"lists-region, as Fixpt's bench/lists-region.fx, at i64."
(define* one-round (subr spin (i64) i64)
  (lambda (n)
    (letrena r
      (letrec ((iota (subr (maxeff (alloc r) spin) (i64 (listof i64 r)) (listof i64 r))
                 (lambda (n acc) (if (i64= n 0) acc (iota (i64- n 1) (rcons r n acc)))))
               (add-up (subr (maxeff (read r) spin) ((listof i64 r) i64) i64)
                 (lambda (xs acc) (if (null? xs) acc (add-up (cdr xs) (i64+ acc (car xs)))))))
        (add-up (iota n nil) 0)))))
(define* rounds (subr spin (i64 i64) i64)
  (lambda (k acc) (if (i64= k 0) acc (rounds (i64- k 1) (i64+ acc (one-round 1000))))))
(rounds 3000 0)
