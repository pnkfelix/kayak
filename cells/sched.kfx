"sched.kfx: what FX-26's processes and `par` need of the runtime (C125),
 as Fixpt's runtime has it: a run queue of tasks, mailboxes, I-cells that
 tasks wait for, timers, and messages copied. The scheduler itself is
 FX-26 (`fx26:processes.fx`), compiled into the program's words; it
 reaches these through `%fx26-sched`'s operations (prims.kfx), and the
 machine through `preempt-due!` and `task-failed!` (machine.kfx).

 The state is a vector, as Fixpt's: the run queue (the front, oldest
 first; the back, newest first), the scheduler's prompt tag, a seed
 (always `#f`: Fixpt's comes from `FIXPT_SCHED_SEED`, which its tests do
 not set), the words copied, the timers (pairs of a time and a waker,
 newest first), the tasks cancelled, the scheduler's `preempt`, the tasks
 parked, how many tasks the first is running, the trampoline word, each
 task of a monitored group with its group, each group's handler, a
 failure caught, each `race` group with the group it is inside, each task
 that waits with how it stops, and the wakers of the standard input.
 Tasks are numbers, the lowest free first; each has a quiet count and a
 grace (Fixpt's `Regions::quiet`). Tier 1 keeps a region's objects in the
 one heap, so a task's places are only numbers (`regions`).
 fixpt-source: crates/fixpt-runtime/src/sched.rs@1925bca"

(define s-front i64 0)
(define s-back i64 1)
(define s-tag i64 2)
(define s-copied i64 4)
(define s-timers i64 5)
(define s-cancelled i64 6)
(define s-preempt i64 7)
(define s-parked i64 8)
(define s-running i64 9)
(define s-trampoline i64 10)
(define s-groups i64 11)
(define s-monitors i64 12)
(define s-failure i64 13)
(define s-parents i64 14)
(define s-waiting i64 15)
(define s-stdin i64 16)

"A task's time slice, in polls: Fixpt's `SLICE`, or another (`--slice`,
 as Fixpt's `FIXPT_SLICE`), so that a test may preempt at nearly every
 poll."
(define slice (ref i64 @c) (new 65536))

"A region's number, as Fixpt's `%region-enter` gives one. Tier 1 keeps
 a region's objects in the one heap: what a region frees is memory, never
 an answer."
(define regions (ref i64 @c) (new 0))

"The state's vector, or `#f` before the first operation; the collector
 forwards it (machine.kfx)."
(define sched-state (ref i64 @c) (new 3))

"Whether there is a state: it is `#f` until made, and stays a vector."
(define sched? (->* () bool) (lambda () (not (i64= (get sched-state) v-false))))

(define-rec
  (filled! (->* (i64 i64 (listof i64 @c)) i64)
    (lambda (v i xs) (if (null? xs) v (begin (obj-set! v i (car xs)) (filled! v (i64+ i 1) (cdr xs)))))))

(define state! (->* () i64)
  (lambda ()
    "The state's vector, made if there is none yet (Fixpt's `state`)."
    (if (sched?)
        (get sched-state)
        (let ((s (filled! (make-bloblet! k-vector 17 0 #t #f) 0
                          (list v-null v-null v-false v-false (fix 0) v-null v-null v-false v-null (fix 0)
                                v-false v-null v-null v-false v-null v-null v-null))))
          (begin (set sched-state s) s)))))

(define st (->* (i64) i64) (lambda (k) (obj-ref (state!) k)))
(define st-set! (->* (i64 i64) unit) (lambda (k v) (obj-set! (state!) k v)))
(define st-cons! (->* (i64 i64) unit) (lambda (k v) (st-set! k (cons! v (st k)))))

"Tasks: whether each is ended, and its quiet count with its grace in bit
 7; the first, 0, never ends."
(define task-ended (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 64 0)))
(define task-quiet (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 64 0)))
(define task-count (ref i64 @c) (new 1))
(define task-now (ref i64 @c) (new 0))

(define task-live? (->* (i64) bool)
  (lambda (t) (and (i64>= t 0) (i64< t (get task-count)) (i64= (flatarray-ref-i64 (get task-ended) t) 0))))

(define-rec
  (free-task (->* (i64) i64)
    (lambda (t)
      (cond ((i64>= t (get task-count)) t)
            ((i64= (flatarray-ref-i64 (get task-ended) t) 1) t)
            (else (free-task (i64+ t 1)))))))

(define-rec
  (grown (->* ((flatarrayof i64 @c) (flatarrayof i64 @c) i64) (flatarrayof i64 @c))
    (lambda (from to i)
      (if (i64>= i (flatarray-length-i64 from)) to (begin (flatarray-set-i64! to i (flatarray-ref-i64 from i)) (grown from to (i64+ i 1)))))))

(define task-new! (->* () i64)
  (lambda ()
    "A new task, not current: its number, the lowest free (`task_new`)."
    (let ((t (free-task 1)))
      (begin
        (if (i64>= t (flatarray-length-i64 (get task-ended)))
            (let ((n (i64* 2 (flatarray-length-i64 (get task-ended)))))
              (begin
                (set task-ended (grown (get task-ended) (make-flatarray-i64 n 0) 0))
                (set task-quiet (grown (get task-quiet) (make-flatarray-i64 n 0) 0))))
            #u)
        (if (i64>= t (get task-count)) (set task-count (i64+ t 1)) #u)
        (flatarray-set-i64! (get task-ended) t 0)
        (flatarray-set-i64! (get task-quiet) t 0)
        t))))

(define task-switch! (->* (i64) i64)
  (lambda (t) "Task `t` made current: the task that was." (let ((was (get task-now))) (begin (set task-now t) was))))

(define task-end! (->* (i64) unit)
  (lambda (t)
    "Task `t`, not the first, ended; if it is current, the first becomes so."
    (if (not (task-live? t))
        #u
        (let ((was (task-switch! t)))
          (begin
            (flatarray-set-i64! (get task-ended) t 1)
            (set task-now (if (i64= was t) (the i64 0) was)))))))

(define quiet (->* () i64) (lambda () (flatarray-ref-i64 (get task-quiet) (get task-now))))
(define quiet-set! (->* (i64) unit) (lambda (q) (flatarray-set-i64! (get task-quiet) (get task-now) q)))
(define quiet? (->* () bool) (lambda () (not (i64= (i64-and (quiet) 127) 0))))
(define quiet-enter! (->* () unit)
  (lambda ()
    (let ((q (quiet)))
      (quiet-set! (i64-or (i64-and q 128) (let ((d (i64+ (i64-and q 127) 1))) (if (i64> d 127) (the i64 127) d)))))))
(define quiet-leave! (->* () unit)
  (lambda ()
    "Out of a quiet; out of the last, a grace begins."
    (let* ((q (quiet)) (d (if (i64= (i64-and q 127) 0) (the i64 0) (i64- (i64-and q 127) 1))))
      (quiet-set! (i64-or d (if (i64= d 0) (the i64 128) (i64-and q 128)))))))
(define take-grace! (->* () bool)
  (lambda () (let ((q (quiet))) (begin (quiet-set! (i64-and q 127)) (not (i64= (i64-and q 128) 0))))))

"Lists in the heap."
(define-rec
  (heap-items (->* (i64) (listof i64 @c)) (lambda (l) (if (is-pair? l) (cons (pair-car l) (heap-items (pair-cdr l))) nil))))

(define-rec
  (kept-of (->* ((listof i64 @c) (subr cm (i64) bool)) (listof i64 @c))
    (lambda (xs drop) (cond ((null? xs) nil) ((drop (car xs)) (kept-of (cdr xs) drop)) (else (cons (car xs) (kept-of (cdr xs) drop)))))))

(define-rec
  (reversed-onto! (->* (i64 i64) i64)
    (lambda (l acc) (if (is-pair? l) (reversed-onto! (pair-cdr l) (cons! (pair-car l) acc)) acc))))

"The scheduler's lists, sifted where they are, in the heap, which is
 collected, with no closure made (C148): what tier 1 makes of its own is
 never let go (C43), and these are asked at every scheduling. How an
 item `e` is matched: `e` is `x` (0); its car is (1); its cdr is (2);
 either is (3); its car is an item of list `x` (4); its car is a time
 not after `x` (5)."
(define-rec
  (heap-member? (->* (i64 i64) bool)
    (lambda (l x) (and (is-pair? l) (or (i64= (pair-car l) x) (heap-member? (pair-cdr l) x))))))

(define matches? (->* (i64 i64 i64) bool)
  (lambda (e how x)
    (cond ((i64= how 0) (i64= e x))
          ((i64= how 1) (i64= (pair-car e) x))
          ((i64= how 2) (i64= (pair-cdr e) x))
          ((i64= how 3) (or (i64= (pair-car e) x) (i64= (pair-cdr e) x)))
          ((i64= how 4) (heap-member? x (pair-car e)))
          (else (i64<= (fix-val (pair-car e)) x)))))

(define-rec
  (any-match? (->* (i64 i64 i64) bool)
    (lambda (l how x) (and (is-pair? l) (or (matches? (pair-car l) how x) (any-match? (pair-cdr l) how x))))))

(define-rec
  (sifted! (->* (i64 i64 i64 bool i64) i64)
    (lambda (l how x keep acc)
      "The items of `l` that match (`keep`) or not, reversed, onto `acc`."
      (cond ((not (is-pair? l)) acc)
            ((let ((m (matches? (pair-car l) how x))) (if keep m (not m))) (sifted! (pair-cdr l) how x keep (cons! (pair-car l) acc)))
            (else (sifted! (pair-cdr l) how x keep acc))))))

(define without! (->* (i64 i64 i64) i64)
  (lambda (l how x)
    "List `l` without the items that match, in order; `l` itself if it has
     none."
    (if (any-match? l how x) (reversed-onto! (sifted! l how x #f v-null) v-null) l)))

(define only! (->* (i64 i64 i64) i64)
  (lambda (l how x) "The items of list `l` that match, in order." (reversed-onto! (sifted! l how x #t v-null) v-null)))

(define-rec
  (i64-in? (->* ((listof i64 @c) i64) bool)
    (lambda (xs x) (and (not (null? xs)) (or (i64= (car xs) x) (i64-in? (cdr xs) x))))))

"The run queue."
(define queue-push! (->* (i64) unit) (lambda (thunk) (st-cons! s-back thunk)))

(define-rec
  (pushed-each! (->* (i64) unit)
    (lambda (ws) (if (is-pair? ws) (begin (queue-push! (pair-car ws)) (pushed-each! (pair-cdr ws))) #u))))

(define queue-pop! (->* () i64)
  (lambda ()
    "The next task to run, the oldest, or `#f` (`pop`)."
    (let ((front (if (i64= (st s-front) v-null)
                     (let ((f (reversed-onto! (st s-back) v-null))) (begin (st-set! s-back v-null) f))
                     (st s-front))))
      (if (not (is-pair? front))
          (begin (st-set! s-front v-null) v-false)
          (begin (st-set! s-front (pair-cdr front)) (pair-car front))))))

(define pop-any! (->* () i64)
  (lambda ()
    "The next task to run, or, with none, the oldest parked one."
    (let ((t (queue-pop!)))
      (if (not (i64= t v-false))
          t
          (let ((ps (reversed-onto! (st s-parked) v-null)))
            (if (is-pair? ps)
                (begin (st-set! s-parked (reversed-onto! (pair-cdr ps) v-null)) (pair-car ps))
                v-false))))))

"Messages, copied: what a message shares with its sender rather than
 copies (Fixpt's `shared`), and the copy (`copy_within`): pairs and
 bloblets, sharing and cycles kept, raw suffixes as they are, frozen
 flags too."
(define shared? (->* (i64) bool)
  (lambda (v)
    (and (not (is-pair? v))
         (let ((k (kind-of v)))
           (not (or (i64= k k-string) (i64= k k-bytevector) (i64= k k-bloblet) (i64= k k-sum) (i64= k k-product) (i64= k k-flat-array)))))))

(define-datatype moved (moved i64 i64))
(define copy-made (ref (listof moved @c) @c) (new nil))
(define copy-order (ref (listof i64 @c) @c) (new nil))
(define copy-words (ref i64 @c) (new 0))

(define-rec
  (moved-to (->* ((listof moved @c) i64) i64)
    (lambda (ms v) (if (null? ms) 0 (tagcase (car ms) (moved (a b) (if (i64= a v) b (moved-to (cdr ms) v))))))))

(define has-trailer? (->* (i64) bool) (lambda (v) (i64= (tag-of (word-at (i64- (address v) 1))) t-trailer)))

(define-rec
  (slots-onto (->* (i64 i64 i64 (listof i64 @c)) (listof i64 @c))
    (lambda (v k last acc) (if (i64> k last) acc (slots-onto v (i64+ k 1) last (cons (slot-of v k) acc))))))

(define-rec
  (discovered! (->* ((listof i64 @c)) unit)
    (lambda (todo)
      (if (null? todo)
          #u
          (let ((v (car todo)) (rest (cdr todo)))
            (cond ((is-sref? v) (discovered! (cons (sref-owner v) rest)))
                  ((not (or (is-pair? v) (is-bloblet? v))) (discovered! rest))
                  ((shared? v) (discovered! rest))
                  ((not (i64= (moved-to (get copy-made) v) 0)) (discovered! rest))
                  ((is-pair? v)
                   (begin
                     (set copy-made (cons (moved v (cons! v-null v-null)) (get copy-made)))
                     (set copy-order (cons v (get copy-order)))
                     (set copy-words (i64+ (get copy-words) 2))
                     (discovered! (cons (pair-cdr v) (cons (pair-car v) rest)))))
                  (else
                   (let* ((tr (has-trailer? v))
                          (from (if tr (the i64 2) (the i64 1)))
                          (copy (make-bloblet! (kind-of v) (if tr (i64- (fields-of v) 1) (fields-of v)) (bytes-of v) tr #f)))
                     (begin
                       (set copy-made (cons (moved v copy) (get copy-made)))
                       (set copy-order (cons v (get copy-order)))
                       (set copy-words (i64+ (get copy-words) (i64+ (i64+ 1 (fields-of v)) (i64-quotient (i64+ (bytes-of v) 7) 8))))
                       (discovered! (slots-onto v from (fields-of v) rest)))))))))))

(define copied-value (->* (i64) i64)
  (lambda (x)
    "What `x` is in the copy."
    (cond ((is-sref? x)
           (let ((o (moved-to (get copy-made) (sref-owner x))))
             (if (i64= o 0) x (make-sref (address o) (sref-offset x)))))
          ((or (is-pair? x) (is-bloblet? x))
           (let ((c (moved-to (get copy-made) x))) (if (i64= c 0) x c)))
          (else x))))

(define-rec
  (filled-copy! (->* ((listof i64 @c)) unit)
    (lambda (vs)
      (if (null? vs)
          #u
          (let* ((v (car vs)) (c (moved-to (get copy-made) v)))
            (begin
              (if (is-pair? v)
                  (begin (word-set! (address c) (copied-value (pair-car v)))
                         (word-set! (i64+ (address c) 1) (copied-value (pair-cdr v))))
                  (letrec ((copy-fields (subr cm (i64) unit)
                             (lambda (k) (if (i64> k (fields-of v)) #u (begin (slot-set! c k (copied-value (slot-of v k))) (copy-fields (i64+ k 1))))))
                           (copy-suffix (subr cm (i64) unit)
                             (lambda (j)
                               (if (i64>= j (i64-quotient (i64+ (bytes-of v) 7) 8))
                                   #u
                                   (begin (word-set! (i64+ (address c) j) (word-at (i64+ (address v) j))) (copy-suffix (i64+ j 1)))))))
                    (begin
                      (copy-fields (if (has-trailer? v) (the i64 2) (the i64 1)))
                      (copy-suffix 0)
                      (frozen-as! c (fields-frozen? v) (suffix-frozen? v)))))
              (filled-copy! (cdr vs))))))))

(define copy-within! (->* (i64) i64)
  (lambda (root)
    "A copy of what `root` reaches, but for what is shared; the words
     copied counted in the state."
    (begin
      (set copy-made nil) (set copy-order nil) (set copy-words 0)
      (discovered! (list root))
      (filled-copy! (reverse (get copy-order)))
      (st-set! s-copied (fix (i64+ (fix-val (st s-copied)) (get copy-words))))
      (let ((m (copied-value root))) (begin (set copy-made nil) (set copy-order nil) m)))))

"I-cells: whether full, the value, the waiters; mailboxes: messages,
 oldest first, then newest first, and the task waiting."
(define make-icell! (->* () i64)
  (lambda ()
    "An i-cell (Fixpt's `sched::make_icell`): empty, no one waiting."
    (let ((c (make-bloblet! k-icell 3 0 #t #f)))
      (begin (slot-set! c 2 v-false) (slot-set! c 3 v-false) (slot-set! c 4 v-null) c))))

(define cell-put! (->* (i64 i64) i64)
  (lambda (c v)
    "I-cell `c` given `v`, its one write; the tasks waiting for it run, in
     the order they began to wait (`icell_put`)."
    (cond ((not (is-kind? c k-icell)) (begin (trap! "expected an i-cell") 0))
          ((not (i64= (slot-of c 2) v-false)) (begin (trap! "an i-cell written twice") 0))
          (else
           (let ((ws (slot-of c 4)))
             (begin
               (slot-set! c 3 v)
               (slot-set! c 2 v-true)
               (slot-set! c 4 v-null)
               (pushed-each! (reversed-onto! ws v-null))
               v-unit))))))

(define make-mailbox! (->* () i64)
  (lambda ()
    (let ((m (make-bloblet! k-mailbox 3 0 #t #f)))
      (begin (slot-set! m 2 v-null) (slot-set! m 3 v-null) (slot-set! m 4 v-false) m))))

(define mailbox-ready? (->* (i64) bool) (lambda (m) (or (is-pair? (slot-of m 2)) (is-pair? (slot-of m 3)))))

(define mailbox-put! (->* (i64 i64) i64)
  (lambda (m v)
    "The message copied, at the back; the receiver, if it waits, run."
    (let ((msg (copy-within! v)))
      (begin
        (slot-set! m 3 (cons! msg (slot-of m 3)))
        (if (i64= (slot-of m 4) v-false)
            #u
            (let ((w (slot-of m 4))) (begin (slot-set! m 4 v-false) (queue-push! w))))
        v-unit))))

(define mailbox-take! (->* (i64) i64)
  (lambda (m)
    "The oldest message, taken."
    (let ((front (if (is-pair? (slot-of m 2))
                     (slot-of m 2)
                     (let ((f (reversed-onto! (slot-of m 3) (slot-of m 2)))) (begin (slot-set! m 3 v-null) f)))))
      (if (not (is-pair? front))
          (begin (slot-set! m 2 v-null) (trap! "%fx26-sched: an empty mailbox taken from") 0)
          (begin (slot-set! m 2 (pair-cdr front)) (pair-car front))))))

"Timers: each waker run once the clock reaches its time."
(define timer-add! (->* (i64 i64) i64)
  (lambda (t w)
    (begin
      (if (i64>= (clock) t)
          (queue-push! w)
          (st-cons! s-timers (cons! (fix (cond ((i64> t fix-max) fix-max) ((i64< t fix-min) fix-min) (else t))) w)))
      v-unit)))

(define-rec
  (due-in? (->* (i64 i64) bool)
    (lambda (l now) (and (is-pair? l) (or (i64<= (fix-val (pair-car (pair-car l))) now) (due-in? (pair-cdr l) now))))))

(define timer-due? (->* () bool)
  (lambda ()
    "Whether a timer is due; the clock not read if none is set."
    (let ((ts (st s-timers))) (and (is-pair? ts) (due-in? ts (clock))))))

(define-rec
  (timers-earliest (->* (i64 i64) i64)
    (lambda (l e) (if (is-pair? l) (timers-earliest (pair-cdr l) (let ((t (fix-val (pair-car (pair-car l))))) (if (i64< t e) t e))) e))))

(define-rec
  (timer-by-time! (->* (i64 i64) i64)
    (lambda (e l)
      "Timer `e` in list `l`, sorted by time, after those of its own."
      (cond ((not (is-pair? l)) (cons! e v-null))
            ((i64< (fix-val (pair-car e)) (fix-val (pair-car (pair-car l)))) (cons! e l))
            (else (cons! (pair-car l) (timer-by-time! e (pair-cdr l))))))))

(define-rec
  (timers-sorted! (->* (i64 i64) i64)
    (lambda (l acc) (if (is-pair? l) (timers-sorted! (pair-cdr l) (timer-by-time! (pair-car l) acc)) acc))))

(define-rec
  (wakers-pushed! (->* (i64) unit)
    (lambda (l) (if (is-pair? l) (begin (queue-push! (pair-cdr (pair-car l))) (wakers-pushed! (pair-cdr l))) #u))))
(define-rec
  (heap-cars (->* ((listof i64 @c)) (listof i64 @c)) (lambda (xs) (if (null? xs) nil (cons (pair-car (car xs)) (heap-cars (cdr xs)))))))

(define timers-wait! (->* (bool) i64)
  (lambda (sleep)
    "When no task can run and the first waits: `#f` if no timer is set;
     else, having slept until the earliest (if `sleep`), each timer due
     taken, its waker run, in the order of their times, and `#t`. Tier 1
     reads no standard input: a waker waiting for it is not yet (C122)."
    (let ((ts (st s-timers)))
      (cond ((is-pair? (st s-stdin)) (begin (trap! "tier 1: the standard input waited for, not yet as Fixpt (C122)") v-false))
            ((not (is-pair? ts)) v-false)
            (else
             (begin
               (if sleep (sleep-until (timers-earliest ts fix-max)) #u)
               (let ((now (clock)))
                 (begin
                   (st-set! s-timers (without! ts 5 now))
                   (wakers-pushed! (timers-sorted! (reversed-onto! (only! ts 5 now) v-null) v-null))
                   v-true))))))))

"Tasks the scheduler keeps."
(define-rec
  (assq-cdr (->* (i64 i64) i64)
    (lambda (l t)
      "The first entry's of `l` for `t`, its value, or `#f`."
      (cond ((not (is-pair? l)) v-false)
            ((i64= (pair-car (pair-car l)) t) (pair-cdr (pair-car l)))
            (else (assq-cdr (pair-cdr l) t))))))

(define group-of (->* (i64) i64)
  (lambda (t) "The group task `t` is of, or `#f`." (if (sched?) (assq-cdr (st s-groups) t) v-false)))

(define forget-task! (->* (i64) unit)
  (lambda (t)
    "What the scheduler kept of task `t`, ended (`forget_task`)."
    (begin
      (st-set! s-cancelled (without! (st s-cancelled) 0 t))
      (st-set! s-groups (without! (st s-groups) 1 t))
      (st-set! s-monitors (without! (st s-monitors) 1 t))
      (st-set! s-parents (without! (st s-parents) 3 t))
      (st-set! s-waiting (without! (st s-waiting) 1 t)))))

(define cancelled? (->* (i64) bool)
  (lambda (t) (heap-member? (st s-cancelled) t)))

(define reaped! (->* () i64)
  (lambda ()
    "Each cancelled task that waits, `(task . stop)`, taken from those that
     wait (`REAP`)."
    (let* ((cs (st s-cancelled)) (ws (st s-waiting)) (them (only! ws 4 cs)))
      (begin (st-set! s-waiting (without! ws 4 cs)) them))))

"Preemption and failure, for the machine."
(define wanted-how! (->* () i64)
  (lambda ()
    "Whether the scheduler would have the current task preempted here: 0,
     no; 1, yes; 2, in a task, if the scheduler's prompt is on the
     machine's stack, which the machine asks only then, as walking its
     stack costs (`wanted`, its `reachable` called last)."
    (cond ((or (quiet?) (take-grace!)) 0)
          ((i64= (get task-now) 0)
           (if (and (or (is-pair? (st s-front)) (is-pair? (st s-back)) (is-pair? (st s-parked)) (timer-due?))
                    (i64= (fix-val (st s-running)) 0))
               1
               0))
          ((i64= (st s-tag) v-false) 0)
          (else 2))))

(define wanted! (->* (bool) bool)
  (lambda (reach)
    "Whether the scheduler would have the current task preempted here; in
     a task, `reach` says whether the scheduler's prompt is on the
     machine's stack (`wanted`)."
    (let ((w (wanted-how!))) (or (i64= w 1) (and (i64= w 2) reach)))))

(define sched-tag (->* () i64)
  (lambda () "The scheduler's prompt tag, or `#f`." (if (sched?) (st s-tag) v-false)))

(define preempt-wanted! (->* () i64)
  (lambda ()
    "At a poll whose slice is spent: as `wanted-how!`, 0 too if there is
     no scheduler's `preempt` to call (`preempt_due_with`)."
    (if (and (sched?) (is-kind? (st s-preempt) k-closure)) (wanted-how!) 0)))

(define preempt-due! (->* () i64)
  (lambda ()
    "The scheduler's `preempt`, wanted, for the machine to call at the
     poll, the task then quiet until it has."
    (begin (quiet-enter!) (st s-preempt))))

(define-rec
  (groups-within (->* ((listof i64 @c)) (listof i64 @c))
    (lambda (gs)
      "`gs`, with every group inside one of them (`BRANCH_GROUP`)."
      (let ((more (kept-of (heap-cars (kept-of (heap-items (st s-parents)) (lambda ((e i64)) (not (i64-in? gs (pair-cdr e))))))
                        (lambda ((g i64)) (i64-in? gs g)))))
        (if (null? more)
            gs
            (groups-within (onto-new gs more))))))
  (onto-new (->* ((listof i64 @c) (listof i64 @c)) (listof i64 @c))
    (lambda (gs xs) (cond ((null? xs) gs) ((i64-in? gs (car xs)) (onto-new gs (cdr xs))) (else (onto-new (cons (car xs) gs) (cdr xs)))))))

(define-rec
  (last-monitor (->* (i64 i64 i64) i64)
    (lambda (l g found)
      (cond ((not (is-pair? l)) found)
            ((i64= (pair-car (pair-car l)) g) (last-monitor (pair-cdr l) g (pair-cdr (pair-car l))))
            (else (last-monitor (pair-cdr l) g found))))))

(define-rec
  (pushed-cancelled! (->* ((listof i64 @c)) unit)
    (lambda (ts) (if (null? ts) #u (begin (st-cons! s-cancelled (car ts)) (pushed-cancelled! (cdr ts)))))))

(define-rec
  (all-quiet-left! (->* () unit) (lambda () (if (quiet?) (begin (quiet-leave!) (all-quiet-left!)) #u))))

(define task-failed! (->* (string bool) i64)
  (lambda (message reach)
    "The current task failed with `message`: if it is of a monitored group
     and the scheduler's prompt is on the stack (`reach`), the rest of the
     group cancelled, the failure kept for the scheduler, and the prompt's
     tag, to abort to; else `#f`, the failure the form's (`task_failed`)."
    (let* ((cur (fix (get task-now)))
           (g (group-of cur))
           (mon (if (i64= g v-false) v-false (last-monitor (st s-monitors) g v-false))))
      (if (or (i64= (get task-now) 0) (i64= mon v-false) (i64= (st s-tag) v-false) (not reach) (not (i64= (st s-failure) v-false)))
          v-false
          (let ((gs (groups-within (list g))))
            (begin
              (pushed-cancelled! (heap-cars (kept-of (heap-items (st s-groups)) (lambda ((e i64)) (or (not (i64-in? gs (pair-cdr e))) (i64= (pair-car e) cur))))))
              (st-set! s-failure (cons! (make-string! message) mon))
              (all-quiet-left!)
              (st s-tag)))))))
