"show.kfx: a value written as Fixpt's `write` writes it (C122), so that
 tier 1's answers are compared with Fixpt's as text. Shared structure is
 not labelled yet (Fixpt's `#n=`): a cyclic value would not end.
 fixpt-source: crates/fixpt-runtime/src/print.rs@7641962"

(define hex-digit (subr kfx (i64) string)
  (lambda (d) (char->string (string-ref-i64 "0123456789abcdef" d))))

(define-rec
  (hex (subr kfx (i64) string)
    (lambda (n) (if (i64< n 16) (hex-digit n) (string-append (hex (i64-shr n 4)) (hex-digit (i64-and n 15)))))))

(define char-written (subr kfx (i64) string)
  (lambda (cp)
    (string-append "#\\"
      (cond ((i64= cp 32) "space") ((i64= cp 10) "newline") ((i64= cp 9) "tab") ((i64= cp 13) "return")
            ((i64= cp 0) "null") ((i64= cp 7) "alarm") ((i64= cp 8) "backspace") ((i64= cp 127) "delete")
            ((i64= cp 27) "escape")
            ((i64< cp 32) (string-append "x" (hex cp)))
            (else (char->string (i64->char cp)))))))

(define-rec
  (escaped (subr kfx (string i64 string) string)
    (lambda (s i acc)
      (if (i64>= i (string-length-i64 s))
          acc
          (let* ((c (string-ref-i64 s i)) (cp (char->i64 c)))
            (escaped s (i64+ i 1)
              (string-append acc
                (cond ((i64= cp 34) "\\\"") ((i64= cp 92) "\\\\") ((i64= cp 10) "\\n") ((i64= cp 9) "\\t") ((i64= cp 13) "\\r")
                      ((i64< cp 32) (string-append "\\x" (string-append (hex cp) ";")))
                      (else (char->string c))))))))))

(define kind-name (subr kfx (i64) string)
  (lambda (k)
    "A kind's name, as Fixpt's `KINDS` has it, its number from `layout.fx`."
    (cond
          ((i64= k (int->i64 (with lay kind-string))) "string")
          ((i64= k (int->i64 (with lay kind-symbol))) "symbol")
          ((i64= k (int->i64 (with lay kind-vector))) "vector")
          ((i64= k (int->i64 (with lay kind-bytevector))) "bytevector")
          ((i64= k (int->i64 (with lay kind-flonum))) "flonum")
          ((i64= k (int->i64 (with lay kind-bignum))) "bignum")
          ((i64= k (int->i64 (with lay kind-ratnum))) "ratnum")
          ((i64= k (int->i64 (with lay kind-closure))) "closure")
          ((i64= k (int->i64 (with lay kind-code))) "code")
          ((i64= k (int->i64 (with lay kind-box))) "box")
          ((i64= k (int->i64 (with lay kind-record))) "record")
          ((i64= k (int->i64 (with lay kind-record-type))) "record-type")
          ((i64= k (int->i64 (with lay kind-port))) "port")
          ((i64= k (int->i64 (with lay kind-continuation))) "continuation")
          ((i64= k (int->i64 (with lay kind-values))) "values")
          ((i64= k (int->i64 (with lay kind-promise))) "promise")
          ((i64= k (int->i64 (with lay kind-hash-table))) "hash-table")
          ((i64= k (int->i64 (with lay kind-environment))) "environment")
          ((i64= k (int->i64 (with lay kind-primitive))) "primitive")
          ((i64= k (int->i64 (with lay kind-bloblet))) "bloblet")
          ((i64= k (int->i64 (with lay kind-cellular-code))) "cellular-code")
          ((i64= k (int->i64 (with lay kind-compiled-code))) "compiled-code")
          ((i64= k (int->i64 (with lay kind-env-frame))) "env-frame")
          ((i64= k (int->i64 (with lay kind-sum))) "sum")
          ((i64= k (int->i64 (with lay kind-product))) "product")
          ((i64= k (int->i64 (with lay kind-cellular-closure))) "cellular-closure")
          ((i64= k (int->i64 (with lay kind-cellular-continuation))) "cellular-continuation")
          ((i64= k (int->i64 (with lay kind-register-code))) "register-code")
          ((i64= k (int->i64 (with lay kind-native-closure))) "native-closure")
          ((i64= k (int->i64 (with lay kind-flat-array))) "flat-array")
          ((i64= k (int->i64 (with lay kind-eqtable))) "eqtable")
          ((i64= k (int->i64 (with lay kind-weak-pair))) "weak-pair")
          ((i64= k (int->i64 (with lay kind-native-frame))) "native-frame")
          ((i64= k (int->i64 (with lay kind-icell))) "icell")
          ((i64= k (int->i64 (with lay kind-mailbox))) "mailbox")
          ((i64= k (int->i64 (with lay kind-extension))) "extension")
          (else "?"))))

(define-rec
  (written (subr cm (i64) string)
    (lambda (v)
      (cond ((is-fixnum? v) (i64->string (fix-val v)))
            ((i64= v v-true) "#t")
            ((i64= v v-false) "#f")
            ((i64= v v-null) "()")
            ((i64= v v-unit) "#u")
            ((i64= v v-eof) "#<eof>")
            ((i64= v v-unspecified) "#<unspecified>")
            ((i64= v v-default) "#<default>")
            ((i64= v v-unbound) "#<unbound>")
            ((is-char? v) (char-written (i64-shr v 8)))
            ((i64= (tag-of v) t-immediate) "#<immediate>")
            ((is-pair? v) (string-append "(" (string-append (written (pair-car v)) (string-append (tail-written (pair-cdr v)) ")"))))
            ((is-kind? v k-string) (string-append "\"" (string-append (escaped (string-text v) 0 "") "\"")))
            ((is-kind? v k-symbol) (symbol-text v))
            ((is-kind? v k-box) (string-append "#<box " (string-append (written (slot-of v 2)) ">")))
            ((is-kind? v k-sum) (string-append "#<sum " (string-append (written (slot-of v 2)) ">")))
            ((is-kind? v k-product) (string-append "#<product of " (string-append (i64->string (i64- (fields-of v) 1)) ">")))
            ((is-kind? v k-code) (string-append "#<cellular-word " (string-append (written (slot-of v f-name)) ">")))
            ((is-bloblet? v)
             (string-append "#<" (string-append (kind-name (kind-of v))
               (string-append " " (string-append (i64->string (fields-of v))
                 (string-append " fields " (string-append (i64->string (bytes-of v)) " bytes>")))))))
            (else "#<unknown>"))))
  (tail-written (subr cm (i64) string)
    (lambda (rest)
      (cond ((i64= rest v-null) "")
            ((is-pair? rest) (string-append " " (string-append (written (pair-car rest)) (tail-written (pair-cdr rest)))))
            (else (string-append " . " (written rest)))))))
