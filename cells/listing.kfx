"listing.kfx: words read from Fixpt's listing of them (C122), what
 `fixpt --fx26-machine fx-cells-rsinterp compile` writes: for each word
 its header, `word NAME (N cells, cellular):`, then a line for each
 instruction, `AT: ROUTINE OPERAND ...`. Exact, but where a literal is
 cut short (`…`), two words share a name, or the compilers disagree:
 those are refused. Each word's register code (`its register code`) is
 read into a register word, its twin under `--regs` (C129).
 fixpt-source: crates/fixpt-runtime/src/disasm.rs@1925bca"

(define listing-error (subr kfx (string) void)
  (lambda (why) (error (string-append "kayak-cells: the listing: " why))))

"Parentheses, as characters (KFX's reader takes no `#\\(`)."
(define open-paren char (i64->char 40))
(define close-paren char (i64->char 41))
(define comma char (i64->char 44))
(define colon char (i64->char 58))
(define dquote char (i64->char 34))
(define bar char (i64->char 124))
(define backslash char (i64->char 92))

"Lines, each its characters."
(define-rec
  (lines-of (subr kfx (chars chars (listof chars acyclic)) (listof chars acyclic))
    (lambda (cs acc out)
      (cond ((null? cs) (the (listof chars acyclic) (reverse (the (listof chars acyclic) (if (null? acc) out (cons (the chars (reverse acc)) out))))))
            ((char=? (car cs) #\newline) (lines-of (cdr cs) nil (cons (the chars (reverse acc)) out)))
            (else (lines-of (cdr cs) (cons (car cs) acc) out))))))

(define-rec
  (starts? (subr kfx (chars chars) bool)
    (lambda (cs prefix)
      (cond ((null? prefix) #t)
            ((null? cs) #f)
            (else (and (char=? (car cs) (car prefix)) (starts? (cdr cs) (cdr prefix))))))))

(define-rec
  (drop-n (subr kfx (chars i64) chars)
    (lambda (cs n) (if (or (null? cs) (i64= n 0)) cs (drop-n (cdr cs) (i64- n 1))))))

(define-rec
  (spaces-dropped (subr kfx (chars) chars)
    (lambda (cs) (if (and (not (null? cs)) (char=? (car cs) #\space)) (spaces-dropped (cdr cs)) cs))))

(define-rec
  (until-char (subr kfx (chars char chars) chars)
    (lambda (cs c acc)
      "The characters before the first `c`."
      (if (or (null? cs) (char=? (car cs) c)) (the chars (reverse acc)) (until-char (cdr cs) c (cons (car cs) acc))))))

(define before-char (subr kfx (chars char) chars) (lambda (cs c) (until-char cs c nil)))

(define-rec
  (after-char (subr kfx (chars char) chars)
    (lambda (cs c) (cond ((null? cs) nil) ((char=? (car cs) c) (cdr cs)) (else (after-char (cdr cs) c))))))

(define-rec
  (contains? (subr kfx (chars chars) bool)
    (lambda (cs part) (cond ((starts? cs part) #t) ((null? cs) #f) (else (contains? (cdr cs) part))))))

(define-rec
  (digits-of (subr kfx (chars i64) i64)
    (lambda (cs acc)
      (if (and (not (null? cs)) (char-numeric? (car cs)))
          (digits-of (cdr cs) (i64+ (i64* acc 10) (i64- (char->i64 (car cs)) 48)))
          acc))))

(define number-of (subr kfx (chars) i64)
  (lambda (cs)
    (let ((cs (spaces-dropped cs)))
      (cond ((null? cs) (begin (listing-error "a number is missing") 0))
            ((char=? (car cs) #\-) (i64- 0 (digits-of (cdr cs) 0)))
            ((char-numeric? (car cs)) (digits-of cs 0))
            (else (begin (listing-error (string-append "not a number: " (list->string cs))) 0))))))

"A word's block: its name, its cells, its entry, its instructions' lines
 (each where it starts, and the rest of it)."
(define-datatype iline (iline i64 chars))
(define-datatype block (block string i64 i64 (listof iline acyclic)))

(define header-block (subr kfx (chars) block)
  (lambda (cs)
    "`word NAME (N cells, cellular):` or `(N cells, the routine R):`."
    (let* ((rest (drop-n cs 5))
           (name (list->string (before-char rest #\space)))
           (inside (after-char rest open-paren))
           (n (number-of inside))
           (entry (the i64 (cond ((contains? inside (string-chars "cellular)")) r-docol)
                        ((contains? inside (string-chars "the routine "))
                         (index-in routine-names (list->string (before-char (drop-n (after-char (after-char inside comma) #\space) 12) close-paren)) 0))
                        (else (begin (listing-error (string-append "a word of no kind tier 1 runs: " (list->string cs))) 0))))))
      (block name n entry nil))))

(define-rec
  (blocks (subr kfx ((listof chars acyclic) (listof block acyclic) i64) (listof block acyclic))
    (lambda (ls out mode)
      "The blocks of a listing's lines, newest last. `mode`: 0 in a word's
       cells, 1 in its register code (each instruction kept at `-2 - AT`),
       2 in what else is listed of it, passed over."
      (if (null? ls)
          (the (listof block acyclic) (reverse out))
          (let ((l (car ls)))
            (cond ((starts? l (string-chars "word "))
                   (blocks (cdr ls) (cons (header-block l) out) 0))
                  ((starts? l (string-chars "; the compilers disagree"))
                   (begin (listing-error "the compilers disagree") nil))
                  ((or (null? l) (char=? (car l) #\;)) (blocks (cdr ls) out 0))
                  ((starts? l (string-chars "  its register code ")) (blocks (cdr ls) out 1))
                  ((starts? l (string-chars "  its ")) (blocks (cdr ls) out 2))
                  ((or (null? out) (i64= mode 2)) (blocks (cdr ls) out mode))
                  (else
                   (let* ((t (spaces-dropped l))
                          (at (digits-of t 0))
                          (text (spaces-dropped (after-char t colon))))
                     (if (contains? text (string-chars "…"))
                         (begin (listing-error "a literal cut short") nil)
                         (blocks (cdr ls)
                                 (tagcase (car out)
                                   (block (n c e is) (cons (block n c e (cons (iline (if (i64= mode 1) (i64- -2 at) at) text) is)) (cdr out))))
                                 mode))))))))))

"The words, by name."
(define words (ref (listof named @c) @c) (new nil))

(define word-named (subr cm (chars) i64)
  (lambda (cs)
    (let ((w (lookup (get words) (list->string (before-char cs #\space)))))
      (if (i64= w 0)
          (begin (listing-error (string-append "no word is named " (list->string cs))) 0)
          w))))

"The undefined closure: what a global holds before it is written, which
 traps if called (Fixpt's `undefined_closure`)."
(define undefined-closure (ref i64 @c) (new 0))

(define the-undefined (subr cm () i64)
  (lambda ()
    (if (i64= (get undefined-closure) 0)
        (let* ((w (make-code-word! "undefined" 1 r-docol))
               (c (make-bloblet! k-closure 1 0 #t #f)))
          (begin
            (slot-set! w f-cell0 (fix r-undefined))
            (slot-set! c f-word w)
            (set undefined-closure c)
            c))
        (get undefined-closure))))

(define global-named (subr cm (string) i64)
  (lambda (name)
    "Global `name`'s cell (Fixpt's: its value, its name, how many times it
     was written), made the first time it is named."
    (let ((g (lookup (get globals) name)))
      (if (not (i64= g 0))
          g
          (let ((g (make-bloblet! k-bloblet 3 0 #t #f)))
            (begin
              (slot-set! g f-value (the-undefined))
              (slot-set! g 3 (symbol! name))
              (slot-set! g f-writes (fix 0))
              (set globals (cons (named! name g) (get globals)))
              g))))))

"Literals as `fixpt compile --full-literals` writes them (C123): every one
 in full, so that it is built again exactly (Fixpt's `literal.rs`;
 `docs/fx26.md`, \"The compile listing's literals\"). An object reached
 more than once is labelled `#N=` where first written and named `#N#`
 after, across the whole listing, so that what is `eq?` in the program is
 `eq?` here. A labelled pair is made before what is in it, so that a
 cycle through pairs is too; one through a vector or other bloblet is
 refused (not yet).
 fixpt-source: crates/fixpt-runtime/src/literal.rs@1925bca"
(define-datatype lab (lab i64 i64))
(define labels (ref (listof lab @c) @c) (new nil))

"What reading gives: a value, an integer, a text or values, and what is
 left to read."
(define-datatype lgot (lgot i64 chars))
(define-datatype gint (gint int chars))
(define-datatype gtext (gtext string chars))
(define-datatype gall (gall (listof i64 @c) chars))

(define-rec
  (label-value (subr cm ((listof lab @c) i64) i64)
    (lambda (ls n)
      (cond ((null? ls) 0)
            ((tagcase (car ls) (lab (m v) (i64= m n))) (tagcase (car ls) (lab (m v) v)))
            (else (label-value (cdr ls) n))))))

(define labelled! (subr cm (i64 i64) i64)
  (lambda (n v) (begin (set labels (cons (lab n v) (get labels))) v)))

(define hex-digit-value (subr kfx (char) i64)
  (lambda (c)
    (let ((n (char->i64 c)))
      (cond ((and (i64>= n 48) (i64<= n 57)) (i64- n 48))
            ((and (i64>= n 97) (i64<= n 102)) (i64- n 87))
            (else -1)))))

(define-rec
  (hex-int (subr kfx (chars int) gint)
    (lambda (cs acc)
      (if (and (not (null? cs)) (i64>= (hex-digit-value (car cs)) 0))
          (hex-int (cdr cs) (+ (* acc 16) (i64->int (hex-digit-value (car cs)))))
          (gint acc cs)))))

(define-rec
  (decimal-int (subr kfx (chars int) gint)
    (lambda (cs acc)
      (if (and (not (null? cs)) (char-numeric? (car cs)))
          (decimal-int (cdr cs) (+ (* acc 10) (i64->int (i64- (char->i64 (car cs)) 48))))
          (gint acc cs)))))

(define signed-int (subr kfx (chars) gint)
  (lambda (cs)
    (if (and (not (null? cs)) (char=? (car cs) #\-))
        (tagcase (decimal-int (cdr cs) 0) (gint (n rest) (gint (- 0 n) rest)))
        (decimal-int cs 0))))

(define-rec
  (escaped-text (subr kfx (chars char chars) gtext)
    (lambda (cs q acc)
      "A string's or a symbol's characters up to `q`: one that is not
       printable ASCII, or is `q` or a backslash, written by its code in hex,
       after a backslash and an `x`, before a `;`."
      (cond ((null? cs) (begin (listing-error "a literal's text runs to the end") (gtext "" nil)))
            ((char=? (car cs) q) (gtext (list->string (the chars (reverse acc))) (cdr cs)))
            ((char=? (car cs) backslash)
             (tagcase (hex-int (drop-n cs 2) 0)
               (gint (n rest) (escaped-text (cdr rest) q (cons (i64->char (int->i64 n)) acc)))))
            (else (escaped-text (cdr cs) q (cons (car cs) acc)))))))

(define expect (subr kfx (chars string) chars)
  (lambda (cs prefix)
    (if (starts? cs (string-chars prefix))
        (drop-n cs (string-length-i64 prefix))
        (begin (listing-error (string-append "a literal tier 1 does not read: " (list->string cs))) nil))))

(define ends-word? (subr kfx (chars) bool)
  (lambda (cs) (or (null? cs) (char=? (car cs) #\space) (char=? (car cs) close-paren))))

(define-rec
  (kind-numbered (subr kfx (string i64) i64)
    (lambda (name k)
      (cond ((i64> k 255) (begin (listing-error (string-append "a bloblet of no kind tier 1 knows: " name)) 0))
            ((string=? (kind-name k) name) k)
            (else (kind-numbered name (i64+ k 1)))))))

(define-rec
  (fields-set! (subr cm (i64 i64 (listof i64 @c)) unit)
    (lambda (b k xs)
      (if (null? xs) #u (begin (slot-set! b k (car xs)) (fields-set! b (i64+ k 1) (cdr xs)))))))

(define byte-set! (subr cm (i64 i64 i64) unit)
  (lambda (p i x)
    "Byte `i` of the raw words from word `p` := `x`, little-endian."
    (let* ((at (i64+ p (i64-quotient i 8)))
           (shift (i64->int (i64* 8 (i64-remainder i 8)))))
      (word-set! at (i64-or (i64-and (word-at at) (i64-not (i64-shl 255 shift))) (i64-shl x shift))))))

(define-rec
  (bytes-set! (subr cm (i64 i64 (listof i64 @c)) unit)
    (lambda (p i xs) (if (null? xs) #u (begin (byte-set! p i (fix-val (car xs))) (bytes-set! p (i64+ i 1) (cdr xs)))))))

(define-rec
  (trailer-in? (subr cm ((listof i64 @c)) bool)
    (lambda (xs) (cond ((null? xs) #f) ((i64= (tag-of (car xs)) t-trailer) #t) (else (trailer-in? (cdr xs)))))))

(define bloblet-literal! (subr cm (string (listof i64 @c) (listof i64 @c)) i64)
  (lambda (kind fields bytes)
    "`#bloblet(KIND (FIELD ...) #u8(BYTE ...))`: its fields from 1, field 1
     its trailer, `#trailer N`, if it has one; frozen if a sum or product,
     as Fixpt makes those (the listing does not say)."
    (let* ((k (kind-numbered kind 0))
           (f (args-count fields 0))
           (trailer (and (not (null? fields)) (i64= (tag-of (car fields)) t-trailer)))
           (b (make-bloblet! k (if trailer (i64- f 1) f) (args-count bytes 0) trailer #f)))
      (begin
        (if (and trailer (not (i64= (i64-shr (car fields) 3) f)))
            (listing-error "a bloblet's trailer that says not its fields")
            #u)
        (if (trailer-in? (if trailer (cdr fields) fields))
            (listing-error "a trailer that is not a bloblet's field 1")
            #u)
        (fields-set! b (if trailer (the i64 2) (the i64 1)) (if trailer (cdr fields) fields))
        (bytes-set! (address b) 0 bytes)
        (if (or (i64= k k-sum) (i64= k k-product)) (frozen-whole! b) #u)
        b))))

(define-rec
  (until-delimiter (subr kfx (chars chars) chars)
    (lambda (cs acc)
      (if (or (null? cs) (char=? (car cs) #\space) (char=? (car cs) close-paren) (char=? (car cs) open-paren))
          (the chars (reverse acc))
          (until-delimiter (cdr cs) (cons (car cs) acc))))))

(define vector-literal! (subr cm ((listof i64 @c)) i64)
  (lambda (xs)
    (let ((v (make-bloblet! k-vector (args-count xs 0) 0 #t #f)))
      (letrec ((fill (subr cm ((listof i64 @c) i64) unit)
                 (lambda (ys i) (if (null? ys) #u (begin (obj-set! v i (car ys)) (fill (cdr ys) (i64+ i 1)))))))
        (begin (fill xs 0) v)))))

(define bytevector-literal! (subr cm ((listof i64 @c)) i64)
  (lambda (xs)
    "A bytevector (Fixpt's `make_bytevector`): its length, a raw word, then
     its bytes."
    (let* ((n (args-count xs 0))
           (b (make-bloblet! k-bytevector 0 (i64* 8 (i64+ 1 (i64-quotient (i64+ n 7) 8))) #f #f)))
      (begin (word-set! (address b) n) (bytes-set! (i64+ (address b) 1) 0 xs) b))))

(define-rec
  (lit-datum (subr cm (chars) lgot)
    (lambda (cs)
      "One literal, from the start of `cs`."
      (cond
        ((null? cs) (begin (listing-error "a literal is missing") (lgot 0 nil)))
        ((or (char-numeric? (car cs)) (char=? (car cs) #\-))
         (tagcase (signed-int cs)
           (gint (n rest)
             (if (and (not (null? rest)) (char=? (car rest) #\/))
                 (tagcase (decimal-int (cdr rest) 0)
                   (gint (d rest2) (lgot (make-ratnum! (int-value! n) (int-value! d)) rest2)))
                 (lgot (int-value! n) rest)))))
        ((char=? (car cs) dquote) (tagcase (escaped-text (cdr cs) dquote nil) (gtext (t rest) (lgot (make-string! t) rest))))
        ((char=? (car cs) bar) (tagcase (escaped-text (cdr cs) bar nil) (gtext (t rest) (lgot (symbol! t) rest))))
        ((starts? cs (string-chars "()")) (lgot v-null (drop-n cs 2)))
        ((char=? (car cs) open-paren) (pair-rest (cdr cs) (cons! v-null v-null)))
        ((starts? cs (string-chars "#f64x")) (tagcase (hex-int (drop-n cs 5) 0) (gint (n rest) (lgot (flonum-bits! (int->i64 n)) rest))))
        ((starts? cs (string-chars "#f32x")) (tagcase (hex-int (drop-n cs 5) 0) (gint (n rest) (lgot (f32-bits (int->i64 n)) rest))))
        ((starts? cs (string-chars "#\\x")) (tagcase (hex-int (drop-n cs 3) 0) (gint (n rest) (lgot (char-value (int->i64 n)) rest))))
        ((starts? cs (string-chars "#u8(")) (tagcase (lit-items (drop-n cs 4) nil) (gall (xs rest) (lgot (bytevector-literal! xs) rest))))
        ((starts? cs (string-chars "#(")) (tagcase (lit-items (drop-n cs 2) nil) (gall (xs rest) (lgot (vector-literal! xs) rest))))
        ((starts? cs (string-chars "#word ")) (tagcase (escaped-text (cdr (drop-n cs 6)) dquote nil) (gtext (t rest) (lgot (word-named (string-chars t)) rest))))
        ((starts? cs (string-chars "#global ")) (tagcase (escaped-text (cdr (drop-n cs 8)) dquote nil) (gtext (t rest) (lgot (global-named t) rest))))
        ((starts? cs (string-chars "#trailer ")) (tagcase (decimal-int (drop-n cs 9) 0) (gint (n rest) (lgot (i64-or (i64-shl (int->i64 n) 3) t-trailer) rest))))
        ((starts? cs (string-chars "#bloblet("))
         (let* ((at (drop-n cs 9))
                (kind (list->string (before-char at #\space))))
           (tagcase (lit-items (expect (drop-n at (i64+ (string-length-i64 kind) 1)) "(") nil)
             (gall (fields rest)
               (tagcase (lit-items (expect (spaces-dropped rest) "#u8(") nil)
                 (gall (bytes rest2) (lgot (bloblet-literal! kind fields bytes) (expect rest2 ")"))))))))
        ((starts? cs (string-chars "#suffix-ref("))
         (tagcase (lit-datum (drop-n cs 12))
           (lgot (o rest)
             (tagcase (decimal-int (spaces-dropped rest) 0)
               (gint (n rest2) (lgot (make-sref (address o) (int->i64 n)) (expect rest2 ")")))))))
        ((and (char=? (car cs) #\#) (not (null? (cdr cs))) (char-numeric? (car (cdr cs))))
         (tagcase (decimal-int (cdr cs) 0)
           (gint (n rest)
             (cond ((starts? rest (string-chars "#"))
                    (let ((v (label-value (get labels) (int->i64 n))))
                      (if (i64= v 0)
                          (begin (listing-error "a label named before what it labels is made: a cycle through a vector or bloblet, not yet") (lgot 0 nil))
                          (lgot v (cdr rest)))))
                   ((and (starts? rest (string-chars "=(")) (not (starts? rest (string-chars "=()"))))
                    (pair-rest (drop-n rest 2) (labelled! (int->i64 n) (cons! v-null v-null))))
                   ((starts? rest (string-chars "="))
                    (tagcase (lit-datum (cdr rest)) (lgot (v rest2) (lgot (labelled! (int->i64 n) v) rest2))))
                   (else (begin (listing-error "a label neither made nor named") (lgot 0 nil)))))))
        ((char=? (car cs) #\#)
         (let* ((name (list->string (before-char (until-delimiter cs nil) #\space)))
                (rest (drop-n cs (string-length-i64 name))))
           (cond ((string=? name "#t") (lgot v-true rest))
                 ((string=? name "#f") (lgot v-false rest))
                 ((string=? name "#u") (lgot v-unit rest))
                 ((string=? name "#eof") (lgot v-eof rest))
                 ((string=? name "#unspecified") (lgot v-unspecified rest))
                 ((string=? name "#default") (lgot v-default rest))
                 ((string=? name "#unbound") (lgot v-unbound rest))
                 (else (begin (listing-error (string-append "a literal tier 1 does not have yet: " name)) (lgot 0 nil))))))
        (else (begin (listing-error (string-append "a literal tier 1 does not read: " (list->string cs))) (lgot 0 nil))))))
  (pair-rest (subr cm (chars i64) lgot)
    (lambda (cs p)
      "A pair's `car . cdr)`, into pair `p`, made already."
      (tagcase (lit-datum cs)
        (lgot (a rest)
          (begin
            (word-set! (address p) a)
            (tagcase (lit-datum (expect rest " . "))
              (lgot (d rest2) (begin (word-set! (i64+ (address p) 1) d) (lgot p (expect rest2 ")"))))))))))
  (lit-items (subr cm (chars (listof i64 @c)) gall)
    (lambda (cs acc)
      "Literals a space apart, to a `)`."
      (let ((cs (spaces-dropped cs)))
        (cond ((null? cs) (begin (listing-error "a literal's items run to the end") (gall nil nil)))
              ((char=? (car cs) close-paren) (gall (the (listof i64 @c) (reverse acc)) (cdr cs)))
              (else (tagcase (lit-datum cs) (lgot (v rest) (lit-items rest (cons v acc))))))))))

"A closure the compiler made, a literal: the listing shows its word, not
 its free values, so it is taken as a closure of none, one for each word,
 and its word checked to read none (`free-read?`) once all are made."
(define literals (ref (listof named @c) @c) (new nil))

(define closure-literal (subr cm (i64) i64)
  (lambda (w)
    (let* ((name (symbol-text (slot-of w f-name)))
           (had (lookup (get literals) name)))
      (if (not (i64= had 0))
          had
          (let ((c (make-bloblet! k-closure 1 0 #t #f)))
            (begin
              (slot-set! c f-word w)
              (set literals (cons (named! name c) (get literals)))
              c))))))

(define-rec
  (free-read? (subr cm (i64 i64) bool)
    (lambda (w k)
      "Whether word `w`, from field `k`, reads a free value: instruction by
       instruction, so that no operand is taken for one."
      (if (i64> k (fields-of w))
          #f
          (let ((cell (slot-of w k)))
            (cond ((not (is-fixnum? cell)) (free-read? w (i64+ k 1)))
                  ((i64= (fix-val cell) r-free) #t)
                  (else (free-read? w (i64+ k (i64+ 1 (operand-count (fix-val cell)))))))))))
  (literals-checked! (subr cm ((listof named @c)) unit)
    (lambda (ls)
      (if (null? ls)
          #u
          (tagcase (car ls)
            (named (n i)
              (if (free-read? (slot-of (named-value (car ls)) f-word) f-cell0)
                  (listing-error (string-append "a closure as a literal, whose word reads a free value: " n))
                  (literals-checked! (cdr ls)))))))))

(define literal (subr cm (chars) i64)
  (lambda (cs)
    (cond ((starts? cs (string-chars "word ")) (word-named (drop-n cs 5)))
          ((starts? cs (string-chars "closure of ")) (closure-literal (word-named (drop-n cs 11))))
          (else (tagcase (lit-datum cs)
                  (lgot (v rest)
                    (if (null? (spaces-dropped rest))
                        v
                        (begin (listing-error (string-append "a literal: " (list->string cs))) 0))))))))

"Register words (C129), by name: a word's register code, read as Fixpt's
 `register_lines` writes it, into a bloblet of kind register-code, as
 Fixpt's `make_register_word` makes one: its entry -1 here (Fixpt's 0,
 not compiled, is `docol` to tier 1), its twin the word."
(define register-words (ref (listof named @c) @c) (new nil))
"Whether a word's twin is its register word, which tier 1 then runs."
(define regs-on (ref bool @c) (new #f))

(define reg-put! (subr cm (i64 i64 i64 i64) unit)
  (lambda (rw at j v) (if (i64= rw 0) #u (slot-set! rw (i64+ f-cell0 (i64+ at j)) v))))

(define reg-instruction! (subr cm (i64 i64 chars) unit)
  (lambda (rw at text)
    "Register instruction `text` at cell `at` of `rw` (0: its literals only
     read, for the labels they make)."
    (let* ((name (list->string (before-char text #\space)))
           (ops (spaces-dropped (drop-n text (string-length-i64 name))))
           (n (index-in rop-names name 0))
           (second (spaces-dropped (after-char ops #\space)))
           (num (lambda ((cs chars)) (fix (number-of cs))))
           (routine (lambda ((cs chars))
                      (let ((r (index-in routine-names (list->string (before-char cs #\space)) 0)))
                        (if (i64< r 0) (begin (listing-error (string-append "no routine is named " (list->string cs))) (the i64 0)) (fix r)))))
           (prim (lambda ((cs chars))
                   (let ((p (prim-number (list->string (before-char cs #\space)))))
                     (if (i64< p 0) (begin (listing-error (string-append "a primitive tier 1 does not have yet: " (list->string cs))) (the i64 0)) (fix p))))))
      (cond
        ((i64< n 0) (listing-error (string-append "no register operation is named " name)))
        (else
         (begin
           (reg-put! rw at 0 (fix n))
           (cond
             ((or (i64= n ro-vargs) (i64= n ro-return)) #u)
             ((i64= n ro-const) (reg-put! rw at 1 (literal ops)))
             ((or (i64= n ro-global) (i64= n ro-setglbl)) (reg-put! rw at 1 (global-named (list->string ops))))
             ((i64= n ro-op1) (reg-put! rw at 1 (routine ops)))
             ((or (i64= n ro-op2) (i64= n ro-cellular)) (begin (reg-put! rw at 1 (routine ops)) (reg-put! rw at 2 (num second))))
             ((i64= n ro-op2imm) (begin (reg-put! rw at 1 (routine ops)) (reg-put! rw at 2 (literal second))))
             ((i64= n ro-prim) (begin (reg-put! rw at 1 (prim ops)) (reg-put! rw at 2 (num second))))
             ((i64= n ro-prim1) (reg-put! rw at 1 (prim ops)))
             ((i64= n ro-prim2) (begin (reg-put! rw at 1 (prim ops)) (reg-put! rw at 2 (num second))))
             ((i64= n ro-prim2imm) (begin (reg-put! rw at 1 (prim ops)) (reg-put! rw at 2 (literal second))))
             ((i64= n ro-prim3imm)
              (begin
                (reg-put! rw at 1 (prim ops))
                (tagcase (lit-datum second)
                  (lgot (v rest) (begin (reg-put! rw at 2 v) (reg-put! rw at 3 (num (spaces-dropped rest))))))))
             ((i64= n ro-lambda)
              (let ((rest (drop-n ops 5)))
                (begin
                  (reg-put! rw at 1 (word-named (before-char rest #\space)))
                  (reg-put! rw at 2 (num (drop-n (after-char rest #\space) 5)))
                  (reg-put! rw at 3 (fix r-closure)))))
             ((or (i64= n ro-branch) (i64= n ro-branchf) (i64= n ro-brancht))
              (reg-put! rw at 1 (fix (i64- (number-of (drop-n ops 2)) (i64+ at 2)))))
             ((i64= n ro-global-guard)
              (let* ((written (after-char (after-char ops #\space) #\space))
                     (to (drop-n (after-char (after-char written #\space) #\space) 2)))
                (begin
                  (reg-put! rw at 1 (global-named (list->string (before-char ops #\space))))
                  (reg-put! rw at 2 (num written))
                  (reg-put! rw at 3 (fix (i64- (number-of to) (i64+ at 4)))))))
             ((i64= (rop-operands n) 1) (reg-put! rw at 1 (num ops)))
             (else (begin (reg-put! rw at 1 (num ops)) (reg-put! rw at 2 (num second)))))))))))

(define cell-set! (subr cm (i64 i64 i64) unit)
  (lambda (w at v) (slot-set! w (i64+ f-cell0 at) v)))

(define instruction! (subr cm (i64 i64 iline) unit)
  (lambda (w rw il)
    (tagcase il
      (iline (at text)
        (if (i64< at 0)
            (reg-instruction! rw (i64- -2 at) text)
        (let* ((name (list->string (before-char text #\space)))
               (ops (spaces-dropped (drop-n text (string-length-i64 name))))
               (n (index-in routine-names name 0)))
          (cond ((string=? name "word") (cell-set! w at (word-named ops)))
                ((i64< n 0) (listing-error (string-append "no routine is named " name)))
                (else
                 (begin
                   (cell-set! w at (fix n))
                   (cond ((i64= n r-lit) (cell-set! w (i64+ at 1) (literal ops)))
                         ((or (i64= n r-branch) (i64= n r-zbranch))
                          (cell-set! w (i64+ at 1) (fix (i64- (number-of (drop-n ops 2)) (i64+ at 2)))))
                         ((or (i64= n r-global) (i64= n r-global-set))
                          (cell-set! w (i64+ at 1) (global-named (list->string ops))))
                         ((i64= n r-prim)
                          (let* ((pname (list->string (before-char ops #\space)))
                                 (p (prim-number pname)))
                            (if (i64< p 0)
                                (listing-error (string-append "a primitive tier 1 does not have yet: " pname))
                                (begin
                                  (cell-set! w (i64+ at 1) (fix p))
                                  (cell-set! w (i64+ at 2) (fix (number-of (after-char ops #\space))))))))
                         ((i64= n r-closure)
                          (let ((rest (drop-n ops 5)))
                            (begin
                              (cell-set! w (i64+ at 1) (word-named rest))
                              (cell-set! w (i64+ at 2) (fix (number-of (drop-n (after-char rest #\space) 5)))))))
                         ((i64= (operand-count n) 1) (cell-set! w (i64+ at 1) (fix (number-of ops))))
                         ((i64= (operand-count n) 0) #u)
                         (else (listing-error (string-append "operands tier 1 does not read yet: " name)))))))))))))

(define-rec
  (chars=? (subr kfx (chars chars) bool)
    (lambda (a b)
      (cond ((null? a) (null? b))
            ((null? b) #f)
            (else (and (char=? (car a) (car b)) (chars=? (cdr a) (cdr b))))))))

(define-rec
  (label-end (subr kfx (chars) chars)
    (lambda (cs) "After a label's digits." (if (and (not (null? cs)) (char-numeric? (car cs))) (label-end (cdr cs)) cs))))

(define-rec
  (unlabelled (subr kfx (chars chars) chars)
    (lambda (cs acc)
      "A line, its labels made (`#N=`) taken out: a word listed twice is the
       same word though its literals were labelled the first time (C123)."
      (cond ((null? cs) (the chars (reverse acc)))
            ((and (char=? (car cs) #\#) (not (null? (cdr cs))) (char-numeric? (car (cdr cs)))
                  (not (null? (label-end (cdr cs)))) (char=? (car (label-end (cdr cs))) #\=))
             (unlabelled (cdr (label-end (cdr cs))) acc))
            (else (unlabelled (cdr cs) (cons (car cs) acc)))))))

(define-rec
  (ilines=? (subr kfx ((listof iline acyclic) (listof iline acyclic)) bool)
    (lambda (a b)
      (cond ((null? a) (null? b))
            ((null? b) #f)
            (else (and (tagcase (car a) (iline (x xs) (tagcase (car b) (iline (y ys) (and (i64= x y) (chars=? (unlabelled xs nil) (unlabelled ys nil)))))))
                       (ilines=? (cdr a) (cdr b))))))))

(define-rec
  (block-named (subr kfx ((listof block acyclic) string) (listof block acyclic))
    (lambda (bs n)
      (cond ((null? bs) nil)
            ((tagcase (car bs) (block (m c e is) (string=? m n))) (the (listof block acyclic) (list (car bs))))
            (else (block-named (cdr bs) n))))))

(define-rec
  (distinct-blocks (subr kfx ((listof block acyclic) (listof block acyclic)) (listof block acyclic))
    (lambda (bs seen)
      "The blocks, a word listed twice, cell for cell the same, once (C122:
       a word reached two ways is listed each time, as words are compared
       by no program, its two copies are one); two that differ, refused."
      (if (null? bs)
          (the (listof block acyclic) (reverse seen))
          (tagcase (car bs)
            (block (n c e is)
              (let ((had (block-named seen n)))
                (cond ((null? had) (distinct-blocks (cdr bs) (cons (car bs) seen)))
                      ((tagcase (car had) (block (m c2 e2 is2) (and (i64= c c2) (i64= e e2) (ilines=? is is2))))
                       (distinct-blocks (cdr bs) seen))
                      (else (begin (listing-error (string-append "two words are named " n)) nil))))))))))

(define-rec
  (register-cells (subr kfx ((listof iline acyclic) i64) i64)
    (lambda (is n)
      "How many cells a word's register code has: past its last instruction."
      (if (null? is)
          n
          (tagcase (car is)
            (iline (at text)
              (if (i64< at -1)
                  (let* ((k (i64- -2 at)) (op (index-in rop-names (list->string (before-char text #\space)) 0))
                         (end (i64+ k (i64+ 1 (if (i64< op 0) 0 (rop-operands op))))))
                    (register-cells (cdr is) (if (i64> end n) end n)))
                  (register-cells (cdr is) n))))))))

(define make-register-word! (subr cm (string i64 i64) i64)
  (lambda (name twin n)
    "A register word of `n` cells, standing for word `twin` (Fixpt's
     `make_register_word`)."
    (let ((w (make-bloblet! k-register-code (i64+ (i64- f-cell0 2) n) 0 #t #t)))
      (begin
        (slot-set! w f-entry (fix -1))
        (slot-set! w f-name (symbol! name))
        (slot-set! w f-twin twin)
        w))))

(define-rec
  (twins-linked! (subr cm ((listof named @c)) unit)
    (lambda (rs)
      "Each register word its word's twin (`--regs`), where tier 1 runs it:
       one entered with its arguments in registers, at most `REGS` of them
       (Fixpt runs the others, `vargs` and more, as stack code too)."
      (if (null? rs)
          #u
          (begin
            (let ((rw (named-value (car rs))))
              (if (and (i64= (slot-of rw f-cell0) (fix ro-args))
                       (i64<= (fix-val (slot-of rw (i64+ f-cell0 1))) register-regs))
                  (slot-set! (slot-of rw f-twin) f-twin rw)
                  #u))
            (twins-linked! (cdr rs)))))))

(define-rec
  (words-made! (subr cm ((listof block acyclic)) unit)
    (lambda (bs)
      "Each block's word, made, its cells not yet written."
      (if (null? bs)
          #u
          (begin
            (tagcase (car bs)
              (block (n c e is)
                (if (not (i64= (lookup (get words) n) 0))
                    (listing-error (string-append "two words are named " n))
                    (let ((w (make-code-word! n c e)) (rc (register-cells is 0)))
                      (begin
                        (set words (cons (named! n w) (get words)))
                        (if (i64> rc 0) (set register-words (cons (named! n (make-register-word! n w rc)) (get register-words))) #u))))))
            (words-made! (cdr bs))))))
  (cells-written! (subr cm (i64 i64 (listof iline acyclic)) unit)
    (lambda (w rw is) (if (null? is) #u (begin (instruction! w rw (car is)) (cells-written! w rw (cdr is))))))
  (literals-read! (subr cm ((listof iline acyclic)) unit)
    (lambda (is)
      "A word listed again: its literals read, for the labels they make, and
       dropped."
      (if (null? is)
          #u
          (begin
            (tagcase (car is)
              (iline (at text)
                (cond ((i64< at 0) (reg-instruction! 0 (i64- -2 at) text))
                      ((starts? text (string-chars "lit ")) (begin (literal (drop-n text 4)) #u))
                      (else #u))))
            (literals-read! (cdr is))))))
  (blocks-written! (subr cm ((listof block acyclic) strings) unit)
    (lambda (bs seen)
      "Every block's cells, in the listing's order, so that a label is made
       where Fixpt writes it first: a word's first listing written into it,
       a later one's literals only read."
      (if (null? bs)
          #u
          (tagcase (car bs)
            (block (n c e is)
              (let ((is (the (listof iline acyclic) (reverse is))))
                (begin
                  (if (string-member? n seen) (literals-read! is) (cells-written! (lookup (get words) n) (lookup (get register-words) n) is))
                  (blocks-written! (cdr bs) (cons n seen))))))))))

(define listing-words! (subr cm (string) i64)
  (lambda (text)
    "The words of a listing, made; the word named `program`."
    (let* ((all (blocks (lines-of (string-chars text) nil nil) nil 0))
           (bs (distinct-blocks all nil)))
      (begin
        (words-made! bs)
        (blocks-written! all nil)
        (literals-checked! (get literals))
        (if (get regs-on) (twins-linked! (get register-words)) #u)
        (let ((p (lookup (get words) "program")))
          (if (i64= p 0) (begin (listing-error "no word is named program") 0) p))))))
