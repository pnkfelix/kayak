"heap.kfx: tier 1's heap, in Fixpt's format (C122): one flat array of
 `i64`, a value `vbase + 8 index + tag` (C139): the word's machine
 address and its tag, as Fixpt's values are, `vbase` the array's address;
 or, with `--indexes`, its index and its tag, `vbase` 0, as Fixpt's
 images have it. Pairs are two words; every other object a bloblet: a
 header, its fields below its suffix (field `k` at `p - k`, the trailer
 field 1, its payload the distance back to the header), its suffix's
 bytes. Collected by Coopt's collector's baseline, below (C122).
 fixpt-source: crates/fixpt-heap/src/heap.rs@b9dae98"

(define mem (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 4096 0)))
"The next free index. Indices 0 to 7 are never an object's."
(define top (ref i64 @c) (new 8))
"How far the heap may be used: the array's length with `--indexes`, which
 is copied to a bigger one to grow; else less than `heap-capacity`, to
 which each space is reserved once (committed as it is touched), so that
 nothing moves but by a collection, which moves every value (C139)."
(define limit (ref i64 @c) (new 4096))
(define heap-capacity i64 268435456)
(define addressed (ref bool @c) (new #f))
"The values' base, this space's and the other's: the arrays' addresses,
 or 0 with `--indexes`."
(define vbase (ref i64 @c) (new 0))
(define to-vbase (ref i64 @c) (new 0))

"A trap's message, or ``: the first one stops the machine."
(define trap-message (ref string @c) (new ""))

(define trap! (subr cm (string) unit)
  (lambda (m) (if (string=? (get trap-message) "") (set trap-message m) #u)))
(define trapped? (subr cm () bool) (lambda () (not (string=? (get trap-message) ""))))

(define-rec
  (copied-into! (subr cm ((flatarrayof i64 @c) (flatarrayof i64 @c) i64 i64) unit)
    (lambda (from to i n)
      (if (i64>= i n)
          #u
          (begin (flatarray-set-i64! to i (flatarray-ref-i64 from i))
                 (copied-into! from to (i64+ i 1) n))))))

(define room! (subr cm (i64) unit)
  (lambda (n)
    "Room for `n` more words: the heap twice as big, if need be; with
     addresses, within the space reserved, else a trap."
    (let ((m (get mem)))
      (cond ((i64<= (i64+ (get top) n) (get limit)) #u)
            ((get addressed)
             (let ((more (i64* 2 (i64+ (get limit) n))))
               (if (i64> (i64+ (get top) n) heap-capacity)
                   (trap! "out of heap")
                   (set limit (if (i64> more heap-capacity) heap-capacity more)))))
            (else
              (let ((bigger (the (flatarrayof i64 @c) (make-flatarray-i64 (i64* 2 (i64+ (flatarray-length-i64 m) n)) 0))))
                (begin (copied-into! m bigger 0 (get top)) (set mem bigger) (set limit (flatarray-length-i64 bigger)))))))))

(define-rec
  (zeroed! (subr cm ((flatarrayof i64 @c) i64 i64) unit)
    (lambda (m i n) (if (i64>= i n) #u (begin (flatarray-set-i64! m i 0) (zeroed! m (i64+ i 1) n))))))

(define alloc! (subr cm (i64) i64)
  (lambda (n)
    "`n` words, each 0 (fixnum 0): the space is used again after a
     collection."
    (begin
      (room! n)
      (let ((at (get top)))
        (begin (set top (i64+ at n)) (zeroed! (get mem) at (i64+ at n)) at)))))

(define word-at (subr cm (i64) i64) (lambda (i) (flatarray-ref-i64 (get mem) i)))
(define word-set! (subr cm (i64 i64) unit) (lambda (i w) (flatarray-set-i64! (get mem) i w)))


"Values."
(define tag-of (subr kfx (i64) i64) (lambda (w) (i64-and w 7)))
(define is-fixnum? (subr kfx (i64) bool) (lambda (w) (i64= (tag-of w) t-fixnum)))
(define is-pair? (subr kfx (i64) bool) (lambda (w) (i64= (tag-of w) t-pair)))
(define is-bloblet? (subr kfx (i64) bool) (lambda (w) (i64= (tag-of w) t-bloblet)))
(define fix (subr kfx (i64) i64) (lambda (n) (i64-shl n 3)))
(define fix-val (subr kfx (i64) i64) (lambda (w) (i64-shr w 3)))
(define address (subr cm (i64) i64) (lambda (w) "A value's index." (i64-shr (i64- w (get vbase)) 3)))
(define heap-ref (subr cm (i64 i64) i64)
  (lambda (i tag) "The value of index `i`, with `tag`." (i64-or (i64+ (i64-shl i 3) (get vbase)) tag)))
"A fixnum's range: 61 bits, signed."
(define fix-max i64 1152921504606846975)
(define fix-min i64 -1152921504606846976)
(define fits? (subr kfx (i64) bool) (lambda (n) (and (i64<= n fix-max) (i64>= n fix-min))))
(define boolean (subr kfx (bool) i64) (lambda (b) (if b v-true v-false)))
(define char-value (subr kfx (i64) i64)
  (lambda (cp) (i64-or (i64-shl cp 8) (i64-or (i64-shl sub-char 3) t-immediate))))
(define is-char? (subr kfx (i64) bool)
  (lambda (w) (and (i64= (tag-of w) t-immediate) (i64= (i64-and (i64-shr w 3) 31) sub-char))))

"Suffix refs."
(define is-sref? (subr kfx (i64) bool) (lambda (w) (i64= (tag-of w) t-suffix-ref)))
(define make-sref (subr kfx (i64 i64) i64)
  (lambda (owner offset)
    "A suffix ref to byte `offset` of the suffix at word `owner`."
    (i64-or (i64-shl offset (i64->int sref-offset-shift)) (i64-or (i64-shl owner 3) t-suffix-ref))))
(define sref-owner (subr cm (i64) i64)
  (lambda (r) "Its owner, a bloblet." (heap-ref (i64-and (i64-shr r 3) sref-owner-mask) t-bloblet)))
(define sref-offset (subr kfx (i64) i64)
  (lambda (r) (i64-and (i64-shr r (i64->int sref-offset-shift)) (i64- sref-offset-limit 1))))

"Pairs."
(define cons! (subr cm (i64 i64) i64)
  (lambda (a d)
    (let ((at (alloc! 2)))
      (begin (word-set! at a) (word-set! (i64+ at 1) d) (heap-ref at t-pair)))))
(define pair-car (subr cm (i64) i64) (lambda (p) (word-at (address p))))
(define pair-cdr (subr cm (i64) i64) (lambda (p) (word-at (i64+ (address p) 1))))

"A list in the heap, of KFX's list of its items."
(define-rec
  (list-of (subr cm ((listof i64 @c)) i64)
    (lambda (xs) (if (null? xs) v-null (cons! (car xs) (list-of (cdr xs)))))))

"Bloblets."
(define header-word (subr kfx (i64 i64 i64 bool bool) i64)
  (lambda (kind fields bytes ff sf)
    (i64-or t-header
      (i64-or (i64-shl kind (with lay header-kind-lo))
        (i64-or (if ff (i64-shl 1 (with lay header-fields-frozen-lo)) 0)
          (i64-or (if sf (i64-shl 1 (with lay header-suffix-frozen-lo)) 0)
            (i64-or (i64-shl fields (with lay header-fields-lo))
                    (i64-shl bytes (with lay header-bytes-lo)))))))))

(define make-bloblet! (subr cm (i64 i64 i64 bool bool) i64)
  (lambda (kind n bytes trailer frozen)
    "A bloblet of `kind`, `n` fields (and a trailer, if `trailer`), each
     fixnum 0, and `bytes` bytes of suffix, 0: a pointer to its suffix."
    (let* ((f (if trailer (i64+ n 1) n))
           (h (alloc! (i64+ (i64+ 1 f) (i64-quotient (i64+ bytes 7) 8))))
           (p (i64+ h (i64+ 1 f))))
      (begin
        (word-set! h (header-word kind f bytes frozen #f))
        (if trailer (word-set! (i64- p 1) (i64-or (i64-shl f 3) t-trailer)) #u)
        (heap-ref p t-bloblet)))))

(define header-of (subr cm (i64) i64)
  (lambda (v)
    "A bloblet's header word: just below its suffix, or as far below as its
     trailer says."
    (let* ((p (address v))
           (w (word-at (i64- p 1))))
      (if (i64= (tag-of w) t-trailer)
          (word-at (i64- (i64- p 1) (i64-shr w 3)))
          w))))

(define header-index (subr cm (i64) i64)
  (lambda (v)
    (let* ((p (address v)) (w (word-at (i64- p 1))))
      (if (i64= (tag-of w) t-trailer) (i64- (i64- p 1) (i64-shr w 3)) (i64- p 1)))))

(define frozen-whole! (subr cm (i64) unit)
  (lambda (v)
    "A bloblet's fields and suffix frozen (Fixpt's `freeze_bloblet`)."
    (let ((h (header-index v)))
      (word-set! h (i64-or (word-at h)
                     (i64-or (i64-shl 1 (with lay header-fields-frozen-lo)) (i64-shl 1 (with lay header-suffix-frozen-lo))))))))

(define bits (subr kfx (i64 int int) i64)
  (lambda (w lo width) (i64-and (i64-shr w lo) (i64- (i64-shl 1 width) 1))))
(define kind-of (subr cm (i64) i64)
  (lambda (v) (bits (header-of v) (with lay header-kind-lo) (with lay header-kind-width))))
(define fields-of (subr cm (i64) i64)
  (lambda (v) (bits (header-of v) (with lay header-fields-lo) (with lay header-fields-width))))
(define bytes-of (subr cm (i64) i64)
  (lambda (v) (bits (header-of v) (with lay header-bytes-lo) (with lay header-bytes-width))))
(define fields-frozen? (subr cm (i64) bool)
  (lambda (v) (i64= 1 (bits (header-of v) (with lay header-fields-frozen-lo) 1))))
(define is-kind? (subr cm (i64 i64) bool)
  (lambda (v k) (and (is-bloblet? v) (i64= (kind-of v) k))))

(define suffix-frozen? (subr cm (i64) bool)
  (lambda (v) (i64= 1 (bits (header-of v) (with lay header-suffix-frozen-lo) 1))))
(define frozen-as! (subr cm (i64 bool bool) unit)
  (lambda (v f sf)
    "A bloblet's fields frozen if `f`, its suffix if `sf` (Fixpt's
     `freeze_bloblet`: it only sets)."
    (let ((h (header-index v)))
      (word-set! h (i64-or (word-at h)
                     (i64-or (if f (i64-shl 1 (with lay header-fields-frozen-lo)) 0)
                             (if sf (i64-shl 1 (with lay header-suffix-frozen-lo)) 0)))))))

"Field `k` of a bloblet, read and written as code that knows its shape
 does (Fixpt's `bloblet_slot`): not checked."
(define slot-of (subr cm (i64 i64) i64) (lambda (v k) (word-at (i64- (address v) k))))
(define slot-set! (subr cm (i64 i64 i64) unit) (lambda (v k x) (word-set! (i64- (address v) k) x)))

"An object `alloc` lays out (Fixpt's `obj_ref`, `obj_set`): its payload
 in order from the header up, the trailer last, so that element `i` is
 field `F - i`, `F` its fields with the trailer."
(define obj-ref (subr cm (i64 i64) i64) (lambda (v i) (slot-of v (i64- (fields-of v) i))))
(define obj-set! (subr cm (i64 i64 i64) unit) (lambda (v i x) (slot-set! v (i64- (fields-of v) i) x)))
(define obj-length (subr cm (i64) i64) (lambda (v) (i64- (fields-of v) 1)))

"Whether field `k` may be read (Fixpt's `field_slot`): one of the
 bloblet's, not its trailer."
(define field-ok? (subr cm (i64 i64) bool)
  (lambda (v k)
    (and (i64> k 0) (i64<= k (fields-of v))
         (not (i64= (tag-of (slot-of v k)) t-trailer)))))

"Strings: a bloblet of no fields, its suffix a word of the length, then
 the code points two to a word, the first in the low half."
(define-rec
  (points-filled! (subr cm (string i64 i64 i64) unit)
    (lambda (s p i n)
      "The code points of `s` from `i` on, into the string at `p`: a
       procedure of its own, as a `letrec`'s closure would be made at each
       call, and never let go (C43)."
      (if (i64>= i n)
          #u
          (let ((at (i64+ p (i64+ 1 (i64-quotient i 2))))
                (cp (char->i64 (string-ref-i64 s i))))
            (begin
              (word-set! at (i64-or (word-at at) (if (i64= (i64-remainder i 2) 0) cp (i64-shl cp 32))))
              (points-filled! s p (i64+ i 1) n)))))))

(define make-string! (subr cm (string) i64)
  (lambda (s)
    (let* ((n (string-length-i64 s))
           (v (make-bloblet! k-string 0 (i64* 8 (i64+ 1 (i64-quotient (i64+ n 1) 2))) #f #f))
           (p (address v)))
      (begin (word-set! p n) (points-filled! s p 0 n) v))))

(define-rec
  (text-chars (subr cm (i64 i64 chars) chars)
    (lambda (v i acc)
      "String `v`'s characters before the `i`th, onto `acc`."
      (if (i64<= i 0)
          acc
          (let* ((j (i64- i 1))
                 (w (word-at (i64+ (address v) (i64+ 1 (i64-quotient j 2)))))
                 (cp (if (i64= (i64-remainder j 2) 0) (i64-and w 4294967295) (i64-and (i64-shr w 32) 4294967295))))
            (text-chars v j (cons (i64->char cp) acc)))))))

(define string-text (subr cm (i64) string)
  (lambda (v)
    "A string's text, as KFX's: made once, of its characters (C151), not a
     string made again for each."
    (list->string (text-chars v (word-at (address v)) nil))))

"Symbols, interned: an object of its name, its hash and its global slot,
 in `alloc`'s order (Fixpt's `intern`), one for each name. Tier 1 keeps
 no global slots: each is 0."
(define-datatype named (named string i64))
(define symbols (ref (listof named @c) @c) (new nil))
(define globals (ref (listof named @c) @c) (new nil))

"A name's value is not in its `named`, which holds where it is: in
 `named-values`, which a collection forwards in place. So a collection
 makes nothing of the runtime's own, which is never let go: a program
 that runs long would otherwise grow by every name at each one."
(define named-values (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 64 0)))
(define named-count (ref i64 @c) (new 0))
(define named! (subr cm (string i64) named)
  (lambda (n v)
    (let ((i (get named-count)) (m (get named-values)))
      (begin
        (if (i64< i (flatarray-length-i64 m))
            #u
            (let ((bigger (the (flatarrayof i64 @c) (make-flatarray-i64 (i64* 2 i) 0))))
              (begin (copied-into! m bigger 0 i) (set named-values bigger))))
        (flatarray-set-i64! (get named-values) i v)
        (set named-count (i64+ i 1))
        (named n i)))))
(define named-value (subr cm (named) i64)
  (lambda (x) (tagcase x (named (m i) (flatarray-ref-i64 (get named-values) i)))))

(define-rec
  (lookup (subr cm ((listof named @c) string) i64)
    (lambda (xs n)
      (cond ((null? xs) 0)
            ((tagcase (car xs) (named (m i) (string=? m n))) (named-value (car xs)))
            (else (lookup (cdr xs) n))))))

(define symbol! (subr cm (string) i64)
  (lambda (name)
    (let ((had (lookup (get symbols) name)))
      (if (not (i64= had 0))
          had
          (let ((s (make-bloblet! k-symbol 3 0 #t #f)))
            (begin
              (obj-set! s 0 (make-string! name))
              (obj-set! s 1 (fix (int->i64 (symbol-name-hash (string->symbol name)))))
              (obj-set! s 2 (fix 0))
              (set symbols (cons (named! name s) (get symbols)))
              s))))))

(define symbol-text (subr cm (i64) string) (lambda (s) (string-text (obj-ref s 0))))

"Words."
(define make-word! (subr cm (string i64 i64) i64)
  (lambda (name n entry)
    "A word of `n` cells, its entry `entry`: its fields frozen, as Fixpt
     publishes a word, each cell written by the reader below."
    (let ((w (make-bloblet! k-code (i64+ n 3) 0 #t #t)))
      (begin
        (slot-set! w f-entry (fix entry))
        (slot-set! w f-name (symbol! name))
        (slot-set! w f-twin v-false)
        w))))

"The collector: Coopt's baseline, a Cheney copy of everything live into
 the other space (`coopt-heap`'s `forward`, `forward_pair`,
 `forward_bloblet`, `cheney`, at Coopt c366857), the spaces swapped, never
 freed (kayak-rt frees nothing): its generations, regions, summaries and
 marking to come, each against this one. A forwarding word, tag 7, holds
 its copy's address: in a pair's first word; in a bloblet's header, and in
 the word just below its suffix when that is no trailer, so that a pointer
 finds it at once (Fixpt's arrangement, Coopt's)."
(define other (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 1 0)))
(define to-top (ref i64 @c) (new 8))
(define collections (ref i64 @c) (new 0))
(define words-copied (ref i64 @c) (new 0))

(define to-at (subr cm (i64) i64) (lambda (i) (flatarray-ref-i64 (get other) i)))
(define to-ref (subr cm (i64 i64) i64)
  (lambda (i tag) "The value of index `i` of the other space, with `tag`." (i64-or (i64+ (i64-shl i 3) (get to-vbase)) tag)))
(define to-address (subr cm (i64) i64) (lambda (w) (i64-shr (i64- w (get to-vbase)) 3)))
(define to-set! (subr cm (i64 i64) unit) (lambda (i w) (flatarray-set-i64! (get other) i w)))
(define to-alloc! (subr cm (i64) i64)
  (lambda (n) (let ((at (get to-top))) (begin (set to-top (i64+ at n)) (set words-copied (i64+ (get words-copied) n)) at))))

(define words-of (subr cm (i64) i64)
  (lambda (head)
    "An object's words, from its header: itself, its fields, its suffix."
    (i64+ (i64+ 1 (bits head (with lay header-fields-lo) (with lay header-fields-width)))
          (i64-quotient (i64+ (bits head (with lay header-bytes-lo) (with lay header-bytes-width)) 7) 8))))

(define-rec
  (copied-words! (subr cm (i64 i64 i64) unit)
    (lambda (from at n)
      (if (i64<= n 0) #u (begin (to-set! at (word-at from)) (copied-words! (i64+ from 1) (i64+ at 1) (i64- n 1)))))))

(define forward-object! (subr cm (i64) i64)
  (lambda (w)
    "The word for `w`, a pair or bloblet, after the collection: its
     object's copy, copied first if need be; itself, if it is no pointer."
    (cond
      ((is-pair? w)
       (let* ((o (address w)) (first (word-at o)))
         (if (i64= (tag-of first) t-forward)
             (to-ref (i64-shr first 3) t-pair)
             (let ((at (to-alloc! 2)))
               (begin
                 (to-set! at first)
                 (to-set! (i64+ at 1) (word-at (i64+ o 1)))
                 (word-set! o (i64-or (i64-shl at 3) t-forward))
                 (to-ref at t-pair))))))
      ((is-bloblet? w)
       (let* ((p (address w)) (before (word-at (i64- p 1))))
         (if (i64= (tag-of before) t-forward)
             (to-ref (i64+ (i64-shr before 3) 1) t-bloblet)
             (let* ((h (if (i64= (tag-of before) t-trailer) (i64- (i64- p 1) (i64-shr before 3)) (i64- p 1)))
                    (head (word-at h)))
               (if (i64= (tag-of head) t-forward)
                   (to-ref (i64+ (i64-shr head 3) (i64- p h)) t-bloblet)
                   (let* ((n (words-of head))
                          (f (bits head (with lay header-fields-lo) (with lay header-fields-width)))
                          (at (to-alloc! n)))
                     (begin
                       (copied-words! h at n)
                       (word-set! h (i64-or (i64-shl at 3) t-forward))
                       (if (and (i64> f 0) (not (i64= (tag-of before) t-trailer)))
                           (word-set! (i64- p 1) (i64-or (i64-shl (i64+ at f) 3) t-forward))
                           #u)
                       (to-ref (i64+ at (i64- p h)) t-bloblet))))))))
      (else w))))

(define forward! (subr cm (i64) i64)
  (lambda (w)
    "As `forward-object!`; a suffix ref, at its owner's copy: Coopt's
     heap has none, Fixpt's collector keeps the owner (`object_of`)."
    (if (is-sref? w)
        (make-sref (to-address (forward-object! (sref-owner w))) (sref-offset w))
        (forward-object! w))))

(define-rec
  (fields-forwarded! (subr cm (i64 i64) unit)
    (lambda (i end)
      (if (i64> i end) #u (begin (to-set! i (forward! (to-at i))) (fields-forwarded! (i64+ i 1) end)))))
  (scanned! (subr cm (i64) unit)
    (lambda (i)
      "Cheney's scan: each object copied, its traced words forwarded, until
       the scan meets the copying."
      (if (i64>= i (get to-top))
          #u
          (let ((w (to-at i)))
            (if (i64= (tag-of w) t-header)
                (let ((f (bits w (with lay header-fields-lo) (with lay header-fields-width))))
                  (begin (fields-forwarded! (i64+ i 1) (i64+ i f)) (scanned! (i64+ i (words-of w)))))
                (begin (fields-forwarded! i (i64+ i 1)) (scanned! (i64+ i 2)))))))))

(define-rec
  (named-forwarded! (subr cm (i64) unit)
    (lambda (i)
      "Every name's value from `i` on, forwarded in place."
      (if (i64>= i (get named-count))
          #u
          (let ((m (get named-values)))
            (begin (flatarray-set-i64! m i (forward! (flatarray-ref-i64 m i))) (named-forwarded! (i64+ i 1))))))))

(define collect-begin! (subr cm () unit)
  (lambda ()
    "The other space made ready, as big as this one: the roots are then
     forwarded (`forward!`), then `collect-end!`."
    (begin
      (if (and (not (get addressed)) (i64< (flatarray-length-i64 (get other)) (flatarray-length-i64 (get mem))))
          (set other (the (flatarrayof i64 @c) (make-flatarray-i64 (flatarray-length-i64 (get mem)) 0)))
          #u)
      (set to-top 8)
      (named-forwarded! 0))))

(define collect-end! (subr cm () unit)
  (lambda ()
    "Everything the roots reach, copied; the spaces swapped; the space grown,
     both, if what lives fills more than half."
    (begin
      (scanned! 8)
      (let ((old (get mem)))
        (begin
          (set mem (get other))
          (set other old)
          (let ((b (get vbase))) (begin (set vbase (get to-vbase)) (set to-vbase b)))
          (if (get addressed) #u (set limit (flatarray-length-i64 (get mem))))
          (set top (get to-top))
          (set collections (i64+ (get collections) 1))
          (if (i64> (i64* 2 (get top)) (get limit))
              (room! (get limit))
              #u))))))
