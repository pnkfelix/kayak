"hand-x64.kfx: tier 2's machine on x86_64 (C136): hand.kfx's, routine for
 routine, emitted with FX-26's own x86_64 encoder (`fx26:x86_64.fx`), as
 Fixpt keeps its x86_64 machine beside its arm64 one (`cellular/x64.rs`).
 The same state, the same stacks, the same giving back; only the code
 differs, kept as close to hand.kfx's as the two instruction sets allow:
 the same routines in the same order, the same steps.

 What x86_64 changes, as Fixpt's does:
 - Fewer registers. As Fixpt's table: `r14` the ip, `r13` `cur`, `r12`
   the data stack's top, `rbx` the return stack's, `r15` the state,
   `rbp` the frame, `r9` `clo`; and `r10` the heap's base, which Fixpt's
   machine has not (its values are addresses) and this one has (tier 1's
   are offsets). Scratch: `rax` for hand.kfx's `x9`, `rdi`, `rsi`, `rcx`,
   `rdx`, `r8`, `r11` for `x10`, `x11`, `x13` … `x16`. The fuel lives in
   the state, counted down there, as Fixpt's; so do the data stack's
   base and the cell being run, which hand.kfx keeps in registers.
 - Variable-length instructions: code is placed in bytes, and every
   branch to a label is a 32-bit one, never out of reach.
 - `r15` is the native convention's pinned state: kept on the machine
   stack, with every other register the machine uses, and given back.
 - Tiers 4 and 5 (`--compiled`): hand.kfx's, at the same places, by the
   same tables; register code's `RESULT` in `rax`, `REG1` in `rdi`,
   `REG2` in `r14`, the rest in the state, its link there too while a
   word runs, calls by `call` and `ret` (C137).
 - Tier 6 (`--direct`): register code as native procedures beside tier
   5's, leaving for it where it would give back (C138).
 fixpt-source: crates/fixpt-native/src/cellular/x64.rs@4caffc2"

(define x86 (load-input "fx26:x86_64.fx"))

"Registers, as the hardware numbers them."
(define y-mem int 10)
(define y-ip int 14)
(define y-cur int 13)
(define y-dsp int 12)
(define y-rsp int 3)
(define y-st int 15)
(define y-fp int 5)
(define y-clo int 9)
(define y-w int 0)
(define y10 int 7)
(define y11 int 6)
(define y13 int 1)
(define y14 int 2)
(define y15 int 8)
(define y16 int 11)
"The native convention's: its arguments, and its fourth's place in its
 state."
(define y-rdi int 7)
(define y-rsi int 6)
(define y-r8 int 8)
(define y-reg4 int 616)

"Conditions, as `x86_64.fx` numbers them."
(define q-o int 0)
(define q-b int 2)
(define q-ae int 3)
(define q-e int 4)
(define q-ne int 5)
(define q-be int 6)
(define q-a int 7)
(define q-l int 12)

"Arithmetic and shifts, as `x86-alu` and `x86-shift-imm` take them."
(define a-add int 0)
(define a-or int 1)
(define a-and int 4)
(define a-sub int 5)
(define a-cmp int 7)
(define s-shl int 4)
(define s-shr int 5)
(define s-sar int 7)

"The state's elements this machine keeps that hand.kfx keeps in
 registers: the data stack's base, the cell being run, and register
 code's link (hand.kfx's `x30`; 0 for none)."
(define st-dsb int 30)
(define st-cell int 31)
(define st-link int 32)

"Code: bytes, and jumps to labels (`jmp`, `jcc`, `lea` of `rip`), each
 32-bit, placed when every label is; data, a label's offset from the
 code's start (8 bytes); and no-ops to the next 8-byte place, where a
 point that is returned to starts (a link in a frame reads as a fixnum)."
(define-datatype x-item (xb (listof int @k)) (xj int int int) (xl int) (xo int) (xa int))
(define y-jmp int 0)
(define y-jcc int 1)
(define y-lea int 2)
(define y-call int 3)

(define y-items (ref (listof x-item @c) @c) (new nil))
(define ye! (->* ((listof int @k)) unit) (lambda (bs) (set y-items (cons (xb bs) (get y-items)))))
(define ybind! (->* (int) unit) (lambda (l) (set y-items (cons (xl l) (get y-items)))))
(define yb! (->* (int) unit) (lambda (l) (set y-items (cons (xj y-jmp 0 l) (get y-items)))))
(define ybc! (->* (int int) unit) (lambda (c l) (set y-items (cons (xj y-jcc c l) (get y-items)))))
(define yadr! (->* (int int) unit) (lambda (r l) (set y-items (cons (xj y-lea r l) (get y-items)))))
(define yalign! (->* (int) unit)
  (lambda (n) "No-ops, so that the `n` bytes next end 8-aligned." (set y-items (cons (xa n) (get y-items)))))
(define ycall! (->* (int) unit) (lambda (l) (set y-items (cons (xj y-call 0 l) (get y-items)))))
"Data, placed before the code: 8 bytes an entry."
(define y-data (ref (listof x-item @c) @c) (new nil))
(define yd! (->* (int) unit) (lambda (v) (set y-data (cons (xb ((with x86 x86-le8) v)) (get y-data)))))
(define ydo! (->* (int) unit) (lambda (l) (set y-data (cons (xo l) (get y-data)))))
(define ydata-label! (->* (int) unit) (lambda (l) (set y-data (cons (xl l) (get y-data)))))

(define-rec
  (y-length (->* ((listof int @k) int) int) (lambda (bs n) (if (null? bs) n (y-length (cdr bs) (+ n 1))))))

(define y-size (->* (x-item int) int)
  (lambda (x at)
    (tagcase x
      (xb (bs) (y-length bs 0))
      (xj (k a l) (cond ((or (= k y-jmp) (= k y-call)) 5) ((= k y-jcc) 6) (else 7)))
      (xo (l) 8)
      (xa (z) (modulo (- 8 (modulo (+ at z) 8)) 8))
      (xl (l) 0))))

(define-rec
  (y-placed! (->* ((listof x-item @c) int (flatarrayof i64 @c)) int)
    (lambda (xs at ls)
      "Each label's place, in bytes, in `ls`; how many bytes there are."
      (if (null? xs)
          at
          (tagcase (car xs)
            (xl (l) (begin (flatarray-set-i64! ls (int->i64 l) (int->i64 at)) (y-placed! (cdr xs) at ls)))
            (else x (y-placed! (cdr xs) (+ at (y-size x at)) ls)))))))

(define y-encoded (->* (x-item int (flatarrayof i64 @c)) (listof int @k))
  (lambda (x at ls)
    "Item `x`, at byte `at`: a jump by its label's distance from its end."
    (tagcase x
      (xb (bs) bs)
      (xj (k a l)
        (let ((d (- (where ls l) (+ at (y-size x at)))))
          (cond ((= k y-jmp) ((with x86 x86-jmp) d))
                ((= k y-jcc) ((with x86 x86-jcc) a d))
                ((= k y-call) ((with x86 x86-call) d))
                (else ((with x86 x86-lea-rip) a d)))))
      (xo (l) ((with x86 x86-le8) (where ls l)))
      (xa (z) ((with x86 x86-nops) (y-size x at)))
      (xl (l) nil))))

"Instructions, by `x86_64.fx`'s encoders."
(define ymov! (->* (int int) unit) (lambda (d s) (ye! ((with x86 x86-mov) d s))))
(define yld! (->* (int int int) unit) (lambda (d b o) (ye! ((with x86 x86-load) d b o))))
(define yst! (->* (int int int) unit) (lambda (b o s) (ye! ((with x86 x86-store) b o s))))
(define yld-ix! (->* (int int int int) unit) (lambda (d b i o) (ye! ((with x86 x86-load-ix) d b i 1 o))))
(define ylea! (->* (int int int) unit) (lambda (d b o) (ye! ((with x86 x86-lea) d b o))))
(define ylea-ix! (->* (int int int int int) unit) (lambda (d b i s o) (ye! ((with x86 x86-lea-ix) d b i s o))))
(define yimm! (->* (int int) unit) (lambda (d i) (ye! ((with x86 x86-mov-imm) d i))))
(define yalu! (->* (int int int) unit) (lambda (op d s) (ye! ((with x86 x86-alu) op d s))))
(define yalui! (->* (int int int) unit) (lambda (op d i) (ye! ((with x86 x86-alu-imm) op d i))))
(define yalurm! (->* (int int int int) unit) (lambda (op d b o) (ye! ((with x86 x86-alu-rm) op d b o))))
(define yalumi! (->* (int int int int) unit) (lambda (op b o i) (ye! ((with x86 x86-alu-mi) op b o i))))
(define ytesti! (->* (int int) unit) (lambda (r i) (ye! ((with x86 x86-test-imm) r i))))

"The heap by values (C139): with addresses, a value is its object's
 address and its tag; with indices, its offset from `r10`, the heap's
 base."
(define yld-v! (->* (int int int) unit)
  (lambda (d v o) (if (get addressed) (yld! d v o) (yld-ix! d y-mem v o))))
(define ylea-v! (->* (int int int) unit)
  (lambda (d v o) (if (get addressed) (ylea! d v o) (ylea-ix! d y-mem v 1 o))))
(define yvalued! (->* (int) unit)
  (lambda (d) "The address in `d` as a value, less its tag." (if (get addressed) #u (yalu! a-sub d y-mem))))

(define yshift! (->* (int int int) unit) (lambda (op d i) (ye! ((with x86 x86-shift-imm) op d i))))
(define ycmov! (->* (int int int) unit) (lambda (c d s) (ye! ((with x86 x86-cmov) c d s))))
(define yjmp-r! (->* (int) unit) (lambda (r) (ye! ((with x86 x86-jmp-r) r))))
(define ypush! (->* (int) unit) (lambda (r) (ye! ((with x86 x86-push) r))))
(define ypop! (->* (int) unit) (lambda (r) (ye! ((with x86 x86-pop) r))))
(define yret! (->* () unit) (lambda () (ye! ((with x86 x86-ret)))))
(define yneg! (->* (int) unit) (lambda (r) (ye! ((with x86 x86-neg) r))))
(define ycall-r! (->* (int) unit) (lambda (r) (ye! ((with x86 x86-call-r) r))))
(define ypush-st! (->* (int) unit) (lambda (i) (ye! ((with x86 x86-push-m) y-st (at-st i)))))
(define ypop-st! (->* (int) unit) (lambda (i) (ye! ((with x86 x86-pop-m) y-st (at-st i)))))
(define yzero! (->* (int) unit)
  (lambda (i) "The state's element `i` 0." (ye! ((with x86 x86-store-imm) y-st -1 1 (at-st i) 0))))

"Shorthands: the state's element `i`; a register, its tag checked; a
 field extracted."
(define yst-ld! (->* (int int) unit) (lambda (d i) (yld! d y-st (at-st i))))
(define yst-st! (->* (int int) unit) (lambda (i s) (yst! y-st (at-st i) s)))
(define ycmp-st! (->* (int int) unit) (lambda (r i) (yalurm! a-cmp r y-st (at-st i))))
(define ypushed! (->* (int) unit)
  (lambda (r) "`r` pushed on the data stack." (begin (yst! y-dsp 0 r) (yalui! a-add y-dsp 8))))
(define yubfx! (->* (int int int int) unit)
  (lambda (d n lsb mask)
    "`d` := `n`'s bits from `lsb`, `mask` of them."
    (begin (if (= d n) #u (ymov! d n)) (yshift! s-shr d lsb) (yalui! a-and d mask))))

(define ygive-if! (->* (int) unit) (lambda (c) "Give the cell back if `c`." (ybc! c (get l-give))))
(define ynext! (->* () unit)
  (lambda () "On to the next cell." (yb! (if (< (get h-cont) 0) (get l-next) (get h-cont)))))
(define ytaken! (->* () unit)
  (lambda () "On to a branch's target, the ip moved to it." (yb! (if (< (get h-target) 0) (get l-next) (get h-target)))))
(define yresume! (->* () unit) (lambda () "On to the cell at the ip, of `cur`." (yb! (get l-resume))))

(define ytag-in! (->* (int int) unit)
  (lambda (r tag) "Given back unless `r`'s tag is `tag`." (begin (ymov! y13 r) (yalui! a-and y13 7) (yalui! a-cmp y13 tag) (ygive-if! q-ne))))

(define yneed! (->* (int) unit)
  (lambda (n)
    "At least `n` values on the data stack (1 or 2), else give back."
    (if (= n 1)
        (begin (ycmp-st! y-dsp st-dsb) (ygive-if! q-be))
        (begin (yst-ld! y13 st-dsb) (yalui! a-add y13 8) (yalu! a-cmp y-dsp y13) (ygive-if! q-be)))))

(define yroom! (->* () unit)
  (lambda () "Room to push one, else give back." (begin (ycmp-st! y-dsp st-ds-end) (ygive-if! q-ae))))

(define ylimits! (->* () unit)
  (lambda ()
    "Within the limits tier 1's `check-limits!` holds to, else give back."
    (begin (ycmp-st! y-dsp st-ds-lim) (ygive-if! q-a) (ycmp-st! y-rsp st-rs-lim) (ygive-if! q-ae))))

(define yput-top! (->* (int) unit)
  (lambda (r) "Two values replaced by `r`." (begin (yalui! a-sub y-dsp 8) (yst! y-dsp -8 r) (ynext!))))

(define yboolean-of! (->* (int) unit)
  (lambda (c) "`rcx` := `#t` if `c`, else `#f`." (begin (yimm! y13 3) (yimm! y14 11) (ycmov! c y13 y14))))

(define ytwo-fixnums! (->* () unit)
  (lambda ()
    "`rcx` the one below the top, `rdx` the top; both fixnums, else give back."
    (begin
      (yneed! 2) (yld! y13 y-dsp -16) (yld! y14 y-dsp -8)
      (ymov! y15 y13) (yalu! a-or y15 y14) (ytesti! y15 7) (ygive-if! q-ne))))

(define yip-op! (->* (int) unit)
  (lambda (d) "`d` the operand at the ip, the ip past it." (begin (yld! d y-ip 0) (yalui! a-sub y-ip 8))))

(define ykind-in! (->* (int i64) unit)
  (lambda (r kind)
    "`rsi` the heap's address of the value in `r` plus 4; given back unless
     it is a bloblet with a trailer whose header says `kind`."
    (begin
      (ytag-in! r 4)
      (ylea-v! y11 r 0) (yld! y15 y11 -12)
      (ymov! y13 y15) (yalui! a-and y13 7) (yalui! a-cmp y13 5) (ygive-if! q-ne)
      (ymov! y14 y11) (yalu! a-sub y14 y15) (yld! y14 y14 -7) (yubfx! y14 y14 3 255)
      (yalui! a-cmp y14 (i64->int kind)) (ygive-if! q-ne))))

(define yframe-pushed! (->* (int int) unit)
  (lambda (t u)
    "A return entry for `cur` at the ip, as tier 1's: `cur`, the ip's
     distance back from the word's address, the frame's from the data
     stack's base, `clo`; `t` and `u` scratch. Given back if there is no
     room for it."
    (begin
      (ycmp-st! y-rsp st-rs-end) (ygive-if! q-ae)
      (ylea-v! t y-cur -4) (yalu! a-sub t y-ip)
      (ymov! u y-fp) (yalurm! a-sub u y-st (at-st st-dsb))
      (yst! y-rsp 0 y-cur) (yst! y-rsp 8 t) (yst! y-rsp 16 u) (yst! y-rsp 24 y-clo) (yalui! a-add y-rsp 32))))

(define-rec
  (yargs-loaded! (->* (int int) unit)
    (lambda (r loaded)
      "`REGr`… from the frame, as many as the count in `rax` (times 8)."
      (if (> r 8)
          #u
          (begin
            (yalui! a-cmp y-w (* 8 r)) (ybc! q-b loaded)
            (yld! y14 y-fp (* 8 (- r 1))) (yst-st! (+ st-regs r) y14)
            (yargs-loaded! (+ r 1) loaded))))))

(define-rec
  (ystate-regs-zeroed! (->* (int) unit)
    (lambda (r) "`REGr`… to `REG8` 0, in the state." (if (> r 8) #u (begin (yzero! (+ st-regs r)) (ystate-regs-zeroed! (+ r 1)))))))

(define yadapted! (->* () unit)
  (lambda ()
    "hand.kfx's `h-adapted!`: a call of a word whose twin is register code
     of as many arguments (`--regs`, C129), entered as tier 1's `call!`
     enters it; `RESULT` and `REG1`… in the state, `RESULT` in `rax` too."
    (let ((done (label!)) (loaded (label!)))
      (begin
        (yld-v! y13 y-cur (at-field f-twin)) (yalui! a-cmp y13 3) (ybc! q-e done)
        (yld-v! y15 y13 (at-field (i64+ f-cell0 1))) (yalu! a-cmp y15 y-w) (ybc! q-ne done)
        (ystate-regs-zeroed! 0)
        (yargs-loaded! 1 loaded)
        (ybind! loaded)
        (yimm! y-w 0)
        (ymov! y-dsp y-fp) (ymov! y-cur y13)
        (ylea-v! y-ip y-cur (- -4 (* 8 (+ (i64->int f-cell0) 2))))
        (ybind! done)))))

(define ycalled! (->* (bool) unit)
  (lambda (tail)
    "A call of the closure on top with the `count` values below it (tier
     1's `call!`), in tail position its frame slid down over this one's;
     the count, times 8, in `rax`, which `yadapted!` reads."
    (let ((loop (label!)) (done (label!)))
      (begin
        (yip-op! y-w)
        (ylea-ix! y14 y-fp y-w 1 8) (yalu! a-cmp y-dsp y14) (ygive-if! q-b)
        (yld! y10 y-dsp -8)
        (ykind-in! y10 k-closure)
        (ylimits!)
        (if tail
            (begin
              (ylea! y14 y-dsp -8) (ymov! y15 y14) (yalu! a-sub y15 y-w) (ymov! y16 y-fp)
              (ybind! loop) (yalu! a-cmp y15 y14) (ybc! q-ae done)
              (yld! y13 y15 0) (yalui! a-add y15 8) (yst! y16 0 y13) (yalui! a-add y16 8) (yb! loop)
              (ybind! done) (ylea-ix! y-dsp y-fp y-w 1 0))
            (begin
              (yframe-pushed! y14 y15)
              (yalui! a-sub y-dsp 8) (ymov! y-fp y-dsp) (yalu! a-sub y-fp y-w)))
        (yld! y-cur y11 (at-field f-word))
        (ymov! y-clo y10)
        (ylea-v! y-ip y-cur (- -4 (* 8 (i64->int f-cell0))))
        (yadapted!)
        (yresume!)))))

(define yfields-of! (->* () unit)
  (lambda ()
    "`r8` eight times the fields of the bloblet whose address plus 4 is in
     `rsi`, `rdx` eight times the lowest that may be read: past a trailer,
     its distance, 2; past a header, its count, 1; else given back."
    (let ((header (label!)) (done (label!)))
      (begin
        (yld! y15 y11 -12) (ymov! y14 y15) (yalui! a-and y14 7) (yalui! a-cmp y14 5) (ybc! q-ne header)
        (yalui! a-sub y15 5) (yimm! y14 16) (yb! done)
        (ybind! header)
        (yalui! a-cmp y14 6) (ygive-if! q-ne)
        (yubfx! y15 y15 14 262143) (yshift! s-shl y15 3) (yimm! y14 8)
        (ybind! done)))))

(define yfield-read! (->* () unit)
  (lambda ()
    "`r11` field `rcx / 8` of the bloblet at `rsi`, if it may be read (tier
     1's `field-ok?`), else given back."
    (begin
      (yfields-of!)
      (yalu! a-cmp y13 y14) (ygive-if! q-l) (yalu! a-cmp y13 y15) (ygive-if! q-a)
      (ymov! y16 y11) (yalu! a-sub y16 y13) (yld! y16 y16 -4))))

(define yallocating! (->* (int int) unit)
  (lambda (words count8)
    "Room for an object of `words` words more than `count8 / 8` (`count8`
     a register, or -1 for none): `rcx` the heap's `top`, `r11` its
     address. Given back if tier 1's `safepoint!` would collect first, or
     `room!` grow the heap."
    (begin
      (yst-ld! y13 st-top) (ycmp-st! y13 st-alloc-limit) (ygive-if! q-a)
      (ylea! y15 y13 words)
      (if (< count8 0) #u (begin (ymov! y14 count8) (yshift! s-shr y14 3) (yalu! a-add y15 y14)))
      (ycmp-st! y15 st-mem-length) (ygive-if! q-a)
      (if (get addressed) (begin (ymov! y16 y13) (yshift! s-shl y16 3)) (ylea-ix! y16 y-mem y13 8 0))
      (yalurm! a-add y16 y-st (at-st st-vbase)))))

(define yconsed! (->* (bool) unit)
  (lambda (region)
    "`cons`, or `%region-cons` (its region below the two, and dropped):
     the pair at the heap's top, as tier 1's `cons!` makes it."
    (begin
      (if region
          (begin (yst-ld! y13 st-dsb) (yalui! a-add y13 24) (yalu! a-cmp y-dsp y13) (ygive-if! q-b))
          (yneed! 2))
      (yallocating! 2 -1)
      (yld! y14 y-dsp -16) (yld! y15 y-dsp -8) (yst! y16 0 y14) (yst! y16 8 y15)
      (ylea! y15 y13 2) (yst-st! st-top y15)
      (if region (yalui! a-sub y-dsp 8) #u)
      (ymov! y14 y16) (yvalued! y14) (yalui! a-add y14 1)
      (yput-top! y14))))

(define yprimed! (->* () unit)
  (lambda ()
    "`prim P COUNT`: those primitives the machine has, else given back."
    (let ((region-cons (label!)))
      (begin
        (yip-op! y13) (yip-op! y-w)
        (ymov! y14 y13) (yshift! s-shr y14 19)
        (yalui! a-cmp y14 (i64->int o-region-cons)) (ybc! q-e region-cons)
        (yb! (get l-give))
        (ybind! region-cons)
        (yalui! a-cmp y-w 24) (ygive-if! q-ne)
        (yconsed! #t)))))

(define yclosed! (->* () unit)
  (lambda ()
    "`closure W COUNT`: a cellular closure of word `W` over the `COUNT`
     values on top, as tier 1's `make-bloblet!` lays it out: its header,
     its fields (`count + 2`, the trailer one), its trailer."
    (let ((loop (label!)) (done (label!)))
      (begin
        (yroom!)
        (yip-op! y10) (yip-op! y-w)
        (ylea-ix! y14 y-fp y-w 1 0) (yalu! a-cmp y-dsp y14) (ygive-if! q-b)
        (yallocating! 3 y-w)
        (yimm! y15 (+ 6 (* 8 (i64->int k-closure))))
        (ymov! y14 y-w) (yshift! s-shr y14 3) (yalui! a-add y14 2) (yshift! s-shl y14 14) (yalu! a-or y15 y14)
        (yst! y16 0 y15)
        (ylea-ix! y11 y16 y-w 1 24)
        (ylea! y14 y-w 21) (yst! y11 -8 y14)
        (yst! y11 -16 y10)
        (ymov! y15 y-dsp) (yalu! a-sub y15 y-w) (ylea! y16 y11 -24)
        (ybind! loop) (yalu! a-cmp y15 y-dsp) (ybc! q-ae done)
        (yld! y14 y15 0) (yalui! a-add y15 8) (yst! y16 0 y14) (yalui! a-sub y16 8) (yb! loop)
        (ybind! done)
        (yalu! a-sub y-dsp y-w)
        (ymov! y14 y-w) (yshift! s-shr y14 3) (yalu! a-add y14 y13) (yalui! a-add y14 3) (yst-st! st-top y14)
        (ymov! y14 y11) (yvalued! y14) (yalui! a-add y14 4) (ypushed! y14)
        (ynext!)))))

(define yword-entered! (->* () unit)
  (lambda ()
    "The word in `rax`, a cell, entered as tier 1's `enter!` does, if its
     entry is `docol` or past the routines (compiled)."
    (let ((docol (label!)))
     (begin
      (ytag-in! y-w 4)
      (ylea-v! y11 y-w 0)
      (yld! y10 y11 (at-field f-entry))
      (yalui! a-cmp y10 (* 8 (i64->int r-docol))) (ybc! q-e docol)
      (yalui! a-cmp y10 (* 8 (i64->int r-count))) (ygive-if! q-b)
      (ybind! docol)
      (ylimits!)
      (ytag-in! y-cur 4)
      (yframe-pushed! y13 y14)
      (ymov! y-cur y-w)
      (ylea! y-ip y11 (- -4 (* 8 (i64->int f-cell0))))
      (yresume!)))))

(define ycar-cdr! (->* (bool) unit)
  (lambda (first)
    "`car` if `first`, else `cdr`."
    (begin
      (yneed! 1) (yld! y13 y-dsp -8) (ymov! y14 y13) (yalui! a-and y14 7) (yalui! a-cmp y14 1) (ygive-if! q-ne)
      (yld-v! y16 y13 (if first -1 7))
      (yst! y-dsp -8 y16) (ynext!))))

(define yentered! (->* (int) unit)
  (lambda (n)
    "Routine number `n`'s code; what it does not do it gives back."
    (cond
      ((= n (i64->int r-lit))
       (begin (yroom!) (yip-op! y13) (ypushed! y13) (ynext!)))
      ((= n (i64->int r-dup))
       (begin (yneed! 1) (yroom!) (yld! y13 y-dsp -8) (ypushed! y13) (ynext!)))
      ((= n (i64->int r-drop)) (begin (yneed! 1) (yalui! a-sub y-dsp 8) (ynext!)))
      ((= n (i64->int r-swap))
       (begin (yneed! 2) (yld! y13 y-dsp -8) (yld! y14 y-dsp -16) (yst! y-dsp -16 y13) (yst! y-dsp -8 y14) (ynext!)))
      ((= n (i64->int r-over))
       (begin (yneed! 2) (yroom!) (yld! y13 y-dsp -16) (ypushed! y13) (ynext!)))
      ((= n (i64->int r-eq))
       (begin (yneed! 2) (yld! y13 y-dsp -16) (yld! y14 y-dsp -8) (yalu! a-cmp y13 y14) (yboolean-of! q-e) (yput-top! y13)))
      ((or (= n (i64->int r-add)) (= n (i64->int r-int-add)))
       (begin (ytwo-fixnums!) (yalu! a-add y13 y14) (ygive-if! q-o) (yput-top! y13)))
      ((or (= n (i64->int r-sub)) (= n (i64->int r-int-sub)))
       (begin (ytwo-fixnums!) (yalu! a-sub y13 y14) (ygive-if! q-o) (yput-top! y13)))
      ((or (= n (i64->int r-less)) (= n (i64->int r-int-less)))
       (begin (ytwo-fixnums!) (yalu! a-cmp y13 y14) (yboolean-of! q-l) (yput-top! y13)))
      ((= n (i64->int r-int-eq))
       (begin (ytwo-fixnums!) (yalu! a-cmp y13 y14) (yboolean-of! q-e) (yput-top! y13)))
      ((or (= n (i64->int r-car)) (= n (i64->int r-pair-car))) (ycar-cdr! #t))
      ((or (= n (i64->int r-cdr)) (= n (i64->int r-pair-cdr))) (ycar-cdr! #f))
      ((= n (i64->int r-slot))
       (begin
         (yip-op! y13) (ylea-ix! y14 y-fp y13 1 0)
         (ycmp-st! y14 st-dsb) (ygive-if! q-b) (yalu! a-cmp y14 y-dsp) (ygive-if! q-ae)
         (yroom!) (yld! y15 y14 0) (ypushed! y15) (ynext!)))
      ((= n (i64->int r-slot-set))
       (begin
         (yneed! 1) (yip-op! y13) (ylea-ix! y14 y-fp y13 1 0) (ylea! y15 y-dsp -8)
         (ycmp-st! y14 st-dsb) (ygive-if! q-b) (yalu! a-cmp y14 y15) (ygive-if! q-ae)
         (yld! y16 y-dsp -8) (yst! y14 0 y16) (ymov! y-dsp y15) (ynext!)))
      ((= n (i64->int r-global))
       (begin
         (yroom!) (yip-op! y13)
         (yld-v! y15 y13 (at-field f-value)) (ypushed! y15) (ynext!)))
      ((= n (i64->int r-branch))
       (begin (ylimits!) (yip-op! y13) (yalu! a-sub y-ip y13) (ytaken!)))
      ((= n (i64->int r-zbranch))
       (let ((taken (label!)))
         (begin
           (yneed! 1) (yld! y14 y-dsp -8) (yalui! a-cmp y14 3)
           (ybc! q-e taken)
           (yalui! a-sub y-dsp 8) (yalui! a-sub y-ip 8) (ynext!)
           (ybind! taken)
           (ylimits!) (yalui! a-sub y-dsp 8) (yip-op! y13) (yalu! a-sub y-ip y13) (ytaken!))))
      ((or (= n (i64->int r-call)) (= n (i64->int r-tcall)))
       (ycalled! #f))
      ((or (= n (i64->int r-tailcall)) (= n (i64->int r-ttailcall)))
       (ycalled! #t))
      ((= n (i64->int r-free))
       (begin
         (yroom!) (ytag-in! y-clo 4)
         (yip-op! y13) (yalui! a-add y13 (* 8 (i64->int f-free0)))
         (ylea-v! y11 y-clo 0)
         (yfield-read!) (ypushed! y16) (ynext!)))
      ((= n (i64->int r-field))
       (begin
         (yneed! 1) (yip-op! y10) (yld! y16 y-dsp -8)
         (ytag-in! y16 4) (ylea-v! y11 y16 0) (ymov! y13 y10)
         (yfield-read!) (yst! y-dsp -8 y16) (ynext!)))
      ((= n (i64->int r-global-set))
       (begin
         (yneed! 1) (yip-op! y13) (ylea-v! y14 y13 0)
         (yld! y15 y-dsp -8) (yst! y14 (at-field f-value) y15)
         (yalumi! a-add y14 (at-field f-writes) 8)
         (yalui! a-sub y-dsp 8) (ynext!)))
      ((= n (i64->int r-field-ref))
       (begin
         (yneed! 2) (yld! y10 y-dsp -8) (ytesti! y10 7) (ygive-if! q-ne)
         (yld! y16 y-dsp -16) (ytag-in! y16 4) (ylea-v! y11 y16 0) (ymov! y13 y10)
         (yfield-read!) (yput-top! y16)))
      ((= n (i64->int r-cons)) (yconsed! #f))
      ((= n (i64->int r-prim)) (yprimed!))
      ((= n (i64->int r-closure)) (yclosed!))
      ((= n (i64->int r-exit))
       (begin (ycmp-st! y-rsp st-rsb) (ygive-if! q-e) (yb! (get l-pop-return))))
      ((= n (i64->int r-return))
       (begin
         (yneed! 1) (ylea! y15 y-dsp -8) (yalu! a-cmp y15 y-fp) (ygive-if! q-b)
         (ycmp-st! y-rsp st-rsb) (ygive-if! q-e)
         (yld! y13 y-dsp -8) (ymov! y-dsp y-fp) (ypushed! y13)
         (yb! (get l-pop-return))))
      (else (yb! (get l-give))))))

(define-rec
  (ytable! (->* (int int) unit)
    (lambda (n base)
      "A jump to each routine's code, by number, 5 bytes each: routine
       `n`'s label is `base + n`."
      (if (>= n (i64->int r-count)) #u (begin (yb! (+ base n)) (ytable! (+ n 1) base))))))

(define-rec
  (yroutines! (->* (int int) unit)
    (lambda (n base)
      (if (>= n (i64->int r-count))
          #u
          (begin (ybind! (+ base n)) (yentered! n) (yroutines! (+ n 1) base))))))

"The registers the machine uses that the native convention's caller may
 need, `r15` its state: kept on the machine stack."
(define ykept! (->* () unit)
  (lambda () (begin (ypush! y-fp) (ypush! y-rsp) (ypush! y-dsp) (ypush! y-cur) (ypush! y-ip) (ypush! y-st))))
(define yrestored! (->* () unit)
  (lambda () (begin (ypop! y-st) (ypop! y-ip) (ypop! y-cur) (ypop! y-dsp) (ypop! y-rsp) (ypop! y-fp))))

(define yat-entry! (->* (int int int) unit)
  (lambda (length base at)
    "The state's `at` its `length` element as an address past `base`."
    (begin (yst-ld! y14 length) (yshift! s-shl y14 3) (yalu! a-add y14 base) (yst-st! at y14))))

(define yentry! (->* () unit)
  (lambda ()
    "From the native convention: the state, the heap and the data stack
     in `rdi`, `rsi`, `r8`, the return stack in its state's `reg4`, each a
     flat array's suffix (tag 4)."
    (begin
      (ykept!)
      (yld! y13 y-st y-reg4)
      (ylea! y-st y-rdi -4) 
      (if (get addressed) #u (begin (ylea! y-mem y-rsi -4) (yalurm! a-sub y-mem y-st (at-st st-vbase))))
      (ylea! y15 y-r8 -4) (yst-st! st-dsb y15)
      (ylea! y13 y13 -4) (yst-st! st-rsb y13)
      ;; The limits, as addresses.
      (yat-entry! st-ds-limit y15 st-ds-lim)
      (yat-entry! st-rs-limit y13 st-rs-lim)
      (yat-entry! st-ds-length y15 st-ds-end)
      (yat-entry! st-rs-push y13 st-rs-end)
      ;; The registers.
      (yst-ld! y-cur st-cur)
      (yst-ld! y14 st-kk) (yshift! s-shl y14 3) (ylea-v! y-ip y-cur -4) (yalu! a-sub y-ip y14)
      (yst-ld! y14 st-fp) (yshift! s-shl y14 3) (ylea-ix! y-fp y15 y14 1 0)
      (yst-ld! y-clo st-clo)
      (yst-ld! y14 st-dsp) (yshift! s-shl y14 3) (ylea-ix! y-dsp y15 y14 1 0)
      (yst-ld! y14 st-rsp) (yshift! s-shl y14 3) (ylea-ix! y-rsp y13 y14 1 0)
      ;; The code 16-byte aligned, as kayak-jit seals it, else out at once.
      (yadr! y16 (get l-start)) (yst-st! st-start y16)
      (ytesti! y16 15) (ybc! q-ne (get l-misaligned))
      (yresume!))))

(define yleave! (->* (i64) unit)
  (lambda (why)
    "The registers back in the state, the cell being run `kk`'s, and out,
     with `why`, a fixnum."
    (begin
      (yst-st! st-cur y-cur)
      (yst-ld! y16 st-cell) (ylea-v! y13 y-cur -4) (yalu! a-sub y13 y16) (yshift! s-sar y13 3) (yst-st! st-kk y13)
      (ymov! y13 y-fp) (yalurm! a-sub y13 y-st (at-st st-dsb)) (yshift! s-shr y13 3) (yst-st! st-fp y13)
      (yst-st! st-clo y-clo)
      (ymov! y13 y-dsp) (yalurm! a-sub y13 y-st (at-st st-dsb)) (yshift! s-shr y13 3) (yst-st! st-dsp y13)
      (ymov! y13 y-rsp) (yalurm! a-sub y13 y-st (at-st st-rsb)) (yshift! s-shr y13 3) (yst-st! st-rsp y13)
      (yimm! 0 (i64->int (fix why)))
      (yrestored!)
      (yret!))))

"Register code's registers, where they are while it runs (C137)."
(define y-reg-in (->* (int) int)
  (lambda (k)
    "The machine register `REGk` is in while register code runs, or -1
     for one in the state: `REG0` in `clo`, `REG1` in `rdi`, which
     register code does not use as scratch, `REG2` in `r14`, the ip's
     register, which it does not use either; with addresses (C139),
     `REG3` in `r10`, the heap's base with indices."
    (cond ((= k 0) y-clo) ((= k 1) y10) ((= k 2) y-ip) ((and (= k 3) (get addressed)) y-mem) (else -1))))
(define yreg-ld! (->* (int int) unit)
  (lambda (d k)
    "`d` := `REGk`."
    (let ((r (y-reg-in k))) (if (< r 0) (yst-ld! d (+ st-regs k)) (if (= r d) #u (ymov! d r))))))
(define yreg-st! (->* (int int) unit)
  (lambda (k s)
    "`REGk` := `s`."
    (let ((r (y-reg-in k))) (if (< r 0) (yst-st! (+ st-regs k) s) (if (= r s) #u (ymov! r s))))))
(define yreg-of! (->* (int int) int)
  (lambda (k tmp) "A register `REGk` is in: its own, or `tmp`, loaded." (let ((r (y-reg-in k))) (if (< r 0) (begin (yld! tmp y-st (at-st (+ st-regs k))) tmp) r))))

(define-rec
  (yregs-out! (->* (int) unit)
    (lambda (k)
      "`REGk`… to `REG8` that are in machine registers, to the state."
      (if (> k 8) #u (begin (if (< (y-reg-in k) 0) #u (yst-st! (+ st-regs k) (y-reg-in k))) (yregs-out! (+ k 1)))))))
(define-rec
  (yregs-in! (->* (int) unit)
    (lambda (k)
      "`REGk`… to `REG8` that are in machine registers, from the state."
      (if (> k 8) #u (begin (if (< (y-reg-in k) 0) #u (yst-ld! (y-reg-in k) (+ st-regs k))) (yregs-in! (+ k 1)))))))
(define yleft! (->* () unit)
  (lambda ()
    "Register code left for the machine: `RESULT` and the registers in
     machine registers kept in the state, as tier 1 keeps them."
    (begin (yst-st! st-regs y-w) (yregs-out! 1))))
(define yentered-reg! (->* () unit)
  (lambda ()
    "Register code entered from the machine: `RESULT` and the registers in
     machine registers from the state."
    (begin (yst-ld! y-w st-regs) (yregs-in! 1))))
(define-rec
  (yregs-zeroed! (->* (int) unit)
    (lambda (k)
      "`REGk`… to `REG8` 0, where they are."
      (if (> k 8) #u (begin (if (< (y-reg-in k) 0) (yzero! (+ st-regs k)) (yimm! (y-reg-in k) 0)) (yregs-zeroed! (+ k 1)))))))

(define yresumed! (->* () unit)
  (lambda ()
    "hand.kfx's `resumed!`: going on at the ip, a cell of `cur`'s, its code
     if `cur` was compiled and has code for that cell, else the cell
     interpreted (`NEXT`); by the same tables, at the same places."
    (let ((neg (label!)) (plain (label!)))
      (begin
        (ybind! (get l-resume))
        ;; Entered so, register code has no link: it returns the stack's way.
        (yzero! st-link)
        (ymov! y13 y-cur) (yalui! a-and y13 7) (yalui! a-cmp y13 4) (ybc! q-ne (get l-next))
        (ylea-v! y11 y-cur 0) (yld! y10 y11 (at-field f-entry))
        (yalui! a-cmp y10 (* 8 (i64->int r-count))) (ybc! q-b (get l-next))
        (yalui! a-sub y10 (* 8 (i64->int r-count)))
        ;; Past the words compiled (a register word's entry is -1): given
        ;; back, at the cell the ip is at.
        (yadr! y16 (get l-words)) (yalurm! a-cmp y10 y16 0) (ybc! q-ae (get l-resume-give))
        (yld-ix! y14 y16 y10 8)
        (yadr! y16 (get l-start)) (yalu! a-add y16 y14)
        (ylea! y15 y11 -4) (yalu! a-sub y15 y-ip)
        (yld! y14 y16 0)
        (yalui! a-cmp y15 0) (ybc! q-l neg)
        (yalu! a-cmp y15 y14) (ybc! q-ae (get l-next))
        (yld-ix! y14 y16 y15 8) (yalui! a-cmp y14 0) (ybc! q-e (get l-next))
        ;; A register word's way in, from field 0 of its table (never a
        ;; cell's): its registers from the state, then on; stack code's 0.
        (yld! y15 y16 8)
        (yadr! y16 (get l-start)) (yalu! a-add y16 y14)
        (yalui! a-cmp y15 0) (ybc! q-e plain)
        (yadr! y13 (get l-start)) (yalu! a-add y13 y15) (yjmp-r! y13)
        (ybind! plain) (yjmp-r! y16)
        ;; Below 0, register code's point to resume at after a call: the
        ;; table's second half; past it, a poll's, given back.
        (ybind! neg)
        (yneg! y15) (yalu! a-cmp y15 y14) (ybc! q-ae (get l-resume-give))
        (yalu! a-add y16 y14) (yld-ix! y14 y16 y15 8) (yalui! a-cmp y14 0) (ybc! q-e (get l-resume-give))
        (yadr! y16 (get l-start)) (yalu! a-add y16 y14) (yjmp-r! y16)))))

(define ymachine! (->* () unit)
  (lambda ()
    "The whole machine: its entry, `NEXT`, the ways out, the table, and a
     routine for each number."
    (let ((word (label!)) (table (label!)) (skip (label!)) (loop (label!)) (base (get hand-labels)))
      (begin
        (set hand-labels (+ base (i64->int r-count)))
        (set l-next (label!)) (set l-give (label!)) (set l-give-pre (label!)) (set l-ran-out (label!)) (set l-pop-return (label!))
        (set l-resume (label!)) (set l-resume-give (label!)) (set l-misaligned (label!))
        (ybind! (get l-entry))
        (yentry!)
        (yresumed!)
        ;; NEXT: the cell, as tier 1's `run!` takes it: none if out of fuel
        ;; (tier 1 then polls or stops), else one step's fuel spent; the
        ;; fuel in the state, as Fixpt's x86_64 machine keeps it.
        (ybind! (get l-next))
        (yst-st! st-cell y-ip)
        (yalumi! a-sub y-st (at-st st-fuel) 1)
        (ygive-if! q-b)
        (yip-op! y-w)
        (ytesti! y-w 7)
        (ybc! q-ne word)
        (yalui! a-cmp y-w (* 8 (i64->int r-count)))
        (ygive-if! q-ae)
        (ymov! y10 y-w) (yshift! s-shr y10 3) (ylea-ix! y10 y10 y10 4 0)
        (yadr! y16 table)
        (yalu! a-add y16 y10)
        (yjmp-r! y16)
        (ybind! word)
        (yword-entered!)
        ;; Giving back: the step's fuel returned, if it was spent.
        (ybind! (get l-give))
        (yalumi! a-add y-st (at-st st-fuel) 1)
        (ybind! (get l-give-pre))
        (yleave! gave-back)
        (ybind! (get l-ran-out))
        (yleave! ran-out)
        (ybind! (get l-misaligned))
        (yst-st! st-cell y-ip) (yleave! misaligned)
        (ybind! (get l-resume-give))
        (yst-st! st-cell y-ip) (yb! (get l-give-pre))
        ;; A return, as tier 1's `pop-return!`: a prompt's or a mark's entry
        ;; passed by.
        (ybind! (get l-pop-return))
        (ybind! loop)
        (ycmp-st! y-rsp st-rsb) (ybc! q-be (get l-ran-out))
        (yld! y13 y-rsp -32)
        (yalui! a-cmp y13 (i64->int prompt-mark-word)) (ybc! q-e skip)
        (yalui! a-cmp y13 (i64->int mark-mark-word)) (ybc! q-e skip)
        (ymov! y-cur y13)
        (yld! y14 y-rsp -24) (yld! y15 y-rsp -16) (yld! y-clo y-rsp -8) (yalui! a-sub y-rsp 32)
        (ylea-v! y-ip y-cur -4) (yalu! a-sub y-ip y14)
        (ymov! y-fp y15) (yalurm! a-add y-fp y-st (at-st st-dsb))
        (yresume!)
        (ybind! skip)
        (yalui! a-sub y-rsp 32) (yb! loop)
        (ybind! table)
        (ytable! 0 base)
        (yroutines! 0 base)))))

"Tier 4 (C128) on x86_64: each of the listing's words compiled, cell by
 cell, to its routine's code, as hand.kfx's `word-compiled!`, the same
 tables of where to resume at the same places."
(define-rec
  (ycells-compiled! (->* (i64 i64 i64 (flatarrayof i64 @c) int) unit)
    (lambda (w i n at base)
      "Cell `i` on of word `w`, of `n`, each start's code at label `base +
       i`: `NEXT`'s step, then its routine with the next cell's code and a
       branch's target's for its `NEXT`; a word, entered."
      (if (i64>= i n)
          #u
          (if (not (i64= (flatarray-ref-i64 at i) 1))
              (ycells-compiled! w (i64+ i 1) n at base)
              (let ((c (slot-of w (i64+ f-cell0 i))) (nx (next-start at (i64+ i 1) n)))
                (begin
                  (ybind! (+ base (i64->int i)))
                  (yst-st! st-cell y-ip) (yalumi! a-sub y-st (at-st st-fuel) 1) (ygive-if! q-b) (yip-op! y-w)
                  (set h-cont (+ base (i64->int nx)))
                  (set h-target -1)
                  (cond ((not (is-fixnum? c)) (yword-entered!))
                        ((and (i64>= (fix-val c) 0) (i64< (fix-val c) r-count))
                         (begin
                           (if (or (i64= (fix-val c) r-branch) (i64= (fix-val c) r-zbranch))
                               (let ((t (i64+ i (i64+ 2 (fix-val (slot-of w (i64+ f-cell0 (i64+ i 1))))))))
                                 (if (and (i64>= t 0) (i64< t n) (i64= (flatarray-ref-i64 at t) 1))
                                     (set h-target (+ base (i64->int t)))
                                     #u))
                               #u)
                           (yentered! (i64->int (fix-val c)))))
                        (else (yb! (get l-give))))
                  (ycells-compiled! w nx n at base))))))))

(define-rec
  (y-resume-table! (->* ((flatarrayof i64 @c) int i64 i64) unit)
    (lambda (at base n k)
      "A word's table of where to resume, from cell `k`: the offset of its
       code, if it starts one, else 0."
      (if (i64>= k (i64+ f-cell0 n))
          #u
          (begin
            (if (and (i64>= k f-cell0) (i64= (flatarray-ref-i64 at (i64- k f-cell0)) 1))
                (ydo! (+ base (i64->int (i64- k f-cell0))))
                (yd! 0))
            (y-resume-table! at base n (i64+ k 1)))))))

(define-rec
  (y-zeros! (->* (i64) unit) (lambda (k) "`k` entries of 0." (if (i64<= k 0) #u (begin (yd! 0) (y-zeros! (i64- k 1)))))))

(define yword-compiled! (->* (i64 int int) unit)
  (lambda (w n-cells rt)
    "Word `w` compiled; `rt` the label of its table of where to resume."
    (let* ((n (int->i64 n-cells))
           (at (the (flatarrayof i64 @c) (make-flatarray-i64 (i64+ n 1) 0)))
           (base (get hand-labels)))
      (begin
        (set hand-labels (+ base (+ n-cells 1)))
        (starts! w 0 n at)
        (ycells-compiled! w 0 n at base)
        (ybind! (+ base n-cells)) (yb! (get l-next))
        (set h-cont -1) (set h-target -1)
        (ydata-label! rt)
        (yd! (* 8 (i64->int (i64+ f-cell0 n))))
        (y-resume-table! at base n 0)
        (y-zeros! (i64+ f-cell0 n))))))

"Tier 5 (C130) on x86_64: register words compiled, as hand.kfx's
 `register-compiled!`, instruction for instruction. What x86_64 changes
 (C137): `RESULT` is `rax`, `REG1` `rdi`, `REG2` `r14`, and `REG3`…`REG8`
 stay where tier 1 keeps them, in the state (`REG0` is `clo`, as ever),
 for this machine has no more registers to spare (its values are
 offsets, its heap's base pinned); an instruction's place is made only
 when it gives back, by a stub of its own; the
 link is the state's `st-link`, as hand.kfx's `x30`, while the word runs.
 A call is a `call`, the callee popping the link from the machine stack
 at once; a return pushes it back and `ret`s; a call in tail position
 pushes its own link and jumps, for the callee to pop. So each `ret`
 pairs with its `call`, as the processor predicts returns (C137)."
(define yopnd! (->* (int i64 int) unit)
  (lambda (d kk j)
    "Operand `j` of the instruction at field `kk` of the running word."
    (yld-v! d y-cur (- (- -4 (* 8 (i64->int kk))) (* 8 (+ j 1))))))

(define yop2-fast! (->* (i64 int) unit)
  (lambda (r y)
    "`RESULT` := cellular routine `r` of `RESULT` and `y`, on fixnums; past
     them, or of another routine, given back."
    (cond ((i64= r r-eq) (begin (yalu! a-cmp y-w y) (yboolean-of! q-e) (ymov! y-w y13)))
          ((or (i64= r r-int-add) (i64= r r-add) (i64= r r-int-sub) (i64= r r-sub))
           (begin
             (ymov! y15 y-w) (yalu! a-or y15 y) (ytesti! y15 7) (ygive-if! q-ne)
             (ymov! y15 y-w)
             (yalu! (if (or (i64= r r-int-add) (i64= r r-add)) a-add a-sub) y15 y)
             (ygive-if! q-o) (ymov! y-w y15)))
          ((or (i64= r r-int-less) (i64= r r-less) (i64= r r-int-eq))
           (begin
             (ymov! y15 y-w) (yalu! a-or y15 y) (ytesti! y15 7) (ygive-if! q-ne)
             (yalu! a-cmp y-w y) (yboolean-of! (if (i64= r r-int-eq) q-e q-l)) (ymov! y-w y13)))
          (else (yb! (get l-give))))))

(define yreturn-pushed! (->* (i64) unit)
  (lambda (nx)
    "A return entry to this word's point after a call, `-nx`: given back
     if there is no room for it."
    (begin
      (ycmp-st! y-rsp st-rs-end) (ygive-if! q-ae)
      (yimm! y13 (- 0 (* 8 (i64->int nx)))) (ymov! y14 y-fp) (yalurm! a-sub y14 y-st (at-st st-dsb))
      (yst! y-rsp 0 y-cur) (yst! y-rsp 8 y13) (yst! y-rsp 16 y14) (yst! y-rsp 24 y-clo) (yalui! a-add y-rsp 32))))

(define-rec
  (yfrees-stored! (->* (int int) unit)
    (lambda (r n)
      (if (> r n) #u (begin (yreg-ld! y14 r) (yst! y11 (- -24 (* 8 (- r 1))) y14) (yfrees-stored! (+ r 1) n))))))

(define-rec
  (yfill-false! (->* (int) unit)
    (lambda (m) (if (<= m 0) #u (begin (ypushed! y13) (yfill-false! (- m 1)))))))

"Fixpt's convention for tier 5 (`--fixpt-calls`, C140): a callee leaves
 the point to return to where its `call` put it, on the machine stack,
 until `save` moves it to the frame (and to `st-link`, as ever, from
 there), and a leaf returns by it there; the machine stack is never more
 than that link deep. Where it was lost (a call before `save`, or a way
 in from the machine), a 0 there stands for it, a return then the
 stack's way. Whether it is there as an instruction is compiled; and by
 instruction, for the ways in made after."
(define hand-fixpt-calls (ref bool @c) (new #f))
(define y-machine-sp int 4)
(define h-5-pushed (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 1 0)))
(define h-stubs (ref int @c) (new -1))
(define y-pushed? (->* () bool) (lambda () (and (get hand-fixpt-calls) (< (get h-link) 0))))
(define y-pushed-at? (->* (i64) bool)
  (lambda (i) (and (get hand-fixpt-calls) (i64= (flatarray-ref-i64 (get h-5-pushed) i) 1))))
(define ylink-dropped! (->* () unit)
  (lambda () "Leaving for the machine: the link, if it is on the machine stack, dropped." (if (y-pushed?) (yalui! a-add y-machine-sp 8) #u)))
(define yno-link-pushed! (->* () unit) (lambda () (begin (yimm! y13 0) (ypush! y13))))

(define ylink-reloaded! (->* (int) unit)
  (lambda (m)
    "The link again, after a call: from the frame; before `save`, none."
    (cond ((>= m 0) (begin (yld! y13 y-fp (* 8 m)) (yst-st! st-link y13)))
          ((get hand-fixpt-calls) (yno-link-pushed!))
          (else (yzero! st-link)))))

"A register word's entry for a call: the link popped, then its first
 instruction past `args`. Placed just before that instruction's code, so
 found from it (`yentry-address!`); the tables' way in to that instruction,
 by a jump, is past it."
(define y-link-popped (->* () (listof int @k)) (lambda () ((with x86 x86-pop-m) y-st (at-st st-link))))
(define h-call-entry (ref int @c) (new -1))

(define ycalled-to! (->* (int int) unit)
  (lambda (l r)
    "A call, by `call`, to label `l`, or to the address in `r` if `l` is
     -1: a callee's entry for a call, which pops the point after it into
     the link. That point 8-aligned, a link in a frame read as a fixnum."
    (begin
      (ylink-dropped!)
      (if (< l 0) (begin (yalign! (y-length ((with x86 x86-call-r) r) 0)) (ycall-r! r)) (begin (yalign! 5) (ycall! l)))
      (ylink-reloaded! (get h-link)))))

(define ytail-called! (->* (int) unit)
  (lambda (r)
    "A call in tail position to the address in `r`, a callee's entry for a
     call: this word's link pushed for it to pop."
    (begin (if (y-pushed?) #u (ypush-st! st-link)) (yjmp-r! r))))

(define yentry-address! (->* (int int) unit)
  (lambda (r none)
    "`r11` register word `r`'s entry for a call, by the tables past the
     code's start (field 2 of its own); to `none` if it has none."
    (begin
      (yst-ld! y13 st-start)
      (yld-v! y15 r (at-field f-entry))
      (yalui! a-cmp y15 (* 8 (i64->int r-count))) (ybc! q-b none)
      (yalui! a-sub y15 (* 8 (i64->int r-count)))
      (yalurm! a-cmp y15 y13 8) (ybc! q-ae none)
      (yld-ix! y14 y13 y15 16)
      (ylea-ix! y16 y13 y14 1 0) (yld! y14 y16 24)
      (ylea-ix! y16 y13 y14 1 0))))

(define-rec
  (yargs-pushed! (->* (int int) unit)
    (lambda (r n) (if (> r n) #u (begin (yreg-ld! y14 r) (ypushed! y14) (yargs-pushed! (+ r 1) n))))))

"The labels of a register word's ways to give back, by instruction:
 instruction `i`'s `h-gbase + 2i`, past its step's fuel `h-gbase + 2i + 1`."
(define h-gbase (ref int @c) (new 0))

(define-rec
  (ygive-stubs! (->* (i64 i64 (flatarrayof i64 @c) int) unit)
    (lambda (i n starts give-pre)
      "For each instruction from `i`, and past the last, its ways to give
       back: its place in `r11`, then the word's."
      (if (i64> i n)
          #u
          (begin
            (if (or (i64= i n) (i64= (flatarray-ref-i64 starts i) 1))
                (begin
                  (ybind! (+ (get h-gbase) (* 2 (i64->int i)))) (yalumi! a-add y-st (at-st st-fuel) 1)
                  (ybind! (+ (get h-gbase) (+ 1 (* 2 (i64->int i)))))
                  (ylea-v! y16 y-cur (- -4 (* 8 (i64->int (i64+ f-cell0 i)))))
                  (if (y-pushed-at? i) (yalui! a-add y-machine-sp 8) #u)
                  (yb! give-pre))
                #u)
            (ygive-stubs! (i64+ i 1) n starts give-pre))))))

"Tier 6 (C138): register words compiled a second time, as native
 procedures, beside their tier 5 code: the same registers (`RESULT` in
 `rax`, `REG1` in `rdi`, `REG2` in `r14`, the rest in the state), the same
 frames on the data stack, but none of what keeps tier 1's state exact at
 every instruction. Fuel is spent a block at a time (exactly as many
 steps as tier 1's); a call is a `call` with a record on the machine
 stack, `(ret nx fp clo cur)` from its top, of what the caller would have
 pushed on the return stack, whose place there is kept (`rbx` moved past
 it) but not written; and nothing is given back. What tier 6 would give
 back, it leaves instead: the records written to the return stack as the
 entries they stand for (`l-materialize`), the fuel not spent given back,
 then on in tier 5 at the same instruction, whose code says what tier 1
 would do. What allocates is here only as tier 5 makes it, at the heap's
 top (`cons`, `%region-cons`, a closure of its registers, C147): where
 tier 5 would give back to collect first, tier 6 leaves, so the collector
 never sees a record. Entered by a call from tier 5 (its entry for a call
 diverted to `adapter`), over a bottom record, `(1 1)`, that says so.
 Which words, their blocks and their labels are hand.kfx's, shared."
(define l-materialize-pushed (ref int @c) (new 0))

(define y6-called! (->* (int int int i64) unit)
  (lambda (l r new-cur nx)
    "A call of tier 6 code at label `l`, or if it is -1 at the address in
     `r`, `cur` then `new-cur`
     (a register, or -1 for this one), the closure in `rax` (none for
     `invokeself`): the caller's record pushed, its place on the return
     stack kept, and after it, all popped."
    (begin
      (ylimits!) (ycmp-st! y-rsp st-rs-end) (ygive-if! q-ae)
      (ypush! y-cur) (ypush! y-clo) (ypush! y-fp)
      (yimm! y13 (- 0 (* 8 (i64->int (i64+ f-cell0 nx))))) (ypush! y13)
      (yalui! a-add y-rsp 32)
      (if (< new-cur 0) #u (begin (ymov! y-clo y-w) (ymov! y-cur new-cur)))
      (if (< l 0) (ycall-r! r) (ycall! l))
      (yalui! a-add y-machine-sp 8) (ypop! y-fp) (ypop! y-clo) (ypop! y-cur)
      (yalui! a-sub y-rsp 32))))

(define y6-invoked! (->* (bool int i64) unit)
  (lambda (tail n nx)
    "`invoke n` (or `tailinvoke`) of the closure in `rax`, if its word's
     twin has tier 6 code of `n` arguments; else out, to tier 5."
    (begin
      (ykind-in! y-w k-closure)
      (yld! y13 y11 (at-field f-word)) (yld-v! y16 y13 (at-field f-twin))
      (yalui! a-cmp y16 3) (ygive-if! q-e)
      (yld-v! y15 y16 (at-field (i64+ f-cell0 1))) (yalui! a-cmp y15 (* 8 n)) (ygive-if! q-ne)
      ;; Its tier 6 code: field 1 of its table, by the tables past the
      ;; code's start.
      (yld-v! y15 y16 (at-field f-entry))
      (yalui! a-cmp y15 (* 8 (i64->int r-count))) (ygive-if! q-b)
      (yalui! a-sub y15 (* 8 (i64->int r-count)))
      (yadr! y13 (get l-words)) (yalurm! a-cmp y15 y13 0) (ygive-if! q-ae)
      (yld-ix! y14 y13 y15 8)
      (yadr! y13 (get l-start)) (yalu! a-add y14 y13) (yld! y14 y14 16)
      (yalui! a-cmp y14 0) (ygive-if! q-e)
      (yalu! a-add y14 y13)
      (if tail
          (begin (ylimits!) (ymov! y-clo y-w) (ymov! y-cur y16) (yjmp-r! y14))
          (y6-called! -1 y14 y16 nx)))))

(define y6-returned! (->* () unit)
  (lambda ()
    "`return`: to the caller's code; over the bottom record, out, to tier
     5's, which returns to tier 5's caller."
    (begin (yalumi! a-cmp y-machine-sp 8 1) (ygive-if! q-e) (yret!))))

(define-rec
  (y6-exits! (->* (i64 i64 (flatarrayof i64 @c) (flatarrayof i64 @c) (flatarrayof i64 @c) (flatarrayof i64 @c)) unit)
    (lambda (i n starts at of len)
      "Each instruction's way out: the fuel of its block not spent given
       back (it, and those after it), the records written, on in tier 5
       at it."
      (if (i64>= i n)
          #u
          (begin
            (if (and (i64>= i 2) (i64= (flatarray-ref-i64 starts i) 1))
                (let ((back (i64- (flatarray-ref-i64 len (flatarray-ref-i64 of i)) (flatarray-ref-i64 at i))))
                  (begin
                    (ybind! (+ (get h-6-exits) (i64->int i)))
                    (if (i64> back 0) (yalumi! a-add y-st (at-st st-fuel) (i64->int back)) #u)
                    (yadr! y16 (+ (get h-6-tier5) (i64->int i)))
                    (yb! (if (y-pushed-at? i) (get l-materialize-pushed) (get l-materialize)))))
                #u)
            (y6-exits! (i64+ i 1) n starts at of len))))))

(define y-materialize! (->* (int bool) unit)
  (lambda (l pushed)
    "Tier 6 left, for tier 5's code at `r11`: each record, from the
     innermost, written in the place it kept on the return stack, as the
     entry it stands for; all popped, the bottom record too; the link
     tier 5's caller gave, if the code left is that call's, else none;
     with `pushed`, that link on the machine stack too (`--fixpt-calls`,
     code before `save`)."
    (let ((loop (label!)) (done (label!)) (inner (label!)) (out (label!)))
      (begin
        (ybind! l)
        (ymov! y11 y-machine-sp) (ymov! y14 y-rsp)
        (ybind! loop)
        (yalumi! a-cmp y11 8 1) (ybc! q-e done)
        (yalui! a-sub y14 32)
        (yld! y13 y11 32) (yst! y14 0 y13)
        (yld! y13 y11 8) (yst! y14 8 y13)
        (yld! y13 y11 16) (yalurm! a-sub y13 y-st (at-st st-dsb)) (yst! y14 16 y13)
        (yld! y13 y11 24) (yst! y14 24 y13)
        (yalui! a-add y11 40) (yb! loop)
        (ybind! done)
        (yalu! a-cmp y11 y-machine-sp) (ybc! q-ne inner)
        (yst-ld! y13 st-t6link) (yst-st! st-link y13) (yb! out)
        (ybind! inner) (yzero! st-link)
        (ybind! out) (ylea! y-machine-sp y11 16)
        (if pushed (ypush-st! st-link) #u)
        (yjmp-r! y16)))))

(define yreg-body! (->* (i64 i64 i64 int (flatarrayof i64 @c)) unit)
  (lambda (rw i n base resumes)
    "What register instruction `i` of `rw`'s `n` cells does, its
     instructions at labels from `base`, for tier 5, or for tier 6 if
     `h-6`; for tier 5, a point after a call marked in `resumes`."
    (let* ((kk (i64+ f-cell0 i))
           (op (fix-val (slot-of rw kk)))
           (o (lambda ((j int)) (fix-val (slot-of rw (i64+ kk (int->i64 (+ j 1)))))))
           (nx (i64+ i (i64+ 1 (rop-operands op))))
           (to (lambda ((ops int) (off i64)) (t6-to base (i64+ i (i64+ (int->i64 (+ ops 1)) off))))))
      (begin
        (cond
          ((or (i64= op ro-args) (i64= op ro-vargs)) #u)
          ((i64= op ro-const) (yopnd! y-w kk 0))
          ((i64= op ro-global) (begin (yopnd! y16 kk 0) (yld-v! y-w y16 (at-field f-value))))
          ((i64= op ro-setglbl)
           (begin
             (yopnd! y16 kk 0) (ylea-v! y16 y16 0) (yst! y16 (at-field f-value) y-w)
             (yalumi! a-add y16 (at-field f-writes) 8)))
          ((i64= op ro-reg) (yreg-ld! y-w (i64->int (o 0))))
          ((i64= op ro-setreg) (yreg-st! (i64->int (o 0)) y-w))
          ((i64= op ro-movereg) (begin (yreg-ld! y16 (i64->int (o 0))) (yreg-st! (i64->int (o 1)) y16)))
          ((i64= op ro-lexical)
           (begin
             (ytag-in! y-clo 4) (ylea-v! y11 y-clo 0)
             (yimm! y13 (* 8 (i64->int (i64+ f-free0 (o 0))))) (yfield-read!) (ymov! y-w y16)))
          ((i64= op ro-save)
           (let ((m (i64->int (o 0))))
             (begin
               (ylea! y16 y-dsp (* 8 (+ m 1)))
               (ycmp-st! y16 st-ds-lim) (ygive-if! q-a)
               (ycmp-st! y16 st-ds-end) (ygive-if! q-a)
               (ycmp-st! y-rsp st-rs-lim) (ygive-if! q-ae)
               (ymov! y-fp y-dsp) (yimm! y13 3)
               (if (<= m 16)
                   (yfill-false! m)
                   (let ((loop (label!)))
                     (begin (ylea! y15 y16 -8) (ybind! loop) (ypushed! y13) (yalu! a-cmp y-dsp y15) (ybc! q-b loop))))
               ;; The link: 8-aligned, a fixnum to the collector; tier 6's
               ;; none, its frames returning the stack's way once left.
               (cond ((get h-6) (yimm! y13 0))
                     ((y-pushed?) (begin (ypop! y13) (yst-st! st-link y13)))
                     (else (yst-ld! y13 st-link)))
               (ypushed! y13)
               (set h-link m))))
          ((i64= op ro-pop)
           (begin (ylea! y16 y-dsp (* -8 (+ (i64->int (o 0)) 1))) (ycmp-st! y16 st-dsb) (ygive-if! q-b) (ymov! y-dsp y16)))
          ((or (i64= op ro-stack) (i64= op ro-load) (i64= op ro-setstk) (i64= op ro-store))
           (let ((slot (i64->int (if (or (i64= op ro-stack) (i64= op ro-setstk)) (o 0) (o 1))))
                 (k (i64->int (o 0))))
             (begin
               (ylea! y14 y-fp (* 8 slot)) (yalu! a-cmp y14 y-dsp) (ygive-if! q-ae)
               (cond ((i64= op ro-stack) (yld! y-w y14 0))
                     ((i64= op ro-setstk) (yst! y14 0 y-w))
                     ((i64= op ro-load) (begin (yld! y16 y14 0) (yreg-st! k y16)))
                     (else (begin (yreg-ld! y16 k) (yst! y14 0 y16)))))))
          ((i64= op ro-op1)
           (let ((r (o 0)))
             (if (or (i64= r r-car) (i64= r r-cdr) (i64= r r-pair-car) (i64= r r-pair-cdr))
                 (begin
                   (ymov! y14 y-w) (yalui! a-and y14 7) (yalui! a-cmp y14 1) (ygive-if! q-ne)
                   (yld-v! y-w y-w (if (or (i64= r r-car) (i64= r r-pair-car)) -1 7)))
                 (yb! (get l-give)))))
          ((i64= op ro-op2) (yop2-fast! (o 0) (yreg-of! (i64->int (o 1)) y16)))
          ((i64= op ro-op2imm) (begin (yopnd! y16 kk 1) (yop2-fast! (o 0) y16)))
          ((i64= op ro-field)
           (begin
             (ytag-in! y-w 4) (ylea-v! y11 y-w 0)
             (yimm! y13 (* 8 (i64->int (o 0)))) (yfield-read!) (ymov! y-w y16)))
          ((or (and (i64= op ro-cellular) (i64= (o 0) r-cons) (i64= (o 1) 2))
               (and (i64= op ro-prim) (i64= (prim-op (o 0)) o-region-cons) (i64= (o 1) 3)))
           (let ((first (if (i64= op ro-cellular) 1 2)))
             (begin
               (yallocating! 2 -1)
               (yreg-ld! y14 first) (yst! y16 0 y14) (yreg-ld! y14 (+ first 1)) (yst! y16 8 y14)
               (ylea! y15 y13 2) (yst-st! st-top y15)
               (ymov! y-w y16) (yvalued! y-w) (yalui! a-add y-w 1))))
          ((and (i64= op ro-lambda) (i64<= (o 1) register-regs) (i64= (o 2) r-closure))
           (let ((n (i64->int (o 1))))
             (begin
               ;; As `yclosed!` lays a closure out, its values from the registers.
               (yallocating! (+ 3 n) -1)
               (yimm! y15 (+ (+ 6 (* 8 (i64->int k-closure))) (* (+ n 2) 16384)))
               (yst! y16 0 y15)
               (ylea! y11 y16 (+ (* 8 n) 24))
               (yimm! y14 (+ (* 8 n) 21)) (yst! y11 -8 y14)
               (yopnd! y14 kk 0) (yst! y11 -16 y14)
               (yfrees-stored! 1 n)
               (ylea! y14 y13 (+ 3 n)) (yst-st! st-top y14)
               (ymov! y-w y11) (yvalued! y-w) (yalui! a-add y-w 4))))
          ((and (get h-6) (or (i64= op ro-invoke) (i64= op ro-tailinvoke)))
           (y6-invoked! (i64= op ro-tailinvoke) (i64->int (o 0)) nx))
          ((and (get h-6) (i64= op ro-invokeself)) (y6-called! (+ base 2) -1 -1 nx))
          ((and (get h-6) (i64= op ro-return)) (y6-returned!))
          ((or (i64= op ro-invoke) (i64= op ro-tailinvoke))
           (let ((tail (i64= op ro-tailinvoke)) (stack-code (label!)) (stack-way (label!)) (n (i64->int (o 0))))
             (begin
               (ykind-in! y-w k-closure)
               (yld! y13 y11 (at-field f-word)) (yld-v! y16 y13 (at-field f-twin))
               (yalui! a-cmp y16 3) (ybc! q-e stack-code)
               (yld-v! y15 y16 (at-field (i64+ f-cell0 1)))
               (yalui! a-cmp y15 (* 8 n)) (ygive-if! q-ne)
               (ylimits!)
               (if tail #u (yreturn-pushed! (i64+ f-cell0 nx)))
               (ymov! y-clo y-w) (ymov! y-cur y16)
               ;; Register code compiled: called (in tail position, the
               ;; link this one's), its value in `rax`.
               (yentry-address! y-cur stack-way)
               (if tail
                   (ytail-called! y16)
                   (begin (ycalled-to! -1 y16) (yb! (+ base (i64->int nx)))))
               (ybind! stack-way)
               (ylink-dropped!) (yleft!)
               (ylea-v! y-ip y-cur (- -4 (* 8 (+ (i64->int f-cell0) 2))))
               (yresume!)
               ;; Stack code: the arguments its frame, as tier 1's `call!`.
               (ybind! stack-code)
               (if (> n 8)
                   (yb! (get l-give))
                   (begin
                     (ymov! y15 y13)
                     (ylimits!)
                     (ylea! y16 y-dsp (* 8 n)) (ycmp-st! y16 st-ds-end) (ygive-if! q-a)
                     (if tail #u (yreturn-pushed! (i64+ f-cell0 nx)))
                     (ymov! y-fp y-dsp) (yargs-pushed! 1 n)
                     (ymov! y-clo y-w) (ylink-dropped!) (yleft!) (ymov! y-cur y15)
                     (ylea-v! y-ip y-cur (- -4 (* 8 (i64->int f-cell0))))
                     (yresume!))))))
          ((i64= op ro-invokeself)
           (begin (ylimits!) (yreturn-pushed! (i64+ f-cell0 nx)) (ycalled-to! (get h-call-entry) -1)))
          ((i64= op ro-return)
           (let ((stack-way (label!)))
             (begin
               (ycmp-st! y-rsp st-rsb) (ygive-if! q-e)
               ;; With a link, to the caller's code, the entry it pushed
               ;; popped; else the stack's way.
               (if (y-pushed?) (yalumi! a-cmp y-machine-sp 0 0) (yalumi! a-cmp y-st (at-st st-link) 0))
               (ybc! q-e stack-way)
               (yld! y13 y-rsp -32)
               (yalui! a-cmp y13 (i64->int prompt-mark-word)) (ybc! q-e stack-way)
               (yalui! a-cmp y13 (i64->int mark-mark-word)) (ybc! q-e stack-way)
               (ymov! y-cur y13) (yld! y14 y-rsp -16) (yld! y-clo y-rsp -8) (yalui! a-sub y-rsp 32)
               (ymov! y-fp y14) (yalurm! a-add y-fp y-st (at-st st-dsb))
               (if (y-pushed?) #u (ypush-st! st-link)) (yret!)
               (ybind! stack-way)
               (yroom!) (ypushed! y-w) (ylink-dropped!) (yleft!) (yb! (get l-pop-return)))))
          ((i64= op ro-branch) (yb! (to 1 (o 0))))
          ((i64= op ro-branchf) (begin (yalui! a-cmp y-w 3) (ybc! q-e (to 1 (o 0)))))
          ((i64= op ro-brancht) (begin (yalui! a-cmp y-w 3) (ybc! q-ne (to 1 (o 0)))))
          ((i64= op ro-global-guard)
           (begin
             (yopnd! y16 kk 0) (yld-v! y13 y16 (at-field f-writes))
             (yopnd! y14 kk 1) (yalu! a-cmp y13 y14) (ybc! q-ne (to 3 (fix-val (slot-of rw (i64+ kk 3)))))))
          (else (yb! (get l-give))))
        ;; Where a call or a call-out comes back to: its value on the data
        ;; stack, whether it ran here or was given back.
        (if (and (not (get h-6)) (or (i64= op ro-prim) (i64= op ro-lambda) (i64= op ro-cellular) (i64= op ro-invoke) (i64= op ro-invokeself)))
            (flatarray-set-i64! resumes nx (int->i64 (+ (get h-link) 2)))
            #u)))))

(define yreg-ins! (->* (i64 i64 i64 int (flatarrayof i64 @c)) unit)
  (lambda (rw i n base resumes)
    "Register instruction `i` of `rw`'s `n` cells for tier 5, at label
     `base + i`, its step counted; before the first past `args`, the
     word's entry for a call (to tier 6's adapter, if it has tier 6 code)."
    (begin
      (flatarray-set-i64! (get h-5-pushed) i (if (y-pushed?) 1 0))
      (cond ((not (i64= i 2)) #u)
            ;; Fixpt's: the link left where the `call` put it.
            ((and (get hand-fixpt-calls) (< (get h-6-adapter) 0)) (ybind! (get h-call-entry)))
            ((get hand-fixpt-calls) (begin (yb! (+ base 2)) (ybind! (get h-call-entry)) (yb! (get h-6-adapter))))
            (else
              (begin
                (yb! (+ base 2)) (ybind! (get h-call-entry)) (ye! (y-link-popped))
                (yb! (if (< (get h-6-adapter) 0) (+ base 2) (get h-6-adapter))))))
      (ybind! (+ base (i64->int i)))
      ;; Its own ways to give back, which know its place.
      (set l-give (+ (get h-gbase) (* 2 (i64->int i)))) (set l-give-pre (+ (get h-gbase) (+ 1 (* 2 (i64->int i)))))
      (yalumi! a-sub y-st (at-st st-fuel) 1) (ygive-if! q-b)
      (yreg-body! rw i n base resumes))))

(define y6-ins! (->* (i64 i64 i64 (flatarrayof i64 @c)) unit)
  (lambda (rw i n none)
    "Register instruction `i` of `rw`'s `n` cells for tier 6: at a block's
     first, the block's steps counted; its way out its own."
    (begin
      (ybind! (+ (get h-6-base) (i64->int i)))
      (set l-give (+ (get h-6-exits) (i64->int i))) (set l-give-pre (get l-give))
      (if (i64= (flatarray-ref-i64 (get h-6-lead) i) 1)
          (begin (yalumi! a-sub y-st (at-st st-fuel) (i64->int (flatarray-ref-i64 (get h-6-len) i))) (ygive-if! q-b))
          #u)
      (yreg-body! rw i n (get h-6-base) none))))

(define-rec
  (y6-instructions! (->* (i64 i64 i64 (flatarrayof i64 @c)) unit)
    (lambda (rw i n none)
      (if (i64>= i n)
          #u
          (begin
            (y6-ins! rw i n none)
            (y6-instructions! rw (i64+ i (i64+ 1 (rop-operands (fix-val (slot-of rw (i64+ f-cell0 i)))))) n none))))))

(define-rec
  (yreg-instructions! (->* (i64 i64 i64 int (flatarrayof i64 @c) (flatarrayof i64 @c)) unit)
    (lambda (rw i n base starts resumes)
      (if (i64>= i n)
          #u
          (let ((nx (i64+ i (i64+ 1 (rop-operands (fix-val (slot-of rw (i64+ f-cell0 i))))))))
            (begin
              (flatarray-set-i64! starts i 1)
              (yreg-ins! rw i n base resumes)
              (yreg-instructions! rw nx n base starts resumes)))))))

(define-rec
  (yresumes-emitted! (->* (i64 i64 int int int (flatarrayof i64 @c)) unit)
    (lambda (i n base rbase rgive resumes)
      "For each point after a call: `RESULT` popped, and on."
      (if (i64>= i n)
          #u
          (begin
            (if (i64>= (flatarray-ref-i64 resumes i) 1)
                (begin
                  (ybind! (+ rbase (i64->int i)))
                  (ycmp-st! y-dsp st-dsb) (ybc! q-be rgive) (yregs-zeroed! 1) (yalui! a-sub y-dsp 8) (yld! y-w y-dsp 0)
                  (ylink-reloaded! (- (i64->int (flatarray-ref-i64 resumes i)) 2))
                  (yb! (+ base (i64->int i))))
                #u)
            (yresumes-emitted! (i64+ i 1) n base rbase rgive resumes))))))

(define-rec
  (yreg-table! (->* (i64 i64 int int (flatarrayof i64 @c) bool int) unit)
    (lambda (k n base rgive marks six stubs)
      "A half of a register word's table: from field `k`, the code of each
       instruction `marks` marks, else the way to give back; if `six`, a
       block's first's way in to tier 6 (`t6-to`); before `save`, with
       `--fixpt-calls`, its way in from `stubs` (-1 for none), which
       pushes a link of none first."
      (if (i64>= k (i64+ f-cell0 n))
          #u
          (begin
            (if (and (i64>= k f-cell0) (i64>= (flatarray-ref-i64 marks (i64- k f-cell0)) 1))
                (ydo! (if (and (>= stubs 0) (y-pushed-at? (i64- k f-cell0)))
                          (+ stubs (i64->int (i64- k f-cell0)))
                          (if six (t6-to base (i64- k f-cell0)) (+ base (i64->int (i64- k f-cell0))))))
                (ydo! rgive))
            (yreg-table! (i64+ k 1) n base rgive marks six stubs))))))

(define-rec
  (ylink-stubs! (->* (i64 i64 int (flatarrayof i64 @c) int bool) unit)
    (lambda (i n base starts stubs six)
      "For each instruction from `i` before `save` (`--fixpt-calls`), its
       way in from the machine at `stubs + i`: no link pushed, then on."
      (if (i64>= i n)
          #u
          (begin
            (if (and (i64= (flatarray-ref-i64 starts i) 1) (y-pushed-at? i))
                (begin
                  (ybind! (+ stubs (i64->int i))) (yno-link-pushed!)
                  (yb! (if six (t6-to base i) (+ base (i64->int i)))))
                #u)
            (ylink-stubs! (i64+ i 1) n base starts stubs six))))))

(define-rec
  (y6-ways-in! (->* (i64 i64) unit)
    (lambda (i n)
      "For each block's first from `i`, its way in to tier 6 from tier 5,
       or from the tables: the link tier 5's code had kept, the bottom
       record pushed, on at it."
      (if (i64> i n)
          #u
          (begin
            (if (and (i64>= i 2) (i64< i n) (i64= (flatarray-ref-i64 (get h-6-lead) i) 1))
                (begin
                  (ybind! (+ (get h-6-ins) (i64->int i)))
                  (if (y-pushed-at? i) (ypop-st! st-t6link) (begin (yst-ld! y13 st-link) (yst-st! st-t6link y13)))
                  (yimm! y13 1) (ypush! y13) (ypush! y13)
                  (yb! (+ (get h-6-base) (i64->int i))))
                #u)
            (y6-ways-in! (i64+ i 1) n))))))

(define y6-compiled! (->* (i64 i64 int (flatarrayof i64 @c)) unit)
  (lambda (rw n base starts)
    "Register word `rw`'s tier 6 code, its tier 5 code at labels from
     `base`, and its ways in."
    (let ((n-cells (i64->int n)))
      (begin
        (set h-6-tier5 base)
        (set h-6 #t)
        (y6-instructions! rw 2 n (get h-6-lead))
        (set h-6 #f)
        ;; Past the last, as tier 5's.
        (ybind! (+ (get h-6-base) n-cells)) (yadr! y16 (+ base n-cells))
        (yb! (if (y-pushed-at? n) (get l-materialize-pushed) (get l-materialize)))
        (y6-exits! 0 n starts (get h-6-at) (get h-6-of) (get h-6-len))
        (y6-ways-in! 2 n)))))

(define yregister-compiled! (->* (i64 int int) unit)
  (lambda (rw n-cells rt)
    "Register word `rw` compiled; `rt` the label of its table. Its own ways
     to give back keep the instruction's place, `RESULT` and the registers
     in machine registers in the state."
    (let* ((n (int->i64 n-cells))
           (starts (the (flatarrayof i64 @c) (make-flatarray-i64 (i64+ n 1) 0)))
           (resumes (the (flatarrayof i64 @c) (make-flatarray-i64 (i64+ n 1) 0)))
           (base (get hand-labels)) (rbase (+ base (+ n-cells 1)))
           (way-in (+ rbase (+ n-cells 1))) (give-pre (+ way-in 1)) (rgive (+ way-in 2))
           (machine-give (get l-give)) (machine-give-pre (get l-give-pre))
           ;; `direct-op?`'s fuller set not yet (C212): x86_64's tier 5 has
           ;; but some of it, and none is tried on x86_64.
           (direct (and (get hand-direct) (direct-able? rw 0 n #t #f))))
      (begin
        (set hand-labels (+ rgive 1))
        (if direct (set words-direct (+ (get words-direct) 1)) #u)
        (set h-call-entry (label!))
        (set h-gbase (get hand-labels)) (set hand-labels (+ (get hand-labels) (* 2 (+ n-cells 1))))
        (set h-link -1)
        (set h-5-pushed (make-flatarray-i64 (i64+ n 1) 0))
        (set h-stubs (get hand-labels)) (set hand-labels (+ (get hand-labels) (+ n-cells 1)))
        (if direct (t6-prepared! rw n) #u)
        (yreg-instructions! rw 0 n base starts resumes)
        (ybind! (+ base n-cells)) (yb! (+ (get h-gbase) (* 2 n-cells)))
        (yresumes-emitted! 0 n base rbase rgive resumes)
        (flatarray-set-i64! (get h-5-pushed) n (if (y-pushed?) 1 0))
        (ygive-stubs! 0 n starts give-pre)
        (ybind! give-pre) (yst-st! st-cell y16) (yleft!) (yb! machine-give-pre)
        ;; Its way in from the machine, to the code in `r11`.
        (ybind! way-in) (yentered-reg!) (yjmp-r! y16)
        (ybind! rgive) (yb! (get l-resume-give))
        (if direct (y6-compiled! rw n base starts) #u)
        (set h-6-adapter -1) (set h-6-on #f)
        (ylink-stubs! 0 n base starts (get h-stubs) direct)
        (set l-give machine-give) (set l-give-pre machine-give-pre)
        (ydata-label! rt)
        (yd! (* 8 (i64->int (i64+ f-cell0 n))))
        (ydo! way-in) (if direct (ydo! (+ (get h-6-base) 2)) (yd! 0)) (ydo! (get h-call-entry))
        (yreg-table! 3 n base rgive starts direct (get h-stubs))
        (yreg-table! 0 n rbase rgive resumes #f -1)))))

(define-rec
  (y-bytes! (->* ((bloblet (fields) @heap) (listof int @k) int) int)
    (lambda (b bs at)
      (if (null? bs) at (begin (bloblet-set-byte! b at (car bs)) (y-bytes! b (cdr bs) (+ at 1)))))))

(define-rec
  (y-all-put! (->* ((bloblet (fields) @heap) (listof x-item @c) int (flatarrayof i64 @c)) unit)
    (lambda (b xs at ls)
      "Each item placed, at byte `at` on."
      (if (null? xs)
          #u
          (y-all-put! b (cdr xs) (y-bytes! b (y-encoded (car xs) at ls) at) ls)))))

(define-rec
  (yregisters-compiled! (->* ((listof named @c) int (listof int @c)) (listof int @c))
    (lambda (rs s rts)
      "hand.kfx's `registers-compiled!`, by `yregister-compiled!`."
      (if (null? rs)
          rts
          (let ((rw (named-value (car rs))))
            (if (and (i64= (slot-of (slot-of rw f-twin) f-twin) rw)
                     (i64<= (cells-in rw f-cell0) compiled-cells-most))
                (let ((rt (label!)))
                  (begin
                    (yregister-compiled! rw (i64->int (cells-in rw f-cell0)) rt)
                    (slot-set! rw f-entry (fix (i64+ r-count (int->i64 s))))
                    (yregisters-compiled! (cdr rs) (+ s 1) (cons rt rts))))
                (yregisters-compiled! (cdr rs) s rts)))))))

(define-rec
  (ywords-compiled! (->* ((listof named @c) int (listof int @c)) (listof int @c))
    (lambda (ws s rts)
      "hand.kfx's `words-compiled!`, by `yword-compiled!`."
      (if (null? ws)
          rts
          (let ((w (named-value (car ws))))
            (if (and (is-kind? w k-code) (i64= (fix-val (slot-of w f-entry)) r-docol)
                     (i64<= (cells-in w f-cell0) compiled-cells-most))
                (let ((rt (label!)))
                  (begin
                    (yword-compiled! w (i64->int (cells-in w f-cell0)) rt)
                    (slot-set! w f-entry (fix (i64+ r-count (int->i64 s))))
                    (ywords-compiled! (cdr ws) (+ s 1) (cons rt rts))))
                (ywords-compiled! (cdr ws) s rts)))))))

(define-rec
  (y-words-table (->* ((listof int @c) (listof x-item @c)) (listof x-item @c))
    (lambda (rts acc)
      "The table of the words' tables, word 0's first (`rts` the last first)."
      (if (null? rts) acc (y-words-table (cdr rts) (cons (xo (car rts)) acc))))))

(define hand-code-x64! (->* () (sumof (made hand-code) (failed string)))
  (lambda ()
    "The machine, made once: emitted, with the listing's words compiled
     (`--compiled`), encoded, sealed. First a jump to its entry, then the
     data, then the code, at hand.kfx's places: the table of the words'
     tables 8 bytes in."
    (if (not (null? (get hand-made)))
        (sum made (car (get hand-made)))
        (begin
          (set y-items nil) (set y-data nil) (set hand-labels 0)
          (set l-start (label!)) (set l-entry (label!)) (set l-words (label!))
          (set h-cont -1) (set h-target -1)
          (ymachine!)
          (set l-materialize (label!)) (y-materialize! (get l-materialize) #f)
          (set l-materialize-pushed (label!))
          (if (get hand-fixpt-calls) (y-materialize! (get l-materialize-pushed) #t) #u)
          (let* ((cts (if (get hand-compiled) (ywords-compiled! (get words) 0 nil) nil))
                 (rts (if (get hand-compiled) (yregisters-compiled! (get register-words) (count-of cts 0) cts) cts))
                 (u (set words-compiled (count-of rts 0)))
                 (its (the (listof x-item @c)
                        (cons (xl (get l-start))
                          (cons (xj y-jmp 0 (get l-entry))
                            (cons (xb (list 0 0 0))
                              (cons (xl (get l-words))
                                (cons (xb ((with x86 x86-le8) (* 8 (count-of rts 0))))
                                  (append (y-words-table rts nil) (append (reverse (get y-data)) (reverse (get y-items)))))))))))
                 (ls (the (flatarrayof i64 @c) (make-flatarray-i64 (int->i64 (get hand-labels)) 0)))
                 (count (y-placed! its 0 ls))
                 (b (the (bloblet (fields) @heap) (make-bloblet count)))
                 (v (y-all-put! b its 0 ls))
                 (p (the hand-code (native-procedure (seal-code b)))))
            (begin (set hand-made (list p)) (sum made p)))))))

(define hand-code! (->* () (sumof (made hand-code) (failed string)))
  (lambda ()
    "Tier 2's machine for the machine this runs on: arm64's (hand.kfx) or
     x86_64's; elsewhere none."
    (let ((target (car (the (listof string @heap) (native-convention)))))
      (cond ((and (get hand-fixpt-calls) (string=? target "(target arm64)")) (sum failed "--fixpt-calls: x86_64's alone (C140)"))
            ((string=? target "(target arm64)") (hand-code-arm64!))
            ((string=? target "(target x86_64)") (hand-code-x64!))
            (else (sum failed (string-append "tier 2: no machine for " target)))))))

"An array's address (C139), for values that are addresses: FX-26 has no
 operation that says it, so a native procedure of two instructions, made
 once for the machine this runs on, returns its argument, a flat array's
 suffix (tag 4), less its tag, as an `int` (a fixnum)."
(define-type address-code (subr (conv native) (read @c) ((flatarrayof i64 @c)) int))
(define address-made (ref (listof address-code @c) @c) (new nil))

(define address-code! (->* () (sumof (made-address address-code) (no-address string)))
  (lambda ()
    (let ((target (car (the (listof string @heap) (native-convention)))))
      (cond ((not (null? (get address-made))) (sum made-address (car (get address-made))))
            ((string=? target "(target x86_64)")
             (let* ((bs (the (listof int @k)
                          (append ((with x86 x86-lea) 0 y-rdi -4)
                            (append ((with x86 x86-shift-imm) s-shl 0 3) ((with x86 x86-ret))))))
                    (b (the (bloblet (fields) @heap) (make-bloblet (y-length bs 0))))
                    (u (y-bytes! b bs 0))
                    (p (the address-code (native-procedure (seal-code b)))))
               (begin (set address-made (list p)) (sum made-address p))))
            ((string=? target "(target arm64)")
             (let* ((b (the (bloblet (fields) @heap) (make-bloblet 12)))
                    (u (begin (put4 b 0 ((with a64 arm-sub-imm) 0 1 4)) (put4 b 4 (arm-lsl 0 0 3)) (put4 b 8 (with a64 arm-ret))))
                    (p (the address-code (native-procedure (seal-code b)))))
               (begin (set address-made (list p)) (sum made-address p))))
            (else (sum no-address (string-append "no native code for " target)))))))

(define code-area-made! (->* (address-code (flatarrayof i64 @c) i64) unit)
  (lambda (p first above)
    "The code area (C226), where native code runs: its reservation's pages
     from the first whole one, as many whole pages as fit, given an execute
     view by kayak-rt (`code:exec-view/1`); none, and so no code a program
     makes, where it gives none. Above both spaces, whose ends are below
     `above` (C230): native code calls what a closure holds as code if it
     is at least the area's lowest, as Fixpt's code area is its heap's top.
     `first`, reserved before the spaces, is there where reservations come
     from the top down (Linux); else one reserved after them, where they
     come from the bottom up (macOS); else, none."
    (if (not (and (syscall-available? code-view) (syscall-available? page-words)))
        #u
        (let* ((c (if (i64>= (int->i64 (p first)) above)
                      first
                      (the (flatarrayof i64 @c) (make-flatarray-i64 code-capacity 0))))
               (at (int->i64 (p c)))
               (page (int->i64 (page-words)))
               (lo (i64-remainder (i64- page (i64-remainder (i64-shr at 3) page)) page))
               (n (i64* page (i64-quotient (i64- code-capacity lo) page)))
               (d (int->i64 (code-view c (i64->int lo) (i64->int n)))))
          (if (or (i64< at above) (i64= d -1))
              #u
              (begin
                (set code c) (set code-vbase at)
                ;; Two parts (C234): the stubbed part the first half of the
                ;; pages, native code the rest, from the state's `code-lo`.
                (let ((mid (i64+ lo (i64* page (i64-quotient (i64-quotient n page) 2)))))
                  (begin
                    (set stub-lo lo) (set stub-top lo) (set stub-hi mid)
                    (set code-lo mid) (set code-top mid) (set code-hi (i64+ lo n))))
                (set code-stub-word
                     (if (string=? (car (the (listof string @heap) (native-convention))) "(target x86_64)")
                         ;; jmp [r15 + 288]; int3 (41 ff a7 20 01 00 00 cc)
                         -3746994885129404607
                         ;; ldr x16, [x24, #288]; br x16 (f9409310 d61f0200)
                         -3017691022109928688))
                (set code-marks (the (flatarrayof i64 @c) (make-flatarray-i64 code-capacity 0)))
                (set code-distance d) (set code-on #t)))))))

(define heap-addressed! (->* () bool)
  (lambda ()
    "Values made addresses from now on (C139), before any is made: both
     spaces reserved whole, their addresses the values' bases. Whether
     they could be; else values stay indices."
    (if (not (i64= (get top) 8))
        #f
        (tagcase (address-code!)
          (made-address p
            (let* ((first (the (flatarrayof i64 @c) (make-flatarray-i64 code-capacity 0)))
                   (m (the (flatarrayof i64 @c) (make-flatarray-i64 heap-capacity 0)))
                   (o (the (flatarrayof i64 @c) (make-flatarray-i64 heap-capacity 0))))
              (begin
                (set mem m) (set other o)
                (set vbase (int->i64 (p m))) (set to-vbase (int->i64 (p o)))
                (set addressed #t)
                ;; A first space of a nursery's size, Fixpt's (2^20 words, C238):
                ;; reserved whole, committed as touched; from 4096 words, a
                ;; program of little live data collected every 3072 words.
                (set limit 1048576)
                (code-area-made! p first
                                 (i64+ (if (i64> (get vbase) (get to-vbase)) (get vbase) (get to-vbase)) (i64* 8 heap-capacity)))
                #t)))
          (no-address why #f)))))

