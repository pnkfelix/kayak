"machine.kfx: Fixpt's cellular machine (C122), its interpreter as Fixpt's
 Rust one is (`fx-cells-rsinterp`), routine by routine: a data stack, a
 return stack of four-word entries (word, next field, frame, closure),
 the registers `cur k fp clo`. Each check where Fixpt makes it, each trap
 its message, so a run ends as Fixpt's does. Not yet: prompts, marks,
 continuations, native code, bignums.
 fixpt-source: crates/fixpt-engine/src/cellular.rs@35c59a3"

"The limits: values on the data stack, entries on the return stack."
(define ds-limit i64 131072)
(define rs-limit i64 65536)

(define ds (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 (i64+ 131072 1024) 0)))
(define dsp (ref i64 @c) (new 0))
(define rs (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 (i64* 4 (i64+ 65536 16)) 0)))
(define rsp (ref i64 @c) (new 0))
(define cur (ref i64 @c) (new 3))
(define kk (ref i64 @c) (new 0))
(define fp (ref i64 @c) (new 0))
(define clo (ref i64 @c) (new 3))
(define fuel (ref i64 @c) (new 0))
"What is left of the step limit past this slice (Fixpt's `reserve`)."
(define reserve (ref i64 @c) (new 0))

(define quoted (subr kfx (i64) string) (lambda (n) (string-append "`" (string-append (routine-name n) "`"))))
(define type-trap! (subr cm (i64) unit)
  (lambda (n)
    (trap! (if (or (i64= n r-pair-car) (i64= n r-pair-cdr))
               "car or cdr of a non-pair"
               (string-append (quoted n) " was given a value of the wrong kind")))))
(define overflow-trap! (subr cm (i64) unit) (lambda (n) (trap! (string-append (quoted n) "'s result does not fit"))))
(define underflow-trap! (subr cm (i64) unit) (lambda (n) (trap! (string-append (quoted n) " found too few values on the data stack"))))
(define field-trap! (subr cm (i64) unit) (lambda (n) (trap! (string-append (quoted n) " named a field that is not there"))))

"The data stack."
(define ds-at (subr cm (i64) i64) (lambda (i) (flatarray-ref-i64 (get ds) i)))
(define ds-set! (subr cm (i64 i64) unit) (lambda (i v) (flatarray-set-i64! (get ds) i v)))
(define push! (subr cm (i64) unit)
  (lambda (v)
    (if (i64>= (get dsp) (flatarray-length-i64 (get ds)))
        (trap! "stack overflow")
        (begin (ds-set! (get dsp) v) (set dsp (i64+ (get dsp) 1))))))
(define pop! (subr cm (i64) i64)
  (lambda (n)
    "The value on top, popped; a trap in routine `n` if there is none."
    (if (i64= (get dsp) 0)
        (begin (underflow-trap! n) 0)
        (begin (set dsp (i64- (get dsp) 1)) (ds-at (get dsp))))))
(define pop-fix! (subr cm (i64) i64)
  (lambda (n)
    (let ((v (pop! n)))
      (if (is-fixnum? v) (fix-val v) (begin (type-trap! n) 0)))))

"The return stack."
(define rs-push! (subr cm (i64) unit)
  (lambda (v) (begin (flatarray-set-i64! (get rs) (get rsp) v) (set rsp (i64+ (get rsp) 1)))))
(define rs-at (subr cm (i64) i64) (lambda (i) (flatarray-ref-i64 (get rs) i)))

(define push-return! (subr cm () unit)
  (lambda ()
    (if (i64>= (i64+ (get rsp) 4) (flatarray-length-i64 (get rs)))
        (trap! "stack overflow")
        (begin (rs-push! (get cur)) (rs-push! (fix (get kk))) (rs-push! (fix (get fp))) (rs-push! (get clo))))))

"Register code's registers (C129): `RESULT` at 0, `REG1`…`REG8` at 1 to 8
 (`REG0` is `clo`). Live only between instructions that cannot collect:
 Fixpt's compiler saves what lives across a call or a call-out in the
 frame, and a poll spills them all to the data stack."
(define rr (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 9 0)))
(define reg-at (subr cm (i64) i64) (lambda (k) (if (i64= k 0) (get clo) (flatarray-ref-i64 (get rr) k))))
(define reg-set! (subr cm (i64 i64) unit) (lambda (k v) (flatarray-set-i64! (get rr) k v)))
(define result (subr cm () i64) (lambda () (flatarray-ref-i64 (get rr) 0)))
(define result! (subr cm (i64) unit) (lambda (v) (flatarray-set-i64! (get rr) 0 v)))

"A register word's `kk` below 0: a point to resume at once something
 else has run. `-K`: after a call or a call-out, its value on the data
 stack, popped into `RESULT`; `-K - POLLED`: after a poll, every register
 on it (Fixpt marks the entries a `blr` made, negating `8k`)."
(define polled i64 1048576)

(define-rec
  (regs-cleared! (subr cm (i64) unit)
    (lambda (k)
      "`REGk`… to `REG8` 0: dead, and so harmless when a poll spills them
       for the collector to see (Fixpt spills only what lives; a dead
       register may hold what a collection since has moved)."
      (if (i64> k register-regs) #u (begin (reg-set! k 0) (regs-cleared! (i64+ k 1)))))))

(define-rec
  (adapted! (subr cm (i64 i64 i64) unit)
    (lambda (rw i count)
      "A word with register code entered by a stack-code call (Fixpt's
       adapter): the frame's values into `REG1`… from `i`, the frame
       dropped, on in the register word, past `args`."
      (if (i64< i count)
          (begin (reg-set! (i64+ i 1) (ds-at (i64+ (get fp) i))) (adapted! rw (i64+ i 1) count))
          (begin (regs-cleared! (i64+ count 1)) (result! 0) (set dsp (get fp)) (set cur rw) (set kk (i64+ f-cell0 2)))))))

"A prompt's entry on the return stack, `(PROMPT-MARK tag handler
 height)`, and a mark's, `(MARK-MARK key value 0)`, just above the entry
 its body returns to (Fixpt's)."
(define prompt-mark i64 v-default)
(define mark-mark i64 v-unspecified)

(define-rec
  (pop-return! (subr cm () unit)
    (lambda ()
      "Return to the entry on top; a prompt's or a mark's on the way is left
       behind, as its body is returning through it."
      (let ((n (get rsp)))
        (if (or (i64= (rs-at (i64- n 4)) prompt-mark) (i64= (rs-at (i64- n 4)) mark-mark))
            (begin (set rsp (i64- n 4)) (pop-return!))
            (begin
              (set clo (rs-at (i64- n 1)))
              (set fp (fix-val (rs-at (i64- n 2))))
              (set kk (fix-val (rs-at (i64- n 3))))
              (set cur (rs-at (i64- n 4)))
              (set rsp (i64- n 4))))))))

(define check-limits! (subr cm () unit)
  (lambda ()
    (if (or (i64> (get dsp) ds-limit) (i64>= (i64-quotient (get rsp) 4) rs-limit))
        (trap! "stack overflow")
        #u)))

(define limits-ok? (subr cm () bool)
  (lambda () (not (or (i64> (get dsp) ds-limit) (i64>= (i64-quotient (get rsp) 4) rs-limit)))))

(define operand! (subr cm () i64)
  (lambda () (let ((v (slot-of (get cur) (get kk)))) (begin (set kk (i64+ (get kk) 1)) v))))

(define closure? (subr cm (i64) bool) (lambda (v) (is-kind? v k-closure)))
(define word? (subr cm (i64) bool) (lambda (v) (is-kind? v k-code)))

"Collection (C122), at a safepoint only, as Fixpt's machine collects:
 everything live is then on the stacks, in `cur` and `clo`, or in the
 tables of what was read. When the space is three quarters full; or at
 every safepoint, under stress (`--gc-stress`, Coopt's policy for tests)."
(define gc-stress (ref bool @c) (new #f))

(define-rec
  (stack-forwarded! (subr cm ((flatarrayof i64 @c) i64 i64) unit)
    (lambda (a i n)
      (if (i64>= i n) #u (begin (flatarray-set-i64! a i (forward! (flatarray-ref-i64 a i))) (stack-forwarded! a (i64+ i 1) n))))))

(define collect! (subr cm () unit)
  (lambda ()
    (begin
      (collect-begin!)
      (set words (named-forwarded (get words)))
      (set literals (named-forwarded (get literals)))
      (set undefined-closure (forward! (get undefined-closure)))
      (stack-forwarded! (get ds) 0 (get dsp))
      (stack-forwarded! (get rs) 0 (get rsp))
      (set cur (forward! (get cur)))
      (set clo (forward! (get clo)))
      (set sched-state (forward! (get sched-state)))
      (collect-end!))))

(define safepoint! (subr cm () unit)
  (lambda ()
    (if (or (get gc-stress) (i64> (i64* 4 (get top)) (i64* 3 (get limit))))
        (collect!)
        #u)))

"Flows: what a routine leaves the loop to do."
(define next i64 0)
(define exit-flow i64 1)
(define halt-flow i64 2)

"Continuations (Fixpt's `continuation`, `reinstate`): a bloblet of the
 stacks' values and return entries taken, as two vectors, the registers,
 the data stack's height they were taken from, whether it is everything,
 and how many times it may be resumed; given to a program as a closure
 over the word `slot 0; free 0; resume`."
(define cont-ds i64 2)
(define cont-rs i64 3)
(define cont-cur i64 4)
(define cont-k i64 5)
(define cont-fp i64 6)
(define cont-clo i64 7)
(define cont-base i64 8)
(define cont-whole i64 9)
(define cont-regions i64 10)
(define cont-run i64 11)
(define cont-inner i64 12)
(define cont-shots i64 13)
"Shots: many, once, spent."
(define shots-many i64 0)
(define shots-once i64 1)
(define shots-spent i64 2)

(define vector-from! (subr cm ((flatarrayof i64 @c) i64 i64) i64)
  (lambda (a from to)
    "A vector of `a`'s words from `from` up to `to`, as Fixpt's
     `vector_from` lays one out (`obj-set!`)."
    (let ((v (make-bloblet! k-vector (i64- to from) 0 #t #f)))
      (letrec ((fill (subr cm (i64) unit)
                 (lambda (i) (if (i64>= i to) #u (begin (obj-set! v (i64- i from) (flatarray-ref-i64 a i)) (fill (i64+ i 1)))))))
        (begin (fill from) v)))))

(define vector-length (subr cm (i64) i64) (lambda (v) (obj-length v)))
(define vector-ref (subr cm (i64 i64) i64) (lambda (v i) (obj-ref v i)))

(define capture! (subr cm (i64 i64 bool) i64)
  (lambda (rs-from ds-from whole)
    (let* ((d (vector-from! (get ds) ds-from (get dsp)))
           (r (vector-from! (get rs) rs-from (get rsp)))
           (k (make-bloblet! k-continuation 12 0 #t #f)))
      (begin
        (slot-set! k cont-ds d) (slot-set! k cont-rs r)
        (slot-set! k cont-cur (get cur)) (slot-set! k cont-k (fix (get kk)))
        (slot-set! k cont-fp (fix (get fp))) (slot-set! k cont-clo (get clo))
        (slot-set! k cont-base (fix ds-from)) (slot-set! k cont-whole (boolean whole))
        (slot-set! k cont-regions (fix 0)) (slot-set! k cont-run (fix 0))
        (slot-set! k cont-inner v-false) (slot-set! k cont-shots (fix shots-many))
        k))))

(define continuation-closure! (subr cm (i64) i64)
  (lambda (k)
    "`k` as a closure, so that everything callable is one."
    (let ((w (make-word! "continuation" 5 r-docol))
          (c (make-bloblet! k-closure 2 0 #t #f)))
      (begin
        (slot-set! w f-cell0 (fix r-slot)) (slot-set! w (i64+ f-cell0 1) (fix 0))
        (slot-set! w (i64+ f-cell0 2) (fix r-free)) (slot-set! w (i64+ f-cell0 3) (fix 0))
        (slot-set! w (i64+ f-cell0 4) (fix r-resume))
        (slot-set! c f-word w)
        (slot-set! c f-free0 k)
        c))))

(define continuation-of (subr cm (i64) i64)
  (lambda (v)
    "The continuation `v` is, or stands for as such a closure; or 0."
    (cond ((is-kind? v k-continuation) v)
          ((and (is-kind? v k-closure) (i64= (fields-of v) f-free0)
                (is-kind? (slot-of v f-free0) k-continuation)
                (string=? (symbol-text (slot-of (slot-of v f-word) f-name)) "continuation"))
           (slot-of v f-free0))
          (else 0))))

(define prompt-height (subr kfx (i64) i64) (lambda (w) (i64-and (fix-val w) 4294967295)))
(define prompt-word (subr kfx (i64) i64) (lambda (h) (fix (i64-and h 4294967295))))

(define-rec
  (find-marked (subr cm (i64 i64 i64) i64)
    (lambda (i sentinel key)
      "Where the innermost entry below `i` marked `sentinel` for `key`
       starts, or -1."
      (cond ((i64< i 4) -1)
            ((and (i64= (rs-at (i64- i 4)) sentinel) (i64= (rs-at (i64- i 3)) key)) (i64- i 4))
            (else (find-marked (i64- i 4) sentinel key))))))

(define-rec
  (marks-of-stack (subr cm (i64 i64) (listof i64 @c))
    (lambda (i key)
      "Marks for `key` in `rs`'s entries below `i`, innermost first."
      (cond ((i64< i 4) nil)
            ((and (i64= (rs-at (i64- i 4)) mark-mark) (i64= (rs-at (i64- i 3)) key))
             (cons (rs-at (i64- i 2)) (marks-of-stack (i64- i 4) key)))
            (else (marks-of-stack (i64- i 4) key))))))

(define-rec
  (marks-of-vector (subr cm (i64 i64 i64) (listof i64 @c))
    (lambda (v i key)
      "Marks for `key` in a continuation's return entries below entry `i`,
       innermost first."
      (cond ((i64< i 4) nil)
            ((and (i64= (vector-ref v (i64- i 4)) mark-mark) (i64= (vector-ref v (i64- i 3)) key))
             (cons (vector-ref v (i64- i 2)) (marks-of-vector v (i64- i 4) key)))
            (else (marks-of-vector v (i64- i 4) key))))))

(define-rec
  (pushed-from-vector! (subr cm (i64 i64) unit)
    (lambda (v i) (if (i64>= i (vector-length v)) #u (begin (push! (vector-ref v i)) (pushed-from-vector! v (i64+ i 1)))))))

(define-rec
  (entries-reinstated! (subr cm (i64 i64 i64) unit)
    (lambda (v i delta)
      "A continuation's return entries back on the return stack, frames and
       prompts' heights moved by `delta`."
      (if (i64>= i (vector-length v))
          #u
          (let ((e0 (vector-ref v i)) (e1 (vector-ref v (i64+ i 1))) (e2 (vector-ref v (i64+ i 2))) (e3 (vector-ref v (i64+ i 3))))
            (begin
              (rs-push! e0)
              (rs-push! e1)
              (rs-push! (if (or (i64= e0 prompt-mark) (i64= e0 mark-mark)) e2 (fix (i64+ (fix-val e2) delta))))
              (rs-push! (if (i64= e0 prompt-mark) (prompt-word (i64+ (prompt-height e3) delta)) e3))
              (entries-reinstated! v (i64+ i 4) delta)))))))

(define reinstate! (subr cm (i64 i64 bool) unit)
  (lambda (k v tail)
    "Give continuation `k` the value `v`: a delimited one composed on top
     of these stacks, returning here (or, from a tail call, to this
     frame's caller); a whole one replacing them."
    (let ((whole (i64= (slot-of k cont-whole) v-true))
          (old-base (fix-val (slot-of k cont-base))))
      (begin
        (cond (whole (begin (set dsp 0) (set rsp 0)))
              (tail (set dsp (get fp)))
              (else (push-return!)))
        (let ((delta (i64- (get dsp) old-base)))
          (begin
            (pushed-from-vector! (slot-of k cont-ds) 0)
            (entries-reinstated! (slot-of k cont-rs) 0 delta)
            (set cur (slot-of k cont-cur))
            (set kk (fix-val (slot-of k cont-k)))
            (set fp (i64+ (fix-val (slot-of k cont-fp)) delta))
            (set clo (slot-of k cont-clo))
            (push! v)))))))

(define spend! (subr cm (i64) bool)
  (lambda (k)
    "Whether `k` may be given a value: not if it is one-shot and was; a
     one-shot one spent."
    (let ((s (fix-val (slot-of k cont-shots))))
      (cond ((i64= s shots-spent) (begin (trap! "a one-shot continuation resumed twice") #f))
            ((i64= s shots-once) (begin (slot-set! k cont-shots (fix shots-spent)) #t))
            (else #t)))))

(define call! (subr cm (i64 i64 bool) i64)
  (lambda (n count tail)
    "Call the closure on top with the `count` values below it, which become
     its frame; in tail position, its frame slid down over this one."
    (if (i64< (get dsp) (i64+ (get fp) (i64+ count 1)))
        (begin (underflow-trap! n) next)
        (let ((c (pop! n)))
          (cond
            ((is-kind? c k-continuation)
             (if (not (i64= count 1))
                 (begin (trap! (string-append "a continuation takes one value, and was given " (i64->string count))) next)
                 (let ((v (pop! n)))
                   (begin (check-limits!) (if (spend! c) (reinstate! c v tail) #u) next))))
            ((not (closure? c))
              (begin (type-trap! n) next))
            (else
              (begin
                (check-limits!)
                (if tail
                    (letrec ((slide (subr cm (i64 i64) unit)
                               (lambda (from to)
                                 (if (i64>= from (get dsp))
                                     #u
                                     (begin (ds-set! to (ds-at from)) (slide (i64+ from 1) (i64+ to 1)))))))
                      (let ((from (i64- (get dsp) count)))
                        (begin (slide from (get fp)) (set dsp (i64+ (get fp) count)))))
                    (begin (push-return!) (set fp (i64- (get dsp) count))))
                (set cur (slot-of c f-word))
                (set kk f-cell0)
                (set clo c)
                (let ((rw (slot-of (get cur) f-twin)))
                  (if (and (not (i64= rw v-false)) (i64= (fix count) (slot-of rw (i64+ f-cell0 1))))
                      (adapted! rw 0 count)
                      #u))
                next)))))))

(define-rec
  (args-of (subr cm (i64 i64 (listof i64 @c)) (listof i64 @c))
    (lambda (from i acc)
      "The values from `from` up to `i`, deepest first."
      (if (i64<= i from) acc (args-of from (i64- i 1) (cons (ds-at (i64- i 1)) acc))))))

(define int-op! (subr cm (i64) i64)
  (lambda (n)
    (let* ((b (pop! n)) (a (pop! n)))
      (begin
        (cond ((and (is-fixnum? a) (is-fixnum? b)
                    (or (i64= n r-int-less) (i64= n r-int-eq)
                        (fits? (if (i64= n r-int-add) (i64+ (fix-val a) (fix-val b)) (i64- (fix-val a) (fix-val b))))))
               (let ((x (fix-val a)) (y (fix-val b)))
                 (cond ((i64= n r-int-less) (push! (boolean (i64< x y))))
                       ((i64= n r-int-eq) (push! (boolean (i64= a b))))
                       (else (push! (fix (if (i64= n r-int-add) (i64+ x y) (i64- x y))))))))
              ((and (is-integer? a) (is-integer? b))
               "Past a fixnum, a bignum (Fixpt's `num::int_op`)."
               (let ((x (int-of a)) (y (int-of b)))
                 (push! (cond ((i64= n r-int-less) (boolean (< x y)))
                              ((i64= n r-int-eq) (boolean (= x y)))
                              ((i64= n r-int-add) (int-value! (+ x y)))
                              (else (int-value! (- x y)))))))
              (else (type-trap! n)))
        next))))

(define fix-op! (subr cm (i64) i64)
  (lambda (n)
    (let* ((y (pop-fix! n)) (x (pop-fix! n)))
      (begin
        (cond ((i64= n r-less) (push! (boolean (i64< x y))))
              (else (let ((r (if (i64= n r-add) (i64+ x y) (i64- x y))))
                      (if (fits? r) (push! (fix r)) (overflow-trap! n)))))
        next))))

(define enter-above! (subr cm (i64 i64 i64 i64 i64 i64) unit)
  (lambda (n thunk m0 m1 m2 m3)
    "Run closure `thunk` with no arguments above a marker entry `(m0 m1 m2
     m3)`: its frame, the marker, and where to resume after."
    (if (not (closure? thunk))
        (type-trap! n)
        (begin
          (check-limits!)
          (push-return!)
          (rs-push! m0) (rs-push! m1) (rs-push! m2) (rs-push! m3)
          (set cur (slot-of thunk f-word)) (set kk f-cell0) (set fp (get dsp)) (set clo thunk)))))

(define abort-to! (subr cm (i64 i64 i64) i64)
  (lambda (n tag v)
    "An abort to the innermost prompt for `tag`, its handler given `v`."
    (let ((at (find-marked (get rsp) prompt-mark tag)))
      (if (i64< at 0)
          (begin (trap! "abort: no prompt for this tag") next)
          (let ((handler (rs-at (i64+ at 2))) (height (prompt-height (rs-at (i64+ at 3)))))
            (begin
              (set rsp at)
              (pop-return!)
              (set dsp height)
              (push! v)
              (push! handler)
              (call! n 1 #f)))))))

(define closure-made! (subr cm (i64 i64) i64)
  (lambda (n at)
    "`closure W COUNT`, its operands at field `at` of `cur` (read past the
     safepoint, which may move them): a closure of `W` over the `COUNT`
     values on top. Register code's `lambda` too (C129)."
    (let* ((u (safepoint!)) (w (slot-of (get cur) at)) (count (fix-val (slot-of (get cur) (i64+ at 1)))))
      (if (i64< (get dsp) (i64+ (get fp) count))
          (begin (underflow-trap! n) next)
          (let ((c (make-bloblet! k-closure (i64+ count 1) 0 #t #f))
                (base (i64- (get dsp) count)))
            (letrec ((fill (subr cm (i64) unit)
                       (lambda (i)
                         (if (i64>= i count)
                             #u
                             (begin (slot-set! c (i64+ f-free0 i) (ds-at (i64+ base i))) (fill (i64+ i 1)))))))
              (begin
                (slot-set! c f-word w)
                (fill 0)
                (set dsp base)
                (push! c)
                next)))))))

(define prim-run! (subr cm (i64 i64 i64) i64)
  (lambda (n p count)
    "`prim P COUNT` on the `COUNT` values on top. Register code's `prim` too
     (C129)."
    (cond ((i64< (get dsp) count) (begin (underflow-trap! n) next))
          ((or (i64< count (prim-min p)) (and (i64>= (prim-max p) 0) (i64> count (prim-max p))))
           (begin (trap! (string-append "`" (string-append (prim-name p) (string-append "` given " (string-append (i64->string count) " argument(s)"))))) next))
          (else
           (let* ((u (safepoint!))
                  (from (i64- (get dsp) count))
                  (args (args-of from (get dsp) nil)))
             (begin (set dsp from) (push! (prim-apply! p args)) next))))))

(define-rec
  (routine! (subr cm (i64) i64)
    (lambda (n)
      "Routine `n`, its operands the cells after it: what to do next."
      (cond
        ((i64= n r-slot)
         (let ((i (fix-val (operand!))))
           (begin (if (i64< (i64+ (get fp) i) (get dsp)) (push! (ds-at (i64+ (get fp) i))) (field-trap! n)) next)))
        ((i64= n r-lit) (begin (push! (operand!)) next))
        ((i64= n r-global) (begin (push! (slot-of (operand!) f-value)) next))
        ((or (i64= n r-tcall) (i64= n r-ttailcall))
         (let ((count (fix-val (operand!))))
           (if (and (i64> (get dsp) (i64+ (get fp) count)) (closure? (ds-at (i64- (get dsp) 1))))
               (call! n count (i64= n r-ttailcall))
               (begin (type-trap! n) next))))
        ((i64= n r-return)
         (let ((v (pop! n)))
           (if (i64< (get dsp) (get fp))
               (begin (underflow-trap! n) next)
               (begin (set dsp (get fp)) (push! v) exit-flow))))
        ((i64= n r-closure)
         (let ((at (get kk))) (begin (set kk (i64+ at 2)) (closure-made! n at))))
        ((i64= n r-global-set)
         (let* ((g (operand!)) (x (pop! n)))
           (begin
             (slot-set! g f-value x)
             (slot-set! g f-writes (fix (i64+ (fix-val (slot-of g f-writes)) 1)))
             next)))
        ((i64= n r-zbranch)
         (let* ((flag (pop! n)) (off (fix-val (operand!))))
           (begin
             (if (i64= flag v-false) (begin (set kk (i64+ (get kk) off)) (check-limits!)) #u)
             next)))
        ((or (i64= n r-int-add) (i64= n r-int-sub) (i64= n r-int-less) (i64= n r-int-eq)) (int-op! n))
        ((i64= n r-exit) exit-flow)
        ((i64= n r-slot-set)
         (let* ((i (fix-val (operand!))) (x (pop! n)))
           (begin (if (i64< (i64+ (get fp) i) (get dsp)) (ds-set! (i64+ (get fp) i) x) (field-trap! n)) next)))
        ((i64= n r-eq) (let* ((b (pop! n)) (a (pop! n))) (begin (push! (boolean (i64= a b))) next)))
        ((or (i64= n r-pair-car) (i64= n r-pair-cdr) (i64= n r-car) (i64= n r-cdr))
         (let ((p (pop! n)))
           (begin
             (if (is-pair? p)
                 (push! (if (or (i64= n r-pair-car) (i64= n r-car)) (pair-car p) (pair-cdr p)))
                 (type-trap! n))
             next)))
        ((i64= n r-prim)
         (let* ((p (fix-val (operand!))) (count (fix-val (operand!)))) (prim-run! n p count)))
        ((i64= n r-cons)
         (if (i64< (get dsp) 2)
             (begin (underflow-trap! n) next)
             (let* ((u (safepoint!)) (b (pop! n)) (a (pop! n))) (begin (push! (cons! a b)) next))))
        ((i64= n r-branch)
         (let ((off (fix-val (operand!)))) (begin (set kk (i64+ (get kk) off)) (check-limits!) next)))
        ((or (i64= n r-add) (i64= n r-sub) (i64= n r-less)) (fix-op! n))
        ((i64= n r-free)
         (let ((i (fix-val (operand!))))
           (begin
             (if (and (is-bloblet? (get clo)) (field-ok? (get clo) (i64+ f-free0 i)))
                 (push! (slot-of (get clo) (i64+ f-free0 i)))
                 (field-trap! n))
             next)))
        ((or (i64= n r-call) (i64= n r-tailcall))
         (call! n (fix-val (operand!)) (i64= n r-tailcall)))
        ((i64= n r-field)
         (let* ((k (fix-val (operand!))) (obj (pop! n)))
           (begin
             (cond ((not (is-bloblet? obj)) (type-trap! n))
                   ((field-ok? obj k) (push! (slot-of obj k)))
                   (else (field-trap! n)))
             next)))
        ((i64= n r-field-ref)
         (let* ((kf (pop! n)) (obj (pop! n)))
           (begin
             (cond ((or (not (is-fixnum? kf)) (not (is-bloblet? obj))) (type-trap! n))
                   ((and (i64>= (fix-val kf) 0) (field-ok? obj (fix-val kf))) (push! (slot-of obj (fix-val kf))))
                   (else (field-trap! n)))
             next)))
        ((i64= n r-field-set)
         (let* ((kf (pop! n)) (obj (pop! n)) (x (pop! n)))
           (begin
             (cond ((or (not (is-fixnum? kf)) (not (is-bloblet? obj))) (type-trap! n))
                   ((or (i64= (tag-of x) t-trailer) (i64= (tag-of x) t-header) (i64= (tag-of x) t-forward)
                        (i64< (fix-val kf) 0) (not (field-ok? obj (fix-val kf))) (fields-frozen? obj))
                    (field-trap! n))
                   (else (slot-set! obj (fix-val kf) x)))
             next)))
        ((i64= n r-rest)
         (if (i64> (get fp) (get dsp))
             (begin (underflow-trap! n) next)
             (begin (push! (list-of (args-of (get fp) (get dsp) nil))) next)))
        ((i64= n r-execute)
         (let ((w (pop! n)))
           (cond ((is-fixnum? w) (routine! (fix-val w)))
                 ((word? w) (begin (enter! w) next))
                 (else (begin (trap! "`execute` was given what is no word") next)))))
        ((i64= n r-dup)
         (begin (if (i64= (get dsp) 0) (underflow-trap! n) (push! (ds-at (i64- (get dsp) 1)))) next))
        ((i64= n r-drop) (begin (pop! n) next))
        ((i64= n r-swap)
         (let* ((b (pop! n)) (a (pop! n))) (begin (push! b) (push! a) next)))
        ((i64= n r-over)
         (begin (if (i64< (get dsp) 2) (underflow-trap! n) (push! (ds-at (i64- (get dsp) 2)))) next))
        ((or (i64= n r-prompt) (i64= n r-withmark))
         (let* ((thunk (pop! n)) (b (pop! n)) (a (pop! n)))
           (begin
             (enter-above! n thunk
               (if (i64= n r-prompt) prompt-mark mark-mark) a b
               (if (i64= n r-prompt) (prompt-word (get dsp)) (fix 0)))
             next)))
        ((i64= n r-withmark-tail)
         (let* ((thunk (pop! n)) (v (pop! n)) (key (pop! n)))
           (if (not (closure? thunk))
               (begin (type-trap! n) next)
               (let ((top (get rsp)))
                 (begin
                   (check-limits!)
                   (set dsp (get fp))
                   (if (and (i64>= top 4) (i64= (rs-at (i64- top 4)) mark-mark) (i64= (rs-at (i64- top 3)) key))
                       (flatarray-set-i64! (get rs) (i64- top 2) v)
                       (begin (rs-push! mark-mark) (rs-push! key) (rs-push! v) (rs-push! (fix 0))))
                   (set cur (slot-of thunk f-word)) (set kk f-cell0) (set fp (get dsp)) (set clo thunk)
                   next)))))
        ((i64= n r-abort)
         (let* ((v (pop! n)) (tag (pop! n))) (abort-to! n tag v)))
        ((or (i64= n r-callcomp) (i64= n r-callone) (i64= n r-callcc))
         (let* ((tag (if (i64= n r-callcc) v-false (pop! n)))
                (proc (pop! n))
                (at (if (i64= n r-callcc) (the i64 -1) (find-marked (get rsp) prompt-mark tag))))
           (if (and (i64< at 0) (not (i64= n r-callcc)))
               (begin (trap! "call-with-composable-continuation: no prompt for this tag") next)
               (begin
                 (push! proc)
                 (safepoint!)
                 (let* ((proc (pop! n))
                        (k (if (i64< at 0)
                               (capture! 0 0 #t)
                               (capture! (i64+ at 4) (prompt-height (rs-at (i64+ at 3))) #f))))
                   (begin
                     (if (i64= n r-callone) (slot-set! k cont-shots (fix shots-once)) #u)
                     (push! (continuation-closure! k))
                     (push! proc)
                     (call! n 1 #f)))))))
        ((i64= n r-resume)
         (let* ((k (pop! n)) (v (pop! n)))
           (if (not (is-kind? k k-continuation))
               (begin (type-trap! n) next)
               (begin (check-limits!) (if (spend! k) (reinstate! k v #t) #u) next))))
        ((i64= n r-firstmark)
         (let* ((default (pop! n)) (key (pop! n)) (at (find-marked (get rsp) mark-mark key)))
           (begin (push! (if (i64< at 0) default (rs-at (i64+ at 2)))) next)))
        ((i64= n r-currentmarks)
         (let ((key (pop! n)))
           (begin (push! (list-of (marks-of-stack (get rsp) key))) next)))
        ((i64= n r-marksof)
         (let* ((key (pop! n)) (k (continuation-of (pop! n))))
           (if (i64= k 0)
               (begin (type-trap! n) next)
               (begin (push! (list-of (marks-of-vector (slot-of k cont-rs) (vector-length (slot-of k cont-rs)) key))) next))))
        ((i64= n r-halt) halt-flow)
        ((i64= n r-undefined) (begin (trap! "a procedure was called before it was defined") next))
        ((or (i64< n 1) (i64>= n r-count))
         (begin (trap! (string-append "no routine is numbered " (i64->string n))) next))
        (else (begin (trap! (string-append "tier 1 has no routine " (string-append (routine-name n) " yet (C122)"))) next)))))
  (enter! (subr cm (i64) bool)
    (lambda (w)
      "Enter word `w`, sharing this frame, as Forth's words call; or run its
       routine, if its entry is one: whether it was entered."
      (let ((entry (fix-val (slot-of w f-entry))))
        (if (or (i64= entry r-docol) (i64>= entry r-count))
            (begin
              (check-limits!)
              (if (is-bloblet? (get cur)) (push-return!) #u)
              (set cur w)
              (set kk f-cell0)
              #t)
            (begin
              (if (not (i64= (routine! entry) next))
                  (trap! (string-append "no routine is numbered " (i64->string entry)))
                  #u)
              #f))))))

"Processes (C125): the scheduler's prompt, whether it is on the return
 stack; a time slice's end, where the scheduler may have another task
 run; and a trap in a task of a monitored group, the group's failure."
(define reach? (subr cm () bool)
  (lambda () (let ((t (sched-tag))) (and (not (i64= t v-false)) (i64>= (find-marked (get rsp) prompt-mark t) 0)))))

(define poll-due! (subr cm () i64)
  (lambda ()
    "A slice's end: the next slice given out of the reserve; the
     scheduler's `preempt`, if it would have another task run, else `#f`
     (Fixpt's `poll`)."
    (let ((take (if (i64< (get reserve) (get slice)) (get reserve) (get slice))))
      (begin
        (set fuel take)
        (set reserve (i64- (get reserve) take))
        (let ((f (preempt-due! (reach?))))
          (cond ((i64= f v-false) v-false)
                ((not (limits-ok?)) (begin (quiet-leave!) (take-grace!) v-false))
                (else f)))))))

(define preempt-entered! (subr cm (i64) unit)
  (lambda (f)
    "A return to here pushed, the trampoline entered with `f`, `preempt`,
     on the data stack."
    (begin
      (push-return!)
      (set cur (st s-trampoline)) (set kk f-cell0) (set fp (get dsp)) (set clo v-false)
      (push! f))))

(define poll! (subr cm () bool)
  (lambda ()
    "A slice's end, between fetching a cell and running it: if `preempt` is
     due, called first, the cell put back. Whether it was."
    (let ((f (poll-due!)))
      (if (i64= f v-false)
          #f
          (begin (set kk (i64- (get kk) 1)) (preempt-entered! f) #t)))))

(define failed-in-task! (subr cm () bool)
  (lambda ()
    "After a trap, if the current task is of a monitored group: an abort to
     the scheduler's prompt, the trap forgotten, and on (Fixpt's
     `task_failed`). Whether it was."
    (if (string=? (get trap-message) "evaluation step limit exceeded")
        #f
        (let ((tag (task-failed! (get trap-message) (reach?))))
          (if (i64= tag v-false)
              #f
              (begin (set trap-message "") (abort-to! r-abort tag v-unit) (not (trapped?))))))))

"Register code (C129), run as Fixpt's tier 5 compiles it, on this
 machine: its frames on the data stack (`save M`: `M` slots, `#f`, then
 the link, here 0, `fp` at the first), its calls' and call-outs' values
 returned there, as stack code's are, so that each may call the other.
 One step an instruction, as a cell."
(define-rec
  (regs-pushed! (subr cm (i64 i64) unit)
    (lambda (i n)
      "`REG1`…`REGn` pushed from `REGi`; past `REGS`, the rest a list in the
       last (Fixpt's `push_regs`)."
      (cond ((i64> i n) #u)
            ((and (i64= i register-regs) (i64> n register-regs)) (list-pushed! (reg-at i) (i64- n (i64- i 1))))
            (else (begin (push! (reg-at i)) (regs-pushed! (i64+ i 1) n))))))
  (list-pushed! (subr cm (i64 i64) unit)
    (lambda (l n) (if (i64<= n 0) #u (begin (push! (pair-car l)) (list-pushed! (pair-cdr l) (i64- n 1)))))))

(define-rec
  (regs-spilled! (subr cm (i64) unit)
    (lambda (i) "`RESULT`, then `REG1`…`REG8`, pushed." (if (i64> i register-regs) #u (begin (push! (flatarray-ref-i64 (get rr) i)) (regs-spilled! (i64+ i 1))))))
  (regs-unspilled! (subr cm (i64) unit)
    (lambda (i) (if (i64< i 0) #u (begin (flatarray-set-i64! (get rr) i (pop! r-return)) (regs-unspilled! (i64- i 1)))))))

(define reg-resumed! (subr cm () unit)
  (lambda ()
    "Past a point to resume at, the registers back."
    (let ((k (get kk)))
      (cond ((i64>= k 0) #u)
            ((i64> k (i64- 0 polled)) (begin (regs-cleared! 1) (result! (pop! r-return)) (set kk (i64- 0 k))))
            (else (begin (regs-unspilled! register-regs) (set kk (i64- (i64- 0 k) polled))))))))

(define register-entered! (subr cm (i64 i64 bool) i64)
  (lambda (c rw tail)
    "Closure `c`, whose word's twin is `rw`, called by `invoke` with its
     arguments in the registers (not in tail position, a return here
     pushed first)."
    (begin
      (check-limits!)
      (if tail #u (push-return!))
      (set clo c) (set cur rw) (set kk (i64+ f-cell0 2))
      next)))

(define reg-op! (subr cm () i64)
  (lambda ()
    "The instruction at `kk`: what to do next."
    (let* ((w (get cur)) (k (get kk)) (op (fix-val (slot-of w k)))
           (o0 (slot-of w (i64+ k 1))) (o1 (slot-of w (i64+ k 2)))
           (nx (i64+ k (i64+ 1 (rop-operands op))))
           (val (lambda ((v i64)) (begin (result! v) (set kk nx) next)))
           (slot-ok? (lambda ((i i64)) (i64< (i64+ (get fp) i) (get dsp)))))
      (cond
        ((i64= op ro-const) (val o0))
        ((i64= op ro-reg) (val (reg-at (fix-val o0))))
        ((i64= op ro-setreg) (begin (reg-set! (fix-val o0) (result)) (set kk nx) next))
        ((i64= op ro-movereg) (begin (reg-set! (fix-val o1) (reg-at (fix-val o0))) (set kk nx) next))
        ((i64= op ro-global) (val (slot-of o0 f-value)))
        ((i64= op ro-setglbl)
         (begin
           (slot-set! o0 f-value (result))
           (slot-set! o0 f-writes (fix (i64+ (fix-val (slot-of o0 f-writes)) 1)))
           (set kk nx) next))
        ((i64= op ro-lexical)
         (if (and (is-bloblet? (get clo)) (field-ok? (get clo) (i64+ f-free0 (fix-val o0))))
             (val (slot-of (get clo) (i64+ f-free0 (fix-val o0))))
             (begin (field-trap! r-free) next)))
        ((i64= op ro-save)
         (let ((base (get dsp)))
           (letrec ((slots (subr cm (i64) unit) (lambda (i) (if (i64<= i 0) #u (begin (push! v-false) (slots (i64- i 1)))))))
             (begin (slots (fix-val o0)) (push! (fix 0)) (set fp base) (check-limits!) (set kk nx) next))))
        ((i64= op ro-pop)
         (if (i64< (get dsp) (i64+ (fix-val o0) 1))
             (begin (underflow-trap! r-return) next)
             (begin (set dsp (i64- (get dsp) (i64+ (fix-val o0) 1))) (set kk nx) next)))
        ((or (i64= op ro-stack) (i64= op ro-load))
         (let ((i (fix-val (if (i64= op ro-stack) o0 o1))))
           (cond ((not (slot-ok? i)) (begin (field-trap! r-slot) next))
                 ((i64= op ro-stack) (val (ds-at (i64+ (get fp) i))))
                 (else (begin (reg-set! (fix-val o0) (ds-at (i64+ (get fp) i))) (set kk nx) next)))))
        ((or (i64= op ro-setstk) (i64= op ro-store))
         (let ((i (fix-val (if (i64= op ro-setstk) o0 o1))))
           (if (not (slot-ok? i))
               (begin (field-trap! r-slot-set) next)
               (begin (ds-set! (i64+ (get fp) i) (if (i64= op ro-setstk) (result) (reg-at (fix-val o0)))) (set kk nx) next))))
        ((or (i64= op ro-op1) (i64= op ro-op2) (i64= op ro-op2imm))
         (begin
           (set kk nx)
           (push! (result))
           (if (i64= op ro-op1) #u (push! (if (i64= op ro-op2) (reg-at (fix-val o1)) o1)))
           (let ((flow (routine! (fix-val o0))))
             (begin (if (trapped?) #u (result! (pop! (fix-val o0)))) flow))))
        ((i64= op ro-field)
         (let ((x (result)))
           (cond ((not (is-bloblet? x)) (begin (type-trap! r-field) next))
                 ((field-ok? x (fix-val o0)) (val (slot-of x (fix-val o0))))
                 (else (begin (field-trap! r-field) next)))))
        ((i64= op ro-setfield)
         (let ((x (result)))
           (cond ((not (is-bloblet? x)) (begin (type-trap! r-field-set) next))
                 ((field-ok? x (fix-val o0)) (begin (slot-set! x (fix-val o0) (reg-at (fix-val o1))) (set kk nx) next))
                 (else (begin (field-trap! r-field-set) next)))))
        ((i64= op ro-prim1) (val (prim-apply! (fix-val o0) (list (result)))))
        ((i64= op ro-prim2) (val (prim-apply! (fix-val o0) (list (result) (reg-at (fix-val o1))))))
        ((i64= op ro-prim2imm) (val (prim-apply! (fix-val o0) (list (result) o1))))
        ((i64= op ro-prim3imm)
         (val (prim-apply! (fix-val o0) (list (result) o1 (reg-at (fix-val (slot-of w (i64+ k 3))))))))
        ;; What may collect, or run elsewhere first: its value comes back on
        ;; the data stack, to the point after it.
        ((i64= op ro-prim)
         (begin (set kk (i64- 0 nx)) (regs-pushed! 1 (fix-val o1)) (prim-run! r-prim (fix-val o0) (fix-val o1))))
        ((i64= op ro-lambda)
         (begin (set kk (i64- 0 nx)) (regs-pushed! 1 (fix-val o1)) (closure-made! r-closure (i64+ k 1))))
        ((i64= op ro-cellular)
         (begin (set kk (i64- 0 nx)) (regs-pushed! 1 (fix-val o1)) (routine! (fix-val o0))))
        ((or (i64= op ro-invoke) (i64= op ro-tailinvoke))
         (let* ((tail (i64= op ro-tailinvoke)) (c (result))
                (rw (if (closure? c) (slot-of (slot-of c f-word) f-twin) v-false)))
           (begin
             (if tail #u (set kk (i64- 0 nx)))
             (if (and (not (i64= rw v-false)) (i64= o0 (slot-of rw (i64+ f-cell0 1))))
                 (register-entered! c rw tail)
                 (begin
                   (if tail (set fp (get dsp)) #u)
                   (regs-pushed! 1 (fix-val o0))
                   (push! c)
                   (call! (if tail r-tailcall r-call) (fix-val o0) tail))))))
        ((i64= op ro-invokeself)
         (begin (set kk (i64- 0 nx)) (register-entered! (get clo) w #f)))
        ((i64= op ro-return) (begin (push! (result)) exit-flow))
        ((i64= op ro-branch) (begin (set kk (i64+ k (i64+ 2 (fix-val o0)))) next))
        ((or (i64= op ro-branchf) (i64= op ro-brancht))
         (begin
           (set kk (if (if (i64= op ro-branchf) (i64= (result) v-false) (not (i64= (result) v-false))) (i64+ k (i64+ 2 (fix-val o0))) nx))
           next))
        ((i64= op ro-global-guard)
         (begin
           (set kk (if (i64= (slot-of o0 f-writes) o1) nx (i64+ k (i64+ 4 (fix-val (slot-of w (i64+ k 3)))))))
           next))
        (else (begin (trap! (string-append "tier 1 runs no register operation " (nth-name rop-names op))) next))))))

(define reg-step! (subr cm (i64) bool)
  (lambda (base)
    "One register instruction, as `step!` runs a cell; at a poll that
     preempts, every register spilled first."
    (begin
      (reg-resumed!)
      (cond
        ((and (i64= (get fuel) 0) (i64= (get reserve) 0))
         (begin (trap! "evaluation step limit exceeded") #f))
        ((and (i64= (get fuel) 0)
              (let ((f (poll-due!)))
                (if (i64= f v-false)
                    #f
                    (begin (regs-spilled! 0) (set kk (i64- (i64- 0 (get kk)) polled)) (preempt-entered! f) #t))))
         #t)
        (else
          (begin
            (set fuel (i64- (get fuel) 1))
            (let ((flow (reg-op!)))
              (cond ((and (trapped?) (failed-in-task!)) #t)
                    ((trapped?) #f)
                    ((i64= flow next) #t)
                    ((i64= flow exit-flow)
                     (if (i64= (get rsp) base) #f (begin (pop-return!) #t)))
                    (else #f)))))))))

(define cell-step! (subr cm (i64) bool)
  (lambda (base)
    (let ((cell (slot-of (get cur) (get kk))))
      (begin
        (set kk (i64+ (get kk) 1))
        (cond
          ((and (i64= (get fuel) 0) (i64= (get reserve) 0))
           (begin (trap! "evaluation step limit exceeded") #f))
          ((and (i64= (get fuel) 0) (poll!)) #t)
          (else
            (begin
              (set fuel (i64- (get fuel) 1))
              (let ((flow (if (is-fixnum? cell) (routine! (fix-val cell)) (begin (enter! cell) next))))
                (cond ((and (trapped?) (failed-in-task!)) #t)
                      ((trapped?) #f)
                      ((i64= flow next) #t)
                      ((i64= flow exit-flow)
                       (if (i64= (get rsp) base) #f (begin (pop-return!) #t)))
                      (else #f))))))))))

(define step! (subr cm (i64) bool)
  (lambda (base)
    "One cell, as tier 1 runs it: whether the run goes on."
    (if (and (get regs-on) (is-kind? (get cur) k-register-code))
        (reg-step! base)
        (cell-step! base))))

(define-rec
  (run! (subr cm (i64) unit)
    (lambda (base) "Cells, one after another, until the run ends, halts or traps." (if (step! base) (run! base) #u))))

"Tier 2 (C126): the hand machine (hand.kfx) runs cells until it gives
 one back; tier 1 runs that one; and so on. The machine is given tier 1's
 registers in its state, and tier 1's heap and stacks themselves."
(define hand-on (ref bool @c) (new #f))
(define hand-state (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 st-size 0)))
(define hand-entries (ref i64 @c) (new 0))

"What the machine gave back, counted for `--gc-stats`: a routine at its
 number, register code resumed at 62, a word at 63, a `prim` at 64 plus
 its op, a register instruction at 1600 plus its op."
(define given-size i64 2048)
(define hand-given (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 given-size 0)))

(define given! (subr cm () unit)
  (lambda ()
    (let* ((reg (is-kind? (get cur) k-register-code))
           (cell (if reg (the i64 0) (slot-of (get cur) (get kk))))
           (i (cond ((and reg (i64< (get kk) 0)) (the i64 62))
                    (reg (i64+ 1600 (fix-val (slot-of (get cur) (get kk)))))
                    ((not (is-fixnum? cell)) (the i64 63))
                    ((i64= (fix-val cell) r-prim) (i64+ 64 (prim-op (fix-val (slot-of (get cur) (i64+ (get kk) 1))))))
                    (else (fix-val cell)))))
      (if (i64< i given-size)
          (flatarray-set-i64! (get hand-given) i (i64+ (flatarray-ref-i64 (get hand-given) i) 1))
          #u))))

(define-rec
  (given-shown (subr cm (i64 string) string)
    (lambda (i acc)
      "Each kind given back, with its count."
      (if (i64>= i given-size)
          acc
          (let ((n (flatarray-ref-i64 (get hand-given) i)))
            (given-shown (i64+ i 1)
              (if (i64= n 0)
                  acc
                  (string-append acc
                    (string-append "  "
                      (string-append (cond ((i64< i 62) (routine-name i)) ((i64= i 62) "register code, resumed") ((i64= i 63) "a word")
                                                  ((i64>= i 1600) (string-append "register " (nth-name rop-names (i64- i 1600)))) (else (pdef-of prims (i64- i 64))))
                        (string-append " " (string-append (i64->string n) "\n"))))))))))))

(define-rec
  (regs-copied! (subr cm ((flatarrayof i64 @c) i64 (flatarrayof i64 @c) i64 i64) unit)
    (lambda (from i to j n)
      "Register code's nine registers, `n` left, from `from` at `i` to `to`
       at `j` (the machine keeps them in `x0`…`x8`, C130)."
      (if (i64<= n 0)
          #u
          (begin (flatarray-set-i64! to j (flatarray-ref-i64 from i)) (regs-copied! from (i64+ i 1) to (i64+ j 1) (i64- n 1)))))))

(define hand! (subr cm (hand-code) bool)
  (lambda (m)
    "The machine run from tier 1's registers until it gives a cell back:
     whether it did (else it stopped the run, which it traps)."
    (let ((s (get hand-state)))
      (begin
        (flatarray-set-i64! s (int->i64 st-cur) (get cur)) (flatarray-set-i64! s (int->i64 st-kk) (get kk))
        (flatarray-set-i64! s (int->i64 st-fp) (get fp)) (flatarray-set-i64! s (int->i64 st-clo) (get clo))
        (flatarray-set-i64! s (int->i64 st-dsp) (get dsp)) (flatarray-set-i64! s (int->i64 st-rsp) (get rsp))
        (flatarray-set-i64! s (int->i64 st-fuel) (get fuel))
        (flatarray-set-i64! s (int->i64 st-ds-limit) ds-limit)
        (flatarray-set-i64! s (int->i64 st-rs-limit) (i64* 4 rs-limit))
        (flatarray-set-i64! s (int->i64 st-ds-length) (flatarray-length-i64 (get ds)))
        (flatarray-set-i64! s (int->i64 st-rs-push) (i64- (flatarray-length-i64 (get rs)) 4))
        (flatarray-set-i64! s (int->i64 st-top) (get top))
        (flatarray-set-i64! s (int->i64 st-alloc-limit)
                            (if (get gc-stress) 0 (i64-quotient (i64* 3 (get limit)) 4)))
        (flatarray-set-i64! s (int->i64 st-mem-length) (get limit))
        (flatarray-set-i64! s (int->i64 st-vbase) (get vbase))
        (set hand-entries (i64+ (get hand-entries) 1))
        (regs-copied! (get rr) 0 s (int->i64 st-regs) 9)
        (let ((why (int->i64 (m s (get mem) (get ds) (get rs)))))
          (begin
            (set cur (flatarray-ref-i64 s (int->i64 st-cur))) (set kk (flatarray-ref-i64 s (int->i64 st-kk)))
            (set fp (flatarray-ref-i64 s (int->i64 st-fp))) (set clo (flatarray-ref-i64 s (int->i64 st-clo)))
            (set dsp (flatarray-ref-i64 s (int->i64 st-dsp))) (set rsp (flatarray-ref-i64 s (int->i64 st-rsp)))
            (set fuel (flatarray-ref-i64 s (int->i64 st-fuel)))
            (set top (flatarray-ref-i64 s (int->i64 st-top)))
            (regs-copied! s (int->i64 st-regs) (get rr) 0 9)
            (cond ((i64= why gave-back) (begin (given!) #t))
                  ((i64= why misaligned) (begin (trap! "tier 2: its code is not 16-byte aligned (C131)") #f))
                  (else (begin (trap! "tier 2: the return stack ran out under its marks (C126)") #f)))))))))

(define-rec
  (hand-run! (subr cm (hand-code i64) unit)
    (lambda (m base)
      "The machine, then a cell of tier 1's, until the run ends."
      (if (and (hand! m) (step! base)) (hand-run! m base) #u))))

(define-datatype ran (ran-answer i64) (ran-failed string))

(define run-word! (subr cm (i64 i64) ran)
  (lambda (w steps)
    "Word `w` run with an empty stack, at most `steps` instructions (Fixpt's
     `run_word`): what it leaves on top, or why it failed."
    (begin
      (set dsp 0) (set rsp 0) (set cur v-false) (set kk 0) (set fp 0) (set clo v-false)
      (if (i64> steps (get slice)) (begin (set fuel (get slice)) (set reserve (i64- steps (get slice)))) (begin (set fuel steps) (set reserve 0)))
      (set trap-message "")
      (if (enter! w)
          (if (get hand-on)
              (tagcase (hand-code!)
                (made m (hand-run! m 0))
                (failed why (trap! why)))
              (run! 0))
          #u)
      (cond ((trapped?) (ran-failed (get trap-message)))
            ((i64= (get dsp) 0) (ran-failed "the word left nothing"))
            (else (ran-answer (ds-at (i64- (get dsp) 1))))))))
