"The fixed widths' operations, by their place: `+` 0 to `-shr` 14, `-not`
 15, `int->W` 16, `W->int` 17 (Fixpt's `fixed_op`'s `add` to `to`)."
(define fixed-widths (listof string acyclic) (list "i8" "u8" "i32" "u32" "i64" "u64"))
(define fixed-suffixes (listof string acyclic)
  (list "+" "-" "*" "-quotient" "-remainder" "-and" "-or" "-xor" "<" "<=" ">" ">=" "=" "-shl" "-shr" "-not"))

"`f64`'s operations, by their place (Fixpt's `f64_op`): two arguments to
 12, one from 13; `f32`'s, the same places where it has them."
(define f64-suffixes (listof string acyclic)
  (list "+" "-" "*" "/" "-min" "-max" "-atan2" "-expt" "<" "<=" ">" ">=" "="
        "-abs" "-neg" "-sqrt" "-floor" "-ceiling" "-truncate" "-round" "-exp" "-log" "-sin" "-cos" "-tan" "-asin" "-acos" "-atan"
        "-nan?" "-infinite?" "-finite?" "->string" "->int"))
(define f32-suffixes (listof string acyclic)
  (list "+" "-" "*" "/" "-min" "-max" "" "" "<" "<=" ">" ">=" "="
        "-abs" "-neg" "-sqrt" "-floor" "-ceiling" "-truncate" "-round" "" "" "" "" "" "" "" ""
        "-nan?" "-infinite?" "-finite?" "->string" "->int" "->f64"))

(define-rec
  (family (subr kfx (string (listof string acyclic) i64 i64 i64) (listof pdef acyclic))
    (lambda (prefix suffixes base i unary-from)
      "A family's primitives, `prefix` and each suffix, operation `base + i`:
       one argument from place `unary-from` on, else two."
      (cond ((null? suffixes) nil)
            ((string=? (car suffixes) "") (family prefix (cdr suffixes) base (i64+ i 1) unary-from))
            (else (cons (pdef (string-append prefix (car suffixes)) (if (i64>= i unary-from) 1 2) (if (i64>= i unary-from) 1 2) (i64+ base i))
                        (family prefix (cdr suffixes) base (i64+ i 1) unary-from)))))))

(define-rec
  (fixed-families (subr kfx ((listof string acyclic) i64) (listof pdef acyclic))
    (lambda (ws w)
      (if (null? ws)
          nil
          (let ((base (i64+ o-fixed (i64* 32 w))))
            (onto (family (string-append "%fx26-" (car ws)) fixed-suffixes base 0 15)
                  (cons (pdef (string-append "%fx26-int->" (car ws)) 1 1 (i64+ base 16))
                        (cons (pdef (string-append "%fx26-" (string-append (car ws) "->int")) 1 1 (i64+ base 17))
                              (fixed-families (cdr ws) (i64+ w 1))))))))))

(define prims (listof pdef acyclic)
  (onto
   (list (pdef "list" 0 -1 o-list) (pdef "%make-box" 1 1 o-make-box) (pdef "%region-enter" 0 0 o-region-enter)
         (pdef "%region-exit" 2 2 o-region-exit) (pdef "%region-cons" 3 3 o-region-cons) (pdef "%make-frozen" 1 -1 o-make-frozen)
         (pdef "%fx26-mul" 2 2 o-mul) (pdef "%fx26-quotient" 2 2 o-quotient) (pdef "%fx26-remainder" 2 2 o-remainder)
         (pdef "%fx26-zero?" 1 1 o-zero) (pdef "set-car!" 2 2 o-set-car) (pdef "set-cdr!" 2 2 o-set-cdr)
         (pdef "length" 1 1 o-length) (pdef "pair?" 1 1 o-pair) (pdef "exact-integer?" 1 1 o-exact-integer)
         (pdef "%fx26-nat?" 1 1 o-nat) (pdef "%fx26-list-copy" 1 1 o-list-copy) (pdef "boolean?" 1 1 o-boolean)
         (pdef "null?" 1 1 o-null) (pdef "%fx26-int-less" 2 2 o-int-less) (pdef "%fx26-int-eq" 2 2 o-int-eq)
         (pdef "%fx26-add" 2 2 o-add) (pdef "%fx26-sub" 2 2 o-sub) (pdef "modulo" 2 2 o-modulo)
