        ((i64= op o-convert)
         (let ((native (i64= (i64-and (fix-val b) 3) 2))
               (cellular (or (is-kind? a k-closure) (is-kind? a k-continuation)))
               (is-native (is-kind? a k-native-closure)))
           (if (or (and native cellular) (and (not native) is-native))
               (prim-failed p "of a procedure of the other convention")
               a)))
        (else (prim-failed p "unknown"))))))
