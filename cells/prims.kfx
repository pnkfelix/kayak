"A primitive's cell: its operation, above how many arguments it takes, at
 least (8 bits) and at most (8 bits, 255 for any)."
(define-rec
  (pdef-named (subr kfx ((listof pdef acyclic) string) i64)
    (lambda (ps n)
      (cond ((null? ps) -1)
            ((tagcase (car ps) (pdef (m lo hi o) (string=? m n)))
             (tagcase (car ps) (pdef (m lo hi o) (i64-or (i64-shl o 16) (i64-or (i64-shl lo 8) (i64-and hi 255))))))
            (else (pdef-named (cdr ps) n))))))

(define-rec
  (pdef-of (subr kfx ((listof pdef acyclic) i64) string)
    (lambda (ps op)
      (cond ((null? ps) "?")
            ((tagcase (car ps) (pdef (m lo hi o) (i64= o op))) (tagcase (car ps) (pdef (m lo hi o) m)))
            (else (pdef-of (cdr ps) op))))))

(define prim-number (subr kfx (string) i64) (lambda (n) (pdef-named prims n)))
(define prim-op (subr kfx (i64) i64) (lambda (p) (i64-shr p 16)))
(define prim-name (subr kfx (i64) string) (lambda (p) (pdef-of prims (prim-op p))))
(define prim-min (subr kfx (i64) i64) (lambda (p) (i64-and (i64-shr p 8) 255)))
(define prim-max (subr kfx (i64) i64) (lambda (p) (let ((m (i64-and p 255))) (if (i64= m 255) -1 m))))


"Failures, as Fixpt's runtime says them (`rt.fail`, `rt.type_error`)."
(define fail! (subr cm (string) i64) (lambda (m) (begin (trap! m) 0)))
(define expected! (subr cm (string) i64) (lambda (what) (fail! (string-append "expected " what))))
(define machine-word string "an exact integer that fits a machine word")

(define prim-failed (subr cm (i64 string) i64)
  (lambda (p why)
    "What tier 1 does not do as Fixpt does yet: marked, so that it is not
     taken for an answer."
    (fail! (string-append "tier 1: `" (string-append (prim-name p) (string-append "` " (string-append why ", not yet as Fixpt (C122)")))))))

"Arguments."
(define-rec
  (args-count (subr cm ((listof i64 @c) i64) i64)
    (lambda (xs n) (if (null? xs) n (args-count (cdr xs) (i64+ n 1))))))

(define-rec
  (nth-arg (subr cm ((listof i64 @c) i64) i64)
    (lambda (xs n) (cond ((null? xs) 0) ((i64= n 0) (car xs)) (else (nth-arg (cdr xs) (i64- n 1)))))))

"Lists, as Fixpt's `list_to_vec` walks them: a proper list's length, or
 -1 for an improper or a cyclic one."
(define-rec
  (walked-length (subr cm (i64 i64 i64) i64)
    (lambda (v slow n)
      (cond ((is-pair? v)
             (let ((v2 (pair-cdr v)) (n2 (i64+ n 1)))
               (if (i64= (i64-remainder n2 2) 0)
                   (let ((s2 (pair-cdr slow)))
                     (if (and (i64= s2 v2) (is-pair? v2)) -1 (walked-length v2 s2 n2)))
                   (walked-length v2 slow n2))))
            ((i64= v v-null) n)
            (else -1)))))
(define proper-length (subr cm (i64) i64) (lambda (v) (walked-length v v 0)))

"A primitive's arguments, deepest first, where its caller copies them
 (`pargs1!`, ...), for `prim-apply!` to read: no list is made of them,
 as the runtime's own memory is never let go (C43) and a long run calls
 primitives without end. Only a primitive of any number of them makes the
 list it takes (`pargs-list`)."
(define pargs (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 16 0)))
(define pargc (ref i64 @c) (new 0))
(define pargs-room! (subr cm (i64) unit)
  (lambda (n)
    (if (i64<= n (flatarray-length-i64 (get pargs)))
        (set pargc n)
        (begin (set pargs (the (flatarrayof i64 @c) (make-flatarray-i64 (i64* 2 n) 0))) (set pargc n)))))
(define parg-set! (subr cm (i64 i64) unit) (lambda (i v) (flatarray-set-i64! (get pargs) i v)))
(define parg (subr cm (i64) i64)
  (lambda (i) "Argument `i`, or 0 past the last." (if (i64< i (get pargc)) (flatarray-ref-i64 (get pargs) i) 0)))
(define pargs1! (subr cm (i64) unit) (lambda (a) (begin (pargs-room! 1) (parg-set! 0 a))))
(define pargs2! (subr cm (i64 i64) unit) (lambda (a b) (begin (pargs-room! 2) (parg-set! 0 a) (parg-set! 1 b))))
(define pargs3! (subr cm (i64 i64 i64) unit) (lambda (a b c) (begin (pargs-room! 3) (parg-set! 0 a) (parg-set! 1 b) (parg-set! 2 c))))
(define-rec
  (pargs-heap-list (subr cm (i64 i64) i64)
    (lambda (i acc)
      "The arguments up to `i`, consed onto `acc`, a list of the heap's."
      (if (i64<= i 0) acc (pargs-heap-list (i64- i 1) (cons! (flatarray-ref-i64 (get pargs) (i64- i 1)) acc))))))
(define-rec
  (onto-list (subr cm ((listof i64 @c) i64) i64)
    (lambda (xs tail) (if (null? xs) tail (cons! (car xs) (onto-list (cdr xs) tail))))))

"Lists of the heap's, and the primitives' arguments, taken where they are,
 with no list of the runtime's made of them (C150): what tier 1 makes of
 its own is never let go (C43), and a program makes a product, appends,
 or joins strings without end."
(define-rec
  (copied-onto! (subr cm (i64 i64) i64)
    (lambda (v tail) "List `v`'s items, before `tail`." (if (is-pair? v) (cons! (pair-car v) (copied-onto! (pair-cdr v) tail)) tail))))

(define-rec
  (improper-before (subr cm (i64 i64 i64) i64)
    (lambda (i n heap)
      "The first argument from `i` before the `n`th (or of list `heap`'s
       items, but its last, if `heap` is a list) that is no proper list, or
       0."
      (if (is-pair? heap)
          (cond ((not (is-pair? (pair-cdr heap))) 0)
                ((i64< (proper-length (pair-car heap)) 0) (pair-car heap))
                (else (improper-before 0 0 (pair-cdr heap))))
          (cond ((i64>= i n) 0)
                ((i64< (proper-length (parg i)) 0) (parg i))
                (else (improper-before (i64+ i 1) n heap)))))))

(define-rec
  (appended-args! (subr cm (i64) i64)
    (lambda (i)
      "The arguments from `i` appended, the last as it is."
      (if (i64>= i (i64- (get pargc) 1)) (parg i) (copied-onto! (parg i) (appended-args! (i64+ i 1)))))))

(define-rec
  (appended-lists! (subr cm (i64) i64)
    (lambda (l)
      "The lists list `l` holds appended, the last as it is."
      (if (is-pair? (pair-cdr l)) (copied-onto! (pair-car l) (appended-lists! (pair-cdr l))) (pair-car l)))))

(define-rec
  (fields-of-args! (subr cm (i64 i64 i64) unit)
    (lambda (b k i) "Fields `k` on of `b`, the arguments from `i`." (if (i64>= i (get pargc)) #u (begin (slot-set! b k (parg i)) (fields-of-args! b (i64+ k 1) (i64+ i 1)))))))

(define-rec
  (fields-of-list! (subr cm (i64 i64 i64) unit)
    (lambda (b k l) "Fields `k` on of `b`, list `l`'s items." (if (is-pair? l) (begin (slot-set! b k (pair-car l)) (fields-of-list! b (i64+ k 1) (pair-cdr l))) #u))))

"Strings: code points, two to a word, after the length's word."
(define str? (subr cm (i64) bool) (lambda (v) (is-kind? v k-string)))
(define str-length (subr cm (i64) i64) (lambda (v) (word-at (address v))))
(define str-ref (subr cm (i64 i64) i64)
  (lambda (v i)
    (let ((w (word-at (i64+ (address v) (i64+ 1 (i64-quotient i 2))))))
      (if (i64= (i64-remainder i 2) 0) (i64-and w 4294967295) (i64-and (i64-shr w 32) 4294967295)))))

(define-rec
  (char-found? (subr cm (i64 i64 i64 i64) bool)
    (lambda (c v i n)
      "Whether code point `c` is among string `v`'s, from the `i`th of its `n`."
      (cond ((i64>= i n) #f) ((i64= (str-ref v i) c) #t) (else (char-found? c v (i64+ i 1) n))))))

(define string-made! (subr cm (i64) i64)
  (lambda (n)
    "A string of `n` code points, each 0, to be written (`point-set!`)."
    (let ((v (make-bloblet! k-string 0 (i64* 8 (i64+ 1 (i64-quotient (i64+ n 1) 2))) #f #f)))
      (begin (word-set! (address v) n) v))))

(define point-set! (subr cm (i64 i64 i64) unit)
  (lambda (v i x)
    "Code point `i` of string `v`, made by `string-made!`, `x`."
    (let ((at (i64+ (address v) (i64+ 1 (i64-quotient i 2)))))
      (word-set! at (i64-or (word-at at) (if (i64= (i64-remainder i 2) 0) x (i64-shl x 32)))))))

(define-rec
  (points-copied! (subr cm (i64 i64 i64 i64 i64) i64)
    (lambda (v at s i n)
      "Code points `i` to `n` of string `s` written in `v` from `at`; where
       the next goes."
      (if (i64>= i n) at (begin (point-set! v at (str-ref s i)) (points-copied! v (i64+ at 1) s (i64+ i 1) n))))))

(define-rec
  (args-not-string (subr cm (i64) i64)
    (lambda (i) "The first argument from `i` that is no string, or 0." (cond ((i64>= i (get pargc)) 0) ((not (str? (parg i))) (parg i)) (else (args-not-string (i64+ i 1)))))))

(define-rec
  (list-not-string (subr cm (i64) i64)
    (lambda (l) "The first of list `l`'s items that is no string, or 0." (cond ((not (is-pair? l)) 0) ((not (str? (pair-car l))) (pair-car l)) (else (list-not-string (pair-cdr l)))))))

(define-rec
  (args-points (subr cm (i64 i64) i64)
    (lambda (i n) (if (i64>= i (get pargc)) n (args-points (i64+ i 1) (i64+ n (str-length (parg i))))))))

(define-rec
  (list-points (subr cm (i64 i64) i64)
    (lambda (l n) (if (is-pair? l) (list-points (pair-cdr l) (i64+ n (str-length (pair-car l)))) n))))

(define-rec
  (args-joined! (subr cm (i64 i64 i64) i64)
    (lambda (v at i) (if (i64>= i (get pargc)) v (args-joined! v (points-copied! v at (parg i) 0 (str-length (parg i))) (i64+ i 1))))))

(define-rec
  (list-joined! (subr cm (i64 i64 i64) i64)
    (lambda (v at l) (if (is-pair? l) (list-joined! v (points-copied! v at (pair-car l) 0 (str-length (pair-car l))) (pair-cdr l)) v))))

(define-rec
  (compared-from (subr cm (i64 i64 i64) i64)
    (lambda (a b i)
      "-1, 0 or 1, code point by code point from `i` (Fixpt's `string_cmp`)."
      (let ((na (str-length a)) (nb (str-length b)))
        (cond ((and (i64>= i na) (i64>= i nb)) 0)
              ((i64>= i na) -1)
              ((i64>= i nb) 1)
              ((i64< (str-ref a i) (str-ref b i)) -1)
              ((i64> (str-ref a i) (str-ref b i)) 1)
              (else (compared-from a b (i64+ i 1))))))))
(define strings-compare (subr cm (i64 i64) i64) (lambda (a b) (compared-from a b 0)))

(define-rec
  (fnv (subr cm ((listof i64 @c) i64) i64)
    (lambda (xs h) (if (null? xs) h (fnv (cdr xs) (i64* (i64-xor h (car xs)) 1099511628211))))))

(define-rec
  (string-fnv (subr cm (i64 i64 i64) i64)
    (lambda (s i h) "`fnv` of string `s`'s code points from `i`." (if (i64>= i (str-length s)) h (string-fnv s (i64+ i 1) (i64* (i64-xor h (str-ref s i)) 1099511628211))))))

(define-rec
  (string-chain (subr cm (i64) i64)
    (lambda (i)
      "`string=?` of two and more, the arguments from `i` (Fixpt's
       `string_chain`): each pair, its strings checked, in turn."
      (cond ((i64>= (i64+ i 1) (get pargc)) v-true)
            ((not (str? (parg i))) (expected! "a string"))
            ((not (str? (parg (i64+ i 1)))) (expected! "a string"))
            ((not (i64= (strings-compare (parg i) (parg (i64+ i 1))) 0)) v-false)
            (else (string-chain (i64+ i 1)))))))

"Characters."
(define char-code (subr kfx (i64) i64) (lambda (v) (i64-shr v 8)))
(define scalar? (subr kfx (i64) bool)
  (lambda (n) (and (i64>= n 0) (i64<= n 1114111) (not (and (i64>= n 55296) (i64<= n 57343))))))

(define-rec
  (args-chars? (subr cm (i64) bool)
    (lambda (i) (or (i64>= i (get pargc)) (and (is-char? (parg i)) (args-chars? (i64+ i 1)))))))

(define-rec
  (chars-written! (subr cm (i64 i64) unit)
    (lambda (v i) "Each argument from `i`, a character, code point `i` of `v`." (if (i64>= i (get pargc)) #u (begin (point-set! v i (char-code (parg i))) (chars-written! v (i64+ i 1)))))))

"Bloblets."
(define plain? (subr cm (i64) bool) (lambda (v) (is-kind? v k-bloblet)))

"The most fields an ordinary header holds; more need Fixpt's large one,
 which tier 1 does not make yet."
(define fields-max i64 262143)
(define bytes-max i64 4294967295)

(define-rec
  (fields-filled! (subr cm (i64 i64 i64 i64) unit)
    (lambda (b k last x) (if (i64> k last) #u (begin (slot-set! b k x) (fields-filled! b (i64+ k 1) last x))))))

(define plain-of! (subr cm (i64 i64 i64) i64)
  (lambda (p bytes from)
    "`%make-bloblet`'s: a plain bloblet of `bytes` and its fields the
     arguments from `from`."
    (let ((n (i64- (get pargc) from)))
      (cond ((not (is-fixnum? bytes)) (expected! machine-word))
            ((or (i64< (fix-val bytes) 0) (i64> (fix-val bytes) bytes-max)) (fail! "a bloblet's suffix is 0 to 4 GiB"))
            ((i64>= n fields-max) (prim-failed p "of a large header"))
            (else (let ((b (make-bloblet! k-bloblet n (fix-val bytes) #t #f)))
                    (begin (fields-of-args! b 2 from) b)))))))

(define filled-of! (subr cm (i64 i64 i64 i64 bool) i64)
  (lambda (p bytes n x check-bytes)
    "`%make-bloblet-filled`'s, `%region-make-array`'s: `n` fields, each
     `x`."
    (cond ((and check-bytes (not (is-fixnum? bytes))) (expected! machine-word))
          ((not (is-fixnum? n)) (expected! machine-word))
          ((and check-bytes (or (i64< (fix-val bytes) 0) (i64> (fix-val bytes) bytes-max))) (fail! "a bloblet's suffix is 0 to 4 GiB"))
          ((or (i64< (fix-val n) 0) (i64>= (fix-val n) 1099511627776)) (fail! "a bloblet's field count must be non-negative"))
          ((i64>= (fix-val n) fields-max) (prim-failed p "of a large header"))
          (else (let ((b (make-bloblet! k-bloblet (fix-val n) (if check-bytes (fix-val bytes) 0) #t #f)))
                  (begin (fields-filled! b 2 (i64+ (fix-val n) 1) x) b))))))

"Field `k` of a bloblet, checked (Fixpt's `field_slot`): its trouble, or
 ``."
(define field-trouble (subr cm (i64 i64) string)
  (lambda (b k)
    (cond ((or (i64= k 0) (i64> k (fields-of b))) (string-append "the bloblet has no field -" (i64->string k)))
          ((i64= (tag-of (slot-of b k)) t-trailer) "field -1 is the bloblet's trailer, which only the runtime writes")
          (else ""))))

(define-rec
  (acyclic-from? (subr cm (i64 (listof i64 @c) (ref (listof i64 @c) @c)) bool)
    (lambda (v path done)
      "Whether no way from `v` leads back onto `path` (Fixpt's
       `%fx26-acyclic?`: through pairs and bloblets' fields); `done`, what
       is finished."
      (cond ((not (or (is-pair? v) (is-bloblet? v))) #t)
            ((member-i64? v path) #f)
            ((member-i64? v (get done)) #t)
            (else
             (let ((path (cons v path)))
               (if (if (is-pair? v)
                       (and (acyclic-from? (pair-car v) path done) (acyclic-from? (pair-cdr v) path done))
                       (fields-acyclic? v 1 path done))
                   (begin (set done (cons v (get done))) #t)
                   #f))))))
  (fields-acyclic? (subr cm (i64 i64 (listof i64 @c) (ref (listof i64 @c) @c)) bool)
    (lambda (b k path done)
      (cond ((i64> k (fields-of b)) #t)
            ((i64= (tag-of (slot-of b k)) t-trailer) (fields-acyclic? b (i64+ k 1) path done))
            ((acyclic-from? (slot-of b k) path done) (fields-acyclic? b (i64+ k 1) path done))
            (else #f))))
  (member-i64? (subr cm (i64 (listof i64 @c)) bool)
    (lambda (x xs) (cond ((null? xs) #f) ((i64= x (car xs)) #t) (else (member-i64? x (cdr xs)))))))

"Suffix refs, and the bytes they point at."
(define byte-of (subr cm (i64 i64) i64)
  (lambda (p i) (i64-and (i64-shr (word-at (i64+ p (i64-quotient i 8))) (i64->int (i64* 8 (i64-remainder i 8)))) 255)))
(define byte-put! (subr cm (i64 i64 i64) unit)
  (lambda (p i x)
    (let* ((at (i64+ p (i64-quotient i 8)))
           (shift (i64->int (i64* 8 (i64-remainder i 8)))))
      (word-set! at (i64-or (i64-and (word-at at) (i64-not (i64-shl 255 shift))) (i64-shl (i64-and x 255) shift))))))

(define-rec
  (bytes-read (subr cm (i64 i64 i64 i64) i64)
    (lambda (p at width k)
      "The `width` bytes from byte `at`, little-endian, as a word."
      (if (i64>= k width) 0 (i64-or (i64-shl (byte-of p (i64+ at k)) (i64->int (i64* 8 k))) (bytes-read p at width (i64+ k 1)))))))
(define-rec
  (bytes-put! (subr cm (i64 i64 i64 i64 i64) unit)
    (lambda (p at width bits k)
      (if (i64>= k width) #u (begin (byte-put! p (i64+ at k) (i64-shr bits (i64->int (i64* 8 k)))) (bytes-put! p at width bits (i64+ k 1)))))))

(define room-at (subr cm (i64) i64)
  (lambda (r) "How many bytes of its owner's suffix lie from ref `r` on." (let ((n (i64- (bytes-of (sref-owner r)) (sref-offset r)))) (if (i64< n 0) 0 n))))

(define sref-at! (subr cm (i64 i64) i64)
  (lambda (owner off)
    "Fixpt's `suffix_ref`, its failures said `suffix ref: ...`."
    (let ((n (bytes-of owner)))
      (cond ((i64>= n sref-offset-limit)
             (fail! (string-append "suffix ref: a suffix of " (string-append (i64->string n) " bytes is too large to point into (a suffix ref's offset is below 2^27)"))))
            ((i64>= off n) (fail! (string-append "suffix ref: the bloblet's suffix has no byte " (i64->string off))))
            (else (make-sref (address owner) off))))))

(define sref-moved! (subr cm (i64 i64) i64)
  (lambda (r d)
    "Fixpt's `suffix_ref_add`."
    (if (i64< (i64+ (sref-offset r) d) 0)
        (fail! "suffix ref: the bloblet's suffix has no byte 0")
        (sref-at! (sref-owner r) (i64+ (sref-offset r) d)))))

"A read's or a write's trouble at ref `r` (`suffix_ref_read`, `_write`):
 ``, or what Fixpt says."
(define read-trouble (subr cm (i64 i64) string)
  (lambda (r width)
    (if (i64> (i64+ (sref-offset r) width) (bytes-of (sref-owner r)))
        (string-append "suffix ref: the bloblet's suffix has no byte " (i64->string (i64- (i64+ (sref-offset r) width) 1)))
        "")))

(define sref-read! (subr cm (i64 i64) i64)
  (lambda (r width)
    "Fixpt's `suffix_read`: the bits, or a failure (then 0)."
    (cond ((not (is-sref? r)) (expected! "a suffix ref"))
          ((not (string=? (read-trouble r width) "")) (fail! (read-trouble r width)))
          (else (bytes-read (address (sref-owner r)) (sref-offset r) width 0)))))

(define sref-write! (subr cm (i64 i64 i64) i64)
  (lambda (r width bits)
    "Fixpt's `suffix_write`: unspecified, or a failure."
    (cond ((not (is-sref? r)) (expected! "a suffix ref"))
          ((not (or (is-kind? (sref-owner r) k-bloblet) (is-kind? (sref-owner r) k-flat-array)))
           (expected! "a suffix ref into a bloblet the program may change"))
          ((not (string=? (read-trouble r width) "")) (fail! (read-trouble r width)))
          ((suffix-frozen? (sref-owner r)) (fail! "suffix ref: the bloblet's suffix is frozen"))
          (else (begin (bytes-put! (address (sref-owner r)) (sref-offset r) width bits 0) v-unspecified)))))

"Fixed widths, as Fixpt's `Width`: its bits, its sign, its name."
(define width-bits (subr kfx (i64) i64) (lambda (w) (cond ((i64< w 2) 8) ((i64< w 4) 32) (else 64))))
(define width-signed? (subr kfx (i64) bool) (lambda (w) (i64= (i64-remainder w 2) 0)))
(define width-name (subr kfx (i64) string)
  (lambda (w) (cond ((i64= w 0) "an i8") ((i64= w 1) "a u8") ((i64= w 2) "an i32") ((i64= w 3) "a u32") ((i64= w 4) "an i64") (else "a u64"))))
(define wrapped (subr kfx (i64 int) int)
  (lambda (w x)
    "`x`'s low bits, sign-extended if the width is signed (`Width::wrap`)."
    (let* ((b (i64->int (width-bits w)))
           (m (arithmetic-shift 1 b))
           (low (modulo x m)))
      (if (and (width-signed? w) (>= low (arithmetic-shift 1 (- b 1)))) (- low m) low))))
(define fixed-in? (subr cm (i64 i64) bool)
  (lambda (w v) "Whether `v` is a value of width `w` (`fixed_in`)." (and (is-integer? v) (= (wrapped w (int-of v)) (int-of v)))))

"A list in the heap of strings made of `ss`."
(define-rec
  (strings-list! (subr cm ((listof string @c)) i64)
    (lambda (ss) (if (null? ss) v-null (let ((s (make-string! (car ss)))) (cons! s (strings-list! (cdr ss))))))))

"`seal-code`'s copy (C226; Fixpt's `seal_code_copy`): a bloblet's header,
 fields, trailer and suffix, in the code area, its suffix frozen and its
 instructions made seen; its fields as the bloblet's were."
(define-rec
  (code-copied! (subr cm (i64 i64 i64) unit)
    (lambda (from to n) (if (i64<= n 0) #u (begin (code-set! to (word-at from)) (code-copied! (i64+ from 1) (i64+ to 1) (i64- n 1)))))))
(define sealed-copy! (subr cm (i64) i64)
  (lambda (v)
    (let* ((h (header-index v)) (f (fields-of v)) (nw (i64-quotient (i64+ (bytes-of v) 7) 8))
           (size (i64+ (i64+ 1 f) nw)) (at (get code-top)))
      (if (i64> (i64+ at size) (get code-hi))
          (fail! "seal-code: the code area is full")
          (begin
            (code-set! at (i64-or (word-at h) (i64-shl 1 (with lay header-suffix-frozen-lo))))
            (code-copied! (i64+ h 1) (i64+ at 1) (i64+ f nw))
            (set code-top (i64+ at size))
            (code-flush (get code) (i64->int (i64+ (i64+ at 1) f)) (i64->int (if (i64= nw 0) (the i64 1) nw)))
            (i64-or (i64+ (get code-vbase) (i64* 8 (i64+ (i64+ at 1) f))) t-bloblet))))))

"Tier 1's syscalls (C224): each host name's type in canonical form, \"\"
 for none; Fixpt's three, as its runtime gives them, for now: no view of a
 flat array yet (-1), so nothing to flush."
(define tier1-syscall-type (subr kfx (string) string)
  (lambda (host)
    (cond ((string=? host "code:exec-view/1")
           "(poly ((r1 region)) (subr (maxeff (io sys) (write r1)) ((flatarrayof i64 r1) int int) int))")
          ((string=? host "code:page-words/1") "(subr (io sys) () int)")
          ((string=? host "code:flush/1")
           "(poly ((r1 region)) (subr (maxeff (io sys) (read r1)) ((flatarrayof i64 r1) int int) unit))")
          (else ""))))

"The words in one page of this machine, as kayak-rt says (C225)."
(define-syscall page-words "code:page-words/1" (subr (io sys) () int))
(define tier1-page-words (subr (maxeff (read @globals) (io sys)) () i64)
  (lambda () (int->i64 (page-words))))

"`list->string`'s (C220): whether a proper list's elements are all
 characters; their text."
(define-rec
  (chars? (subr cm (i64) bool)
    (lambda (l) (or (not (is-pair? l)) (and (is-char? (pair-car l)) (chars? (pair-cdr l))))))
  (chars-text (subr cm (i64 string) string)
    (lambda (l acc)
      (if (is-pair? l)
          (chars-text (pair-cdr l) (string-append acc (char->string (i64->char (char-code (pair-car l))))))
          acc))))

"Tables keyed by identity (C220), as Fixpt's `eqtable.rs`: a bloblet of
 kind `eqtable`, its slots the count of collections when its keys were
 last hashed (2), its count (3), its buckets (4), a vector of chains; an
 entry a vector of its key (2), value (3) and next entry (4), `#f` at a
 chain's end. Hashed by address, rehashed after a collection, relinked."
(define eq-bucket (subr kfx (i64 i64) i64)
  (lambda (key n)
    (let ((z (i64-xor (i64-shr key 3) (i64-shr key 12))))
      (i64-remainder (i64-and z 1152921504606846975) n))))
(define-rec
  (eq-falses! (subr cm (i64 i64 i64) unit)
    (lambda (v i n) (if (i64>= i n) #u (begin (slot-set! v (i64+ i 2) v-false) (eq-falses! v (i64+ i 1) n))))))
(define eq-size (subr cm (i64) i64)
  (lambda (v) "A vector's elements, its fields but the trailer." (i64- (fields-of v) 1)))
(define eq-vector! (subr cm (i64) i64)
  (lambda (n) (let ((v (make-bloblet! k-vector n 0 #t #f))) (begin (eq-falses! v 0 n) v))))
(define eqtable-made! (subr cm () i64)
  (lambda ()
    (let* ((bs (eq-vector! 8)) (t (make-bloblet! k-eqtable 3 0 #t #f)))
      (begin (slot-set! t 2 (fix (get collections))) (slot-set! t 3 (fix 0)) (slot-set! t 4 bs) t))))
(define-rec
  (chain-relinked! (subr cm (i64 i64) unit)
    (lambda (e bs)
      (if (i64= e v-false)
          #u
          (let ((next (slot-of e 4)) (b (i64+ 2 (eq-bucket (slot-of e 2) (eq-size bs)))))
            (begin (slot-set! e 4 (slot-of bs b)) (slot-set! bs b e) (chain-relinked! next bs))))))
  (buckets-relinked! (subr cm (i64 i64 i64) unit)
    (lambda (old i bs)
      (if (i64>= i (eq-size old))
          #u
          (let ((e (slot-of old (i64+ i 2))))
            (begin (slot-set! old (i64+ i 2) v-false) (chain-relinked! e bs) (buckets-relinked! old (i64+ i 1) bs)))))))
(define eqtable-relinked! (subr cm (i64 i64) unit)
  (lambda (t bs) (begin (buckets-relinked! (slot-of t 4) 0 bs) (slot-set! t 4 bs) (slot-set! t 2 (fix (get collections))))))
(define-rec
  (chain-find (subr cm (i64 i64) i64)
    (lambda (e key) (cond ((i64= e v-false) v-false) ((i64= (slot-of e 2) key) e) (else (chain-find (slot-of e 4) key))))))
(define eq-entry (subr cm (i64 i64) i64)
  (lambda (t key)
    (begin
      (if (i64= (slot-of t 2) (fix (get collections))) #u (eqtable-relinked! t (slot-of t 4)))
      (let ((bs (slot-of t 4))) (chain-find (slot-of bs (i64+ 2 (eq-bucket key (eq-size bs)))) key)))))
(define eq-set! (subr cm (i64 i64 i64) unit)
  (lambda (t key v)
    (let ((e (eq-entry t key)))
      (if (not (i64= e v-false))
          (slot-set! e 3 v)
          (let ((n (i64+ (i64-shr (slot-of t 3) 3) 1)) (size (eq-size (slot-of t 4))))
            (begin
              (slot-set! t 3 (fix n))
              (if (i64> n (i64* 2 size)) (eqtable-relinked! t (eq-vector! (i64* 2 size))) #u)
              (let* ((bs (slot-of t 4)) (b (i64+ 2 (eq-bucket key (eq-size bs)))) (x (eq-vector! 3)))
                (begin (slot-set! x 2 key) (slot-set! x 3 v) (slot-set! x 4 (slot-of bs b)) (slot-set! bs b x)))))))))
(define-rec
  (chain-without! (subr cm (i64 i64) unit)
    (lambda (before key)
      (let ((e (slot-of before 4)))
        (cond ((i64= e v-false) #u)
              ((i64= (slot-of e 2) key) (slot-set! before 4 (slot-of e 4)))
              (else (chain-without! e key)))))))
(define eq-delete! (subr cm (i64 i64) unit)
  (lambda (t key)
    (if (i64= (eq-entry t key) v-false)
        #u
        (let* ((bs (slot-of t 4)) (b (i64+ 2 (eq-bucket key (eq-size bs)))) (first (slot-of bs b)))
          (begin
            (if (i64= (slot-of first 2) key) (slot-set! bs b (slot-of first 4)) (chain-without! first key))
            (slot-set! t 3 (fix (i64- (i64-shr (slot-of t 3) 3) 1))))))))

(define fixed-op! (subr cm (i64 i64) i64)
  (lambda (w s)
    "Operation `s` of width `w` (Fixpt's `fixed_op`)."
    (let ((a (parg 0)))
      (cond
        ((i64= s 16) (if (is-integer? a) (int-value! (wrapped w (int-of a))) (expected! "an exact integer")))
        ((not (fixed-in? w a)) (expected! (width-name w)))
        ((i64= s 17) (int-value! (int-of a)))
        ((i64= s 15) (int-value! (wrapped w (bitwise-not (int-of a)))))
        ((or (i64= s 13) (i64= s 14))
         (let ((c (parg 1)))
           (if (not (is-integer? c))
               (expected! "an exact integer")
               (let ((k (modulo (int-of c) (i64->int (width-bits w)))))
                 (int-value! (wrapped w (arithmetic-shift (int-of a) (if (i64= s 13) k (- 0 k)))))))))
        (else
         (let ((b (parg 1)))
           (if (not (fixed-in? w b))
               (expected! (width-name w))
               (let ((x (int-of a)) (y (int-of b)))
                 (cond ((and (or (i64= s 3) (i64= s 4)) (zero? y)) (fail! "division by zero"))
                       ((i64= s 8) (boolean (< x y)))
                       ((i64= s 9) (boolean (<= x y)))
                       ((i64= s 10) (boolean (> x y)))
                       ((i64= s 11) (boolean (>= x y)))
                       ((i64= s 12) (boolean (= x y)))
                       (else
                        (int-value! (wrapped w (cond ((i64= s 0) (+ x y))
                                                     ((i64= s 1) (- x y))
                                                     ((i64= s 2) (* x y))
                                                     ((i64= s 3) (quotient x y))
                                                     ((i64= s 4) (remainder x y))
                                                     ((i64= s 5) (bitwise-and x y))
                                                     ((i64= s 6) (bitwise-ior x y))
                                                     (else (bitwise-xor x y)))))))))))))))

"Floats (Fixpt's `f64_op`, `f32_op`): IEEE, round to nearest even,
 nothing trapping; each `f64` a new flonum."
(define integral? (subr kfx (f64) bool) (lambda (x) (and (f64-finite? x) (f64= (f64-truncate x) x))))

(define f64-op! (subr cm (i64 i64) i64)
  (lambda (p s)
    (let ((a (parg 0)))
      (if (not (is-flonum? a))
          (expected! "an f64")
          (let ((x (flonum-of a)))
            (cond
              ((i64>= s 13)
               (cond ((i64= s 13) (make-flonum! (f64-abs x)))
                     ((i64= s 14) (make-flonum! (f64-neg x)))
                     ((i64= s 15) (make-flonum! (f64-sqrt x)))
                     ((i64= s 16) (make-flonum! (f64-floor x)))
                     ((i64= s 17) (make-flonum! (f64-ceiling x)))
                     ((i64= s 18) (make-flonum! (f64-truncate x)))
                     ((i64= s 19) (make-flonum! (f64-round x)))
                     ((i64= s 20) (make-flonum! (f64-exp x)))
                     ((i64= s 21) (make-flonum! (f64-log x)))
                     ((i64= s 22) (make-flonum! (f64-sin x)))
                     ((i64= s 23) (make-flonum! (f64-cos x)))
                     ((i64= s 24) (make-flonum! (f64-tan x)))
                     ((i64= s 25) (make-flonum! (f64-asin x)))
                     ((i64= s 26) (make-flonum! (f64-acos x)))
                     ((i64= s 27) (make-flonum! (f64-atan x)))
                     ((i64= s 28) (boolean (f64-nan? x)))
                     ((i64= s 29) (boolean (f64-infinite? x)))
                     ((i64= s 30) (boolean (f64-finite? x)))
                     ((i64= s 31) (make-string! (f64->string x)))
                     (else (if (integral? x) (int-value! (f64->int x)) (fail! "f64->int: not an integer")))))
              ((not (is-flonum? (parg 1))) (expected! "an f64"))
              (else
               (let ((y (flonum-of (parg 1))))
                 (cond ((i64= s 0) (make-flonum! (f64+ x y)))
                       ((i64= s 1) (make-flonum! (f64- x y)))
                       ((i64= s 2) (make-flonum! (f64* x y)))
                       ((i64= s 3) (make-flonum! (f64/ x y)))
                       ((i64= s 4) (make-flonum! (f64-min x y)))
                       ((i64= s 5) (make-flonum! (f64-max x y)))
                       ((i64= s 6) (make-flonum! (f64-atan2 x y)))
                       ((i64= s 7) (make-flonum! (f64-expt x y)))
                       ((i64= s 8) (boolean (f64< x y)))
                       ((i64= s 9) (boolean (f64<= x y)))
                       ((i64= s 10) (boolean (f64> x y)))
                       ((i64= s 11) (boolean (f64>= x y)))
                       (else (boolean (f64= x y))))))))))))

(define integral32? (subr kfx (f32) bool) (lambda (x) (and (f32-finite? x) (f32= (f32-truncate x) x))))

(define f32-op! (subr cm (i64 i64) i64)
  (lambda (p s)
    (let ((a (parg 0)))
      (if (not (is-f32? a))
          (expected! "an f32")
          (let ((x (f32-of a)))
            (cond
              ((i64>= s 13)
               (cond ((i64= s 13) (f32-value (f32-abs x)))
                     ((i64= s 14) (f32-value (f32-neg x)))
                     ((i64= s 15) (f32-value (f32-sqrt x)))
                     ((i64= s 16) (f32-value (f32-floor x)))
                     ((i64= s 17) (f32-value (f32-ceiling x)))
                     ((i64= s 18) (f32-value (f32-truncate x)))
                     ((i64= s 19) (f32-value (f32-round x)))
                     ((i64= s 28) (boolean (f32-nan? x)))
                     ((i64= s 29) (boolean (f32-infinite? x)))
                     ((i64= s 30) (boolean (f32-finite? x)))
                     ((i64= s 31) (make-string! (f32->string x)))
                     ((i64= s 32) (if (integral32? x) (int-value! (f32->int x)) (fail! "f32->int: not an integer")))
                     (else (make-flonum! (f32->f64 x)))))
              ((not (is-f32? (parg 1))) (expected! "an f32"))
              (else
               (let ((y (f32-of (parg 1))))
                 (cond ((i64= s 0) (f32-value (f32+ x y)))
                       ((i64= s 1) (f32-value (f32- x y)))
                       ((i64= s 2) (f32-value (f32* x y)))
                       ((i64= s 3) (f32-value (f32/ x y)))
                       ((i64= s 4) (f32-value (f32-min x y)))
                       ((i64= s 5) (f32-value (f32-max x y)))
                       ((i64= s 8) (boolean (f32< x y)))
                       ((i64= s 9) (boolean (f32<= x y)))
                       ((i64= s 10) (boolean (f32> x y)))
                       ((i64= s 11) (boolean (f32>= x y)))
                       (else (boolean (f32= x y))))))))))))

"Integers (Fixpt's `fx26_int`, `bitwise`): fixnums at once, else exact
 integers of any size, as KFX's `int`."
(define int-arith (subr cm (i64 i64 i64) i64)
  (lambda (op a b)
    (cond ((and (or (i64= op o-quotient) (i64= op o-remainder) (i64= op o-modulo)) (i64= b (fix 0)))
           (fail! "division by zero"))
          ((not (and (is-integer? a) (is-integer? b))) (expected! "an exact integer"))
          (else
           (let ((x (int-of a)) (y (int-of b)))
             (cond ((i64= op o-int-less) (boolean (< x y)))
                   ((i64= op o-int-eq) (boolean (= x y)))
                   ((i64= op o-add) (int-value! (+ x y)))
                   ((i64= op o-sub) (int-value! (- x y)))
                   ((i64= op o-mul) (int-value! (* x y)))
                   ((i64= op o-quotient) (int-value! (quotient x y)))
                   ((i64= op o-modulo) (int-value! (modulo x y)))
                   (else (int-value! (remainder x y)))))))))

(define shifted (subr cm (i64 i64) i64)
  (lambda (a b)
    "`arithmetic-shift` (Fixpt's `bitwise`'s `shift`): left by a positive
     count, right, floor, by a negative one; a huge count refused but of 0
     or rightward."
    (cond ((not (is-integer? a)) (expected! "an exact integer"))
          ((not (is-integer? b)) (expected! "an exact integer"))
          ((not (is-fixnum? b))
           (cond ((< (int-of b) 0) (if (< (int-of a) 0) (fix -1) (fix 0)))
                 ((zero? (int-of a)) (fix 0))
                 (else (fail! "arithmetic-shift: the count is too large"))))
          ((and (i64> (fix-val b) 16777216) (not (zero? (int-of a)))) (fail! "arithmetic-shift: the count is too large"))
          (else (int-value! (arithmetic-shift (int-of a) (i64->int (if (i64< (fix-val b) -4294967296) -4294967296 (fix-val b)))))))))

(define-rec
  (radix-digits (subr kfx (int int string) string)
    (lambda (n r acc)
      (if (zero? n)
          acc
          (radix-digits (quotient n r) r (string-append (char->string (string-ref-i64 "0123456789abcdefghijklmnopqrstuvwxyz" (int->i64 (remainder n r)))) acc))))))
(define int-radix (subr kfx (int int) string)
  (lambda (n r)
    (cond ((zero? n) "0") ((< n 0) (string-append "-" (radix-digits (- 0 n) r ""))) (else (radix-digits n r "")))))

(define is-number? (subr cm (i64) bool)
  (lambda (v) (or (is-integer? v) (is-flonum? v) (is-kind? v k-ratnum))))

"Flat arrays and blobrefs' layouts (Fixpt's `layout::FLAT_*`)."
(define flat-size (subr kfx (i64) i64) (lambda (code) (if (or (i64= code 0) (i64= code 1) (i64= code 4)) 4 8)))
(define flat-to-the-end i64 268435455)

(define flat-bits-ok? (subr cm (i64 i64) bool)
  (lambda (code v)
    (cond ((i64= code 0) (fixed-in? 2 v)) ((i64= code 1) (fixed-in? 3 v)) ((i64= code 2) (fixed-in? 4 v))
          ((i64= code 3) (fixed-in? 5 v)) ((i64= code 4) (is-f32? v)) (else (is-flonum? v)))))
(define flat-bits-expected (subr kfx (i64) string)
  (lambda (code)
    (cond ((i64= code 0) "an i32") ((i64= code 1) "a u32") ((i64= code 2) "an i64") ((i64= code 3) "a u64")
          ((i64= code 4) "an f32") (else "an f64"))))
(define flat-bits (subr cm (i64 i64) i64)
  (lambda (code v)
    "The bits a flat element of `code` keeps of `v` (`flat_bits_of`), `v`
     checked already."
    (cond ((or (i64= code 0) (i64= code 1)) (i64-and (int->i64 (int-of v)) 4294967295))
          ((or (i64= code 2) (i64= code 3)) (int->i64 (int-of v)))
          ((i64= code 4) (i64-and (i64-shr v 32) 4294967295))
          (else (word-at (address v))))))
(define flat-value! (subr cm (i64 i64) i64)
  (lambda (code bits)
    "The value bits of `code` stand for (`flat_value`)."
    (cond ((i64= code 0) (fix (if (i64>= bits 2147483648) (i64- bits 4294967296) bits)))
          ((i64= code 1) (fix bits))
          ((i64= code 2) (int-value! (i64->int bits)))
          ((i64= code 3) (int-value! (unsigned-int bits)))
          ((i64= code 4) (f32-bits bits))
          (else (flonum-bits! bits)))))

(define flat-bound (subr cm (i64 i64) i64)
  (lambda (r code)
    "An array's length, from `blobref-index`'s code: `n`, or the elements
     left of the suffix after ref `r` (`flat_index_bound`)."
    (let ((n (i64-shr code 32)) (size (i64-and code 4294967295)))
      (if (and (i64= n flat-to-the-end) (i64> size 0)) (i64-quotient (room-at r) size) n))))

(define indexed! (subr cm (i64 i64 i64 i64) i64)
  (lambda (r i code tag-arg)
    "`blobref-index`: element `i`'s ref, of an array whose code is `code`."
    (cond ((not (is-sref? r)) (expected! "a suffix ref"))
          ((not (is-fixnum? i)) (expected! machine-word))
          ((not (is-fixnum? code)) (expected! machine-word))
          (else
           (let ((n (flat-bound r (fix-val code))) (size (i64-and (fix-val code) 4294967295)))
             (if (or (i64< (fix-val i) 0) (i64>= (fix-val i) n))
                 (fail! "blobref-index: out of range")
                 (sref-moved! r (i64* (fix-val i) size))))))))

(define flat-index (subr cm (i64 i64) i64)
  (lambda (a i)
    "A flat array's index `i`, in range (`flat_at`), or -1, failed."
    (cond ((not (is-kind? a k-flat-array)) (begin (expected! "a flat array") -1))
          ((or (not (is-fixnum? i)) (i64< (fix-val i) 0)
               (i64>= (fix-val i) (i64-quotient (bytes-of a) (flat-size (fix-val (slot-of a 2))))))
           (begin (fail! "flatarray: index out of range") -1))
          (else (fix-val i)))))

"Bytevectors: a raw object, its length's word, then its bytes."
(define bv? (subr cm (i64) bool) (lambda (v) (is-kind? v k-bytevector)))
(define bv-length (subr cm (i64) i64) (lambda (v) (word-at (address v))))
(define bv-ref (subr cm (i64 i64) i64) (lambda (v i) (byte-of (i64+ (address v) 1) i)))
(define bv-set! (subr cm (i64 i64 i64) unit) (lambda (v i x) (byte-put! (i64+ (address v) 1) i x)))
(define make-bv! (subr cm (i64) i64)
  (lambda (n)
    (let ((b (make-bloblet! k-bytevector 0 (i64* 8 (i64+ 1 (i64-quotient (i64+ n 7) 8))) #f #f)))
      (begin (word-set! (address b) n) b))))
(define-rec
  (bv-filled! (subr cm (i64 i64 i64 i64) unit)
    (lambda (b i n x) (if (i64>= i n) #u (begin (bv-set! b i x) (bv-filled! b (i64+ i 1) n x))))))
(define-rec
  (bv-copied! (subr cm (i64 i64 i64 i64 i64) unit)
    (lambda (to at from start end)
      (if (i64>= start end) #u (begin (bv-set! to at (bv-ref from start)) (bv-copied! to (i64+ at 1) from (i64+ start 1) end))))))
(define-rec
  (bv-same? (subr cm (i64 i64 i64 i64) bool)
    (lambda (a b i n) (cond ((i64>= i n) #t) ((not (i64= (bv-ref a i) (bv-ref b i))) #f) (else (bv-same? a b (i64+ i 1) n))))))

"An index checked as Fixpt's `index` checks one: its trouble, or ``."
(define index-trouble (subr cm (i64 i64 string) string)
  (lambda (v len what)
    (cond ((not (is-fixnum? v)) (string-append "expected " machine-word))
          ((or (i64< (fix-val v) 0) (i64>= (fix-val v) len))
           (string-append what (string-append " index out of range (length " (string-append (i64->string len) ")"))))
          (else ""))))

"UTF-8, as Rust's `str::from_utf8` takes it: the length of the valid
 prefix (all of it, if valid)."
(define-rec
  (cont-ok? (subr cm (i64 i64 i64) bool)
    (lambda (b i k) (cond ((i64= k 0) #t) ((i64>= i (bv-length b)) #f)
                          ((not (i64= (i64-and (bv-ref b i) 192) 128)) #f)
                          (else (cont-ok? b (i64+ i 1) (i64- k 1)))))))
(define-rec
  (utf8-valid-up-to (subr cm (i64 i64) i64)
    (lambda (b i)
      (if (i64>= i (bv-length b))
          i
          (let* ((x (bv-ref b i))
                 (y (if (i64< (i64+ i 1) (bv-length b)) (bv-ref b (i64+ i 1)) (the i64 0)))
                 (k (the i64 (cond ((i64< x 128) 0)
                                   ((and (i64>= x 194) (i64<= x 223)) 1)
                                   ((and (i64>= x 224) (i64<= x 239)) 2)
                                   ((and (i64>= x 240) (i64<= x 244)) 3)
                                   (else -1))))
                 (second-ok (cond ((i64= x 224) (and (i64>= y 160) (i64<= y 191)))
                                  ((i64= x 237) (and (i64>= y 128) (i64<= y 159)))
                                  ((i64= x 240) (and (i64>= y 144) (i64<= y 191)))
                                  ((i64= x 244) (and (i64>= y 128) (i64<= y 143)))
                                  (else #t))))
            (if (and (i64>= k 0) (or (i64= k 0) second-ok) (cont-ok? b (i64+ i 1) k))
                (utf8-valid-up-to b (i64+ i (i64+ k 1)))
                i))))))
(define utf8-width (subr cm (i64) i64)
  (lambda (x) "How many bytes follow a lead byte `x`." (cond ((i64< x 128) 0) ((i64< x 224) 1) ((i64< x 240) 2) (else 3))))

(define utf8-point (subr cm (i64 i64 i64) i64)
  (lambda (b i k)
    "The code point of the `k + 1` bytes from `i` of bytevector `b`."
    (let ((x (bv-ref b i)))
      (cond ((i64= k 0) x)
            ((i64= k 1) (i64-or (i64-shl (i64-and x 31) 6) (i64-and (bv-ref b (i64+ i 1)) 63)))
            ((i64= k 2) (i64-or (i64-shl (i64-and x 15) 12) (i64-or (i64-shl (i64-and (bv-ref b (i64+ i 1)) 63) 6) (i64-and (bv-ref b (i64+ i 2)) 63))))
            (else (i64-or (i64-shl (i64-and x 7) 18) (i64-or (i64-shl (i64-and (bv-ref b (i64+ i 1)) 63) 12)
                           (i64-or (i64-shl (i64-and (bv-ref b (i64+ i 2)) 63) 6) (i64-and (bv-ref b (i64+ i 3)) 63)))))))))

"UTF-8, as strings and bytevectors, by index (C151): no list of the
 runtime's made of the code points or bytes, as none is let go (C43)."
(define-rec
  (utf8-count (subr cm (i64 i64 i64 i64) i64)
    (lambda (b i n k) "How many code points the valid bytes from `i` to `n` of `b` are." (if (i64>= i n) k (utf8-count b (i64+ i (i64+ 1 (utf8-width (bv-ref b i)))) n (i64+ k 1))))))

(define-rec
  (utf8-decoded! (subr cm (i64 i64 i64 i64) unit)
    (lambda (v j b i)
      "Code point `j` on of string `v`, those of bytes `i` on of `b`."
      (if (i64>= j (str-length v))
          #u
          (let ((k (utf8-width (bv-ref b i))))
            (begin (point-set! v j (utf8-point b i k)) (utf8-decoded! v (i64+ j 1) b (i64+ i (i64+ k 1)))))))))

(define utf8-bytes (subr cm (i64) i64)
  (lambda (c) "How many bytes code point `c` is in UTF-8." (cond ((i64< c 128) 1) ((i64< c 2048) 2) ((i64< c 65536) 3) (else 4))))

(define-rec
  (utf8-length (subr cm (i64 i64 i64) i64)
    (lambda (s i n) (if (i64>= i (str-length s)) n (utf8-length s (i64+ i 1) (i64+ n (utf8-bytes (str-ref s i))))))))

(define-rec
  (utf8-encoded! (subr cm (i64 i64 i64 i64) unit)
    (lambda (b j s i)
      "Byte `j` on of `b`, code points `i` on of string `s`, in UTF-8."
      (if (i64>= i (str-length s))
          #u
          (let ((c (str-ref s i)))
            (begin
              (cond ((i64< c 128) (bv-set! b j c))
                    ((i64< c 2048) (begin (bv-set! b j (i64-or 192 (i64-shr c 6))) (bv-set! b (i64+ j 1) (i64-or 128 (i64-and c 63)))))
                    ((i64< c 65536)
                     (begin (bv-set! b j (i64-or 224 (i64-shr c 12))) (bv-set! b (i64+ j 1) (i64-or 128 (i64-and (i64-shr c 6) 63)))
                            (bv-set! b (i64+ j 2) (i64-or 128 (i64-and c 63)))))
                    (else
                     (begin (bv-set! b j (i64-or 240 (i64-shr c 18))) (bv-set! b (i64+ j 1) (i64-or 128 (i64-and (i64-shr c 12) 63)))
                            (bv-set! b (i64+ j 2) (i64-or 128 (i64-and (i64-shr c 6) 63))) (bv-set! b (i64+ j 3) (i64-or 128 (i64-and c 63))))))
              (utf8-encoded! b (i64+ j (utf8-bytes c)) s (i64+ i 1))))))))

(define-rec
  (not-bytes (subr cm (i64) string)
    (lambda (l)
      "Why list `l` is not one of bytes, or \"\"."
      (cond ((not (is-pair? l)) "")
            ((not (is-fixnum? (pair-car l))) (string-append "expected " machine-word))
            ((or (i64< (fix-val (pair-car l)) 0) (i64> (fix-val (pair-car l)) 255)) "byte out of range")
            (else (not-bytes (pair-cdr l)))))))

(define-rec
  (bytes-of-list! (subr cm (i64 i64 i64) i64)
    (lambda (b i l) (if (is-pair? l) (begin (bv-set! b i (fix-val (pair-car l))) (bytes-of-list! b (i64+ i 1) (pair-cdr l))) b))))

(define fx26-sum! (subr cm (string i64) i64)
  (lambda (tag v)
    "`(sum tag v)`, as FX-26 makes one (Fixpt's `fx26_sum`)."
    (let ((b (make-bloblet! k-sum 2 0 #t #f)))
      (begin (slot-set! b 2 (symbol! tag)) (slot-set! b 3 v) (frozen-whole! b) b))))

(define frozen2! (subr cm (i64 i64 i64) i64)
  (lambda (k x y)
    "`frozen-of!` of two fields, `x` and `y`, with no list made of them (C148)."
    (let ((b (make-bloblet! k 2 0 #t #f)))
      (begin (slot-set! b 2 x) (slot-set! b 3 y) (frozen-whole! b) b))))

(define-rec
  (args-free! (subr cm (i64 i64 i64 i64) unit)
    (lambda (c k i n) (if (i64>= i n) #u (begin (slot-set! c k (parg i)) (args-free! c (i64+ k 1) (i64+ i 1) n))))))

(define closure-of! (subr cm (i64 i64 i64) i64)
  (lambda (w from n)
    "A cellular closure of word `w` over the arguments from `from` before
     the `n`th (Fixpt's `region_closure`)."
    (let ((c (make-bloblet! k-closure (i64+ (i64- n from) 1) 0 #t #f)))
      (begin (slot-set! c f-word w) (args-free! c f-free0 from n) c))))

(define-rec
  (butlast (subr cm ((listof i64 @c)) (listof i64 @c))
    (lambda (xs) (if (or (null? xs) (null? (cdr xs))) nil (cons (car xs) (butlast (cdr xs)))))))

(define vlambda! (subr cm (i64) i64)
  (lambda (f)
    "FX-26's `vlambda` (Fixpt's `%fx26-vlambda`): a closure over `f` of a
     word `rest; free 0; tailcall 1`. Its register code, which tier 1 does
     not run, is not made."
    (let ((w (make-word! "vlambda" 5 r-docol)))
      (begin
        (slot-set! w f-cell0 (fix r-rest))
        (slot-set! w (i64+ f-cell0 1) (fix r-free))
        (slot-set! w (i64+ f-cell0 2) (fix 0))
        (slot-set! w (i64+ f-cell0 3) (fix r-tailcall))
        (slot-set! w (i64+ f-cell0 4) (fix 1))
        (let ((c (make-bloblet! k-closure 2 0 #t #f))) (begin (slot-set! c f-word w) (slot-set! c f-free0 f) c))))))

(define-rec
  (fields-list (subr cm (i64 i64 i64) i64)
    (lambda (b k last) (if (i64> k last) v-null (cons! (slot-of b k) (fields-list b (i64+ k 1) last))))))

(define-rec
  (label-field (subr cm (i64 i64 i64) i64)
    (lambda (o label i)
      "The first of owner `o`'s fields from 2 that holds `label`, from `i`:
       its place, or -1."
      (cond ((not (string=? (field-trouble o (i64+ i 2)) "")) -1)
            ((i64= (slot-of o (i64+ i 2)) label) i)
            (else (label-field o label (i64+ i 1)))))))

(define-rec
  (filled-cells! (subr cm (i64 i64 (listof i64 @c)) unit)
    (lambda (w k xs) (if (null? xs) #u (begin (slot-set! w k (fix (car xs))) (filled-cells! w (i64+ k 1) (cdr xs)))))))

(define trampoline! (subr cm () i64)
  (lambda ()
    "The word a machine enters at a poll with `preempt` on its data stack:
     `call 0`, `drop`, `%fx26-preempt-done`, `drop`, `exit` (Fixpt's
     `%preempt-trampoline`)."
    (let ((w (make-word! "%preempt-trampoline" 8 r-docol)))
      (begin
        (filled-cells! w f-cell0 (list r-call 0 r-drop r-prim (prim-number "%fx26-preempt-done") 0 r-drop r-exit))
        w))))

(define sched-op! (subr cm (i64 i64 i64) i64)
  (lambda (n a b)
    "`%fx26-sched`'s operation `n` on `a` and `b` (Fixpt's `sched::run_op`),
     each operand checked to be what the operation takes."
    (cond
      ((and (or (i64= n 1) (i64= n 2) (i64= n 24) (i64= n 35) (i64= n 36) (i64= n 39) (i64= n 40))
            (not (and (is-fixnum? a) (task-live? (fix-val a)))))
       (fail! (string-append "%fx26-sched: no such task (op " (string-append (i64->string n) ")"))))
      ((and (or (i64= n 7) (i64= n 8) (i64= n 9) (i64= n 17) (i64= n 23)) (not (is-kind? a k-mailbox))) (expected! "a mailbox"))
      ((and (or (i64= n 10) (i64= n 11) (i64= n 15) (i64= n 22) (i64= n 34)) (not (is-kind? a k-icell))) (expected! "an i-cell"))
      ((or (i64= n 18) (i64= n 19))
       (cond ((not (fixed-in? 4 a)) (expected! "an i64"))
             ((i64= n 19) (boolean (i64>= (clock) (int->i64 (int-of a)))))
             (else (timer-add! (int->i64 (int-of a)) b))))
      ((i64= n 21) (timers-wait! #t))
      ((i64= n 30) (timers-wait! #f))
      ((i64= n 38)
       (if (str? a) (task-failed! (string-text a) #t) (expected! "a string")))
      ((i64= n 31)
       (let ((w (and (sched?) (wanted! #t))))
         (begin (if w (quiet-enter!) #u) (boolean w))))
      ((i64= n 32) (begin (quiet-leave!) v-unit))
      ((i64= n 33) (begin (quiet-enter!) v-unit))
      ((i64= n 0) (fix (task-new!)))
      ((i64= n 1) (fix (task-switch! (fix-val a))))
      ((i64= n 2)
       (begin (if (i64= (fix-val a) 0) #u (begin (task-end! (fix-val a)) (forget-task! a))) v-unit))
      ((or (i64= n 35) (i64= n 39))
       (let ((p (if (i64= n 39) (group-of (fix (get task-now))) v-false)))
         (begin
           (if (i64= p v-false) #u (st-cons! s-parents (cons! a p)))
           (st-cons! s-groups (cons! a a))
           (st-cons! s-monitors (cons! a b))
           v-unit)))
      ((i64= n 36)
       (let ((g (group-of (fix (get task-now)))))
         (begin (if (i64= g v-false) #u (st-cons! s-groups (cons! a g))) v-unit)))
      ((i64= n 37)
       (let ((f (st s-failure)))
         (begin
           (if (i64= f v-false)
               #u
               (begin
                 (st-set! s-failure v-false)
                 (if (i64= (get task-now) 0) #u (let ((t (get task-now))) (begin (task-end! t) (forget-task! (fix t)))))))
           f)))
      ((i64= n 24) (begin (if (i64= (fix-val a) 0) #u (st-cons! s-cancelled a)) v-unit))
      ((i64= n 25) (boolean (cancelled? a)))
      ((i64= n 3) (fix (get task-now)))
      ((i64= n 4) (begin (queue-push! a) v-unit))
      ((i64= n 5) (queue-pop!))
      ((i64= n 26)
       (begin
         (st-set! s-preempt a)
         (if (i64= (st s-trampoline) v-false) (st-set! s-trampoline (trampoline!)) #u)
         v-unit))
      ((i64= n 43) (fail! "tier 1: `%fx26-sched` of the standard input, not yet as Fixpt (C122)"))
      ((i64= n 44) (begin (st-cons! s-stdin a) v-unit))
      ((i64= n 45) (begin (st-set! s-stdin (without! (st s-stdin) 0 a)) v-unit))
      ((i64= n 40) (begin (st-cons! s-waiting (cons! a b)) v-unit))
      ((i64= n 41) (begin (st-set! s-waiting (without! (st s-waiting) 1 a)) v-unit))
      ((i64= n 42) (reaped!))
      ((i64= n 27) (begin (st-cons! s-parked a) v-unit))
      ((i64= n 28) (pop-any!))
      ((i64= n 29)
       (let ((r (i64+ (fix-val (st s-running)) (if (is-fixnum? a) (fix-val a) (the i64 0)))))
         (begin (st-set! s-running (fix (if (i64< r 0) (the i64 0) r))) v-unit)))
      ((i64= n 6) (make-mailbox!))
      ((i64= n 7) (mailbox-put! a b))
      ((i64= n 17) (boolean (mailbox-ready? a)))
      ((i64= n 8) (mailbox-take! a))
      ((i64= n 9)
       (begin (if (mailbox-ready? a) (queue-push! b) (slot-set! a 4 b)) v-unit))
      ((i64= n 10) (slot-of a 2))
      ((i64= n 15) (slot-of a 3))
      ((i64= n 11)
       (begin (if (i64= (slot-of a 2) v-false) (slot-set! a 4 (cons! b (slot-of a 4))) (queue-push! b)) v-unit))
      ((i64= n 22) (begin (slot-set! a 4 (without! (slot-of a 4) 0 b)) v-unit))
      ((i64= n 23) (begin (if (i64= (slot-of a 4) b) (slot-set! a 4 v-false) #u) v-unit))
      ((i64= n 20) (begin (st-set! s-timers (without! (st s-timers) 2 a)) v-unit))
      ((i64= n 14) (cell-put! a b))
      ((i64= n 34) (if (i64= (slot-of a 2) v-false) (cell-put! a b) v-unit))
      ((i64= n 12)
       (if (i64= (st s-tag) v-false)
           (frozen2! k-sum (symbol! "none") v-unit)
           (frozen2! k-sum (symbol! "some") (st s-tag))))
      ((i64= n 13) (begin (st-set! s-tag a) v-unit))
      ((i64= n 16) (begin (set regions (i64+ (get regions) 1)) (fix (get regions))))
      (else (fail! "%fx26-sched: no such operation")))))

(define-rec
  (reversed (subr cm (i64 i64) i64)
    (lambda (v acc) (if (is-pair? v) (reversed (pair-cdr v) (cons! (pair-car v) acc)) acc))))
(define-rec
  (flats-filled! (subr cm (i64 i64 i64 i64 i64) unit)
    (lambda (arr size bits i n)
      (if (i64>= i n) #u (begin (bytes-put! (address arr) (i64* i size) size bits 0) (flats-filled! arr size bits (i64+ i 1) n))))))

(define prim-apply! (subr cm (i64) i64)
  (lambda (p)
    "Primitive `p` given its arguments, `pargs`: its value."
    (let* ((op (prim-op p))
           (a (parg 0))
           (b (parg 1))
           (c (parg 2)))
      (cond
        ((i64>= op o-f32-ops) (f32-op! p (i64- op o-f32-ops)))
        ((i64>= op o-f64) (f64-op! p (i64- op o-f64)))
        ((i64>= op o-fixed) (fixed-op! (i64-quotient (i64- op o-fixed) 32) (i64-remainder (i64- op o-fixed) 32)))
        ((i64= op o-list) (pargs-heap-list (get pargc) v-null))
        ((i64= op o-make-box)
         (let ((x (make-bloblet! k-box 1 0 #t #f))) (begin (slot-set! x 2 a) x)))
        ((or (i64= op o-region-enter) (i64= op o-reap-enter))
         (begin (set regions (i64+ (get regions) 1)) (fix (get regions))))
        ((i64= op o-region-exit) b)
        ((i64= op o-region-cons) (cons! b c))
        ((i64= op o-make-frozen)
         (cond ((not (is-fixnum? a)) (expected! machine-word))
               ((not (or (i64= (fix-val a) k-sum) (i64= (fix-val a) k-product))) (fail! "%make-frozen makes sums and products"))
               (else (let ((b (make-bloblet! (fix-val a) (i64- (get pargc) 1) 0 #t #f)))
                       (begin (fields-of-args! b 2 1) (frozen-whole! b) b)))))
        ((and (or (i64= op o-mul) (i64= op o-add) (i64= op o-sub)) (is-fixnum? a) (is-fixnum? b))
         (int-arith op a b))
        ((or (i64= op o-mul) (i64= op o-add) (i64= op o-sub) (i64= op o-quotient) (i64= op o-remainder)
             (i64= op o-int-less) (i64= op o-int-eq))
         (if (and (is-fixnum? a) (is-fixnum? b) (or (i64= op o-int-less) (i64= op o-int-eq)))
             (boolean (if (i64= op o-int-less) (i64< a b) (i64= a b)))
             (int-arith op a b)))
        ((i64= op o-modulo)
         (cond ((not (is-number? a)) (expected! "a number"))
               ((not (is-number? b)) (expected! "a number"))
               ((not (and (is-integer? a) (is-integer? b))) (prim-failed p "of what is no exact integer"))
               (else (int-arith op a b))))
        ((or (i64= op o-max) (i64= op o-min))
         (let ((less (if (and (is-fixnum? a) (is-fixnum? b)) (boolean (i64< a b)) (int-arith o-int-less a b))))
           (cond ((trapped?) 0)
                 ((i64= op o-max) (if (i64= less v-true) b a))
                 (else (if (i64= less v-true) a b)))))
        ((i64= op o-shift) (shifted a b))
        ((or (i64= op o-bit-and) (i64= op o-bit-ior) (i64= op o-bit-xor))
         (cond ((not (is-integer? a)) (expected! "an exact integer"))
               ((not (is-integer? b)) (expected! "an exact integer"))
               ((i64= op o-bit-and) (int-value! (bitwise-and (int-of a) (int-of b))))
               ((i64= op o-bit-ior) (int-value! (bitwise-ior (int-of a) (int-of b))))
               (else (int-value! (bitwise-xor (int-of a) (int-of b))))))
        ((i64= op o-bit-not) (if (is-integer? a) (int-value! (bitwise-not (int-of a))) (expected! "an exact integer")))
        ((i64= op o-number-string)
         (cond ((not (is-number? a)) (expected! "a number"))
               ((and (not (i64< (get pargc) 2)) (not (is-fixnum? b))) (expected! machine-word))
               ((or (i64< (get pargc) 2) (i64= (fix-val b) 10) (is-flonum? a)) (make-string! (number-text a)))
               ((or (i64< (fix-val b) 2) (i64> (fix-val b) 36)) (prim-failed p "in no radix from 2 to 36"))
               ((is-integer? a) (make-string! (int-radix (int-of a) (i64->int (fix-val b)))))
               (else (make-string! (string-append (int-radix (int-of (slot-of a 3)) (i64->int (fix-val b)))
                                    (string-append "/" (int-radix (int-of (slot-of a 2)) (i64->int (fix-val b)))))))))
        ((i64= op o-zero) (boolean (i64= a (fix 0))))
        ((or (i64= op o-set-car) (i64= op o-set-cdr))
         (if (is-pair? a)
             (begin (word-set! (if (i64= op o-set-car) (address a) (i64+ (address a) 1)) b) v-unspecified)
             (expected! "a pair")))
        ((i64= op o-length)
         (let ((k (proper-length a))) (if (i64< k 0) (expected! "a proper list") (fix k))))
        ((i64= op o-pair) (boolean (is-pair? a)))
        ((i64= op o-null) (boolean (i64= a v-null)))
        ((i64= op o-boolean) (boolean (or (i64= a v-true) (i64= a v-false))))
        ((i64= op o-exact-integer) (boolean (is-integer? a)))
        ((i64= op o-nat) (boolean (and (is-fixnum? a) (i64>= (fix-val a) 0))))
        ((i64= op o-fixnum) (boolean (is-fixnum? a)))
        ((i64= op o-byte) (boolean (and (is-fixnum? a) (i64>= (fix-val a) 0) (i64<= (fix-val a) 255))))
        ((i64= op o-list-copy)
         (if (i64< (proper-length a) 0) (expected! "a list") (copied-onto! a v-null)))
        ((i64= op o-list-p) (boolean (i64>= (proper-length a) 0)))
        ((i64= op o-int-f64) (if (is-integer? a) (make-flonum! (int->f64 (int-of a))) (expected! "an exact integer")))
        ((i64= op o-int-f32) (if (is-integer? a) (f32-value (int->f32 (int-of a))) (expected! "an exact integer")))
        ((i64= op o-f64-f32) (if (is-flonum? a) (f32-value (f64->f32 (flonum-of a))) (expected! "an f64")))
        ((i64= op o-f64-bits) (if (is-flonum? a) (int-value! (unsigned-int (word-at (address a)))) (expected! "an f64")))
        ((i64= op o-bits-f64) (if (fixed-in? 5 a) (flonum-bits! (int->i64 (int-of a))) (expected! "a u64")))
        ((i64= op o-f32-bits) (if (is-f32? a) (fix (i64-and (i64-shr a 32) 4294967295)) (expected! "an f32")))
        ((i64= op o-bits-f32) (if (fixed-in? 3 a) (f32-bits (fix-val a)) (expected! "a u32")))
        ((i64= op o-append)
         ;; Fixpt's `append`: nothing, `()`; else every list but the last
         ;; copied, each checked proper, before the last.
         (cond ((i64= (get pargc) 0) v-null)
               ((not (i64= (improper-before 0 (i64- (get pargc) 1) v-null) 0)) (expected! "a proper list"))
               (else (appended-args! 0))))
        ((i64= op o-reverse)
         (if (i64< (proper-length a) 0)
             (expected! "a proper list")
             (reversed a v-null)))
        ((i64= op o-list-vector)
         (if (i64< (proper-length a) 0)
             (expected! "a proper list")
             (let ((v (make-bloblet! k-vector (proper-length a) 0 #t #f))) (begin (fields-of-list! v 2 a) v))))
        ((i64= op o-append-list)
         (cond ((i64< (proper-length a) 0) (expected! "a proper list"))
               ((not (is-pair? a)) v-null)
               ((not (i64= (improper-before 0 0 a) 0)) (expected! "a proper list"))
               (else (appended-lists! a))))
        ((i64= op o-length-is)
         (if (not (is-fixnum? b)) (expected! "a fixnum") (boolean (i64= (proper-length a) (fix-val b)))))
        ((i64= op o-first) a)
        ((i64= op o-acyclic) (boolean (acyclic-from? a nil (new nil))))
        ((i64= op o-eq) (boolean (i64= a b)))
        ((i64= op o-not) (boolean (i64= a v-false)))
        ((i64= op o-symbol) (boolean (is-kind? a k-symbol)))
        ((i64= op o-string) (boolean (str? a)))
        ((i64= op o-char) (boolean (is-char? a)))
        ((i64= op o-vector) (boolean (is-kind? a k-vector)))
        ((i64= op o-bytevector) (boolean (bv? a)))
        ((i64= op o-procedure)
         (boolean (or (is-kind? a 8) (is-kind? a 19) (is-kind? a 14) (is-kind? a k-closure) (is-kind? a k-native-closure) (is-kind? a k-continuation))))
        ((i64= op o-array) (boolean (plain? a)))
        ((i64= op o-f32) (boolean (is-f32? a)))
        ((i64= op o-box) (boolean (is-kind? a k-box)))
        ((i64= op o-sum) (boolean (is-kind? a k-sum)))
        ((i64= op o-product) (boolean (is-kind? a k-product)))
        ((i64= op o-datum-f64) (boolean (is-flonum? a)))
        ((i64= op o-string-length) (if (str? a) (fix (str-length a)) (expected! "a string")))
        ((i64= op o-char-in)
         "FX-26's `char-in?` (Fixpt's `%fx26-char-in?`): whether the character
          is one of the string's, looked for in place."
         (cond ((not (is-char? a)) (expected! "a character"))
               ((not (str? b)) (expected! "a string"))
               (else (boolean (char-found? (char-code a) b 0 (str-length b))))))
        ((i64= op o-string-ref)
         (cond ((not (str? a)) (expected! "a string"))
               ((not (string=? (index-trouble b (str-length a) "string") "")) (fail! (index-trouble b (str-length a) "string")))
               (else (char-value (str-ref a (fix-val b))))))
        ((i64= op o-string-append)
         (if (not (i64= (args-not-string 0) 0)) (expected! "a string") (args-joined! (string-made! (args-points 0 0)) 0 0)))
        ((i64= op o-string-append-list)
         (cond ((i64< (proper-length a) 0) (expected! "a proper list"))
               ((not (i64= (list-not-string a) 0)) (expected! "a string"))
               (else (list-joined! (string-made! (list-points a 0)) 0 a))))
        ((i64= op o-substring)
         (cond ((not (str? a)) (expected! "a string"))
               ((not (is-fixnum? b)) (expected! machine-word))
               ((not (is-fixnum? c)) (expected! machine-word))
               ((or (i64< (fix-val b) 0) (i64< (fix-val c) (fix-val b)) (i64> (fix-val c) (str-length a)))
                (fail! "substring range out of bounds"))
