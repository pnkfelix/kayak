         (pdef "%fx26-bitwise-and" 2 2 o-bit-and) (pdef "%fx26-bitwise-ior" 2 2 o-bit-ior) (pdef "%fx26-bitwise-xor" 2 2 o-bit-xor)
         (pdef "%fx26-bitwise-not" 1 1 o-bit-not) (pdef "number->string" 1 2 o-number-string) (pdef "%fx26-fixnum?" 1 1 o-fixnum)
         (pdef "%fx26-int->f64" 1 1 o-int-f64) (pdef "%fx26-int->f32" 1 1 o-int-f32) (pdef "%fx26-f64->f32" 1 1 o-f64-f32)
         (pdef "%fx26-f64->bits" 1 1 o-f64-bits) (pdef "%fx26-bits->f64" 1 1 o-bits-f64) (pdef "%fx26-f32->bits" 1 1 o-f32-bits)
         (pdef "%fx26-bits->f32" 1 1 o-bits-f32) (pdef "append" 0 -1 o-append) (pdef "reverse" 1 1 o-reverse)
         (pdef "list->vector" 1 1 o-list-vector) (pdef "%fx26-append-list" 1 1 o-append-list) (pdef "%fx26-length-is?" 2 2 o-length-is)
         (pdef "%fx26-first" 2 2 o-first) (pdef "%fx26-acyclic?" 1 1 o-acyclic) (pdef "eq?" 2 2 o-eq) (pdef "not" 1 1 o-not)
         (pdef "symbol?" 1 1 o-symbol) (pdef "string?" 1 1 o-string) (pdef "char?" 1 1 o-char) (pdef "vector?" 1 1 o-vector)
         (pdef "bytevector?" 1 1 o-bytevector) (pdef "%fx26-procedure?" 1 1 o-procedure) (pdef "%fx26-array?" 1 1 o-array)
         (pdef "%fx26-f32?" 1 1 o-f32) (pdef "%fx26-box?" 1 1 o-box) (pdef "%fx26-sum?" 1 1 o-sum) (pdef "%fx26-product?" 1 1 o-product)
         (pdef "%fx26-datum-f64?" 1 1 o-datum-f64) (pdef "string-length" 1 1 o-string-length) (pdef "string-ref" 2 2 o-string-ref)
         (pdef "string-append" 0 -1 o-string-append) (pdef "%fx26-string-append-list" 1 1 o-string-append-list)
         (pdef "substring" 3 3 o-substring) (pdef "string" 0 -1 o-make-string-of) (pdef "string=?" 1 -1 o-string-eq)
         (pdef "%fx26-string<?" 2 2 o-string-lt) (pdef "%fx26-string<=?" 2 2 o-string-le) (pdef "%fx26-string>?" 2 2 o-string-gt)
         (pdef "%fx26-string>=?" 2 2 o-string-ge) (pdef "%fx26-string-compare" 2 2 o-string-compare) (pdef "%string-hash" 1 1 o-string-hash)
         (pdef "%symbol-hash" 1 1 o-symbol-hash) (pdef "char->integer" 1 1 o-char-integer) (pdef "integer->char" 1 1 o-integer-char)
         (pdef "char-upcase" 1 1 o-char-upcase) (pdef "char-downcase" 1 1 o-char-downcase) (pdef "char-numeric?" 1 1 o-char-numeric)
