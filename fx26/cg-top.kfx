"cg-top.kfx: kayak's compiler to cells, its form loop and its quoted nodes (split from
 `cg.kfx`, C248): each top-level form's words, then its register twins
 (`regs-entry.kfx`), as Fixpt's `compile-twins.fx`; and the listing, each
 word's cells and its register code."

"Each of a `define-rec`'s values made, then its words' twins (C248), and
 its global set."
(define-rec
  (c-rec-fill! (subr gen (cbinds code) unit)
    (lambda (bs c)
      (if (null? bs) #u
          (tagcase (car bs)
            (cbind (n x)
              (begin (c-name-for! n x) (set cg-lambda-at (lambda-at x)) (c-exp x nil 0 c #f) (regs-form-twins!) (r-note-constant! n x)
                     (c-op1 c "global!" (o-global n)) (c-wrote! n) (c-rec-fill! (cdr bs) c))))))))

"A global defined by a form not a lambda's, or by an untyped one: its
 value made, its words' twins, its global set."
(define c-define-value! (subr gen (string cx code) unit)
  (lambda (n x c)
    (begin (set cg-form-writes nil) (c-exp x nil 0 c #f) (regs-form-twins!)
           (c-push-global! n) (r-note-constant! n x) (c-op1 c "global!" (o-global n)) (c-wrote! n))))

"Each form in turn; the last expression's value is left on the stack.
 After each, the twins of the words it made, as Fixpt's form loop makes
 them, the globals it writes counted (C248)."
(define-rec
  (c-tops (subr gen ((listof ctop acyclic) code bool) bool)
    (lambda (ts c has-value)
      (if (null? ts)
          has-value
          (tagcase (car ts)
            (t-define (n typed x)
              (begin
                (if has-value (c-op c "drop") #u)
                (tagcase x
                  ;; A lambda written with its type: its global first, so
                  ;; that it can call itself through it.
                  (x-lambda (ps body a)
                    (if typed
                        (begin (c-push-global! n) (set c-word-name (list n)) (set cg-defining (list n))
                               (set cg-lambda-at a) (set cg-form-writes (list n))
                               (r-note-constant! n x)
                               (c-lambda ps body nil 0 c nil nil) (regs-form-twins!) (r-note-inline! n ps body a)
                               (c-op1 c "global!" (o-global n)) (c-wrote! n))
                        (c-define-value! n x c)))
                  (else y (c-define-value! n x c)))
                (c-tops (cdr ts) c #f)))
            ;; Every name's global first; then each lambda, which runs nothing.
            (t-define-rec (bs)
              (begin
                (if has-value (c-op c "drop") #u)
                (c-rec-globals! bs)
                (set cg-form-writes (map (lambda ((b cbind)) (tagcase b (cbind (n x) n))) bs))
                (c-rec-fill! bs c)
                (c-tops (cdr ts) c #f)))
            (t-exp (x) (begin (if has-value (c-op c "drop") #u) (set cg-form-writes nil) (c-exp x nil 0 c #f) (regs-form-twins!) (c-tops (cdr ts) c #t)))
            (t-none () (c-tops (cdr ts) c has-value)))))))

"A program's one word, which runs it and leaves the value of its last
 expression (unit, if it has none), and the words it makes."
(define compile-cells (subr gen (sexps facts) unit)
  (lambda (forms fs)
    (let ((c (the code (new nil))))
      (begin
        (set cg-facts fs)
        (set cg-source (if (null? forms) "" (datum-file (car forms))))
        (set cg-qnodes nil)
        (set cg-convert-facts
             (filter (lambda ((x fact)) (tagcase x (fact (f p what) (or (has-prefix? what "convert ") (has-prefix? what "convention "))))) fs))
        (set cg-fx-calls nil)
        (set cg-native-calls nil)
        (set cg-module-facts
             (filter (lambda ((x fact)) (tagcase x (fact (f p what) (or (has-prefix? what "with-spec ") (has-prefix? what "module-arg ") (has-prefix? what "module-had ") (has-prefix? what "module-made ") (string=? what "module-value") (string=? what "with-value"))))) fs))
        (set cg-layouts nil)
        (set cg-included nil)
        (set cg-made nil)
        (set cg-words nil)
        (globals-reset!)
        (set cg-call-facts
             (filter (lambda ((x fact)) (tagcase x (fact (f p what) (or (string=? what "call-fx") (string=? what "call-native"))))) fs))
        (set cg-standard-words nil)
        (set c-this-params -1)
        (set cg-twins nil) (set cg-defining nil) (set cg-lambda-at -1) (set cg-define-at nil)
        (set cg-writes nil) (set cg-form-writes nil) (set cg-reg-codes nil) (set cg-inlines nil) (set cg-unrolls nil) (set cg-specials nil) (set cg-copies nil) (set cg-consts nil) (set cg-form-lambdas nil) (set cg-standard-twins nil)
        (if (c-tops (parse-tops forms) c #f) #u (c-lit c (l-unit)))
        (c-op c "exit")
        (c-assemble c "program")
        #u))))

(define-rec
  (cells-of (subr kfx (citems i64) i64) (lambda (xs n) (if (null? xs) n (cells-of (cdr xs) (i64+ n (item-size (car xs)))))))
  (word-named (subr kfx ((listof word acyclic) string) (listof word acyclic))
    (lambda (ws n) (cond ((null? ws) nil) ((tagcase (car ws) (word (m xs) (string=? m n))) (list (car ws))) (else (word-named (cdr ws) n))))))

"The listing's quoted nodes written (`quoted-interned`): Fixpt's
 `literal.rs`, an object reached more than once labelled `#N=` where it
 is first written and named `#N#` after, numbered as written, across the
 listing. First each node's reaches counted, in the order written, its
 parts only at its first; then the marks replaced."
(define-datatype qseen (qseen i64 i64))
(define cg-qreached (ref (listof qseen acyclic) @g) (new nil))
(define cg-qlabels (ref (listof qseen acyclic) @g) (new nil))
(define cg-qnext (ref i64 @g) (new 0))
(define-rec
  (qseen-of (subr kfx ((listof qseen acyclic) i64) i64)
    (lambda (ss n) (if (null? ss) 0 (tagcase (car ss) (qseen (k v) (if (i64= k n) v (qseen-of (cdr ss) n)))))))
  (qnode-parts (subr kfx ((listof qnode acyclic) i64) (listof lit acyclic))
    (lambda (ns n) (if (null? ns) nil (tagcase (car ns) (qnode (k a d) (if (i64= k n) (list a d) (qnode-parts (cdr ns) n))))))))
(define-rec
  (q-reached! (subr gen (lit) unit)
    (lambda (l)
      (tagcase l
        (l-quoted (n)
          (let ((c (qseen-of (get cg-qreached) n)))
            (begin
              (set cg-qreached (cons (qseen n (i64+ c 1)) (get cg-qreached)))
              (if (i64= c 0)
                  (let ((ps (qnode-parts (get cg-qnodes) n))) (begin (q-reached! (car ps)) (q-reached! (car (cdr ps)))))
                  #u))))
        (else y #u))))
  (q-written! (subr gen (lit) string)
    (lambda (l)
      (tagcase l
        (l-quoted (n)
          (let ((ps (qnode-parts (get cg-qnodes) n)) (k (qseen-of (get cg-qlabels) n)))
            (cond ((i64> k 0) (string-append "#" (string-append (i64->string (i64- k 1)) "#")))
                  ((i64> (qseen-of (get cg-qreached) n) 1)
                   (let ((m (get cg-qnext)))
                     (begin
                       (set cg-qnext (i64+ m 1))
                       (set cg-qlabels (cons (qseen n (i64+ m 1)) (get cg-qlabels)))
                       (string-append "#" (string-append (i64->string m) (string-append "=" (q-pair-text ps)))))))
                  (else (q-pair-text ps)))))
        (else y (lit-text l)))))
  (q-pair-text (subr gen ((listof lit acyclic)) string)
    (lambda (ps) (string-append "(" (string-append (q-written! (car ps)) (string-append " . " (string-append (q-written! (car (cdr ps))) ")")))))))
