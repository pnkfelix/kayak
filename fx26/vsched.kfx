"vsched.kfx: what FX-26's processes and `par` need of the engine's runtime
 (C219): tier 1's (cells/sched.kfx, C125; one scheduler's state for both,
 C334), as Fixpt's runtime has it: a run queue of tasks, mailboxes,
 I-cells that tasks wait for, timers, monitored groups, tasks cancelled,
 messages copied. The scheduler itself is FX-26, `fx26:processes.fx`,
 lowered with the program; it reaches these through `%sched`'s
 operations, by number, here. A task is the scheduler's: it waits by
 capturing the rest of itself up to the scheduler's prompt, which the
 engine has; here, only what the tasks share. The state is tier 1's
 `sched-state`, which the engine's collector forwards (`collect!`).
 fixpt-source: crates/fixpt-runtime/src/sched.rs@19b31f1"

(define sched-refused! (subr hp (string) i64)
  (lambda (message) "A failure, the engine's (C110)." (begin (failed-with! message) 0)))

"`%sched`'s operations."
(define task-arg? (subr cread (i64) bool)
  (lambda (a) (and (fixnum? a) (task-live? (fixnum-value a)))))

(define sched-op! (subr (maxeff vm loading) (i64 i64 i64) i64)
  (lambda (n a b)
    "`%sched`'s operation `n` on `a` and `b` (Fixpt's `sched::run_op`, tier 1's
     `sched-op!`), each operand checked to be what the operation takes."
    (cond
      ((and (or (i64= n 1) (i64= n 2) (i64= n 24) (i64= n 35) (i64= n 36) (i64= n 39) (i64= n 40)) (not (task-arg? a)))
       (sched-refused! (string-append "%fx26-sched: no such task (op " (string-append (i64->string n) ")"))))
      ((and (or (i64= n 7) (i64= n 8) (i64= n 9) (i64= n 17) (i64= n 23)) (not (is-kind? a k-mailbox))) (sched-refused! "expected a mailbox"))
      ((and (or (i64= n 10) (i64= n 11) (i64= n 15) (i64= n 22) (i64= n 34)) (not (is-kind? a k-icell))) (sched-refused! "expected an i-cell"))
      ((i64= n 18) (timer-add! (word-i64 a) b))
      ((i64= n 19) (bool-word (i64>= (clock) (word-i64 a))))
      ((i64= n 21) (timers-wait! #t))
      ((i64= n 30) (timers-wait! #f))
      ((i64= n 31) (let ((w (and (sched?) (wanted! #t)))) (begin (if w (quiet-enter!) #u) (bool-word w))))
      ((i64= n 32) (begin (quiet-leave!) w-unit))
      ((i64= n 33) (begin (quiet-enter!) w-unit))
      ((i64= n 0) (fixnum (task-new!)))
      ((i64= n 1) (fixnum (task-switch! (fixnum-value a))))
      ((i64= n 2) (begin (if (i64= (fixnum-value a) 0) #u (begin (task-end! (fixnum-value a)) (forget-task! a))) w-unit))
      ((or (i64= n 35) (i64= n 39))
       (let ((p (if (i64= n 39) (group-of (fixnum (get task-now))) w-false)))
         (begin
           (if (i64= p w-false) #u (sched-st-cons! s-parents (cons! a p)))
           (sched-st-cons! s-groups (cons! a a))
           (sched-st-cons! s-monitors (cons! a b))
           w-unit)))
      ((i64= n 36)
       (let ((g (group-of (fixnum (get task-now)))))
         (begin (if (i64= g w-false) #u (sched-st-cons! s-groups (cons! a g))) w-unit)))
      ((i64= n 37)
       (let ((f (sched-st s-failure)))
         (begin
           (if (i64= f w-false)
               #u
               (begin
                 (sched-st-set! s-failure w-false)
                 (if (i64= (get task-now) 0) #u (let ((t (get task-now))) (begin (task-end! t) (forget-task! (fixnum t)))))))
           f)))
      ((i64= n 38) (task-failed! (string-text a) #t))
      ((i64= n 24) (begin (if (i64= (fixnum-value a) 0) #u (sched-st-cons! s-cancelled a)) w-unit))
      ((i64= n 25) (bool-word (cancelled? a)))
      ((i64= n 3) (fixnum (get task-now)))
      ((i64= n 4) (begin (queue-push! a) w-unit))
      ((i64= n 5) (queue-pop!))
      ((i64= n 26) (begin (sched-st-set! s-preempt a) w-unit))
      ((i64= n 43) (bool-word (stdin-ready?)))
      ((i64= n 44) (begin (sched-st-cons! s-stdin a) w-unit))
      ((i64= n 45) (begin (sched-st-set! s-stdin (without! (sched-st s-stdin) 0 a)) w-unit))
      ;; Heist's F6 (C296): a process's output ready, its end, any's news;
      ;; a waker waiting for each, and taken back.
      ((i64= n 46) (bool-word (process-output-ready? (fixnum-value a))))
      ((i64= n 47) (begin (sched-st-cons! s-output (cons! a b)) w-unit))
      ((i64= n 48) (begin (sched-st-set! s-output (without! (sched-st s-output) 2 a)) w-unit))
      ((i64= n 49) (bool-word (process-ended? (fixnum-value a))))
      ((i64= n 50) (begin (sched-st-cons! s-exit (cons! a b)) w-unit))
      ((i64= n 51) (begin (sched-st-set! s-exit (without! (sched-st s-exit) 2 a)) w-unit))
      ((i64= n 52) (bool-word (i64>= (int->i64 (process-news)) 0)))
      ((i64= n 53) (begin (sched-st-cons! s-news a) w-unit))
      ((i64= n 54) (begin (sched-st-set! s-news (without! (sched-st s-news) 0 a)) w-unit))
      ;; `attempt-within`'s deadline (Fixpt's 3e026d63): the clock `a`
      ;; milliseconds from now.
      ((i64= n 55) (int-value! (i64->int (i64+ (clock) (i64* (if (i64< (int->i64 (int-of a)) 0) 0 (int->i64 (int-of a))) 1000000)))))
      ((i64= n 40) (begin (sched-st-cons! s-waiting (cons! a b)) w-unit))
      ((i64= n 41) (begin (sched-st-set! s-waiting (without! (sched-st s-waiting) 1 a)) w-unit))
      ((i64= n 42) (reaped!))
      ((i64= n 27) (begin (sched-st-cons! s-parked a) w-unit))
      ((i64= n 28) (pop-any!))
      ((i64= n 29)
       (let ((r (i64+ (fixnum-value (sched-st s-running)) (if (fixnum? a) (fixnum-value a) (the i64 0)))))
         (begin (sched-st-set! s-running (fixnum (if (i64< r 0) (the i64 0) r))) w-unit)))
      ((i64= n 6) (make-mailbox!))
      ((i64= n 7) (mailbox-put! a b))
      ((i64= n 17) (bool-word (mailbox-ready? a)))
      ((i64= n 8) (if (mailbox-ready? a) (mailbox-take! a) (sched-refused! "%fx26-sched: an empty mailbox taken from")))
      ((i64= n 9) (begin (if (mailbox-ready? a) (queue-push! b) (slot-set! a 4 b)) w-unit))
      ((i64= n 10) (slot-of a 2))
      ((i64= n 15) (slot-of a 3))
      ((i64= n 11) (begin (if (i64= (slot-of a 2) w-false) (slot-set! a 4 (cons! b (slot-of a 4))) (queue-push! b)) w-unit))
      ((i64= n 22) (begin (slot-set! a 4 (without! (slot-of a 4) 0 b)) w-unit))
      ((i64= n 23) (begin (if (i64= (slot-of a 4) b) (slot-set! a 4 w-false) #u) w-unit))
      ((i64= n 20) (begin (sched-st-set! s-timers (without! (sched-st s-timers) 2 a)) w-unit))
      ((i64= n 14)
       ;; Its checks the engine's failures, not tier 1's traps.
       (cond ((not (is-kind? a k-icell)) (sched-refused! "expected an i-cell"))
             ((not (i64= (slot-of a 2) w-false)) (sched-refused! "an i-cell written twice"))
             (else (cell-put! a b))))
      ((i64= n 34) (if (i64= (slot-of a 2) w-false) (cell-put! a b) w-unit))
      ((i64= n 12) (sum-word! (if (i64= (sched-st s-tag) w-false) "none" "some") (if (i64= (sched-st s-tag) w-false) w-unit (sched-st s-tag))))
      ((i64= n 13) (begin (sched-st-set! s-tag a) w-unit))
      ((i64= n 16) (begin (set regions (i64+ (get regions) 1)) (fixnum (get regions))))
      (else (sched-refused! "%fx26-sched: no such operation")))))
