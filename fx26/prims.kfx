"prims.kfx: the engine's primitives (C58): FX-26's standard environment,
 and kfx/prelude.fx's names at `i64`, each a KFX procedure of the values
 it is given. Integers of every width are `int`; an operation of a fixed
 width wraps its result as its type does. Those that touch the
 continuation (prompts, aborts, captures) are the machine's
 (machine.kfx), named here for their arity."

"The fixed widths but `i64` (`i64`'s are above): a name, its type and its
 operation; each operation done on `int` and wrapped as the type wraps."
(define fixed-types strings (list "i32" "u32" "u64" "u8" "i8"))

(define-rec
  (fixed-in (subr kfx (string strings) string)
    (lambda (n ts)
      (cond ((null? ts) "")
            ((and (has-prefix? n (car ts)) (not (string=? n (car ts)))
                  (let ((c (string-ref-i64 n (string-length-i64 (car ts))))) (or (char=? c #\+) (char=? c #\-) (char=? c #\*) (char=? c #\=) (char=? c #\<) (char=? c #\>))))
             (car ts))
            ((string=? n (string-append "int->" (car ts))) (car ts))
            (else (fixed-in n (cdr ts)))))))

(define fixed-type (subr kfx (string) string) (lambda (n) (fixed-in n fixed-types)))

(define fixed-op (subr kfx (string) string)
  (lambda (n)
    (let ((t (fixed-type n)))
      (if (has-prefix? n "int->") "from-int" (after-prefix n t)))))

(define fixed-arity (subr kfx (string) i64)
  (lambda (op) (if (string-member? op (list "-not" "->int" "->string" "from-int")) 1 2)))

(define wrapped (subr kfx (string int) int)
  (lambda (t n)
    (cond ((string=? t "i32") (i32->int (int->i32 n)))
          ((string=? t "u32") (u32->int (int->u32 n)))
          ((string=? t "u64") (u64->int (int->u64 n)))
          ((string=? t "u8") (u8->int (int->u8 n)))
          (else (i8->int (int->i8 n))))))

(define width-of (subr kfx (string) int)
  (lambda (t) (cond ((or (string=? t "u64")) 64) ((or (string=? t "i32") (string=? t "u32")) 32) (else 8))))

"The program's own arguments, as `--run`'s driver gives them (main.kfx)."
(define program-args (ref strings @h) (new nil))

(define prim-alias (subr kfx (string) string)
  (lambda (n)
    "The primitive `n` is at run time: an escape-only tag a prompt tag, an
     escape an abort (C105, as Fixpt runs them); else `n`."
    (cond ((string=? n "make-escape-tag") "make-continuation-prompt-tag")
          ((string=? n "escape") "abort-current-continuation")
          (else n))))

(define prim-arity (subr kfx (string) i64)
  (lambda (n)
    "A primitive's arity, or -1 if `n` names none."
    (cond ((string-member? n (list "i64+" "i64-" "i64*" "i64-quotient" "i64-remainder" "i64-and" "i64-or" "i64-xor"
                                   "i64=" "i64<" "i64>" "i64<=" "i64>=" "+" "-" "*" "quotient" "remainder" "modulo"
                                   "=" "<" ">" "<=" ">=" "max" "min" "bitwise-and" "bitwise-ior" "bitwise-xor" "arithmetic-shift"
                                   "string-append" "string=?" "string<?" "string>?" "char=?" "char<?" "char>?" "bool=?"
                                   "string-ref" "string-ref-i64" "cons" "set" "symbol=?" "array-ref" "make-array"
                                   "abort-current-continuation" "call-with-composable-continuation" "abort-with-continuation"
                                   "string-compare" "char-in?"))
           2)
          ((string-member? n (list "i64-not" "not" "zero?" "int->i64" "i64->int" "int->string" "i64->string" "bitwise-not"
                                   "string-length" "string-length-i64" "char->i64" "i64->char" "char->integer" "integer->char"
                                   "char->string" "string->list" "list->string" "car" "cdr" "null?" "pair?" "new" "get" "error"
                                   "string->symbol" "symbol->string" "array-length" "array->list" "list->array" "char-upcase"
                                   "char-downcase" "char-whitespace?" "char-numeric?" "char-alphabetic?" "string-downcase"
                                   "list-length" "length" "reverse"))
           1)
          ((string-member? n (list "char<=?" "char>=?" "string<=?" "string>=?" "string-ci=?" "symbol-compare" "%case="))
           2)
          ((string-member? n (list "int?" "string?" "bool?" "char?" "symbol?" "array?" "procedure?" "f64?" "ref?" "sum?" "product?" "bytevector?"
                                   "char->integer" "integer->char"))
           1)
          ((string-member? n (list "stay-cellular" "vector?" "datum-list->vector")) 1)
          ((string-member? n (list "eq?" "set-car!" "set-cdr!" "apply" "first-mark" "marks-of")) 2)
          ((string-member? n (list "with-mark")) 3)
          ((string-member? n (list "current-marks")) 1)
          ((string-member? n (list "make-continuation-mark-key")) 0)
          ((string-member? n (list "%identity" "bytevector-length" "string->utf8" "utf8->string" "flatarray-length-i64")) 1)
          ((string-member? n (list "append" "make-bytevector" "bytevector-u8-ref" "bytevector=?" "make-flatarray-i64" "flatarray-ref-i64")) 2)
          ((string-member? n (list "bytevector-u8-set!" "bytevector-copy" "flatarray-set-i64!")) 3)
          ((string=? n "bytevector-copy!") 5)
          ((string-member? n (list "substring" "array-set!" "string-search" "rcons" "rmake-array")) 3)
          ((string=? n "rnew") 2)
          ((string-member? n (list "i64-shl" "i64-shr" "write-file")) 2)
          ((string-member? n (list "write-out" "write-err" "exit" "read-file" "list-dir" "sleep-until")) 1)
          ((string-member? n (list "read-line" "clock" "args")) 0)
          ((not (string=? (fixed-type n) "")) (fixed-arity (fixed-op n)))
          ((has-prefix? n "f64") (if (string-member? n (list "f64-abs" "f64-neg" "f64-sqrt" "f64-floor" "f64-ceiling" "f64-truncate" "f64-round" "f64-exp" "f64-log" "f64-sin" "f64-cos" "f64-tan" "f64-asin" "f64-acos" "f64-atan"
                                                         "f64->string" "f64->int" "f64-nan?" "f64-infinite?" "f64-finite?")) 1 2))
          ((string=? n "int->f64") 1)
          ((string-member? n (list "make-continuation-prompt-tag")) 0)
          (else -1))))

"Values taken apart, a wrong shape an error: the checker has seen to it
 that none is, but a primitive is not to trust that."
(define val-int (subr eng (val) int)
  (lambda (v) (tagcase v (v-int (n) n) (else other (begin (failed-with! "the engine: an integer is expected") 0)))))

(define string-of (subr eng (val) string)
  (lambda (v) (tagcase v (v-string (s) s) (else other (begin (failed-with! "the engine: a string is expected") "")))))

(define char-of (subr eng (val) char)
  (lambda (v) (tagcase v (v-char (c) c) (else other (begin (failed-with! "the engine: a character is expected") #\space)))))

(define bool-of (subr eng (val) bool)
  (lambda (v) (tagcase v (v-bool (b) b) (else other (begin (failed-with! "the engine: a boolean is expected") #f)))))

(define symbol-of (subr eng (val) symbol)
  (lambda (v) (tagcase v (v-symbol (s) s) (else other (begin (failed-with! "the engine: a symbol is expected") (string->symbol ""))))))

(define w64 (subr kfx (int) int)
  (lambda (n) "An `i64`'s value: the low 64 bits, two's complement." (i64->int (int->i64 n))))

(define i64-of (subr eng (val) i64) (lambda (v) (int->i64 (val-int v))))

(define v-i64 (subr kfx (i64) val) (lambda (n) (v-int (i64->int n))))

(define-rec
  (list-of (subr eng (val) vals)
    (lambda (v)
      "A list's elements, in order."
      (tagcase v
        (v-pair (a d) (cons (get a) (list-of (get d))))
        (else other nil))))
  (list-val (subr eng (vals) val)
    (lambda (xs) (if (null? xs) (v-nil) (v-pair (new (car xs)) (new (list-val (cdr xs))))))))

(define-rec
  (chars-val (subr eng ((listof char acyclic)) val)
    (lambda (cs) (if (null? cs) (v-nil) (v-pair (new (v-char (car cs))) (new (chars-val (cdr cs))))))))

(define-rec
  (chars-of (subr eng (val) (listof char acyclic))
    (lambda (v) (tagcase v (v-pair (a d) (cons (char-of (get a)) (chars-of (get d)))) (else other nil)))))

(define-rec
  (vals-array (subr eng (vals) (arrayof val @h))
    (lambda (xs)
      (let ((a (the (arrayof val @h) (make-array (i64->int (size xs)) (v-unit)))))
        (begin (fill-array a 0 xs) a))))
  (fill-array (subr eng ((arrayof val @h) i64 vals) unit)
    (lambda (a i xs) (if (null? xs) #u (begin (array-set! a (i64->int i) (car xs)) (fill-array a (i64+ i 1) (cdr xs)))))))

(define-rec
  (array-vals (subr eng ((arrayof val @h) i64) vals)
    (lambda (a i) (if (>= (i64->int i) (array-length a)) nil (cons (array-ref a (i64->int i)) (array-vals a (i64+ i 1)))))))

(define flag (subr kfx (bool) val) (lambda (b) (v-bool b)))

(define bytes-of (subr eng (val) (bytevectorof @h))
  (lambda (v) (tagcase v (v-bytes (b) b) (else other (begin (failed-with! "the engine: a bytevector is expected") (make-bytevector 0 (int->u8 0)))))))

"An I/O error as FX-26 has it: a product of its kind, a sum, and the
 system's words."
(define io-error-val (subr eng (io-error) val)
  (lambda (e)
    (let ((kind (tagcase (extract e kind)
                  (not-found u "not-found") (permission-denied u "permission-denied") (already-exists u "already-exists")
                  (not-a-directory u "not-a-directory") (is-a-directory u "is-a-directory") (broken-pipe u "broken-pipe")
                  (invalid-data u "invalid-data") (other u "other"))))
      (v-product (list "kind" "detail") (vals-array (list (v-sum kind (v-unit)) (v-string (extract e detail))))))))

(define written (subr eng ((sumof (done unit) (failed io-error))) val)
  (lambda (r) (tagcase r (done u (v-sum "done" (v-unit))) (failed e (v-sum "failed" (io-error-val e))))))

(define-rec
  (strings-vals (subr eng (strings) vals)
    (lambda (ss) (if (null? ss) nil (cons (v-string (car ss)) (strings-vals (cdr ss)))))))

(define-rec
  (onto-vals (subr eng (vals vals) vals)
    (lambda (xs ys) (if (null? xs) ys (cons (car xs) (onto-vals (cdr xs) ys))))))

(define-rec
  (reverse-vals (subr eng (vals vals) vals)
    (lambda (xs acc) (if (null? xs) acc (reverse-vals (cdr xs) (cons (car xs) acc))))))

(define real-of (subr eng (val) f64)
  (lambda (v) (tagcase v (v-real (x) x) (else other (begin (failed-with! "the engine: an f64 is expected") 0.0)))))

(define same-atom? (subr eng (val val) bool)
  (lambda (a b)
    "`case`'s comparison: two atoms of one kind, by that kind's equality."
    (tagcase a
      (v-int (x) (tagcase b (v-int (y) (= x y)) (else other #f)))
      (v-char (x) (tagcase b (v-char (y) (char=? x y)) (else other #f)))
      (v-string (x) (tagcase b (v-string (y) (string=? x y)) (else other #f)))
      (v-bool (x) (tagcase b (v-bool (y) (bool=? x y)) (else other #f)))
      (v-symbol (x) (tagcase b (v-symbol (y) (symbol=? x y)) (else other #f)))
      (else other #f))))

(define fixed-prim (subr eng (string string val val) val)
  (lambda (t op a b)
    (let ((x (val-int a)))
      (cond ((string=? op "from-int") (v-int (wrapped t x)))
            ((string=? op "->int") a)
            ((string=? op "->string") (v-string (int->string x)))
            ((string=? op "-not") (v-int (wrapped t (bitwise-not x))))
            (else
             (let ((y (val-int b)))
               (cond ((string=? op "+") (v-int (wrapped t (+ x y))))
                     ((string=? op "-") (v-int (wrapped t (- x y))))
                     ((string=? op "*") (v-int (wrapped t (* x y))))
                     ((string=? op "-quotient") (v-int (wrapped t (quotient x y))))
                     ((string=? op "-remainder") (v-int (wrapped t (remainder x y))))
                     ((string=? op "-and") (v-int (wrapped t (bitwise-and x y))))
                     ((string=? op "-or") (v-int (wrapped t (bitwise-ior x y))))
                     ((string=? op "-xor") (v-int (wrapped t (bitwise-xor x y))))
                     ((string=? op "-shl") (v-int (wrapped t (arithmetic-shift x (modulo y (width-of t))))))
                     ((string=? op "-shr") (v-int (wrapped t (arithmetic-shift x (- 0 (modulo y (width-of t)))))))
                     ((string=? op "=") (flag (= x y)))
                     ((string=? op "<") (flag (< x y)))
                     ((string=? op ">") (flag (> x y)))
                     ((string=? op "<=") (flag (<= x y)))
                     ((string=? op ">=") (flag (>= x y)))
                     (else (begin (failed-with! (string-append "the engine has no primitive " (string-append t op))) (v-unit))))))))))

(define f64-prim (subr eng (string val val) val)
  (lambda (n a b)
    (let ((x (real-of a)))
      (cond ((string=? n "f64->string") (v-string (f64->string x)))
            ((string=? n "f64->int") (v-int (f64->int x)))
            ((string=? n "f64-abs") (v-real (f64-abs x)))
            ((string=? n "f64-neg") (v-real (f64-neg x)))
            ((string=? n "f64-sqrt") (v-real (f64-sqrt x)))
            ((string=? n "f64-exp") (v-real (f64-exp x)))
            ((string=? n "f64-log") (v-real (f64-log x)))
            ((string=? n "f64-sin") (v-real (f64-sin x)))
            ((string=? n "f64-cos") (v-real (f64-cos x)))
            ((string=? n "f64-tan") (v-real (f64-tan x)))
            ((string=? n "f64-asin") (v-real (f64-asin x)))
            ((string=? n "f64-acos") (v-real (f64-acos x)))
            ((string=? n "f64-atan") (v-real (f64-atan x)))
            ((string=? n "f64-floor") (v-real (f64-floor x)))
            ((string=? n "f64-ceiling") (v-real (f64-ceiling x)))
            ((string=? n "f64-truncate") (v-real (f64-truncate x)))
            ((string=? n "f64-round") (v-real (f64-round x)))
            ((string=? n "f64-nan?") (flag (f64-nan? x)))
            ((string=? n "f64-infinite?") (flag (f64-infinite? x)))
            ((string=? n "f64-finite?") (flag (f64-finite? x)))
            (else
             (let ((y (real-of b)))
               (cond ((string=? n "f64+") (v-real (f64+ x y)))
                     ((string=? n "f64-") (v-real (f64- x y)))
                     ((string=? n "f64*") (v-real (f64* x y)))
                     ((string=? n "f64/") (v-real (f64/ x y)))
                     ((string=? n "f64-min") (v-real (f64-min x y)))
                     ((string=? n "f64-max") (v-real (f64-max x y)))
                     ((string=? n "f64-atan2") (v-real (f64-atan2 x y)))
                     ((string=? n "f64-expt") (v-real (f64-expt x y)))
                     ((string=? n "f64<") (flag (f64< x y)))
                     ((string=? n "f64<=") (flag (f64<= x y)))
                     ((string=? n "f64>") (flag (f64> x y)))
                     ((string=? n "f64>=") (flag (f64>= x y)))
                     ((string=? n "f64=") (flag (f64= x y)))
                     (else (begin (failed-with! (string-append "the engine has no primitive " n)) (v-unit))))))))))

(define apply-prim (subr eng (string vals) val)
  (lambda (n xs)
    "Primitive `n` of the values `xs`."
    (let ((a (if (null? xs) (v-unit) (car xs)))
          (b (if (or (null? xs) (null? (cdr xs))) (v-unit) (car (cdr xs)))))
      (cond ((string=? n "i64+") (v-i64 (i64+ (i64-of a) (i64-of b))))
            ((string=? n "i64-") (v-i64 (i64- (i64-of a) (i64-of b))))
            ((string=? n "i64*") (v-i64 (i64* (i64-of a) (i64-of b))))
            ((string=? n "i64-quotient") (v-i64 (i64-quotient (i64-of a) (i64-of b))))
            ((string=? n "i64-remainder") (v-i64 (i64-remainder (i64-of a) (i64-of b))))
            ((string=? n "i64-and") (v-i64 (i64-and (i64-of a) (i64-of b))))
            ((string=? n "i64-or") (v-i64 (i64-or (i64-of a) (i64-of b))))
            ((string=? n "i64-xor") (v-i64 (i64-xor (i64-of a) (i64-of b))))
            ((string=? n "i64-not") (v-i64 (i64-not (i64-of a))))
            ((string=? n "i64=") (flag (i64= (i64-of a) (i64-of b))))
            ((string=? n "i64<") (flag (i64< (i64-of a) (i64-of b))))
            ((string=? n "i64>") (flag (i64> (i64-of a) (i64-of b))))
            ((string=? n "i64<=") (flag (i64<= (i64-of a) (i64-of b))))
            ((string=? n "i64>=") (flag (i64>= (i64-of a) (i64-of b))))
            ((string=? n "+") (v-int (+ (val-int a) (val-int b))))
            ((string=? n "-") (v-int (- (val-int a) (val-int b))))
            ((string=? n "*") (v-int (* (val-int a) (val-int b))))
            ((string=? n "quotient") (v-int (quotient (val-int a) (val-int b))))
            ((string=? n "remainder") (v-int (remainder (val-int a) (val-int b))))
            ((string=? n "modulo") (v-int (modulo (val-int a) (val-int b))))
            ((string=? n "=") (flag (= (val-int a) (val-int b))))
            ((string=? n "<") (flag (< (val-int a) (val-int b))))
            ((string=? n ">") (flag (> (val-int a) (val-int b))))
            ((string=? n "<=") (flag (<= (val-int a) (val-int b))))
            ((string=? n ">=") (flag (>= (val-int a) (val-int b))))
            ((string=? n "max") (v-int (max (val-int a) (val-int b))))
            ((string=? n "min") (v-int (min (val-int a) (val-int b))))
            ((string=? n "zero?") (flag (zero? (val-int a))))
            ((string=? n "bitwise-and") (v-int (bitwise-and (val-int a) (val-int b))))
            ((string=? n "bitwise-ior") (v-int (bitwise-ior (val-int a) (val-int b))))
            ((string=? n "bitwise-xor") (v-int (bitwise-xor (val-int a) (val-int b))))
            ((string=? n "bitwise-not") (v-int (bitwise-not (val-int a))))
            ((string=? n "arithmetic-shift") (v-int (arithmetic-shift (val-int a) (val-int b))))
            ((string=? n "int->i64") (v-int (w64 (val-int a))))
            ((string=? n "i64->int") a)
            ((string=? n "int->string") (v-string (int->string (val-int a))))
            ((string=? n "i64->string") (v-string (int->string (val-int a))))
            ((string=? n "not") (flag (not (bool-of a))))
            ((string=? n "bool=?") (flag (bool=? (bool-of a) (bool-of b))))
            ((string=? n "string-append") (v-string (string-append (string-of a) (string-of b))))
            ((string=? n "string=?") (flag (string=? (string-of a) (string-of b))))
            ((string=? n "string<?") (flag (string<? (string-of a) (string-of b))))
            ((string=? n "string>?") (flag (string>? (string-of a) (string-of b))))
            ((string=? n "string-compare") (v-int (string-compare (string-of a) (string-of b))))
            ((string=? n "string-search") (v-int (string-search (string-of a) (string-of b) (val-int (car (cdr (cdr xs)))))))
            ((string=? n "string-downcase") (v-string (string-downcase (string-of a))))
            ((or (string=? n "string-length") (string=? n "string-length-i64")) (v-int (string-length (string-of a))))
            ((or (string=? n "string-ref") (string=? n "string-ref-i64")) (v-char (string-ref (string-of a) (val-int b))))
            ((string=? n "substring") (v-string (substring (string-of a) (val-int b) (val-int (car (cdr (cdr xs)))))))
            ((or (string=? n "char->i64") (string=? n "char->integer")) (v-int (i64->int (char->i64 (char-of a)))))
            ((or (string=? n "i64->char") (string=? n "integer->char")) (v-char (i64->char (int->i64 (val-int a)))))
            ((string=? n "char->string") (v-string (char->string (char-of a))))
            ((string=? n "char=?") (flag (char=? (char-of a) (char-of b))))
            ((string=? n "char<?") (flag (char<? (char-of a) (char-of b))))
            ((string=? n "char>?") (flag (char>? (char-of a) (char-of b))))
            ((string=? n "char-upcase") (v-char (char-upcase (char-of a))))
            ((string=? n "char-downcase") (v-char (char-downcase (char-of a))))
            ((string=? n "char-whitespace?") (flag (char-whitespace? (char-of a))))
            ((string=? n "char-in?") (flag (has-char-in? (string-of b) (char-of a))))
            ((string=? n "char-numeric?") (flag (char-numeric? (char-of a))))
            ((string=? n "char-alphabetic?") (flag (char-alphabetic? (char-of a))))
            ((string=? n "string->list") (chars-val (the (listof char acyclic) (string->list (string-of a)))))
            ((string=? n "list->string") (v-string (list->string (chars-of a))))
            ((string=? n "string->symbol") (v-symbol (string->symbol (string-of a))))
            ((string=? n "symbol->string") (v-string (symbol->string (symbol-of a))))
            ((string=? n "symbol=?") (flag (symbol=? (symbol-of a) (symbol-of b))))
            ((string=? n "cons") (v-pair (new a) (new b)))
            ((string=? n "car") (tagcase a (v-pair (h t) (get h)) (else other (begin (failed-with! "car of nil") (v-unit)))))
            ((string=? n "cdr") (tagcase a (v-pair (h t) (get t)) (else other (begin (failed-with! "cdr of nil") (v-unit)))))
            ((string=? n "null?") (tagcase a (v-nil () (flag #t)) (else other (flag #f))))
            ((string=? n "pair?") (tagcase a (v-pair (h t) (flag #t)) (else other (flag #f))))
            ((or (string=? n "length") (string=? n "list-length")) (v-int (i64->int (size (list-of a)))))
            ((string=? n "reverse") (list-val (reverse-vals (list-of a) nil)))
            ((string=? n "new") (v-ref (new a)))
            ((string=? n "get") (tagcase a (v-ref (r) (get r)) (else other (begin (failed-with! "the engine: a reference is expected") (v-unit)))))
            ((string=? n "set") (tagcase a (v-ref (r) (begin (set r b) (v-unit))) (else other (begin (failed-with! "the engine: a reference is expected") (v-unit)))))
            ((string=? n "make-array") (v-array (make-array (val-int a) b)))
            ((string=? n "array-ref") (tagcase a (v-array (arr) (array-ref arr (val-int b))) (else other (v-unit))))
            ((string=? n "array-set!") (tagcase a (v-array (arr) (begin (array-set! arr (val-int b) (car (cdr (cdr xs)))) (v-unit))) (else other (v-unit))))
            ((string=? n "array-length") (tagcase a (v-array (arr) (v-int (array-length arr))) (else other (v-unit))))
            ((string=? n "array->list") (tagcase a (v-array (arr) (list-val (array-vals arr 0))) (else other (v-unit))))
            ((string=? n "list->array") (v-array (vals-array (list-of a))))
            ((string=? n "error") (begin (failed-with! (string-of a)) (v-unit)))
            ((string=? n "%identity") a)
            ((string=? n "int?") (flag (tagcase a (v-int (x) #t) (else other #f))))
            ((string=? n "string?") (flag (tagcase a (v-string (x) #t) (else other #f))))
            ((string=? n "bool?") (flag (tagcase a (v-bool (x) #t) (else other #f))))
            ((string=? n "char?") (flag (tagcase a (v-char (x) #t) (else other #f))))
            ((string=? n "symbol?") (flag (tagcase a (v-symbol (x) #t) (v-unit () #t) (else other #f))))
            ((string=? n "array?") (flag (tagcase a (v-array (x) #t) (v-flat (x) #t) (else other #f))))
            ((string=? n "procedure?") (flag (tagcase a (v-proc (n2 b e) #t) (v-prim (n2 k) #t) (v-ctor (n2 k) #t) (v-cont (fs u o) #t) (else other #f))))
            ((string=? n "f64?") (flag (tagcase a (v-real (x) #t) (else other #f))))
            ((string=? n "ref?") (flag (tagcase a (v-ref (x) #t) (else other #f))))
            ((string=? n "sum?") (flag (tagcase a (v-sum (t x) #t) (v-data (t x) #t) (else other #f))))
            ((string=? n "product?") (flag (tagcase a (v-product (l x) #t) (else other #f))))
            ((string=? n "bytevector?") (flag (tagcase a (v-bytes (x) #t) (else other #f))))
            ((string=? n "i64-shl") (v-i64 (i64-shl (i64-of a) (val-int b))))
            ((string=? n "i64-shr") (v-i64 (i64-shr (i64-of a) (val-int b))))
            ((string=? n "write-out") (written (write-out (string-of a))))
            ((string=? n "write-err") (written (write-err (string-of a))))
            ((string=? n "exit") (begin (exit (val-int a)) (v-unit)))
            ((string=? n "clock") (v-i64 (clock)))
            ((string=? n "sleep-until") (begin (sleep-until (i64-of a)) (v-unit)))
            ((string=? n "args") (list-val (strings-vals (get program-args))))
            ((string=? n "read-line")
             (tagcase (read-line) (line t (v-sum "line" (v-string t))) (eof u (v-sum "eof" (v-unit))) (failed e (v-sum "failed" (io-error-val e)))))
            ((string=? n "read-file")
             (tagcase (the (sumof (data (bytevectorof @h)) (failed io-error)) (read-file (string-of a)))
               (data d (v-sum "data" (v-bytes d))) (failed e (v-sum "failed" (io-error-val e)))))
            ((string=? n "write-file") (written (write-file (string-of a) (bytes-of b))))
            ((string=? n "list-dir")
             (tagcase (the (sumof (names strings) (failed io-error)) (list-dir (string-of a)))
               (names ns (v-sum "names" (list-val (strings-vals ns)))) (failed e (v-sum "failed" (io-error-val e)))))
            ((string=? n "append") (list-val (onto-vals (list-of a) (list-of b))))
            ((string=? n "make-bytevector") (v-bytes (make-bytevector (val-int a) (int->u8 (val-int b)))))
            ((string=? n "bytevector-length") (v-int (bytevector-length (bytes-of a))))
            ((string=? n "bytevector-u8-ref") (v-int (u8->int (bytevector-u8-ref (bytes-of a) (val-int b)))))
            ((string=? n "bytevector-u8-set!") (begin (bytevector-u8-set! (bytes-of a) (val-int b) (int->u8 (val-int (car (cdr (cdr xs)))))) (v-unit)))
            ((string=? n "bytevector-copy") (v-bytes (bytevector-copy (bytes-of a) (val-int b) (val-int (car (cdr (cdr xs)))))))
            ((string=? n "bytevector-copy!")
             (let ((r (cdr (cdr xs))))
               (begin (bytevector-copy! (bytes-of a) (val-int b) (bytes-of (car r)) (val-int (car (cdr r))) (val-int (car (cdr (cdr r))))) (v-unit))))
            ((string=? n "bytevector=?") (flag (bytevector=? (bytes-of a) (bytes-of b))))
            ((string=? n "string->utf8") (v-bytes (string->utf8 (string-of a))))
            ((string=? n "utf8->string")
             (tagcase (utf8->string (bytes-of a)) (text t (v-sum "text" (v-string t))) (bad k (v-sum "bad" (v-int k)))))
            ((string=? n "make-flatarray-i64") (v-flat (make-array (val-int a) b)))
            ((string=? n "flatarray-ref-i64") (tagcase a (v-flat (arr) (array-ref arr (val-int b))) (else other (v-unit))))
            ((string=? n "flatarray-set-i64!") (tagcase a (v-flat (arr) (begin (array-set! arr (val-int b) (car (cdr (cdr xs)))) (v-unit))) (else other (v-unit))))
            ((string=? n "flatarray-length-i64") (tagcase a (v-flat (arr) (v-int (array-length arr))) (else other (v-unit))))
            ((string=? n "%case=") (flag (same-atom? a b)))
            ((string=? n "rcons") (v-pair (new b) (new (car (cdr (cdr xs))))))
            ((string=? n "rnew") (v-ref (new b)))
            ((string=? n "rmake-array") (v-array (make-array (val-int b) (car (cdr (cdr xs))))))
            ((string=? n "char<=?") (flag (char<=? (char-of a) (char-of b))))
            ((string=? n "char>=?") (flag (char>=? (char-of a) (char-of b))))
            ((string=? n "string<=?") (flag (string<=? (string-of a) (string-of b))))
            ((string=? n "string>=?") (flag (string>=? (string-of a) (string-of b))))
            ((string=? n "string-ci=?") (flag (string-ci=? (string-of a) (string-of b))))
            ((string=? n "symbol-compare") (v-int (symbol-compare (symbol-of a) (symbol-of b))))
            ((not (string=? (fixed-type n) "")) (fixed-prim (fixed-type n) (fixed-op n) a b))
            ((string=? n "int->f64") (v-real (int->f64 (val-int a))))
            ((has-prefix? n "f64") (f64-prim n a b))
            (else (begin (failed-with! (string-append "the engine has no primitive " n)) (v-unit)))))))
