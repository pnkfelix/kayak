"main.kfx: the engine's driver (C58).

   kayak-fx26 FILE ...          the files, one program, checked, lowered
                                and run; each top-level expression's value
                                written on a line, as `fixpt eval` writes it;
   kayak-fx26 --main FILE ...   the same, then `(main)`, whose value, a
                                string, is written as it is;
   kayak-fx26 --run FILE ... -- ARG ...
                                the files, then `(main)`, as `fixpt run`
                                runs them: its arguments the ARGs, its
                                result's low byte the status.

 The checker is the compiler's (kfx/check*.kfx): what it accepts, the
 engine runs, for now."

(define-effect driving (maxeff eng gen (io args) (io fs-read) (io stdout) (io stderr) (io exit) (alloc @io) (read @io)))

(define fail-with (subr (maxeff (io stderr) (io exit)) (string int) void)
  (lambda (message status)
    (begin (write-err (string-append "kayak-fx26: " (string-append message "\n"))) (exit status))))

(define read-text (subr (maxeff (read @globals) (io fs-read) (io stderr) (io exit) (alloc @io) (read @io)) (string) string)
  (lambda (path)
    (tagcase (the (sumof (data (bytevectorof @io)) (failed io-error)) (read-file path))
      (data b (tagcase (utf8->string b) (text s s) (bad k (fail-with (string-append path ": not UTF-8") 1))))
      (failed e (fail-with (string-append "cannot read " (string-append path (string-append ": " (extract e detail)))) 1)))))

(define say (subr (io stdout) (string) unit)
  (lambda (s) (tagcase (write-out s) (done u #u) (failed e #u))))

(define-rec
  (loads-read (subr driving (strings fileds) fileds)
    (lambda (todo done)
      "The files a program loads, and those they load, each read once (C88)."
      (cond ((null? todo) done)
            ((any? (lambda ((s filed)) (tagcase s (filed (n t) (string=? n (car todo))))) done) (loads-read (cdr todo) done))
            (else
             (let ((text (read-text (car todo))))
               (loads-read (onto (load-paths-all (read-all (string-chars text) (car todo) 1) (directory-of (car todo))) (cdr todo))
                           (cons (filed (car todo) text) done))))))))

(define-rec
  (read-files (subr driving (strings) sexps)
    (lambda (paths)
      "The files, their loads spliced in as modules (C88)."
      (if (null? paths)
          nil
          (let* ((forms (read-all (string-chars (read-text (car paths))) (car paths) 1))
                 (loaded (loads-read (load-paths-all forms (directory-of (car paths))) nil)))
            (onto (with-loads forms (car paths) loaded) (read-files (cdr paths))))))))

(define-rec
  (forms-mention? (subr kfx (sexps strings) bool)
    (lambda (es heads)
      "Whether any of `es` is, or holds, a list headed by one of `heads`."
      (any? (lambda ((e sexp))
              (tagcase e
                (lst (xs f l p)
                  (or (and (not (null? xs)) (tagcase (car xs) (sym (n f2 p2) (string-member? n heads)) (else other #f)))
                      (forms-mention? xs heads)))
                (else other #f)))
            es))))

(define with-processes (subr kfx (sexps) sexps)
  (lambda (forms)
    "A program of processes, `%processes` defined first, the scheduler's
     module file built in (C219): what its forms are made calls of, as
     Fixpt's parser makes them (`process-expanded`)."
    (if (forms-mention? forms process-heads)
        (onto (with-loads (read-all (string-chars "(define %processes (load-module \"fx26:processes.fx\"))") "<scheduler>" 1) "<scheduler>" nil) forms)
        forms)))

(define-rec
  (before-dashes (subr kfx (strings) strings)
    (lambda (xs) (if (or (null? xs) (string=? (car xs) "--")) nil (cons (car xs) (before-dashes (cdr xs)))))))

(define-rec
  (after-dashes (subr kfx (strings) strings)
    (lambda (xs) (cond ((null? xs) nil) ((string=? (car xs) "--") (cdr xs)) (else (after-dashes (cdr xs)))))))

"The program loaded: the heap made, its globals and their names, the
 IR's tables, then each top-level form run in turn on the machine over
 words (vm.kfx, C64)."
(define-effect running (maxeff driving vm))

(define-rec
  (names-array! (subr running ((arrayof string @h) strings i64) unit)
    (lambda (a ns i) (if (null? ns) #u (begin (array-set! a (i64->int i) (car ns)) (names-array! a (cdr ns) (i64+ i 1)))))))

(define-rec
  (number-tops! (subr running ((listof top acyclic)) (listof i64 acyclic))
    (lambda (tops)
      "Each top-level form's node: a definition's or an expression's
       (positive: an expression's, written), none for the rest (-1)."
      (if (null? tops)
          nil
          (let ((n (tagcase (car tops)
                     (top-define (x) (i64- 0 (i64+ (number! x) 2)))
                     (top-expr (x) (number! x))
                     (top-none () (the i64 -1)))))
            (cons n (number-tops! (cdr tops))))))))

"A failure the engine said (C110), the program's: `kayak-fx26 FILE` ends
 as Fixpt's run does, its message written, and status 70; then its
 backtrace (TODO §29), which Fixpt has not."
(define failure-raised! (subr running () unit)
  (lambda ()
    (if (get engine-failed)
        (begin (write-err (string-append "kayak-fx26: " (string-append (failure-traced! "  ") "\n"))) (exit 70) #u)
        #u)))

(define-rec
  (run-tops (subr running ((listof i64 acyclic) bool) unit)
    (lambda (ns quiet)
      (if (null? ns)
          #u
          (let ((n (car ns)))
            (begin
              (cond ((i64= n -1) #u)
                    ((i64< n 0) (begin (run 0 (i64- (i64- 0 n) 2) 0 w-nil 0 0 0) (failure-raised!)))
                    (else (let ((w (run 0 n 0 w-nil 0 0 0))) (begin (failure-raised!) (if quiet #u (say (string-append (show-word w) "\n")))))))
              (run-tops (cdr ns) quiet)))))))

(define load! (subr running (strings) unit)
  (lambda (gs)
    (begin
      (heap-start! 1048576)
      (set globals (make-flatarray-i64 (size gs) w-unbound))
      (let ((names (the (arrayof string @h) (make-array (i64->int (i64+ (size gs) 1)) ""))))
        (begin (names-array! names gs 0) (set global-name-table names)))
      (set io-error-labels (label-ids! (list "kind" "detail")))
      (set size-labels (label-ids! (list "rows" "columns")))
      (if (and (i64= op-make-tag (list-position "make-continuation-prompt-tag" prim-list 0))
               (i64= op-abort (list-position "abort-current-continuation" prim-list 0))
               (i64= op-capture (list-position "call-with-composable-continuation" prim-list 0))
               (i64= op-capture-once (list-position "call-with-oneshot-continuation" prim-list 0))
               (i64= op-cwcc (list-position "cwcc" prim-list 0))
               (i64= op-suspend (list-position "abort-with-continuation" prim-list 0))
               (i64= op-apply (list-position "apply" prim-list 0)))
          #u
          (error "the engine: the control primitives' numbers are not their places in prim-list")))))

(define usage string
  "usage: kayak-fx26 [repl]                       the REPL (,help in it for more)
       kayak-fx26 FILE ...                     the files, one program, checked
                                               and run, each top-level
                                               expression's value written
       kayak-fx26 --main FILE ...              the same, then (main), its
                                               string written
       kayak-fx26 --run FILE ... [-- ARG ...]  the files, then (main) given the
                                               ARGs, its low byte the status
       kayak-fx26 --cells FILE ...             the program's cellular words,
                                               as `fixpt compile` lists its
       kayak-fx26 --keys FILE                  a REPL session from a script of
                                               keys (tests/repl/)
       kayak-fx26 --help                       this

The REPL's history is kept in ~/.kayak_fx26_history. Built with the
rust-repl feature, the REPL is C103's, in Rust's threads: there,
KAYAK_SPEC_DEBUG set, it writes each refusal of checking as you type to
stderr; KAYAK_TIMING set, each turn of its loop that took more than 5 ms,
and where the time went.
")

"The engine run on files (`kayak-fx26 FILE ...`), as `main` (start.kfx) runs
 it for whatever is not the REPL."
(define engine-main (subr running () int)
  (lambda ()
    (let* ((all (the strings (args)))
           ;; `--syscalls`: the program a runtime's own, which may declare
           ;; syscalls (C224), as Fixpt's flag says.
           (sys (and (not (null? all)) (string=? (car all) "--syscalls")))
           (as (if sys (cdr all) all))
           (running (and (not (null? as)) (string=? (car as) "--run")))
           (with-main (or running (and (not (null? as)) (string=? (car as) "--main"))))
           (paths (before-dashes (if with-main (cdr as) as))))
      (cond
        ((and (not (null? as)) (or (string=? (car as) "--help") (string=? (car as) "-h")))
         (begin (say usage) 0))
        ((null? paths)
         (begin (write-err usage) (exit 2) 2))
        ;; The program's cellular words, as Fixpt lists its (C133).
        ((string=? (car as) "--cells")
         (let* ((forms (with-processes (read-files (cdr as)))) (checked (check-program-as forms sys)))
           (tagcase checked
             (verdict (found fs) (begin (compile-cells forms fs) (say (cells-listing)) 0)))))
        (else
          (let* ((forms (with-processes (read-files paths)))
                 (checked (check-program-as forms sys))
                 (gs (onto (global-names forms) (onto (module-entries forms) (with-entries (verdict-facts checked))))))
            (begin
              (load! gs)
              (let ((ns (number-tops! (lower-tops forms gs))))
                (begin
                  (failure-raised!)
                  (run-tops ns with-main)
                  (if with-main
                      (let ((i (position-of "main" gs 0)))
                        (if (i64< i 0)
                            (begin (fail-with "no main" 1) 1)
                            (begin
                              (set program-args (after-dashes as))
                              (let ((w (run 2 0 0 w-nil 0 (flatarray-ref-i64 (get globals) i) w-nil)))
                                (cond ((get engine-failed) (begin (failure-raised!) 0)) ((is-obj? w ob-string) (begin (say (word-string w)) 0))
                                      ((and running (fixnum? w)) (begin (exit (i64->int (i64-and (fixnum-value w) 255))) 0))
                                      (else (begin (say (show-word w)) 0)))))))
                      0))))))))))
