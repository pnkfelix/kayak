"vshow.kfx: a word written as `fixpt eval` writes a value (C64). Its KFX
 string is made in proportion to what is written."

(define-rec
  (escaped-chars (subr (maxeff (read @globals) spin (read @h)) (i64 i64) string)
    (lambda (p i)
      (if (i64>= i (obj-size p))
          ""
          (let ((c (obj-ref p i)))
            (string-append (cond ((i64= c 34) "\\\"") ((i64= c 92) "\\\\") ((i64= c 10) "\\n") (else (char->string (i64->char c))))
                           (escaped-chars p (i64+ i 1))))))))

(define-rec
  (bytes-shown (subr (maxeff (read @globals) spin (read @h)) (i64 i64) string)
    (lambda (p i)
      (cond ((i64>= i (obj-size p)) "")
            ((i64= i 0) (string-append (i64->string (obj-ref p i)) (bytes-shown p (i64+ i 1))))
            (else (string-append " " (string-append (i64->string (obj-ref p i)) (bytes-shown p (i64+ i 1)))))))))

(define char-shown (subr kfx (char) string)
  (lambda (c)
    (cond ((char=? c #\space) "#\\space") ((char=? c #\newline) "#\\newline") ((char=? c #\tab) "#\\tab")
          (else (string-append "#\\" (char->string c))))))

(define-rec
  (show-word (subr hp (i64) string)
    (lambda (w)
      (cond ((fixnum? w) (i64->string (fixnum-value w)))
            ((f32-word? w) (f32->string (word-f32 w)))
            ((immediate? w)
             (let ((kind (immediate-kind w)))
               (cond ((i64= kind imm-char) (char-shown (word-char w)))
                     ((i64= kind imm-bool) (if (truthy? w) "#t" "#f"))
                     ((i64= kind imm-unit) "#u")
                     ((i64= kind imm-nil) "()")
                     ((i64= kind imm-symbol) (name-of-number (immediate-value w)))
                     ((i64= kind imm-tag) "#<prompt-tag>")
                     (else "#<closure>"))))
            ((pointer? w)
             (let ((kind (obj-kind w)))
               (cond ((i64= kind ob-big) (int->string (word-int w)))
                     ((i64= kind ob-string) (string-append "\"" (string-append (escaped-chars w 0) "\"")))
                     ((i64= kind ob-real) (f64->string (word-real w)))
                     ((i64= kind ob-pair) (string-append "(" (string-append (show-word (pair-car w)) (string-append (show-tail (pair-cdr w)) ")"))))
                     ((i64= kind ob-ref) (string-append "#<box " (string-append (show-word (obj-ref w 0)) ">")))
                     ((or (i64= kind ob-sum) (i64= kind ob-data)) (string-append "#<sum " (string-append (name-of-number (fixnum-value (obj-ref w 0))) ">")))
                     ((i64= kind ob-product) (string-append "#<product of " (string-append (i64->string (i64- (obj-size w) 1)) ">")))
                     ((i64= kind ob-array) (string-append "#<bloblet " (string-append (i64->string (i64+ (obj-size w) 1)) " fields 0 bytes>")))
                     ((i64= kind ob-flat) (string-append "#<flat-array " (string-append (i64->string (obj-size w))
                                            (string-append " fields " (string-append (i64->string (i64* 8 (obj-size w))) " bytes>")))))
                     ((i64= kind ob-vector) (string-append "#(" (string-append (vector-shown w 0) ")")))
                     ((i64= kind ob-bytes) (string-append "#u8(" (string-append (bytes-shown w 0) ")")))
                     ((i64= kind ob-ctor) (name-of-number (fixnum-value (obj-ref w 0))))
                     ((i64= kind ob-cont) "#<continuation>")
                     ((i64= kind ob-eqtable) (string-append "#<eqtable of " (string-append (i64->string (fixnum-value (obj-ref w 1))) ">")))
                     ((i64= kind ob-flatx)
                      (string-append "#<flat-array 2 fields " (string-append (i64->string (i64* (fixnum-value (obj-ref w 0)) (i64- (obj-size w) 1))) " bytes>")))
                     (else "#<closure>"))))
            (else "#<closure>"))))
  (vector-shown (subr hp (i64 i64) string)
    (lambda (w i)
      (cond ((i64>= i (obj-size w)) "")
            ((i64= i 0) (string-append (show-word (element w 0)) (vector-shown w 1)))
            (else (string-append " " (string-append (show-word (element w i)) (vector-shown w (i64+ i 1))))))))
  (show-tail (subr hp (i64) string)
    (lambda (w)
      (cond ((i64= w w-nil) "")
            ((is-obj? w ob-pair) (string-append " " (string-append (show-word (pair-car w)) (show-tail (pair-cdr w)))))
            (else (string-append " . " (show-word w)))))))
