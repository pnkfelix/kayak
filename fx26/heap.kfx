"heap.kfx: the engine's heap and its collector (C64,
 docs/research/collector.md): words in two flat arrays of `i64`, a
 copying collector (Cheney's), written in KFX. Nothing here allocates
 KFX data once the heap is made, but when it grows: kayak-rt's heap is
 never freed, so the engine's must be all its own.

 Moving to Fixpt's layout, tier 1's (C318, `docs/research/one-heap.md`).
 A word's values are Fixpt's (its `value.rs`): its low three bits its tag
 (000 a fixnum, the word shifted right by 3; 011 an immediate, a subtag
 in bits 3 to 8 and its payload above; 100 an object, at the index the
 word shifted right by 3, `vbase` 0 for now); `#f`, `#t`, `nil`, `#u`,
 the unbound marker, characters and `f32`s Fixpt's own immediates. Not
 yet Fixpt's: an object is still a header word (its kind in the low 8
 bits, its payload's size above) and its payload, a pair one too; and
 primitives, prompt tags and the machine's own specials are immediates
 of subtags Fixpt has none of (25 to 27), until each is an object as
 Fixpt has it; symbols are Fixpt's objects (C321). An IR node, in a frame or a procedure, is a
 fixnum, its number in the IR's table."

"Tags, immediates' kinds, objects' kinds."
(define imm-char i64 0)
(define imm-bool i64 1)
(define imm-unit i64 2)
(define imm-nil i64 3)
(define imm-symbol i64 4)
(define imm-prim i64 5)
(define imm-tag i64 6)
(define imm-special i64 7)

"Objects' kinds, as an object's header says them: Fixpt's kind where the
 engine's object is Fixpt's (`layout.rs`'s `KINDS`; C318), else one past
 Fixpt's (200 on) until it is. A pair has no header: Fixpt's two words."
(define ob-pair i64 0)
(define ob-ref i64 10)
(define ob-sum i64 36)
(define ob-product i64 37)
(define ob-data i64 200)
"An FX-26 array: Fixpt's bloblet of fields."
(define ob-array i64 32)
(define ob-flat i64 201)
(define ob-proc i64 8)
(define ob-cont i64 14)
(define ob-env i64 35)
(define ob-frame i64 202)
(define ob-ctor i64 203)
"`datum`'s vector (C77): its elements, words, as an array's."
(define ob-vector i64 3)
"A bloblet (C215): its bytes, an `ob-bytes`, then its fields."
(define ob-bloblet i64 204)
"A blobref (C215): its owner, a bloblet, then its offset, a fixnum."
(define ob-blobref i64 205)
"An FX-26 flat array (C220): its elements' width in bytes, a fixnum,
 then its elements, words (the engine's values are its own, not raw)."
(define ob-flatx i64 42)
"A table keyed by identity (C220, Fixpt's `eqtable.rs`): the count of
 collections when its keys were last hashed, its count of entries, its
 buckets (an `ob-array` of chains); an entry an `ob-array`, its key,
 value and next entry (`#f` at a chain's end)."
(define ob-eqtable i64 43)
"Kinds whose payload is raw words, not values: a bloblet's suffix, never
 traced, as Fixpt's. A string and a bytevector are Fixpt's (C320:
 words.kfx)."
(define ob-string i64 1)
"A symbol (C321): Fixpt's, its name (a string), its hash and its global
 slot, which in the engine holds its name's number (tier 1's holds 0: to
 settle once the heap is one); and a keyword, Fixpt's, its symbol."
(define ob-symbol i64 2)
(define ob-keyword i64 48)
(define ob-bytes i64 4)
(define ob-real i64 5)
(define ob-big i64 208)
(define raw-kind? (subr kfx (i64) bool)
  (lambda (k) (or (i64= k ob-string) (i64= k ob-bytes) (i64= k ob-real) (i64= k ob-big))))

"Making and taking apart words: Fixpt's tags (`value.rs`)."
(define fixnum-max i64 1152921504606846975)
(define fixnum-min i64 -1152921504606846976)
(define fixnum? (subr kfx (i64) bool) (lambda (w) (i64= (i64-and w 7) 0)))
(define fits-fixnum? (subr kfx (i64) bool) (lambda (n) (and (i64<= n fixnum-max) (i64>= n fixnum-min))))
(define fixnum (subr kfx (i64) i64) (lambda (n) (i64-shl n 3)))
(define fixnum-value (subr kfx (i64) i64) (lambda (w) (i64-shr w 3)))
"A pair (tag 001) or a bloblet (tag 100): an object, at index `w >> 3`,
 a pair's car, a bloblet's suffix's first word."
(define pair-tagged? (subr kfx (i64) bool) (lambda (w) (i64= (i64-and w 7) 1)))
(define pointer? (subr kfx (i64) bool) (lambda (w) (or (i64= (i64-and w 7) 4) (i64= (i64-and w 7) 1))))
(define pointer-index (subr kfx (i64) i64) (lambda (w) (i64-shr w 3)))
(define bloblet-at (subr kfx (i64) i64) (lambda (p) (i64+ (i64-shl p 3) 4)))
(define pair-at (subr kfx (i64) i64) (lambda (i) (i64+ (i64-shl i 3) 1)))
(define immediate? (subr kfx (i64) bool) (lambda (w) (i64= (i64-and w 7) 3)))

"Fixpt's immediates' subtags, and the engine's own until they are objects."
(define sub-false i64 0)
(define sub-true i64 1)
(define sub-null i64 2)
(define sub-unit i64 3)
(define sub-unbound i64 7)
(define sub-char i64 8)
(define sub-f32 i64 9)
(define sub-symbol i64 24)
(define sub-prim i64 25)
(define sub-tag i64 26)
(define sub-special i64 27)

(define imm-word (subr kfx (i64 i64) i64)
  (lambda (sub n) (i64+ (i64-shl n 8) (i64+ (i64-shl sub 3) 3))))
(define immediate-sub (subr kfx (i64) i64) (lambda (w) (i64-and (i64-shr w 3) 31)))

(define immediate (subr kfx (i64 i64) i64)
  (lambda (kind n)
    "The engine's immediate of `kind` (`imm-char` and the rest) and payload
     `n`, as Fixpt's subtag says it."
    (cond ((i64= kind imm-char) (imm-word sub-char n))
          ((i64= kind imm-bool) (imm-word (if (i64= n 0) sub-false sub-true) 0))
          ((i64= kind imm-unit) (imm-word sub-unit 0))
          ((i64= kind imm-nil) (imm-word sub-null 0))
          ((i64= kind imm-symbol) (imm-word sub-symbol n))
          ((i64= kind imm-prim) (imm-word sub-prim n))
          ((i64= kind imm-tag) (imm-word sub-tag n))
          (else (imm-word sub-special n)))))
(define immediate-kind (subr kfx (i64) i64)
  (lambda (w)
    (let ((sub (immediate-sub w)))
      (cond ((or (i64= sub sub-false) (i64= sub sub-true)) imm-bool)
            ((i64= sub sub-unit) imm-unit)
            ((i64= sub sub-null) imm-nil)
            ((i64= sub sub-char) imm-char)
            ((i64= sub sub-symbol) imm-symbol)
            ((i64= sub sub-prim) imm-prim)
            ((i64= sub sub-tag) imm-tag)
            (else imm-special)))))
(define immediate-value (subr kfx (i64) i64) (lambda (w) (i64-shr w 8)))
(define code-word (subr kfx (i64) i64) (lambda (i) (fixnum i)))
(define code-index (subr kfx (i64) i64) (lambda (w) (fixnum-value w)))

"Fixpt's constants (`value.rs`): `#f` 3, `#t` 11, `nil` 19, `#u` 27, the
 unbound marker 59."
(define w-unit i64 27)
(define w-nil i64 19)
(define w-true i64 11)
(define w-false i64 3)
(define w-unbound i64 59)

"The heap: the space allocated in, the other, the next free index, and
 the limit past which a step may not go. A constant each, made once."
(define space (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 1 0)))
(define other-space (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 1 0)))
(define free-at (ref i64 @h) (new 1))
"Each name's symbol and keyword, by its number, once made (0 until then):
 roots, so that each name has one object (C321)."
(define symbol-objects (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 64 0)))
(define keyword-objects (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 64 0)))
(define collections (ref i64 @h) (new 0))

(define heap-start! (subr (maxeff (read @globals) spin (read @h) (write @h) (alloc @h)) (i64) unit)
  (lambda (words)
    "Two spaces of `words` words each. Index 0 is never an object's, so
     that a pointer's index is never 0."
    (begin
      (set space (make-flatarray-i64 words 0))
      (set other-space (make-flatarray-i64 words 0))
      (set free-at 1))))

(define heap-room (subr (maxeff (read @globals) spin (read @h)) () i64)
  (lambda ()
    "The room left, as the machine counts what a step needs: a header and a
     payload an object (C64). Two thirds of the words free, since Fixpt's
     layout (C318) gives an object of fields a trailer too, at most half as
     much again (one of a field); one of none has no trailer, and a pair is
     two words, not three."
    (i64-quotient (i64* (i64- (flatarray-length-i64 (get space)) (get free-at)) 2) 3)))

"Fixpt's headers (`layout.fx`): tag 110, the kind in bits 3 to 11, a
 large header's mark at bit 11, the fields (F, with the trailer) in bits
 14 to 32, the suffix's bytes (B) in bits 32 to 64; a large header's F
 in the extension word before it, kind 255, its F above bit 11. A
 trailer, the last field, is tag 101 and F above."
(define fields-max i64 262143)
(define header (subr kfx (i64 i64 i64) i64)
  (lambda (kind f b) (i64+ (i64-shl b 32) (i64+ (i64-shl f 14) (i64+ (i64-shl kind 3) 6)))))
(define large-header (subr kfx (i64 i64) i64)
  (lambda (kind b) (i64+ (i64-shl b 32) (i64+ 2048 (i64+ (i64-shl kind 3) 6)))))
(define extension (subr kfx (i64) i64) (lambda (f) (i64+ (i64-shl f 11) (i64+ (i64-shl 255 3) 6))))
(define trailer (subr kfx (i64) i64) (lambda (f) (i64+ (i64-shl f 3) 5)))
(define header-kind (subr kfx (i64) i64) (lambda (h) (i64-and (i64-shr h 3) 255)))
(define header-large? (subr kfx (i64) bool) (lambda (h) (i64= (i64-and (i64-shr h 11) 1) 1)))
(define header-fields (subr kfx (i64) i64) (lambda (h) (i64-and (i64-shr h 14) fields-max)))
(define header-bytes (subr kfx (i64) i64) (lambda (h) (i64-and (i64-shr h 32) 4294967295)))
(define extension-fields (subr kfx (i64) i64) (lambda (x) (i64-shr x 11)))
(define word-tag (subr kfx (i64) i64) (lambda (w) (i64-and w 7)))
(define suffix-words (subr kfx (i64) i64) (lambda (b) (i64-quotient (i64+ b 7) 8)))

(define bump! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64) i64)
  (lambda (n)
    (let ((at (get free-at)))
      (if (i64> (i64+ at n) (flatarray-length-i64 (get space)))
          (begin (error "the engine's heap: a step allocated past the room it was given") 0)
          (begin (set free-at (i64+ at n)) at)))))

(define put! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64 i64) unit)
  (lambda (i w) (flatarray-set-i64! (get space) i w)))
(define at-word (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (i) (flatarray-ref-i64 (get space) i)))

(define alloc! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64 i64) i64)
  (lambda (kind n)
    "An object of `kind`, `n` words of payload, in Fixpt's layout (C318): a
     pair two words; an object of raw words a bloblet whose suffix they are;
     any other a bloblet of `n` fields and a trailer, so that payload word
     `i` is the word `i` after the header, as `alloc` lays it out. The room
     was made sure of before the step (`heap-ensure!`)."
    (cond ((i64= kind ob-pair) (pair-at (bump! 2)))
          ;; No fields: no trailer, the word below the suffix its header.
          ((or (raw-kind? kind) (i64= n 0))
           (let ((at (bump! (i64+ n 1)))) (begin (put! at (header kind 0 (i64* 8 n))) (bloblet-at (i64+ at 1)))))
          (else
           (let ((f (i64+ n 1)))
             (if (i64> f fields-max)
                 (let ((at (bump! (i64+ f 2))))
                   (begin (put! at (extension f)) (put! (i64+ at 1) (large-header kind 0))
                          (put! (i64+ at (i64+ f 1)) (trailer f))
                          (bloblet-at (i64+ at (i64+ f 2)))))
                 (let ((at (bump! (i64+ f 1))))
                   (begin (put! at (header kind f 0)) (put! (i64+ at f) (trailer f))
                          (bloblet-at (i64+ at (i64+ f 1)))))))))))

"An object's payload: a pair's two words; a bloblet's fields, found by its
 trailer (`p - F + i`), or, with none, its suffix (`p + i`)."
(define payload-at (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
  (lambda (v i)
    (if (pair-tagged? v)
        (i64+ (pointer-index v) i)
        (let* ((p (pointer-index v)) (b (at-word (i64- p 1))))
          (if (i64= (word-tag b) 5) (i64+ (i64- p (i64-shr b 3)) i) (i64+ p i))))))

(define header-at (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (v)
    "A bloblet's main header's index."
    (let* ((p (pointer-index v)) (b (at-word (i64- p 1))))
      (if (i64= (word-tag b) 5) (i64- (i64- p 1) (i64-shr b 3)) (i64- p 1)))))

(define obj-kind (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (v) (if (pair-tagged? v) ob-pair (header-kind (at-word (header-at v))))))

(define obj-size (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (v)
    (if (pair-tagged? v)
        2
        (let* ((p (pointer-index v)) (b (at-word (i64- p 1))))
          (if (i64= (word-tag b) 5) (i64- (i64-shr b 3) 1) (i64-quotient (header-bytes b) 8))))))

(define obj-ref (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
  (lambda (v i) (at-word (payload-at v i))))

(define obj-set! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64 i64 i64) unit)
  (lambda (v i w) (put! (payload-at v i) w)))

"The engine's own objects, which only it reads (frames, environments,
 closures, continuations): payload word `i` is field `i + 2`, at `p - 2 -
 i`, Fixpt's `slot` order (`bloblet_slot`), no trailer read to find it
 (C318). Every other object's is `alloc`'s order, which Fixpt's code reads
 (`obj-ref`), its trailer read for its count of fields."
(define slot-ref (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
  (lambda (v i) (at-word (i64- (i64- (pointer-index v) 2) i))))
(define slot-set! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64 i64 i64) unit)
  (lambda (v i w) (put! (i64- (i64- (pointer-index v) 2) i) w)))

"The collector: Cheney's, over Fixpt's objects. Each root copied, then
 the copies scanned, header by header (a word no header begins a pair);
 a moved object's forwarding, tag 111, its copy's index, in a pair's first
 word and in the word below a bloblet's suffix."

(define-rec
  (copy-words! (subr (maxeff (read @globals) spin (read @h) (write @h)) ((flatarrayof i64 @h) (flatarrayof i64 @h) i64 i64 i64) unit)
    (lambda (from to i at n)
      (if (i64= n 0)
          #u
          (begin (flatarray-set-i64! to at (flatarray-ref-i64 from i))
                 (copy-words! from to (i64+ i 1) (i64+ at 1) (i64- n 1)))))))

(define forwarded (subr kfx (i64) i64) (lambda (i) (i64+ (i64-shl i 3) 7)))

(define copy-word! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64) i64)
  (lambda (w)
    "`w`, its object copied to the other space if it is one not yet copied:
     the word that now names it."
    (cond ((not (pointer? w)) w)
          ((pair-tagged? w)
           (let* ((from (get space)) (i (pointer-index w)) (c (flatarray-ref-i64 from i)))
             (if (i64= (word-tag c) 7)
                 (pair-at (i64-shr c 3))
                 (let ((at (get free-at)))
                   (begin
                     (copy-words! from (get other-space) i at 2)
                     (flatarray-set-i64! from i (forwarded at))
                     (set free-at (i64+ at 2))
                     (pair-at at))))))
          (else
           (let* ((from (get space)) (p (pointer-index w)) (b (flatarray-ref-i64 from (i64- p 1))))
             (if (i64= (word-tag b) 7)
                 (bloblet-at (i64-shr b 3))
                 (let* ((f (if (i64= (word-tag b) 5) (i64-shr b 3) (the i64 0)))
                        (hi (i64- (i64- p 1) f))
                        (h (flatarray-ref-i64 from hi))
                        (start (if (header-large? h) (i64- hi 1) hi))
                        (n (i64+ (i64- p start) (suffix-words (header-bytes h))))
                        (at (get free-at))
                        (np (i64+ at (i64- p start))))
                   (begin
                     (copy-words! from (get other-space) start at n)
                     (flatarray-set-i64! from (i64- p 1) (forwarded np))
                     (set free-at (i64+ at n))
                     (bloblet-at np)))))))))

(define-rec
  (scan-words! (subr (maxeff (read @globals) spin (read @h) (write @h)) ((flatarrayof i64 @h) i64 i64) unit)
    (lambda (to at n)
      (if (i64= n 0)
          #u
          (begin (flatarray-set-i64! to at (copy-word! (flatarray-ref-i64 to at)))
                 (scan-words! to (i64+ at 1) (i64- n 1)))))))

(define-rec
  (scan! (subr (maxeff (read @globals) spin (read @h) (write @h)) (i64) unit)
    (lambda (at)
      "The objects copied, from `at` to the free index, each scanned: a
       bloblet's fields, not its suffix; a pair's two words."
      (if (i64>= at (get free-at))
          #u
          (let* ((to (get other-space)) (w (flatarray-ref-i64 to at)))
            (if (i64= (word-tag w) 6)
                (if (i64= (header-kind w) 255)
                    (let* ((f (extension-fields w)) (h (flatarray-ref-i64 to (i64+ at 1))))
                      (begin (scan-words! to (i64+ at 2) f)
                             (scan! (i64+ at (i64+ 2 (i64+ f (suffix-words (header-bytes h))))))))
                    (let ((f (header-fields w)))
                      (begin (scan-words! to (i64+ at 1) f)
                             (scan! (i64+ at (i64+ 1 (i64+ f (suffix-words (header-bytes w)))))))))
                (begin (scan-words! to at 2) (scan! (i64+ at 2)))))))))

(define-rec
  (copy-roots! (subr (maxeff (read @globals) spin (read @h) (write @h)) ((flatarrayof i64 @h) i64 i64) unit)
    (lambda (roots i n)
      (if (i64>= i n)
          #u
          (begin (flatarray-set-i64! roots i (copy-word! (flatarray-ref-i64 roots i)))
                 (copy-roots! roots (i64+ i 1) n))))))

(define grow! (subr (maxeff (read @globals) spin (read @h) (write @h) (alloc @h)) ((flatarrayof i64 @h) (flatarrayof i64 @h) (flatarrayof i64 @h) i64) unit)
  (lambda (roots globals consts words)
    "Two new spaces of `words` words, what lives copied into them: the old
     two left to kayak-rt, which never frees them (a geometric cost)."
    (begin
      (set other-space (make-flatarray-i64 words 0))
      (set free-at 1)
      (copy-roots! roots 0 (flatarray-length-i64 roots))
      (copy-roots! globals 0 (flatarray-length-i64 globals))
      (copy-roots! consts 0 (flatarray-length-i64 consts))
      (copy-roots! (get symbol-objects) 0 (flatarray-length-i64 (get symbol-objects)))
      (copy-roots! (get keyword-objects) 0 (flatarray-length-i64 (get keyword-objects)))
      (scan! 1)
      (set space (get other-space))
      (set other-space (make-flatarray-i64 words 0)))))

(define collect! (subr (maxeff (read @globals) spin (read @h) (write @h) (alloc @h)) ((flatarrayof i64 @h) (flatarrayof i64 @h) (flatarrayof i64 @h) i64) unit)
  (lambda (roots globals consts need)
    "Every object `roots`, `globals` and `consts` reach copied to the other space,
     which becomes the one allocated in; the spaces grown, both, if what
     survives and `need` would fill more than half. The roots updated in
     place."
    (begin
      (set free-at 1)
      (copy-roots! roots 0 (flatarray-length-i64 roots))
      (copy-roots! globals 0 (flatarray-length-i64 globals))
      (copy-roots! consts 0 (flatarray-length-i64 consts))
      (copy-roots! (get symbol-objects) 0 (flatarray-length-i64 (get symbol-objects)))
      (copy-roots! (get keyword-objects) 0 (flatarray-length-i64 (get keyword-objects)))
      (scan! 1)
      (let ((from (get space)))
        (begin
          (set space (get other-space))
          (set other-space from)
          (set collections (i64+ (get collections) 1))
          (let ((live (i64+ (get free-at) need)))
            (if (i64> (i64* live 2) (flatarray-length-i64 (get space)))
                (grow! roots globals consts (i64* live 4))
                #u)))))))

"Interned names: symbols, tags, labels and label lists, each a number in a
 table of strings, made once a name, never freed."
(define names (ref (arrayof string @h) @h) (new (make-array 64 "")))
(define name-count (ref i64 @h) (new 0))

(define-rec
  (name-at (subr (maxeff (read @globals) spin (read @h)) (string i64 i64) i64)
    (lambda (s i n)
      (cond ((i64>= i n) -1)
            ((string=? (array-ref (get names) (i64->int i)) s) i)
            (else (name-at s (i64+ i 1) n))))))

(define-rec
  (names-copied! (subr (maxeff (read @globals) spin (read @h) (write @h)) ((arrayof string @h) (arrayof string @h) i64 i64) unit)
    (lambda (from to i n)
      (if (i64>= i n) #u (begin (array-set! to (i64->int i) (array-ref from (i64->int i))) (names-copied! from to (i64+ i 1) n))))))

(define intern! (subr (maxeff (read @globals) spin (read @h) (write @h) (alloc @h)) (string) i64)
  (lambda (s)
    "The number of name `s`, made if it has none."
    (let ((found (name-at s 0 (get name-count))))
      (if (i64>= found 0)
          found
          (let ((n (get name-count)))
            (begin
              (if (i64>= n (int->i64 (array-length (get names))))
                  (let ((bigger (the (arrayof string @h) (make-array (i64->int (i64* n 2)) ""))))
                    (begin (names-copied! (get names) bigger 0 n) (set names bigger)))
                  #u)
              (array-set! (get names) (i64->int n) s)
              (set name-count (i64+ n 1))
              n))))))

(define name-of-number (subr (maxeff (read @globals) spin (read @h)) (i64) string)
  (lambda (n) (array-ref (get names) (i64->int n))))
