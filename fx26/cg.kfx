"cg.kfx: an FX-26 program, checked, compiled to cellular words (C133), as
 Fixpt's compiler written in FX-26 compiles one (its `compile.fx` and the
 files after it), decision for decision, so that the words are the ones
 Fixpt's listing shows: `kayak-fx26 --cells FILE` writes them as
 `fixpt compile --full-literals` writes its, and kayak-cells runs them.

 The program is first made Fixpt's parser's trees (`cx`, its `exp`), its
 derived forms expanded as that parser expands them (`parser-exps.fx`),
 each node with where it starts, which names a lambda's word. The
 compiler then follows `compile-exps.fx`: a lambda's arguments are its
 frame on the data stack, a `let`'s values are pushed onto the frame and
 are slots of it, closures are flat, globals are cells, and a call in tail
 position is a tail call; a module is a product of its values (C144); a
 region an arena or a reap entered and left (C145); a prompt the routine
 that runs its body, a procedure of nothing, under its tag (C146). Not
 yet: Fixpt's middle phase (its plans, inlining, specialization), lambda
 lifting, register code (the words' twins). Bloblets and floats: C152.
 fixpt-source: crates/fixpt-fx26/src/compile.fx@bb3f570
 fixpt-source: crates/fixpt-fx26/src/compile-exps.fx@d28cc6d
 fixpt-source: crates/fixpt-fx26/src/compile-state.fx@d28cc6d
 fixpt-source: crates/fixpt-fx26/src/compile-lift.fx@bb3f570
 fixpt-source: crates/fixpt-fx26/src/compile-programs.fx@f03cabe
 fixpt-source: crates/fixpt-fx26/src/parser-exps.fx@f03cabe
 fixpt-source: crates/fixpt-fx26/src/parser.fx@f03cabe"

"The generator's data lives at `@g`."
(define-effect gen (maxeff (read @globals) spin (read @g) (write @g) (alloc @g)))

"Fixpt's table of the runtime primitive each standard operation runs as."
(define standard (load-module "fx26:standard.fx"))

;;; ------------------------------------------------------------ the trees

"Fixpt's `exp`, each node with where it starts (its `a`): a variable, the
 literals, a lambda of its parameters' names, an application, `if`,
 `let`, `letrec`, `begin`, a product of its fields, an `extract` of the
 field the checker found (`extract-index`), a sum, a `tagcase`. Type
 abstractions and ascriptions compile to nothing, so are not kept."
(define-datatype cx
  (x-var string i64)
  (x-int int i64)
  (x-bool bool i64)
  (x-str string i64)
  (x-char char i64)
  (x-float int i64)
  (x-sym string i64)
  (x-unit i64)
  (x-lambda strings cx i64)
  (x-app cx (listof cx acyclic) i64)
  (x-if cx cx cx i64)
  (x-let (listof cbind acyclic) cx i64)
  (x-letrec (listof cbind acyclic) cx i64)
  (x-begin (listof cx acyclic) i64)
  (x-proj cx i64)
  (x-product (listof cbind acyclic) i64)
  (x-extract cx i64 i64)
  (x-sum string cx i64)
  ;; Its arms, its `else`, and, of a blobref to a flat sum, its layout's
  ;; code (Fixpt's `w + 8 * numeric + 256 * p`), else -1.
  (x-tagcase cx (listof carm acyclic) (listof cbind acyclic) i64 i64)
  (x-prompt cx cx cx i64)
  (x-bloblet string i64 (listof cx acyclic) i64)
  (x-region i64 string cx i64)
  (x-rlambda cx cx i64)
  (x-module (listof cmem acyclic) i64)
  (x-with cx strings (listof i64 acyclic) cx i64)
  (x-reshape cx paths i64))

"A module's member (Fixpt's `mod-item`, each value one, C144): its name,
 its value, its kind, whether it is a lambda written with its type, which
 may name the members after it, and where its item is. Kind 2 the module
 gives; 1 is hidden, in the module's own product but not its type; 0 in
 neither, an abstract type's conversion, or a name an `include` gives."
(define-datatype cmem (cmem string cx i64 bool i64))
(define cmem-name (subr kfx (cmem) string) (lambda (i) (tagcase i (cmem (n x k l a) n))))
(define cmem-value (subr kfx (cmem) cx) (lambda (i) (tagcase i (cmem (n x k l a) x))))
(define cmem-kind (subr kfx (cmem) i64) (lambda (i) (tagcase i (cmem (n x k l a) k))))

"Where a module keeps each value a module type wants: a field of it, or a
 field of a module in a field of it, ..."
(define-type paths (listof (listof i64 acyclic) acyclic))

"A binding: a name and its expression (a `let`'s, a `letrec`'s, a
 product's field, a `tagcase`'s `else`)."
(define-datatype cbind (cbind string cx))

"A `tagcase` arm: its tag, whether it takes a product apart, the names it
 binds, its body."
(define-datatype carm (carm string bool strings cx))

(define-type cxs (listof cx acyclic))
(define-type cbinds (listof cbind acyclic))

"A top-level form: a definition, with whether it is written with a type;
 a `define-rec`; an expression; or a form that makes no code."
(define-datatype ctop
  (t-define string bool cx)
  (t-define-rec cbinds)
  (t-exp cx)
  (t-none))

(define cx-start (subr kfx (cx) i64)
  (lambda (x)
    (tagcase x
      (x-var (n a) a) (x-int (n a) a) (x-bool (v a) a) (x-str (s a) a) (x-char (c a) a) (x-float (b a) a)
      (x-sym (s a) a) (x-unit (a) a) (x-lambda (ps b a) a) (x-app (f xs a) a)
      (x-if (t y n a) a) (x-let (bs b a) a) (x-letrec (bs b a) a) (x-begin (xs a) a) (x-proj (x a) a)
      (x-product (fs a) a) (x-extract (p i a) a) (x-sum (t v a) a) (x-tagcase (s arms els k a) a)
      (x-prompt (t body h a) a) (x-bloblet (op i xs a) a) (x-region (k r body a) a) (x-rlambda (r l a) a)
      (x-module (its a) a) (x-with (m ns ks body a) a) (x-reshape (y ps a) a))))

"A lambda's parameters, body, and region (an `rlambda`'s, one or none), if
 `x` is one; else none."
(define-datatype lparts (lparts strings cx (listof cx acyclic)))
(define lambda-of (subr kfx (cx) (listof lparts acyclic))
  (lambda (x)
    (tagcase x
      (x-lambda (ps body a) (list (lparts ps body nil)))
      (x-rlambda (r l a) (tagcase l (x-lambda (ps body b) (list (lparts ps body (list r)))) (else y nil)))
      (else y nil))))

;;; --------------------------------------------------------- free names

(define-rec
  (c-adjoin (subr kfx (strings string) strings)
    (lambda (xs n) (if (string-member? n xs) xs (cons n xs)))))

(define-rec
  (c-bound-names (subr kfx (cbinds strings) strings)
    (lambda (bs bound) (if (null? bs) bound (c-bound-names (cdr bs) (tagcase (car bs) (cbind (n x) (cons n bound))))))))

(define c-bound-exps (subr kfx (cbinds) cxs)
  (lambda (bs) (map (lambda ((b cbind)) (tagcase b (cbind (n x) x))) bs)))

(define-rec
  (c-names (subr kfx (strings strings) strings)
    (lambda (ns bound) (if (null? ns) bound (c-names (cdr ns) (cons (car ns) bound))))))

"The names free in `x`, not `bound`, onto `acc`, the newest first, in
 Fixpt's order: what an expression's parts are walked in."
"A standard name, whatever a program binds it to (Fixpt's `(with #%fx
 name)`, C221): what a quote builds with."
(define std-var (subr kfx (string i64) cx) (lambda (n a) (x-var (string-append "#%fx:" n) a)))
(define std-marked? (subr kfx (string) bool) (lambda (n) (has-prefix? n "#%fx:")))
(define std-named (subr kfx (string) string) (lambda (n) (if (std-marked? n) (after-prefix n "#%fx:") n)))

(define-rec
  (c-free-all (subr kfx (cxs strings strings) strings)
    (lambda (es bound acc) (if (null? es) acc (c-free-all (cdr es) bound (c-free (car es) bound acc)))))
  (c-free (subr kfx (cx strings strings) strings)
    (lambda (x bound acc)
      (tagcase x
        (x-var (n a) (if (or (std-marked? n) (string-member? n bound)) acc (c-adjoin acc n)))
        (x-lambda (ps body a) (c-free body (c-names ps bound) acc))
        (x-app (f args a) (c-free f bound (c-free-all args bound acc)))
        (x-if (t th el a) (c-free t bound (c-free th bound (c-free el bound acc))))
        (x-letrec (bs body a)
          (let ((inner (c-bound-names bs bound)))
            (c-free body inner (c-free-all (c-bound-exps bs) inner acc))))
        (x-let (bs body a) (c-free body (c-bound-names bs bound) (c-free-all (c-bound-exps bs) bound acc)))
        (x-begin (es a) (c-free-all es bound acc))
        (x-proj (x a) (c-free x bound acc))
        (x-product (fs a) (c-free-all (c-bound-exps fs) bound acc))
        (x-extract (p i a) (c-free p bound acc))
        (x-sum (t v a) (c-free v bound acc))
        (x-tagcase (s arms els k a) (c-free s bound (c-free-arms arms bound (c-free-else els bound acc))))
        (x-prompt (t body h a) (c-free t bound (c-free body bound (c-free h bound acc))))
        (x-bloblet (op i xs a) (c-free-all xs bound acc))
        (x-region (k r body a) (c-free body (cons r bound) acc))
        (x-rlambda (r l a) (c-free r bound (c-free l bound acc)))
        ;; A module's items see all of them, as a `letrec*`'s.
        (x-module (its a)
          (let ((inner (c-names (map cmem-name its) bound)))
            (c-free-all (map cmem-value its) inner acc)))
        ;; The module, then the body, the module's values bound in it.
        (x-with (m ns ks body a) (c-free body (c-names ns bound) (c-free m bound acc)))
        (x-reshape (y ps a) (c-free y bound acc))
        (else y acc))))
  (c-free-arms (subr kfx ((listof carm acyclic) strings strings) strings)
    (lambda (arms bound acc)
      (if (null? arms) acc
          (tagcase (car arms) (carm (t p ns body) (c-free-arms (cdr arms) bound (c-free body (c-names ns bound) acc)))))))
  (c-free-else (subr kfx (cbinds strings strings) strings)
    (lambda (els bound acc)
      (if (null? els) acc (tagcase (car els) (cbind (n x) (c-free x (cons n bound) acc)))))))

(define c-mentions? (subr kfx (cx string) bool) (lambda (x n) (string-member? n (c-free x nil nil))))

(define c-free-names (subr kfx (cx) strings) (lambda (x) (c-free x nil nil)))

"The checker's facts, for the program being compiled."
(define cg-facts (ref facts @g) (new nil))

"Of those, the conversions (C230; `conversion-noted`), looked for at every
 expression: none, in most programs."
(define cg-convert-facts (ref facts @g) (new nil))

"Of those, what a module's place is told (C144): a module parameter's type,
 at each `with` of it (`with-spec`), and at each module given for one
 (`module-arg`), its values' names in order. Few, so asked of often."
(define cg-module-facts (ref facts @g) (new nil))

"Where each call of a procedure of the fx convention starts (the checker's
 `call-fx`): made a call that looks at its callee's kind, not a typed one,
 as Fixpt's `c-call-in` makes it."
(define cg-fx-calls (ref (listof i64 @g) @g) (new nil))
(define-rec
  (cg-fx-call? (subr gen (i64 (listof i64 @g)) bool)
    (lambda (a xs) (cond ((null? xs) #f) ((i64= a (car xs)) #t) (else (cg-fx-call? a (cdr xs)))))))

"Each module's values' names, in the order its product holds them, by the
 name it is bound to: the newest first, a module's items' own while its
 items are read."
(define-datatype clayout (clayout string strings))

"A module's `include` of the module named: whether it is hidden, and where."
(define-datatype cinc (cinc string bool i64))

"The modules made where they are included (kfx's reader names each,
 `made--P`, and defines it before the module, C90), by name: each is made
 in place again, as Fixpt makes it."
(define-datatype cmade (cmade string cx))
(define cg-made (ref (listof cmade acyclic) @g) (new nil))

(define-rec
  (made-module (subr kfx ((listof cmade acyclic) string) cxs)
    (lambda (ms n)
      (cond ((null? ms) nil)
            ((tagcase (car ms) (cmade (m x) (string=? m n))) (tagcase (car ms) (cmade (m x) (list x))))
            (else (made-module (cdr ms) n))))))

"Whether `n` is a module made in place (C90), not a file's (`made--load--`)
 nor an input's."
(define instance-load? (subr kfx (sexp) bool)
  (lambda (e)
    "Whether `e` is the module a load of a file of parameters made, `(module
     (%loaded path %instance ...) ...)` (C216): made again where it is
     included, an instance each time, as Fixpt makes one each time its
     maker is called (`modules/load-parameters.fx`)."
    (and (head-is? e "module") (i64>= (size (items e)) 2) (head-is? (second (items e)) "%loaded")
         (any? (lambda ((x sexp)) (sym-is? x "%instance")) (items (second (items e)))))))

(define made-here-name? (subr kfx (string) bool)
  (lambda (n) (and (has-prefix? n "made--") (not (has-prefix? n "made--load--")) (not (has-prefix? n "made--input--")))))
(define cg-layouts (ref (listof clayout acyclic) @g) (new nil))
"The modules an `include` makes of an expression, not one named (C221),
 by a hidden name of their place: the values the checker noted each gives
 (`with-spec`)."
(define cg-included (ref (listof clayout acyclic) @g) (new nil))

(define-rec
  (layout-in (subr kfx ((listof clayout acyclic) string) (listof strings acyclic))
    (lambda (ls n)
      (cond ((null? ls) nil)
            ((tagcase (car ls) (clayout (m ns) (string=? m n))) (tagcase (car ls) (clayout (m ns) (list ns))))
            (else (layout-in (cdr ls) n))))))

(define-rec
  (words-in (subr kfx (chars chars strings) strings)
    (lambda (cs word acc)
      "The words of `cs`, between spaces, onto `acc`, the last first."
      (cond ((null? cs) (if (null? word) acc (cons (list->string (reverse word)) acc)))
            ((char=? (car cs) #\space) (words-in (cdr cs) nil (if (null? word) acc (cons (list->string (reverse word)) acc))))
            (else (words-in (cdr cs) (cons (car cs) word) acc))))))

(define split-words (subr kfx (string) strings) (lambda (s) (reverse (words-in (string-chars s) nil nil))))

(define-rec
  (indices-from (subr kfx (i64 i64) (listof i64 acyclic))
    (lambda (i n) (if (i64>= i n) nil (cons i (indices-from (i64+ i 1) n))))))

(define-rec
  (fact-text (subr kfx (facts string i64 string) string)
    (lambda (fs file pos prefix)
      "The newest fact at `file` and `pos` beginning `prefix`, past it; or
       the empty string."
      (cond ((null? fs) "")
            ((tagcase (car fs)
               (fact (f p what)
                 (and (string=? f file) (i64= p pos) (i64>= (string-length-i64 what) (string-length-i64 prefix))
                      (string=? (substring what 0 (string-length prefix)) prefix))))
             (tagcase (car fs) (fact (f p what) (substring what (string-length prefix) (string-length what)))))
            (else (fact-text (cdr fs) file pos prefix))))))

(define-rec
  (fact-noted? (subr kfx (facts string i64 string) bool)
    (lambda (fs file pos what)
      "Whether the fact `what` is noted at `file` and `pos`."
      (cond ((null? fs) #f)
            ((tagcase (car fs) (fact (f p w) (and (string=? f file) (i64= p pos) (string=? w what)))) #t)
            (else (fact-noted? (cdr fs) file pos what))))))

(define cg-fail (subr kfx (string) void)
  (lambda (why) (error (string-append "kayak-fx26: cells: " why))))

(define-rec
  (digits-i64 (subr kfx (chars i64) i64)
    (lambda (cs n) (if (null? cs) n (digits-i64 (cdr cs) (i64+ (i64* n 10) (i64- (char->i64 (car cs)) 48)))))))

;;; ------------------------------------------------- Fixpt's parser's trees

(define cg-fixnum? (subr kfx (int) bool)
  (lambda (n) (and (<= n 1152921504606846975) (>= n -1152921504606846976))))

(define call2 (subr kfx (string cx cx i64) cx) (lambda (f x y a) (x-app (x-var f a) (list x y) a)))

"An integer literal past a fixnum, as arithmetic on fixnums: `(- 0 x)` for
 a negative; else, in base 10⁹, `(+ (* rest 1000000000) last)`, `rest`
 again so until it is a fixnum (Fixpt's `big-literal`)."
(define-rec
  (big-peel (subr kfx (int (listof int acyclic) i64) cx)
    (lambda (n limbs a)
      (if (cg-fixnum? n)
          (big-build (x-int n a) limbs a)
          (big-peel (quotient n 1000000000) (cons (remainder n 1000000000) limbs) a))))
  (big-build (subr kfx (cx (listof int acyclic) i64) cx)
    (lambda (acc limbs a)
      (if (null? limbs)
          acc
          (big-build (call2 "+" (call2 "*" acc (x-int 1000000000 a) a) (x-int (car limbs) a) a) (cdr limbs) a)))))

(define big-literal (subr kfx (int i64) cx)
  (lambda (v a)
    (cond ((cg-fixnum? v) (x-int v a))
          ((< v 0) (call2 "-" (x-int 0 a) (big-peel (- 0 v) nil a) a))
          (else (big-peel v nil a)))))

"A datatype's constructors, as Fixpt's parser expands `define-datatype`:
 each `(define tag type (lambda (x1 …) (sum tag (product (1 x1) …))))`, the
 lambda where the form starts, its body where the variant does."
(define-rec
  (dt-vars (subr kfx (i64 i64) strings)
    (lambda (i n) (if (i64> i n) nil (cons (string-append "%x" (i64->string i)) (dt-vars (i64+ i 1) n))))))

(define-rec
  (dt-fields (subr kfx (strings i64 i64) cbinds)
    (lambda (xs i a) (if (null? xs) nil (cons (cbind (i64->string i) (x-var (car xs) a)) (dt-fields (cdr xs) (i64+ i 1) a))))))

(define-rec
  (dt-constructors (subr kfx (sexps i64) (listof ctop acyclic))
    (lambda (vs a)
      (if (null? vs) nil
          (let* ((parts (items (car vs))) (tag (sym-name (car parts))) (at (datum-pos (car vs)))
                 (xs (dt-vars 1 (size (cdr parts)))))
            (cons (t-define tag #t (x-lambda xs (x-sum tag (x-product (dt-fields xs 1 at) at) at) a))
                  (dt-constructors (cdr vs) a)))))))

"A `case` datum's kind (Fixpt's `case-kind`): 0 an integer, 1 a
 character, 2 a string, 3 a symbol, 4 a boolean, -1 none of these."
(define case-kind (subr kfx (sexp) i64)
  (lambda (d)
    (tagcase d
      (num (k f p) 0) (big (t f p) 0) (chr (c f p) 1) (str (t f p) 2)
      (sym (n f p) (cond ((or (string=? n "#t") (string=? n "#f")) 4) ((string=? n "#u") -1) (else 3)))
      (else other -1))))

(define-rec
  (case-data-count (subr kfx (sexps) i64)
    (lambda (clauses) (if (null? (cdr clauses)) 0 (i64+ (size (items (car (items (car clauses))))) (case-data-count (cdr clauses)))))))

"How many data of kind `k` make a `case` a search tree (Fixpt's
 `case-tree-from`)."
(define case-tree-from (subr kfx (i64 bool) i64)
  (lambda (k direct)
    (cond ((i64= k 0) (if direct 8 32)) ((i64= k 2) 16) ((i64= k 3) (if direct 32 64)) (else 1000000000))))

"A `case`'s data by halving (C221; Fixpt's `case-tree`, TODO §46): each
 datum's test, the value it sorts by (the integer, or the runtime's hash
 of the string or symbol), and its clause."
(define-datatype ckey (ckey cx i64 i64))
(define ckey-at (subr kfx (ckey) i64) (lambda (e) (tagcase e (ckey (t v c) v))))

(define case-sort-key (subr kfx (i64 sexp) i64)
  (lambda (k d)
    (tagcase d
      (num (n f p) (if (i64= k 0) n 0))
      (str (t f p) (if (i64= k 2) (int->i64 (string-hash t)) 0))
      (sym (n f p) (if (i64= k 3) (int->i64 (symbol-name-hash (string->symbol n))) 0))
      (else other 0))))

"Whether every datum has a sort value: integers only if fixnums."
(define-rec
  (case-all-keyed? (subr kfx (i64 sexps) bool)
    (lambda (k clauses)
      (or (not (i64= k 0)) (null? (cdr clauses))
          (and (not (any? (lambda ((d sexp)) (tagcase d (num (n f p) (or (i64< n -1152921504606846976) (i64> n 1152921504606846975))) (else other #t)))
                          (items (car (items (car clauses))))))
               (case-all-keyed? k (cdr clauses)))))))

"`e` into `sorted`, after those of no greater value: a stable sort."
(define-rec
  (case-insert (subr kfx (ckey (listof ckey acyclic)) (listof ckey acyclic))
    (lambda (e sorted)
      (if (or (null? sorted) (i64< (ckey-at e) (ckey-at (car sorted))))
          (cons e sorted)
          (cons (car sorted) (case-insert e (cdr sorted))))))
  (case-sort (subr kfx ((listof ckey acyclic) (listof ckey acyclic)) (listof ckey acyclic))
    (lambda (es sorted) (if (null? es) sorted (case-sort (cdr es) (case-insert (car es) sorted))))))

(define-rec
  (case-key-nth (subr kfx ((listof ckey acyclic) i64) i64)
    (lambda (es i) (if (i64= i 0) (ckey-at (car es)) (case-key-nth (cdr es) (i64- i 1)))))
  (case-take (subr kfx ((listof ckey acyclic) i64) (listof ckey acyclic))
    (lambda (es k) (if (i64= k 0) nil (cons (car es) (case-take (cdr es) (i64- k 1))))))
  (case-drop (subr kfx ((listof ckey acyclic) i64) (listof ckey acyclic))
    (lambda (es k) (if (i64= k 0) es (case-drop (cdr es) (i64- k 1)))))
  (case-mid-up (subr kfx ((listof ckey acyclic) i64 i64) i64)
    (lambda (es mid n)
      (if (and (i64< mid n) (i64> mid 0) (i64= (case-key-nth es mid) (case-key-nth es (i64- mid 1))))
          (case-mid-up es (i64+ mid 1) n)
          mid)))
  (case-mid-down (subr kfx ((listof ckey acyclic) i64) i64)
    (lambda (es mid)
      (if (and (i64> mid 0) (i64= (case-key-nth es mid) (case-key-nth es (i64- mid 1))))
          (case-mid-down es (i64- mid 1))
          mid))))

"Where to halve `n` sorted entries: nearest the middle, between unequal
 values (0 if none)."
(define case-mid (subr kfx ((listof ckey acyclic) i64) i64)
  (lambda (es n)
    (let ((up (case-mid-up es (i64-quotient n 2) n)))
      (if (i64= up n) (case-mid-down es (i64-quotient n 2)) up))))

(define-rec
  (case-body-at (subr kfx (cxs i64) cx)
    (lambda (es i) (if (i64= i 0) (car es) (case-body-at (cdr es) (i64- i 1)))))
  (case-leaf (subr kfx ((listof ckey acyclic) i64 cxs bool cx i64) cx)
    (lambda (es m bodies whole els a)
      "The entries' tests in turn, each giving its clause (or, `whole`, its
       body); `m` (or `els`) for none."
      (cond ((and (null? es) (not whole)) (x-int (i64->int m) a))
            ((null? es) els)
            (else
             (tagcase (car es)
               (ckey (t v c)
                 (x-if t (if whole (case-body-at bodies c) (x-int (i64->int c) a)) (case-leaf (cdr es) m bodies whole els a) a)))))))
  (case-index (subr kfx (cx (listof ckey acyclic) i64 i64 cxs bool cx i64) cx)
    (lambda (by es n m bodies whole els a)
      "The clause of sorted entries, `by` halved against their values."
      (if (i64<= n 3)
          (case-leaf es m bodies whole els a)
          (let ((mid (case-mid es n)))
            (if (i64= mid 0)
                (case-leaf es m bodies whole els a)
                (x-if (x-app (std-var "<" a) (list by (x-int (i64->int (case-key-nth es mid)) a)) a)
                      (case-index by (case-take es mid) mid m bodies whole els a)
                      (case-index by (case-drop es mid) (i64- n mid) m bodies whole els a)
                      a))))))
  (case-pick (subr kfx (cx cxs i64 i64 i64) cx)
    (lambda (i bodies lo hi a)
      "The body of index `lo`..`hi` that `i` names, by halving."
      (if (i64= lo hi)
          (case-body-at bodies lo)
          (let ((mid (i64-quotient (i64+ (i64+ lo hi) 1) 2)))
            (x-if (x-app (std-var "<" a) (list i (x-int (i64->int mid) a)) a)
                  (case-pick i bodies lo (i64- mid 1) a)
                  (case-pick i bodies mid hi a)
                  a))))))

"Whether a `case`'s or `typecase`'s key is a variable, tested as it is."
(define case-direct? (subr kfx (sexps) bool)
  (lambda (xs)
    (and (not (null? (cdr (cdr xs))))
         (tagcase (car xs) (sym (n f p) (not (or (string=? n "#t") (string=? n "#f") (string=? n "#u")))) (else other #f)))))

"The standard predicate of each shape `typecase` tests (Fixpt's
 `typecase-predicate`)."
(define typecase-predicate (subr kfx (string) string)
  (lambda (s)
    (cond ((string=? s "int") "int?") ((string=? s "char") "char?") ((string=? s "bool") "bool?") ((string=? s "nil") "null?")
          ((string=? s "pair") "pair?") ((string=? s "string") "string?") ((string=? s "symbol") "symbol?")
          ((string=? s "procedure") "procedure?") ((string=? s "bloblet") "array?") ((string=? s "f64") "f64?")
          ((string=? s "f32") "f32?") ((string=? s "box") "ref?") ((string=? s "sum") "sum?") ((string=? s "product") "product?")
          ((string=? s "vector") "vector?") (else "bytevector?"))))

(define bloblet-form? (subr kfx (string) bool)
  (lambda (h)
    (string-member? h (list "make-bloblet" "rmake-bloblet" "bloblet-ref" "bloblet-set!" "bloblet-freeze" "bloblet-byte"
                            "bloblet-set-byte!" "bloblet-bytes" "blobref-at" "blobref+" "blobref-owner" "blobref-offset"
                            "blobref-get" "blobref-set!" "blobref-index" "blobref-variant!" "blobref-length"))))

"The scalar flat's layout code (`fixpt_heap::layout::FLAT_*`), or -1."
(define flat-code (subr kfx (string) i64)
  (lambda (s)
    (cond ((string=? s "i32") 0) ((string=? s "u32") 1) ((string=? s "i64") 2) ((string=? s "u64") 3)
          ((string=? s "f32") 4) ((string=? s "f64") 5) (else -1))))

(define words-i64 (subr kfx (string) (listof i64 acyclic))
  (lambda (w) (map (lambda ((x string)) (digits-i64 (string-chars x) 0)) (split-words w))))

(define second-i64 (subr kfx ((listof i64 acyclic)) i64) (lambda (xs) (if (null? (cdr xs)) 0 (car (cdr xs)))))

"What blobref operation `op` at `a` takes for what the checker found of
 it, as Fixpt's `k-datum-operand` gives it: a new blobref's size, a
 scalar's code, an array's length and element size (`n << 32 | size`), a
 keyed flat sum's code (its key's width, 8, its variants' offset times
 256); -1 for none."
(define blob-operand (subr gen (string string i64) i64)
  (lambda (op f a)
    (let ((at (lambda ((prefix string)) (fact-text (get cg-facts) f a prefix))))
      (cond ((or (string=? op "blobref-at") (string=? op "blobref+"))
             (let ((n (at "blob-size "))) (if (string=? n "") -1 (digits-i64 (string-chars n) 0))))
            ((or (string=? op "blobref-get") (string=? op "blobref-set!")) (flat-code (at "blob-scalar ")))
            ((or (string=? op "blobref-index") (string=? op "blobref-length"))
             (let ((ns (words-i64 (at "blob-element ")))) (if (null? ns) -1 (i64+ (i64* (second-i64 ns) 4294967296) (car ns)))))
            ((string=? op "blobref-variant!")
             (let ((ws (split-words (at "blob-variant "))))
               (if (null? ws) -1
                   ;; Fixpt's code: the key's width, 8 if the labels are numbers
                   ;; (a key; none, `fields`, C175), the variants' offset times 256.
                   (i64+ (i64+ (digits-i64 (string-chars (car ws)) 0) (if (i64> (size ws) 3) 0 8))
                         (i64* 256 (digits-i64 (string-chars (car (cdr (cdr ws)))) 0))))))
            (else -1)))))

"A generative type's conversions, `up-t` and `down-t`, each `(lambda (x)
 x)` where the form is, as Fixpt's parser's `identity-at` makes them."
(define generative-name (subr kfx (sexp) string)
  (lambda (e)
    "A generative type's name: its own, or a family's head, `(t (a type +))`
     (C217)."
    (tagcase e (lst (ys f l p) (sym-name (car ys))) (else other (sym-name e)))))

(define confirmed (subr kfx (sexp string string string bool) sexp)
  (lambda (e base test cert with-k)
    "`(confirm-nat x (n body) else)`, `(acyclic x (n body) else)`,
     `(confirm-length x k (n body) else)` as Fixpt's parser makes them (C217):
     the value bound once, to a variable named for what the form does not
     mention; tested; the name bound to it certified."
    (let* ((xs (cdr (items e)))
           (t (fresh-for base e))
           (k (if with-k (the sexps (list (second xs))) nil))
           (arm (items (if with-k (third xs) (second xs))))
           (els (if with-k (fourth xs) (third xs))))
      (sx (list (sy "let") (sx (list (sx (list (sy t) (car xs)))))
                (sx (list (sy "if") (sx (cons (sy test) (cons (sy t) k)))
                          (sx (list (sy "let") (sx (list (sx (list (car arm) (sx (cons (sy cert) (cons (sy t) k)))))))
                                    (second arm)))
                          els)))))))

(define generative-conversions (subr kfx (string i64) (listof ctop acyclic))
  (lambda (t a)
    (list (t-define (string-append "up-" t) #t (x-lambda (list "x") (x-var "x" a) a))
          (t-define (string-append "down-" t) #t (x-lambda (list "x") (x-var "x" a) a)))))

"The type of the module read last: its values' names, in order."
(define cg-module-type (ref strings @g) (new nil))

"Whether `x` is a module made where it is written."
(define module-made? (subr kfx (cx) bool)
  (lambda (x) (tagcase x (x-module (its a) #t) (x-reshape (y ps a) (tagcase y (x-module (its b) #t) (else z #f))) (else y #f))))

"`n`, if `x` is a module made here, or one named (a load's), its values'
 names noted, for a `with` of it."
(define note-layout! (subr gen (string cx) unit)
  (lambda (n x)
    (cond ((module-made? x) (set cg-layouts (cons (clayout n (get cg-module-type)) (get cg-layouts))))
          ((tagcase x (x-var (m a) (not (null? (layout-in (get cg-layouts) m)))) (else y #f))
           (tagcase x (x-var (m a) (set cg-layouts (cons (clayout n (car (layout-in (get cg-layouts) m))) (get cg-layouts)))) (else y #u)))
          (else #u))))

"`x` in an `include`'s `(with %include …)` where item `a` is (Fixpt's
 `in-includes`), which binds nothing here, its names bound once already:
 a lambda's body, so that its word is named for the item's place."
(define in-includes (subr kfx (cx i64) cx)
  (lambda (x a)
    (tagcase x
      (x-lambda (ps body b) (x-lambda ps (x-with (x-unit a) nil nil body a) b))
      (else y (x-with (x-unit a) nil nil x a)))))

"Member `i` so, if it is a value of an item."
(define member-in-includes (subr kfx (cmem) cmem)
  (lambda (i) (tagcase i (cmem (n x k l a) (if (i64= k 0) i (cmem n (in-includes x a) k l a))))))

"The names `xs` (the included values, in order) members `its` use, each
 once, in order: for each member, those it uses in `xs`'s order (Fixpt's
 `c-included-names`)."
(define-rec
  (included-used (subr kfx ((listof cmem acyclic) strings strings) strings)
    (lambda (its xs acc)
      (if (null? its)
          (reverse acc)
          (let ((fv (c-free-names (cmem-value (car its)))))
            (included-used (cdr its) xs
                           (onto (reverse (filter (lambda ((n string)) (and (string-member? n fv) (not (string-member? n acc)))) xs))
                                 acc)))))))

(define-rec
  (put-sep-words (subr kfx (strings) string)
    (lambda (ss) (cond ((null? ss) "") ((null? (cdr ss)) (car ss)) (else (string-append (car ss) (string-append " " (put-sep-words (cdr ss)))))))))


"An arm's label: a name, or a flat sum's number, as its digits (C221)."
(define arm-label (subr kfx (sexp) string)
  (lambda (x) (tagcase x (num (k f p) (i64->string k)) (else other (sym-name x)))))

"Quasiquotes' shapes (C221, Fixpt's parser.fx): `(form e)`'s `e`, as a
 list of none or one; whether a list is dotted, its items before the dot
 and its tail; the depth a list's items after its head are at."
(define q-unquote-of (subr kfx (sexp string) sexps)
  (lambda (x form)
    (tagcase x
      (lst (ys f l p) (if (and (i64= (size ys) 2) (sym-is? (car ys) form)) (cdr ys) nil))
      (else other nil))))
(define q-unquoted (subr kfx (sexp i64) sexps)
  (lambda (x depth) (if (i64= depth 1) (q-unquote-of x "unquote") nil)))
(define q-compound? (subr kfx (sexp) bool)
  (lambda (x) (tagcase x (lst (ys f l p) (not (null? ys))) (else other #f))))
(define-rec
  (q-dotted? (subr kfx (sexps) bool)
    (lambda (ys)
      (cond ((or (null? ys) (null? (cdr ys))) #f)
            ((null? (cdr (cdr ys))) (sym-is? (car ys) "."))
            (else (q-dotted? (cdr ys))))))
  (q-before-dot (subr kfx (sexps) sexps)
    (lambda (ys) (if (sym-is? (car ys) ".") nil (cons (car ys) (q-before-dot (cdr ys))))))
  (q-dot-tail (subr kfx (sexps) sexp)
    (lambda (ys) (if (sym-is? (car ys) ".") (second ys) (q-dot-tail (cdr ys))))))
(define q-inner (subr kfx (sexps i64) i64)
  (lambda (items depth)
    (let ((two (i64= (size items) 2)) (h (if (null? items) (sy "") (car items))))
      (cond ((i64< depth 0) depth)
            ((and two (sym-is? h "quasiquote")) (i64+ depth 1))
            ((and two (i64> depth 1) (or (sym-is? h "unquote") (sym-is? h "unquote-splicing"))) (i64- depth 1))
            (else depth)))))
(define-rec
  (q-free? (subr kfx (sexp i64) bool)
    (lambda (x depth)
      "Whether no `unquote` or `unquote-splicing` at depth 1 is in `x`."
      (and (null? (q-unquoted x depth))
           (tagcase x
             (lst (ys f l p)
               (cond ((head-is? x "#vector") (q-items-free? (cdr ys) depth depth))
                     ((q-dotted? ys) (and (q-items-free? (q-before-dot ys) depth (q-inner (q-before-dot ys) depth))
                                          (q-free? (q-dot-tail ys) depth)))
                     (else (q-items-free? ys depth (q-inner ys depth)))))
             (else other #t)))))
  (q-items-free? (subr kfx (sexps i64 i64) bool)
    (lambda (items depth inner)
      (or (null? items)
          (and (null? (if (i64= depth 1) (q-unquote-of (car items) "unquote-splicing") nil))
               (q-free? (car items) depth)
               (q-items-free? (cdr items) inner inner))))))

(define-rec
  (parse-x (subr gen (sexp) cx)
    (lambda (e)
      "`e`, converted where the checker found it converted (C230)."
      (let ((x (parse-x-as-is e)))
        (if (null? (get cg-convert-facts))
            x
            (converted-x (fact-text (get cg-convert-facts) (datum-file e) (datum-pos e) "convert ") x (datum-pos e))))))

  (converted-x (subr gen (string cx i64) cx)
    (lambda (k x a)
      "`x` given to `%fx26-convert` with `k`, what Fixpt's compiler gives it
       (`exp_unnoted`): an adapter, if `x` is of the other convention. As
       it is, if `k` is empty."
      (if (string=? k "")
          x
          (x-app (x-var "%fx26-convert" a) (list x (x-int (i64->int (digits-i64 (string-chars k) 0)) a)) a))))

  (parse-x-as-is (subr gen (sexp) cx)
    (lambda (e)
      (tagcase e
        (num (k f p) (big-literal (i64->int k) p))
        (big (text f p) (big-literal (big-int text) p))
        (chr (c f p) (x-char c p))
        (str (s f p) (x-str s p))
        (real (x f p) (x-float (u64->int (f64->bits (real-value x))) p))
        (sym (n f p)
          (cond ((string=? n "#t") (x-bool #t p))
                ((string=? n "#f") (x-bool #f p))
                ((string=? n "#u") (x-unit p))
                ;; A module made in place (C90), made where it is named.
                ((not (null? (made-module (get cg-made) n))) (car (made-module (get cg-made) n)))
                (else (x-var n p))))
        (lst (xs f l p)
          (if (null? xs)
              (begin (cg-fail "not an expression: ()") (x-unit p))
              (parse-form (tagcase (car xs) (sym (n f2 p2) n) (else other "")) xs e f p))))))

  (parse-xs (subr gen (sexps) cxs)
    (lambda (es) (if (null? es) nil (cons (parse-x (car es)) (parse-xs (cdr es))))))

  (parse-body (subr gen (sexps i64) cx)
    (lambda (forms a)
      "One or more expressions, an implicit `begin` where the form starts."
      (if (null? (cdr forms)) (parse-x (car forms)) (x-begin (parse-xs forms) a))))

  (parse-form (subr gen (string sexps sexp string i64) cx)
    (lambda (h xs e f a)
      (cond ((string=? h "lambda") (x-lambda (map binder-name (items (second xs))) (parse-body (cdr (cdr xs)) a) a))
            ((string=? h "if") (x-if (parse-x (second xs)) (parse-x (car (cdr (cdr xs)))) (parse-x (car (cdr (cdr (cdr xs))))) a))
            ((string=? h "let") (x-let (parse-binds (items (second xs))) (parse-body (cdr (cdr xs)) a) a))
            ((string=? h "let*") (parse-let* (items (second xs)) (parse-body (cdr (cdr xs)) a)))
            ((string=? h "letrec") (x-letrec (parse-typed-binds (items (second xs))) (parse-body (cdr (cdr xs)) a) a))
            ((string=? h "begin") (parse-body (cdr xs) a))
            ((string=? h "cond") (parse-cond (cdr xs) a))
            ((string=? h "and") (parse-and (cdr xs) a))
            ((string=? h "or") (parse-or (cdr xs) a))
            ((string=? h "convention")
             "A conversion written (C230): as Fixpt's, `%fx26-convert` where the
              procedure is of another convention, an adapter."
             (converted-x (fact-text (get cg-convert-facts) f a "convention ") (parse-x (car (cdr (cdr xs)))) a))
            ((string=? h "the") (parse-x (car (cdr (cdr xs)))))
            ((string=? h "plambda") (parse-body (cdr (cdr xs)) a))
            ((member-of? h process-heads)
             "A form of processes, a call of the scheduler's (C219), as Fixpt's
              parser makes it."
             (parse-x (process-expanded e)))
            ((and (string=? h "acyclic") (i64= (size xs) 4)) (parse-x (confirmed e "%acyclic-value" "acyclic?" "certify-acyclic" #f)))
            ((and (string=? h "confirm-nat") (i64= (size xs) 4)) (parse-x (confirmed e "%nat-value" "nat?" "certify-nat" #f)))
            ((and (string=? h "confirm-length") (i64= (size xs) 5)) (parse-x (confirmed e "%confirm-value" "length-is?" "certify-length" #t)))
            ;; Its own node, as Fixpt's `e-proj`: a standard name under it is
            ;; not called as the standard operation, but as its value.
            ((string=? h "proj") (x-proj (parse-x (second xs)) a))
            ((string=? h "quote") (parse-quoted (second xs) a))
            ((string=? h "product") (x-product (parse-fields (cdr xs)) a))
            ((string=? h "extract")
             (let ((k (fact-text (get cg-facts) f a "extract-index ")) (o (fact-text (get cg-facts) f a "blob-offset ")))
               (cond ((not (string=? k "")) (x-extract (parse-x (second xs)) (digits-i64 (string-chars k) 0) a))
                     ;; A blobref's field: a blobref at its offset.
                     ((not (string=? o "")) (x-bloblet "%blobref-field" (digits-i64 (string-chars o) 0) (list (parse-x (second xs))) a))
                     ;; `par`'s pair (C219): of fields 1 and 2, in order.
                     ((tagcase (third xs) (num (k f2 p2) (and (i64>= k 1) (i64<= k 2))) (else other #f))
                      (x-extract (parse-x (second xs)) (i64- (tagcase (third xs) (num (k f2 p2) k) (else other 1)) 1) a))
                     (else (begin (cg-fail "an extract the checker did not see") (x-unit a))))))
            ((bloblet-form? h) (parse-bloblet h (cdr xs) f a))
            ((string=? h "sum") (x-sum (label-of (second xs)) (parse-x (car (cdr (cdr xs)))) a))
            ((string=? h "tagcase")
             "Of a blobref to a flat sum (C33, C175), its layout's code from
              the checker's fact: the key's width, whether it is numeric (it
              is, but where the tag names an owner's field), the variant's
              offset (C221)."
             (let ((flat (spaced-words (fact-text (get cg-facts) f a "blob-tagcase "))))
               (x-tagcase (parse-x (second xs)) (parse-arms (cdr (cdr xs))) (parse-else (cdr (cdr xs)))
                          (if (null? flat)
                              -1
                              (i64+ (digits-i64 (string-chars (car flat)) 0)
                                    (i64+ (if (i64= (size flat) 3) (the i64 0) (the i64 8))
                                          (i64* 256 (digits-i64 (string-chars (car (cdr flat))) 0)))))
                          a)))
            ((or (string=? h "module") (string=? h "%module-value")) (module-narrowed (parse-module (cdr xs) a) f a))
            ((string=? h "extend") (module-narrowed (parse-extend (second xs) (third xs) a) f a))
            ;; `(with #%fx n)`: the standard `n`, whatever is bound to it (C221).
            ((and (string=? h "with") (i64= (size xs) 3) (sym-is? (second xs) "#%fx") (tagcase (third xs) (sym (n f2 p2) #t) (else other #f)))
             (std-var (sym-name (third xs)) a))
            ((string=? h "with") (parse-with (second xs) (parse-body (cdr (cdr xs)) a) f a))
            ((or (string=? h "letregion") (string=? h "letrena") (string=? h "letreap") (string=? h "letfreeze"))
             ;; What it makes besides the region: nothing, an arena, a reap,
             ;; or nothing, its data frozen as it ends (Fixpt's `region-kind`).
             (x-region (cond ((string=? h "letregion") 0) ((string=? h "letrena") 1) ((string=? h "letreap") 2) (else 3))
                       (tagcase (second xs) (lst (ns f2 l2 p2) (sym-name (car ns))) (else other (sym-name (second xs))))
                       (parse-body (cdr (cdr xs)) a) a))
            ;; `(rlambda r (param …) body …)`: the region, and the lambda.
            ((string=? h "rlambda")
             (x-rlambda (parse-x (second xs)) (x-lambda (map binder-name (items (third xs))) (parse-body (cdr (cdr (cdr xs))) a) a) a))
            ;; `(prompt tag body handler)`.
            ((string=? h "prompt") (x-prompt (parse-x (second xs)) (parse-x (third xs)) (parse-x (fourth xs)) a))
            ((string=? h "case") (parse-case (cdr xs) a))
            ((string=? h "typecase") (parse-typecase (cdr xs) a))
            ;; `(vlambda p body …)`: `%vlambda` of a lambda of one (C221, as
            ;; Fixpt's parser makes it).
            ((string=? h "vlambda")
             (x-app (x-var "%vlambda" a) (list (x-lambda (list (binder-name (second xs))) (parse-body (cdr (cdr xs)) a) a)) a))
            ((string=? h "quasiquote") (quasi-in (second xs) 1))
            ((string=? h "load-module")
             (begin (cg-fail (string-append "not yet: " h)) (x-unit a)))
            (else
             (begin
               (if (fact-noted? (get cg-facts) f a "call-fx") (set cg-fx-calls (cons a (get cg-fx-calls))) #u)
               (x-app (parse-x (car xs)) (parse-args (cdr xs)) a))))))

  (parse-bloblet (subr gen (string sexps string i64) cx)
    (lambda (op args f a)
      "A bloblet's or a blobref's operation (Fixpt's `e-bloblet`), and what
       the checker found it takes (C152): a field's index, written; a new
       blobref's size; a scalar's layout, an array's, a flat sum's."
      (cond ((or (string=? op "bloblet-ref") (string=? op "bloblet-set!"))
             (x-bloblet op (tagcase (second args) (num (k f2 p2) k) (else other (the i64 -1)))
                        (cons (parse-x (car args)) (if (string=? op "bloblet-set!") (list (parse-x (third args))) nil)) a))
            (else (x-bloblet op (blob-operand op f a) (parse-xs args) a)))))

  ;; `(case key ((datum …) e …) … (else e …))` on atoms, as Fixpt's parser
  ;; expands it (C153): a variable as it is, else bound by a `let` to
  ;; `%case-key`, and nested `if`s, each datum compared by its kind's
  ;; equality. Many data (Fixpt's `case-tree-from`) make a search tree of
  ;; their sort values there: not yet.
  (parse-case (subr gen (sexps i64) cx)
    (lambda (xs a)
      (let* ((clauses (cdr xs))
             (k (if (null? (cdr clauses)) (the i64 -1) (case-kind (car (items (car (items (car clauses))))))))
             (n (case-data-count clauses))
             (els (items (last clauses)))
             (direct (and (i64= (size els) 2) (not (tagcase (second els) (lst (ys f l p) #t) (else other #f)))
                          (i64= n (i64- (size clauses) 1)))))
        (cond ((and (i64>= n (case-tree-from k direct)) (case-all-keyed? k clauses))
               (if (case-direct? xs)
                   (case-tree (parse-x (car xs)) xs k a)
                   (x-let (list (cbind "%case-key" (parse-x (car xs))))
                          (case-tree (x-var "%case-key" (datum-pos (car xs))) xs k a) a)))
              ((case-direct? xs) (parse-case-arms (parse-x (car xs)) clauses))
              (else (x-let (list (cbind "%case-key" (parse-x (car xs))))
                           (parse-case-arms (x-var "%case-key" (datum-pos (car xs))) clauses) a))))))

  ;; Many data (C221, Fixpt's `case-tree`): the clause's index by halving
  ;; the sorted data, then its body by halving the indices; with a clause
  ;; per datum and an `else` of one atom, the bodies at the leaves.
  (case-tree (subr gen (cx sexps i64 i64) cx)
    (lambda (kv xs k a)
      (let* ((sorted (case-sort (case-entries kv k (cdr xs) 0) nil))
             (bodies (case-bodies (cdr xs)))
             (m (i64- (size bodies) 1))
             (by (if (i64= k 0) kv (x-var "%case-hash" a)))
             (n (size sorted))
             (lastc (items (last (cdr xs))))
             (atom-else (and (i64= (size lastc) 2) (not (tagcase (second lastc) (lst (ys f l p) #t) (else other #f)))))
             (tree (if (and atom-else (i64= n m))
                       (case-index by sorted n m bodies #t (case-body-at bodies m) a)
                       (x-let (list (cbind "%case-index" (case-index by sorted n m bodies #f (x-unit a) a)))
                              (case-pick (x-var "%case-index" a) bodies 0 m a) a))))
        (if (i64= k 0)
            tree
            (x-let (list (cbind "%case-hash" (x-app (std-var (if (i64= k 2) "string-hash" "symbol-name-hash") a) (list kv) a))) tree a)))))

  (case-entries (subr gen (cx i64 sexps i64) (listof ckey acyclic))
    (lambda (kv k clauses c)
      (if (null? (cdr clauses))
          nil
          (case-entries-of kv k (items (car (items (car clauses)))) c (case-entries kv k (cdr clauses) (i64+ c 1))))))

  (case-entries-of (subr gen (cx i64 sexps i64 (listof ckey acyclic)) (listof ckey acyclic))
    (lambda (kv k data c rest)
      (if (null? data)
          rest
          (cons (ckey (parse-case-test kv (car data)) (case-sort-key k (car data)) c) (case-entries-of kv k (cdr data) c rest)))))

  (case-bodies (subr gen (sexps) cxs)
    (lambda (clauses)
      (if (null? clauses)
          nil
          (cons (parse-body (cdr (items (car clauses))) (datum-pos (car clauses))) (case-bodies (cdr clauses))))))

  (parse-case-arms (subr gen (cx sexps) cx)
    (lambda (kv clauses)
      (let* ((c (car clauses)) (parts (items c)) (ca (datum-pos c)))
        (if (null? (cdr clauses))
            (parse-body (cdr parts) ca)
            (x-if (parse-case-tests kv (items (car parts)) ca) (parse-body (cdr parts) ca) (parse-case-arms kv (cdr clauses)) ca)))))

  (parse-case-tests (subr gen (cx sexps i64) cx)
    (lambda (kv data ca)
      (let ((t (parse-case-test kv (car data))))
        (if (null? (cdr data)) t (x-if t (x-bool #t ca) (parse-case-tests kv (cdr data) ca) ca)))))

  (parse-case-test (subr gen (cx sexp) cx)
    (lambda (kv d)
      (let* ((at (datum-pos d)) (k (case-kind d))
             (eq (cond ((i64= k 0) "=") ((i64= k 1) "char=?") ((i64= k 2) "string=?") ((i64= k 3) "symbol=?") (else "bool=?")))
             (lit (if (i64= k 3) (x-sym (sym-name d) at) (parse-x d))))
        (x-app (std-var eq at) (list kv lit) at))))

  ;; `(typecase e (shape name body) … (else [name] body))`, as Fixpt's
  ;; parser expands it: a variable as it is, else bound to
  ;; `%typecase-value`; each arm its shape's predicate, then its name bound.
  (parse-typecase (subr gen (sexps i64) cx)
    (lambda (xs a)
      (if (case-direct? xs)
          (parse-typecase-arms (cdr xs) (sym-name (car xs)) a)
          (x-let (list (cbind "%typecase-value" (parse-x (car xs)))) (parse-typecase-arms (cdr xs) "%typecase-value" a) a))))

  (parse-typecase-arms (subr gen (sexps string i64) cx)
    (lambda (arms tmp a)
      (let ((parts (items (car arms))))
        (if (null? (cdr arms))
            (if (i64= (size parts) 3)
                (x-let (list (cbind (sym-name (second parts)) (x-var tmp a))) (parse-x (third parts)) a)
                (parse-x (second parts)))
            (x-if (x-app (std-var (typecase-predicate (sym-name (car parts))) a) (list (x-var tmp a)) a)
                  (x-let (list (cbind (sym-name (second parts)) (x-var tmp a))) (parse-x (third parts)) a)
                  (parse-typecase-arms (cdr arms) tmp a)
                  a)))))

  (parse-args (subr gen (sexps) cxs)
    (lambda (es) (if (null? es) nil (cons (parse-arg (car es)) (parse-args (cdr es))))))

  (parse-arg (subr gen (sexp) cx)
    (lambda (e)
      "An argument; a module given where a module type is wanted made one of
       that type, its values those the type names, in its order (Fixpt's
       `k-reshapes`), unless it is so already."
      (tagcase e
        (sym (n f p)
          (let ((want (fact-text (get cg-module-facts) f p "module-arg "))
                (have (let ((had (fact-text (get cg-module-facts) f p "module-had ")) (laid (layout-in (get cg-layouts) n)))
                        ;; The layout it was made with, if known; else its type's order (C216).
                        (the (listof strings acyclic)
                             (cond ((not (null? laid)) (the (listof strings acyclic) laid))
                                   ((string=? had "") (the (listof strings acyclic) nil))
                                   (else (the (listof strings acyclic) (list (split-words had)))))))))
            (cond ((or (string=? want "") (null? have)) (parse-x e))
                  ((string=? want (put-sep-words (car have))) (parse-x e))
                  (else (x-reshape (parse-x e) (map (lambda ((w string)) (list (index-in w (car have) 0))) (split-words want)) p)))))
        (else other
          ;; An expression's module, of the layout it was made with (C216).
          (let* ((want (fact-text (get cg-module-facts) (datum-file e) (datum-pos e) "module-arg "))
                 (x (parse-x e))
                 (had (fact-text (get cg-module-facts) (datum-file e) (datum-pos e) "module-had "))
                 (have (if (string=? had "") (get cg-module-type) (split-words had))))
            (if (or (string=? want "") (string=? want (put-sep-words have))
                    ;; One made here is made of the type wanted (`module-narrowed`).
                    (head-is? e "module") (head-is? e "extend"))
                x
                (x-reshape x (map (lambda ((w string)) (list (index-in w have 0))) (split-words want)) (datum-pos e))))))))

  (module-fact? (subr gen (i64 string) bool)
    (lambda (a what)
      (any? (lambda ((x fact)) (tagcase x (fact (f p w) (and (i64= p a) (string=? w what))))) (get cg-module-facts))))

  (parse-with (subr gen (sexp cx string i64) cx)
    (lambda (m body f a)
      "`(with m body …)`: `m`'s values bound in the body, those it names. A
       module parameter's are its type's, as the checker said; else `m` is
       a module whose items were read."
      (let ((spec (fact-text (get cg-module-facts) f a "with-spec "))
            (known (tagcase m (sym (n f2 p2) (layout-in (get cg-layouts) n)) (else other nil))))
        (cond ((not (string=? spec "")) (with-layout m (split-words spec) body a))
              ((not (null? known)) (with-layout m (car known) body a))
              (else (begin (cg-fail "not yet: a with of a module not named") body))))))

  (with-layout (subr gen (sexp strings cx i64) cx)
    (lambda (m ns body a) (x-with (parse-x m) ns (indices-from 0 (size ns)) body a)))

  (parse-module (subr gen (sexps i64) cx)
    (lambda (forms a)
      "A module: its own members, in order; then, if it includes modules, a
       first member `%include`, the module of the modules included, made
       first, and the names of theirs its members use bound once after it
       (Fixpt's `with-includes`, `c-note-included!`). The module made is of
       its own members; then, if its type is not that, one of its type:
       the values of the modules it includes but hides, then its own that
       it gives."
      (let* ((outer (get cg-layouts))
             ;; The modules included first, as FX-26 makes them.
             (incs (includes-of forms #f))
             (own (parse-items forms 2))
             (own-names (map cmem-name (filter (lambda ((i cmem)) (i64> (cmem-kind i) 0)) own)))
             (given (map cmem-name (filter (lambda ((i cmem)) (i64= (cmem-kind i) 2)) own))))
        (begin
          (set cg-layouts outer)
          (cond
            ;; A load (kfx's reader's): the module its file is, shared.
            ((and (null? own) (i64= (size incs) 1) (i64= (size forms) 1)
                  (tagcase (car incs) (cinc (m h p) (has-prefix? m "made--load--"))))
             (tagcase (car incs) (cinc (m h p) (begin (set cg-module-type (included-layout m))
                                                     ;; A load of parameters' instance, made again here (C216).
                                                     (let ((made (made-module (get cg-made) m))) (if (null? made) (x-var m p) (car made)))))))
            ((null? incs)
              (begin (set cg-module-type given)
                     (if (string=? (put-sep-words own-names) (put-sep-words given))
                         (x-module own a)
                         (x-reshape (x-module own a) (map (lambda ((n string)) (list (index-in n own-names 0))) given) a))))
            (else
              (let* ((at (tagcase (car incs) (cinc (m h p) p)))
                     (inc-type (included-values incs #t))
                     (shown (included-values incs #f))
                     (inside (map member-in-includes own))
                     (used (included-used inside inc-type nil))
                     (its (cons (cmem "%include" (include-module incs at) 1 #f at)
                                (onto (map (lambda ((n string)) (cmem n (x-extract (x-var "%include" at) (index-in n inc-type 0) at) 0 #f at)) used)
                                      inside)))
                     (mine (cons "%include" own-names)))
                (begin (set cg-module-type (onto shown given))
                       (x-reshape (x-module its a)
                                  (onto (map (lambda ((n string)) (list 0 (index-in n inc-type 0))) shown)
                                        (map (lambda ((n string)) (list (index-in n mine 0))) given))
                                  a)))))))))

  (module-narrowed (subr gen (cx string i64) cx)
    (lambda (x f a)
      "A module made where a module's type is wanted, of the values that type
       names, in its order (the checker's `module-arg` there, C216; Fixpt's
       `k-reshape-at`): made, then reshaped, unless it is so already."
      (let ((want (let ((arg (fact-text (get cg-module-facts) f a "module-arg ")))
                    ;; Else the order of its own type, the checker's (C216).
                    (if (string=? arg "") (fact-text (get cg-module-facts) f a "module-made ") arg)))
            (have (get cg-module-type)))
        (if (or (string=? want "") (string=? want (put-sep-words have)))
            x
            (begin (set cg-module-type (split-words want))
                   (x-reshape x (map (lambda ((w string)) (list (index-in w have 0))) (split-words want)) a))))))

  (parse-extend (subr gen (sexp sexp i64) cx)
    (lambda (e0 e1 a)
      "`(extend e0 e1)` (FX-91's): a module of `e0`, then `e1`, which sees
       `e0`'s values, in a `with` of it; then, of its type, `e0`'s values,
       `e1`'s in their place where both give one, then `e1`'s others."
      (let* ((l0 (included-layout (sym-name e0)))
             (x1 (tagcase e1 (sym (n f p) (x-var n p)) (else other (parse-x e1))))
             (l1 (tagcase e1 (sym (n f p) (included-layout n)) (else other (get cg-module-type))))
             (seen (tagcase e1 (sym (n f p) x1) (else other (x-with (x-var "%extend" a) l0 (indices-from 0 (size l0)) x1 a))))
             (more (filter (lambda ((n string)) (not (string-member? n l0))) l1)))
        (begin
          (set cg-module-type (onto l0 more))
          (x-reshape (x-module (list (cmem "%extend" (parse-x e0) 1 #f a) (cmem "%extended" seen 1 #f a)) a)
                     (onto (map (lambda ((n string)) (if (string-member? n l1) (list 1 (index-in n l1 0)) (list 0 (index-in n l0 0)))) l0)
                           (map (lambda ((n string)) (list 1 (index-in n l1 0))) more))
                     a)))))

  (include-module (subr gen ((listof cinc acyclic) i64) cx)
    (lambda (incs at)
      "`%include`: the modules included, each a member of it; then, of its
       type, each of their values in turn."
      (x-reshape (x-module (include-members incs 0) at) (include-paths incs 0) at)))

  (include-members (subr gen ((listof cinc acyclic) i64) (listof cmem acyclic))
    (lambda (incs k)
      (if (null? incs)
          nil
          (tagcase (car incs)
            (cinc (m h p)
              (cons (cmem (string-append (if h "%hinclude-" "%include-") (i64->string k))
                          (let ((made (made-module (get cg-made) m))) (if (null? made) (x-var m p) (car made)))
                          2 #f p)
                    (include-members (cdr incs) (i64+ k 1))))))))

  (include-paths (subr gen ((listof cinc acyclic) i64) paths)
    (lambda (incs k)
      (if (null? incs)
          nil
          (tagcase (car incs)
            (cinc (m h p)
              (onto (let ((n (size (included-layout m)))) (map (lambda ((i i64)) (list k i)) (indices-from 0 n)))
                    (include-paths (cdr incs) (i64+ k 1))))))))

  (included-values (subr gen ((listof cinc acyclic) bool) strings)
    (lambda (incs hidden)
      "The values of the modules included, in order, of those hidden too if
       `hidden`."
      (if (null? incs)
          nil
          (tagcase (car incs)
            (cinc (m h p)
              (onto (if (and h (not hidden)) nil (included-layout m)) (included-values (cdr incs) hidden)))))))

  (included-layout (subr gen (string) strings)
    (lambda (m)
      (let ((l (if (has-prefix? m "%incl ") (layout-in (get cg-included) m) (layout-in (get cg-layouts) m))))
        (if (null? l) (begin (cg-fail (string-append "not yet: an include of a module not named: " m)) nil) (car l)))))

  (includes-of (subr gen (sexps bool) (listof cinc acyclic))
    (lambda (forms hidden)
      "A module's `include`s, in order, those in a `hide` hidden."
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (cond ((and (head-is? f "include") (i64= (size (items f)) 2) (not (tagcase (second (items f)) (sym (n f2 p2) #t) (else other #f))))
                   ;; A module an expression makes (C221): made where it is
                   ;; included, once, as a module made in place is.
                   (let* ((x (second (items f))) (n (string-append "%incl " (i64->string (datum-pos x)))))
                     (begin
                       (if (null? (made-module (get cg-made) n))
                           (let ((made (parse-x x)))
                             (begin
                               (set cg-made (cons (cmade n made) (get cg-made)))
                               (set cg-included (cons (clayout n (spaced-words (fact-text (get cg-facts) (datum-file x) (datum-pos x) "with-spec ")))
                                                      (get cg-included)))))
                           #u)
                       (cons (cinc n hidden (datum-pos f)) (includes-of (cdr forms) hidden)))))
                  ((head-is? f "include")
                   (if (i64= (size (items f)) 2)
                       (cons (cinc (sym-name (second (items f))) hidden (datum-pos f)) (includes-of (cdr forms) hidden))
                       (begin (cg-fail "not yet: an include with exceptions") nil)))
                  ((head-is? f "hide") (onto (includes-of (cdr (items f)) #t) (includes-of (cdr forms) hidden)))
                  (else (includes-of (cdr forms) hidden)))))))

  (parse-items (subr gen (sexps i64) (listof cmem acyclic))
    (lambda (forms kind)
      "A module's members, in order, each a value; those of a `hide` of kind
       1, hidden."
      (if (null? forms) nil (onto (parse-item (car forms) kind) (parse-items (cdr forms) kind)))))

  (parse-item (subr gen (sexp i64) (listof cmem acyclic))
    (lambda (e kind)
      (let ((h (tagcase e (lst (xs f l p) (if (null? xs) "" (tagcase (car xs) (sym (n f2 p2) n) (else other2 "")))) (else other ""))))
        (cond ((or (string=? h "define") (string=? h "define*"))
               (let* ((xs (items e)) (typed (i64= (size xs) 4)) (n (sym-name (second xs)))
                      (x (parse-x (if typed (fourth xs) (third xs)))))
                 (begin (note-layout! n x)
                        (list (cmem n x kind (and typed (not (null? (lambda-of x)))) (datum-pos e))))))
              ((string=? h "define-rec") (parse-rec-members (cdr (items e)) kind))
              ((string=? h "define-generative")
               (map (lambda ((t ctop)) (tagcase t (t-define (n typed x) (cmem n x 0 #f (datum-pos e))) (else y (cmem "" (x-unit 0) 0 #f 0))))
                    (generative-conversions (generative-name (second (items e))) (datum-pos e))))
              ((string=? h "define-datatype")
               (map (lambda ((t ctop)) (tagcase t (t-define (n typed x) (cmem n x kind #t (datum-pos e))) (else y (cmem "" (x-unit 0) 0 #f 0))))
                    (dt-constructors (cdr (cdr (items e))) (datum-pos e))))
              ((string=? h "import")
               (map (lambda ((t ctop)) (tagcase t (t-define (n typed x) (cmem n x kind #f (datum-pos e))) (else y (cmem "" (x-unit 0) 0 #f 0))))
                    (imports e)))
              ((string=? h "hide") (parse-items (cdr (items e)) 1))
              ((or (string=? h "define-type") (string=? h "define-effect") (string=? h "define-convention") (string=? h "include")
                   (string=? h "%loaded"))
               nil)
              ;; A string is a comment.
              ((tagcase e (str (t f p) #t) (else other #f)) nil)
              (else (begin (cg-fail (string-append "not yet: a module's " h)) nil))))))

  (parse-rec-members (subr gen (sexps i64) (listof cmem acyclic))
    (lambda (bs kind)
      "A `define-rec`'s members, each `(name type expression)`, each where
       its binding is."
      (if (null? bs)
          nil
          (let ((x (parse-x (third (items (car bs))))))
            (cons (cmem (sym-name (car (items (car bs)))) x kind (not (null? (lambda-of x))) (datum-pos (car bs)))
                  (parse-rec-members (cdr bs) kind))))))

  (imports (subr gen (sexp) (listof ctop acyclic))
    (lambda (e)
      "`(import m x …)`: each value `x` defined as `(with m x)`; `(type t
       …)` and `(effect e …)` name no value."
      (import-names (second (items e)) (cdr (cdr (items e))) (datum-pos e))))

  (import-names (subr gen (sexp sexps i64) (listof ctop acyclic))
    (lambda (m xs a)
      (cond ((null? xs) nil)
            ((tagcase (car xs) (sym (n f p) #t) (else other #f))
             (tagcase (car xs)
               (sym (n f p) (cons (t-define n #f (parse-with m (x-var n p) f a)) (import-names m (cdr xs) a)))
               (else other nil)))
            (else (import-names m (cdr xs) a)))))

  (parse-binds (subr gen (sexps) cbinds)
    (lambda (bs)
      (if (null? bs) nil
          (cons (cbind (sym-name (car (items (car bs)))) (parse-x (second (items (car bs))))) (parse-binds (cdr bs))))))

  (parse-typed-binds (subr gen (sexps) cbinds)
    (lambda (bs)
      "A `letrec`'s or `define-rec`'s bindings, `(name type expression)`."
      (if (null? bs) nil
          (cons (cbind (sym-name (car (items (car bs)))) (parse-x (car (cdr (cdr (items (car bs)))))))
                (parse-typed-binds (cdr bs))))))

  (parse-fields (subr gen (sexps) cbinds)
    (lambda (fs)
      "A product's fields, `(label expression)`, in order."
      (if (null? fs) nil
          (cons (cbind (label-of (car (items (car fs)))) (parse-x (second (items (car fs))))) (parse-fields (cdr fs))))))

  (parse-let* (subr gen (sexps cx) cx)
    (lambda (bs body)
      "`let*`: nested one-binding `let`s, each where its binding starts."
      (if (null? bs) body
          (x-let (list (cbind (sym-name (car (items (car bs)))) (parse-x (second (items (car bs))))))
                 (parse-let* (cdr bs) body) (datum-pos (car bs))))))

  (parse-cond (subr gen (sexps i64) cx)
    (lambda (clauses a)
      "`cond`: nested `if`s, each where its clause starts."
      (let* ((c (car clauses)) (parts (items c)))
        (if (null? (cdr clauses))
            (parse-body (cdr parts) (datum-pos c))
            (x-if (parse-x (car parts)) (parse-body (cdr parts) (datum-pos c)) (parse-cond (cdr clauses) a) (datum-pos c))))))

  (parse-and (subr gen (sexps i64) cx)
    (lambda (xs a)
      (cond ((null? xs) (x-bool #t a))
            ((null? (cdr xs)) (parse-x (car xs)))
            (else (let* ((x (parse-x (car xs))) (rest (parse-and (cdr xs) a))) (x-if x rest (x-bool #f a) a))))))

  (parse-or (subr gen (sexps i64) cx)
    (lambda (xs a)
      (cond ((null? xs) (x-bool #f a))
            ((null? (cdr xs)) (parse-x (car xs)))
            (else (let* ((x (parse-x (car xs))) (rest (parse-or (cdr xs) a))) (x-if x (x-bool #t a) rest a))))))

  (parse-quoted (subr gen (sexp i64) cx)
    (lambda (d a)
      "A quoted datum, as Fixpt's quote rewrite writes it: a symbol, an atom
       as itself; a list of `cons` and `nil`, a dotted one's tail its last,
       a vector `list->vector` of its items' list, interned whole."
      (tagcase d
        (sym (n f p) (cond ((string=? n "#t") (x-bool #t a)) ((string=? n "#f") (x-bool #f a)) (else (x-sym n a))))
        (lst (ys f l p)
          (if (null? ys) (std-var "nil" a)
              (x-app (std-var "%quote" a) (list (quoted-item d a)) a)))
        (else other (parse-x d)))))

  (quoted-list (subr gen (sexps i64) cx)
    (lambda (ys a)
      (cond ((null? ys) (std-var "nil" a))
            ((and (tagcase (car ys) (sym (n f p) (string=? n ".")) (else other #f)) (not (null? (cdr ys))) (null? (cdr (cdr ys))))
             (quoted-item (second ys) a))
            (else (x-app (std-var "cons" a) (list (quoted-item (car ys) a) (quoted-list (cdr ys) a)) a)))))

  (quoted-item (subr gen (sexp i64) cx)
    (lambda (d a)
      (tagcase d
        (sym (n f p) (cond ((string=? n "#t") (x-bool #t a)) ((string=? n "#f") (x-bool #f a)) (else (x-sym n a))))
        (lst (ys f l p)
          (if (and (not (null? ys)) (tagcase (car ys) (sym (n f2 p2) (string=? n "#vector")) (else other #f)))
              (x-app (std-var "list->vector" a) (list (quoted-list (cdr ys) a)) a)
              (quoted-list ys a)))
        (else other (parse-x d)))))

  ;; Quasiquotes (C221): Fixpt's parser's `quoted` (parser.fx, TODO §51),
  ;; its rewrite made as this compiler's expressions; a `the` erased.
  ;; `(unquote e)` at depth 1 is `e`; `(unquote-splicing e)`, `e` appended
  ;; to what follows; what no unquote reaches, one `%quote`, made once.
  (quasi-in (subr gen (sexp i64) cx)
    (lambda (x depth)
      (let* ((u (q-unquoted x depth)) (a (datum-pos x))
             (mark (and (null? u) (i64>= depth 1) (q-compound? x) (q-free? x depth)))
             (dq (if mark (the i64 -1) depth)))
        (if (not (null? u))
            (parse-x (car u))
            (let ((built
                   (tagcase x
                     (sym (n f p) (cond ((string=? n "#t") (x-bool #t a)) ((string=? n "#f") (x-bool #f a)) (else (x-sym n a))))
                     (lst (ys f l p)
                       (cond ((null? ys) (std-var "nil" a))
                             ((head-is? x "#vector")
                              (x-app (std-var "datum-list->vector" a)
                                     (list (if (null? (cdr ys)) (std-var "nil" a) (q-items (cdr ys) #f (car (cdr ys)) dq a))) a))
                             ((q-dotted? ys) (q-items (q-before-dot ys) #t (q-dot-tail ys) dq a))
                             (else (q-items ys #f (car ys) dq a))))
                     (else other (parse-x x)))))
              (if mark (x-app (std-var "%quote" a) (list built) a) built))))))

  (q-items (subr gen (sexps bool sexp i64 i64) cx)
    (lambda (items dotted tail depth a)
      (q-onto items dotted tail depth (and (i64>= depth 1) (or (not dotted) (q-free? tail depth)))
              depth (q-inner items depth) #t a)))

  (q-plain (subr gen (sexps bool sexp i64) cx)
    (lambda (items dotted tail a)
      (if (null? items)
          (if dotted (quasi-in tail -1) (std-var "nil" a))
          (x-app (std-var "cons" a) (list (quasi-in (car items) -1) (q-plain (cdr items) dotted tail a)) a))))

  (q-onto (subr gen (sexps bool sexp i64 bool i64 i64 bool i64) cx)
    (lambda (items dotted tail ldepth free-tail depth inner first a)
      (cond
        ((null? items) (if dotted (quasi-in tail ldepth) (std-var "nil" a)))
        ((and free-tail (not first) (q-items-free? items inner inner))
         (x-app (std-var "%quote" a) (list (q-plain items dotted tail a)) a))
        (else
         (let ((rest (q-onto (cdr items) dotted tail ldepth free-tail inner inner #f a))
               (spliced (if (i64= depth 1) (q-unquote-of (car items) "unquote-splicing") nil)))
           (if (null? spliced)
               (x-app (std-var "cons" a) (list (quasi-in (car items) depth) rest) a)
               (x-app (std-var "append" a) (list (parse-x (car spliced)) rest) a)))))))

  (parse-arms (subr gen (sexps) (listof carm acyclic))
    (lambda (arms)
      "A `tagcase`'s arms before its `else`: `(tag name body …)` or
       `(tag (name …) body …)`."
      (if (or (null? arms) (head-is? (car arms) "else")) nil
          (let* ((parts (items (car arms))) (b (second parts)))
            (cons (tagcase b
                    (lst (ns f l p) (carm (arm-label (car parts)) #t (map sym-name ns) (parse-body (cdr (cdr parts)) (datum-pos (car arms)))))
                    (else other (carm (arm-label (car parts)) #f (list (sym-name b)) (parse-body (cdr (cdr parts)) (datum-pos (car arms))))))
                  (parse-arms (cdr arms)))))))

  (parse-else (subr gen (sexps) cbinds)
    (lambda (arms)
      (cond ((null? arms) nil)
            ((head-is? (car arms) "else")
             (let ((parts (items (car arms))))
               (list (cbind (sym-name (second parts)) (parse-body (cdr (cdr parts)) (datum-pos (car arms)))))))
            (else (parse-else (cdr arms)))))))

(define-rec
  (parse-syscall-tops (subr gen (sexps) (listof ctop acyclic))
    (lambda (ds)
      (if (null? ds)
          nil
          (let ((d (items (car ds))))
            (cons (t-define (sym-name (second d)) #f (parse-x (third d))) (parse-syscall-tops (cdr ds))))))))

(define parse-top (subr gen (sexp) (listof ctop acyclic))
  (lambda (e)
    (let ((h (tagcase e (lst (xs f l p) (if (null? xs) "" (tagcase (car xs) (sym (n f2 p2) n) (else other2 "")))) (else other ""))))
      (cond ((or (string=? h "define") (string=? h "define*"))
             (let* ((xs (items e)) (typed (not (i64= (size xs) 3))) (n (sym-name (second xs)))
                    (x (parse-x (if typed (fourth xs) (third xs)))))
               (begin (note-layout! n x)
                      (if (and (or (made-here-name? n) (instance-load? (if typed (fourth xs) (third xs)))) (module-made? x))
                          (begin (set cg-made (cons (cmade n x) (get cg-made))) nil)
                          (list (t-define n typed x))))))
            ((string=? h "define-rec") (list (t-define-rec (parse-typed-binds (cdr (items e))))))
            ((or (string=? h "define-type") (string=? h "define-effect") (string=? h "define-convention")) nil)
            ((string=? h "define-datatype") (dt-constructors (cdr (cdr (items e))) (datum-pos e)))
            ((string=? h "define-generative") (generative-conversions (generative-name (second (items e))) (datum-pos e)))
            ((string=? h "import") (imports e))
            ((string=? h "include") (begin (cg-fail (string-append "not yet: " h)) nil))
            ;; A syscall's declaration (C224): the two definitions it is, as
            ;; the engine makes them (`syscall-definitions`), from the
            ;; checker's fact.
            ((or (string=? h "define-syscall") (string=? h "define-optional-syscall"))
             (parse-syscall-tops (syscall-definitions e (spaced-words (fact-text (get cg-facts) (datum-file e) (datum-pos e) "syscall ")))))
            (else (list (t-exp (parse-x e))))))))

;;; ------------------------------------------------------------- the code

"A literal cell's value: as Fixpt's listing writes it (`literal.rs`)."
(define-datatype lit
  (l-int int)
  (l-bool bool)
  (l-unit)
  (l-nil)
  (l-str string)
  (l-char char)
  (l-f64 int)
  (l-sym string)
  (l-pair lit lit)
  (l-word string))

"An instruction's operand: a number, a literal, a word (by its name), a
 global (by its name), a runtime primitive (by its name)."
(define-datatype opnd (o-int i64) (o-lit lit) (o-word string) (o-global string) (o-prim string))

"One item of a word being built: an instruction (a routine and its
 operands), a label, or a branch to one (Fixpt's `item`)."
(define-datatype item
  (it-ins string (listof opnd acyclic))
  (it-label i64)
  (it-branch i64)
  (it-zbranch i64))

(define-type citems (listof item acyclic))
(define-type code (ref citems @g))

"A word: its name and its items, labels resolved when it is written."
(define-datatype word (word string citems))

"A word's name as the listing says it: up to a tab."
(define-rec
  (before-tab (subr kfx (chars chars) string)
    (lambda (cs acc)
      (cond ((null? cs) (list->string (reverse acc)))
            ((char=? (car cs) #\tab) (list->string (reverse acc)))
            (else (before-tab (cdr cs) (cons (car cs) acc)))))))
(define shown-name (subr kfx (string) string) (lambda (n) (before-tab (string-chars n) nil)))

"The program's words, the newest first."
(define cg-words (ref (listof word acyclic) @g) (new nil))
(define cg-labels (ref i64 @g) (new 0))

(define c-fresh (subr gen () i64)
  (lambda () (let ((n (get cg-labels))) (begin (set cg-labels (i64+ n 1)) n))))

(define c-emit (subr gen (code item) unit) (lambda (c i) (set c (cons i (get c)))))
(define c-op (subr gen (code string) unit) (lambda (c r) (c-emit c (it-ins r nil))))
(define c-op1 (subr gen (code string opnd) unit) (lambda (c r x) (c-emit c (it-ins r (list x)))))
(define c-lit (subr gen (code lit) unit) (lambda (c x) (c-op1 c "lit" (o-lit x))))
(define c-int (subr gen (code i64) unit) (lambda (c n) (c-lit c (l-int (i64->int n)))))

"Field `k` of a bloblet whose type says it has one."
(define c-field (subr gen (code i64) unit) (lambda (c k) (c-op1 c "field" (o-int k))))

"Field `k` of the bloblet on top set to the value under it."
(define c-field-set (subr gen (code i64) unit) (lambda (c k) (begin (c-int c k) (c-op c "field!"))))

"A runtime primitive with `n` arguments."
(define c-prim (subr gen (code string i64) unit)
  (lambda (c name n) (c-emit c (it-ins "prim" (list (o-prim name) (o-int n))))))

"That the blobref on top has room for a flat of `size` bytes."
(define c-fits (subr gen (code i64) unit)
  (lambda (c size) (if (i64> size 1) (begin (c-int c size) (c-prim c "%fx26-suffix-fits" 2)) #u)))

(define second-cx (subr kfx (cxs) cx) (lambda (xs) (car (cdr xs))))

"Drop what a mutator left, and leave FX-26's unit value instead."
(define c-unit-after (subr gen (code) unit) (lambda (c) (begin (c-op c "drop") (c-lit c (l-unit)))))

"What is left when the value is in hand: `return` in tail position."
(define c-done (subr gen (code bool) unit) (lambda (c tail) (if tail (c-op c "return") #u)))

(define-rec
  (c-drops (subr gen (code i64) unit)
    (lambda (c k) (if (i64<= k 0) #u (begin (c-op c "drop") (c-drops c (i64- k 1)))))))

"After a body whose value is on top of `n` values bound from `slot` up:
 the value into `slot`, the others dropped. Nothing in tail position,
 where `return` drops the whole frame."
(define c-unbind (subr gen (code i64 i64 bool) unit)
  (lambda (c slot n tail)
    (if (or tail (i64= n 0)) #u (begin (c-op1 c "slot!" (o-int slot)) (c-drops c (i64- n 1))))))

;;; ------------------------------------------------------------ the listing
;;; As Fixpt's `disasm.rs` writes it, its literals as `literal.rs` writes
;;; them in full: the words from `program`, each a header and a line for
;;; each instruction, `AT: ROUTINE OPERAND …`.

(define-rec
  (hex-digits (subr kfx (i64 chars) chars)
    (lambda (n acc)
      (let* ((d (i64-remainder n 16)) (ch (i64->char (if (i64< d 10) (i64+ 48 d) (i64+ 87 d)))))
        (if (i64< n 16) (cons ch acc) (hex-digits (i64-quotient n 16) (cons ch acc)))))))

(define hex (subr kfx (i64) string) (lambda (n) (list->string (hex-digits n nil))))

"A float's 64 bits, `k` hex digits of them, as Fixpt's listing writes them."
(define-rec
  (hex-bits (subr kfx (int i64 chars) string)
    (lambda (b k acc)
      (if (i64= k 0)
          (list->string acc)
          (let ((d (int->i64 (remainder b 16))))
            (hex-bits (quotient b 16) (i64- k 1) (cons (i64->char (if (i64< d 10) (i64+ 48 d) (i64+ 87 d))) acc)))))))

"A string's characters, each not printable ASCII (and `quote` and `\\`) by
 its code, `\\xHH;`."
(define lit-escaped (subr kfx (string char) string)
  (lambda (s quote)
    (list->string
      (concat (map (lambda ((ch char))
                     (let ((k (char->i64 ch)))
                       (if (or (char=? ch quote) (i64= k 92) (i64< k 32) (i64> k 126))
                           (string-chars (string-append "\\x" (string-append (hex k) ";")))
                           (list ch))))
                   (string-chars s))))))

(define-rec
  (lit-text (subr kfx (lit) string)
    (lambda (l)
      (tagcase l
        (l-int (n) (int->string n))
        (l-bool (v) (if v "#t" "#f"))
        (l-unit () "|#u|")
        (l-nil () "()")
        (l-str (s) (string-append "\"" (string-append (lit-escaped s #\") "\"")))
        (l-char (ch) (string-append "#\\x" (hex (char->i64 ch))))
        (l-f64 (b) (string-append "#f64x" (hex-bits b 16 nil)))
        (l-sym (s) (string-append "|" (string-append (lit-escaped s #\|) "|")))
        (l-pair (a d) (string-append "(" (string-append (lit-text a) (string-append " . " (string-append (lit-text d) ")")))))
        (l-word (w) (string-append "word " (shown-name w)))))))

(define item-size (subr kfx (item) i64)
  (lambda (i) (tagcase i (it-ins (r os) (i64+ 1 (size os))) (it-label (n) 0) (it-branch (n) 2) (it-zbranch (n) 2))))

"Where each label is: a list of (label, cell) pairs."
(define-datatype place (place i64 i64))
(define-rec
  (places-of (subr kfx (citems i64 (listof place acyclic)) (listof place acyclic))
    (lambda (xs at acc)
      (if (null? xs) acc
          (places-of (cdr xs) (i64+ at (item-size (car xs)))
                     (tagcase (car xs) (it-label (n) (cons (place n at) acc)) (else y acc)))))))
(define-rec
  (place-at (subr kfx ((listof place acyclic) i64) i64)
    (lambda (ps n) (cond ((null? ps) -1) ((tagcase (car ps) (place (m at) (i64= m n))) (tagcase (car ps) (place (m at) at))) (else (place-at (cdr ps) n))))))

(define-rec
  (range-from (subr kfx (i64 i64) (listof i64 acyclic))
    (lambda (i n) (if (i64>= i n) nil (cons i (range-from (i64+ i 1) n))))))
(define range-to (subr kfx (i64) (listof i64 acyclic)) (lambda (n) (range-from 0 n)))

(define padded (subr kfx (i64) string)
  (lambda (n)
    (let ((s (i64->string n)))
      (string-append (list->string (map (lambda ((k i64)) #\space) (range-to (i64- 4 (string-length-i64 s))))) s))))

(define second-opnd (subr kfx ((listof opnd acyclic)) opnd) (lambda (os) (car (cdr os))))

(define line (subr kfx (i64 string) string) (lambda (at text) (string-append "  " (string-append (padded at) (string-append ": " text)))))

(define-rec
  (put-sep-lines (subr kfx (strings) string)
    (lambda (ss) (if (null? ss) "" (string-append (car ss) (string-append "\n" (put-sep-lines (cdr ss))))))))

(define opnd-text (subr kfx (opnd) string)
  (lambda (o)
    (tagcase o
      (o-int (n) (i64->string n))
      (o-lit (l) (lit-text l))
      (o-word (w) (string-append "word " (shown-name w)))
      (o-global (g) g)
      (o-prim (p) p))))

(define-rec
  (words-said (subr kfx ((listof opnd acyclic)) strings)
    (lambda (os) (if (null? os) nil (onto (tagcase (car os) (o-word (w) (list w)) (o-lit (l) (tagcase l (l-word (w) (list w)) (else y nil))) (else y nil)) (words-said (cdr os)))))))

(define ins-text (subr kfx (string (listof opnd acyclic)) string)
  (lambda (r os)
    (if (string=? r "closure")
        (string-append "closure " (string-append (opnd-text (car os)) (string-append " over " (opnd-text (second-opnd os)))))
        (if (null? os) r (string-append r (string-append " " (put-sep-words (map opnd-text os))))))))





"One word's lines, and the words its lines name, in order."
(define-datatype wsaid (wsaid string strings))

(define-rec
  (lines-of-items (subr kfx (citems i64 (listof place acyclic) strings strings) wsaid)
    (lambda (xs at ps out named)
      (if (null? xs)
          (wsaid (put-sep-lines (reverse out)) (reverse named))
          (let* ((x (car xs)) (next (i64+ at (item-size x))))
            (tagcase x
              (it-label (n) (lines-of-items (cdr xs) next ps out named))
              (it-branch (n) (lines-of-items (cdr xs) next ps (cons (line at (string-append "branch → " (i64->string (place-at ps n)))) out) named))
              (it-zbranch (n) (lines-of-items (cdr xs) next ps (cons (line at (string-append "0branch → " (i64->string (place-at ps n)))) out) named))
              (it-ins (r os) (lines-of-items (cdr xs) next ps (cons (line at (ins-text r os)) out) (onto (reverse (words-said os)) named)))))))))





"A word's lines, as the listing writes them."
(define word-text (subr kfx (citems) string)
  (lambda (xs) (tagcase (lines-of-items xs 0 (places-of xs 0 nil) nil nil) (wsaid (text named) text))))

"Whether a word named `name`, as the listing names it, is listed: none,
 one whose lines are `text`, or only others."
(define-rec
  (c-named (subr kfx ((listof word acyclic) string string i64) i64)
    (lambda (ws name text k)
      (cond ((null? ws) k)
            ((tagcase (car ws) (word (m xs) (string=? (shown-name m) name)))
             (if (tagcase (car ws) (word (m xs) (string=? (word-text xs) text))) 1 (c-named (cdr ws) name text 2)))
            (else (c-named (cdr ws) name text k))))))

"A word assembled: made one of the program's, under `name`. Two words
 may have one name in Fixpt's listing (C144): an abstract type's two
 conversions, a datatype's constructors in a module that includes one, a
 global defined again. One the same as a word of its name, cell for cell,
 is listed under it too, as Fixpt lists it (told apart by a tab and a
 number, which the listing leaves out), and kayak-cells takes it as that
 word; one not the same is named apart, `name~N`, so that it runs."
(define c-assemble (subr gen (code string) string)
  (lambda (c name)
    (let* ((xs (the citems (reverse (get c))))
           (k (c-named (get cg-words) name (word-text xs) 0))
           (n (i64->string (size (get cg-words))))
           (own (cond ((i64= k 0) name)
                      ((i64= k 1) (string-append name (string-append "\t" n)))
                      (else (string-append name (string-append "~" n))))))
      (begin (set cg-words (cons (word own xs) (get cg-words))) own))))

;;; ------------------------------------------------------------ the scope

"Where a variable is (Fixpt's `loc`): a slot of the frame, a free value
 of the closure, a global, a `letrec` sibling not made yet, to be in slot
 `i`, or the procedure being compiled, only called in tail position, each
 call a jump to its start."
(define-datatype loc (at-slot i64) (at-free i64) (at-global string) (at-pending i64) (at-loop))

(define-datatype centry (centry string loc))
(define-type cenv (listof centry acyclic))
(define-type found (listof loc acyclic))

(define c-extend (subr kfx (string loc cenv) cenv) (lambda (n l e) (cons (centry n l) e)))

(define-rec
  (c-find (subr kfx (cenv string) found)
    (lambda (e n)
      (cond ((null? e) nil)
            ((tagcase (car e) (centry (m l) (string=? m n))) (tagcase (car e) (centry (m l) (list l))))
            (else (c-find (cdr e) n))))))

"The globals defined so far, the newest first."
(define cg-globals (ref strings @g) (new nil))

"Where `n` is: in the locals, else in the globals; none means standard."
(define c-where (subr gen (cenv string) found)
  (lambda (e n)
    (let ((l (c-find e n)))
      (cond ((not (null? l)) l)
            ((string-member? n (get cg-globals)) (list (at-global n)))
            (else nil)))))

(define c-load (subr gen (code loc) unit)
  (lambda (c l)
    (tagcase l
      (at-slot (i) (c-op1 c "slot" (o-int i)))
      (at-free (i) (c-op1 c "free" (o-int i)))
      (at-global (g) (c-op1 c "global" (o-global g)))
      (at-pending (i) (cg-fail "a letrec sibling not made yet is only captured"))
      (at-loop () (cg-fail "a loop is only ever called, in tail position")))))

(define c-loop? (subr kfx (loc) bool) (lambda (l) (tagcase l (at-loop () #t) (else y #f))))
(define c-global? (subr kfx (loc) bool) (lambda (l) (tagcase l (at-global (g) #t) (else y #f))))


(define c-count (poly ((a type)) (subr kfx ((listof a acyclic)) i64)) (plambda ((a type)) (lambda ((xs (listof a acyclic))) (size xs))))

"Whether every use of `f` in `x` is a call with `n` arguments: where
 `loops` asks, in tail position, which the compiler makes a loop; else in
 any position, and in lambdas inside too, so that `f` is never a value."
(define-rec
  (c-calls-only (subr kfx (cx string i64 bool bool) bool)
    (lambda (x f n tail loops)
      (tagcase x
        (x-var (m a) (not (string=? m f)))
        (x-lambda (ps body a) (or (string-member? f ps) (c-calls-only-inside body f n loops)))
        (x-app (fun args a)
          (and (c-calls-only-all args f n loops)
               (tagcase fun
                 (x-var (m a2) (if (string=? m f) (and (or tail (not loops)) (i64= (size args) n)) #t))
                 (else y (c-calls-only fun f n #f loops)))))
        (x-if (t th el a) (and (c-calls-only t f n #f loops) (c-calls-only th f n tail loops) (c-calls-only el f n tail loops)))
        (x-letrec (bs body a)
          (or (string-member? f (c-bound-names bs nil))
              (and (c-calls-only-all (c-bound-exps bs) f n loops) (c-calls-only body f n tail loops))))
        (x-let (bs body a)
          (and (c-calls-only-all (c-bound-exps bs) f n loops)
               (or (string-member? f (c-bound-names bs nil)) (c-calls-only body f n tail loops))))
        (x-begin (es a) (c-calls-only-begin es f n tail loops))
        (x-proj (x a) (c-calls-only x f n tail loops))
        (x-product (fs a) (c-calls-only-all (c-bound-exps fs) f n loops))
        (x-extract (p i a) (c-calls-only p f n #f loops))
        (x-sum (t v a) (c-calls-only v f n #f loops))
        (x-tagcase (s arms els k a)
          (and (c-calls-only s f n #f loops) (c-calls-only-arms arms f n tail loops) (c-calls-only-else els f n tail loops)))
        (x-bloblet (op i xs a) (c-calls-only-all xs f n loops))
        (x-prompt (t body h a)
          (and (c-calls-only t f n #f loops) (c-calls-only h f n #f loops) (c-calls-only-inside body f n loops)))
        (x-region (k r body a) (or (string=? r f) (c-calls-only body f n #f loops)))
        (x-rlambda (r l a) (and (c-calls-only r f n #f loops) (c-calls-only l f n #f loops)))
        ;; Said of no module, as Fixpt's compilers say.
        (x-module (its a) #f)
        (x-with (m ns ks body a) #f)
        (x-reshape (y ps a) (c-calls-only y f n #f loops))
        (else y #t))))
  (c-calls-only-inside (subr kfx (cx string i64 bool) bool)
    (lambda (x f n loops) (if loops (not (c-mentions? x f)) (c-calls-only x f n #f loops))))
  (c-calls-only-all (subr kfx (cxs string i64 bool) bool)
    (lambda (es f n loops) (or (null? es) (and (c-calls-only (car es) f n #f loops) (c-calls-only-all (cdr es) f n loops)))))
  (c-calls-only-begin (subr kfx (cxs string i64 bool bool) bool)
    (lambda (es f n tail loops)
      (cond ((null? es) #t)
            ((null? (cdr es)) (c-calls-only (car es) f n tail loops))
            (else (and (c-calls-only (car es) f n #f loops) (c-calls-only-begin (cdr es) f n tail loops))))))
  (c-calls-only-arms (subr kfx ((listof carm acyclic) string i64 bool bool) bool)
    (lambda (arms f n tail loops)
      (or (null? arms)
          (and (tagcase (car arms) (carm (t p ns body) (or (string-member? f ns) (c-calls-only body f n tail loops))))
               (c-calls-only-arms (cdr arms) f n tail loops)))))
  (c-calls-only-else (subr kfx (cbinds string i64 bool bool) bool)
    (lambda (els f n tail loops)
      (or (null? els) (tagcase (car els) (cbind (m x) (or (string=? m f) (c-calls-only x f n tail loops))))))))

(define c-loops-only (subr kfx (cx string i64 bool) bool) (lambda (x f n tail) (c-calls-only x f n tail #t)))

;;; ------------------------------------------- the procedure being compiled

"The word being compiled, when it is a `letrec`-bound procedure's: a tail
 call of `c-this-name`, still bound at `c-this-loc`, is a loop.
 `c-this-params` is -1 when the word is no such procedure's."
(define-datatype this (this string loc i64))
(define c-this-name (ref string @g) (new "none"))
(define c-this-loc (ref loc @g) (new (at-loop)))
(define c-this-params (ref i64 @g) (new -1))
(define c-this-start (ref i64 @g) (new 0))

(define c-this-saved (subr gen () this)
  (lambda () (this (get c-this-name) (get c-this-loc) (get c-this-params))))

(define c-this-enter! (subr gen (this i64) unit)
  (lambda (me start)
    (tagcase me (this (n l k) (begin (set c-this-name n) (set c-this-loc l) (set c-this-params k) (set c-this-start start))))))

"Whether `l` is where the procedure being compiled is bound: its loop, or
 the free value holding its closure, or a top-level definition's own
 global."
(define c-this-loc? (subr kfx (loc loc) bool)
  (lambda (l me)
    (tagcase me
      (at-loop () (c-loop? l))
      (at-free (i) (tagcase l (at-free (j) (i64= i j)) (else y #f)))
      (at-global (g) (c-global? l))
      (else y #f))))

(define c-self-call? (subr gen (cx cxs cenv bool) bool)
  (lambda (f args e tail)
    (and tail (i64>= (get c-this-params) 0)
         (tagcase f
           (x-var (n a)
             (and (string=? n (get c-this-name))
                  (let ((l (c-find e n)))
                    (and (not (null? l)) (c-this-loc? (car l) (get c-this-loc))
                         (i64= (size args) (get c-this-params))))))
           (else y #f)))))

"Into the parameters' slots, from `i` down to 0."
(define-rec
  (c-loop-stores (subr gen (code i64) unit)
    (lambda (c i) (if (i64< i 0) #u (begin (c-op1 c "slot!" (o-int i)) (c-loop-stores c (i64- i 1)))))))

;;; ---------------------------------------------------------- word names

"The name the next lambda's word gets, if not where its body starts (a
 global's); the name of the lambda whose body is compiled, without where
 it starts, an inner lambda's word named within it, `outer/inner@N`; and
 while a `let`'s binding's init is compiled, the binding's name, which
 the first lambda compiled in it is named for. Each a list of none or one."
(define c-word-name (ref strings @g) (new nil))
(define c-scope-name (ref strings @g) (new nil))
(define c-bind-name (ref strings @g) (new nil))

(define c-take (subr gen ((ref strings @g)) strings)
  (lambda (r) (let ((v (get r))) (begin (set r nil) v))))

"A lambda's word's name, but for where its body starts: `named`'s, if it
 has one (a global's); else for the definition it is in, and the name it
 is bound to there (`own`, a `letrec`'s, or `bound`, a `let`'s), or
 `lambda`."
(define c-word-base (subr gen (strings strings strings) string)
  (lambda (named own bound)
    (if (null? named)
        (let ((inner (cond ((not (null? own)) (car own)) ((not (null? bound)) (car bound)) (else "lambda")))
              (scope (get c-scope-name)))
          (if (null? scope) inner (string-append (car scope) (string-append "/" inner))))
        (car named))))

(define c-word-symbol (subr gen (string strings cx) string)
  (lambda (base named body)
    (if (null? named) (string-append base (string-append "@" (i64->string (cx-start body)))) (car named))))

;;; ------------------------------------------------- standard operations

"Whether `name` is an equality of the same word, as `eq` does it."
(define std-eq-name? (subr kfx (string) bool)
  (lambda (n)
    (or (string=? n "char=?") (string=? n "symbol=?") (string=? n "wglobal=?") (string=? n "eq?") (string=? n "bool=?"))))

(define std-nil-name? (subr kfx (string) bool) (lambda (n) (or (string=? n "nil") (string=? n "no-pair"))))

(define std-primitive (subr kfx (string) string) (lambda (n) (with standard (standard-primitive n))))

"How many arguments a standard operation takes, as a value, or -1 if it
 is not known here (Fixpt asks its runtime's table for the rest: not yet)."
(define c-arity (subr kfx (string) i64)
  (lambda (n)
    (cond ((string-member? n (list "make-continuation-prompt-tag" "make-escape-tag" "make-continuation-mark-key")) 0)
          ((string-member? n (list "car" "cdr" "null?" "not" "new" "get" "char->integer" "integer->char" "string-length"
                                   "char->string" "symbol->string" "string->symbol" "array-length" "current-marks" "cwcc"
                                   ;; The shapes' tests (C217).
                                   "int?" "string?" "bool?" "char?" "symbol?" "pair?" "procedure?" "f64?" "f32?" "ref?" "sum?"
                                   "product?" "bytevector?" "vector?" "array?" "nat?"))
           1)
          ((string-member? n (list "with-mark" "array-set!" "substring" "%sched")) 3)
          ((string-member? n (list "+" "-" "*" "<" ">" "<=" ">=" "=" "modulo" "quotient" "cons" "set-car!" "set-cdr!" "char=?"
                                   "string=?" "array-ref" "string-ref" "make-array" "abort-current-continuation" "escape" "set"
                                   "marks-of" "call-with-composable-continuation" "call-with-oneshot-continuation" "first-mark"))
           2)
          ((std-eq-name? n) 2)
          (else -1))))

"The boolean on top negated."
(define c-not (subr gen (code) unit) (lambda (c) (begin (c-lit c (l-bool #f)) (c-op c "eq"))))

"The index on top made the field it is in an array, whose elements are
 its fields from 2 on."
(define c-array-index (subr gen (code) unit) (lambda (c) (begin (c-int c 2) (c-op c "int-add"))))

(define c-standard-on (subr gen (string i64 code) unit)
  (lambda (name n c)
    (cond ((string=? name "+") (c-op c "int-add"))
          ((string=? name "-") (c-op c "int-sub"))
          ((string=? name "<") (c-op c "int-less"))
          ((string=? name ">") (begin (c-op c "swap") (c-op c "int-less")))
          ((string=? name "<=") (begin (c-op c "swap") (c-op c "int-less") (c-not c)))
          ((string=? name ">=") (begin (c-op c "int-less") (c-not c)))
          ((string=? name "=") (c-op c "int-eq"))
          ((string=? name "cons") (c-op c "cons"))
          ((string=? name "car") (c-op c "pair-car"))
          ((string=? name "cdr") (c-op c "pair-cdr"))
          ((or (string=? name "set-car!") (string=? name "set-cdr!")) (begin (c-prim c name 2) (c-unit-after c)))
          ((string=? name "new") (c-prim c "%make-box" 1))
          ((string=? name "get") (c-field c 2))
          ((string=? name "set") (begin (c-op c "swap") (c-field-set c 2) (c-lit c (l-unit))))
          ((string=? name "null?") (begin (c-lit c (l-nil)) (c-op c "eq")))
          ((string=? name "not") (c-not c))
          ((string=? name "char->string") (c-prim c "string" 1))
          ((or (string=? name "make-continuation-prompt-tag") (string=? name "make-escape-tag") (string=? name "make-continuation-mark-key"))
           (begin (c-lit c (l-unit)) (c-prim c "%make-box" 1)))
          ((or (string=? name "abort-current-continuation") (string=? name "escape")) (c-op c "abort"))
          ((string=? name "call-with-composable-continuation") (c-op c "callcomp"))
          ((string=? name "call-with-oneshot-continuation") (c-op c "callone"))
          ((string=? name "cwcc") (c-op c "callcc"))
          ((string=? name "with-mark") (c-op c "withmark"))
          ((string=? name "first-mark") (c-op c "firstmark"))
          ((string=? name "current-marks") (c-op c "currentmarks"))
          ((string=? name "marks-of") (c-op c "marksof"))
          ((string=? name "array-ref") (begin (c-array-index c) (c-op c "field@")))
          ((string=? name "array-set!")
           (begin (c-op c "swap") (c-array-index c) (c-op c "swap") (c-prim c "%bloblet-set!" 3) (c-unit-after c)))
          ((string=? name "apply") (begin (c-op c "swap") (c-field c 3) (c-op1 c "call" (o-int 1))))
          ((string=? name "array-length") (begin (c-prim c "%bloblet-fields" 1) (c-int c 1) (c-op c "int-sub")))
          ((string-member? name (list "modulo" "char->integer" "integer->char" "string-append" "string-length" "string-ref" "list->vector"
                                      "substring" "string=?" "string->symbol" "symbol->string"))
           (c-prim c name n))
          ;; A conversion (C230, `converted-x`): Fixpt's primitive itself.
          ((string=? name "%fx26-convert") (c-prim c name n))
          ((std-eq-name? name) (c-op c "eq"))
          (else
           (let ((p (std-primitive name)))
             (cond ((string=? p "%fx26-identity") #u)
                   ((string=? p "") (cg-fail (string-append "not yet compiled: " name)))
                   (else (c-prim c p n))))))))

"The standard `vsubr`s, `list`, `append` and `string-append`, each with
 the operation of one list that its value applies; \"\" for the rest."
(define c-vsubr-list-op (subr kfx (string) string)
  (lambda (n)
    (cond ((string=? n "list") "datum-list") ((string=? n "append") "%append-list")
          ((string=? n "string-append") "%string-append-list") (else ""))))
(define c-vsubr? (subr kfx (string) bool) (lambda (n) (not (string=? (c-vsubr-list-op n) ""))))

"The words made of standard operations as values, by name."
(define cg-standard-words (ref strings @g) (new nil))

(define-rec
  (c-params-pushed (subr gen (code i64 i64) unit)
    (lambda (c i n) (if (i64= i n) #u (begin (c-op1 c "slot" (o-int i)) (c-params-pushed c (i64+ i 1) n))))))

"A standard operation's word as a value: a procedure of its arity that
 applies it to its parameters; a `vsubr`'s, of one list, its operation's
 on that list."
(define c-standard-word (subr gen (string) string)
  (lambda (name)
    (if (string-member? name (get cg-standard-words))
        name
        (let ((n (c-arity name)) (body (the code (new nil))))
          (begin
            (cond ((c-vsubr? name)
                   (begin (c-op1 body "slot" (o-int 0)) (c-standard-on (c-vsubr-list-op name) 1 body)))
                  ((i64< n 0) (cg-fail (string-append "not yet compiled as a value: " name)))
                  ((string=? name "make-array")
                   (begin (c-int body 0) (c-params-pushed body 0 n) (c-prim body "%make-bloblet-filled" 3)))
                  (else (begin (c-params-pushed body 0 n) (c-standard-on name n body))))
            (c-op body "return")
            (set cg-standard-words (cons name (get cg-standard-words)))
            (c-assemble body name))))))

"A standard operation as a value: a closure of its word over no values; a
 `vsubr`'s given to `%fx26-vlambda`."
(define c-standard-value (subr gen (string code) unit)
  (lambda (name c)
    (let ((w (c-standard-word name)))
      (begin (c-emit c (it-ins "closure" (list (o-word w) (o-int 0))))
             (if (c-vsubr? name) (c-prim c "%fx26-vlambda" 1) #u)))))

"The standard operation `f` names, if it is a name bound nowhere else;
 else \"\"."
(define c-standard-name (subr gen (cx cenv) string)
  (lambda (f e)
    (tagcase f (x-var (n a) (cond ((std-marked? n) (std-named n)) ((null? (c-where e n)) n) (else ""))) (else y ""))))

"The datum a quote builds, as a literal, where it is made of literals and
 symbols: none, or one."
(define-rec
  (c-quoted-cell (subr kfx (cx) (listof lit acyclic))
    (lambda (x)
      (tagcase x
        (x-int (n a) (list (l-int n)))
        (x-bool (v a) (list (l-bool v)))
        (x-char (v a) (list (l-char v)))
        (x-sym (s a) (list (l-sym s)))
        (x-var (n a) (if (string=? (std-named n) "nil") (list (l-nil)) nil))
        (x-app (f args a)
          (if (and (tagcase f (x-var (n b) (string=? (std-named n) "cons")) (else y #f)) (i64= (size args) 2))
              (let ((h (c-quoted-cell (car args))) (t (c-quoted-cell (car (cdr args)))))
                (if (or (null? h) (null? t)) nil (list (l-pair (car h) (car t)))))
              nil))
        (else y nil)))))

;;; --------------------------------------------------------- expressions
;;; `depth` is how many values are on the frame above its start, so the
;;; next value pushed is slot `depth`. In tail position, code ends the
;;; word: with a tail call, or with `return` after the value.

"What a lambda's word captures, as patches for `letrec` siblings: for each
 sibling it captured before the sibling was made, its free value's index
 and the slot the sibling will be in."
(define-datatype patch (patch i64 i64))
(define-type patches (listof patch acyclic))

"A lambda's word, and the names its closure captures, in order."
(define-datatype cclosing (cclosing string strings))

(define-rec
  (c-param-env (subr kfx (strings i64 cenv) cenv)
    (lambda (ps i acc) (if (null? ps) acc (c-param-env (cdr ps) (i64+ i 1) (c-extend (car ps) (at-slot i) acc))))))

"The free names that are locals here, not globals or standard names, nor
 a loop, which is not a value."
(define-rec
  (c-captured (subr gen (strings cenv) strings)
    (lambda (xs e)
      (cond ((null? xs) nil)
            ((let ((l (c-find e (car xs)))) (or (null? l) (c-loop? (car l)) (c-global? (car l)))) (c-captured (cdr xs) e))
            (else (cons (car xs) (c-captured (cdr xs) e)))))))

(define-rec
  (c-inner-env (subr kfx (strings cenv i64) cenv)
    (lambda (xs acc i) (if (null? xs) acc (c-inner-env (cdr xs) (c-extend (car xs) (at-free i) acc) (i64+ i 1))))))

"A parameter of the same name hides the procedure."
(define c-own-of (subr kfx (strings strings) strings)
  (lambda (ps own0) (if (or (null? own0) (string-member? (car own0) ps)) nil own0)))

"The scope a lambda's body starts in: its own name, if it does not capture
 it, where `e` has it, a global, or else its loop."
(define c-own-scope (subr gen (strings strings cenv) cenv)
  (lambda (own fv e)
    (if (or (null? own) (string-member? (car own) fv))
        nil
        (let ((l (c-where e (car own))))
          (list (centry (car own) (if (and (not (null? l)) (c-global? (car l))) (car l) (at-loop))))))))

(define c-this-of (subr kfx (strings cenv i64) (listof this acyclic))
  (lambda (own inner n) (if (null? own) nil (list (this (car own) (car (c-find inner (car own))) n)))))

"Each captured name's value, as the closure will hold it, free value `j`
 on; a sibling not made yet is a placeholder, and one of the patches."
(define-rec
  (c-push-all (subr gen (strings cenv i64 code) patches)
    (lambda (xs e j c)
      (if (null? xs)
          nil
          (let* ((pending (tagcase (car (c-find e (car xs)))
                            (at-slot (i) (begin (c-op1 c "slot" (o-int i)) (the i64 -1)))
                            (at-free (i) (begin (c-op1 c "free" (o-int i)) (the i64 -1)))
                            (at-pending (s) (begin (c-lit c (l-bool #f)) s))
                            (else y (begin (cg-fail "a global or a loop is not captured") (the i64 -1)))))
                 (rest (c-push-all (cdr xs) e (i64+ j 1) c)))
            (if (i64< pending 0) rest (cons (patch j pending) rest)))))))

"A product's members, from the slot after the sum's, each a slot."
(define-rec
  (c-members (subr gen (strings cenv i64 i64 i64 code) cenv)
    (lambda (ns e sum-slot slot j c)
      (if (null? ns)
          e
          (begin (c-op1 c "slot" (o-int (i64+ sum-slot 1)))
                 (c-field c (i64+ j 2))
                 (c-members (cdr ns) (c-extend (car ns) (at-slot slot) e) sum-slot (i64+ slot 1) (i64+ j 1) c))))))

"Binding `i`'s scope while it is made: each sibling pending, and itself a
 loop if it only calls itself in loops."
(define-rec
  (c-letrec-own (subr kfx (cbinds cenv i64 i64 i64 cx i64) cenv)
    (lambda (bs e depth k i body nps)
      (if (null? bs)
          e
          (tagcase (car bs)
            (cbind (g x)
              (let ((loops (and (i64= k i) (c-loops-only body g nps #t))))
                (c-letrec-own (cdr bs) (c-extend g (if loops (at-loop) (at-pending (i64+ depth k))) e) depth (i64+ k 1) i body nps))))))))

(define-rec
  (c-letrec-slots (subr kfx (cbinds cenv i64) cenv)
    (lambda (bs e d)
      (if (null? bs) e (tagcase (car bs) (cbind (n x) (c-letrec-slots (cdr bs) (c-extend n (at-slot d) e) (i64+ d 1))))))))

(define-rec
  (c-patch-one (subr gen (patches i64 i64 code) unit)
    (lambda (ps depth i c)
      (if (null? ps)
          #u
          (tagcase (car ps)
            (patch (j s)
              (begin (c-op1 c "slot" (o-int s))
                     (c-op1 c "slot" (o-int (i64+ depth i)))
                     (c-field-set c (i64+ 3 j))
                     (c-patch-one (cdr ps) depth i c)))))))
  (c-letrec-patch (subr gen ((listof patches acyclic) i64 i64 code) unit)
    (lambda (made depth i c)
      (if (null? made) #u (begin (c-patch-one (car made) depth i c) (c-letrec-patch (cdr made) depth (i64+ i 1) c))))))

;;; modules (C144). A module's items are made in slots in order, as a
;;; `letrec*`'s: a typed lambda naming an item not made yet captures it
;;; once it is made, as a `letrec`'s siblings are (Fixpt's
;;; `compile-state.fx`, step for step).

"A closure in slot `d` waiting for slot `s`'s value, as its free value
 `j`."
(define-datatype wait (wait i64 i64 i64))

(define-rec
  (c-module-slots (subr kfx ((listof cmem acyclic) i64) cenv)
    (lambda (its d)
      (if (null? its) nil (cons (centry (cmem-name (car its)) (at-slot d)) (c-module-slots (cdr its) (i64+ d 1)))))))

"Whether `x` names any of `later`'s."
(define c-names-any? (subr kfx (cx cenv) bool)
  (lambda (x later) (any? (lambda ((n string)) (not (null? (c-find later n)))) (c-free x nil nil))))

"Item `n`'s lambda's scope while it is made: each of `later` pending, and
 itself a loop if it only calls itself in loops."
(define-rec
  (c-module-own (subr kfx (string cenv cenv cx i64) cenv)
    (lambda (n e later body nps)
      (if (null? later)
          e
          (tagcase (car later)
            (centry (m l)
              (let ((loops (and (string=? m n) (c-loops-only body n nps #t))))
                (c-module-own n (c-extend m (if loops (at-loop) (tagcase l (at-slot (s) (at-pending s)) (else y l))) e)
                              (cdr later) body nps))))))))

"Each closure of `ws` waiting for slot `d`, given it."
(define-rec
  (c-give-waiting (subr gen (code (listof wait acyclic) i64) unit)
    (lambda (c ws d)
      (if (null? ws)
          #u
          (tagcase (car ws)
            (wait (at j s)
              (begin
                (if (i64= s d)
                    (begin (c-op1 c "slot" (o-int d)) (c-op1 c "slot" (o-int at)) (c-field-set c (i64+ 3 j)))
                    #u)
                (c-give-waiting c (cdr ws) d))))))))

(define-rec
  (c-slots-load (subr gen (code (listof i64 acyclic)) unit)
    (lambda (c ss) (if (null? ss) #u (begin (c-op1 c "slot" (o-int (car ss))) (c-slots-load c (cdr ss)))))))

"Each of `ps` of the module in slot `d` pushed: a field, a field of that,
 ..."
(define-rec
  (c-fields-in (subr gen (code (listof i64 acyclic)) unit)
    (lambda (c ks) (if (null? ks) #u (begin (c-field c (i64+ (car ks) 2)) (c-fields-in c (cdr ks)))))))
(define-rec
  (c-reshape-fields (subr gen (code i64 paths) unit)
    (lambda (c d ps)
      (if (null? ps) #u (begin (c-op1 c "slot" (o-int d)) (c-fields-in c (car ps)) (c-reshape-fields c d (cdr ps)))))))

(define-rec
  (c-exps (subr gen (cxs cenv i64 code) i64)
    (lambda (es e depth c)
      (if (null? es) 0 (begin (c-exp (car es) e depth c #f) (i64+ 1 (c-exps (cdr es) e (i64+ depth 1) c))))))

  (c-exp (subr gen (cx cenv i64 code bool) unit)
    (lambda (x e depth c tail)
      (tagcase x
        (x-var (n a)
          (let ((l (if (std-marked? n) nil (c-where e n))))
            (begin
              (if (null? l)
                  (if (std-nil-name? (std-named n)) (c-lit c (l-nil)) (c-standard-value (std-named n) c))
                  (c-load c (car l)))
              (c-done c tail))))
        (x-int (n a) (begin (c-lit c (l-int n)) (c-done c tail)))
        (x-bool (v a) (begin (c-lit c (l-bool v)) (c-done c tail)))
        (x-str (s a) (begin (c-lit c (l-str s)) (c-done c tail)))
        (x-char (ch a) (begin (c-lit c (l-char ch)) (c-done c tail)))
        (x-float (b a) (begin (c-lit c (l-f64 b)) (c-done c tail)))
        (x-sym (s a) (begin (c-lit c (l-sym s)) (c-done c tail)))
        (x-unit (a) (begin (c-lit c (l-unit)) (c-done c tail)))
        (x-lambda (ps body a) (begin (c-lambda ps body e depth c nil nil) (c-done c tail)))
        (x-rlambda (r l a)
          (tagcase l
            (x-lambda (ps body b) (begin (c-lambda ps body e depth c nil (list r)) (c-done c tail)))
            (else y (cg-fail "an rlambda's lambda"))))
        (x-bloblet (op i xs a) (begin (c-bloblet op i xs e depth c) (c-done c tail)))
        ;; The tag, the handler, and the body as a procedure of nothing; then
        ;; the routine that runs it under the prompt.
        (x-prompt (t body h a)
          (begin (c-exp t e depth c #f)
                 (c-exp h e (i64+ depth 1) c #f)
                 (c-lambda nil body e (i64+ depth 2) c nil nil)
                 (c-op c "prompt")
                 (c-done c tail)))
        ;; The region's name bound in a slot, as a `let`'s, to a region
        ;; entered (an arena, or a reap), and left with the body's value,
        ;; which is so not in tail position.
        (x-region (k r body a)
          (if (or (i64= k 0) (i64= k 3))
              ;; A region for analysis only: nothing at run time.
              (c-exp body e depth c tail)
              (begin
                (c-prim c (if (i64= k 1) "%region-enter" "%reap-enter") 0)
                (c-exp body (c-extend r (at-slot depth) e) (i64+ depth 1) c #f)
                (c-prim c "%region-exit" 2)
                (c-done c tail))))
        (x-app (f args a)
          (tagcase f
            ;; A lambda applied at once: a `let`.
            (x-lambda (ps body b)
              (if (i64= (size ps) (size args))
                  (c-let (map2 (lambda ((p string) (y cx)) (cbind p y)) ps args) body e depth c tail)
                  (c-app f args e depth c tail a)))
            (else y (c-app f args e depth c tail a))))
        (x-if (t th el a)
          (let ((no (c-fresh)) (end (c-fresh)))
            (begin
              (c-exp t e depth c #f)
              (c-emit c (it-zbranch no))
              (c-exp th e depth c tail)
              (if tail #u (c-emit c (it-branch end)))
              (c-emit c (it-label no))
              (c-exp el e depth c tail)
              (c-emit c (it-label end)))))
        (x-let (bs body a) (c-let bs body e depth c tail))
        (x-letrec (bs body a) (c-letrec bs body e depth c tail))
        (x-begin (es a) (c-begin es e depth c tail))
        (x-proj (x a) (c-exp x e depth c tail))
        (x-product (fs a)
          (begin (c-int c 37)
                 (c-prim c "%make-frozen" (i64+ 1 (c-exps (c-bound-exps fs) e (i64+ depth 1) c)))
                 (c-done c tail)))
        (x-extract (p i a) (begin (c-exp p e depth c #f) (c-field c (i64+ i 2)) (c-done c tail)))
        (x-sum (t v a)
          (begin (c-int c 36) (c-lit c (l-sym t)) (c-exp v e (i64+ depth 2) c #f)
                 (c-prim c "%make-frozen" 3) (c-done c tail)))
        (x-tagcase (s arms els k a)
          ;; Of a flat sum, its tag read once, as a label, into the slot
          ;; after it (Fixpt's `c-tagcase`).
          (let ((end (c-fresh)))
            (begin (c-exp s e depth c #f)
                   (if (i64< k 0)
                       (c-arms arms els e depth c tail end)
                       (begin (c-op1 c "slot" (o-int depth)) (c-int c k) (c-prim c "%fx26-flat-tag" 2)
                              (c-flat-arms arms els k e depth c tail end)))
                   (c-emit c (it-label end)))))
        (x-module (its a) (c-module its e depth c tail))
        (x-with (m ns ks body a)
          (let* ((fv (c-free body nil nil))
                 (inner (c-with-fields m ns ks fv e e depth c))
                 (n (size (filter (lambda ((k string)) (string-member? k fv)) ns))))
            (begin (c-exp body inner (i64+ depth n) c tail) (c-unbind c depth n tail))))
        (x-reshape (y ps a)
          ;; The module, then a product of the values wanted, in their order,
          ;; in its slot.
          (begin (c-exp y e depth c #f)
                 (c-int c 37)
                 (c-reshape-fields c depth ps)
                 (c-prim c "%make-frozen" (i64+ 1 (size ps)))
                 (c-op1 c "slot!" (o-int depth))
                 (c-done c tail))))))

  ;; A bloblet's or a blobref's operation (Fixpt's `c-bloblet`): its
  ;; runtime primitive, with what the checker found it takes.
  (c-bloblet (subr gen (string i64 cxs cenv i64 code) unit)
    (lambda (op i xs e depth c)
      (cond ((string=? op "make-bloblet") (c-prim c "%make-bloblet" (c-exps xs e depth c)))
            ((string=? op "rmake-bloblet") (c-prim c "%region-make-bloblet" (c-exps xs e depth c)))
            ((string=? op "bloblet-ref") (begin (c-exps xs e depth c) (c-field c (i64+ i 2))))
            ((string=? op "bloblet-set!")
             (begin (c-exp (car xs) e depth c #f) (c-int c (i64+ i 2)) (c-exp (second-cx xs) e (i64+ depth 2) c #f)
                    (c-prim c "%bloblet-set!" 3) (c-unit-after c)))
            ((string=? op "bloblet-freeze")
             (begin (c-exps xs e depth c) (c-op c "dup") (c-lit c (l-bool #t)) (c-lit c (l-bool #f))
                    (c-prim c "%bloblet-freeze!" 3) (c-op c "drop")))
            ((string=? op "bloblet-byte") (c-prim c "%bloblet-byte" (c-exps xs e depth c)))
            ((string=? op "bloblet-set-byte!") (begin (c-prim c "%bloblet-set-byte!" (c-exps xs e depth c)) (c-unit-after c)))
            ((string=? op "bloblet-bytes") (c-prim c "%bloblet-bytes" (c-exps xs e depth c)))
            ((string=? op "blobref-at") (begin (c-prim c "%suffix-ref" (c-exps xs e depth c)) (c-fits c i)))
            ((string=? op "blobref+") (begin (c-prim c "%suffix-ref+" (c-exps xs e depth c)) (c-fits c i)))
            ((string=? op "%blobref-field") (begin (c-exp (car xs) e depth c #f) (c-int c i) (c-prim c "%suffix-ref+" 2)))
            ((string=? op "blobref-owner") (c-prim c "%suffix-ref-owner" (c-exps xs e depth c)))
            ((string=? op "blobref-offset") (c-prim c "%suffix-ref-offset" (c-exps xs e depth c)))
            ((string=? op "blobref-get") (begin (c-exp (car xs) e depth c #f) (c-int c i) (c-prim c "%fx26-suffix-ref-get" 2)))
            ((string=? op "blobref-length") (begin (c-exp (car xs) e depth c #f) (c-int c i) (c-prim c "%fx26-suffix-ref-length" 2)))
            ((string=? op "blobref-index") (begin (c-exps xs e depth c) (c-int c i) (c-prim c "%fx26-suffix-ref-index" 3)))
            (else
             (begin (c-exp (car xs) e depth c #f) (c-int c i) (c-exp (second-cx xs) e (i64+ depth 2) c #f)
                    (c-prim c (if (string=? op "blobref-set!") "%fx26-suffix-ref-set!" "%fx26-flat-variant!") 3))))))

  ;; `with`'s values in slots from `depth`: each of `ns` the body names, in
  ;; order, field `k` of the module `m`, which is loaded again for each.
  (c-with-fields (subr gen (cx strings (listof i64 acyclic) strings cenv cenv i64 code) cenv)
    (lambda (m ns ks fv outer inner depth c)
      (cond ((null? ns) inner)
            ((string-member? (car ns) fv)
             (begin (c-exp m outer depth c #f)
                    (c-field c (i64+ (car ks) 2))
                    (c-with-fields m (cdr ns) (cdr ks) fv outer (c-extend (car ns) (at-slot depth) inner) (i64+ depth 1) c)))
            (else (c-with-fields m (cdr ns) (cdr ks) fv outer inner depth c)))))

  ;; A module (`first-class-modules.md`): its items made in slots in order
  ;; from `depth`, as a `letrec*`'s; then the product of the values it gives.
  (c-module (subr gen ((listof cmem acyclic) cenv i64 code bool) unit)
    (lambda (its e depth c tail)
      (let* ((later (c-module-slots its depth))
             (given (c-module-make its e depth later nil nil c)))
        (begin (c-int c 37)
               (c-slots-load c (reverse given))
               (c-prim c "%make-frozen" (i64+ 1 (size given)))
               (c-done c tail)
               (c-unbind c depth (size its) tail)))))

  ;; Items `its` made from slot `d`, `later` theirs, `ws` the closures
  ;; waiting for one, `given` the slots of those the module gives, the
  ;; newest first: those, at the end.
  (c-module-make (subr gen ((listof cmem acyclic) cenv i64 (listof centry acyclic) (listof wait acyclic) (listof i64 acyclic) code)
                       (listof i64 acyclic))
    (lambda (its e d later ws given c)
      (if (null? its)
          given
          (tagcase (car its)
            (cmem (n x k lam at)
              (let* ((ps (if (and lam (c-names-any? x later))
                             (tagcase (car (lambda-of x))
                               (lparts (qs body region)
                                 (c-lambda qs body (c-module-own n e later body (size qs)) d c (list n) region)))
                             (begin (c-exp x e d c #f) (the patches nil))))
                     (waits (onto ws (map (lambda ((p patch)) (tagcase p (patch (j s) (wait d j s)))) ps))))
                (begin
                  (c-give-waiting c waits d)
                  (c-module-make (cdr its) (c-extend n (at-slot d) e) (i64+ d 1) (cdr later) waits
                                 (if (i64> k 0) (cons d given) given) c))))))))

  (c-begin (subr gen (cxs cenv i64 code bool) unit)
    (lambda (es e depth c tail)
      (cond ((null? es) (begin (c-lit c (l-unit)) (c-done c tail)))
            ((null? (cdr es)) (c-exp (car es) e depth c tail))
            (else (begin (c-exp (car es) e depth c #f) (c-op c "drop") (c-begin (cdr es) e depth c tail))))))

  ;; Each value pushed, in the scope outside; the names are the slots.
  (c-let-bind (subr gen (cbinds cenv cenv i64 code) cenv)
    (lambda (bs outer inner depth c)
      (if (null? bs)
          inner
          (tagcase (car bs)
            (cbind (n x)
              (begin (set c-bind-name (list n))
                     (c-exp x outer depth c #f)
                     (set c-bind-name nil)
                     (c-let-bind (cdr bs) outer (c-extend n (at-slot depth) inner) (i64+ depth 1) c)))))))

  (c-let (subr gen (cbinds cx cenv i64 code bool) unit)
    (lambda (bs body e depth c tail)
      (let* ((inner (c-let-bind bs e e depth c)) (n (size bs)))
        (begin (c-exp body inner (i64+ depth n) c tail) (c-unbind c depth n tail)))))

  (c-letrec (subr gen (cbinds cx cenv i64 code bool) unit)
    (lambda (bs body e depth c tail)
      (let* ((made (c-letrec-make bs bs e depth 0 c)) (n (size bs)))
        (begin
          (c-letrec-patch made depth 0 c)
          (c-exp body (c-letrec-slots bs e depth) (i64+ depth n) c tail)
          (c-unbind c depth n tail)))))

  ;; Each closure made, in order; what each must have patched.
  (c-letrec-make (subr gen (cbinds cbinds cenv i64 i64 code) (listof patches acyclic))
    (lambda (all bs e depth i c)
      (if (null? bs)
          nil
          (tagcase (car bs)
            (cbind (name x)
              (if (null? (lambda-of x))
                  (begin (cg-fail "a letrec binds only lambdas") nil)
                  (tagcase (car (lambda-of x))
                    (lparts (ps body region)
                      (let* ((made (c-lambda ps body (c-letrec-own all e depth 0 i body (size ps)) (i64+ depth i) c (list name) region))
                             (rest (c-letrec-make all (cdr bs) e depth (i64+ i 1) c)))
                        (cons made rest))))))))))

  ;; A lambda: its free values pushed, then its word closed over them; with
  ;; a region (an `rlambda`'s, one or none), that region first, and the
  ;; closure made there by `%region-closure`. `own` is the `letrec` name it
  ;; is bound to, or none: its tail calls in its body are loops.
  (c-lambda (subr gen (strings cx cenv i64 code strings cxs) patches)
    (lambda (ps body e depth c own0 region)
      (begin
        (if (null? region) #u (c-exp (car region) e depth c #f))
        (tagcase (c-lambda-word ps body e own0)
          (cclosing (w fv)
            (let ((ps2 (c-push-all fv e 0 c)))
              (begin (if (null? region)
                         (c-emit c (it-ins "closure" (list (o-word w) (o-int (size fv)))))
                         (begin (c-lit c (l-word w)) (c-prim c "%region-closure" (i64+ 2 (size fv)))))
                     ps2)))))))

  ;; A lambda's word, and the names its closure captures, in order.
  (c-lambda-word (subr gen (strings cx cenv strings) cclosing)
    (lambda (ps body e own0)
      (let* ((named (c-take c-word-name))
             (bound (c-take c-bind-name))
             (fv (c-captured (c-free body ps nil) e))
             (own (c-own-of ps own0))
             (inner (c-inner-env fv (c-param-env ps 0 (c-own-scope own fv e)) 0))
             (n (size ps))
             (body-code (the code (new nil)))
             (outer (c-this-saved)) (outer-start (get c-this-start))
             (me (c-this-of own inner n))
             (base (c-word-base named own0 bound))
             (outer-scope (get c-scope-name)))
        (begin
          (set c-scope-name (list base))
          (if (null? me)
              (set c-this-params -1)
              (let ((start (c-fresh))) (begin (c-this-enter! (car me) start) (c-emit body-code (it-label start)))))
          (c-exp body inner n body-code #t)
          (c-this-enter! outer outer-start)
          (let ((w (c-assemble body-code (c-word-symbol base named body))))
            (begin (set c-scope-name outer-scope) (cclosing w fv)))))))

  ;;; applications
  (c-app (subr gen (cx cxs cenv i64 code bool i64) unit)
    (lambda (f args e depth c tail a)
      (if (c-self-call? f args e tail)
          ;; A loop: the arguments into the parameters' slots, the rest of
          ;; the frame dropped, and back to the start.
          (begin (c-exps args e depth c)
                 (c-loop-stores c (i64- (get c-this-params) 1))
                 (c-drops c (i64- depth (get c-this-params)))
                 (c-emit c (it-branch (get c-this-start))))
          (let ((standard (c-standard-name f e)))
            (cond ((string=? standard "")
                   (let ((n (c-exps args e depth c)))
                     (begin (c-exp f e (i64+ depth n) c #f)
                            (c-op1 c (cond ((cg-fx-call? a (get cg-fx-calls)) (if tail "tailcall" "call"))
                                           (tail "ttailcall")
                                           (else "tcall"))
                                   (o-int n)))))
                  ((and (string=? standard "%quote") (i64= (size args) 1) (not (null? (c-quoted-cell (car args)))))
                   (begin (c-lit c (car (c-quoted-cell (car args)))) (c-done c tail)))
                  ;; Else built as written, then interned (TODO §51).
                  ((string=? standard "%quote")
                   (begin (c-exp (car args) e depth c #f) (c-prim c "%fx26-intern-datum" 1) (c-done c tail)))
                  ((and tail (string=? standard "with-mark"))
                   (begin (c-exps args e depth c) (c-op c "withmark-tail")))
                  ((string=? standard "make-array")
                   (begin (c-int c 0) (c-exps args e (i64+ depth 1) c) (c-prim c "%make-bloblet-filled" 3) (c-done c tail)))
                  (else (begin (c-standard-on standard (c-exps args e depth c) c) (c-done c tail))))))))

  ;;; tagcase
  ;; A flat sum's arms (Fixpt's `c-flat-arms`): each name a blobref to its
  ;; variant, `k / 256` bytes along; no arm for the tag a failure.
  (c-flat-arms (subr gen ((listof carm acyclic) cbinds i64 cenv i64 code bool i64) unit)
    (lambda (arms els k e depth c tail end)
      (if (null? arms)
          (begin
            (if (null? els)
                (begin (c-op1 c "slot" (o-int (i64+ depth 1))) (c-prim c "%fx26-flat-no-arm" 1) (c-done c tail))
                (tagcase (car els)
                  (cbind (n x) (c-exp x (c-extend n (at-slot depth) e) (i64+ depth 2) c tail))))
            (c-unbind c depth 2 tail))
          (tagcase (car arms)
            (carm (tag whole ns body)
              (let ((next (c-fresh)))
                (begin
                  (c-op1 c "slot" (o-int (i64+ depth 1)))
                  (c-lit c (if (i64= (i64-remainder (i64-quotient k 8) 2) 1)
                               (l-int (i64->int (digits-i64 (string-chars tag) 0)))
                               (l-sym tag)))
                  (c-op c "eq")
                  (c-emit c (it-zbranch next))
                  (c-op1 c "slot" (o-int depth))
                  (c-int c (i64-quotient k 256))
                  (c-prim c "%suffix-ref+" 2)
                  (c-exp body (c-extend (car ns) (at-slot (i64+ depth 2)) e) (i64+ depth 3) c tail)
                  (c-unbind c depth 3 tail)
                  (if tail #u (c-emit c (it-branch end)))
                  (c-emit c (it-label next))
                  (c-flat-arms (cdr arms) els k e depth c tail end))))))))

  (c-arms (subr gen ((listof carm acyclic) cbinds cenv i64 code bool i64) unit)
    (lambda (arms els e depth c tail end)
      (if (null? arms)
          (if (null? els)
              ;; A checked program covers every tag; this is never reached.
              (begin (c-lit c (l-bool #f)) (c-int c 0) (c-op c "field@") (c-done c tail))
              (tagcase (car els)
                (cbind (n x)
                  (begin (c-exp x (c-extend n (at-slot depth) e) (i64+ depth 1) c tail) (c-unbind c depth 1 tail)))))
          (tagcase (car arms)
            (carm (tag whole ns body)
              (let ((next (c-fresh)))
                (begin
                  ;; Is the tag this arm's?
                  (c-op1 c "slot" (o-int depth))
                  (c-field c 2)
                  (c-lit c (l-sym tag))
                  (c-op c "eq")
                  (c-emit c (it-zbranch next))
                  ;; The value, or its product's members, as slots after the sum.
                  (c-op1 c "slot" (o-int depth))
                  (c-field c 3)
                  (let ((bound (if whole (c-members ns e depth (i64+ depth 2) 0 c) (c-extend (car ns) (at-slot (i64+ depth 1)) e)))
                        (k (if whole (i64+ 1 (size ns)) (the i64 1))))
                    (begin
                      (c-exp body bound (i64+ depth (i64+ 1 k)) c tail)
                      (c-unbind c depth (i64+ k 1) tail)
                      (if tail #u (c-emit c (it-branch end)))))
                  (c-emit c (it-label next))
                  (c-arms (cdr arms) els e depth c tail end)))))))))

;;; ------------------------------------------------------------ programs

(define c-push-global! (subr gen (string) unit) (lambda (n) (set cg-globals (cons n (get cg-globals)))))

"The next lambda's word named for global `n`, when `x`, its definition, is
 a lambda."
(define c-name-for! (subr gen (string cx) unit)
  (lambda (n x) (tagcase x (x-lambda (ps body a) (set c-word-name (list n))) (else y #u))))

(define-rec
  (c-rec-globals! (subr gen (cbinds) unit)
    (lambda (bs) (if (null? bs) #u (tagcase (car bs) (cbind (n x) (begin (c-push-global! n) (c-rec-globals! (cdr bs)))))))))

"Each of a `define-rec`'s values made, and its global set."
(define-rec
  (c-rec-fill! (subr gen (cbinds code) unit)
    (lambda (bs c)
      (if (null? bs) #u
          (tagcase (car bs)
            (cbind (n x)
              (begin (c-name-for! n x) (c-exp x nil 0 c #f) (c-op1 c "global!" (o-global n)) (c-rec-fill! (cdr bs) c))))))))

(define-rec
  (parse-tops (subr gen (sexps) (listof ctop acyclic))
    (lambda (fs) (if (null? fs) nil (let ((t (parse-top (car fs)))) (onto t (parse-tops (cdr fs))))))))

"Each form in turn; the last expression's value is left on the stack."
(define-rec
  (c-tops (subr gen ((listof ctop acyclic) code bool) bool)
    (lambda (ts c has-value)
      (if (null? ts)
          has-value
          (tagcase (car ts)
            (t-define (n typed x)
              (begin
                (if has-value (c-op c "drop") #u)
                (tagcase x
                  ;; A lambda written with its type: its global first, so
                  ;; that it can call itself through it.
                  (x-lambda (ps body a)
                    (if typed
                        (begin (c-push-global! n) (set c-word-name (list n))
                               (c-lambda ps body nil 0 c nil nil) (c-op1 c "global!" (o-global n)))
                        (begin (c-exp x nil 0 c #f) (c-push-global! n) (c-op1 c "global!" (o-global n)))))
                  (else y (begin (c-exp x nil 0 c #f) (c-push-global! n) (c-op1 c "global!" (o-global n)))))
                (c-tops (cdr ts) c #f)))
            ;; Every name's global first; then each lambda, which runs nothing.
            (t-define-rec (bs)
              (begin
                (if has-value (c-op c "drop") #u)
                (c-rec-globals! bs)
                (c-rec-fill! bs c)
                (c-tops (cdr ts) c #f)))
            (t-exp (x) (begin (if has-value (c-op c "drop") #u) (c-exp x nil 0 c #f) (c-tops (cdr ts) c #t)))
            (t-none () (c-tops (cdr ts) c has-value)))))))

"A program's one word, which runs it and leaves the value of its last
 expression (unit, if it has none), and the words it makes."
(define compile-cells (subr gen (sexps facts) unit)
  (lambda (forms fs)
    (let ((c (the code (new nil))))
      (begin
        (set cg-facts fs)
        (set cg-convert-facts
             (filter (lambda ((x fact)) (tagcase x (fact (f p what) (or (has-prefix? what "convert ") (has-prefix? what "convention "))))) fs))
        (set cg-fx-calls nil)
        (set cg-module-facts
             (filter (lambda ((x fact)) (tagcase x (fact (f p what) (or (has-prefix? what "with-spec ") (has-prefix? what "module-arg ") (has-prefix? what "module-had ") (has-prefix? what "module-made ") (string=? what "module-value") (string=? what "with-value"))))) fs))
        (set cg-layouts nil)
        (set cg-included nil)
        (set cg-made nil)
        (set cg-words nil)
        (set cg-globals nil)
        (set cg-standard-words nil)
        (set c-this-params -1)
        (if (c-tops (parse-tops forms) c #f) #u (c-lit c (l-unit)))
        (c-op c "exit")
        (c-assemble c "program")
        #u))))

(define-rec
  (cells-of (subr kfx (citems i64) i64) (lambda (xs n) (if (null? xs) n (cells-of (cdr xs) (i64+ n (item-size (car xs)))))))
  (word-named (subr kfx ((listof word acyclic) string) (listof word acyclic))
    (lambda (ws n) (cond ((null? ws) nil) ((tagcase (car ws) (word (m xs) (string=? m n))) (list (car ws))) (else (word-named (cdr ws) n))))))

"The listing: from `program`, each word reached, as `disasm.rs` walks
 them: the words a word names pushed in order, the last pushed next."
(define-rec
  (listing-from (subr gen (strings strings string) string)
    (lambda (todo seen out)
      (cond ((null? todo) out)
            ((string-member? (car todo) seen) (listing-from (cdr todo) seen out))
            (else
             (let ((w (word-named (get cg-words) (car todo))))
               (if (null? w)
                   (listing-from (cdr todo) (cons (car todo) seen) out)
                   (tagcase (car w)
                     (word (name xs)
                       (tagcase (lines-of-items xs 0 (places-of xs 0 nil) nil nil)
                         (wsaid (text named)
                           (listing-from (onto (reverse named) (cdr todo)) (cons name seen)
                                         (string-append out (string-append "\nword " (string-append (shown-name name) (string-append " (" (string-append (i64->string (cells-of xs 0)) (string-append " cells, cellular):\n" text))))))))))))))))))

(define cells-listing (subr gen () string) (lambda () (listing-from (list "program") nil "")))
