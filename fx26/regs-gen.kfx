"regs-gen.kfx: register code's expressions' compiler (C248), the fifth of
 its layers (`docs/research/register-code.md`), as Fixpt's
 `regcode-core.fx`, `regcode-helpers.fx` and `regcode-places.fx` make
 theirs, decision for decision, so that the code is Fixpt's. Unlike
 theirs, its state is not globals set and restored around calls but what
 it is given: `rgen`, what is being made, and in it `rctx`, what the
 body assumes. What it does not do yet it declines, in one place each
 (`r-decline`), and the lambda keeps its stack code alone.

 Stage 1 (the plan's): variables, constants, `if` and its tests, `begin`,
 `let`, standard operations, calls, the procedure's calls of itself and
 loops, a leaf's tail calls. Stage 2 (C253): closures, `letrec`,
 `tagcase`, prompts, `apply`, `list`. Stage 3 (C259): regions and
 closures made in them, bloblets and blobrefs, flat sums' `tagcase`,
 modules, `with` and reshaping. Stage 4 (C260): calls of a procedure
 specialized at the lambda given, and a copy's own calls. Declined, as
 Fixpt's are: what a leaf cannot make without a frame, more registers than
 there are."

;;; ------------------------------------------------- the globals' writes

"How many times each global has been written once the forms compiled so
 far have run, and the globals the form being compiled writes: what a
 `global-guard` made now expects (Fixpt's `c-writes-expected`). By name,
 as tier 1 keeps its globals."
(define-datatype gwrites (gwrites string i64))
(define cg-writes (ref (listof gwrites acyclic) @g) (new nil))
(define cg-form-writes (ref strings @g) (new nil))

(define-rec
  (writes-of (subr kfx ((listof gwrites acyclic) string) i64)
    (lambda (ws n) (cond ((null? ws) 0) ((tagcase (car ws) (gwrites (m k) (string=? m n))) (tagcase (car ws) (gwrites (m k) k))) (else (writes-of (cdr ws) n)))))
  (count-in (subr kfx (strings string i64) i64)
    (lambda (xs n k) (cond ((null? xs) k) ((string=? (car xs) n) (count-in (cdr xs) n (i64+ k 1))) (else (count-in (cdr xs) n k)))))
  (without-one (subr kfx (strings string) strings)
    (lambda (xs n) (cond ((null? xs) xs) ((string=? (car xs) n) (cdr xs)) (else (cons (car xs) (without-one (cdr xs) n)))))))

(define writes-expected (subr gen (string) i64)
  (lambda (n) (count-in (get cg-form-writes) n (writes-of (get cg-writes) n))))

"A `global!` of `n` emitted: once it runs, `n` written once more."
(define c-wrote! (subr gen (string) unit)
  (lambda (n)
    (begin (set cg-writes (cons (gwrites n (i64+ 1 (writes-of (get cg-writes) n))) (get cg-writes)))
           (set cg-form-writes (without-one (get cg-form-writes) n)))))

;;; ------------------------------------------------------ what is made

"What the body being made assumes (Fixpt's globals `r-declined`,
 `r-assuming`, `r-assumed`, `r-looped`, `r-own-name`, `r-own-now`):
 whether it has been declined; whether it is a fast version; the globals
 it assumes hold what they held, newest first; whether a call of itself
 was made a loop; its definition's global, its arity and its start's
 label (\"\", -1, -1 if none)."
;; In a copy (C260), what it is specialized as, where the parameter the
;; lambda is is, and the label where the copy starts.
(define-datatype rctx (rctx (ref bool @g) bool (ref strings @g) (ref bool @g) string i64 i64 (ref i64 @g) (listof rspec acyclic) (ref rlocs @g) i64))

"What is being made: its items, newest first; whether a leaf; the next
 register and frame slot, and the most slots used; the labels; what the
 procedure knows of itself, and its start's label; and the context."
(define-datatype rgen (rgen (ref ritems @g) bool (ref i64 @g) (ref i64 @g) (ref i64 @g) (ref i64 @g) rthis i64 rctx))

(define g-items (subr kfx (rgen) (ref ritems @g)) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) xs))))
(define g-leaf (subr kfx (rgen) bool) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) leaf))))
(define g-nreg (subr kfx (rgen) (ref i64 @g)) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) nr))))
(define g-nslot (subr kfx (rgen) (ref i64 @g)) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) ns))))
(define g-mslot (subr kfx (rgen) (ref i64 @g)) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) ms))))
(define g-labels (subr kfx (rgen) (ref i64 @g)) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) ls))))
(define g-this (subr kfx (rgen) rthis) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) me))))
(define g-start (subr kfx (rgen) i64) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) st))))
(define g-ctx (subr kfx (rgen) rctx) (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) cx))))

(define x-declined (subr kfx (rctx) (ref bool @g)) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) d))))
(define x-assuming (subr kfx (rctx) bool) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) a))))
(define x-assumed (subr kfx (rctx) (ref strings @g)) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) as))))
(define x-looped (subr kfx (rctx) (ref bool @g)) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) l))))
(define x-own (subr kfx (rctx) string) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) o))))
(define x-own-arity (subr kfx (rctx) i64) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) k))))
(define x-own-start (subr kfx (rctx) i64) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) s))))
"The source position of the expression being compiled (C249), 0 if none."
(define x-at (subr kfx (rctx) (ref i64 @g)) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) at))))

"In a copy, the copy being made (one or none); where the parameter the
 lambda is is (one or none); the label where the copy starts (C260)."
(define x-spec (subr kfx (rctx) (listof rspec acyclic)) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) sp))))
(define x-spec-at (subr kfx (rctx) (ref rlocs @g)) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) sa))))
(define x-spec-start (subr kfx (rctx) i64) (lambda (x) (tagcase x (rctx (d a as l o k s at sp sa ss) ss))))

"What the analyses are told of the body (`rview`)."
(define g-view (subr kfx (rgen) rview)
  (lambda (g) (let ((x (g-ctx g))) (rview (x-assuming x) #f (x-own x) (x-own-arity x)))))

(define r-decline (subr gen (rgen) unit) (lambda (g) (set (x-declined (g-ctx g)) #t)))
(define r-declined? (subr gen (rgen) bool) (lambda (g) (get (x-declined (g-ctx g)))))

;;; -------------------------------------------------------------- emitting

(define r-emit (subr gen (rgen ritem) unit) (lambda (g x) (set (g-items g) (cons x (get (g-items g))))))
(define r-ins (subr gen (rgen string (listof opnd acyclic)) unit) (lambda (g name os) (r-emit g (ri-op name os))))
(define r-op0 (subr gen (rgen string) unit) (lambda (g name) (r-ins g name nil)))
(define r-opn (subr gen (rgen string i64) unit) (lambda (g name n) (r-ins g name (list (o-int n)))))
(define r-opnn (subr gen (rgen string i64 i64) unit) (lambda (g name n m) (r-ins g name (list (o-int n) (o-int m)))))
(define r-const (subr gen (rgen lit) unit) (lambda (g l) (r-ins g "const" (list (o-lit l)))))
(define r-op2imm (subr gen (rgen string lit) unit) (lambda (g r l) (r-ins g "op2imm" (list (o-prim r) (o-lit l)))))
(define r-unit (subr gen (rgen) unit) (lambda (g) (r-const g (l-unit))))
(define r-negate (subr gen (rgen) unit) (lambda (g) (r-op2imm g "eq" (l-bool #f))))
"`k` added to RESULT, as an immediate; nothing, if 0."
(define r-add-imm (subr gen (rgen int) unit)
  (lambda (g k) (cond ((> k 0) (r-op2imm g "int-add" (l-int k))) ((< k 0) (r-op2imm g "int-sub" (l-int (- 0 k)))) (else #u))))

(define r-new-label (subr gen (rgen) i64)
  (lambda (g) (let ((n (get (g-labels g)))) (begin (set (g-labels g) (i64+ n 1)) n))))
(define r-reg (subr gen (rgen) i64)
  (lambda (g)
    (let ((n (i64+ (get (g-nreg g)) 1)))
      (begin (set (g-nreg g) n) (if (i64> n register-regs) (r-decline g) #u) n))))
(define r-slot (subr gen (rgen) i64)
  (lambda (g)
    (let ((n (get (g-nslot g))))
      (begin (set (g-nslot g) (i64+ n 1))
             (if (i64> (i64+ n 1) (get (g-mslot g))) (set (g-mslot g) (i64+ n 1)) #u)
             n))))
"The registers and frame slots taken since there were `regs` and `slots`,
 free again."
(define r-restore (subr gen (rgen i64 i64) unit)
  (lambda (g regs slots) (begin (set (g-nreg g) regs) (set (g-nslot g) slots))))
(define r-leave (subr gen (rgen) unit) (lambda (g) (if (g-leaf g) #u (r-emit g (ri-frame "pop")))))
(define r-done (subr gen (rgen bool) unit) (lambda (g tail) (if tail (begin (r-leave g) (r-op0 g "return")) #u)))
(define r-const-value (subr gen (rgen lit bool) unit) (lambda (g l tail) (begin (r-const g l) (r-done g tail))))

(define r-keep-in-reg (subr gen (rgen) i64) (lambda (g) (let ((r (r-reg g))) (begin (r-opn g "setreg" r) r))))
(define r-keep-in-slot (subr gen (rgen) i64) (lambda (g) (let ((s (r-slot g))) (begin (r-opn g "setstk" s) s))))
(define r-keep (subr gen (rgen bool) rloc) (lambda (g reg) (if reg (rl-reg (r-keep-in-reg g)) (rl-slot (r-keep-in-slot g)))))
(define r-place-value (subr gen (rgen) rloc) (lambda (g) (r-keep g (g-leaf g))))
(define r-get (subr gen (rgen rloc) unit)
  (lambda (g l) (tagcase l (rl-reg (r) (r-opn g "reg" r)) (rl-slot (s) (r-opn g "stack" s)) (else y #u))))
(define r-slot-move (subr gen (rgen i64 i64) unit) (lambda (g from to) (begin (r-opn g "stack" from) (r-opn g "setstk" to))))
(define r-const-into (subr gen (rgen lit i64) unit) (lambda (g l k) (begin (r-const g l) (r-opn g "setreg" k))))
(define r-lexical-into (subr gen (rgen i64 i64) unit) (lambda (g i k) (begin (r-opn g "lexical" i) (r-opn g "setreg" k))))
(define-rec
  (r-emit-all (subr gen (rgen ritems) unit) (lambda (g xs) (if (null? xs) #u (begin (r-emit g (car xs)) (r-emit-all g (cdr xs)))))))

"A call's convention (Fixpt's `r-conv-of`), by its callee's type: native
 (2), called with no look; `fx`, or a composable continuation, which may
 be of either (0, a call that looks); else cellular (1), as the stack
 compiler's `tcall`."
(define r-conv-at (subr gen (i64) i64)
  (lambda (a) (cond ((cg-fx-call? a (get cg-native-calls)) 2) ((cg-fx-call? a (get cg-fx-calls)) 0) (else 1))))
(define r-invoke (subr gen (rgen i64 bool i64) unit)
  (lambda (g n tail conv) (if tail (begin (r-leave g) (r-opnn g "tailinvoke" n conv)) (r-opnn g "invoke" n conv))))

"The guard of a call of `cell`'s procedure: to `call` unless the global
 has not been written since."
(define r-guard (subr gen (rgen string i64) unit)
  (lambda (g cell call) (r-emit g (ri-guard cell (writes-expected cell) call))))
"Whether the body is its fast version, which assumes what the guard would
 test: if so, the assumption noted, for its guard at the start."
(define r-assume (subr gen (rgen string) bool)
  (lambda (g cell)
    (let ((x (g-ctx g)))
      (if (x-assuming x)
          (begin (if (string-member? cell (get (x-assumed x))) #u (set (x-assumed x) (cons cell (get (x-assumed x))))) #t)
          #f))))

;;; ------------------------------------------------------------ analyses

(define r-collects-here? (subr gen (rgen cx cenv bool) bool)
  (lambda (g x te tail) (and (not (g-leaf g)) (r-collects (g-view g) x te (g-this g) tail))))

(define r-local (subr kfx (cenv string) cenv) (lambda (te n) (c-extend n (at-slot -1) te)))
(define-rec
  (r-bind-all (subr kfx (renv renv) renv) (lambda (bound env) (if (null? bound) env (r-bind-all (cdr bound) (cons (car bound) env)))))
  (r-local-all (subr kfx (renv cenv) cenv)
    (lambda (bound te) (if (null? bound) te (r-local-all (cdr bound) (tagcase (car bound) (rbind (n l) (r-local te n)))))))
  (r-local-names (subr kfx (cenv cbinds) cenv)
    (lambda (te bs) (if (null? bs) te (r-local-names (tagcase (car bs) (cbind (n x) (r-local te n))) (cdr bs))))))

(define r-half-regs i64 (i64-quotient register-regs 2))
(define-rec
  (r-repeat (subr kfx (bool i64 (listof bool acyclic)) (listof bool acyclic))
    (lambda (b n acc) (if (i64= n 0) acc (r-repeat b (i64- n 1) (cons b acc)))))
  (r-budget (subr kfx ((listof bool acyclic) i64) (listof bool acyclic))
    (lambda (fs next)
      (cond ((null? fs) nil)
            ((and (car fs) (i64< next r-half-regs)) (cons #t (r-budget (cdr fs) (i64+ next 1))))
            (else (cons #f (r-budget (cdr fs) next)))))))

"Each of `inits`' flags, onto `after`: set where nothing after it calls;
 and whether nothing from the first on calls."
(define-datatype rflags (rflags (listof bool acyclic) bool))
(define-rec
  (r-free-flags (subr gen (rview cxs cenv rthis bool (listof bool acyclic)) rflags)
    (lambda (v inits te me free after)
      (if (null? inits)
          (rflags after free)
          (tagcase (r-free-flags v (cdr inits) te me free after)
            (rflags (fs mine) (rflags (cons mine fs) (and mine (not (r-collects v (car inits) te me #f))))))))))

"For values bound in turn, the first made by `inits`, then `m` more made
 without a call, seen by a body that calls or not: whether each is kept
 in a register (Fixpt's `r-in-regs`). In a leaf, each is; else one is
 where nothing after it calls, so many as leave half the registers."
(define r-in-regs (subr gen (rgen cxs i64 cenv bool) (listof bool acyclic))
  (lambda (g inits m te body-collects)
    (if (g-leaf g)
        (r-repeat #t (i64+ (size inits) m) nil)
        (let ((free (not body-collects)))
          (tagcase (r-free-flags (g-view g) inits te (g-this g) free (r-repeat free m nil))
            (rflags (fs any) (r-budget fs (get (g-nreg g)))))))))

"`x` as `core + k`: the one operand of a chain of `+`, and of `-` of
 constants, that is not a constant (none if all are), and the constants'
 sum, under 2^30 in size."
(define-datatype rsplit (rsplit cxs int))
(define-rec
  (r-split (subr gen (renv cx) rsplit)
    (lambda (env x)
      (let* ((c (r-known env x)) (small (if (null? c) nil (r-const-small (car c)))))
        (if (not (null? small))
            (rsplit nil (car small))
            (let ((s (tagcase x (x-app (f args a) (r-split-app env (r-standard-name env f) args)) (else y nil))))
              (if (null? s) (rsplit (list x) 0) (car s)))))))
  (r-split-app (subr gen (renv string cxs) (listof rsplit acyclic))
    (lambda (env name args)
      (if (or (not (i64= (size args) 2)) (not (r-add-name? name)))
          nil
          (tagcase (r-split env (car args))
            (rsplit (pa ka)
              (tagcase (r-split env (car (cdr args)))
                (rsplit (pb kb)
                  (let* ((plus (string=? name "+")) (k (if plus (+ ka kb) (- ka kb))))
                    (cond ((and plus (not (null? pa)) (not (null? pb))) nil)
                          ((and (not plus) (not (null? pb))) nil)
                          ((not (r-small? k)) nil)
                          (else (list (rsplit (if (null? pa) pb pa) k)))))))))))))
(define r-adds? (subr gen (renv cx) bool)
  (lambda (env e) (tagcase e (x-app (f args a) (and (i64= (size args) 2) (r-add-name? (r-standard-name env f)))) (else y #f))))
(define r-same-exp? (subr kfx (cx cx) bool) (lambda (a b) (i64= (cx-start a) (cx-start b))))
(define r-deeper? (subr kfx (cxs cx cx) bool)
  (lambda (core x y) (and (not (null? core)) (not (r-same-exp? (car core) x)) (not (r-same-exp? (car core) y)))))
(define r-free-operand? (subr gen (renv cx) bool) (lambda (env x) (or (r-simple? x) (not (null? (r-known env x))))))

"Names `r-identity-arg` tests against, made once (C264): a list written in place is
 made at each call."
(define r-identity-arg-names strings (list "+" "-" "*"))

"The operand an identity leaves (`x + 0`, `0 + x`, `x - 0`, `x * 1`,
 `1 * x`), in a list."
(define r-identity-arg (subr gen (renv string cxs) cxs)
  (lambda (env name args)
    (if (or (not (i64= (size args) 2)) (not (string-member? name r-identity-arg-names)))
        nil
        (let* ((x (car args)) (y (car (cdr args))) (a (r-known env x)) (b (r-known env y))
               (is (lambda ((c (listof rconst acyclic)) (n int)) (and (not (null? c)) (tagcase (car c) (rc-int (k) (= k n)) (else z #f))))))
          (cond ((and (string=? name "+") (is b 0)) (list x))
                ((and (string=? name "+") (is a 0)) (list y))
                ((and (string=? name "-") (is b 0)) (list x))
                ((and (string=? name "*") (is b 1)) (list x))
                ((and (string=? name "*") (is a 1)) (list y))
                (else nil))))))

(define r-plain-var-loc (subr gen (renv cx) rlocs) (lambda (env x) (r-var-loc env x)))
(define r-var-in-reg? (subr gen (renv cx) bool) (lambda (env x) (i64> (r-reg-of (r-plain-var-loc env x)) 0)))

"Whether `f` is the procedure running, called with its arity: its own
 name, still bound where the procedure knows itself to be."
(define r-self-known? (subr gen (rgen cx i64 cenv) bool)
  (lambda (g f nargs te)
    (tagcase f
      (x-var (n a)
        (let ((me (g-this g)))
          (and (not (null? me))
               (tagcase (car me)
                 (this (m at k)
                   (and (string=? m n) (i64= k nargs)
                        (let ((l (c-find te n))) (and (not (null? l)) (c-this-loc? (car l) at)))))))))
      (else y #f))))

"The global `f` names, in a list, when it is the procedure's own, called
 with its arity."
(define r-own-self (subr gen (rgen renv cx cxs) strings)
  (lambda (g env f args)
    (let ((x (g-ctx g)))
      (if (or (string=? (x-own x) "") (i64< (x-own-start x) 0) (not (i64= (size args) (x-own-arity x))))
          nil
          (tagcase f
            (x-var (m a)
              (if (string=? m (x-own x))
                  (let ((l (r-var-loc env f))) (if (and (not (null? l)) (tagcase (car l) (rl-global (c) #t) (else y #f))) (list m) nil))
                  nil))
            (else y nil))))))

;;; ------------------------------------------------------------- operands

"A call of global `f` taking `k` arguments, inlined (C252): its noted
 body, if `f` names one seen here, not already being inlined, in a list."
(define r-inlined (subr gen (renv cx i64) (listof rinline acyclic))
  (lambda (env f k)
    (tagcase f
      (x-var (n a)
        (if (std-marked? n)
            nil
            (let ((l (r-where env n)))
              (if (or (null? l) (not (null? (r-local-loc env (inlining-name n)))))
                  nil
                  (tagcase (car l)
                    (rl-global (c) (r-inline-named (get cg-inlines) n k (r-genv env)))
                    (else y nil))))))
      (else y nil))))

"How many bindings of `env` are named `n`."
(define-rec
  (r-count-named (subr kfx (renv string i64) i64)
    (lambda (env n k) (if (null? env) k (r-count-named (cdr env) n (tagcase (car env) (rbind (m l) (if (string=? m n) (i64+ k 1) k))))))))

"Whether any of `args` is a constant list (`nil`, as kayak knows them)."
(define-rec
  (r-any-const-list? (subr gen (renv cxs) bool)
    (lambda (env args)
      (and (not (null? args))
           (or (let ((k (r-known env (car args)))) (and (not (null? k)) (tagcase (car k) (rc-nil () #t) (else y #f))))
               (r-any-const-list? env (cdr args)))))))

"A call of global `f` on `args` unrolled (C252, Fixpt's `r-unrolled`):
 `f` noted to be unrolled, seen here, not unrolled 16 deep here, called
 with a constant list: its body, in a list."
(define r-unrolled (subr gen (renv cx cxs) (listof rinline acyclic))
  (lambda (env f args)
    (tagcase f
      (x-var (n a)
        (if (std-marked? n)
            nil
            (let ((l (r-where env n)))
              (if (or (null? l) (not (tagcase (car l) (rl-global (c) #t) (else y #f)))
                      (i64>= (r-count-named env (inlining-name n) 0) r-unroll-depth)
                      (not (r-any-const-list? env args)))
                  nil
                  (r-inline-named (get cg-unrolls) n (size args) (r-genv env))))))
      (else y nil))))

"An inlined body's environment: its parameters, `params`; what the body
 around folds and inlines already (`%const:` and `%inlining:`, C252); the
 globals it saw, `at` of them; and its own name, being inlined."
(define-rec
  (r-carried (subr kfx (renv renv) renv)
    (lambda (env acc)
      (if (null? env)
          acc
          (r-carried (cdr env)
                     (tagcase (car env)
                       (rbind (n l) (if (or (has-prefix? n "%const:") (has-prefix? n "%inlining:")) (cons (car env) acc) acc))))))))
(define r-inline-env (subr kfx (renv renv string i64) renv)
  (lambda (params env name at)
    (onto params (cons (rbind genv-name (rl-seen at)) (cons (rbind (inlining-name name) (rl-loop)) (r-carried env nil))))))

"A closure's free values as operands, and the patches it needs."
(define-datatype rfree (rfree rargs rpatches))
"A scope: a register environment and its stack one."
(define-datatype rscope (rscope renv cenv))
"A join point's place: its parameters' places and its label."
(define-datatype rplace (rplace rlocs i64))

"The moves of each free value of `fv` (from the `j`th) in a register into
 REGj+1, where it is not there already."
(define-rec
  (r-reg-moves (subr gen (strings renv i64) rmoves)
    (lambda (fv env j)
      (if (null? fv)
          nil
          (let ((l (r-where env (car fv))) (rest (r-reg-moves (cdr fv) env (i64+ j 1))))
            (if (null? l) rest (tagcase (car l) (rl-reg (r) (if (i64= r (i64+ j 1)) rest (cons (rmove r (i64+ j 1)) rest))) (else y rest))))))))

"`env` with each parameter at its place."
(define-rec
  (r-bind-places (subr kfx (renv strings rlocs) renv)
    (lambda (env ps ls) (if (or (null? ps) (null? ls)) env (r-bind-places (r-bind (car ps) (car ls) env) (cdr ps) (cdr ls))))))

"The join point `f` names, in a list: a local's."
(define r-join-of (subr kfx (renv cx) rlocs)
  (lambda (env f)
    (tagcase f
      (x-var (m a) (let ((l (r-local-loc env m))) (if (null? l) nil (tagcase (car l) (rl-join (ps label) l) (else y nil)))))
      (else y nil))))

"The `letrec`'s names where its body sees them: a join point as itself,
 any other in its slot; and to the stack compiler, a join point a loop."
(define-rec
  (r-letrec-env (subr kfx (cbinds (listof i64 acyclic) (listof (listof rplace acyclic) acyclic) renv) renv)
    (lambda (bs at places env)
      (if (null? bs)
          env
          (r-letrec-env (cdr bs) (cdr at) (cdr places)
                        (tagcase (car bs)
                          (cbind (n x)
                            (r-bind n (if (null? (car places)) (rl-slot (car at)) (tagcase (car (car places)) (rplace (locs label) (rl-join locs label)))) env)))))))
  (r-letrec-te (subr kfx (cbinds (listof bool acyclic) cenv) cenv)
    (lambda (bs joins te)
      (if (null? bs) te (r-letrec-te (cdr bs) (cdr joins) (tagcase (car bs) (cbind (n x) (c-extend n (if (car joins) (at-loop) (at-slot -1)) te))))))))

"A call's inlined parameters: where the body finds each, the body's scope,
 and the arguments for the call where the guard fails."
(define-datatype rbound (rbound renv cenv (listof rarg acyclic)))

"What `g` makes, for a body where the procedure running is not known."
(define r-unknowing (subr kfx (rgen) rgen)
  (lambda (g) (tagcase g (rgen (xs leaf nr ns ms ls me st cx) (rgen xs leaf nr ns ms ls nil st cx)))))

"An operand of a call or call-out: an expression, a constant, a frame
 slot's value, a free value of the closure running."
(define-datatype rarg (a-e cx) (a-v lit) (a-slot i64) (a-lexical i64)
  ;; A procedure of no arguments whose body is the expression (a prompt's).
  (a-thunk cx))
(define-type rargs (listof rarg acyclic))
(define r-exp-args (subr kfx (cxs) rargs) (lambda (es) (map (lambda ((x cx)) (a-e x)) es)))
(define r-arg-simple? (subr gen (rarg) bool) (lambda (a) (tagcase a (a-e (x) (r-simple? x)) (a-thunk (b) #f) (else y #t))))
(define r-arg-simple-here? (subr gen (rarg renv bool) bool)
  (lambda (a env many) (and (r-arg-simple? a) (or (not many) (tagcase a (a-e (x) (not (r-var-in-reg? env x))) (else y #t))))))
(define-rec
  (r-last-hard (subr gen (rargs i64 i64) i64)
    (lambda (xs i found) (if (null? xs) found (r-last-hard (cdr xs) (i64+ i 1) (if (r-arg-simple? (car xs)) found i)))))
  (r-nth-arg (subr kfx (rargs i64) rarg) (lambda (xs i) (if (i64= i 0) (car xs) (r-nth-arg (cdr xs) (i64- i 1)))))
  (r-nth-int (subr kfx ((listof i64 acyclic) i64) i64) (lambda (xs i) (if (i64= i 0) (car xs) (r-nth-int (cdr xs) (i64- i 1))))))

"`a` into RESULT and `b` into a register, or `b` as an immediate: which."
(define-datatype roperands (rop-imm lit) (rop-reg i64) (rop-none))

"A sibling not made yet, given a closure as `#f`: its free value `j` to
 be patched with what frame slot `s` will hold (C253)."
(define-datatype rpatch (rpatch i64 i64))
(define-type rpatches (listof rpatch acyclic))

"The word the stack code made of the lambda of `ps` and `body` that knows
 itself as `own0`, seen in `te`, and the names its closure captures, in a
 list; none if none (C253, Fixpt's `c-made-word`): of the form's words, the
 oldest made for the same body, parameters, own name and captures."
(define-datatype rmade (rmade string strings))
(define-rec
  (r-made-in (subr kfx ((listof lword acyclic) i64 strings strings strings) (listof rmade acyclic))
    (lambda (ws at ps own fv)
      (if (null? ws)
          nil
          (let ((older (r-made-in (cdr ws) at ps own fv)))
            (cond ((not (null? older)) older)
                  ((tagcase (car ws) (lword (b qs o w cs) (and (i64= b at) (strings=? qs ps) (strings=? o own) (strings=? cs fv))))
                   (tagcase (car ws) (lword (b qs o w cs) (list (rmade w cs)))))
                  (else nil)))))))
(define r-made-word (subr gen (strings cx cenv strings) (listof rmade acyclic))
  (lambda (ps body te own0)
    (r-made-in (get cg-form-lambdas) (cx-start body) ps (c-own-of ps own0) (c-captured (c-free body ps nil) te))))

"Where a value is: the same register or frame slot."
(define r-same-place? (subr kfx (rloc rloc) bool)
  (lambda (x y)
    (tagcase x
      (rl-reg (i) (tagcase y (rl-reg (j) (i64= i j)) (else z #f)))
      (rl-slot (i) (tagcase y (rl-slot (j) (i64= i j)) (else z #f)))
      (else z #f))))
"A copy's procedure's parameter the lambda is, and the arity it is called
 with."
(define rspec-param (subr kfx (rspec) string)
  (lambda (c) (tagcase c (rspec (sp lps lbody fv genv) (tagcase sp (rspecial (n ps body at k ar la) (r-nth-name ps k)))))))
(define rspec-arity (subr kfx (rspec) i64)
  (lambda (c) (tagcase c (rspec (sp lps lbody fv genv) (tagcase sp (rspecial (n ps body at k ar la) ar))))))
"Whether `x` is, in a copy, the parameter the lambda is, where it is (an
 inlined body's, or the lambda's, does not see it) (Fixpt's
 `r-spec-param?`)."
(define r-spec-param? (subr gen (rgen renv cx) bool)
  (lambda (g env x)
    (let* ((cx (g-ctx g)) (sp (x-spec cx)) (at (get (x-spec-at cx))))
      (and (not (null? sp)) (not (null? at))
           (tagcase x
             (x-var (m a)
               (and (string=? m (rspec-param (car sp)))
                    (let ((l (r-where env m))) (and (not (null? l)) (r-same-place? (car l) (car at))))))
             (else y #f))))))
"Whether `f`, in a copy, is its procedure's own global, called with the
 parameter passed as itself (Fixpt's `r-spec-self?`)."
(define r-spec-self? (subr gen (rgen renv cx cxs) bool)
  (lambda (g env f args)
    (let ((sp (x-spec (g-ctx g))))
      (and (not (null? sp)) (not (null? (get (x-spec-at (g-ctx g)))))
           (tagcase (car sp)
             (rspec (s lps lbody fv genv)
               (tagcase s
                 (rspecial (n ps body at k ar la)
                   (and (tagcase f
                          (x-var (m a) (and (string=? m n) (let ((l (r-where env m))) (and (not (null? l)) (tagcase (car l) (rl-global (c) #t) (else y #f))))))
                          (else y #f))
                        (i64= (size args) (size ps))
                        (r-spec-param? g env (r-nth-cx args k)))))))))))

"A call of global `f` on `args` specialized (C260, Fixpt's
 `r-specialized`): `f` a special seen here, given at the parameter it
 only calls a lambda small enough to inline, of the arity it calls it
 with: the special and the lambda, in a list."
(define-datatype rcall (rcall rspecial cx))
(define r-specialized (subr gen (renv cx cxs) (listof rcall acyclic))
  (lambda (env f args)
    (tagcase f
      (x-var (n a)
        (let ((l (if (std-marked? n) nil (r-where env n))))
          (if (or (null? l) (not (tagcase (car l) (rl-global (c) #t) (else y #f))))
              nil
              (let ((sp (r-special-named (get cg-specials) n (size args) (r-genv env))))
                (if (null? sp)
                    nil
                    (tagcase (car sp)
                      (rspecial (m ps body at k ar la)
                        (tagcase (r-nth-cx args k)
                          (x-lambda (lps lbody b)
                            (if (and (i64= (size lps) ar) (i64>= (r-room lbody r-inline-limit #f) 0)) (list (rcall (car sp) (r-nth-cx args k))) nil))
                          (else y nil)))))))))
      (else y nil))))

(define-rec
  (r-drop-bools (subr kfx ((listof bool acyclic) i64) (listof bool acyclic))
    (lambda (bs k) (if (or (null? bs) (i64<= k 0)) bs (r-drop-bools (cdr bs) (i64- k 1))))))

"A leaf's tail call's arguments, sorted: the moves of those in registers,
 or made into one, to REG1…REGn; and the simple ones, each with its
 register, made after the moves."
(define-datatype rlate (rlate i64 cx))
(define-datatype rleaf (rleaf rmoves (listof rlate acyclic)))
(define-rec
  (r-written? (subr kfx (i64 rmoves (listof rlate acyclic)) bool)
    (lambda (k ms late)
      (cond ((not (null? ms)) (or (i64= (move-to (car ms)) k) (r-written? k (cdr ms) late)))
            ((null? late) #f)
            (else (or (tagcase (car late) (rlate (r x) (i64= r k))) (r-written? k ms (cdr late))))))))

(define-rec
  (r-self-moves (subr gen (rgen rlocs i64) unit)
    (lambda (g made i)
      "Each value made for a jump back to the start into its parameter's
       place: a register's into REGi+1, a slot's into slot i."
      (if (null? made)
          #u
          (begin
            (tagcase (car made)
              (rl-reg (r) (if (i64= r (i64+ i 1)) #u (r-opnn g "movereg" r (i64+ i 1))))
              (rl-slot (s) (if (i64= s i) #u (r-slot-move g s i)))
              (else y (r-decline g)))
            (r-self-moves g (cdr made) (i64+ i 1))))))
  (r-slot-args-of (subr gen (rgen rlocs) rargs)
    (lambda (g ls)
      (if (null? ls)
          nil
          (cons (tagcase (car ls) (rl-slot (s) (a-slot s)) (else y (begin (r-decline g) (a-slot 0)))) (r-slot-args-of g (cdr ls)))))))

"A frame slot for each of a module's items, in order, by name."
(define-rec
  (r-module-slots (subr gen (rgen (listof cmem acyclic)) cenv)
    (lambda (g its) (if (null? its) nil (let ((s (r-slot g))) (cons (centry (cmem-name (car its)) (at-slot s)) (r-module-slots g (cdr its))))))))
"Each frame slot as an operand, in order."
(define-rec
  (r-slot-args (subr kfx ((listof i64 acyclic)) rargs) (lambda (ss) (if (null? ss) nil (cons (a-slot (car ss)) (r-slot-args (cdr ss)))))))
"Item `n`'s lambda's scopes while it is made: each of `later` pending, and
 itself a loop if it only calls itself in loops."
(define-rec
  (r-module-own (subr kfx (string rscope cenv cx i64) rscope)
    (lambda (n sc later lbody nps)
      (if (null? later)
          sc
          (tagcase (car later)
            (centry (m l)
              (let ((loops (and (string=? m n) (c-loops-only lbody n nps #t)))
                    (s (tagcase l (at-slot (i) i) (else y (the i64 0)))))
                (tagcase sc
                  (rscope (env te)
                    (r-module-own n (rscope (r-bind m (if loops (rl-loop) (rl-pending s)) env)
                                            (c-extend m (if loops (at-loop) (at-pending s)) te))
                                  (cdr later) lbody nps))))))))))

;;; ---------------------------------------------------------- expressions

"Names `r-standard-app` tests against, made once (C264): a list written in place is
 made at each call."
(define r-standard-app-names strings (list "int-add" "eq" "int-eq"))

(define-rec
  (r-exp (subr gen (rgen cx renv cenv bool) unit)
    (lambda (g x env te tail)
      "`x`'s value into RESULT; in tail position, returned: where its code
       begins noted, and where the code after it, its parent's again,
       does (C249, as the stack code's)."
      (let ((p (cx-start x)) (here (x-at (g-ctx g))))
        (let ((outer (get here)))
          (if (i64> p 0)
              (begin
                (r-emit g (ri-pos p))
                (set here p)
                (r-exp-at g x env te tail)
                (set here outer)
                (if (i64> outer 0) (r-emit g (ri-pos outer)) #u))
              (r-exp-at g x env te tail))))))

  (r-exp-at (subr gen (rgen cx renv cenv bool) unit)
    (lambda (g x env te tail)
      (let ((k (r-known env x)))
        (if (not (null? k))
            (r-const-value g (rconst-lit (car k)) tail)
            (tagcase x
              (x-var (n a) (begin (r-var-value g (r-where env n) n tail) (r-done g tail)))
              (x-str (s a) (r-const-value g (l-str s) tail))
              (x-float (b a) (r-const-value g (l-f64 b) tail))
              (x-sym (s a) (r-const-value g (l-sym s) tail))
              (x-unit (a) (r-const-value g (l-unit) tail))
              (x-int (n a) (r-const-value g (l-int n) tail))
              (x-bool (v a) (r-const-value g (l-bool v) tail))
              (x-char (v a) (r-const-value g (l-char v) tail))
              (x-proj (y a) (r-exp g y env te tail))
              (x-region (k2 r body a) (if (or (i64= k2 0) (i64= k2 3)) (r-exp g body env te tail) (r-letregion g k2 r body env te tail)))
              (x-if (t th el a)
                (let ((kt (r-known env t)))
                  (if (not (null? kt))
                      (r-exp g (if (r-const-false? (car kt)) el th) env te tail)
                      (let ((no (r-new-label g)) (end (r-new-label g)))
                        (begin
                          (r-branch-on g t #f no env te)
                          (r-exp g th (r-knowing env t #t) te tail)
                          (if tail #u (r-emit g (ri-branch "branch" end)))
                          (r-emit g (ri-label no))
                          (r-exp g el (r-knowing env t #f) te tail)
                          (r-emit g (ri-label end)))))))
              (x-begin (es a) (if (null? es) (r-const-value g (l-unit) tail) (r-begin g es env te tail)))
              (x-let (bs body a) (r-let g bs body env te tail))
              (x-extract (p i a) (begin (r-exp g p env te #f) (r-opn g "field" (i64+ i 2)) (r-done g tail)))
              ;; A lambda applied at once: a `let` (Fixpt's `c-applied-let`).
              (x-app (f args a)
                (tagcase f
                  (x-lambda (ps body b)
                    (if (i64= (size ps) (size args))
                        (r-let g (map2 (lambda ((p string) (y cx)) (cbind p y)) ps args) body env te tail)
                        (r-app g f args a env te tail)))
                  (else y (r-app g f args a env te tail))))
              (x-lambda (ps body a) (begin (r-lambda g ps body env te nil nil tail) (r-done g tail)))
              ;; A closure made in a region (C259).
              (x-rlambda (r l a)
                (tagcase l
                  (x-lambda (ps body b) (begin (r-lambda g ps body env te nil (list r) #f) (r-done g tail)))
                  (else y (r-decline g))))
              (x-letrec (bs body a)
                ;; A leaf makes no closure; join points it may have.
                (if (and (g-leaf g) (not (r-all? (r-join-flags bs body tail)))) (r-decline g) (r-letrec g bs body env te tail)))
              (x-tagcase (s arms els k a) (if (i64< k 0) (r-tagcase g s arms els env te tail) (r-flat-tagcase g k s arms els env te tail)))
              (x-bloblet (op i args a) (begin (r-bloblet g op i args env te) (r-done g tail)))
              (x-module (its a) (r-module g its env te tail))
              (x-with (m ns ks body a) (r-with g m ns ks body env te tail))
              (x-reshape (y ps a) (r-reshape g y ps env te tail))
              (x-sum (t v a)
                (begin (r-prim g "%make-frozen" (list (a-v (l-int 36)) (a-v (l-sym t)) (a-e v)) env te) (r-done g tail)))
              (x-product (fs a)
                (begin (r-prim g "%make-frozen" (cons (a-v (l-int 37)) (r-exp-args (c-bound-exps fs))) env te) (r-done g tail)))
              (x-prompt (t body h a)
                (begin (r-call-out g "cellular" "prompt" (list (a-e t) (a-e h) (a-thunk body)) env te) (r-done g tail)))
              (else y (r-decline g)))))))

  (r-letregion (subr gen (rgen i64 string cx renv cenv bool) unit)
    (lambda (g k r body env te tail)
      "The region's name bound, as a `let`'s, to a region entered (never in
       a leaf), and left with the body's value, which is so not in tail
       position (C259, Fixpt's `r-letregion`)."
      (if (g-leaf g)
          (r-decline g)
          (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
            (begin
              (r-prim g (if (i64= k 1) "%region-enter" "%reap-enter") nil env te)
              (let ((h (r-keep-in-slot g)))
                (begin
                  (r-exp g body (r-bind r (rl-slot h) env) (r-local te r) #f)
                  (let ((v (r-keep-in-slot g)))
                    (begin
                      (r-prim g "%region-exit" (list (a-slot h) (a-slot v)) env te)
                      (r-done g tail)))))
              (r-restore g regs slots))))))

  ;;; bloblets (C259, Fixpt's `r-bloblet-op`)
  (r-bloblet (subr gen (rgen string i64 cxs renv cenv) unit)
    (lambda (g op i args env te)
      "A bloblet form, by its field index or, a blobref's, the operand the
       checker found: a scalar's layout, an array's, a flat sum's."
      (let ((all (r-exp-args args)))
        (cond ((string=? op "bloblet-ref") (begin (r-exp g (car args) env te #f) (r-opn g "field" (i64+ i 2))))
              ((string=? op "make-bloblet") (r-prim g "%make-bloblet" all env te))
              ((string=? op "rmake-bloblet") (r-prim g "%region-make-bloblet" all env te))
              ((string=? op "bloblet-set!")
               (begin (r-prim g "%bloblet-set!" (list (a-e (car args)) (a-v (l-int (i64->int (i64+ i 2)))) (a-e (second-cx args))) env te)
                      (r-unit g)))
              ((string=? op "bloblet-byte") (r-prim g "%bloblet-byte" all env te))
              ((string=? op "bloblet-set-byte!") (begin (r-prim g "%bloblet-set-byte!" all env te) (r-unit g)))
              ((string=? op "bloblet-bytes") (r-prim g "%bloblet-bytes" all env te))
              ;; At a literal offset, in line (`prim2imm`).
              ((string=? op "blobref-at")
               (begin
                 (tagcase (second-cx args)
                   (x-int (k a)
                     (if (and (>= k 0) (< k 67108864))
                         (r-prim g "%suffix-ref" (list (a-e (car args)) (a-v (l-int k))) env te)
                         (r-prim g "%suffix-ref" all env te)))
                   (else y (r-prim g "%suffix-ref" all env te)))
                 (r-fits g i)))
              ((string=? op "blobref+") (begin (r-prim g "%suffix-ref+" all env te) (r-fits g i)))
              ;; A product's field through a blobref (Fixpt's `r-extract`).
              ((string=? op "%blobref-field") (r-prim g "%suffix-ref+" (list (a-e (car args)) (a-v (l-int (i64->int i)))) env te))
              ((string=? op "blobref-owner") (r-prim g "%suffix-ref-owner" all env te))
              ((string=? op "blobref-offset") (r-prim g "%suffix-ref-offset" all env te))
              ((i64< i 0) (r-decline g))
              ((string=? op "blobref-get") (r-prim g "%fx26-suffix-ref-get" (list (a-e (car args)) (a-v (l-int (i64->int i)))) env te))
              ((string=? op "blobref-length") (r-prim g "%fx26-suffix-ref-length" (list (a-e (car args)) (a-v (l-int (i64->int i)))) env te))
              ((string=? op "blobref-index") (r-prim3 g "%fx26-blobref-index" (car args) i (second-cx args) env te))
              ((string=? op "blobref-set!") (r-prim3 g "%fx26-suffix-ref-set!" (car args) i (second-cx args) env te))
              ((string=? op "blobref-variant!") (r-prim3 g "%fx26-flat-variant!" (car args) i (second-cx args) env te))
              (else (r-decline g))))))
  (r-prim3 (subr gen (rgen string cx i64 cx renv cenv) unit)
    (lambda (g name a x b env te)
      "RESULT := runtime primitive `name`, one that never collects, of `a`'s
       value, constant `x` and `b`'s (`prim3imm`): `a` kept in its place
       while `b` is made into a register of its own."
      (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
        (begin
          (r-exp g a env te #f)
          (let* ((at (r-place-value g)) (k (begin (r-exp g b env te #f) (r-reg g))))
            (begin (r-opn g "setreg" k)
                   (r-get g at)
                   (r-ins g "prim3imm" (list (o-prim name) (o-lit (l-int (i64->int x))) (o-int k)))))
          (r-restore g regs slots)))))
  (r-imm-prim (subr gen (rgen string lit) unit)
    (lambda (g name v) (r-ins g "prim2imm" (list (o-prim name) (o-lit v)))))
  (r-fits (subr gen (rgen i64) unit)
    (lambda (g size)
      "A new blobref's flat's `size` bytes checked in the suffix, in line;
       declined where the checker noted none."
      (cond ((i64< size 0) (r-decline g))
            ((i64> size 1) (r-imm-prim g "%fx26-suffix-fits" (l-int (i64->int size))))
            (else #u))))

  ;;; a flat sum's tagcase (C259, Fixpt's `r-flat-tagcase`)
  (r-flat-tagcase (subr gen (rgen i64 cx (listof carm acyclic) cbinds renv cenv bool) unit)
    (lambda (g k s arms els env te tail)
      "The blobref and its tag, a label, kept in places (registers in a
       leaf); each arm's name a blobref to its variant, `k / 256` bytes
       along; no arm for the tag a failure. No call-outs."
      (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
        (begin
          (let* ((sc (r-scrutinee-place g s env te))
                 (tag (begin (r-imm-prim g "%fx26-flat-tag" (l-int (i64->int k))) (r-place-value g)))
                 (end (r-new-label g)))
            (begin
              (r-flat-arms g k arms sc tag end regs slots env te tail)
              (if (null? els)
                  (begin (r-get g tag) (r-ins g "prim1" (list (o-prim "%fx26-flat-no-arm"))) (r-done g tail))
                  (tagcase (car els) (cbind (n x) (r-exp g x (r-bind n sc env) (r-local te n) tail))))
              (r-emit g (ri-label end))))
          (r-restore g regs slots)))))
  (r-flat-arms (subr gen (rgen i64 (listof carm acyclic) rloc rloc i64 i64 i64 renv cenv bool) unit)
    (lambda (g k arms sc tag end regs0 slots0 env te tail)
      (if (null? arms)
          #u
          (tagcase (car arms)
            (carm (name whole ns body)
              (let ((next (r-new-label g)))
                (begin
                  (r-get g tag)
                  (r-op2imm g "eq" (if (i64= (i64-remainder (i64-quotient k 8) 2) 1)
                                       (l-int (i64->int (digits-i64 (string-chars name) 0)))
                                       (l-sym name)))
                  (r-emit g (ri-branch "branchf" next))
                  (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
                    (begin
                      (r-get g sc)
                      (r-imm-prim g "%suffix-ref+" (l-int (i64->int (i64-quotient k 256))))
                      ;; The arm's ref where the blobref and its tag were:
                      ;; neither is used past here on this path.
                      (r-restore g regs0 slots0)
                      (let ((at (r-place-value g)))
                        (r-exp g body (r-bind (car ns) at env) (r-local te (car ns)) tail))
                      (r-restore g regs slots)))
                  (if tail #u (r-emit g (ri-branch "branch" end)))
                  (r-emit g (ri-label next))
                  (r-flat-arms g k (cdr arms) sc tag end regs0 slots0 env te tail))))))))
  (r-scrutinee-place (subr gen (rgen cx renv cenv) rloc)
    (lambda (g s env te)
      "`s`'s value into RESULT, and where it is kept: where it is already,
       if a variable in a register or the frame; else a place of its own."
      (let ((v (r-plain-var-loc env s)))
        (if (and (not (null? v)) (tagcase (car v) (rl-reg (r) #t) (rl-slot (n) #t) (else y #f)))
            (begin (r-get g (car v)) (car v))
            (begin (r-exp g s env te #f) (r-place-value g))))))

  ;;; modules (C259, Fixpt's `regcode-modules.fx`)
  (r-module (subr gen (rgen (listof cmem acyclic) renv cenv bool) unit)
    (lambda (g its env te tail)
      "A module: its items made in frame slots in order, as its stack code
       makes them; then the product of its values. Declined in a leaf."
      (if (g-leaf g)
          (r-decline g)
          (let* ((slots (get (g-nslot g)))
                 (later (r-module-slots g its))
                 (vals (r-module-make g its env te later nil nil)))
            (begin (r-prim g "%make-frozen" (cons (a-v (l-int 37)) (r-slot-args (reverse vals))) env te)
                   (set (g-nslot g) slots)
                   (r-done g tail))))))
  (r-module-make (subr gen (rgen (listof cmem acyclic) renv cenv cenv (listof wait acyclic) (listof i64 acyclic)) (listof i64 acyclic))
    (lambda (g its env te later ws vals)
      "Items `its` made in their slots, `later`, in order, as a `letrec*`'s:
       a typed lambda naming an item not made yet captures it once it is
       made; `ws` the closures waiting, `vals` the slots of the values the
       module gives so far (newest first)."
      (if (null? its)
          vals
          (tagcase (car its)
            (cmem (n x k lam at)
              (let* ((s (tagcase (car later) (centry (m l) (tagcase l (at-slot (i) i) (else y (the i64 0))))))
                     (ps (if (and lam (c-names-any? x later))
                             (r-module-closure g n x env te later)
                             (begin (r-exp g x env te #f) (the rpatches nil))))
                     (waits (begin (r-opn g "setstk" s) (onto ws (map (lambda ((p rpatch)) (tagcase p (rpatch (j t) (wait s j t)))) ps)))))
                (begin
                  (r-give-waiting g waits s)
                  (r-module-make g (cdr its) (r-bind n (rl-slot s) env) (r-local te n) (cdr later) waits
                                 (if (i64> k 0) (cons s vals) vals)))))))))
  (r-module-closure (subr gen (rgen string cx renv cenv cenv) rpatches)
    (lambda (g n x env te later)
      "Item `n`'s lambda `x`, naming items of `later` not made yet: those
       captured as a `letrec`'s siblings are, to be given once made."
      (let ((l (lambda-of x)))
        (if (null? l)
            (begin (r-decline g) nil)
            (tagcase (car l)
              (lparts (ps lbody region)
                (tagcase (r-module-own n (rscope env te) later lbody (size ps))
                  (rscope (e2 te2) (r-lambda g ps lbody e2 te2 (list n) region #f)))))))))
  (r-give-waiting (subr gen (rgen (listof wait acyclic) i64) unit)
    (lambda (g ws s)
      "Each closure of `ws` waiting for slot `s`, given it."
      (if (null? ws)
          #u
          (begin
            (tagcase (car ws)
              (wait (at j t)
                (if (i64= t s)
                    (begin (r-opnn g "load" 1 s) (r-opn g "stack" at) (r-opnn g "setfield" (i64+ 3 j) 1))
                    #u)))
            (r-give-waiting g (cdr ws) s)))))
  (r-with (subr gen (rgen cx strings (listof i64 acyclic) cx renv cenv bool) unit)
    (lambda (g m ns ks body env te tail)
      "`with`: the module's values the body names, by position, each kept
       as a `let`'s value is (in a leaf, in a register); then the body."
      (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
        (begin
          (tagcase (r-with-fields g m ns ks (c-free body nil nil) env (rscope env te))
            (rscope (e2 te2) (r-exp g body e2 te2 tail)))
          (r-restore g regs slots)))))
  (r-with-fields (subr gen (rgen cx strings (listof i64 acyclic) strings renv rscope) rscope)
    (lambda (g m ns ks fv env sc)
      (if (or (null? ns) (null? ks))
          sc
          (if (string-member? (car ns) fv)
              (let ((l (begin (r-module-value g m env) (r-opn g "field" (i64+ (car ks) 2)) (r-keep g (g-leaf g)))))
                (tagcase sc
                  (rscope (e2 te2) (r-with-fields g m (cdr ns) (cdr ks) fv env (rscope (r-bind (car ns) l e2) (r-local te2 (car ns)))))))
              (r-with-fields g m (cdr ns) (cdr ks) fv env sc)))))
  (r-module-value (subr gen (rgen cx renv) unit)
    (lambda (g m env)
      "Module `m`'s value into RESULT, from where `env` has it; declined if
       it is not a name in a place."
      (tagcase m
        (x-var (n a)
          (let ((l (r-where env n)))
            (if (null? l)
                (r-decline g)
                (tagcase (car l)
                  (rl-reg (k) (r-opn g "reg" k))
                  (rl-slot (s) (r-opn g "stack" s))
                  (rl-free (i) (r-opn g "lexical" i))
                  (rl-global (c) (r-ins g "global" (list (o-global c))))
                  (else y (r-decline g))))))
        (else y (r-decline g)))))
  (r-reshape (subr gen (rgen cx paths renv cenv bool) unit)
    (lambda (g y ps env te tail)
      "A module reshaped: kept in a slot, the values the type wanted has
       (by path) each into a slot, and a product of them. Declined in a
       leaf."
      (if (g-leaf g)
          (r-decline g)
          (let* ((slots (get (g-nslot g)))
                 (m (begin (r-exp g y env te #f) (r-keep-in-slot g)))
                 (args (r-reshape-fields g m ps)))
            (begin (r-prim g "%make-frozen" (cons (a-v (l-int 37)) args) env te)
                   (set (g-nslot g) slots)
                   (r-done g tail))))))
  (r-reshape-fields (subr gen (rgen i64 paths) rargs)
    (lambda (g m ps)
      (if (null? ps)
          nil
          (let ((s (begin (r-opn g "stack" m) (r-fields-in g (car ps)) (r-keep-in-slot g))))
            (cons (a-slot s) (r-reshape-fields g m (cdr ps)))))))
  (r-fields-in (subr gen (rgen (listof i64 acyclic)) unit)
    (lambda (g ks) (if (null? ks) #u (begin (r-opn g "field" (i64+ (car ks) 2)) (r-fields-in g (cdr ks))))))

  (r-var-value (subr gen (rgen rlocs string bool) unit)
    (lambda (g l n tail)
      "Variable `n`'s value into RESULT, from where it is; if nowhere,
       `nil`, or a standard operation as a value."
      (if (null? l)
          (if (std-nil-name? (std-named n)) (r-const g (l-nil)) (r-standard-value g (std-named n) tail))
          (tagcase (car l)
            (rl-reg (k) (r-opn g "reg" k))
            (rl-slot (s) (r-opn g "stack" s))
            (rl-free (i) (r-opn g "lexical" i))
            (rl-global (c) (r-ins g "global" (list (o-global c))))
            (else y (r-decline g))))))

  (r-standard-value (subr gen (rgen string bool) unit)
    (lambda (g name tail)
      "A standard operation as a value: a closure of the word the stack
       code made for it. A leaf makes one only in tail position, and a
       `vsubr`'s, given to `%fx26-vlambda`, never."
      (if (or (not (string-member? name (get cg-standard-words))) (and (g-leaf g) (or (not tail) (c-vsubr? name))))
          (r-decline g)
          (begin
            (r-ins g "lambda" (list (o-word name) (o-int 0)))
            (if (c-vsubr? name) (begin (r-opn g "setreg" 1) (r-ins g "prim" (list (o-prim "%fx26-vlambda") (o-int 1)))) #u)))))

  (r-branch-on (subr gen (rgen cx bool i64 renv cenv) unit)
    (lambda (g x when label env te)
      "Code that goes to `label` if `x` is `when` (true: anything but #f),
       and on if not: `and`, `or` and `not` make no boolean."
      (tagcase x
        (x-proj (y a) (r-branch-on g y when label env te))
        (x-app (f args a)
          (if (and (string=? (r-standard-name env f) "not") (i64= (size args) 1))
              (r-branch-on g (car args) (not when) label env te)
              (r-branch-plain g x when label env te)))
        (x-if (t th el a)
          (let ((tc (r-known env th)) (ec (r-known env el)))
            (cond ((and (not (null? tc)) (r-holds? tc when))
                   (begin (r-branch-on g t #t label env te) (r-branch-on g el when label env te)))
                  ((not (null? tc)) (r-branch-past g t #t el when label env te))
                  ((and (not (null? ec)) (r-holds? ec when))
                   (begin (r-branch-on g t #f label env te) (r-branch-on g th when label env te)))
                  ((not (null? ec)) (r-branch-past g t #f th when label env te))
                  (else
                   (let ((no (r-new-label g)) (end (r-new-label g)))
                     (begin (r-branch-on g t #f no env te) (r-branch-on g th when label env te)
                            (r-emit g (ri-branch "branch" end)) (r-emit g (ri-label no))
                            (r-branch-on g el when label env te) (r-emit g (ri-label end))))))))
        (else y (r-branch-plain g x when label env te)))))

  (r-branch-past (subr gen (rgen cx bool cx bool i64 renv cenv) unit)
    (lambda (g t sense x when label env te)
      (let ((skip (r-new-label g)))
        (begin (r-branch-on g t sense skip env te) (r-branch-on g x when label env te) (r-emit g (ri-label skip))))))

  (r-branch-plain (subr gen (rgen cx bool i64 renv cenv) unit)
    (lambda (g x when label env te)
      (let ((k (r-known env x)))
        (if (not (null? k))
            (if (r-holds? k when) (r-emit g (ri-branch "branch" label)) #u)
            (begin (r-exp g x env te #f) (r-emit g (ri-branch (if when "brancht" "branchf") label)))))))

  (r-begin (subr gen (rgen cxs renv cenv bool) unit)
    (lambda (g es env te tail)
      (if (null? (cdr es)) (r-exp g (car es) env te tail) (begin (r-exp g (car es) env te #f) (r-begin g (cdr es) env te tail)))))

  (r-value-loc (subr gen (rgen cx renv cenv bool) rloc)
    (lambda (g x env te reg)
      "Where `x`'s value is: a constant, as itself; else made and kept, in a
       register if `reg`, else a frame slot."
      (let ((k (r-known env x))) (if (null? k) (begin (r-exp g x env te #f) (r-keep g reg)) (rl-const (car k))))))

  (r-let-bind (subr gen (rgen cbinds renv cenv (listof bool acyclic)) renv)
    (lambda (g bs env te flags)
      (if (null? bs)
          nil
          (tagcase (car bs)
            (cbind (n x)
              (let ((l (r-value-loc g x env te (car flags))))
                (cons (rbind n l) (r-let-bind g (cdr bs) env te (cdr flags)))))))))

  (r-let (subr gen (rgen cbinds cx renv cenv bool) unit)
    (lambda (g bs body env te tail)
      "Each value made, in the scope outside, and kept in a register where
       no call comes before the body is done with it (else the frame)."
      (let* ((regs (get (g-nreg g))) (slots (get (g-nslot g)))
             (body-collects (r-collects-here? g body (r-local-names te bs) tail))
             (flags (r-in-regs g (c-bound-exps bs) 0 te body-collects))
             (bound (r-let-bind g bs env te flags)))
        (begin (r-exp g body (r-bind-all bound env) (r-local-all bound te) tail) (r-restore g regs slots)))))

  ;;; applications
  (r-app (subr gen (rgen cx cxs i64 renv cenv bool) unit)
    (lambda (g f args a env te tail)
      (let ((n (size args)) (own (r-own-self g env f args)))
        (cond ((not (null? (r-join-of env f))) (r-jump g (car (r-join-of env f)) args env te tail))
              ((and tail (r-self-known? g f n te)) (r-loop g args env te))
              ;; In a copy specialized at a lambda: the lambda called, or the
              ;; procedure calling itself (C260).
              ((and (r-spec-param? g env f) (i64= n (rspec-arity (car (x-spec (g-ctx g)))))) (r-spec-lambda g args env te tail))
              ((r-spec-self? g env f args)
               (r-self-guarded g (tagcase (car (x-spec (g-ctx g))) (rspec (s lps lbody fv genv) (rspecial-name s)))
                               (x-spec-start (g-ctx g)) f args a env te tail))
              ((not (null? own)) (r-self-guarded g (car own) (x-own-start (g-ctx g)) f args a env te tail))
              (else
               (let ((name (r-standard-name env f)))
                 (cond ((string=? name "") (r-call g f args a env te tail))
                       ;; A quoted datum: made once where it is all literals,
                       ;; the stack code's interned node; else made, then
                       ;; interned (TODO §51).
                       ((and (string=? name "%quote") (i64= n 1))
                        (let ((cell (c-quoted-cell (car args))))
                          (if (null? cell)
                              (begin (r-prim g "%fx26-intern-datum" (r-exp-args args) env te) (r-done g tail))
                              (r-const-value g (quoted-interned (car cell)) tail))))
                       ;; In tail position a mark replaces this frame's (C253):
                       ;; the arguments made, the frame left, and the
                       ;; call-out, which calls the thunk as a tail call.
                       ((and tail (string=? name "with-mark") (i64= n 3))
                        (begin (r-args g (r-exp-args args) env te nil) (r-leave g)
                               (r-ins g "cellular" (list (o-prim "withmark-tail") (o-int 3)))
                               ;; Never reached: register code ends each path so.
                               (r-op0 g "return")))
                       ((and (string=? name "apply") (i64= n 2)) (r-apply g args env te tail))
                       ((not (null? (r-identity-arg env name args))) (r-exp g (car (r-identity-arg env name args)) env te tail))
                       (else (begin (r-standard-app g name args env te) (r-done g tail))))))))))

  (r-standard-app (subr gen (rgen string cxs renv cenv) unit)
    (lambda (g name args env te)
      (tagcase (r-standard name (size args))
        (s-op2 (r swap negate)
          ;; Operands trade places only where one is a variable or a
          ;; constant; a constant goes second, an immediate, where the
          ;; operation does not care which. A chain of `+` and `-` of
          ;; constants: its one operand that is not, then their sum.
          (let* ((x (car args)) (y (car (cdr args)))
                 (split (if (and (r-add-name? name) (or (r-adds? env x) (r-adds? env y))) (r-split-app env name args) nil))
                 (core (if (null? split) nil (tagcase (car split) (rsplit (c k) c))))
                 (literal (r-literal? x))
                 (commutes (string-member? r r-standard-app-names))
                 (free-x (and swap (r-free-operand? env x)))
                 (free-y (and swap (not free-x) (r-free-operand? env y))))
            (begin
              (cond ((r-deeper? core x y)
                     (begin (r-exp g (car core) env te #f) (r-add-imm g (tagcase (car split) (rsplit (c k) k)))))
                    ((and swap (not free-x) (not free-y)) (r-binary-swapped g r x y env te))
                    ((or swap (and commutes literal (null? (r-known env y)))) (r-binary g r y x env te))
                    (else (r-binary g r x y env te)))
              (if negate (r-negate g) #u))))
        (s-op1 (r) (begin (r-exp g (car args) env te #f) (r-ins g "op1" (list (o-prim r)))))
        (s-op2imm (r v) (begin (r-exp g (car args) env te #f) (r-op2imm g r v)))
        (s-field (k) (begin (r-exp g (car args) env te #f) (r-opn g "field" k)))
        (s-prim (p) (r-call-out g "prim" p (r-exp-args args) env te))
        (s-pure (p)
          (if (null? (cdr args))
              (begin (r-exp g (car args) env te #f) (r-ins g "prim1" (list (o-prim p))))
              (r-pure2 g p (car args) (car (cdr args)) env te)))
        (s-cellular (r) (r-call-out g "cellular" r (r-exp-args args) env te))
        (s-identity () (r-exp g (car args) env te #f))
        (s-set ()
          (tagcase (r-operands g (car args) (car (cdr args)) env te #f)
            (rop-reg (k) (begin (r-opnn g "setfield" 2 k) (r-unit g)))
            (else y (r-decline g))))
        (s-special (what) (r-special g what args env te))
        (s-list () (r-list g args env te))
        (else y (r-decline g)))))

  (r-call (subr gen (rgen cx cxs i64 renv cenv bool) unit)
    (lambda (g f args a env te tail)
      "A call: the arguments into REG1…REGn, the procedure in RESULT."
      (let* ((n (size args))
             (u (r-unrolled env f args))
             (i (if (null? u) (r-inlined env f (size args)) u))
             (sp (if (null? i) (r-specialized env f args) nil)))
        (cond ;; An inlined call, or an unrolled one (C252): in a fast
              ;; version, no call, so in a leaf too.
              ((not (null? i))
               (if (and (not (x-assuming (g-ctx g))) (g-leaf g))
                   (r-decline g)
                   (r-inline g (car i) (not (null? u)) f args a env te tail)))
              ((g-leaf g)
               (if (and tail (i64< n register-regs) (null? sp)) (r-leaf-tail-call g f args a env te) (r-decline g)))
              ((not (null? sp)) (r-specialize g (car sp) args env te tail))
              ((and (not tail) (r-self-known? g f n te))
               (begin (r-args g (r-exp-args args) env te nil) (r-opn g "invokeself" n)))
              (else (begin (r-args g (r-exp-args args) env te (list f)) (r-invoke g n tail (r-conv-at a))))))))

  ;;; specialization (C260, Fixpt's `r-specialize`)
  (r-specialize (subr gen (rgen rcall cxs renv cenv bool) unit)
    (lambda (g c args env te tail)
      "A call of a procedure specialized at the lambda it is given: the
       copy made for the lambda (with the form's words, `regs-form-twins!`)
       called, if the global still holds what it was made from."
      (tagcase c
        (rcall (sp lam)
          (tagcase lam
            (x-lambda (lps lbody b)
              (let ((m (r-made-word lps lbody te nil)))
                (if (null? m)
                    (r-decline g)
                    (tagcase (car m)
                      (rmade (w fv)
                        (let ((copy (r-copy-of (get cg-copies) (rspecial-name sp) (cx-start lbody) fv (r-genv env))))
                          (if (null? copy) (r-decline g) (r-specialized-call g (rspecial-name sp) (car copy) args env te tail))))))))
            (else y (r-decline g)))))))
  (r-specialized-call (subr gen (rgen string string cxs renv cenv bool) unit)
    (lambda (g cell copy args env te tail)
      "The copy's closure made first, into a slot; then the arguments, the
       lambda's closure among them; then, if the global has not been
       written since, the copy called, else the global."
      (let* ((regs (get (g-nreg g))) (slots (get (g-nslot g))) (s (r-slot g)) (n (size args)))
        (begin
          (r-ins g "lambda" (list (o-word copy) (o-int 0)))
          (r-opn g "setstk" s)
          (r-args g (r-exp-args args) env te nil)
          (let ((call (r-new-label g)) (end (r-new-label g)))
            (if (r-assume g cell)
                (begin (r-opn g "stack" s) (r-invoke g n tail 0))
                (begin (r-guard g cell call)
                       (r-opn g "stack" s)
                       (r-invoke g n tail 0)
                       (if tail #u (r-emit g (ri-branch "branch" end)))
                       (r-emit g (ri-label call))
                       (r-ins g "global" (list (o-global cell)))
                       (r-invoke g n tail 0)
                       (r-emit g (ri-label end)))))
          (r-restore g regs slots)))))
  (r-spec-lambda (subr gen (rgen cxs renv cenv bool) unit)
    (lambda (g args env te tail)
      "In a copy, a call of the parameter the lambda is: the lambda's body,
       its parameters bound to the arguments and the values its closure
       captured to those fields of the parameter's value, where the globals
       are those it saw."
      (tagcase (car (x-spec (g-ctx g)))
        (rspec (sp lps lbody captured lgenv)
          (let* ((at (car (get (x-spec-at (g-ctx g)))))
                 (regs (get (g-nreg g))) (slots (get (g-nslot g)))
                 (body-collects (and (not (g-leaf g)) (r-collects (g-view g) lbody (r-locals captured (r-locals lps nil)) nil tail)))
                 (flags (r-in-regs g args (size captured) te body-collects))
                 (bound (r-spec-args g lps args env te flags))
                 (all (r-spec-free g at captured 3 bound (r-drop-bools flags (size args)))))
            (begin
              (tagcase all
                (rscope (e2 te2) (r-exp g lbody (onto e2 (cons (rbind genv-name (rl-seen lgenv)) (r-carried env nil))) te2 tail)))
              (r-restore g regs slots)))))))
  (r-spec-args (subr gen (rgen strings cxs renv cenv (listof bool acyclic)) rscope)
    (lambda (g ps args env te flags)
      "Each of the lambda's parameters bound to its argument, made and kept,
       in order."
      (if (or (null? ps) (null? args))
          (rscope nil nil)
          (let* ((l (r-value-loc g (car args) env te (car flags)))
                 (rest (r-spec-args g (cdr ps) (cdr args) env te (cdr flags))))
            (tagcase rest (rscope (e2 te2) (rscope (r-bind (car ps) l e2) (r-local te2 (car ps)))))))))
  (r-spec-free (subr gen (rgen rloc strings i64 rscope (listof bool acyclic)) rscope)
    (lambda (g at fv j sc flags)
      "Each value the lambda's closure captured, from the parameter's value
       at `at`, field `j` on, kept, in order."
      (if (null? fv)
          sc
          (begin
            (tagcase at (rl-reg (k) (r-opn g "reg" k)) (rl-slot (s) (r-opn g "stack" s)) (else y (r-decline g)))
            (r-opn g "field" j)
            (let ((l (r-keep g (car flags))))
              (tagcase sc
                (rscope (e2 te2) (r-spec-free g at (cdr fv) (i64+ j 1) (rscope (r-bind (car fv) l e2) (r-local te2 (car fv))) (cdr flags)))))))))

  (r-inline (subr gen (rgen rinline bool cx cxs i64 renv cenv bool) unit)
    (lambda (g i unrolled f args a env te tail)
      "A call of a small global procedure, inlined (C252, Fixpt's
       `r-inline`): the arguments made and kept (one a variable in the frame
       or the closure, or a constant, used where it is); then, if the global
       still holds a closure of the word its body was compiled to, the body,
       in a scope of its own where the parameters are the arguments and the
       globals those it saw; else the call. A redefinition writes the
       global: the call."
      (tagcase i
        (rinline (name ps body at)
          (let* ((regs (get (g-nreg g))) (slots (get (g-nslot g)))
                 (bound (r-inline-args g ps args env te))
                 (call (r-new-label g)) (end (r-new-label g))
                 ;; Within its own unrolling, no guard: the outer one's holds.
                 (assumed (or (and unrolled (not (null? (r-local-loc env (inlining-name name))))) (r-assume g name))))
            (begin
              (if assumed #u (r-guard g name call))
              (tagcase bound
                (rbound (benv bte bargs)
                  (begin
                    ;; The procedure running is not known in the body.
                    (r-exp (r-unknowing g) body (r-inline-env benv env name at) bte tail)
                    (if assumed
                        #u
                        (begin
                          (if tail #u (r-emit g (ri-branch "branch" end)))
                          (r-emit g (ri-label call))
                          (r-args g bargs env te (list f))
                          (r-invoke g (size args) tail (r-conv-at a))
                          (r-emit g (ri-label end)))))))
              (r-restore g regs slots)))))))

  (r-inline-args (subr gen (rgen strings cxs renv cenv) rbound)
    (lambda (g ps args env te)
      "Each parameter bound to its argument, in order: where the body finds
       it, the body's scope, and the call's arguments where the guard
       fails."
      (if (or (null? ps) (null? args))
          (rbound nil nil nil)
          (let* ((p (car ps)) (x (car args))
                 (k (r-known env x))
                 (l (if (null? k) (r-var-loc env x) (the rlocs (list (rl-const (car k))))))
                 (keeps (and (not (null? l))
                             (tagcase (car l)
                               (rl-slot (s) #t) (rl-free (j) #t) (rl-const (c) #t)
                               ;; In a fast version, where no call comes after
                               ;; to clobber it.
                               (rl-reg (r) (x-assuming (g-ctx g)))
                               (else y #f))))
                 (kept (if keeps l nil))
                 (here (if (null? kept) (begin (r-exp g x env te #f) (r-keep g (g-leaf g))) (car kept)))
                 (arg (cond ((not (null? k)) (a-v (rconst-lit (car k))))
                            ((null? kept) (tagcase here (rl-slot (s) (a-slot s)) (else y (a-e x))))
                            (else (a-e x)))))
            (tagcase (r-inline-args g (cdr ps) (cdr args) env te)
              (rbound (benv bte bargs)
                (rbound (r-bind p here benv) (r-local bte p) (cons arg bargs))))))))

  ;;; closures (C253)
  (r-lambda (subr gen (rgen strings cx renv cenv strings cxs bool) rpatches)
    (lambda (g ps body env te own region tail)
      "A closure of a lambda into RESULT, its free values into REG1…REGn
       first: of the word the stack code made (`r-made-word`); with a
       `region` (an `rlambda`'s, one or none), made there, by
       `%region-closure h fv … w` (C259). A leaf makes one only as its
       value, in tail position, and none in a region. What it gives: for
       each sibling not made yet, the free value and the sibling's slot."
      (if (and (g-leaf g) (not (and tail (null? region))))
          (begin (r-decline g) nil)
          (let ((m (r-made-word ps body te own)))
            (if (null? m)
                (begin (r-decline g) nil)
                (tagcase (car m)
                  (rmade (w fv)
                    (let ((n (size fv)))
                      (cond
                        ((not (null? region))
                         (tagcase (r-free-args g fv env 0)
                           (rfree (as ps2)
                             (begin (r-prim g "%region-closure" (cons (a-e (car region)) (onto as (list (a-v (l-word w))))) env te) ps2))))
                        ((i64> n register-regs)
                          (tagcase (r-free-args g fv env 0)
                            (rfree (as ps2)
                              (begin (r-args g as env te nil) (r-ins g "lambda" (list (o-word w) (o-int n))) ps2))))
                        (else
                          (let ((patches (r-free-into-regs g fv env)))
                            (begin (r-ins g "lambda" (list (o-word w) (o-int n))) patches))))))))))))
  (r-thunk (subr gen (rgen cx renv cenv) unit)
    (lambda (g body env te) (begin (r-lambda g nil body env te nil nil #f) #u)))
  (r-free-args (subr gen (rgen strings renv i64) rfree)
    (lambda (g fv env j)
      "The free values as a call-out's operands; a sibling not made yet as
       `#f`, to be patched."
      (if (null? fv)
          (rfree nil nil)
          (tagcase (r-free-args g (cdr fv) env (i64+ j 1))
            (rfree (as ps)
              (let ((l (r-where env (car fv))))
                (if (null? l)
                    (begin (r-decline g) (rfree as ps))
                    (tagcase (car l)
                      (rl-slot (s) (rfree (cons (a-slot s) as) ps))
                      (rl-free (i) (rfree (cons (a-lexical i) as) ps))
                      (rl-pending (s) (rfree (cons (a-v (l-bool #f)) as) (cons (rpatch j s) ps)))
                      (rl-const (c) (rfree (cons (a-v (rconst-lit c)) as) ps))
                      (else y (begin (r-decline g) (rfree as ps)))))))))))
  (r-free-into-regs (subr gen (rgen strings renv) rpatches)
    (lambda (g fv env) (begin (r-emit-all g (par-move-items (r-reg-moves fv env 0) nil)) (r-free-regs g fv env 0))))
  (r-free-regs (subr gen (rgen strings renv i64) rpatches)
    (lambda (g fv env j)
      "Each free value into REGj+1, as `lambda` wants them (one in a
       register moved already); a sibling not made yet as `#f`, patched."
      (if (null? fv)
          nil
          (let ((l (r-where env (car fv))) (k (i64+ j 1)))
            (if (null? l)
                (begin (r-decline g) nil)
                (tagcase (car l)
                  (rl-reg (r) (r-free-regs g (cdr fv) env k))
                  (rl-slot (s) (begin (r-opnn g "load" k s) (r-free-regs g (cdr fv) env k)))
                  (rl-free (i) (begin (r-lexical-into g i k) (r-free-regs g (cdr fv) env k)))
                  (rl-pending (s) (begin (r-const-into g (l-bool #f) k) (cons (rpatch j s) (r-free-regs g (cdr fv) env k))))
                  (rl-const (c) (begin (r-const-into g (rconst-lit c) k) (r-free-regs g (cdr fv) env k)))
                  (else y (begin (r-decline g) nil))))))))

  ;;; letrec (C253)
  (r-letrec (subr gen (rgen cbinds cx renv cenv bool) unit)
    (lambda (g bs body env te tail)
      "Each closure made into its slot, a placeholder for a sibling not
       made yet; then each placeholder patched; a join point no closure,
       its calls jumps to its body, after the `letrec`'s."
      (let* ((slots (get (g-nslot g))) (regs (get (g-nreg g)))
             (joins (r-join-flags bs body tail))
             (at (r-letrec-slots g joins))
             (made (r-letrec-make g bs bs at 0 env te joins))
             (te2 (r-letrec-te bs joins te))
             (places (begin (r-letrec-patch g made at) (r-join-places g bs joins te2)))
             (env2 (r-letrec-env bs at places env)))
        (begin
          (r-exp g body env2 te2 tail)
          (r-join-bodies g bs places env2 te2 tail)
          (r-restore g regs slots)))))
  (r-letrec-slots (subr gen (rgen (listof bool acyclic)) (listof i64 acyclic))
    (lambda (g joins)
      (if (null? joins) nil (let ((s (if (car joins) (the i64 -1) (r-slot g)))) (cons s (r-letrec-slots g (cdr joins)))))))
  (r-letrec-make (subr gen (rgen cbinds cbinds (listof i64 acyclic) i64 renv cenv (listof bool acyclic)) (listof rpatches acyclic))
    (lambda (g all bs at i env te joins)
      (cond
        ((null? bs) nil)
        ((car joins) (cons nil (r-letrec-make g all (cdr bs) at (i64+ i 1) env te (cdr joins))))
        (else
         (tagcase (car bs)
           (cbind (name x)
             (let* ((l (lambda-of x))
                    (p (if (null? l)
                           (begin (r-decline g) nil)
                           (tagcase (car l)
                             (lparts (ps lbody region)
                               (tagcase (r-sibling-env all at i 0 lbody (size ps) env te)
                                 (rscope (e2 te2) (r-lambda g ps lbody e2 te2 (list name) region #f))))))))
               (begin
                 (r-opn g "setstk" (r-nth-int at i))
                 (cons p (r-letrec-make g all (cdr bs) at (i64+ i 1) env te (cdr joins)))))))))))
  (r-sibling-env (subr gen (cbinds (listof i64 acyclic) i64 i64 cx i64 renv cenv) rscope)
    (lambda (bs at i k lbody n env te)
      "Each sibling where the closure being made sees it: a loop, if it is
       this one and only called so in its body; else the slot it will be
       in, not made yet."
      (if (null? bs)
          (rscope env te)
          (tagcase (car bs)
            (cbind (sib x)
              (let ((loops (and (i64= k i) (c-loops-only lbody sib n #t))) (s (r-nth-int at k)))
                (r-sibling-env (cdr bs) at i (i64+ k 1) lbody n
                               (r-bind sib (if loops (rl-loop) (rl-pending s)) env)
                               (c-extend sib (if loops (at-loop) (at-pending s)) te))))))))
  (r-letrec-patch (subr gen (rgen (listof rpatches acyclic) (listof i64 acyclic)) unit)
    (lambda (g made at)
      (if (null? made) #u (begin (r-patch-one g (car made) (car at)) (r-letrec-patch g (cdr made) (cdr at))))))
  (r-patch-one (subr gen (rgen rpatches i64) unit)
    (lambda (g ps slot)
      (if (null? ps)
          #u
          (tagcase (car ps)
            (rpatch (j s)
              (begin (r-opnn g "load" 1 s) (r-opn g "stack" slot) (r-opnn g "setfield" (i64+ 3 j) 1)
                     (r-patch-one g (cdr ps) slot)))))))
  (r-join-places (subr gen (rgen cbinds (listof bool acyclic) cenv) (listof (listof rplace acyclic) acyclic))
    (lambda (g bs joins named)
      "Each join point's place: its parameters' places, registers where its
       body calls nothing (or in a leaf), so many as leave half of them,
       else frame slots; and its label. None for one that is not."
      (if (null? bs)
          nil
          (let ((here (the (listof rplace acyclic) (if (car joins)
                          (tagcase (car bs)
                            (cbind (n x)
                              (tagcase (car (lambda-of x))
                                (lparts (ps lbody region)
                                  (let* ((regs (or (g-leaf g)
                                                   (and (not (r-collects (g-view g) lbody (r-locals ps named) (g-this g) #t))
                                                        (i64<= (i64+ (get (g-nreg g)) (size ps)) r-half-regs))))
                                         (locs (r-param-places g ps regs))
                                         (label (r-new-label g)))
                                    (the (listof rplace acyclic) (list (rplace locs label))))))))
                          nil))))
            (cons here (r-join-places g (cdr bs) (cdr joins) named))))))
  (r-param-places (subr gen (rgen strings bool) rlocs)
    (lambda (g ps regs)
      (if (null? ps) nil (let ((l (if regs (rl-reg (r-reg g)) (rl-slot (r-slot g))))) (cons l (r-param-places g (cdr ps) regs))))))
  (r-join-bodies (subr gen (rgen cbinds (listof (listof rplace acyclic) acyclic) renv cenv bool) unit)
    (lambda (g bs places env te tail)
      "Each join point's body, after the `letrec`'s, which ends every path
       itself: where its calls go."
      (if (null? bs)
          #u
          (begin
            (if (null? (car places))
                #u
                (tagcase (car bs)
                  (cbind (n x)
                    (tagcase (car (lambda-of x))
                      (lparts (ps lbody region)
                        (tagcase (car (car places))
                          (rplace (locs label)
                            (begin (r-emit g (ri-label label))
                                   (r-exp g lbody (r-bind-places env ps locs) (r-locals ps te) tail)))))))))
            (r-join-bodies g (cdr bs) (cdr places) env te tail)))))
  (r-jump (subr gen (rgen rloc cxs renv cenv bool) unit)
    (lambda (g j args env te tail)
      "A join point's call: each argument made and kept (a register where no
       later argument calls), then each into its parameter's place, and a
       jump."
      (tagcase j
        (rl-join (params label)
          (if (or (not tail) (not (i64= (size args) (size params))))
              (r-decline g)
              (let* ((regs (get (g-nreg g))) (slots (get (g-nslot g)))
                     (made (r-jump-args g args env te (r-in-regs g args 0 te #f))))
                (begin (r-jump-moves g made params) (r-emit g (ri-branch "branch" label)) (r-restore g regs slots)))))
        (else y (r-decline g)))))
  (r-jump-args (subr gen (rgen cxs renv cenv (listof bool acyclic)) rlocs)
    (lambda (g args env te flags)
      (if (null? args)
          nil
          (let ((l (begin (r-exp g (car args) env te #f) (r-keep g (car flags)))))
            (cons l (r-jump-args g (cdr args) env te (cdr flags)))))))
  (r-jump-moves (subr gen (rgen rlocs rlocs) unit)
    (lambda (g made params)
      (if (or (null? made) (null? params))
          #u
          (begin
            (tagcase (car made)
              (rl-reg (a)
                (tagcase (car params)
                  (rl-reg (b) (r-opnn g "movereg" a b))
                  (rl-slot (b) (begin (r-opn g "reg" a) (r-opn g "setstk" b)))
                  (else y (r-decline g))))
              (rl-slot (a)
                (tagcase (car params)
                  (rl-reg (b) (r-opnn g "load" b a))
                  (rl-slot (b) (r-slot-move g a b))
                  (else y (r-decline g))))
              (else y (r-decline g)))
            (r-jump-moves g (cdr made) (cdr params))))))

  ;;; tagcase (C253)
  (r-tagcase (subr gen (rgen cx (listof carm acyclic) cbinds renv cenv bool) unit)
    (lambda (g s arms els env te tail)
      "The scrutinee kept; each arm's tag compared, the last's not when
       there is no `else` (a checked program covers every tag); the value,
       or its product's members, bound."
      (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
        (begin
          (r-exp g s env te #f)
          (let* ((sc (r-place-value g)) (end (r-new-label g)))
            (begin
              (r-arms g arms (null? els) sc end env te tail)
              (if (null? els)
                  #u
                  (tagcase (car els) (cbind (n x) (r-exp g x (r-bind n sc env) (r-local te n) tail))))
              (r-emit g (ri-label end))))
          (r-restore g regs slots)))))
  (r-arms (subr gen (rgen (listof carm acyclic) bool rloc i64 renv cenv bool) unit)
    (lambda (g arms no-else sc end env te tail)
      (if (null? arms)
          #u
          (tagcase (car arms)
            (carm (tag whole ns body)
              (let* ((last (and no-else (null? (cdr arms)))) (next (r-new-label g))
                     (regs (get (g-nreg g))) (slots (get (g-nslot g))))
                (begin
                  (if last
                      #u
                      (begin (r-get g sc) (r-opn g "field" 2) (r-op2imm g "eq" (l-sym tag))
                             (r-emit g (ri-branch "branchf" next))))
                  (let* ((bound (if whole
                                    (r-members g sc ns 0 body nil)
                                    (begin (r-get g sc) (r-opn g "field" 3) (r-bind (car ns) (r-place-value g) nil))))
                         (in-order (the renv (reverse bound))))
                    (r-exp g body (r-bind-all in-order env) (r-local-all in-order te) tail))
                  (r-restore g regs slots)
                  (if tail #u (r-emit g (ri-branch "branch" end)))
                  (r-emit g (ri-label next))
                  (r-arms g (cdr arms) no-else sc end env te tail))))))))
  (r-members (subr gen (rgen rloc strings i64 cx renv) renv)
    (lambda (g sc xs j body acc)
      "A product's members the arm's body uses, each kept, newest first."
      (cond ((null? xs) acc)
            ((not (c-mentions? body (car xs))) (r-members g sc (cdr xs) (i64+ j 1) body acc))
            (else
             (begin (r-get g sc) (r-opn g "field" 3) (r-opn g "field" (i64+ j 2))
                    (let ((l (r-place-value g))) (r-members g sc (cdr xs) (i64+ j 1) body (r-bind (car xs) l acc))))))))

  ;;; apply and list (C253)
  (r-apply (subr gen (rgen cxs renv cenv bool) unit)
    (lambda (g args env te tail)
      "`(apply f xs)`: `f` a `vsubr`, a closure over the procedure of one
       list, free value 0; that procedure called with `xs`, as the stack
       code calls it (no copy)."
      (if (g-leaf g)
          (r-decline g)
          (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
            (begin
              (r-args g (r-exp-args args) env te nil)
              (let ((s (r-slot g)))
                (begin (r-opn g "reg" 1) (r-opn g "field" 3) (r-opn g "setstk" s) (r-opn g "reg" 2) (r-opn g "setreg" 1)
                       (r-opn g "stack" s) (r-invoke g 1 tail 0)))
              (r-restore g regs slots))))))
  (r-list (subr gen (rgen cxs renv cenv) unit)
    (lambda (g args env te)
      "`(list x …)`: every argument not simple, or in a register, made and
       kept first, in order; then the pairs made from the last, onto `nil`."
      (if (g-leaf g)
          (r-decline g)
          (let* ((slots (get (g-nslot g))) (as (r-exp-args args)) (kept (r-args-hard g as 0 -1 env te #t)))
            (begin (r-const g (l-nil)) (r-args-list g as kept (i64- (size as) 1) 0 env te) (set (g-nslot g) slots))))))

  (r-args (subr gen (rgen rargs renv cenv cxs) unit)
    (lambda (g args env te f)
      "The arguments into REG1…REGn, in order, then `f`, if a call's, into
       RESULT. An argument that is not simple is kept in the frame until all
       are made; a simple one is made last. Past `register-regs`, REG8 a
       list of the rest, made by `cons`, which may collect."
      (if (g-leaf g)
          (r-decline g)
          (let* ((n (size args))
                 (many (i64> n register-regs))
                 (slots (get (g-nslot g)))
                 (hard-f (and (not (null? f)) (not (r-simple? (car f)))))
                 (direct (if (or many hard-f) (the i64 -1) (r-last-hard args 0 -1)))
                 (kept (r-args-hard g args 0 direct env te many))
                 (fun (if hard-f (begin (r-exp g (car f) env te #f) (r-keep-in-slot g)) (the i64 -1))))
            (begin
              (if many
                  (begin
                    (r-const g (l-nil))
                    (r-args-list g args kept (i64- n 1) (i64- register-regs 1) env te)
                    (let ((s (r-slot g)))
                      (begin (r-opn g "setstk" s)
                             (r-args-into g args kept 0 (i64- register-regs 1) env te)
                             (r-opnn g "load" register-regs s))))
                  (r-args-into g args kept 0 n env te))
              (cond ((i64>= fun 0) (r-opn g "stack" fun))
                    ((not (null? f)) (r-exp g (car f) env te #f))
                    (else #u))
              (set (g-nslot g) slots))))))

  (r-args-hard (subr gen (rgen rargs i64 i64 renv cenv bool) (listof i64 acyclic))
    (lambda (g args i direct env te many)
      "Each argument: -1 if simple, made later; -2 if made into its
       register now; else the frame slot it is kept in."
      (if (null? args)
          nil
          (if (r-arg-simple-here? (car args) env many)
              (cons (the i64 -1) (r-args-hard g (cdr args) (i64+ i 1) direct env te many))
              (begin
                (tagcase (car args) (a-e (x) (r-exp g x env te #f)) (a-thunk (b) (r-thunk g b env te)) (else y #u))
                (let ((k (if (i64= i direct) (begin (r-opn g "setreg" (i64+ i 1)) (the i64 -2)) (r-keep-in-slot g))))
                  (cons k (r-args-hard g (cdr args) (i64+ i 1) direct env te many))))))))

  (r-args-into (subr gen (rgen rargs (listof i64 acyclic) i64 i64 renv cenv) unit)
    (lambda (g args kept i stop env te)
      (if (or (null? args) (i64= i stop))
          #u
          (begin (r-arg-into g (car args) (car kept) (i64+ i 1) env te)
                 (r-args-into g (cdr args) (cdr kept) (i64+ i 1) stop env te)))))

  (r-arg-into (subr gen (rgen rarg i64 i64 renv cenv) unit)
    (lambda (g a kept k env te)
      (cond ((i64= kept -2) #u)
            ((i64>= kept 0) (r-opnn g "load" k kept))
            (else
             (tagcase a
               (a-e (x) (r-into g x k env te))
               (a-v (v) (r-const-into g v k))
               (a-slot (s) (r-opnn g "load" k s))
               (a-lexical (j) (r-lexical-into g j k))
               (a-thunk (b) #u))))))

  (r-args-list (subr gen (rgen rargs (listof i64 acyclic) i64 i64 renv cenv) unit)
    (lambda (g args kept i from env te)
      "The arguments from the `i`th down to the `from`th, onto the list in
       RESULT, by `cons`."
      (if (i64< i from)
          #u
          (begin
            (r-opn g "setreg" 2)
            (r-arg-into g (r-nth-arg args i) (r-nth-int kept i) 1 env te)
            (r-ins g "cellular" (list (o-prim "cons") (o-int 2)))
            (r-args-list g args kept (i64- i 1) from env te)))))

  (r-call-out (subr gen (rgen string string rargs renv cenv) unit)
    (lambda (g how what args env te)
      (begin (r-args g args env te nil) (r-ins g how (list (o-prim what) (o-int (size args)))))))

  (r-prim (subr gen (rgen string rargs renv cenv) unit)
    (lambda (g name args env te)
      "Runtime primitive `name`: in line if it never collects and its
       operands are a value and a constant (`prim2imm`), or a value
       (`prim1`); else a call-out."
      (let ((n (size args)))
        (cond ((and (r-never-collects? name) (i64= n 1) (r-arg-loaded g (car args) env te))
               (r-ins g "prim1" (list (o-prim name))))
              ((and (r-never-collects? name) (i64= n 2) (tagcase (car (cdr args)) (a-v (v) #t) (else y #f))
                    (r-arg-loaded g (car args) env te))
               (r-ins g "prim2imm" (list (o-prim name) (tagcase (car (cdr args)) (a-v (v) (o-lit v)) (else y (o-int 0))))))
              (else (r-call-out g "prim" name args env te))))))
  (r-arg-loaded (subr gen (rgen rarg renv cenv) bool)
    (lambda (g a env te)
      (tagcase a (a-e (x) (begin (r-exp g x env te #f) #t)) (a-slot (s) (begin (r-opn g "stack" s) #t)) (else y #f))))

  (r-special (subr gen (rgen string cxs renv cenv) unit)
    (lambda (g what args env te)
      "Arrays, and the tag and key makers: as the stack compiler does them."
      (cond ((string=? what "array-ref")
             (begin (r-args g (r-exp-args args) env te nil) (r-index-field g) (r-ins g "cellular" (list (o-prim "field@") (o-int 2)))))
            ((string=? what "array-set!")
             (begin (r-args g (r-exp-args args) env te nil) (r-index-field g)
                    (r-ins g "prim" (list (o-prim "%bloblet-set!") (o-int 3))) (r-unit g)))
            ((string=? what "array-length") (begin (r-prim g "%bloblet-fields" (r-exp-args args) env te) (r-add-imm g -1)))
            ((string=? what "make-array")
             (r-prim g "%make-bloblet-filled" (list (a-v (l-int 0)) (a-e (car args)) (a-e (car (cdr args)))) env te))
            ((string=? what "make-box") (r-prim g "%make-box" (list (a-v (l-unit))) env te))
            ((or (string=? what "set-car!") (string=? what "set-cdr!")) (begin (r-prim g what (r-exp-args args) env te) (r-unit g)))
            (else (r-decline g)))))
  (r-index-field (subr gen (rgen) unit)
    (lambda (g) (begin (r-opn g "reg" 2) (r-add-imm g 2) (r-opn g "setreg" 2))))

  (r-binary (subr gen (rgen string cx cx renv cenv) unit)
    (lambda (g r a b env te)
      "RESULT := r(a, b), `a` evaluated first; a constant `b` an immediate."
      (tagcase (r-operands g a b env te #t)
        (rop-imm (v) (r-op2imm g r v))
        (rop-reg (k) (r-ins g "op2" (list (o-prim r) (o-int k))))
        (rop-none () (r-decline g)))))
  (r-pure2 (subr gen (rgen string cx cx renv cenv) unit)
    (lambda (g p a b env te)
      (tagcase (r-operands g a b env te #t)
        (rop-imm (v) (r-ins g "prim2imm" (list (o-prim p) (o-lit v))))
        (rop-reg (k) (r-ins g "prim2" (list (o-prim p) (o-int k))))
        (rop-none () (r-decline g)))))
  (r-binary-swapped (subr gen (rgen string cx cx renv cenv) unit)
    (lambda (g r x y env te)
      "RESULT := r(y, x), `x` evaluated first, as written; `x` kept in a
       register, or the frame if `y` calls."
      (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))))
        (begin
          (r-exp g x env te #f)
          (let* ((collects (r-collects-here? g y te #f)) (k (r-reg g)))
            (begin
              (if collects
                  (let ((s (r-slot g))) (begin (r-opn g "setstk" s) (r-exp g y env te #f) (r-opnn g "load" k s)))
                  (begin (r-opn g "setreg" k) (r-exp g y env te #f)))
              (r-ins g "op2" (list (o-prim r) (o-int k)))))
          (r-restore g regs slots)))))

  (r-operands (subr gen (rgen cx cx renv cenv bool) roperands)
    (lambda (g a b env te imm)
      "`a` into RESULT and `b` into a register, `a` evaluated first; or, if
       `imm` and `b` is a constant, `b` as an immediate. The register is
       free again after: use it at once."
      (let* ((regs (get (g-nreg g))) (slots (get (g-nslot g)))
             (v (if imm (r-known-cell env b) nil))
             (breg (r-reg-of (r-var-loc env b)))
             (out (cond
                    ((not (null? v)) (begin (r-exp g a env te #f) (rop-imm (car v))))
                    ((i64> breg 0) (begin (r-exp g a env te #f) (rop-reg breg)))
                    ;; `b` first, `a` having no effect and seeing none: a
                    ;; chain nested in second operands then needs one
                    ;; register, not one a level.
                    ((r-simple? a)
                     (let ((k (if (r-simple? b)
                                  (let ((k (r-reg g))) (begin (r-into g b k env te) k))
                                  (begin (r-exp g b env te #f) (r-keep-in-reg g)))))
                       (begin (r-exp g a env te #f) (rop-reg k))))
                    (else
                     (begin
                       (r-exp g a env te #f)
                       (let* ((kept (r-keep g (not (r-collects-here? g b te #f)))) (k (r-reg g)))
                         (begin (r-into g b k env te) (r-get g kept) (rop-reg k))))))))
        (begin (r-restore g regs slots) out))))

  (r-into (subr gen (rgen cx i64 renv cenv) unit)
    (lambda (g x k env te)
      "`x`'s value into REGk: straight from a register or the frame when it
       is a variable there, else by way of RESULT."
      (let ((l (r-plain-var-loc env x)))
        (if (null? l)
            (begin (r-exp g x env te #f) (r-opn g "setreg" k))
            (tagcase (car l)
              (rl-slot (s) (r-opnn g "load" k s))
              (rl-reg (r) (if (i64= r k) #u (r-opnn g "movereg" r k)))
              (else y (begin (r-exp g x env te #f) (r-opn g "setreg" k))))))))

  ;;; the procedure itself
  (r-loop (subr gen (rgen cxs renv cenv) unit)
    (lambda (g args env te)
      "A tail call of the procedure itself: the new arguments made, then put
       where the parameters are, and back to the start."
      (let* ((regs (get (g-nreg g))) (slots (get (g-nslot g))) (made (r-loop-make g args env te)))
        (begin (r-loop-move g made 0) (r-emit g (ri-branch "branch" (g-start g))) (r-restore g regs slots)))))
  (r-loop-make (subr gen (rgen cxs renv cenv) (listof i64 acyclic))
    (lambda (g args env te)
      (if (null? args)
          nil
          (begin (r-exp g (car args) env te #f)
                 (let ((m (if (g-leaf g) (r-keep-in-reg g) (r-keep-in-slot g)))) (cons m (r-loop-make g (cdr args) env te)))))))
  (r-loop-move (subr gen (rgen (listof i64 acyclic) i64) unit)
    (lambda (g made i)
      (if (null? made)
          #u
          (begin (if (g-leaf g) (r-opnn g "movereg" (car made) (i64+ i 1)) (r-slot-move g (car made) i))
                 (r-loop-move g (cdr made) (i64+ i 1))))))

  (r-self-guarded (subr gen (rgen string i64 cx cxs i64 renv cenv bool) unit)
    (lambda (g cell start f args a env te tail)
      "A procedure calling itself through its global `cell`: the arguments
       made; then, if the global has not been written since, this
       procedure again, by its own entry, or in tail position a loop back
       to `start`; else the global's."
      (let ((n (size args)) (conv (r-conv-at a)))
        (if (and (g-leaf g) (or (not (and tail (x-assuming (g-ctx g)))) (i64> n register-regs)))
            (r-decline g)
            (let ((regs (get (g-nreg g))) (slots (get (g-nslot g))) (call (r-new-label g)) (end (r-new-label g)))
              (begin
                (if tail
                    (let* ((made (r-self-temps g args 0 env te)) (assumed (r-assume g cell)))
                      (begin
                        (if assumed #u (r-guard g cell call))
                        (r-self-moves g made 0)
                        (r-emit g (ri-branch "branch" start))
                        (if assumed
                            (set (x-looped (g-ctx g)) #t)
                            (begin (r-emit g (ri-label call))
                                   (r-args g (r-slot-args-of g made) env te (list f))
                                   (r-invoke g n #t conv)))))
                    (begin
                      (r-args g (r-exp-args args) env te nil)
                      (if (r-assume g cell)
                          (r-opn g "invokeself" n)
                          (begin (r-guard g cell call)
                                 (r-opn g "invokeself" n)
                                 (r-emit g (ri-branch "branch" end))
                                 (r-emit g (ri-label call))
                                 (r-ins g "global" (list (o-global cell)))
                                 (r-opnn g "invoke" n conv)
                                 (r-emit g (ri-label end))))))
                (r-restore g regs slots)))))))
  (r-self-temps (subr gen (rgen cxs i64 renv cenv) rlocs)
    (lambda (g args i env te)
      (if (null? args) nil (let ((l (r-self-temp g (car args) i env te))) (cons l (r-self-temps g (cdr args) (i64+ i 1) env te))))))
  (r-self-temp (subr gen (rgen cx i64 renv cenv) rloc)
    (lambda (g x i env te)
      "Argument `i` of a loop kept: where it is already if it is the
       parameter itself, unchanged; else as `r-place-value` keeps it."
      (let ((v (r-plain-var-loc env x)) (leaf (g-leaf g)))
        (if (and (not (null? v))
                 (tagcase (car v) (rl-reg (r) (and leaf (i64= r (i64+ i 1)))) (rl-slot (n) (and (not leaf) (i64= n i))) (else y #f)))
            (car v)
            (begin (r-exp g x env te #f) (r-place-value g))))))

  ;;; a leaf's tail call
  (r-leaf-tail-call (subr gen (rgen cx cxs i64 renv cenv) unit)
    (lambda (g f args a env te)
      "A call in tail position in a leaf, which has no frame: the arguments
       sorted; the procedure into RESULT now if nothing after the moves
       uses RESULT, else kept in a register; the moves; the simple
       arguments; the call. Its own registers above REG1…REGn."
      (let* ((regs (get (g-nreg g)))
             (above (set (g-nreg g) (if (i64> regs (size args)) regs (size args))))
             (made (r-leaf-args g args env te 1)))
        (tagcase made
          (rleaf (ms late)
            (let* ((quiet (and (null? late) (not (moves-cycle? ms))))
                   (fr (r-reg-of (r-plain-var-loc env f)))
                   (written (and (i64> fr 0) (r-written? fr ms late)))
                   ;; Where the procedure is after the moves: a register; 0,
                   ;; to be fetched; -1, in RESULT.
                   (at (cond ((and (i64> fr 0) (not written)) fr)
                             ((and written quiet) (begin (r-opn g "reg" fr) (the i64 -1)))
                             (written (r-reg g))
                             ((r-simple? f) (the i64 0))
                             (else (begin (r-exp g f env te #f) (if quiet (the i64 -1) (r-keep-in-reg g))))))
                   (moves (if (and written (not quiet)) (moves-snoc ms fr at) ms)))
              (begin
                (r-emit-all g (par-move-items moves nil))
                (r-late-into g late env te)
                (cond ((i64> at 0) (r-opn g "reg" at)) ((i64= at 0) (r-exp g f env te #f)) (else #u))
                (r-opnn g "tailinvoke" (size args) (r-conv-at a))
                (set (g-nreg g) regs))))))))
  (r-leaf-args (subr gen (rgen cxs renv cenv i64) rleaf)
    (lambda (g args env te k)
      (if (null? args)
          (rleaf nil nil)
          (let* ((a (car args)) (r (r-reg-of (r-plain-var-loc env a))))
            (cond ((i64> r 0)
                   (let ((rest (r-leaf-args g (cdr args) env te (i64+ k 1))))
                     (if (i64= r k) rest (tagcase rest (rleaf (ms late) (rleaf (cons (rmove r k) ms) late))))))
                  ((r-simple? a)
                   (tagcase (r-leaf-args g (cdr args) env te (i64+ k 1)) (rleaf (ms late) (rleaf ms (cons (rlate k a) late)))))
                  (else
                   (let ((t (begin (r-exp g a env te #f) (r-keep-in-reg g))))
                     (tagcase (r-leaf-args g (cdr args) env te (i64+ k 1)) (rleaf (ms late) (rleaf (cons (rmove t k) ms) late))))))))))
  (r-late-into (subr gen (rgen (listof rlate acyclic) renv cenv) unit)
    (lambda (g late env te)
      (if (null? late) #u (tagcase (car late) (rlate (k x) (begin (r-into g x k env te) (r-late-into g (cdr late) env te))))))))
