"vm.kfx: the engine's machine over words (C64): the CEK machine of
 machine.kfx, its control a node's number, its environment, continuation
 and values words in the heap (heap.kfx). Registers: the mode (0 evaluate
 a node, 1 return a value, 2 apply), the node, the environment, the
 continuation, the value, and the procedure and arguments of an
 application. At the top of each step, if the heap's room is short of the
 reserve, the registers are written to the roots, the heap collected, and
 the step begun again from the roots: nothing else holds a word across a
 collection. A step that needs more room than the reserve (a primitive's
 result of its input's size, a continuation's frames copied) asks first,
 the same way."

(define reserve i64 65536)

(define roots (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 6 0)))

"Fuel (the REPL's, docs/research/repl.md): the steps a run may take
 before it pauses, or -1, no limit. A paused run's registers are kept in
 the roots, in its task's slot (`parked-at`), so that the collector keeps
 what they reach; `w-paused` is what `run` then gives."
(define fuel (ref i64 @h) (new -1))

"A slice's end by the clock, in nanoseconds, or -1: looked at every 8
 of the machine's transitions (fuel counts a node's evaluation alone, and
 a return, a primitive's application, takes none), so that however long
 one is, a slice is not much longer; the live REPL's keys are read
 between slices (C99)."
(define deadline (ref i64 @h) (new -1))

(define ticks (ref i64 @h) (new 0))

(define past-deadline? (subr (maxeff (read @globals) spin (read @h) (write @h) (io clock)) () bool)
  (lambda ()
    (begin
      (set ticks (i64+ (get ticks) 1))
      (and (i64= (i64-and (get ticks) 7) 0) (i64> (clock) (get deadline))))))
(define task-slot (ref i64 @h) (new 0))
(define w-paused i64 62)
"What `run` gives when the run failed (C110): `engine-failure` says how."
(define w-failed i64 94)
(define parked-at (subr kfx (i64) i64) (lambda (slot) (i64+ 8 (i64* slot 8))))
(define globals (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 1 0)))
(define global-name-table (ref (arrayof string @h) @h) (new (make-array 1 "")))
(define tags-made (ref i64 @h) (new 0))

"Frames: a `frame` object, its next frame first, then its kind, then its
 fields. Never written once made, so that a continuation's frames may be
 shared, and resumed again and again."
(define fk-if i64 1)
(define fk-seq i64 2)
(define fk-list i64 3)
(define fk-letrec i64 4)
(define fk-define i64 5)
(define fk-sum i64 6)
(define fk-extract i64 7)
(define fk-tagcase i64 8)
(define fk-ptag i64 9)
(define fk-phandler i64 10)
(define fk-prompt i64 11)
(define fk-abort i64 12)
"A continuation mark (C72): its key (an object, compared by identity) and
 its value."
(define fk-mark i64 13)
"The scheduler's `preempt` called at a slice's end: its value dropped,
 the node it stopped at (field 0) evaluated in its environment (1) (C219,
 Fixpt's `VmFrame::Discard`)."
(define fk-preempted i64 14)

(define frame-kind (subr (maxeff (read @globals) spin (read @h)) (i64) i64) (lambda (k) (fixnum-value (obj-ref k 1))))
(define frame-next (subr (maxeff (read @globals) spin (read @h)) (i64) i64) (lambda (k) (obj-ref k 0)))
(define frame-field (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64) (lambda (k i) (obj-ref k (i64+ i 2))))

(define frame! (subr hp (i64 i64 i64 i64 i64 i64 i64) i64)
  (lambda (kind next n a b c d)
    "A frame of `kind` with `n` fields, the first `n` of `a` to `d`."
    (let ((p (alloc! ob-frame (i64+ n 2))))
      (begin
        (obj-set! p 0 next)
        (obj-set! p 1 (fixnum kind))
        (if (i64> n 0) (obj-set! p 2 a) #u)
        (if (i64> n 1) (obj-set! p 3 b) #u)
        (if (i64> n 2) (obj-set! p 4 c) #u)
        (if (i64> n 3) (obj-set! p 5 d) #u)
        p))))

"Environments: an `env` object, its parent first, then its slots."
(define-rec
  (env-up (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
    (lambda (e d) (if (i64= d 0) e (env-up (obj-ref e 0) (i64- d 1))))))

(define-rec
  (fill-from-reversed! (subr hp (i64 i64 i64) unit)
    (lambda (p i xs)
      "Slots `i` down to 1 of `p` (its first after the header's field 0)
       from the list `xs`, the last first."
      (if (i64< i 1) #u (begin (obj-set! p i (pair-car xs)) (fill-from-reversed! p (i64- i 1) (pair-cdr xs)))))))

(define-rec
  (args-env! (subr hp (i64 i64 i64 i64) unit)
    (lambda (p i xs n) (if (i64> i n) #u (begin (obj-set! p i (pair-car xs)) (args-env! p (i64+ i 1) (pair-cdr xs) n))))))

(define-rec
  (slots-copied! (subr hp (i64 i64 i64 i64) unit)
    (lambda (to from i n) "Slots `i` to `n` - 1 of `from` to the same of `to`." (if (i64>= i n) #u (begin (obj-set! to i (obj-ref from i)) (slots-copied! to from (i64+ i 1) n))))))

"Continuations: the frames above a prompt of a tag, by their count."
(define-rec
  (frames-to (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64) i64)
    (lambda (k tag n)
      "How many frames from `k` before the prompt of `tag`; -1 if none."
      (cond ((i64= k w-nil) -1)
            ((and (i64= (frame-kind k) fk-prompt) (i64= (fixnum-value (frame-field k 0)) tag)) n)
            (else (frames-to (frame-next k) tag (i64+ n 1)))))))

(define-rec
  (frame-after (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
    (lambda (k n) (if (i64= n 0) k (frame-after (frame-next k) (i64- n 1))))))

(define-rec
  (frames-room (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64) i64)
    (lambda (k n acc) (if (i64= n 0) acc (frames-room (frame-next k) (i64- n 1) (i64+ acc (i64+ (obj-size k) 1)))))))

(define-rec
  (frames-copied! (subr hp (i64 i64 i64) i64)
    (lambda (k n onto)
      "The `n` frames from `k`, copied, the last's next `onto`: the first."
      (if (i64= n 0)
          onto
          (let* ((rest (frames-copied! (frame-next k) (i64- n 1) onto))
                 (size (obj-size k))
                 (p (alloc! ob-frame size)))
            (begin
              (obj-set! p 0 rest)
              (slots-copied! p k 1 size)
              p))))))

(define tag-number (subr kfx (i64) i64) (lambda (w) (immediate-value w)))

"Marks (C72): those of a key in `n` frames from `k` (all, if `n` is -1),
 the innermost first."
(define-rec
  (marks-in (subr hp (i64 i64 i64 i64) i64)
    (lambda (k key n acc)
      (cond ((or (i64= k w-nil) (i64= n 0)) (reverse-words! acc w-nil))
            ((and (i64= (frame-kind k) fk-mark) (i64= (frame-field k 0) key))
             (marks-in (frame-next k) key (i64- n 1) (pair! (frame-field k 1) acc)))
            (else (marks-in (frame-next k) key (i64- n 1) acc))))))

(define-rec
  (marks-count (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64 i64) i64)
    (lambda (k key n acc)
      (cond ((or (i64= k w-nil) (i64= n 0)) acc)
            ((and (i64= (frame-kind k) fk-mark) (i64= (frame-field k 0) key)) (marks-count (frame-next k) key (i64- n 1) (i64+ acc 1)))
            (else (marks-count (frame-next k) key (i64- n 1) acc))))))

(define-rec
  (first-mark-in (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64) i64)
    (lambda (k key default)
      (cond ((i64= k w-nil) default)
            ((and (i64= (frame-kind k) fk-mark) (i64= (frame-field k 0) key)) (frame-field k 1))
            (else (first-mark-in (frame-next k) key default))))))

"The control primitives' numbers, their places in `prim-list` (table.kfx),
 written as literals: a constant is a procedure, called at each use."
(define op-make-tag i64 135)
(define op-abort i64 136)
(define op-capture i64 137)
(define op-capture-once i64 210)
(define op-suspend i64 138)
(define op-with-mark i64 170)
(define op-first-mark i64 171)
(define op-current-marks i64 172)
(define op-marks-of i64 173)
(define op-apply i64 168)

(define-rec
  (label-position (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64 i64) i64)
    (lambda (start n l i)
      (cond ((i64>= i n) -1)
            ((i64= (kid-at (i64+ start i)) l) i)
            (else (label-position start n l (i64+ i 1)))))))

(define-rec
  (arm-found (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64) i64)
    (lambda (start n tag)
      (cond ((i64< n 1) -1)
            ((tagcase (armx-at start) (armx (t c b) (i64= t tag))) start)
            (else (arm-found (i64+ start 1) (i64- n 1) tag))))))

(define unbound-global (subr vm (i64) i64)
  (lambda (i) (begin (failed-with! (string-append "the engine: used before it is defined, " (array-ref (get global-name-table) (i64->int i)))) 0)))

(define consts (subr (maxeff (read @globals) spin (read @h)) () (flatarrayof i64 @h)) (lambda () (get constants)))

"A failure's backtrace (TODO §29), made when the machine stops at it:
 the procedures whose activations its continuation holds, innermost
 first, from the call it failed in (`node`, in `env`; -1 if none is
 known) out. A frame's node says its lambda (`node-owner`), and its
 environment its activation: one activation's frames have environments
 each an ancestor of the one before, where two calls' of one procedure
 have neither. A proper tail call leaves no frame, so its caller is not
 there, as in any machine that has tail calls. Consecutive activations of
 one procedure are one line, with their count; what is outside every
 lambda, none."
(define-datatype activation (activation i64 i64 i64))

(define frame-node (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (k)
    (let ((kind (frame-kind k)))
      (cond ((or (i64= kind fk-if) (i64= kind fk-seq) (i64= kind fk-list) (i64= kind fk-letrec) (i64= kind fk-tagcase) (i64= kind fk-ptag))
             (code-index (frame-field k 0)))
            ((i64= kind fk-phandler) (code-index (frame-field k 1)))
            (else -1)))))

(define frame-env (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (k)
    (let ((kind (frame-kind k)))
      (cond ((or (i64= kind fk-if) (i64= kind fk-tagcase) (i64= kind fk-ptag)) (frame-field k 1))
            ((or (i64= kind fk-seq) (i64= kind fk-list) (i64= kind fk-letrec) (i64= kind fk-phandler)) (frame-field k 2))
            (else 0)))))

(define-rec
  (env-within? (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64) bool)
    (lambda (outer e depth)
      "Whether `outer` is `e` or one of its parents."
      (cond ((i64= e outer) #t)
            ((or (i64> depth 256) (not (pointer? e)) (not (is-obj? e ob-env))) #f)
            (else (env-within? outer (obj-ref e 0) (i64+ depth 1)))))))

"The walk out along the frames, a loop however deep the continuation:
 the activation it is in (`owner`, -1 none yet; `env`), how many of that
 lambda's have come one after another (`n`), and the runs finished, the
 first 17 kept (last first), and how many."
(define-datatype walked (walked (listof activation acyclic) i64))

(define-rec
  (activations (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64 i64 (listof activation acyclic) i64) walked)
    (lambda (owner env n k acc runs)
      (if (i64= k w-nil)
          (if (i64< owner 0) (walked acc runs) (walked (cons (activation owner env n) acc) (i64+ runs 1)))
          (let* ((nd (frame-node k)) (o (node-owner nd)) (e (frame-env k)) (next (frame-next k)))
            (cond ((i64< nd 0) (activations owner env n next acc runs))
                  ((i64< owner 0) (activations o e 1 next acc runs))
                  ((and (i64= o owner) (env-within? e env 0)) (activations owner e n next acc runs))
                  ((i64= o owner) (activations owner e (i64+ n 1) next acc runs))
                  (else (activations o e 1 next (if (i64< runs 17) (cons (activation owner env n) acc) acc) (i64+ runs 1)))))))))

(define-rec
  (activations-reversed (subr kfx ((listof activation acyclic) (listof activation acyclic)) (listof activation acyclic))
    (lambda (xs acc) (if (null? xs) acc (activations-reversed (cdr xs) (cons (car xs) acc))))))

(define-rec
  (trace-lines (subr (maxeff (read @globals) spin (read @h) (alloc @h)) ((listof activation acyclic) i64 i64) (listof string @h))
    (lambda (xs shown runs)
      (cond ((null? xs) nil)
            ((i64>= shown 16) (list (string-append "... and " (string-append (i64->string (i64- runs 16)) " more"))))
            (else
             (tagcase (car xs)
               (activation (o e n)
                 (cons (string-append "in " (string-append (array-ref (get wheres) (i64->int o))
                                                           (if (i64> n 1) (string-append ", " (string-append (i64->string n) " calls")) "")))
                       (trace-lines (cdr xs) (i64+ shown 1) runs)))))))))

(define stopped! (subr (maxeff (read @globals) spin (read @h) (write @h) (alloc @h)) (i64 i64 i64) i64)
  (lambda (node env k)
    "The machine stopped at a failure: its backtrace kept, if none is
     yet; `w-failed`."
    (begin
      (if (null? (get engine-trace))
          (tagcase (activations (node-owner node) env 1 k nil 0)
            (walked (acc runs) (set engine-trace (trace-lines (activations-reversed acc nil) 0 runs))))
          #u)
      w-failed)))

"Steps until the next slice's end, as Fixpt's machine counts them
 (`sched::SLICE`), at which the scheduler may preempt the current task."
(define sched-slice i64 65536)
(define sched-poll (ref i64 @h) (new 65536))

(define preempt-at! (subr vm (i64) i64)
  (lambda (k)
    "A step: at a slice's end, the scheduler's `preempt`, if it would have
     another task run (Fixpt's `preempt_due`), the task then quiet until it
     has returned; else `#f`."
    (if (i64> (get sched-poll) 1)
        (begin (set sched-poll (i64- (get sched-poll) 1)) w-false)
        (begin
          (set sched-poll sched-slice)
          (if (not (sched?))
              w-false
              (let ((f (sched-ref s-preempt)) (t (sched-ref s-tag)))
                (if (and (is-obj? f ob-proc)
                         (wanted! (and (not (i64= t w-false)) (i64>= (frames-to k (tag-number t) 0) 0))))
                    (begin (quiet-enter!) f)
                    w-false)))))))

(define-rec
  (run (subr vm (i64 i64 i64 i64 i64 i64 i64) i64)
    (lambda (mode node env k val f args)
      (cond
        ((get engine-failed) (failed-at (if (i64= mode 0) node -1) env k))
        ((i64< (heap-room) reserve)
          (gc-run mode node env k val f args 0))
        (else
          (cond
            ((i64= (get fuel) 0) (park! mode node env k val f args))
            ((and (i64>= (get deadline) 0) (past-deadline?))
             (park! mode node env k val f args))
            ((and (i64= mode 0) (not (i64= (preempt-at! k) w-false)))
             (run 2 -1 0 (frame! fk-preempted k 2 (code-word node) env 0 0) 0 (sched-ref s-preempt) w-nil))
            ((i64= mode 0)
             (begin
             (if (i64> (get fuel) 0) (set fuel (i64- (get fuel) 1)) #u)
             (tagcase (node-at node)
               (n-lit (c) (run 1 0 env k (constant-at c) 0 0))
               (n-local (d s) (run 1 0 env k (obj-ref (env-up env d) (i64+ s 1)) 0 0))
               (n-global (i)
                 (let ((w (flatarray-ref-i64 (get globals) i)))
                   (if (i64= w w-unbound) (begin (unbound-global i) (failed-at node env k)) (run 1 0 env k w 0 0))))
               (n-lambda (n body)
                 (let ((p (alloc! ob-proc 2))) (begin (obj-set! p 0 (code-word node)) (obj-set! p 1 env) (run 1 0 env k p 0 0))))
               (n-call (at count) (run 0 (kid-at at) env (frame! fk-list k 4 (code-word node) (fixnum 1) env w-nil) 0 0 0))
               (n-if (c t e) (run 0 c env (frame! fk-if k 2 (code-word node) env 0 0) 0 0 0))
               (n-seq (at count)
                 (cond ((i64= count 0) (run 1 0 env k w-unit 0 0))
                       ((i64= count 1) (run 0 (kid-at at) env k 0 0 0))
                       (else (run 0 (kid-at at) env (frame! fk-seq k 3 (code-word node) (fixnum 1) env 0) 0 0 0))))
               (n-let (at count body)
                 (if (i64= count 0)
                     (let ((e (alloc! ob-env 1))) (begin (obj-set! e 0 env) (run 0 body e k 0 0 0)))
                     (run 0 (kid-at at) env (frame! fk-list k 4 (code-word node) (fixnum 1) env w-nil) 0 0 0)))
               (n-letrec (at count body)
                 (let ((e (alloc! ob-env (i64+ count 1))))
                   (begin
                     (obj-set! e 0 env)
                     (fill-unbound! e 1 count)
                     (if (i64= count 0)
                         (run 0 body e k 0 0 0)
                         (run 0 (kid-at at) e (frame! fk-letrec k 3 (code-word node) (fixnum 0) e 0) 0 0 0)))))
               (n-define (i x) (run 0 x env (frame! fk-define k 1 (fixnum i) 0 0 0) 0 0 0))
               (n-sum (t x) (run 0 x env (frame! fk-sum k 1 (fixnum t) 0 0 0) 0 0 0))
               (n-product (labels at count)
                 (if (i64= count 0)
                     (let ((p (alloc! ob-product 1))) (begin (obj-set! p 0 (fixnum labels)) (run 1 0 env k p 0 0)))
                     (run 0 (kid-at at) env (frame! fk-list k 4 (code-word node) (fixnum 1) env w-nil) 0 0 0)))
               (n-extract (l x) (run 0 x env (frame! fk-extract k 1 (fixnum l) 0 0 0) 0 0 0))
               (n-tagcase (x start count default) (run 0 x env (frame! fk-tagcase k 2 (code-word node) env 0 0) 0 0 0))
               (n-prompt (t h body) (run 0 t env (frame! fk-ptag k 2 (code-word node) env 0 0) 0 0 0)))))
            ((i64= mode 1)
             (if (i64= k w-nil)
                 val
                 (let ((kind (frame-kind k)) (next (frame-next k)))
                   (cond
                     ((i64= kind fk-if)
                      (tagcase (node-at (code-index (frame-field k 0)))
                        (n-if (c t e) (run 0 (if (truthy? val) t e) (frame-field k 1) next 0 0 0))
                        (else other (run 1 0 env next val 0 0))))
                     ((i64= kind fk-seq)
                      (tagcase (node-at (code-index (frame-field k 0)))
                        (n-seq (at count)
                          (let ((pos (fixnum-value (frame-field k 1))) (e (frame-field k 2)))
                            (if (i64= (i64+ pos 1) count)
                                (run 0 (kid-at (i64+ at pos)) e next 0 0 0)
                                (run 0 (kid-at (i64+ at pos)) e (frame! fk-seq next 3 (frame-field k 0) (fixnum (i64+ pos 1)) e 0) 0 0 0))))
                        (else other (run 1 0 env next val 0 0))))
                     ((i64= kind fk-list) (list-step k next val))
                     ((i64= kind fk-letrec)
                      (let* ((e (frame-field k 2)) (pos (fixnum-value (frame-field k 1))))
                        (begin
                          (obj-set! e (i64+ pos 1) val)
                          (tagcase (node-at (code-index (frame-field k 0)))
                            (n-letrec (at count body)
                              (if (i64= (i64+ pos 1) count)
                                  (run 0 body e next 0 0 0)
                                  (run 0 (kid-at (i64+ at (i64+ pos 1))) e (frame! fk-letrec next 3 (frame-field k 0) (fixnum (i64+ pos 1)) e 0) 0 0 0)))
                            (else other (run 1 0 env next val 0 0))))))
                     ((i64= kind fk-define)
                      (begin (flatarray-set-i64! (get globals) (fixnum-value (frame-field k 0)) val) (run 1 0 env next w-unit 0 0)))
                     ((i64= kind fk-sum)
                      (let ((p (alloc! ob-sum 2))) (begin (obj-set! p 0 (frame-field k 0)) (obj-set! p 1 val) (run 1 0 env next p 0 0))))
                     ((i64= kind fk-extract)
                      (let ((i (label-position (fixnum-value (obj-ref val 0)) (i64- (obj-size val) 1) (fixnum-value (frame-field k 0)) 0)))
                        (if (i64< i 0)
                            (begin (failed-with! "the engine: extract of a field the product has not") (failed-at -1 0 k))
                            (run 1 0 env next (obj-ref val (i64+ i 1)) 0 0))))
                     ((i64= kind fk-tagcase) (tagcase-step k next val))
                     ((i64= kind fk-ptag)
                      (tagcase (node-at (code-index (frame-field k 0)))
                        (n-prompt (t h body) (run 0 h (frame-field k 1) (frame! fk-phandler next 3 val (frame-field k 0) (frame-field k 1) 0) 0 0 0))
                        (else other (run 1 0 env next val 0 0))))
                     ((i64= kind fk-phandler)
                      (tagcase (node-at (code-index (frame-field k 1)))
                        (n-prompt (t h body)
                          (run 0 body (frame-field k 2) (frame! fk-prompt next 2 (fixnum (tag-number (frame-field k 0))) val 0 0) 0 0 0))
                        (else other (run 1 0 env next val 0 0))))
                     ((i64= kind fk-prompt) (run 1 0 env next val 0 0))
                     ((i64= kind fk-mark) (run 1 0 env next val 0 0))
                     ((i64= kind fk-preempted)
                      (begin (quiet-leave!) (run 0 (code-index (frame-field k 0)) (frame-field k 1) next 0 0 0)))
                     ((i64= kind fk-abort) (abort-to (fixnum-value (frame-field k 0)) next val))
                     (else (begin (failed-with! "the engine: a frame of no kind") (failed-at -1 0 k)))))))
            (else (apply-step node env f args k)))))))

  (park! (subr vm (i64 i64 i64 i64 i64 i64 i64) i64)
    (lambda (mode node env k val f args)
      "The registers kept in the task's slot of the roots; `w-paused`."
      (let ((r (get roots)) (at (parked-at (get task-slot))))
        (begin
          (flatarray-set-i64! r at (fixnum mode)) (flatarray-set-i64! r (i64+ at 1) (fixnum node))
          (flatarray-set-i64! r (i64+ at 2) env) (flatarray-set-i64! r (i64+ at 3) k) (flatarray-set-i64! r (i64+ at 4) val)
          (flatarray-set-i64! r (i64+ at 5) f) (flatarray-set-i64! r (i64+ at 6) args)
          w-paused))))

  (gc-run (subr vm (i64 i64 i64 i64 i64 i64 i64 i64) i64)
    (lambda (mode node env k val f args need)
      "The registers to the roots, the heap collected (made room for `need`
       more), and the step begun again from the roots."
      (let ((r (get roots)))
        (begin
          (flatarray-set-i64! r 0 env) (flatarray-set-i64! r 1 k) (flatarray-set-i64! r 2 val)
          (flatarray-set-i64! r 3 f) (flatarray-set-i64! r 4 args)
          (collect! r (get globals) (consts) (i64+ need reserve))
          (run mode node (flatarray-ref-i64 r 0) (flatarray-ref-i64 r 1) (flatarray-ref-i64 r 2)
               (flatarray-ref-i64 r 3) (flatarray-ref-i64 r 4))))))

  (list-step (subr vm (i64 i64 i64) i64)
    (lambda (k next val)
      "A value of a call's, a `let`'s or a product's parts: the next part, or
       all of them, in order, applied, bound or made a product."
      (let* ((nd (code-index (frame-field k 0)))
             (pos (fixnum-value (frame-field k 1)))
             (env (frame-field k 2))
             (got (pair! val (frame-field k 3))))
        (tagcase (node-at nd)
          (n-call (at count)
            (if (i64< pos count)
                (run 0 (kid-at (i64+ at pos)) env (frame! fk-list next 4 (frame-field k 0) (fixnum (i64+ pos 1)) env got) 0 0 0)
                (let ((xs (reverse-words! got w-nil))) (run 2 nd env next 0 (pair-car xs) (pair-cdr xs)))))
          (n-let (at count body)
            (if (i64< pos count)
                (run 0 (kid-at (i64+ at pos)) env (frame! fk-list next 4 (frame-field k 0) (fixnum (i64+ pos 1)) env got) 0 0 0)
                (let ((e (alloc! ob-env (i64+ count 1)))) (begin (obj-set! e 0 env) (fill-from-reversed! e count got) (run 0 body e next 0 0 0)))))
          (n-product (labels at count)
            (if (i64< pos count)
                (run 0 (kid-at (i64+ at pos)) env (frame! fk-list next 4 (frame-field k 0) (fixnum (i64+ pos 1)) env got) 0 0 0)
                (let ((p (alloc! ob-product (i64+ count 1)))) (begin (obj-set! p 0 (fixnum labels)) (fill-from-reversed! p count got) (run 1 0 env next p 0 0)))))
          (else other (begin (failed-with! "the engine: a list frame of no list") (failed-at -1 0 k)))))))

  (tagcase-step (subr vm (i64 i64 i64) i64)
    (lambda (k next val)
      (tagcase (node-at (code-index (frame-field k 0)))
        (n-tagcase (x start count default)
          (let* ((env (frame-field k 1))
                 (is-sum (is-obj? val ob-sum))
                 (tag (if (or is-sum (is-obj? val ob-data)) (fixnum-value (obj-ref val 0)) (the i64 -1)))
                 (found (arm-found start count tag)))
            (if (i64< found 0)
                (let ((e (alloc! ob-env 2))) (begin (obj-set! e 0 env) (obj-set! e 1 val) (run 0 default e next 0 0 0)))
                (tagcase (armx-at found)
                  (armx (t binds body)
                    (let ((whole (if is-sum (obj-ref val 1) val)))
                      (if (or (i64= binds -1) (and is-sum (not (is-obj? whole ob-product))))
                          (let ((e (alloc! ob-env 2))) (begin (obj-set! e 0 env) (obj-set! e 1 whole) (run 0 body e next 0 0 0)))
                          (let* ((n (i64- (obj-size whole) 1))
                                 (e (alloc! ob-env (i64+ n 1))))
                            (begin (slots-copied! e whole 1 (i64+ n 1)) (obj-set! e 0 env)
                                   (run 0 body e next 0 0 0))))))))))
        (else other (begin (failed-with! "the engine: a tagcase frame of no tagcase") (failed-at -1 0 k))))))

  (failed-at (subr vm (i64 i64 i64) i64)
    (lambda (node env k)
      "A failure: in a task of a monitored group, with the scheduler's
       prompt on the stack, an abort to it, the failure forgotten and kept
       for the scheduler (Fixpt's `task_failed`, C219); else the machine
       stopped."
      (let ((tag (sched-tag)))
        (if (or (i64= tag w-false) (i64< (frames-to k (tag-number tag) 0) 0))
            (stopped! node env k)
            (let ((t (task-failed! (string-word! (get engine-failure)) #t)))
              (if (i64= t w-false)
                  (stopped! node env k)
                  (begin (failure-taken!) (abort-to (tag-number t) k w-unit))))))))

  (abort-to (subr vm (i64 i64 i64) i64)
    (lambda (tag k v)
      "To the prompt of `tag`, its handler given `v`."
      (let ((n (frames-to k tag 0)))
        (if (i64< n 0)
            (begin (failed-with! "the engine: no prompt for the tag") (stopped! -1 0 k))
            (let ((p (frame-after k n)))
              (run 2 -1 0 (frame-next p) 0 (frame-field p 1) (pair! v w-nil)))))))

  (apply-step (subr vm (i64 i64 i64 i64 i64) i64)
    (lambda (node env f args k)
      "`f` applied to `args`, at the call `node` in `env` (-1: none known),
       which a failure's backtrace starts at."
      (cond
        ((is-obj? f ob-proc)
         (tagcase (node-at (code-index (obj-ref f 0)))
           (n-lambda (arity body)
             (if (i64= arity -1)
                 (let ((e (alloc! ob-env 2))) (begin (obj-set! e 0 (obj-ref f 1)) (obj-set! e 1 args) (run 0 body e k 0 0 0)))
                 (let* ((n (list-count args 0))
                        (e (alloc! ob-env (i64+ n 1))))
                   (begin (obj-set! e 0 (obj-ref f 1)) (args-env! e 1 args n)
                          (run 0 body e k 0 0 0)))))
           (else other (begin (failed-with! "the engine: a procedure of no lambda") (failed-at node env k)))))
        ((is-obj? f ob-ctor)
         (let* ((n (list-count args 0))
                (p (alloc! ob-data (i64+ n 1))))
           (begin (obj-set! p 0 (obj-ref f 0)) (args-env! p 1 args n) (run 1 0 0 k p 0 0))))
        ((is-obj? f ob-cont)
         (let* ((top (obj-ref f 0)) (n (fixnum-value (obj-ref f 1))) (room (frames-room top n 0)))
           (cond ((i64< (heap-room) (i64+ room reserve)) (gc-run 2 0 0 k 0 f args room))
                 ((and (truthy? (obj-ref f 3)) (truthy? (obj-ref f 2))) (begin (failed-with! (if (i64= (obj-ref f 3) (fixnum 2)) "a one-shot continuation resumed twice" "a continuation resumed twice")) (failed-at node env k)))
                 (else (begin (obj-set! f 2 w-true) (run 1 0 0 (frames-copied! top n k) (pair-car args) 0 0))))))
        ((is-imm? f imm-prim)
         (let ((op (immediate-value f)))
           (cond
             ((i64= op op-make-tag)
              (let ((t (get tags-made))) (begin (set tags-made (i64+ t 1)) (run 1 0 0 k (immediate imm-tag t) 0 0))))
             ((i64= op op-with-mark)
              "The thunk called with the mark on the continuation: in place of
               one of the key there, in tail position, as Scheme's."
              (let* ((key (pair-car args)) (v (pair-car (pair-cdr args))) (thunk (pair-car (pair-cdr (pair-cdr args))))
                     (k2 (if (and (not (i64= k w-nil)) (i64= (frame-kind k) fk-mark) (i64= (frame-field k 0) key))
                             (frame! fk-mark (frame-next k) 2 key v 0 0)
                             (frame! fk-mark k 2 key v 0 0))))
                (run 2 -1 0 k2 0 thunk w-nil)))
             ((i64= op op-first-mark) (run 1 0 0 k (first-mark-in k (pair-car args) (pair-car (pair-cdr args))) 0 0))
             ((i64= op op-current-marks)
              (let ((need (i64* 6 (i64+ (marks-count k (pair-car args) -1 0) 1))))
                (if (i64< (heap-room) (i64+ need reserve))
                    (gc-run 2 0 0 k 0 f args need)
                    (run 1 0 0 k (marks-in k (pair-car args) -1 w-nil) 0 0))))
             ((i64= op op-marks-of)
              (let* ((c (pair-car args)) (key (pair-car (pair-cdr args)))
                     (need (i64* 6 (i64+ (marks-count (obj-ref c 0) key (fixnum-value (obj-ref c 1)) 0) 1))))
                (if (i64< (heap-room) (i64+ need reserve))
                    (gc-run 2 0 0 k 0 f args need)
                    (run 1 0 0 k (marks-in (obj-ref c 0) key (fixnum-value (obj-ref c 1)) w-nil) 0 0))))
             ((i64= op op-apply)
              "`(apply f xs)` (C71): `f` on `xs`'s elements, the list copied, as
               FX-26 copies it (a fresh list, which a `vlambda` may keep)."
              (let ((need (i64* 3 (i64+ (list-count (pair-car (pair-cdr args)) 0) 1))))
                (if (i64< (heap-room) (i64+ need reserve))
                    (gc-run 2 0 0 k 0 f args need)
                    (run 2 -1 0 k 0 (pair-car args) (reverse-words! (reverse-words! (pair-car (pair-cdr args)) w-nil) w-nil)))))
             ((i64= op op-abort) (abort-to (tag-number (pair-car args)) k (pair-car (pair-cdr args))))
             ((or (i64= op op-capture) (i64= op op-capture-once))
              "A one-shot continuation is captured as a composable one, marked
               (field 3, 2) so that a second resume fails, as Fixpt's (C219)."
              (let* ((tag (tag-number (pair-car (pair-cdr args)))) (n (frames-to k tag 0)))
                (if (i64< n 0)
                    (begin (failed-with! "the engine: no prompt for the tag") (failed-at node env k))
                    (let ((c (alloc! ob-cont 4)))
                      (begin (obj-set! c 0 k) (obj-set! c 1 (fixnum n)) (obj-set! c 2 w-false) (obj-set! c 3 (if (i64= op op-capture-once) (fixnum 2) w-false))
                             (run 2 -1 0 k 0 (pair-car args) (pair! c w-nil)))))))
             ((i64= op op-suspend)
              (let* ((tag (tag-number (pair-car args))) (n (frames-to k tag 0)))
                (if (i64< n 0)
                    (begin (failed-with! "the engine: no prompt for the tag") (failed-at node env k))
                    (let ((c (alloc! ob-cont 4)))
                      (begin (obj-set! c 0 k) (obj-set! c 1 (fixnum n)) (obj-set! c 2 w-false) (obj-set! c 3 w-true)
                             (run 2 -1 0 (frame! fk-abort k 1 (fixnum tag) 0 0 0) 0 (pair-car (pair-cdr args)) (pair! c w-nil)))))))
             (else
              (let ((need (op-need op args)))
                (if (i64< (heap-room) (i64+ need reserve))
                    (gc-run 2 0 0 k 0 f args need)
                    (let ((v (apply-op op args)))
                      (if (get engine-failed) (failed-at node env k) (run 1 0 0 k v 0 0)))))))))
        (else (begin (failed-with! "the engine: a call of no procedure") (failed-at node env k)))))))

(define resume (subr vm (i64) i64)
  (lambda (slot)
    "A paused run of the task in `slot` run on, until it ends or pauses."
    (let ((r (get roots)) (at (parked-at slot)))
      (run (fixnum-value (flatarray-ref-i64 r at)) (fixnum-value (flatarray-ref-i64 r (i64+ at 1)))
           (flatarray-ref-i64 r (i64+ at 2)) (flatarray-ref-i64 r (i64+ at 3)) (flatarray-ref-i64 r (i64+ at 4))
           (flatarray-ref-i64 r (i64+ at 5)) (flatarray-ref-i64 r (i64+ at 6))))))

(define-rec
  (roots-copied! (subr vm ((flatarrayof i64 @h) (flatarrayof i64 @h) i64 i64) unit)
    (lambda (from to i n) (if (i64>= i n) #u (begin (flatarray-set-i64! to i (flatarray-ref-i64 from i)) (roots-copied! from to (i64+ i 1) n))))))

(define roots-room! (subr vm (i64) unit)
  (lambda (slot)
    "The roots long enough for `slot`'s registers."
    (let ((old (get roots)) (need (parked-at (i64+ slot 1))))
      (if (i64<= need (flatarray-length-i64 old))
          #u
          (let ((bigger (the (flatarrayof i64 @h) (make-flatarray-i64 (i64* need 2) 0))))
            (begin (roots-copied! old bigger 0 (flatarray-length-i64 old)) (set roots bigger)))))))

(define start-parked! (subr vm (i64 i64) unit)
  (lambda (slot node)
    "The task in `slot` made to begin evaluating `node`, a top-level form:
     as if paused before its first step."
    (begin
      (roots-room! slot)
      (let ((r (get roots)) (at (parked-at slot)))
        (begin
          (flatarray-set-i64! r at (fixnum 0)) (flatarray-set-i64! r (i64+ at 1) (fixnum node))
          (flatarray-set-i64! r (i64+ at 2) 0) (flatarray-set-i64! r (i64+ at 3) w-nil) (flatarray-set-i64! r (i64+ at 4) 0)
          (flatarray-set-i64! r (i64+ at 5) 0) (flatarray-set-i64! r (i64+ at 6) w-nil))))))
