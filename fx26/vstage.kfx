"vstage.kfx: `stage` on the engine (C305; Fixpt's `docs/fx26.md`,
 \"Staging code\"): the code a program gives, a datum, checked as the
 program runs against what the checker noted at the stage, a rep, and made
 a procedure; or why not, a value. The check runs in a worker first, as
 the REPL's do (C111): the checker refuses by failing, which fails the
 worker alone, its refusal sent back. Once it passes, it is checked again
 here, for the facts its lowering reads, lowered and numbered, and made a
 closure over the module, which its frame holds."

"The datum's positions, each list's its own, so that what the checker
 notes of a part (a `with`'s, C213) the lowering finds."
(define stage-pos (ref i64 @h) (new 0))
(define stage-file string "<stage>")

(define stage-at! (subr hp () i64)
  (lambda () (let ((p (get stage-pos))) (begin (set stage-pos (i64+ p 1)) p))))

(define-rec
  (word-sexp (subr hp (i64) sexp)
    (lambda (w)
      "A datum's word as the reader would have read it."
      (cond ((fixnum? w) (num (fixnum-value w) (i64->string (fixnum-value w)) (stage-at!)))
            ((i64= w w-true) (sym "#t" stage-file (stage-at!)))
            ((i64= w w-false) (sym "#f" stage-file (stage-at!)))
            ((i64= w w-unit) (sym "#u" stage-file (stage-at!)))
            ((i64= w w-nil) (lst nil stage-file 1 (stage-at!)))
            ((keyword-word? w) (sym (string-append "#:" (name-of-number (i64- (immediate-value w) keyword-bias))) stage-file (stage-at!)))
            ((is-imm? w imm-symbol) (sym (name-of-number (immediate-value w)) stage-file (stage-at!)))
            ((is-imm? w imm-char) (chr (word-char w) stage-file (stage-at!)))
            ((is-obj? w ob-string) (str (word-string w) stage-file (stage-at!)))
            ((is-obj? w ob-big) (big (int->string (word-int w)) stage-file (stage-at!)))
            ((is-obj? w ob-real) (real (f64->string (word-real w)) stage-file (stage-at!)))
            ((is-pair? w) (let ((p (stage-at!))) (lst (pair-sexps w) stage-file 1 p)))
            (else (sym "%unread" stage-file (stage-at!))))))
  (pair-sexps (subr hp (i64) sexps)
    (lambda (w)
      (cond ((i64= w w-nil) nil)
            ((is-pair? w) (let ((a (word-sexp (pair-car w)))) (cons a (pair-sexps (pair-cdr w)))))
            (else (list (sym "." stage-file (stage-at!)) (word-sexp w)))))))

"What the staged code is checked as: `(lambda (stage-module) (lambda ()
 (with stage-module CODE)))`, against `(subr pure (M) (subr E () R))`."
(define staged-thunk (subr hp (sexp) sexp)
  (lambda (code)
    (let ((s (lambda ((n string)) (sym n stage-file (stage-at!))))
          (l (lambda ((xs sexps)) (lst xs stage-file 1 (stage-at!)))))
      (l (list (s "lambda") (l nil) (l (list (s "with") (s "stage-module") code)))))))

(define staged-program (subr hp (sexp) sexp)
  (lambda (thunk)
    (let ((s (lambda ((n string)) (sym n stage-file (stage-at!))))
          (l (lambda ((xs sexps)) (lst xs stage-file 1 (stage-at!)))))
      (l (list (s "lambda") (l (list (s "stage-module"))) thunk)))))

"The checker's environment a stage's code is checked in: the standard
 one alone, nothing of the program's but the module given."
(define stage-cv (subr kfx () cv)
  (lambda ()
    (let ((empty (cv nil nil nil nil "a type" nil "staged code" 0 nil nil 0 (bempty) nil)))
      (with-binds empty (prim-binds empty)))))

"The check: its state, whose facts the lowering reads; a refusal fails."
(define stage-checked (subr kfx (sexp ty) st)
  (lambda (prog t)
    (tagcase ((with expressions check) (at (stage-cv) "staged code" nil) (new-state) prog t) (res (u es s) s))))

(define stage-verdict (subr kfx (sexp ty) string)
  (lambda (prog t) (begin (stage-checked prog t) "")))

(define-rec
  (begins-with? (subr kfx (chars chars) bool)
    (lambda (cs pat) (or (null? pat) (and (not (null? cs)) (char=? (car cs) (car pat)) (begins-with? (cdr cs) (cdr pat)))))))

(define-rec
  (after-said (subr kfx (chars chars) chars)
    (lambda (cs pat)
      "What follows the first `in staged code: ` of a refusal; all of it if none."
      (cond ((null? cs) nil)
            ((begins-with? cs pat) (drop-chars cs (size pat)))
            (else (after-said (cdr cs) pat))))))

(define* stage-refused (subr pure (string) string) (lambda (m) (if (string=? m "") "refused" m)))

(define refusal-said (subr kfx (string) string)
  (lambda (m)
    "A refusal as its words alone: what the checker says after where, `in
     staged code: `, or a definition's, `<stage>:LINE: in NAME: `."
    (let ((said (list->string (after-said (string-chars m) (string-chars "in staged code: ")))))
      (cond ((not (string=? said "")) said)
            ((not (null? (after-said (string-chars m) (string-chars "<stage>:"))))
             (let ((past (after-said (after-said (string-chars m) (string-chars ": in ")) (string-chars ": "))))
               (if (null? past) m (list->string past))))
            (else m)))))

(define* stage-worked (subr (maxeff (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet spin (read @globals)) (sexp ty) string)
  (lambda (prog t)
    "The check by a worker, whose watcher, a relay of one message, puts what
     it is sent where this waits: `` if it passed, else the refusal."
    (let* ((out (the (icell string @q) (make-icell)))
           (relay (the (addr string @q) (spawn (box string r) (icell-put! out (receive box))))))
      (begin
        (the (addr unit @w) (spawn-monitored relay stage-refused (box unit r) (send relay (stage-verdict prog t))))
        (icell-get out)))))

"The labels of `stage-failure`'s product, made at loading."
(define stage-failure-labels (ref i64 @h) (new -1))

(define stage-failure-word! (subr (maxeff hp (alloc @h)) (string) i64)
  (lambda (m)
    "`(sum failed (product (kind (sum refused #u)) (message m) (start 0) (end 0)))`:
     the place in the code no refusal of kayak's says yet."
    (let* ((k (sum-word! "refused" w-unit)) (msg (string-word! m)) (p (alloc! ob-product 5)))
      (begin (obj-set! p 0 (fixnum (get stage-failure-labels))) (obj-set! p 1 k) (obj-set! p 2 msg)
             (obj-set! p 3 (fixnum 0)) (obj-set! p 4 (fixnum 0)) (sum-word! "failed" p)))))

"Evidence (C307; Fixpt's `docs/fx26.md`, \"Evidence\", and its
 `fixpt_reps::fill`): a rep's holes filled from the evidence given for
 the variables they stand for, each piece of evidence a rep whose root is
 an `evidence` node of what it is of. A hole becomes that; one among an
 effect's atoms, its atoms, spliced into the set. Then canonical again,
 and a set's members each once."
(define-datatype rpe (rpe string rp-nodes (listof symbol acyclic)))

(define-rec
  (rp-max-slot (subr kfx (rp-nodes int) int)
    (lambda (ns m) (if (null? ns) m (rp-max-slot (cdr ns) (if (> (extract (car ns) 1) m) (extract (car ns) 1) m))))))

(define-rec
  (rp-index-in (subr kfx (strings string int) int)
    (lambda (xs n i) (cond ((null? xs) -1) ((string=? (car xs) n) i) (else (rp-index-in (cdr xs) n (+ i 1)))))))

(define rp-moved (subr kfx (rp-operand int (listof symbol acyclic) strings) rp-operand)
  (lambda (a off own all)
    "An evidence's operand, its nodes `off` past, its holes by name in `all`."
    (tagcase a
      (node j (the rp-operand (sum node (+ j off))))
      (bound p (the rp-operand (sum bound (product (1 (+ (extract p 1) off)) (2 (extract p 2))))))
      (hole h (the rp-operand (sum hole (rp-index-in all (nth-symbol own h) 0))))
      (else other a))))

(define-rec
  (rp-evidence-at (subr kfx ((listof rpe acyclic) string) (listof rpe acyclic))
    (lambda (es n) (cond ((null? es) nil) ((tagcase (car es) (rpe (m ns hs) (string=? m n))) (list (car es))) (else (rp-evidence-at (cdr es) n))))))

"Each evidence placed: its offset, and its root's operand moved."
(define-datatype rpp (rpp string int rp-nodes (listof symbol acyclic)))

(define-rec
  (rp-placed (subr kfx ((listof rpe acyclic) int) (listof rpp acyclic))
    (lambda (es off)
      (if (null? es)
          nil
          (tagcase (car es)
            (rpe (n ns hs) (cons (rpp n off ns hs) (rp-placed (cdr es) (+ off (+ (rp-max-slot ns 0) 1))))))))))

(define-rec
  (rp-placed-at (subr kfx ((listof rpp acyclic) string) (listof rpp acyclic))
    (lambda (ps n) (cond ((null? ps) nil) ((tagcase (car ps) (rpp (m off ns hs) (string=? m n))) (list (car ps))) (else (rp-placed-at (cdr ps) n))))))

(define rp-of-evidence (subr kfx (rpp strings) rp-operand)
  (lambda (p all)
    "What evidence is of: its root's one operand, moved."
    (tagcase p
      (rpp (n off ns hs)
        (let ((root (rp-node-at ns 0)))
          (if (null? root)
              (the rp-operand (sum int 0))
              (rp-moved (car (extract (car root) 5)) off hs all)))))))

(define-rec
  (rp-filled-args (subr kfx (rp-operands bool (listof symbol acyclic) (listof rpp acyclic) strings rp-nodes) rp-operands)
    (lambda (as set holes ps all ns-all)
      "A node's operands, each filled hole what its evidence is of; in a set,
       a set's members spliced."
      (if (null? as)
          nil
          (let ((rest (rp-filled-args (cdr as) set holes ps all ns-all)))
            (tagcase (car as)
              (hole h
                (let ((found (rp-placed-at ps (nth-symbol holes h))))
                  (if (null? found)
                      (cons (the rp-operand (sum hole (rp-index-in all (nth-symbol holes h) 0))) rest)
                      (let ((of (rp-of-evidence (car found) all)))
                        (tagcase of
                          (node j
                            (let ((n (rp-node-at ns-all j)))
                              (if (and set (not (null? n)) (extract (car n) 3))
                                  (onto (extract (car n) 5) rest)
                                  (cons of rest))))
                          (else z (cons of rest)))))))
              (else other (cons (car as) rest))))))))

(define rp-filled (subr kfx (rexp (listof rpe acyclic)) rexp)
  (lambda (main es)
    "Rep `main`'s nodes, its holes filled from evidence `es`."
    (tagcase main
      (rexp (ns hs root d)
        (let* ((ps (rp-placed es (+ (rp-max-slot ns 0) 1)))
               (left (filter (lambda ((h string)) (null? (rp-placed-at ps h))) hs))
               (theirs (concat (map (lambda ((p rpp)) (tagcase p (rpp (n off ens ehs) (map (lambda ((y symbol)) (symbol->string y)) ehs)))) ps)))
               (all (onto left (filter (lambda ((h string)) (not (string-member? h left))) theirs)))
               (moved (concat (map (lambda ((p rpp))
                                      (tagcase p
                                        (rpp (n off ens ehs)
                                          (map (lambda ((x rp-node))
                                                 (product (1 (+ (extract x 1) off)) (2 (extract x 2)) (3 (extract x 3)) (4 (extract x 4))
                                                          (5 (map (lambda ((a rp-operand)) (rp-moved a off ehs all)) (extract x 5)))))
                                               ens))))
                                    ps)))
               (holes (map (lambda ((h string)) (string->symbol h)) hs))
               (mine (map (lambda ((x rp-node))
                            (product (1 (extract x 1)) (2 (extract x 2)) (3 (extract x 3)) (4 (extract x 4))
                                     (5 (rp-filled-args (extract x 5) (extract x 3) holes ps all moved))))
                          ns)))
          (rexp (onto mine moved) all root d))))))

(define rp-same? (subr kfx (rp-operand rp-operand) bool)
  (lambda (a b)
    (tagcase a
      (node j (tagcase b (node k (= j k)) (else other #f)))
      (hole j (tagcase b (hole k (= j k)) (else other #f)))
      (bound p (tagcase b (bound q (and (= (extract p 1) (extract q 1)) (= (extract p 2) (extract q 2)))) (else other #f)))
      (else other #f))))

"A canonical rep's nodes, a set's members each once (Fixpt's `fill::dedup`)."
(define-rec
  (rp-once (subr kfx (rp-operands) rp-operands)
    (lambda (as)
      (cond ((null? as) nil)
            ((any? (lambda ((b rp-operand)) (rp-same? (car as) b)) (cdr as)) (rp-once (cdr as)))
            (else (cons (car as) (rp-once (cdr as))))))))

"Evidence's words given: each a rep's binary form, the variable it is for
 named, in the order `names` says."
(define-rec
  (evidence-given (subr (maxeff hp (alloc @h)) (i64 strings i64) (listof rpe acyclic))
    (lambda (prod names i)
      (if (null? names)
          nil
          (let ((got ((proj rep-nodes @h) (word-kfx-bytes (obj-ref prod i)) nil)))
            (cons (rpe (car names) (extract got 1) (extract got 2)) (evidence-given prod (cdr names) (i64+ i 1))))))))

"A region a variable names, given no evidence: one of its own, named
 afresh, `%region-N`, never another (Fixpt's rule)."
(define fresh-regions (ref i64 @h) (new 0))

(define-rec
  (fresh-evidence! (subr hp (strings strings) (listof rpe acyclic))
    (lambda (holes named)
      (cond ((null? holes) nil)
            ((or (not (has-prefix? (car holes) "'")) (string-member? (car holes) named)) (fresh-evidence! (cdr holes) named))
            (else
             (let ((k (get fresh-regions)))
               (begin
                 (set fresh-regions (i64+ k 1))
                 (cons (rpe (car holes)
                            (list (product (1 0) (2 'evidence) (3 #f) (4 nil) (5 (list (the rp-operand (sum node 1)))))
                                  (product (1 1) (2 'rconst) (3 #f) (4 nil)
                                           (5 (list (the rp-operand (sum sym (string->symbol (string-append "%region-" (i64->string k)))))))))
                            nil)
                       (fresh-evidence! (cdr holes) named)))))))))

(define rep-filled! (subr (maxeff hp (alloc @h)) (i64 i64 string) (bytevectorof @h))
  (lambda (rep given names)
    "Rep `rep`'s binary form, its holes filled from the evidence `given`
     holds, for the variables `names` names: canonical, each set's members
     once."
    (let* ((got ((proj rep-nodes @h) (word-kfx-bytes rep) nil))
           (main (rexp (extract got 1) (map (lambda ((y symbol)) (symbol->string y)) (extract got 2)) 0 ""))
           (named (spaced-words names))
           (es (onto (evidence-given given named 1)
                     (fresh-evidence! (map (lambda ((y symbol)) (symbol->string y)) (extract got 2)) named)))
           (canonical (lambda ((r rexp))
                   (tagcase r
                     (rexp (ns hs root d) (the (bytevectorof @h) (rep-of-nodes ns (map (lambda ((h string)) (string->symbol h)) hs) root))))))
           (b (canonical (rp-filled main es)))
           (again ((proj rep-nodes @h) b nil)))
      (canonical (rexp (map (lambda ((x rp-node)) (if (extract x 3) (product (1 (extract x 1)) (2 (extract x 2)) (3 #t) (4 (extract x 4)) (5 (rp-once (extract x 5)))) x))
                       (extract again 1))
                  (map (lambda ((y symbol)) (symbol->string y)) (extract again 2)) 0 "")))))

"`(%reify given REP names)`: evidence, its rep filled."
(define reify-run! (subr (maxeff hp (alloc @h)) (i64 i64 i64) i64)
  (lambda (given rep names) (kfx-bytes-word! (rep-filled! rep given (word-string names)))))

(define stage-run! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64 i64 i64) i64)
  (lambda (m code given rep names)
    "`(%stage-run m code given rep names)`: `(sum ok THUNK)`, the code made a
     procedure over module `m`, checked against `rep` filled from the
     evidence given (C307); or `(sum failed WHY)`."
    (let* ((t ((proj rep-ty @h) (rep-filled! rep given (word-string names))))
           (thunk (staged-thunk (word-sexp code)))
           (prog (staged-program thunk))
           (why (stage-worked prog t)))
      (if (not (string=? why ""))
          (stage-failure-word! (refusal-said why))
          (let* ((s (stage-checked prog t))
                 (gs (with-entries (tagcase s (st (sbs k fs ns) fs))))
                 (body (lower thunk (list (list "stage-module")) gs))
                 (l (number! body))
                 (e (alloc! ob-env 2))
                 (p (alloc! ob-proc 2)))
            (begin (obj-set! e 0 w-nil) (obj-set! e 1 m)
                   (obj-set! p 0 (code-word l)) (obj-set! p 1 e)
                   (sum-word! "ok" p)))))))


"Sessions (C310; Fixpt's `docs/fx26.md`, \"Sessions\", and its
 `sessions.rs`, lowered): definitions that last between pieces of code a
 program stages against a module. A session's state is the checker's
 environment of the standard one and the session's own definitions, its
 globals, past the program's, and its definitions' forms, which the
 redefinition rules of the `--check` driver (C202) read: a definition
 again at a type its users can take assigns its global; at another,
 `shadow` makes it a new one, what used the old keeping it, and `rerun`
 checks the users again, each that checks run again, the rest broken.
 The session, a vector `#(m index)`, names its state by its index here,
 made at its first use, when the module's type is known: a global holding
 `m`, and one for each of `m`'s values, which the session's own may
 shadow. A pending definition is `#(session index)`, its index among
 `pendings`. Reading a session's global is reading the session, which its
 forms' types say (`(read r)`), not part of the code's `E`: the checker's
 `%session` mark (`naming-effs`)."

(define-datatype defn (defn strings sexp))
(define-type defns (listof defn acyclic))
(define-datatype rerun-out (rerun-out cv strings))

(define defn-names (subr kfx (defn) strings) (lambda (d) (tagcase d (defn (ns f) ns))))

(define defined-names-of (subr kfx (sexp) strings)
  (lambda (f)
    "The globals a top-level form defines: a `define`'s, a `define*`'s, a
     `define-rec`'s."
    (cond ((and (or (head-is? f "define") (head-is? f "define*")) (i64>= (size (items f)) 3)
                (not (module-def? f)))
           (list (binder-name (second (items f)))))
          ((head-is? f "define-rec") (map (lambda ((g sexp)) (binder-name (car (items g)))) (cdr (items f))))
          (else nil))))

(define rerun-needed? (subr kfx (cv cv strings) bool)
  (lambda (old new names)
    "Whether a global of `names`, defined before, is now at a type its uses
     may not take."
    (any? (lambda ((n string))
            (let ((a (scope-bind n old)) (b (scope-bind n new)))
              (and (not (null? a)) (not (null? b))
                   (tagcase (car a)
                     (bind (n1 sa wa)
                       (and (or (string=? wa "global") (string=? wa "broken"))
                            (tagcase (car b)
                              (bind (n2 sb wb)
                                (not (or (string=? (scheme-text sa) (scheme-text sb)) (narrower-effect? sb sa)))))))))))
          names)))

(define-rec
  (users-of (subr kfx (defns strings) defns)
    (lambda (ds used)
      "The definitions among `ds` that use a name of `used`, and those that
       use theirs, oldest first."
      (cond ((null? ds) nil)
            ((tagcase (car ds) (defn (ns f) (any? (lambda ((n string)) (string-member? n used)) (names-in f))))
             (cons (car ds) (users-of (cdr ds) (onto (defn-names (car ds)) used))))
            (else (users-of (cdr ds) used))))))

(define broken-binds (subr kfx (cv strings) binds)
  (lambda (v names)
    (concat (map (lambda ((n string))
                   (let ((b (scope-bind n v)))
                     (if (null? b) nil (tagcase (car b) (bind (m sc w) (the binds (list (bind n sc "broken"))))))))
                 names))))

"The machine's globals and their names, and where a product keeps a
 label (vm.kfx's, here since a session makes globals, C310)."
(define globals (ref (flatarrayof i64 @h) @h) (new (make-flatarray-i64 1 0)))
(define global-name-table (ref (arrayof string @h) @h) (new (make-array 1 "")))

(define-rec
  (label-position (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64 i64) i64)
    (lambda (start n l i)
      (cond ((i64>= i n) -1)
            ((i64= (kid-at (i64+ start i)) l) i)
            (else (label-position start n l (i64+ i 1)))))))

"A session's global: a name and its index."
(define-datatype sglobal (sglobal string i64))
(define-type sglobals (listof sglobal acyclic))

"A session's state: its checker's environment, its globals (the newest
 first), its definitions (the oldest first) and how many commits it has
 had."
(define-datatype sess (sess cv sglobals defns i64))
(define-type sesss (listof sess acyclic))

"A pending definition: its session's index, the generation it was checked
 at, its name, its form, its type, and whether it was committed."
(define-datatype pend (pend i64 i64 string sexp ty bool))
(define-type pends (listof pend acyclic))

(define sessions (ref sesss @h) (new nil))
(define pendings (ref pends @h) (new nil))
"The machine's globals' names, an index each, as `lower.kfx` has them: a
 program's, made at loading (`load!`); the REPL's, which grow as it
 defines (C65); and the sessions' (C310), each named as Fixpt's lowering
 names it, `fx26-session-K:NAME`, so that what defines a global after them
 has an index of its own."
(define machine-globals (ref strings @h) (new nil))
"The labels of `session-redefinition`'s product, made at loading."
(define redefinition-labels (ref i64 @h) (new -1))

(define-rec
  (nth-sess (subr kfx (sesss i64) sess)
    (lambda (ss i) (if (i64= i 0) (car ss) (nth-sess (cdr ss) (i64- i 1))))))
(define-rec
  (sess-replaced (subr kfx (sesss i64 sess) sesss)
    (lambda (ss i x) (if (i64= i 0) (cons x (cdr ss)) (cons (car ss) (sess-replaced (cdr ss) (i64- i 1) x))))))
(define-rec
  (nth-pend (subr kfx (pends i64) pend)
    (lambda (ps i) (if (i64= i 0) (car ps) (nth-pend (cdr ps) (i64- i 1))))))
(define-rec
  (pend-replaced (subr kfx (pends i64 pend) pends)
    (lambda (ps i x) (if (i64= i 0) (cons x (cdr ps)) (cons (car ps) (pend-replaced (cdr ps) (i64- i 1) x))))))

(define-rec
  (sglobal-of (subr kfx (sglobals string) i64)
    (lambda (gl n)
      "The index of the session's global named `n`, the newest; -1 if none."
      (cond ((null? gl) -1)
            ((tagcase (car gl) (sglobal (m i) (string=? m n))) (tagcase (car gl) (sglobal (m i) i)))
            (else (sglobal-of (cdr gl) n))))))

(define-rec
  (sglobal-name (subr kfx (sglobals sglobals i64) string)
    (lambda (gl all i)
      "The name of the session's global `i` if it is its name's newest; ``
       if not, or none."
      (cond ((null? gl) "")
            ((tagcase (car gl) (sglobal (m j) (i64= i j)))
             (tagcase (car gl) (sglobal (m j) (if (i64= (sglobal-of all m) i) m ""))))
            (else (sglobal-name (cdr gl) all i))))))

(define session-gs (subr hp (sglobals facts) strings)
  (lambda (gl fs)
    "The globals' names a session's code is lowered with: the program's
     unnamed, which it cannot see; the session's, each by its name where
     it is its name's newest; then the facts' entries (`with-entries`)."
    (onto (map (lambda ((i i64)) (sglobal-name gl gl i)) (counting 0 (size (get machine-globals)))) (with-entries fs))))

(define session-prefix (subr kfx (i64) string)
  (lambda (k) (string-append "fx26-session-" (string-append (i64->string k) ":"))))

(define session-global! (subr (maxeff hp (alloc @h)) (i64 string i64) i64)
  (lambda (k n w)
    "A new global of session `k`, its name `n` there, of value `w`: the
     machine's next, `fx26-session-K:n`, the globals' array and their
     names' grown if need be."
    (let* ((i (size (get machine-globals)))
           (full (string-append (session-prefix k) n))
           (old (get globals))
           (names (get global-name-table)))
      (begin
        (set machine-globals (onto (get machine-globals) (list full)))
        (if (i64< i (flatarray-length-i64 old))
            #u
            (let ((bigger (the (flatarrayof i64 @h) (make-flatarray-i64 (i64* (i64+ i 1) 2) w-unbound))))
              (begin (words-copied! old bigger 0 (flatarray-length-i64 old)) (set globals bigger))))
        (if (i64< i (int->i64 (array-length names)))
            #u
            (let ((more (the (arrayof string @h) (make-array (i64->int (i64* (i64+ i 1) 2)) ""))))
              (begin (names-copied! names more 0 (int->i64 (array-length names))) (set global-name-table more))))
        (array-set! (get global-name-table) (i64->int i) full)
        (flatarray-set-i64! (get globals) i w)
        i))))

(define module-field (subr (maxeff hp (alloc @h)) (i64 string) i64)
  (lambda (m n)
    "Module value `m`'s value named `n` (a product's field, as `extract`
     finds it)."
    (let ((i (label-position (fixnum-value (obj-ref m 0)) (i64- (obj-size m) 1) (intern! n) 0)))
      (if (i64< i 0) w-unbound (obj-ref m (i64+ i 1))))))

(define session-marks (subr kfx () binds)
  (lambda ()
    (list (bind "%session" (scheme nil (ty-unit)) "mark") (bind "%reruns" (scheme nil (ty-unit)) "mark"))))

(define session-top (subr kfx (cv sexp) cv)
  (lambda (v form)
    "A session's definition checked, as the REPL checks a form: one written
     with no type, its type found (`check-untyped`)."
    (if (untyped? form)
        (tagcase (check-untyped v form) (elab (v2 more) (at v2 "staged code" nil)))
        (check-top v form))))

(define-rec
  (seeded (subr (maxeff hp (alloc @h)) (i64 cv sglobals i64 strings) sess)
    (lambda (k v gl m ns)
      "`m`'s values each defined in the session, `(define x (with
       stage-module x))`, its global holding `m`'s."
      (if (null? ns)
          (sess v gl nil 0)
          (let* ((n (car ns))
                 (form (lst (list (sym "define" stage-file 0) (sym n stage-file 0)
                                  (lst (list (sym "with" stage-file 0) (sym "stage-module" stage-file 0) (sym n stage-file 0)) stage-file 1 (stage-at!)))
                            stage-file 1 (stage-at!)))
                 (v2 (session-top v form))
                 (i (session-global! k n (module-field m n))))
            (seeded k v2 (cons (sglobal n i) gl) m (cdr ns)))))))

(define session-state! (subr (maxeff hp (alloc @h)) (i64 ty) i64)
  (lambda (sw mt)
    "The index of session `sw`'s state, made first if it has none, of
     module type `mt`."
    (let ((k (fixnum-value (obj-ref sw 1))))
      (if (i64>= k 0)
          k
          (let* ((k2 (size (get sessions)))
                 (m (obj-ref sw 0))
                 (v (with-binds (stage-cv) (cons (bind "stage-module" (scheme nil mt) "global") (session-marks))))
                 (gm (session-global! k2 "stage-module" m))
                 (vals (map mitem-name (filter (lambda ((x ty)) (string=? (mitem-kind x) "%val")) (mtype-items mt))))
                 (made (seeded k2 v (list (sglobal "stage-module" gm)) m vals)))
            (begin
              (set sessions (onto (get sessions) (list made)))
              (obj-set! sw 1 (fixnum k2))
              k2))))))

(define make-session-word! (subr (maxeff hp (alloc @h)) (i64) i64)
  (lambda (m)
    "`(make-session m)`: `#(m -1)`, its state made at its first use."
    (let ((s (alloc! ob-vector 2))) (begin (obj-set! s 0 m) (obj-set! s 1 (fixnum -1)) s))))

"A check by a worker, as `stage-worked`'s: `` if it passed, else the
 refusal. `kind` 0, `form` an expression checked against `t`; 1, a
 top-level form."
(define session-verdict (subr kfx (cv sexp ty i64) string)
  (lambda (v form t kind)
    (begin
      (if (i64= kind 0)
          (begin ((with expressions check) (at v "staged code" nil) (new-state) form t) #u)
          (begin (session-top v form) #u))
      "")))

(define* session-worked (subr (maxeff (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet spin (read @globals)) (cv sexp ty i64) string)
  (lambda (v form t kind)
    (let* ((out (the (icell string @q) (make-icell)))
           (relay (the (addr string @q) (spawn (box string r) (icell-put! out (receive box))))))
      (begin
        (the (addr unit @w) (spawn-monitored relay stage-refused (box unit r) (send relay (session-verdict v form t kind))))
        (icell-get out)))))

(define stage-failed-word! (subr (maxeff hp (alloc @h)) (string string) i64)
  (lambda (kind m)
    "`(sum failed (product (kind (sum KIND #u)) (message m) (start 0) (end 0)))`."
    (let* ((k (sum-word! kind w-unit)) (msg (string-word! m)) (p (alloc! ob-product 5)))
      (begin (obj-set! p 0 (fixnum (get stage-failure-labels))) (obj-set! p 1 k) (obj-set! p 2 msg)
             (obj-set! p 3 (fixnum 0)) (obj-set! p 4 (fixnum 0)) (sum-word! "failed" p)))))

(define thunk-word! (subr (maxeff vm loading) (ir) i64)
  (lambda (lam)
    "Procedure `lam`, lowered at the top, a closure over nothing."
    (let* ((l (number! lam)) (e (alloc! ob-env 2)) (p (alloc! ob-proc 2)))
      (begin (obj-set! e 0 w-nil) (obj-set! e 1 w-unit)
             (obj-set! p 0 (code-word l)) (obj-set! p 1 e)
             p))))

(define session-scope (subr kfx () scope) (lambda () (list (list "%session"))))

(define session-thunk (subr hp (sexp) sexp)
  (lambda (e)
    (lst (list (sym "lambda" stage-file (stage-at!)) (lst nil stage-file 1 (stage-at!)) e) stage-file 1 (stage-at!))))

(define session-expression! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 sess sexp ty) i64)
  (lambda (k st code t)
    "An expression in session `k`: `(sum ok (sum expression p))`, `p` the
     procedure that evaluates it, checked at `t`, `(subr E () R)`; or why
     not."
    (tagcase st
      (sess (v gl ds g)
        (let* ((thunk (session-thunk code))
               (why (session-worked v thunk t 0)))
          (if (not (string=? why ""))
              (stage-failure-word! (refusal-said why))
              (let* ((s (tagcase ((with expressions check) (at v "staged code" nil) (new-state) thunk t) (res (u es s) s)))
                     (gs (session-gs gl (onto (tagcase s (st (sbs n fs ns) fs)) (cv-facts v))))
                     (p (thunk-word! (lower thunk (session-scope) gs))))
                (sum-word! "ok" (sum-word! "expression" p)))))))))

(define definition-parts (subr kfx (sexp) sexps)
  (lambda (code)
    "`(define name init)` or `(define name type init)`: its name and its
     initializer; none if neither."
    (let ((xs (items code)))
      (if (and (or (i64= (size xs) 3) (i64= (size xs) 4)) (tagcase (second xs) (sym (n f p) #t) (else other #f)))
          (list (second xs) (last xs))
          nil))))

(define session-define! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 sess sexp ty) i64)
  (lambda (sw k st code t)
    "A definition in session `k`, checked against it as it is, its
     initializer, unless a `lambda`, within `E` (`t` is `(subr E () R)`):
     `(sum ok (sum definition d))`, `d` pending; or why not."
    (tagcase st
      (sess (v gl ds g)
        (let ((parts (definition-parts code)))
          (if (null? parts)
              (stage-failed-word! "malformed" "a definition is `(define name init)` or `(define name type init)`")
              (let* ((name (sym-name (car parts)))
                     (init (second parts))
                     (why (session-worked v code t 1)))
                (if (not (string=? why ""))
                    (stage-failure-word! (refusal-said why))
                    (let* ((v2 (session-top v code))
                           (found (scope-bind name v2))
                           (dt (if (null? found) (ty-unit) (tagcase (car found) (bind (n sc w) (tagcase sc (scheme (tvs u) u))))))
                           (es (tagcase t (ty-proc (es ps r) es) (else other nil)))
                           (bounded (if (head-is? init "lambda") "" (session-worked v (session-thunk init) (ty-proc es nil dt) 0))))
                      (if (not (string=? bounded ""))
                          (stage-failure-word! (refusal-said bounded))
                          (let* ((i (size (get pendings)))
                                 (d (alloc! ob-vector 2)))
                            (begin
                              (set pendings (onto (get pendings) (list (pend k g name code dt #f))))
                              (obj-set! d 0 sw) (obj-set! d 1 (fixnum i))
                              (sum-word! "ok" (sum-word! "definition" d))))))))))))))

(define session-run! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64 i64 i64) i64)
  (lambda (sw code given rep names)
    "`(%session-run s code given rep names)`, `session-check`'s: the code an
     expression or a definition, checked in session `s` against `rep`,
     `(subr pure (M) (subr E () R))`, filled from the evidence given."
    (let* ((whole ((proj rep-ty @h) (rep-filled! rep given (word-string names))))
           (mt (tagcase whole (ty-proc (es ps r) (car ps)) (else other whole)))
           (t (tagcase whole (ty-proc (es ps r) r) (else other whole)))
           (k (session-state! sw mt))
           (st (nth-sess (get sessions) k))
           (c (word-sexp code)))
      (if (head-is? c "define")
          (session-define! sw k st c t)
          (session-expression! k st c t)))))

(define pending-of (subr hp (i64) pend)
  (lambda (d) (nth-pend (get pendings) (fixnum-value (obj-ref d 1)))))

(define-rec
  (direct-users (subr kfx (defns string) strings)
    (lambda (ds n)
      "The names the definitions among `ds` define that use `n`, not
       defining it themselves."
      (if (null? ds)
          nil
          (tagcase (car ds)
            (defn (ns f)
              (onto (if (and (string-member? n (names-in f)) (not (string-member? n ns))) ns nil)
                    (direct-users (cdr ds) n))))))))

(define redefines-word! (subr (maxeff hp (alloc @h)) (i64 i64) i64)
  (lambda (sw d)
    "`(session-redefines s d)`: `(sum fresh #u)`, or `(sum redefines r)`, `r`
     the name, its type and the new one, and the session's definitions
     that use it."
    (tagcase (pending-of d)
      (pend (k g name form dt used)
        (let* ((st (nth-sess (get sessions) k))
               (found (tagcase st (sess (v gl ds g2) (scope-bind name v)))))
          (if (or (null? found) (tagcase (car found) (bind (n sc w) (not (or (string=? w "global") (string=? w "broken"))))))
              (sum-word! "fresh" w-unit)
              (let* ((old (tagcase (car found) (bind (n sc w) (tagcase sc (scheme (tvs u) (show-ty (new-state) u))))))
                     (users (tagcase st (sess (v gl ds g2) (direct-users ds name))))
                     (p (alloc! ob-product 5)))
                (begin
                  (obj-set! p 0 (fixnum (get redefinition-labels)))
                  (obj-set! p 1 (string-word! name)) (obj-set! p 2 (string-word! old))
                  (obj-set! p 3 (string-word! (show-ty (new-state) dt))) (obj-set! p 4 (strings-word! users))
                  (sum-word! "redefines" p)))))))))

"What a commit runs: each definition, its global and its form."
(define-datatype runs (runs i64 sexp))
(define-type runss (listof runs acyclic))

(define-datatype rerun-made (rerun-made cv sglobals runss))

(define-rec
  (session-reruns (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (cv sglobals defns string runss) rerun-made)
    (lambda (v gl us redefined made)
      "Each user in turn checked again: each that checks run again, at its
       global; each that does not broken, as Fixpt says it."
      (if (null? us)
          (rerun-made v gl made)
          (tagcase (car us)
            (defn (ns form)
              (let ((why (session-worked v form (ty-unit) 1)))
                (if (string=? why "")
                    (session-reruns (session-top v form) gl (cdr us) redefined
                                    (onto made (map (lambda ((n string)) (runs (sglobal-of gl n) form)) ns)))
                    (session-reruns (with-binds v (onto (broken-binds v ns)
                                                        (map (lambda ((n string)) (bind (string-append "%broken-why " n) (scheme nil (ty-unit))
                                                                                        (string-append "since `" (string-append redefined (string-append "` was redefined (" (string-append (refusal-said why) ")"))))))
                                                             ns)))
                                    gl (cdr us) redefined made)))))))))

(define decision-tag (subr hp (i64) string)
  (lambda (w) (if (is-obj? w ob-sum) (name-of-number (fixnum-value (obj-ref w 0))) "")))

(define run-ir (subr kfx (strings runs) ir)
  (lambda (gs r)
    "A form run by a commit: its global given its initializer's value."
    (tagcase r
      (runs (i form)
        (let ((xs (items form)))
          (i-define i (named (sym-name (second xs)) (lower (last xs) (cons nil (session-scope)) gs))))))))

(define ready-word! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64) i64)
  (lambda (sw d decision)
    "`(%session-ready s d decision)`: `d` committed as `decision` says, then
     `(sum go p)`, `p` the procedure that runs the definition, and what
     runs again, for the program to call; or why not."
    (tagcase (pending-of d)
      (pend (k g name form dt used)
        (let ((st (nth-sess (get sessions) k)))
          (tagcase st
            (sess (v gl ds g2)
              (let* ((found (scope-bind name v))
                     (existed (and (not (null? found)) (tagcase (car found) (bind (n sc w) (or (string=? w "global") (string=? w "broken"))))))
                     (how (decision-tag decision)))
                (cond ((not (i64= (obj-ref d 0) sw)) (stage-failed-word! "stale" "this definition was checked against another session"))
                      (used (stage-failed-word! "stale" "this definition was committed already"))
                      ((not (i64= g g2)) (stage-failed-word! "stale" "the session changed since this definition was checked: check it again"))
                      ((and existed (string=? how "refuse"))
                       (stage-failed-word! "refused" (string-append "`" (string-append name "` is defined already, and the redefinition was refused"))))
                      (else
                       (let* ((v2 (session-top v form))
                              (needed (and existed (rerun-needed? v v2 (list name))))
                              (i (if (and existed (not needed)) (sglobal-of gl name) (session-global! k name w-unbound)))
                              (gl2 (if (and existed (not needed)) gl (cons (sglobal name i) gl)))
                              (kept (filter (lambda ((x defn)) (not (string-member? name (defn-names x)))) ds))
                              (again (if (and needed (string=? how "rerun"))
                                         (session-reruns v2 gl2 (users-of kept (list name)) name nil)
                                         (rerun-made v2 gl2 nil))))
                         (tagcase again
                           (rerun-made (v3 gl3 more)
                             (let* ((gs (session-gs gl3 (cv-facts v3)))
                                    (body (i-seq (onto (map (lambda ((r runs)) (run-ir gs r)) (cons (runs i form) more)) (list (i-lit (v-unit))))))
                                    (p (thunk-word! (i-lambda 0 body "" ""))))
                               (begin
                                 (set sessions (sess-replaced (get sessions) k (sess v3 gl3 (onto kept (list (defn (list name) form))) (i64+ g2 1))))
                                 (set pendings (pend-replaced (get pendings) (fixnum-value (obj-ref d 1)) (pend k g name form dt #t)))
                                 (sum-word! "go" p))))))))))))))))

(define committed-word! (subr (maxeff hp (alloc @h)) (i64 i64) i64)
  (lambda (sw d)
    "`(%session-committed! s d)`: `(sum defined NAME)`."
    (tagcase (pending-of d) (pend (k g name form dt used) (sum-word! "defined" (string-word! name))))))
