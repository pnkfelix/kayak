"vstage.kfx: `stage` on the engine (C305; Fixpt's `docs/fx26.md`,
 \"Staging code\"): the code a program gives, a datum, checked as the
 program runs against what the checker noted at the stage, a rep, and made
 a procedure; or why not, a value. What is no machine's is staging.kfx's
 (C336); here, the code, once it passes, lowered and numbered, and made a
 closure over the module, which its frame holds; and sessions."

(define stage-run! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64 i64 i64) i64)
  (lambda (m code given rep names)
    "`(%stage-run m code given rep names)`: `(sum ok THUNK)`, the code made a
     procedure over module `m`, checked against `rep` filled from the
     evidence given (C307); or `(sum failed WHY)`."
    (let* ((t ((proj rep-ty @c) (rep-filled! rep given (word-string names))))
           (thunk (staged-thunk (code-sexp! code)))
           (prog (staged-program thunk))
           (why (stage-worked prog t)))
      (if (not (string=? why ""))
          (refused-word! why)
          (let* ((s (stage-checked prog t))
                 (gs (with-entries (tagcase s (st (sbs k fs ns) fs))))
                 (body (lower thunk (list (list "stage-module")) gs))
                 (l (number! body))
                 (e (alloc! ob-env 2))
                 (p (alloc! ob-proc 2)))
            (begin (bloblet-value-set! e 0 w-nil) (bloblet-value-set! e 1 m)
                   (bloblet-value-set! p 0 (code-word l)) (bloblet-value-set! p 1 e)
                   (sum-word! "ok" p)))))))

"The machine's globals and their names (vm.kfx's, here since a session
 makes globals, C310)."
(define globals (ref (flatarrayof i64 @c) @c) (new (make-flatarray-i64 1 0)))
(define global-name-table (ref (arrayof string @c) @c) (new (make-array 1 "")))

"The machine's globals' names, an index each, as `lower.kfx` has them: a
 program's, made at loading (`load!`); the REPL's, which grow as it
 defines (C65); and the sessions' (C310), each named as Fixpt's lowering
 names it, `fx26-session-K:NAME`, so that what defines a global after them
 has an index of its own."
(define machine-globals (ref strings @c) (new nil))
"The labels of `session-redefinition`'s product, made at loading."
(define redefinition-labels (ref i64 @c) (new -1))

(define session-gs (subr hp (sglobals facts) strings)
  (lambda (gl fs)
    "The globals' names a session's code is lowered with: the program's
     unnamed, which it cannot see; the session's, each by its name where
     it is its name's newest; then the facts' entries (`with-entries`)."
    (onto (map (lambda ((i i64)) (sglobal-name gl gl i)) (counting 0 (size (get machine-globals)))) (with-entries fs))))

(define session-global! (subr (maxeff hp (alloc @c)) (i64 string i64) i64)
  (lambda (k n w)
    "A new global of session `k`, its name `n` there, of value `w`: the
     machine's next, `fx26-session-K:n`, the globals' array and their
     names' grown if need be."
    (let* ((i (size (get machine-globals)))
           (full (numbered-global (string-append (session-prefix k) n) (get machine-globals)))
           (old (get globals))
           (names (get global-name-table)))
      (begin
        (set machine-globals (onto (get machine-globals) (list full)))
        (if (i64< i (flatarray-length-i64 old))
            #u
            (let ((bigger (the (flatarrayof i64 @c) (make-flatarray-i64 (i64* (i64+ i 1) 2) w-unbound))))
              (begin (words-copied! old bigger 0 (flatarray-length-i64 old)) (set globals bigger))))
        (if (i64< i (int->i64 (array-length names)))
            #u
            (let ((more (the (arrayof string @c) (make-array (i64->int (i64* (i64+ i 1) 2)) ""))))
              (begin (names-copied! names more 0 (int->i64 (array-length names))) (set global-name-table more))))
        (array-set! (get global-name-table) (i64->int i) full)
        (flatarray-set-i64! (get globals) i w)
        i))))

(define-rec
  (seeded (subr (maxeff hp (alloc @c)) (i64 cv sglobals i64 strings i64) sess)
    (lambda (k v gl m ns i)
      "`m`'s values each defined in the session, `(define x (with
       stage-module x))`, its global holding `m`'s: a product, its values in
       its type's order (C328), `ns`, from `i`."
      (if (null? ns)
          (sess v gl nil 0)
          (let* ((n (car ns))
                 (form (lst (list (sym "define" stage-file 0) (sym n stage-file 0)
                                  (lst (list (sym "with" stage-file 0) (sym "stage-module" stage-file 0) (sym n stage-file 0)) stage-file 1 (stage-at!)))
                            stage-file 1 (stage-at!)))
                 (v2 (session-top v form))
                 (g (session-global! k n (bloblet-value m i))))
            (seeded k v2 (cons (sglobal n g) gl) m (cdr ns) (i64+ i 1)))))))

(define session-state! (subr (maxeff hp (alloc @c)) (i64 ty) i64)
  (lambda (sw mt)
    "The index of session `sw`'s state, made first if it has none, of
     module type `mt`."
    (let ((k (fixnum-value (obj-ref sw 1))))
      (if (i64>= k 0)
          k
          (let* ((k2 (size (get sessions)))
                 (m (obj-ref sw 0))
                 ;; The module's types and effects in scope too, as a `with` of it
                 ;; opens them (C315; Fixpt's `stage/session-types.fx`), its abstract
                 ;; types named for it, `stage-module..t`, as Fixpt names them.
                 (rp-abs (data-names-with "rp.." mt))
                 (mt (data-renamed rp-abs (map (lambda ((n string)) (string-append "stage-module.." (after-prefix n "rp.."))) rp-abs) mt))
                 (v (module-types-opened
                     (with-binds (stage-cv) (cons (bind "stage-module" (scheme nil mt) "global") (session-marks)))
                     mt))
                 (gm (session-global! k2 "stage-module" m))
                 (vals (map mitem-name (filter (lambda ((x ty)) (string=? (mitem-kind x) "%val")) (mtype-items mt))))
                 (made (seeded k2 v (list (sglobal "stage-module" gm)) m vals 0)))
            (begin
              (set sessions (onto (get sessions) (list made)))
              (obj-set! sw 1 (fixnum k2))
              k2))))))

(define thunk-word! (subr (maxeff vm loading) (ir) i64)
  (lambda (lam)
    "Procedure `lam`, lowered at the top, a closure over nothing."
    (let* ((l (number! lam)) (e (alloc! ob-env 2)) (p (alloc! ob-proc 2)))
      (begin (bloblet-value-set! e 0 w-nil) (bloblet-value-set! e 1 w-unit)
             (bloblet-value-set! p 0 (code-word l)) (bloblet-value-set! p 1 e)
             p))))

(define session-scope (subr kfx () scope) (lambda () (list (list "%session"))))

(define session-expression! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 sess sexp ty) i64)
  (lambda (k st code t)
    "An expression in session `k`: `(sum ok (sum expression p))`, `p` the
     procedure that evaluates it, checked at `t`, `(subr E () R)`; or why
     not."
    (tagcase st
      (sess (v gl ds g)
        (let* ((thunk (session-thunk code))
               (why (session-worked v thunk t 0)))
          (if (not (string=? why ""))
              (refused-word! why)
              (let* ((s (tagcase ((with expressions check) (at v "staged code" nil) (new-state) thunk t) (res (u es s) s)))
                     (gs (session-gs gl (onto (tagcase s (st (sbs n fs ns) fs)) (cv-facts v))))
                     (p (thunk-word! (lower thunk (session-scope) gs))))
                (sum-word! "ok" (sum-word! "expression" p)))))))))

(define session-run! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64 i64 i64) i64)
  (lambda (sw code given rep names)
    "`(%session-run s code given rep names)`, `session-check`'s: the code an
     expression or a definition, checked in session `s` against `rep`,
     `(subr pure (M) (subr E () R))`, filled from the evidence given."
    (let* ((whole ((proj rep-ty @c) (rep-filled! rep given (word-string names))))
           (mt (tagcase whole (ty-proc (es ps r) (car ps)) (else other whole)))
           (t (tagcase whole (ty-proc (es ps r) r) (else other whole)))
           (k (session-state! sw mt))
           (st (nth-sess (get sessions) k))
           (c (code-sexp! code)))
      (if (head-is? c "define")
          (session-define! sw k st c t)
          (session-expression! k st c t)))))

(define run-ir (subr kfx (strings runs) ir)
  (lambda (gs r)
    "A form run by a commit: its global given its initializer's value."
    (tagcase r
      (runs (i form)
        (let ((xs (items form)))
          (i-define i (named (sym-name (second xs)) (lower (last xs) (cons nil (session-scope)) gs))))))))

(define ready-word! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64) i64)
  (lambda (sw d decision)
    "`(%session-ready s d decision)`: `d` committed as `decision` says, then
     `(sum go p)`, `p` the procedure that runs the definition, and what
     runs again, for the program to call; or why not."
    (tagcase (pending-of d)
      (pend (k g name form dt used)
        (let ((st (nth-sess (get sessions) k)))
          (tagcase st
            (sess (v gl ds g2)
              (let* ((found (scope-bind name v))
                     (existed (and (not (null? found)) (tagcase (car found) (bind (n sc w) (or (string=? w "global") (string=? w "broken"))))))
                     (how (decision-tag decision)))
                (cond ((not (i64= (obj-ref d 0) sw)) (stage-failed-word! "stale" "this definition was checked against another session"))
                      (used (stage-failed-word! "stale" "this definition was committed already"))
                      ((not (i64= g g2)) (stage-failed-word! "stale" "the session changed since this definition was checked: check it again"))
                      ((and existed (string=? how "refuse"))
                       (stage-failed-word! "refused" (string-append "`" (string-append name "` is defined already, and the redefinition was refused"))))
                      (else
                       (let* ((v2 (session-top v form))
                              (needed (and existed (rerun-needed? v v2 (list name))))
                              (i (if (and existed (not needed)) (sglobal-of gl name) (session-global! k name w-unbound)))
                              (gl2 (if (and existed (not needed)) gl (cons (sglobal name i) gl)))
                              (kept (filter (lambda ((x defn)) (not (string-member? name (defn-names x)))) ds))
                              (again (if (and needed (string=? how "rerun"))
                                         (session-reruns v2 gl2 (users-of kept (list name)) name nil)
                                         (rerun-made v2 gl2 nil))))
                         (tagcase again
                           (rerun-made (v3 gl3 more)
                             (let* ((gs (session-gs gl3 (cv-facts v3)))
                                    (body (i-seq (onto (map (lambda ((r runs)) (run-ir gs r)) (cons (runs i form) more)) (list (i-lit (v-unit))))))
                                    (p (thunk-word! (i-lambda 0 body "" ""))))
                               (begin
                                 (set sessions (sess-replaced (get sessions) k (sess v3 gl3 (onto kept (list (defn (list name) form))) (i64+ g2 1))))
                                 (set pendings (pend-replaced (get pendings) (fixnum-value (obj-ref d 1)) (pend k g name form dt #t)))
                                 (sum-word! "go" p))))))))))))))))

