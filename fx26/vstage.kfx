"vstage.kfx: `stage` on the engine (C305; Fixpt's `docs/fx26.md`,
 \"Staging code\"): the code a program gives, a datum, checked as the
 program runs against what the checker noted at the stage, a rep, and made
 a procedure; or why not, a value. The check runs in a worker first, as
 the REPL's do (C111): the checker refuses by failing, which fails the
 worker alone, its refusal sent back. Once it passes, it is checked again
 here, for the facts its lowering reads, lowered and numbered, and made a
 closure over the module, which its frame holds."

"The datum's positions, each list's its own, so that what the checker
 notes of a part (a `with`'s, C213) the lowering finds."
(define stage-pos (ref i64 @h) (new 0))
(define stage-file string "<stage>")

(define stage-at! (subr hp () i64)
  (lambda () (let ((p (get stage-pos))) (begin (set stage-pos (i64+ p 1)) p))))

(define-rec
  (word-sexp (subr hp (i64) sexp)
    (lambda (w)
      "A datum's word as the reader would have read it."
      (cond ((fixnum? w) (num (fixnum-value w) (i64->string (fixnum-value w)) (stage-at!)))
            ((i64= w w-true) (sym "#t" stage-file (stage-at!)))
            ((i64= w w-false) (sym "#f" stage-file (stage-at!)))
            ((i64= w w-unit) (sym "#u" stage-file (stage-at!)))
            ((i64= w w-nil) (lst nil stage-file 1 (stage-at!)))
            ((keyword-word? w) (sym (string-append "#:" (name-of-number (i64- (immediate-value w) keyword-bias))) stage-file (stage-at!)))
            ((is-imm? w imm-symbol) (sym (name-of-number (immediate-value w)) stage-file (stage-at!)))
            ((is-imm? w imm-char) (chr (word-char w) stage-file (stage-at!)))
            ((is-obj? w ob-string) (str (word-string w) stage-file (stage-at!)))
            ((is-obj? w ob-big) (big (int->string (word-int w)) stage-file (stage-at!)))
            ((is-obj? w ob-real) (real (f64->string (word-real w)) stage-file (stage-at!)))
            ((is-pair? w) (let ((p (stage-at!))) (lst (pair-sexps w) stage-file 1 p)))
            (else (sym "%unread" stage-file (stage-at!))))))
  (pair-sexps (subr hp (i64) sexps)
    (lambda (w)
      (cond ((i64= w w-nil) nil)
            ((is-pair? w) (let ((a (word-sexp (pair-car w)))) (cons a (pair-sexps (pair-cdr w)))))
            (else (list (sym "." stage-file (stage-at!)) (word-sexp w)))))))

"What the staged code is checked as: `(lambda (stage-module) (lambda ()
 (with stage-module CODE)))`, against `(subr pure (M) (subr E () R))`."
(define staged-thunk (subr hp (sexp) sexp)
  (lambda (code)
    (let ((s (lambda ((n string)) (sym n stage-file (stage-at!))))
          (l (lambda ((xs sexps)) (lst xs stage-file 1 (stage-at!)))))
      (l (list (s "lambda") (l nil) (l (list (s "with") (s "stage-module") code)))))))

(define staged-program (subr hp (sexp) sexp)
  (lambda (thunk)
    (let ((s (lambda ((n string)) (sym n stage-file (stage-at!))))
          (l (lambda ((xs sexps)) (lst xs stage-file 1 (stage-at!)))))
      (l (list (s "lambda") (l (list (s "stage-module"))) thunk)))))

"The checker's environment a stage's code is checked in: the standard
 one alone, nothing of the program's but the module given."
(define stage-cv (subr kfx () cv)
  (lambda ()
    (let ((empty (cv nil nil nil nil "a type" nil "staged code" 0 nil nil 0 (bempty) nil)))
      (with-binds empty (prim-binds empty)))))

"The check: its state, whose facts the lowering reads; a refusal fails."
(define stage-checked (subr kfx (sexp ty) st)
  (lambda (prog t)
    (tagcase ((with expressions check) (at (stage-cv) "staged code" nil) (new-state) prog t) (res (u es s) s))))

(define stage-verdict (subr kfx (sexp ty) string)
  (lambda (prog t) (begin (stage-checked prog t) "")))

(define-rec
  (begins-with? (subr kfx (chars chars) bool)
    (lambda (cs pat) (or (null? pat) (and (not (null? cs)) (char=? (car cs) (car pat)) (begins-with? (cdr cs) (cdr pat)))))))

(define-rec
  (after-said (subr kfx (chars chars) chars)
    (lambda (cs pat)
      "What follows the first `in staged code: ` of a refusal; all of it if none."
      (cond ((null? cs) nil)
            ((begins-with? cs pat) (drop-chars cs (size pat)))
            (else (after-said (cdr cs) pat))))))

(define* stage-refused (subr pure (string) string) (lambda (m) (if (string=? m "") "refused" m)))

(define refusal-said (subr kfx (string) string)
  (lambda (m)
    "A refusal as its words alone: what the checker says after where."
    (let ((said (list->string (after-said (string-chars m) (string-chars "in staged code: ")))))
      (if (string=? said "") m said))))

(define* stage-worked (subr (maxeff (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet spin (read @globals)) (sexp ty) string)
  (lambda (prog t)
    "The check by a worker, whose watcher, a relay of one message, puts what
     it is sent where this waits: `` if it passed, else the refusal."
    (let* ((out (the (icell string @q) (make-icell)))
           (relay (the (addr string @q) (spawn (box string r) (icell-put! out (receive box))))))
      (begin
        (the (addr unit @w) (spawn-monitored relay stage-refused (box unit r) (send relay (stage-verdict prog t))))
        (icell-get out)))))

"The labels of `stage-failure`'s product, made at loading."
(define stage-failure-labels (ref i64 @h) (new -1))

(define stage-failure-word! (subr (maxeff hp (alloc @h)) (string) i64)
  (lambda (m)
    "`(sum failed (product (kind (sum refused #u)) (message m) (start 0) (end 0)))`:
     the place in the code no refusal of kayak's says yet."
    (let* ((k (sum-word! "refused" w-unit)) (msg (string-word! m)) (p (alloc! ob-product 5)))
      (begin (obj-set! p 0 (fixnum (get stage-failure-labels))) (obj-set! p 1 k) (obj-set! p 2 msg)
             (obj-set! p 3 (fixnum 0)) (obj-set! p 4 (fixnum 0)) (sum-word! "failed" p)))))

"Evidence (C307; Fixpt's `docs/fx26.md`, \"Evidence\", and its
 `fixpt_reps::fill`): a rep's holes filled from the evidence given for
 the variables they stand for, each piece of evidence a rep whose root is
 an `evidence` node of what it is of. A hole becomes that; one among an
 effect's atoms, its atoms, spliced into the set. Then canonical again,
 and a set's members each once."
(define-datatype rpe (rpe string rp-nodes (listof symbol acyclic)))

(define-rec
  (rp-max-slot (subr kfx (rp-nodes int) int)
    (lambda (ns m) (if (null? ns) m (rp-max-slot (cdr ns) (if (> (extract (car ns) 1) m) (extract (car ns) 1) m))))))

(define-rec
  (rp-index-in (subr kfx (strings string int) int)
    (lambda (xs n i) (cond ((null? xs) -1) ((string=? (car xs) n) i) (else (rp-index-in (cdr xs) n (+ i 1)))))))

(define rp-moved (subr kfx (rp-operand int (listof symbol acyclic) strings) rp-operand)
  (lambda (a off own all)
    "An evidence's operand, its nodes `off` past, its holes by name in `all`."
    (tagcase a
      (node j (the rp-operand (sum node (+ j off))))
      (bound p (the rp-operand (sum bound (product (1 (+ (extract p 1) off)) (2 (extract p 2))))))
      (hole h (the rp-operand (sum hole (rp-index-in all (nth-symbol own h) 0))))
      (else other a))))

(define-rec
  (rp-evidence-at (subr kfx ((listof rpe acyclic) string) (listof rpe acyclic))
    (lambda (es n) (cond ((null? es) nil) ((tagcase (car es) (rpe (m ns hs) (string=? m n))) (list (car es))) (else (rp-evidence-at (cdr es) n))))))

"Each evidence placed: its offset, and its root's operand moved."
(define-datatype rpp (rpp string int rp-nodes (listof symbol acyclic)))

(define-rec
  (rp-placed (subr kfx ((listof rpe acyclic) int) (listof rpp acyclic))
    (lambda (es off)
      (if (null? es)
          nil
          (tagcase (car es)
            (rpe (n ns hs) (cons (rpp n off ns hs) (rp-placed (cdr es) (+ off (+ (rp-max-slot ns 0) 1))))))))))

(define-rec
  (rp-placed-at (subr kfx ((listof rpp acyclic) string) (listof rpp acyclic))
    (lambda (ps n) (cond ((null? ps) nil) ((tagcase (car ps) (rpp (m off ns hs) (string=? m n))) (list (car ps))) (else (rp-placed-at (cdr ps) n))))))

(define rp-of-evidence (subr kfx (rpp strings) rp-operand)
  (lambda (p all)
    "What evidence is of: its root's one operand, moved."
    (tagcase p
      (rpp (n off ns hs)
        (let ((root (rp-node-at ns 0)))
          (if (null? root)
              (the rp-operand (sum int 0))
              (rp-moved (car (extract (car root) 5)) off hs all)))))))

(define-rec
  (rp-filled-args (subr kfx (rp-operands bool (listof symbol acyclic) (listof rpp acyclic) strings rp-nodes) rp-operands)
    (lambda (as set holes ps all ns-all)
      "A node's operands, each filled hole what its evidence is of; in a set,
       a set's members spliced."
      (if (null? as)
          nil
          (let ((rest (rp-filled-args (cdr as) set holes ps all ns-all)))
            (tagcase (car as)
              (hole h
                (let ((found (rp-placed-at ps (nth-symbol holes h))))
                  (if (null? found)
                      (cons (the rp-operand (sum hole (rp-index-in all (nth-symbol holes h) 0))) rest)
                      (let ((of (rp-of-evidence (car found) all)))
                        (tagcase of
                          (node j
                            (let ((n (rp-node-at ns-all j)))
                              (if (and set (not (null? n)) (extract (car n) 3))
                                  (onto (extract (car n) 5) rest)
                                  (cons of rest))))
                          (else z (cons of rest)))))))
              (else other (cons (car as) rest))))))))

(define rp-filled (subr kfx (rexp (listof rpe acyclic)) rexp)
  (lambda (main es)
    "Rep `main`'s nodes, its holes filled from evidence `es`."
    (tagcase main
      (rexp (ns hs root d)
        (let* ((ps (rp-placed es (+ (rp-max-slot ns 0) 1)))
               (left (filter (lambda ((h string)) (null? (rp-placed-at ps h))) hs))
               (theirs (concat (map (lambda ((p rpp)) (tagcase p (rpp (n off ens ehs) (map (lambda ((y symbol)) (symbol->string y)) ehs)))) ps)))
               (all (onto left (filter (lambda ((h string)) (not (string-member? h left))) theirs)))
               (moved (concat (map (lambda ((p rpp))
                                      (tagcase p
                                        (rpp (n off ens ehs)
                                          (map (lambda ((x rp-node))
                                                 (product (1 (+ (extract x 1) off)) (2 (extract x 2)) (3 (extract x 3)) (4 (extract x 4))
                                                          (5 (map (lambda ((a rp-operand)) (rp-moved a off ehs all)) (extract x 5)))))
                                               ens))))
                                    ps)))
               (holes (map (lambda ((h string)) (string->symbol h)) hs))
               (mine (map (lambda ((x rp-node))
                            (product (1 (extract x 1)) (2 (extract x 2)) (3 (extract x 3)) (4 (extract x 4))
                                     (5 (rp-filled-args (extract x 5) (extract x 3) holes ps all moved))))
                          ns)))
          (rexp (onto mine moved) all root d))))))

(define rp-same? (subr kfx (rp-operand rp-operand) bool)
  (lambda (a b)
    (tagcase a
      (node j (tagcase b (node k (= j k)) (else other #f)))
      (hole j (tagcase b (hole k (= j k)) (else other #f)))
      (bound p (tagcase b (bound q (and (= (extract p 1) (extract q 1)) (= (extract p 2) (extract q 2)))) (else other #f)))
      (else other #f))))

"A canonical rep's nodes, a set's members each once (Fixpt's `fill::dedup`)."
(define-rec
  (rp-once (subr kfx (rp-operands) rp-operands)
    (lambda (as)
      (cond ((null? as) nil)
            ((any? (lambda ((b rp-operand)) (rp-same? (car as) b)) (cdr as)) (rp-once (cdr as)))
            (else (cons (car as) (rp-once (cdr as))))))))

"Evidence's words given: each a rep's binary form, the variable it is for
 named, in the order `names` says."
(define-rec
  (evidence-given (subr (maxeff hp (alloc @h)) (i64 strings i64) (listof rpe acyclic))
    (lambda (prod names i)
      (if (null? names)
          nil
          (let ((got ((proj rep-nodes @h) (word-kfx-bytes (obj-ref prod i)) nil)))
            (cons (rpe (car names) (extract got 1) (extract got 2)) (evidence-given prod (cdr names) (i64+ i 1))))))))

"A region a variable names, given no evidence: one of its own, named
 afresh, `%region-N`, never another (Fixpt's rule)."
(define fresh-regions (ref i64 @h) (new 0))

(define-rec
  (fresh-evidence! (subr hp (strings strings) (listof rpe acyclic))
    (lambda (holes named)
      (cond ((null? holes) nil)
            ((or (not (has-prefix? (car holes) "'")) (string-member? (car holes) named)) (fresh-evidence! (cdr holes) named))
            (else
             (let ((k (get fresh-regions)))
               (begin
                 (set fresh-regions (i64+ k 1))
                 (cons (rpe (car holes)
                            (list (product (1 0) (2 'evidence) (3 #f) (4 nil) (5 (list (the rp-operand (sum node 1)))))
                                  (product (1 1) (2 'rconst) (3 #f) (4 nil)
                                           (5 (list (the rp-operand (sum sym (string->symbol (string-append "%region-" (i64->string k)))))))))
                            nil)
                       (fresh-evidence! (cdr holes) named)))))))))

(define rep-filled! (subr (maxeff hp (alloc @h)) (i64 i64 string) (bytevectorof @h))
  (lambda (rep given names)
    "Rep `rep`'s binary form, its holes filled from the evidence `given`
     holds, for the variables `names` names: canonical, each set's members
     once."
    (let* ((got ((proj rep-nodes @h) (word-kfx-bytes rep) nil))
           (main (rexp (extract got 1) (map (lambda ((y symbol)) (symbol->string y)) (extract got 2)) 0 ""))
           (named (spaced-words names))
           (es (onto (evidence-given given named 1)
                     (fresh-evidence! (map (lambda ((y symbol)) (symbol->string y)) (extract got 2)) named)))
           (canonical (lambda ((r rexp))
                   (tagcase r
                     (rexp (ns hs root d) (the (bytevectorof @h) (rep-of-nodes ns (map (lambda ((h string)) (string->symbol h)) hs) root))))))
           (b (canonical (rp-filled main es)))
           (again ((proj rep-nodes @h) b nil)))
      (canonical (rexp (map (lambda ((x rp-node)) (if (extract x 3) (product (1 (extract x 1)) (2 (extract x 2)) (3 #t) (4 (extract x 4)) (5 (rp-once (extract x 5)))) x))
                       (extract again 1))
                  (map (lambda ((y symbol)) (symbol->string y)) (extract again 2)) 0 "")))))

"`(%reify given REP names)`: evidence, its rep filled."
(define reify-run! (subr (maxeff hp (alloc @h)) (i64 i64 i64) i64)
  (lambda (given rep names) (kfx-bytes-word! (rep-filled! rep given (word-string names)))))

(define stage-run! (subr (maxeff vm loading (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet) (i64 i64 i64 i64 i64) i64)
  (lambda (m code given rep names)
    "`(%stage-run m code given rep names)`: `(sum ok THUNK)`, the code made a
     procedure over module `m`, checked against `rep` filled from the
     evidence given (C307); or `(sum failed WHY)`."
    (let* ((t ((proj rep-ty @h) (rep-filled! rep given (word-string names))))
           (thunk (staged-thunk (word-sexp code)))
           (prog (staged-program thunk))
           (why (stage-worked prog t)))
      (if (not (string=? why ""))
          (stage-failure-word! (refusal-said why))
          (let* ((s (stage-checked prog t))
                 (gs (with-entries (tagcase s (st (sbs k fs ns) fs))))
                 (body (lower thunk (list (list "stage-module")) gs))
                 (l (number! body))
                 (e (alloc! ob-env 2))
                 (p (alloc! ob-proc 2)))
            (begin (obj-set! e 0 w-nil) (obj-set! e 1 m)
                   (obj-set! p 0 (code-word l)) (obj-set! p 1 e)
                   (sum-word! "ok" p)))))))

