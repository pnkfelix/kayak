"lower.kfx: an FX-26 program, checked, lowered to the engine's IR (C58).
 Names are resolved: a local to its frame's depth and slot, a global to
 its index, a primitive to its value. Types are dropped (`the`, a
 binder's type, `plambda`, `proj`), and FX-26's derived forms (`let*`,
 `cond`, `and`, `or`, `when`) made of the core."

"Where names are: the frames' names, the innermost first; the globals, in
 the order they are defined, an index each."
(define-type scope (listof strings acyclic))

(define binder-name (subr kfx (sexp) string)
  (lambda (p) (tagcase p (sym (n f x) n) (lst (xs f l x) (sym-name (car xs))) (else other ""))))

(define read-one (subr kfx (string) sexp)
  (lambda (text) (car (read-all (string-chars text) "" 1))))

(define sx (subr kfx (sexps) sexp) (lambda (xs) (lst xs "" 0 0)))
(define sy (subr kfx (string) sexp) (lambda (n) (sym n "" 0)))

(define guarded-bind (subr kfx (string sexp sexp sexp sexp) sexp)
  (lambda (t e test arm els)
    "`(let ((t e)) (if test (let ((x t)) body) els))`, `arm` `(x body)`: the
     confirming forms as Fixpt's parser makes them (C214)."
    (sx (list (sy "let") (sx (list (sx (list (sy t) e))))
              (sx (list (sy "if") test
                        (sx (list (sy "let") (sx (list (sx (list (car (items arm)) (sy t))))) (second (items arm))))
                        els))))))

(define member-of? (subr kfx (string strings) bool) (lambda (x xs) (string-member? x xs)))

;; The forms of processes and `par` (C219), made as Fixpt's parser makes
;; them (its processes.rs): each a call of the scheduler's, `fx26:processes.fx`,
;; loaded as the global `%processes`.
(define process-heads strings
  (list "spawn" "spawn-monitored" "send" "receive" "self" "par" "race" "pselect" "icell-get" "icell-put!"))

(define lib-op (subr kfx (string) sexp)
  (lambda (name) (sx (list (sy "with") (sy "%processes") (sy name)))))

(define thunk-of (subr kfx (sexp) sexp) (lambda (e) (sx (list (sy "lambda") (sx nil) e))))

(define-rec
  (par-tree (subr kfx (sexps bool) sexp)
    (lambda (es first)
      "The branches as nested `par2`s, from the last: `(par2 (lambda () e1)
       (lambda () rest))`."
      (if (null? (cdr es))
          (thunk-of (car es))
          (let ((t (sx (list (lib-op "par2") (thunk-of (car es)) (par-tree (cdr es) #f)))))
            (if first t (thunk-of t))))))
  (par-lets (subr kfx (sexps sexps) sexp)
    (lambda (names body)
      "The branches' values out of `%par`, two by two, then the body."
      (let ((ex (lambda ((k i64)) (sx (list (sy "extract") (sy "%par") (num k "" 0))))))
        (if (null? (cdr (cdr names)))
            (sx (cons (sy "let") (cons (sx (list (sx (list (car names) (ex 1))) (sx (list (second names) (ex 2))))) body)))
            (sx (list (sy "let") (sx (list (sx (list (car names) (ex 1))) (sx (list (sy "%par") (ex 2)))))
                      (par-lets (cdr names) body))))))))

(define-rec
  (race-tree (subr kfx (sexps bool) sexp)
    (lambda (es first)
      (if (null? (cdr es))
          (thunk-of (car es))
          (let ((t (sx (list (lib-op "race2") (thunk-of (car es)) (race-tree (cdr es) #f)))))
            (if first t (thunk-of t)))))))

(define select-event (subr kfx (sexp) string)
  (lambda (w)
    (let ((h (tagcase (car (items w)) (sym (n f p) n) (else other ""))))
      (cond ((string=? h "icell-get") "cell-event") ((string=? h "receive") "mailbox-event")
            ((string=? h "sleep-until") "clock-event") (else "stdin-event")))))

(define-rec
  (select-events (subr kfx (sexps i64) sexp)
    (lambda (arms i)
      (let ((e (sx (list (lib-op (select-event (car (items (car arms))))) (sy (string-append "%sel-" (i64->string i)))))))
        (if (null? (cdr arms)) e (sx (list (lib-op "or-event") e (select-events (cdr arms) (i64+ i 1))))))))
  (select-arms (subr kfx (sexps i64) sexp)
    (lambda (arms i)
      (let* ((arm (items (car arms))) (w (items (car arm)))
             (get (sx (if (null? (cdr w)) (list (car w)) (list (car w) (sy (string-append "%sel-" (i64->string i)))))))
             (this (sx (cons (sy "let") (cons (sx (list (sx (list (second arm) get)))) (cdr (cdr arm)))))))
        (if (null? (cdr arms))
            this
            (sx (list (sy "if") (sx (list (sy "=") (sy "%sel") (num i "" 0))) this (select-arms (cdr arms) (i64+ i 1))))))))
  (select-binds (subr kfx (sexps i64) sexps)
    (lambda (arms i)
      (if (null? arms)
          nil
          (let ((w (items (car (items (car arms))))))
            (cons (sx (list (sy (string-append "%sel-" (i64->string i))) (if (null? (cdr w)) (sy "#u") (second w))))
                  (select-binds (cdr arms) (i64+ i 1))))))))

(define process-expanded (subr kfx (sexp) sexp)
  (lambda (e)
    "A form of processes as Fixpt's parser makes it (C219)."
    (let* ((xs (items e)) (h (sym-name (car xs))) (args (cdr xs)))
      (cond ((member-of? h (list "send" "receive" "self" "icell-get" "icell-put!")) (sx (cons (lib-op h) args)))
            ((or (string=? h "spawn") (string=? h "spawn-monitored"))
             (let* ((rest (if (string=? h "spawn") args (cdr (cdr args))))
                    (header (items (car rest)))
                    (b (car header)) (m (second header)) (r (third header))
                    (proc (sx (list (sy "plambda") (sx (list (sx (list r (sy "place")))))
                                    (sx (cons (sy "lambda")
                                              (cons (sx (list (sx (list b (sx (list (sy "inbox") m r)))) (sx (list r (sx (list (sy "place") r))))))
                                                    (onto (cdr rest) (list (sy "#u"))))))))))
               (if (string=? h "spawn")
                   (sx (list (lib-op "spawn-process") proc))
                   (sx (list (lib-op "spawn-monitored") (car args) (second args) proc)))))
            ((string=? h "par")
             (let ((bs (items (car args))))
               (sx (list (sy "let") (sx (list (sx (list (sy "%par") (par-tree (map (lambda ((b sexp)) (second (items b))) bs) #t)))))
                         (par-lets (map (lambda ((b sexp)) (car (items b))) bs) (cdr args))))))
            ((string=? h "race") (race-tree args #t))
            (else
             (sx (list (sy "let") (sx (select-binds args 0))
                       (sx (list (sy "let") (sx (list (sx (list (sy "%sel") (sx (list (lib-op "sync") (select-events args 0)))))))
                                 (select-arms args 0))))))))))

(define-rec
  (fresh-from (subr kfx (string strings i64) string)
    (lambda (base taken i)
      (let ((n (if (i64= i 0) base (string-append base (i64->string i)))))
        (if (string-member? n taken) (fresh-from base taken (i64+ i 1)) n)))))

(define fresh-for (subr kfx (string sexp) string)
  (lambda (base e)
    "An expansion's own variable, named for what its form `e` does not
     mention (C214; Fixpt's `fresh_name`): `base`, else `base1`, ..."
    (fresh-from base (names-in e) 0)))

(define standard-written (subr kfx (string) string)
  (lambda (n)
    "A standard name the engine has as FX-26 written (C214), not a
     primitive: \"\" if none."
    (cond ((string=? n "assert") "(lambda ((p bool)) (if p #u (error \"assertion failed\")))")
          ((string=? n "assume") "(lambda ((p bool)) (if p #u (error \"assumption not met\")))")
          ((string=? n "nat?") "(lambda ((n int)) (>= n 0))")
          ((string=? n "datum-int?") "(lambda ((d datum)) (int? d))")
          ((string=? n "list") "(vlambda xs xs)")
          ((string=? n "append")
           "As a value, a `vsubr` (C220): the lists joined, the last shared."
           "(vlambda xss (letrec ((go (lambda (ls) (if (null? ls) nil (if (null? (cdr ls)) (car ls) (append (car ls) (go (cdr ls)))))))) (go xss)))")
          ((string=? n "string-append")
           "(vlambda ss (letrec ((go (lambda (ls) (if (null? ls) \"\" (string-append (car ls) (go (cdr ls))))))) (go ss)))")
          ((string=? n "native-code?") "(lambda () #f)")
          ((or (string=? n "certify-nat") (string=? n "certify-acyclic")) "(lambda ((x int)) x)")
          ((string=? n "acyclic?")
           "No cycle through its pairs: none met again on the way down to it."
           "(lambda ((d datum)) (letrec ((on-path (lambda ((x datum) (path datum)) (if (null? path) #f (if (eq? x (car path)) #t (on-path x (cdr path)))))) (walk (lambda ((x datum) (path datum)) (if (pair? x) (if (on-path x path) #f (if (walk (car x) (cons x path)) (walk (cdr x) (cons x path)) #f)) #t)))) (walk d nil)))")
          ((string=? n "symbol-name-hash")
           "Fixpt's (`symbol_hash_of`): FNV-1a of the name's UTF-8, wrapped to a fixnum of 61 bits."
           "(lambda ((sym symbol)) (let ((b (string->utf8 (symbol->string sym)))) (letrec ((go (lambda ((i int) (h i64)) (if (>= i (bytevector-length b)) (i64->int (i64-shr (i64-shl (i64-and h (int->i64 9223372036854775807)) 3) 3)) (go (+ i 1) (i64* (i64-xor h (int->i64 (bytevector-u8-ref b i))) (int->i64 1099511628211))))))) (go 0 (int->i64 -3750763034362895579)))))")
          (else ""))))

(define shape-test (subr kfx (string) string)
  (lambda (shape)
    "A shape's test, as `typecase` names the shape."
    (cond ((string=? shape "nil") "null?") ((string=? shape "bloblet") "array?") ((string=? shape "box") "ref?")
          (else (string-append shape "?")))))

(define-rec
  (unquoted? (subr kfx (sexp i64) bool)
    (lambda (d depth)
      "Whether a quasiquoted datum has an unquote at depth 1: else it is a
       constant, quoted and interned as a quote is."
      (tagcase d
        (lst (ys f l p)
          (cond ((null? ys) #f)
                ((and (i64= (size ys) 2) (or (head-is? d "unquote") (head-is? d "unquote-splicing")))
                 (or (i64= depth 1) (unquoted? (second ys) (i64- depth 1))))
                ((and (i64= (size ys) 2) (head-is? d "quasiquote")) (unquoted? (second ys) (i64+ depth 1)))
                (else (any? (lambda ((y sexp)) (unquoted? y depth)) ys))))
        (else other #f)))))

(define quasi-tagged (subr kfx (string ir) ir)
  (lambda (tag x)
    "`(tag x)` as data."
    (i-call (i-lit (v-prim "cons" 2))
            (list (i-lit (v-symbol (string->symbol tag))) (i-call (i-lit (v-prim "cons" 2)) (list x (i-lit (v-nil))))))))

(define-rec
  (position-of (subr kfx (string strings i64) i64)
    (lambda (n xs i)
      (cond ((null? xs) -1)
            ((string=? (car xs) n) i)
            (else (position-of n (cdr xs) (i64+ i 1)))))))

(define-rec
  (find-local (subr kfx (string scope i64) (listof i64 acyclic))
    (lambda (n sc depth)
      "A local's depth and slot, or nothing; a slot of -1 is a name of the
       module a `with` opened, whose frame holds the module (a product)."
      (cond ((null? sc) nil)
            ((and (not (null? (car sc))) (string=? (car (car sc)) "%with"))
             (if (string-member? n (cdr (car sc))) (list depth -1) (find-local n (cdr sc) (i64+ depth 1))))
            (else
             (let ((i (position-of n (car sc) 0)))
               (if (i64>= i 0) (list depth i) (find-local n (cdr sc) (i64+ depth 1)))))))))

(define-rec
  (words-from (subr kfx ((listof char acyclic) (listof char acyclic) strings) strings)
    (lambda (cs w acc)
      (cond ((null? cs) (reverse-strs (if (null? w) acc (cons (rev->string w) acc)) nil))
            ((char=? (car cs) #\space) (words-from (cdr cs) nil (if (null? w) acc (cons (rev->string w) acc))))
            (else (words-from (cdr cs) (cons (car cs) w) acc)))))
  (reverse-strs (subr kfx (strings strings) strings)
    (lambda (xs acc) (if (null? xs) acc (reverse-strs (cdr xs) (cons (car xs) acc))))))

(define spaced-words (subr kfx (string) strings) (lambda (s) (words-from (string-chars s) nil nil)))

"Modules (C59): a module's value is a product of the values it gives.
 What each gives is kept among the globals' names, as `%exports m x ...`
 (a slot never used), and the names every `moduleof` type gives as
 `%any-module x ...`, for a `with` of a module given as a parameter."
(define-rec
  (exports-of (subr kfx (string strings) strings)
    (lambda (m gs)
      (cond ((null? gs) nil)
            ((has-prefix? (car gs) (string-append "%exports " (string-append m " ")))
             (cdr (cdr (spaced-words (car gs)))))
            (else (exports-of m (cdr gs)))))))

(define-rec
  (with-at (subr kfx (string strings) strings)
    (lambda (key gs)
      "What a `with` at `key`, `FILE:POS`, opens, as the checker found it of
       a module value or parameter (`%with-at`, its `with-spec`; C213)."
      (cond ((null? gs) nil)
            ((has-prefix? (car gs) (string-append "%with-at " (string-append key " ")))
             (cdr (cdr (spaced-words (car gs)))))
            (else (with-at key (cdr gs)))))))

(define-rec
  (fact-at (subr kfx (string string strings) strings)
    (lambda (key what gs)
      "The words after `what` of the checker's fact at `key`, `FILE:POS`, if
       one is (`%fact`, C215)."
      (cond ((null? gs) nil)
            ((has-prefix? (car gs) (string-append "%fact " (string-append key (string-append " " what))))
             (spaced-words (after-prefix (car gs) (string-append "%fact " (string-append key (string-append " " what))))))
            (else (fact-at key what (cdr gs)))))))

(define key-of (subr kfx (sexp) string)
  (lambda (e) (string-append (datum-file e) (string-append ":" (i64->string (datum-pos e))))))

(define lit-int (subr kfx (string) ir) (lambda (w) (i-lit (v-int (i64->int (string->i64 w))))))

(define second-ir (subr kfx (irs) ir) (lambda (xs) (car (cdr xs))))


(define-rec
  (flat-arms (subr kfx (sexps string string string) sexp)
    (lambda (arms t key off)
      "A flat sum's arms as `if`s on its tag `key` (C215; kayak-rt's
       `put-flat-tagcase`): each its variant, `off` bytes in; `else`'s the
       blobref itself; no arm, a failure, as FX-26's."
      (if (null? arms)
          (sx (list (sy "error") (str "tagcase: no arm for this flat sum's tag" "" 0)))
          (let ((arm (items (car arms))))
            (if (sym-is? (car arm) "else")
                (sx (list (sy "let") (sx (list (sx (list (second arm) (sy t))))) (sx (cons (sy "begin") (cdr (cdr arm))))))
                (sx (list (sy "if") (if (tagcase (car arm) (sym (n f p) #t) (else other #f))
                                        ;; No key: a label, a symbol (C215).
                                        (sx (list (sy "symbol=?") (sy key) (sx (list (sy "quote") (car arm)))))
                                        (sx (list (sy "=") (sy key) (car arm))))
                          (sx (list (sy "let") (sx (list (sx (list (second arm) (sx (list (sy "%blobref-field") (sy t) (num (string->i64 off) "" 0)))))))
                                    (sx (cons (sy "begin") (cdr (cdr arm))))))
                          (flat-arms (cdr arms) t key off)))))))))

(define flat-tagcase (subr kfx (sexp sexps strings) sexp)
  (lambda (e xs found)
    "`(tagcase r arm ...)` of a blobref to a keyed flat sum (C215): its tag
     read once, of the key's width, then the arms."
    (let ((t (fresh-for "%flat-value" e)) (key (fresh-for "%flat-tag" e)))
      (sx (list (sy "let") (sx (list (sx (list (sy t) (car xs)))))
                (sx (list (sy "let") (sx (list (sx (list (sy key) (if (i64= (size found) 3)
                                                                         (sx (list (sy "%blobref-label") (sy t)))
                                                                         (sx (list (sy "%blobref-tag") (sy t) (num (string->i64 (car found)) "" 0))))))))
                          (flat-arms (cdr xs) t key (second-word found)))))))))

(define scalar-code (subr kfx (string) string)
  (lambda (n)
    (cond ((string=? n "i64") "0") ((string=? n "u64") "1") ((string=? n "f64") "2") ((string=? n "i32") "3")
          ((string=? n "u32") "4") ((string=? n "f32") "5") ((string=? n "u8") "6") (else "7"))))

(define-rec
  (any-module (subr kfx (strings) strings)
    (lambda (gs)
      (cond ((null? gs) nil)
            ((has-prefix? (car gs) "%any-module ") (cdr (spaced-words (car gs))))
            (else (any-module (cdr gs)))))))

(define include-exports (subr kfx (sexp strings) strings)
  (lambda (f gs)
    "What an `include` takes of its module: all it gives, but those its
     exception names (C87, an `extend`'s second module's)."
    (let* ((all (exports-of (sym-name (second (items f))) gs))
           (ex (include-except f))
           (out (if (null? ex)
                    nil
                    (if (head-is? (car ex) "except-module")
                        (exports-of (sym-name (second (items (car ex)))) gs)
                        (map sym-name (cdr (items (car ex))))))))
      (concat (map (lambda ((n string)) (if (string-member? n out) nil (the strings (list n)))) all)))))

"An `include` of a module an expression makes, not one named (C221): its
 names those the checker noted it gives (`%with-at`), its value kept in a
 hidden name of its place."
(define include-named? (subr kfx (sexp) bool)
  (lambda (f) (tagcase (second (items f)) (sym (n p2 q) #t) (else other #f))))
(define include-hidden (subr kfx (sexp) string)
  (lambda (f) (string-append "%incl " (key-of (second (items f))))))
(define include-names (subr kfx (sexp strings) strings)
  (lambda (f gs) (if (include-named? f) (include-exports f gs) (with-at (key-of (second (items f))) gs))))

(define instance-module? (subr kfx (sexp) bool)
  (lambda (e)
    "Whether `e` is the module a load of a file of parameters made (C213:
     `(module (%loaded path %instance ...) ...)`): one made again for each
     instance, as Fixpt makes one each time its maker is called."
    (and (head-is? e "module") (i64>= (size (items e)) 2) (head-is? (second (items e)) "%loaded")
         (any? (lambda ((x sexp)) (sym-is? x "%instance")) (items (second (items e)))))))

(define-rec
  (instances-of (subr kfx (strings) strings)
    (lambda (gs)
      (cond ((null? gs) nil)
            ((has-prefix? (car gs) "%instance-module ") (cons (after-prefix (car gs) "%instance-module ") (instances-of (cdr gs))))
            (else (instances-of (cdr gs)))))))

(define-rec
  (module-item-names (subr kfx (sexps strings bool) strings)
    (lambda (its gs exported)
      "The names a module's items define, in order; only those it gives if
       `exported` (a `hide`'s are not, an `include`'s are)."
      (if (null? its)
          nil
          (let ((f (car its)))
            (onto (cond ((or (head-is? f "define") (head-is? f "define*")) (list (binder-name (second (items f)))))
                        ((head-is? f "define-rec") (map (lambda ((g sexp)) (sym-name (car (items g)))) (cdr (items f))))
                        ((head-is? f "define-datatype") (map (lambda ((g sexp)) (sym-name (car (items g)))) (cdr (cdr (items f)))))
                        ((head-is? f "define-generative")
                         (let ((n (binder-name (second (items f))))) (list (string-append "up-" n) (string-append "down-" n))))
                        ((and (head-is? f "include") (not (include-named? f)))
                         (if exported (include-names f gs) (cons (include-hidden f) (include-names f gs))))
                        ((head-is? f "include")
                         ;; An instance's module made first, then its values (C213).
                         (if (and (not exported) (string-member? (sym-name (second (items f))) (instances-of gs)))
                             (cons (string-append "%inst " (sym-name (second (items f)))) (include-exports f gs))
                             (include-exports f gs)))
                        ((head-is? f "hide") (if exported nil (module-item-names (cdr (items f)) gs #f)))
                        (else nil))
                  (module-item-names (cdr its) gs exported)))))))

(define includes-first (subr kfx (sexps) sexps)
  (lambda (its)
    "A module's items, its `include`s first, hidden or not."
    (let ((inc? (lambda ((f sexp)) (head-is? f "include"))))
      (onto (concat (map (lambda ((f sexp))
                           (cond ((inc? f) (the sexps (list f)))
                                 ((head-is? f "hide")
                                  (let ((hs (concat (map (lambda ((g sexp)) (if (inc? g) (the sexps (list g)) nil)) (cdr (items f))))))
                                    (if (null? hs) nil (the sexps (list (lst (cons (car (items f)) hs) "" 0 0))))))
                                 (else nil)))
                         its))
            (concat (map (lambda ((f sexp))
                           (cond ((inc? f) nil)
                                 ((head-is? f "hide")
                                  (the sexps (list (lst (cons (car (items f)) (concat (map (lambda ((g sexp)) (if (inc? g) nil (the sexps (list g)))) (cdr (items f))))) "" 0 0))))
                                 (else (the sexps (list f)))))
                         its))))))

(define without-doc (subr kfx (sexps) sexps)
  (lambda (body)
    "A body's forms, its docstring dropped."
    (if (and (not (null? (cdr body))) (tagcase (car body) (str (s f p) #t) (else other #f))) (cdr body) body)))

(define-rec
  (digits-int (subr kfx ((listof char acyclic) int) int)
    (lambda (cs n) (if (null? cs) n (digits-int (cdr cs) (+ (* n 10) (i64->int (i64- (char->i64 (car cs)) 48))))))))

(define big-int (subr kfx (string) int)
  (lambda (text)
    "A literal past an `i64`."
    (let ((cs (string-chars text)))
      (if (char=? (car cs) #\-) (- 0 (digits-int (cdr cs) 0)) (digits-int cs 0)))))

"A real literal's value: its digits as an integer over a power of ten,
 which is the value rounded once, as reading it is, while both are exact
 in an `f64` (up to 2^53 and 10^22)."
(define-rec
  (real-parts (subr kfx ((listof char acyclic) int int bool) f64)
    (lambda (cs n scale after)
      (cond ((null? cs) (f64/ (int->f64 n) (int->f64 scale)))
            ((char=? (car cs) #\.) (real-parts (cdr cs) n scale #t))
            (else (real-parts (cdr cs) (+ (* n 10) (i64->int (i64- (char->i64 (car cs)) 48))) (if after (* scale 10) scale) after))))))

(define-rec
  (mantissa-int (subr kfx ((listof char acyclic) int i64) int)
    (lambda (cs n d)
      "A mantissa's digits as an integer (its point dropped)."
      (cond ((null? cs) n)
            ((char=? (car cs) #\.) (mantissa-int (cdr cs) n d))
            (else (mantissa-int (cdr cs) (+ (* n 10) (i64->int (i64- (char->i64 (car cs)) 48))) d))))))

(define-rec
  (after-point (subr kfx ((listof char acyclic) i64 bool) i64)
    (lambda (cs n seen) (cond ((null? cs) n) ((char=? (car cs) #\.) (after-point (cdr cs) n #t)) (else (after-point (cdr cs) (if seen (i64+ n 1) n) seen))))))

(define-rec
  (ten-to (subr kfx (i64) int) (lambda (k) (if (i64<= k 0) 1 (* 10 (ten-to (i64- k 1)))))))

(define exponent-value (subr kfx ((listof char acyclic)) i64)
  (lambda (x)
    (cond ((char=? (car x) #\-) (i64- 0 (int->i64 (digits-int (cdr x) 0))))
          ((char=? (car x) #\+) (int->i64 (digits-int (cdr x) 0)))
          (else (int->i64 (digits-int x 0))))))

"A real with an exponent (C155): its mantissa's digits `n` times ten to
 `e`, rounded once, as reading it is, where both are exact in an `f64`
 (`n` up to 2^53, ten up to the 22nd); else not read yet."
(define scaled-real (subr kfx (string (listof char acyclic)) f64)
  (lambda (text body)
    (let* ((m (before-exponent body))
           (n (mantissa-int m 0 0))
           (e (i64- (exponent-value (after-exponent body)) (after-point m 0 #f))))
      (cond ((or (> n 9007199254740992) (i64> e 22) (i64< e -22))
             (error (string-append "the engine: a real it reads not exactly yet: " text)))
            ((i64>= e 0) (f64* (int->f64 n) (int->f64 (ten-to e))))
            (else (f64/ (int->f64 n) (int->f64 (ten-to (i64- 0 e)))))))))

(define real-value (subr kfx (string) f64)
  (lambda (text)
    (let* ((cs (string-chars text)) (neg (char=? (car cs) #\-)) (body (if neg (cdr cs) cs))
           (v (if (or (has-char? body #\e) (has-char? body #\E)) (scaled-real text body) (real-parts body 0 1 #f))))
      (if neg (f64-neg v) v))))

"The globals a program defines, in order: each definition's name, and a
 datatype's constructors."
(define-rec
  (global-names (subr kfx (sexps) strings)
    (lambda (forms)
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (onto (cond ((or (head-is? f "define") (head-is? f "define*"))
                         (list (binder-name (second (items f)))))
                        ((head-is? f "define-rec")
                         (map (lambda ((g sexp)) (sym-name (car (items g)))) (cdr (items f))))
                        ((head-is? f "define-datatype")
                         (map (lambda ((g sexp)) (sym-name (car (items g)))) (cdr (cdr (items f)))))
                        ((head-is? f "define-generative")
                         (let ((n (binder-name (second (items f))))) (list (string-append "up-" n) (string-append "down-" n))))
                        (else nil))
                  (global-names (cdr forms))))))))

(define-rec
  (concat-words (subr kfx (strings) string)
    (lambda (ws) (if (null? ws) "" (if (null? (cdr ws)) (car ws) (string-append (car ws) (string-append " " (concat-words (cdr ws)))))))))

(define-rec
  (module-words (subr kfx (sexps strings) strings)
    (lambda (forms gs)
      "`%exports` for each module the program defines, in order, each seeing
       those before."
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (if (module-def? f)
                (let* ((inner (module-words (unhidden (module-written f)) gs))
                       (gs2 (onto inner gs))
                       (w (concat-words (cons "%exports" (cons (binder-name (second (items f))) (module-item-names (module-written f) gs2 #t)))))
                       (ws (the strings (if (instance-module? (last (items f)))
                                            (the strings (list w (string-append "%instance-module " (binder-name (second (items f))))))
                                            (the strings (list w))))))
                  "A module's modules too (C88), whose names a `with` of one
                   inside it opens."
                  (onto inner (onto ws (module-words (cdr forms) (onto ws gs2)))))
                (module-words (cdr forms) gs))))))
  (moduleof-names (subr kfx (sexps) strings)
    (lambda (forms)
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (onto (if (and (head-is? f "define-type") (head-is? (third (items f)) "moduleof"))
                      (concat (map (lambda ((it sexp)) (if (head-is? it "val") (the strings (list (sym-name (second (items it))))) nil))
                                   (cdr (items (third (items f))))))
                      nil)
                  (moduleof-names (cdr forms))))))))


"Where a form is written, `file:line`, for a lambda's backtrace line."
(define form-place (subr kfx (sexp) string)
  (lambda (e) (tagcase e (lst (xs f l p) (string-append f (string-append ":" (i64->string l)))) (else other ""))))

"A lambda given the name it is bound to; anything else as it is."
(define named (subr kfx (string ir) ir)
  (lambda (n e) (tagcase e (i-lambda (a body m w) (i-lambda a body n w)) (else other e))))

(define-rec
  (lower (subr kfx (sexp scope strings) ir)
    (lambda (e sc gs)
      (tagcase e
        (num (k f p) (i-lit (v-int (i64->int k))))
        (big (text f p) (i-lit (v-int (big-int text))))
        (chr (c f p) (i-lit (v-char c)))
        (str (s f p) (i-lit (v-string s)))
        (real (x f p) (i-lit (v-real (real-value x))))
        (sym (n f p) (lower-name n sc gs))
        (lst (xs f l p)
          (if (null? xs)
              (i-lit (v-nil))
              (let ((h (tagcase (car xs) (sym (n f2 p2) n) (else other ""))))
                (if (and (not (string=? h "")) (null? (find-local h sc 0)))
                    (lower-form h (cdr xs) e sc gs)
                    (i-call (lower (car xs) sc gs) (lower-all (cdr xs) sc gs))))))
        (else other (error "the engine: a datum it cannot lower")))))

  (lower-all (subr kfx (sexps scope strings) irs)
    (lambda (es sc gs) (if (null? es) nil (cons (lower (car es) sc gs) (lower-all (cdr es) sc gs)))))

  (lower-body (subr kfx (sexps scope strings) ir)
    (lambda (body sc gs)
      (let ((forms (without-doc body)))
        (if (null? (cdr forms)) (lower (car forms) sc gs) (i-seq (lower-all forms sc gs))))))

  (lower-name (subr kfx (string scope strings) ir)
    (lambda (n sc gs)
      (let ((local (find-local n sc 0)))
        (cond ((and (not (null? local)) (i64= (car (cdr local)) -1)) (i-extract n (i-local (car local) 0)))
              ((not (null? local)) (i-local (car local) (car (cdr local))))
              ((string=? n "#t") (i-lit (v-bool #t)))
              ((string=? n "#f") (i-lit (v-bool #f)))
              ((string=? n "#u") (i-lit (v-unit)))
              ((i64>= (position-of n gs 0) 0) (i-global (position-of n gs 0) n))
              ((or (string=? n "nil") (string=? n "no-pair")) (i-lit (v-nil)))
              ((and (i64>= (prim-arity (prim-alias n)) 0) (string=? (standard-written n) ""))
               (i-lit (v-prim (prim-alias n) (prim-arity (prim-alias n)))))
              ((not (string=? (standard-written n) "")) (lower (read-one (standard-written n)) nil nil))
              (else (begin (error (string-append "the engine: nothing is named " n)) (i-lit (v-unit))))))))

  (lower-quoted (subr kfx (sexp scope strings) ir)
    (lambda (d sc gs)
      "A quoted datum (C77, C79): a symbol or `#t`, `#f`; another atom as
       itself; a list a literal made once at loading and interned there
       (table.kfx), as FX-26's heap interns a quote."
      (tagcase d
        (sym (n f p) (cond ((string=? n "#t") (i-lit (v-bool #t))) ((string=? n "#f") (i-lit (v-bool #f))) (else (i-lit (v-symbol (string->symbol n))))))
        (lst (ys f l p) (if (null? ys) (i-lit (v-nil)) (i-lit (v-datum d))))
        (else other (lower d sc gs)))))

  (lower-quasi (subr kfx (sexp i64 scope strings) ir)
    (lambda (d depth sc gs)
      "A quasiquoted datum (C79): an unquote at depth 1 its expression; an
       unquote-splicing's list appended, by the standard `append`."
      (tagcase d
        (lst (ys f l p)
          (cond ((null? ys) (i-lit (v-nil)))
                ((and (i64= (size ys) 2) (head-is? d "unquote") (i64= depth 1)) (lower (second ys) sc gs))
                ((and (i64= (size ys) 2) (or (head-is? d "unquote") (head-is? d "unquote-splicing")))
                 (quasi-tagged (sym-name (car ys)) (lower-quasi (second ys) (i64- depth 1) sc gs)))
                ((and (i64= (size ys) 2) (head-is? d "quasiquote"))
                 (quasi-tagged "quasiquote" (lower-quasi (second ys) (i64+ depth 1) sc gs)))
                ((head-is? d "#vector")
                 (i-call (i-lit (v-prim "datum-list->vector" 1)) (list (lower-quasi (lst (cdr ys) f l p) depth sc gs))))
                ((and (sym-is? (car ys) ".") (not (null? (cdr ys))) (null? (cdr (cdr ys)))) (lower-quasi (car (cdr ys)) depth sc gs))
                ((and (i64= depth 1) (head-is? (car ys) "unquote-splicing") (i64= (size (items (car ys))) 2))
                 (i-call (i-lit (v-prim "append" 2))
                         (list (lower (second (items (car ys))) sc gs) (lower-quasi (lst (cdr ys) f l p) depth sc gs))))
                ((not (unquoted? d depth)) (lower-quoted d sc gs))
                (else
                 (i-call (i-lit (v-prim "cons" 2))
                         (list (lower-quasi (car ys) depth sc gs) (lower-quasi (lst (cdr ys) f l p) depth sc gs))))))
        (else other (lower-quoted d sc gs)))))

  (lower-form (subr kfx (string sexps sexp scope strings) ir)
    (lambda (h xs e sc gs)
      (cond ((string=? h "the") (lower (second xs) sc gs))
            ((and (string=? h "convention") (i64= (size xs) 2))
             "`(convention C e)`: `e`, the engine's procedures one convention (C181)."
             (lower (second xs) sc gs))
            ((string=? h "quote") (lower-quoted (car xs) sc gs))
            ((string=? h "quasiquote") (lower-quasi (car xs) 1 sc gs))
            ((or (string=? h "plambda") (string=? h "proj")) (if (string=? h "proj") (lower (car xs) sc gs) (lower (second xs) sc gs)))
            ((string=? h "lambda")
             (let ((names (map binder-name (items (car xs)))))
               (i-lambda (size names) (lower-body (cdr xs) (cons names sc) gs) "" (form-place e))))
            ((string=? h "vlambda")
             "A variadic procedure (C71): arity -1, its one parameter the list of
              its arguments."
             (i-lambda -1 (lower-body (cdr xs) (cons (list (binder-name (car xs))) sc) gs) "" (form-place e)))
            ((string=? h "if") (i-if (lower (car xs) sc gs) (lower (second xs) sc gs) (lower (third xs) sc gs)))
            ((string=? h "begin") (i-seq (lower-all xs sc gs)))
            ((string=? h "let")
             (let ((bs (items (car xs))))
               (i-let (map (lambda ((b sexp)) (named (binder-name (car (items b))) (lower (last (items b)) sc gs))) bs)
                      (lower-body (cdr xs) (cons (map (lambda ((b sexp)) (binder-name (car (items b)))) bs) sc) gs))))
            ((string=? h "let*")
             (let ((bs (items (car xs))))
               (if (null? bs)
                   (lower-body (cdr xs) sc gs)
                   (i-let (list (named (binder-name (car (items (car bs)))) (lower (last (items (car bs))) sc gs)))
                          (lower-form "let*" (cons (lst (cdr bs) "" 0 0) (cdr xs)) e (cons (list (binder-name (car (items (car bs))))) sc) gs)))))
            ((string=? h "letrec")
             (let* ((bs (items (car xs)))
                    (inner (cons (map (lambda ((b sexp)) (binder-name (car (items b)))) bs) sc)))
               (i-letrec (map (lambda ((b sexp)) (named (binder-name (car (items b))) (lower (last (items b)) inner gs))) bs) (lower-body (cdr xs) inner gs))))
            ((string=? h "cond") (lower-cond xs sc gs))
            ((string=? h "case")
             (let ((inner (cons (the strings (list (fresh-for "%case-key" e))) sc)))
               (i-let (list (lower (car xs) sc gs)) (lower-case (cdr xs) inner gs))))
            ((member-of? h (list "blobref-at" "blobref+" "blobref-get" "blobref-set!" "blobref-index" "blobref-length" "blobref-variant!"))
             "A blobref's operation (C215), its layout the checker's facts here."
             (let* ((k (key-of e))
                    (args (lower-all xs sc gs))
                    (sz (fact-at k "blob-size " gs))
                    (elem (fact-at k "blob-element " gs))
                    (scalar (fact-at k "blob-scalar " gs))
                    (variant (fact-at k "blob-variant " gs))
                    (p (lambda ((name string) (n i64) (more irs)) (i-call (i-lit (v-prim name n)) more))))
               (cond ((string=? h "blobref-at") (p "%blobref-at" 3 (onto args (list (lit-int (if (null? sz) "0" (car sz)))))))
                     ((string=? h "blobref+") (p "%blobref+" 3 (onto args (list (lit-int (if (null? sz) "0" (car sz)))))))
                     ((string=? h "blobref-get") (p "%blobref-get" 2 (onto args (list (lit-int (scalar-code (if (null? scalar) "" (car scalar))))))))
                     ((string=? h "blobref-set!")
                      (i-call (i-lit (v-prim "%blobref-set!" 3)) (list (car args) (lit-int (scalar-code (if (null? scalar) "" (car scalar)))) (second-ir args))))
                     ((and (string=? h "blobref-index") (i64= (size elem) 2))
                      (p "%blobref-index" 4 (onto args (list (lit-int (car elem)) (lit-int (second-word elem))))))
                     ((and (string=? h "blobref-length") (i64= (size elem) 2))
                      (p "%blobref-length" 3 (onto args (list (lit-int (car elem)) (lit-int (second-word elem))))))
                     ((and (string=? h "blobref-variant!") (i64= (size variant) 4))
                      ;; No key: the label a symbol (C215).
                      (i-call (i-lit (v-prim "%blobref-variant-named!" 3))
                              (list (car args) (i-lit (v-symbol (string->symbol (second-word variant)))) (lit-int (car (cdr (cdr variant)))))))
                     ((and (string=? h "blobref-variant!") (i64= (size variant) 3))
                      (i-call (i-lit (v-prim "%blobref-variant!" 4))
                              (list (car args) (lit-int (car variant)) (lit-int (second-word variant)) (lit-int (car (cdr (cdr variant)))))))
                     (else (begin (error (string-append "the engine: a blobref's operation it has not yet: " h)) (i-lit (v-unit)))))))
            ((member-of? h process-heads)
             "A form of processes, a call of the scheduler's (C219)."
             (lower (process-expanded e) sc gs))
            ((or (string=? h "make-bloblet") (string=? h "rmake-bloblet"))
             "A bloblet (C215): its bytes' count, then its fields; `rmake-bloblet`'s
              place, the heap here, left off."
             (i-call (i-lit (v-prim "%make-bloblet" 1)) (lower-all (if (string=? h "rmake-bloblet") (cdr xs) xs) sc gs)))
            ((string=? h "letfreeze")
             "Its region, run as the heap's (C214): frozen data is data all the same."
             (i-let (list (i-lit (v-unit))) (lower-body (cdr xs) (cons (list (binder-name (car xs))) sc) gs)))
            ((and (string=? h "acyclic") (i64= (size xs) 3))
             "`(acyclic e (x body) else)` (C214): `body`, `x` the value, if no cycle
              runs through it, else `else`; its variable named apart."
             (let ((t (fresh-for "%acyclic-value" e)))
               (lower (guarded-bind t (car xs) (sx (list (sy "acyclic?") (sy t))) (second xs) (third xs)) sc gs)))
            ((and (string=? h "confirm-nat") (i64= (size xs) 3))
             "`(confirm-nat e (n body) else)` (C214): `body`, `n` the value, if it is
              no less than 0, else `else`, as Fixpt's parser makes it."
             (let ((t (fresh-for "%nat-value" e)))
               (lower (guarded-bind t (car xs) (sx (list (sy ">=") (sy t) (num 0 "" 0))) (second xs) (third xs)) sc gs)))
            ((and (string=? h "confirm-length") (i64= (size xs) 4))
             "`(confirm-length e k (x body) else)` (C214): `body`, `x` the list, if it
              has `k` elements, else `else`."
             (let ((t (fresh-for "%confirm-value" e)))
               (lower (guarded-bind t (car xs) (sx (list (sy "=") (sx (list (sy "length") (sy t))) (second xs))) (third xs) (fourth xs)) sc gs)))
            ((or (string=? h "letregion") (string=? h "letrena") (string=? h "letreap"))
             "A region, run as the heap: its name bound, to unit, as a place may be
              given (`rcons`, `rnew`), where the engine drops it."
             (i-let (list (i-lit (v-unit))) (lower-body (cdr xs) (cons (list (binder-name (car xs))) sc) gs)))
            ((string=? h "rlambda") (lower-form "lambda" (cdr xs) e sc gs))
            ((and (string=? h "with") (sym-is? (car xs) "#%fx"))
             "`(with #%fx n)`: the standard `n`, whatever names it here (C199)."
             (lower-name (sym-name (second xs)) nil nil))
            ((string=? h "with")
             (let* ((m (car xs))
                    (statics (tagcase m (sym (n f p) (exports-of n gs)) (else other nil)))
                    (found (if (null? statics) (with-at (string-append (datum-file e) (string-append ":" (i64->string (datum-pos e)))) gs) nil))
                    (names (the strings (cond ((not (null? statics)) (the strings statics)) ((not (null? found)) (the strings found)) (else (any-module gs))))))
               (i-let (list (lower m sc gs)) (lower-body (cdr xs) (cons (cons "%with" names) sc) gs))))
            ((string=? h "select") (error "the engine: a select as a value"))
            ((or (string=? h "module") (string=? h "%module-value")) (lower-module xs sc gs))
            ((string=? h "extend") (lower-module (module-written (lst (list (sym "define" "" 0) (sym "%extend" "" 0) e) "" 0 0)) sc gs))
            ((string=? h "and")
             (cond ((null? xs) (i-lit (v-bool #t)))
                   ((null? (cdr xs)) (lower (car xs) sc gs))
                   (else (i-if (lower (car xs) sc gs) (lower-form "and" (cdr xs) e sc gs) (i-lit (v-bool #f))))))
            ((string=? h "or")
             (cond ((null? xs) (i-lit (v-bool #f)))
                   ((null? (cdr xs)) (lower (car xs) sc gs))
                   (else (i-if (lower (car xs) sc gs) (i-lit (v-bool #t)) (lower-form "or" (cdr xs) e sc gs)))))
            ((or (string=? h "string-append") (string=? h "append"))
             "Variadic (C220): called, folded to the right, each argument in
              turn, the primitive of two; as values, `standard-written`'s."
             (cond ((null? xs) (i-lit (if (string=? h "append") (v-nil) (v-string ""))))
                   ((null? (cdr xs)) (lower (car xs) sc gs))
                   (else (i-call (i-lit (v-prim h 2)) (list (lower (car xs) sc gs) (lower-form h (cdr xs) e sc gs))))))
            ((string=? h "list")
             (if (null? xs)
                 (i-lit (v-nil))
                 (i-call (i-lit (v-prim "cons" 2)) (list (lower (car xs) sc gs) (lower-form "list" (cdr xs) e sc gs)))))
            ((string=? h "sum") (i-sum (label-of (car xs)) (lower (second xs) sc gs)))
            ((string=? h "product")
             (i-product (map (lambda ((f sexp)) (label-of (car (items f)))) xs)
                        (map (lambda ((f sexp)) (lower (second (items f)) sc gs)) xs)))
            ((and (string=? h "extract") (not (null? (fact-at (key-of e) "blob-offset " gs))))
             "A flat product's field, of a blobref (C215): a blobref to it."
             (i-call (i-lit (v-prim "%blobref-field" 2)) (list (lower (car xs) sc gs) (lit-int (car (fact-at (key-of e) "blob-offset " gs))))))
            ((string=? h "extract") (i-extract (label-of (second xs)) (lower (car xs) sc gs)))
            ((and (string=? h "tagcase") (not (null? (fact-at (key-of e) "blob-tagcase " gs))))
             (lower (flat-tagcase e xs (fact-at (key-of e) "blob-tagcase " gs)) sc gs))
            ((string=? h "tagcase") (lower-tagcase xs sc gs))
            ((string=? h "typecase") (lower-typecase (car xs) (cdr xs) sc gs))
            ((string=? h "prompt") (i-prompt (lower (car xs) sc gs) (lower (third xs) sc gs) (lower (second xs) sc gs)))
            (else (i-call (lower-name h sc gs) (lower-all xs sc gs))))))

  (lower-module (subr kfx (sexps scope strings) ir)
    (lambda (written sc gs)
      "A module: its items' values in a frame of their own, each seeing those
       before it and itself (a `letrec`), then the product of those it gives.
       The modules it includes are made first, as FX-26 makes them (C86)."
      (let* ((its (includes-first written))
             (names (module-item-names its gs #f))
             (given (module-item-names its gs #t))
             (inner (cons names sc)))
        (i-letrec (module-values its inner gs)
                  (i-product given (map (lambda ((n string)) (i-local 0 (position-of n names 0))) given))))))

  (module-values (subr kfx (sexps scope strings) irs)
    (lambda (its sc gs)
      (if (null? its)
          nil
          (let ((f (car its)))
            (onto (cond ((or (head-is? f "define") (head-is? f "define*")) (list (named (binder-name (second (items f))) (lower (last (items f)) sc gs))))
                        ((head-is? f "define-rec") (map (lambda ((g sexp)) (named (sym-name (car (items g))) (lower (last (items g)) sc gs))) (cdr (items f))))
                        ((head-is? f "define-datatype")
                         (map (lambda ((g sexp)) (i-lit (v-ctor (sym-name (car (items g))) (i64- (size (items g)) 1)))) (cdr (cdr (items f)))))
                        ((head-is? f "define-generative") (list (i-lit (v-prim "%identity" 1)) (i-lit (v-prim "%identity" 1))))
                        ((and (head-is? f "include") (not (include-named? f)))
                         (cons (named (include-hidden f) (lower (second (items f)) sc gs))
                               (map (lambda ((n string)) (i-extract n (lower-name (include-hidden f) sc gs))) (include-names f gs))))
                        ((head-is? f "include")
                         (let ((m (sym-name (second (items f)))))
                           (if (string-member? m (instances-of gs))
                               ;; A new instance (C213): its maker called, its values taken.
                               (cons (named (string-append "%inst " m) (i-call (lower-name m sc gs) nil))
                                     (map (lambda ((n string)) (i-extract n (lower-name (string-append "%inst " m) sc gs))) (include-exports f gs)))
                               (map (lambda ((n string)) (i-extract n (lower-name m sc gs))) (include-exports f gs)))))
                        ((head-is? f "hide") (module-values (cdr (items f)) sc gs))
                        (else nil))
                  (module-values (cdr its) sc gs))))))

  (lower-typecase (subr kfx (sexp sexps scope strings) ir)
    (lambda (x arms sc gs)
      "`typecase` (C62): each arm its shape's test of `x`, binding it."
      (if (null? arms)
          (i-lit (v-unit))
          (let ((arm (items (car arms))))
            (cond ((and (sym-is? (car arm) "else") (i64= (size arm) 2)) (lower-body (cdr arm) sc gs))
                  ((sym-is? (car arm) "else")
                   "`(else name body)` (C77): `name` the value as the arms leave it."
                   (i-let (list (lower x sc gs)) (lower-body (cdr (cdr arm)) (cons (list (binder-name (second arm))) sc) gs)))
                  (else
                (i-if (i-call (i-lit (v-prim (shape-test (sym-name (car arm))) 1)) (list (lower x sc gs)))
                      (i-let (list (lower x sc gs)) (lower-body (cdr (cdr arm)) (cons (list (binder-name (second arm))) sc) gs))
                      (lower-typecase x (cdr arms) sc gs))))))))

  (lower-case (subr kfx (sexps scope strings) ir)
    (lambda (clauses sc gs)
      "`case`'s clauses, the key the innermost frame's one value."
      (if (null? clauses)
          (i-lit (v-unit))
          (let ((c (items (car clauses))))
            (if (sym-is? (car c) "else")
                (lower-body (cdr c) sc gs)
                (i-if (lower-matches (items (car c)) sc gs) (lower-body (cdr c) sc gs) (lower-case (cdr clauses) sc gs)))))))

  (lower-matches (subr kfx (sexps scope strings) ir)
    (lambda (ds sc gs)
      (if (null? ds)
          (i-lit (v-bool #f))
          (i-if (i-call (i-lit (v-prim "%case=" 2))
                        (list (i-local 0 0)
                              (tagcase (car ds)
                                (sym (n f p) (if (or (string=? n "#t") (string=? n "#f")) (lower (car ds) sc gs) (i-lit (v-symbol (string->symbol n)))))
                                (else other (lower (car ds) sc gs)))))
                (i-lit (v-bool #t))
                (lower-matches (cdr ds) sc gs)))))

  (lower-cond (subr kfx (sexps scope strings) ir)
    (lambda (clauses sc gs)
      (if (null? clauses)
          (i-lit (v-unit))
          (let ((c (items (car clauses))))
            (if (sym-is? (car c) "else")
                (lower-body (cdr c) sc gs)
                (i-if (lower (car c) sc gs) (lower-body (cdr c) sc gs) (lower-cond (cdr clauses) sc gs)))))))

  (lower-tagcase (subr kfx (sexps scope strings) ir)
    (lambda (xs sc gs)
      "`(tagcase e (tag x body) (tag (x ...) body) ... (else x body))`."
      (let* ((arms (cdr xs))
             (default (concat (map (lambda ((a sexp)) (if (sym-is? (car (items a)) "else") (the sexps (list a)) nil)) arms)))
             (named (concat (map (lambda ((a sexp)) (if (sym-is? (car (items a)) "else") nil (the sexps (list a)))) arms))))
        (i-tagcase (lower (car xs) sc gs)
                   (map (lambda ((a sexp))
                          (let* ((parts (items a))
                                 (binder (second parts))
                                 (whole (tagcase binder (lst (ys f l p) #f) (else other #t)))
                                 (names (tagcase binder (lst (ys f l p) (map binder-name ys)) (else other (the strings (list (binder-name binder)))))))
                            (arm (label-of (car parts)) (if whole -1 (size names)) (lower-body (cdr (cdr parts)) (cons names sc) gs))))
                        named)
                   (if (null? default)
                       (i-lit (v-unit))
                       (let ((parts (items (car default))))
                         (lower-body (cdr (cdr parts)) (cons (list (binder-name (second parts))) sc) gs))))))))

"A top-level form: a definition, its global's value; an expression, its
 own (a string too, which `fixpt eval` writes); the rest (types,
 effects) nothing."
(define-datatype top (top-define ir) (top-expr ir) (top-none))

(define-rec
  (lower-tops (subr kfx (sexps strings) (listof top acyclic))
    (lambda (forms gs)
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (onto (cond ((tagcase f (str (s fl p) #t) (else other #f)) (list (top-expr (i-lit (v-string (tagcase f (str (s fl p) s) (else other "")))))))
                        ((head-is? f "define")
                         (let ((xs (items f)))
                           (list (top-define (i-define (position-of (binder-name (second xs)) gs 0)
                                                       (named (binder-name (second xs))
                                                              (if (instance-module? (last xs))
                                                                  ;; Its maker (C213).
                                                                  (lower (lst (list (sym "lambda" "" 0) (lst nil "" 0 0) (last xs)) "" 0 0) nil gs)
                                                                  (lower (last xs) nil gs))))))))
                        ((head-is? f "define*")
                         (let ((xs (items f)))
                           (list (top-define (i-define (position-of (binder-name (second xs)) gs 0) (named (binder-name (second xs)) (lower (last xs) nil gs)))))))
                        ((head-is? f "define-rec")
                         (map (lambda ((g sexp))
                                (let ((ys (items g)))
                                  (top-define (i-define (position-of (sym-name (car ys)) gs 0) (named (sym-name (car ys)) (lower (last ys) nil gs))))))
                              (cdr (items f))))
                        ((head-is? f "define-datatype")
                         (map (lambda ((g sexp))
                                (let ((ys (items g)))
                                  (top-define (i-define (position-of (sym-name (car ys)) gs 0) (i-lit (v-ctor (sym-name (car ys)) (i64- (size ys) 1)))))))
                              (cdr (cdr (items f)))))
                        ((head-is? f "define-generative")
                         "A generative type's conversions, both ways: the value itself."
                         (let ((n (binder-name (second (items f)))))
                           (list (top-define (i-define (position-of (string-append "up-" n) gs 0) (i-lit (v-prim "%identity" 1))))
                                 (top-define (i-define (position-of (string-append "down-" n) gs 0) (i-lit (v-prim "%identity" 1)))))))
                        ((or (head-is? f "define-type") (head-is? f "define-effect") (head-is? f "define-convention"))
                         (list (top-none)))
                        (else (list (top-expr (lower f nil gs)))))
                  (lower-tops (cdr forms) gs)))))))

(define with-entries (subr kfx (facts) strings)
  (lambda (fs)
    "Each `with` of a module value or parameter, what it opens, as the
     checker noted it (`with-spec`): `%with-at FILE:POS x ...`, a slot never
     used (C213)."
    (concat (map (lambda ((f fact))
                   (tagcase f
                     (fact (file pos what)
                       (cond ((has-prefix? what "with-spec ")
                              (the strings (list (string-append "%with-at " (string-append file (string-append ":" (string-append (i64->string pos) (string-append " " (after-prefix what "with-spec ")))))))))
                             ((any? (lambda ((k string)) (has-prefix? what k)) (list "blob-size " "blob-scalar " "blob-element " "blob-variant " "blob-offset " "blob-tagcase "))
                              ;; A flat's layout where it is read (C215).
                              (the strings (list (string-append "%fact " (string-append file (string-append ":" (string-append (i64->string pos) (string-append " " what))))))))
                             (else nil)))))
                 fs))))

(define module-entries (subr kfx (sexps) strings)
  (lambda (forms)
    "The globals' names' entries for modules: `%exports`, and `%any-module`."
    (onto (module-words forms nil) (list (concat-words (cons "%any-module" (moduleof-names forms)))))))
