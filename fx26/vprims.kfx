        ((i64= op 256) (bool-word (keyword-word? a)))
        ((i64= op 257) (keyword-word (symbol-number a)))
        ((i64= op 258) (obj-ref a 0))
        ((i64= op 251) (begin (string-set-w! a (fixnum-value b) (char->i64 (word-char c))) w-unit))
        ((i64= op 252) (begin (string-filled! a 0 (raw-length a) (char->i64 (word-char b))) w-unit))
        ((i64= op 253) (string-copy-w! a (fixnum-value b) (fixnum-value c)))
        ((i64= op 254) (begin (string-copy-into-w! a b c (fourth-arg args) (fifth-arg args)) w-unit))
        (else (begin (failed-with! "the engine: a primitive of no number") 0))))))
