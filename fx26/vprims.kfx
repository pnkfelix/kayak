"vprims.kfx: the primitives over words (C64), generated from the list in
 table.kfx by scripts/gen-vprims.py: `op-need`, the
 room each may allocate, made sure of before it runs; `apply-op`, each by
 its number. The helpers they use are in vwords.kfx."

(define op-need (subr vm (i64 i64) i64)
  (lambda (op args)
    (let ((a (if (i64= args w-nil) (the i64 0) (pair-car args)))
          (b (if (or (i64= args w-nil) (i64= (pair-cdr args) w-nil)) (the i64 0) (pair-car (pair-cdr args)))))
      (cond
        ((i64= op 16) (int-room a b))
        ((i64= op 17) (int-room a b))
        ((i64= op 18) (int-room-mul a b))
        ((i64= op 19) (int-room a b))
        ((i64= op 20) (int-room a b))
        ((i64= op 21) (int-room a b))
        ((i64= op 30) (int-room a b))
        ((i64= op 31) (int-room a b))
        ((i64= op 32) (int-room a b))
        ((i64= op 33) (int-room a a))
        ((i64= op 34) (shift-room a b))
        ((i64= op 37) (text-room a))
        ((i64= op 38) (text-room a))
        ((i64= op 41) (i64+ (i64+ (string-length-w a) (string-length-w b)) 1))
        ((i64= op 49) (i64* 2 (i64+ (string-length-w a) 1)))
        ((i64= op 54) (i64+ (string-length-w a) 1))
        ((i64= op 70) (i64* 3 (i64+ (string-length-w a) 1)))
        ((i64= op 71) (i64+ (list-count a 0) 1))
        ((i64= op 73) (i64+ (string-length-i64 (name-of-number (immediate-value a))) 1))
        ((i64= op 83) (i64* 3 (i64+ (list-count a 0) 1)))
        ((i64= op 84) (i64* 6 (i64+ (list-count a 0) 1)))
        ((i64= op 90) (i64+ (fixnum-value a) 1))
        ((i64= op 94) (i64* 3 (i64+ (obj-size a) 1)))
        ((i64= op 95) (i64+ (list-count a 0) 1))
        ((i64= op 96) (i64+ (fixnum-value b) 1))
        ((i64= op 97) (i64+ (fixnum-value a) 1))
        ((i64= op 101) (i64+ (fixnum-value a) 1))
        ((i64= op 105) (i64+ (obj-size a) 1))
        ((i64= op 108) (i64+ (i64* 4 (string-length-w a)) 2))
        ((i64= op 109) (i64+ (obj-size a) 8))
        ((i64= op 130) (args-room))
        ((i64= op 131) (line-room!))
        ((i64= op 244) (byte-room!))
        ((i64= op 245) (bytes-room! (i64- (fixnum-value (pair-car (pair-cdr (pair-cdr args)))) (fixnum-value b))))
        ((i64= op 247) (term-room! 0))
        ((i64= op 248) (term-room! 1))
        ((i64= op 249) (term-room! 2))
        ((i64= op 132) (file-room! a))
        ((i64= op 134) (dir-room! a))
        ((i64= op 175) (i64+ (list-count a 0) 1))
        ((i64= op 187) (i64+ (i64+ (fixnum-value a) 1) (i64+ (list-count (pair-cdr args) 0) 2)))
        ((i64= op 207) 4096)
        ((i64= op 212) (i64+ (fixnum-value b) 8))
        ((i64= op 222) 8192)
        ((i64= op 223) 24)
        ((i64= op 227) (i64+ (i64* 2 (obj-size (obj-ref a 2))) 16))
        ((i64>= op fixed-base) 8)
        ;; Strings at a region (C285): their room, a word a character.
        ((or (i64= op 250) (i64= op 255)) (i64+ (fixnum-value (if (i64= op 250) a (pair-car (pair-cdr args)))) 1))
        ((i64= op 253) (i64+ (obj-size a) 1))
        (else 64)))))

"What kayak-rt would fail at, beneath a primitive, said first as the
 engine's failure (C110), in kayak-rt's words: a failure there would end
 the REPL, the program's own computation, which nothing catches."
(define refused-op! (subr hp (string) i64)
  (lambda (message) (begin (failed-with! message) 0)))

"`f32`'s operation `i` (`f32-names`) on `a` and `b` (C220): IEEE's,
 binary32, as KFX's own `f32`."
(define f32-op-word (subr (maxeff hp (alloc @h)) (i64 i64 i64) i64)
  (lambda (i a b)
    (cond
      ((i64= i 24) (f32-word (int->f32 (word-int a))))
      ((i64= i 25) (f32-word (f64->f32 (word-real a))))
      ((i64= i 26) (bool-word (f32-word? a)))
      ((i64= i 28) (f32-word (bits->f32 (int->u32 (word-int a)))))
      ((not (f32-word? a)) (refused-op! "an f32 expected"))
      ((i64>= i 11)
       (let ((x (word-f32 a)))
         (cond ((i64= i 11) (f32-word (f32-abs x)))
               ((i64= i 12) (f32-word (f32-neg x)))
               ((i64= i 13) (f32-word (f32-sqrt x)))
               ((i64= i 14) (f32-word (f32-floor x)))
               ((i64= i 15) (f32-word (f32-ceiling x)))
               ((i64= i 16) (f32-word (f32-truncate x)))
               ((i64= i 17) (f32-word (f32-round x)))
               ((i64= i 18) (bool-word (f32-nan? x)))
               ((i64= i 19) (bool-word (f32-infinite? x)))
               ((i64= i 20) (bool-word (f32-finite? x)))
               ((i64= i 21) (string-word! (f32->string x)))
               ((i64= i 22)
                (if (and (f32-finite? x) (f32= (f32-truncate x) x)) (int-word! (f32->int x)) (refused-op! "f32->int: not an integer")))
               ((i64= i 23) (real-word! (f32->f64 x)))
               (else (int-word! (u32->int (f32->bits x)))))))
      ((not (f32-word? b)) (refused-op! "an f32 expected"))
      (else
       (let ((x (word-f32 a)) (y (word-f32 b)))
         (cond ((i64= i 0) (f32-word (f32+ x y)))
               ((i64= i 1) (f32-word (f32- x y)))
               ((i64= i 2) (f32-word (f32* x y)))
               ((i64= i 3) (f32-word (f32/ x y)))
               ((i64= i 4) (f32-word (f32-min x y)))
               ((i64= i 5) (f32-word (f32-max x y)))
               ((i64= i 6) (bool-word (f32< x y)))
               ((i64= i 7) (bool-word (f32<= x y)))
               ((i64= i 8) (bool-word (f32> x y)))
               ((i64= i 9) (bool-word (f32>= x y)))
               (else (bool-word (f32= x y)))))))))

(define char-code? (subr kfx (i64) bool)
  (lambda (n) (and (i64>= n 0) (i64<= n 1114111) (not (and (i64>= n 55296) (i64<= n 57343))))))

(define integral? (subr kfx (f64) bool)
  (lambda (x) (and (f64-finite? x) (f64= (f64-floor x) x))))

(define-rec
  (fields-set! (subr hp (i64 i64 i64) unit)
    (lambda (p i xs)
      "Slots from `i` of `p` the elements of list `xs`, in order."
      (if (i64= xs w-nil) #u (begin (obj-set! p i (pair-car xs)) (fields-set! p (i64+ i 1) (pair-cdr xs)))))))

"Blobrefs (C215), as kayak-rt's `BlobRef`: a flat in a bloblet's bytes,
 `at` bytes in; each scalar read and written little-endian, its code
 (`%blobref-get`): 0 `i64`, 1 `u64`, 2 `f64`, 3 `i32`, 4 `u32`, 5 `f32`,
 6 `u8`, 7 `i8`."
(define blobref-bytes (subr hp (i64) i64) (lambda (r) (obj-ref (obj-ref r 0) 0)))
(define blob-at (subr hp (i64) i64) (lambda (r) (fixnum-value (obj-ref r 1))))

(define blobref! (subr hp (i64 i64 i64) i64)
  (lambda (owner at size)
    "A blobref to a flat of `size` bytes `at` bytes into `owner`'s, which it
     lies within whole, as FX-26 checks it where one is made."
    (if (or (i64< at 0) (i64> (i64+ at size) (obj-size (obj-ref owner 0))))
        (refused-op! (string-append "suffix ref: a flat of " (string-append (i64->string size) (string-append " bytes at byte " (string-append (i64->string at) " runs past the end of the suffix")))))
        (let ((p (alloc! ob-blobref 2))) (begin (obj-set! p 0 owner) (obj-set! p 1 (fixnum at)) p)))))

(define-rec
  (bytes-read (subr hp (i64 i64 i64 int) int)
    (lambda (b at n acc)
      "Bytes `at` to `at + n - 1` of `b`, little-endian, onto `acc`."
      (if (i64<= n 0) acc (bytes-read b at (i64- n 1) (+ (* acc 256) (i64->int (obj-ref b (i64+ at (i64- n 1))))))))))

(define-rec
  (bytes-written! (subr hp (i64 i64 i64 int) unit)
    (lambda (b at n x)
      (if (i64<= n 0) #u
          (begin (obj-set! b at (int->i64 (modulo x 256))) (bytes-written! b (i64+ at 1) (i64- n 1) (quotient (- x (modulo x 256)) 256)))))))

(define scalar-width (subr kfx (i64) i64)
  (lambda (code) (cond ((i64<= code 2) 8) ((i64<= code 5) 4) (else 1))))

(define signed-from (subr kfx (int i64) int)
  (lambda (u n) (let ((top (arithmetic-shift 1 (i64->int (i64* n 8))))) (if (>= u (quotient top 2)) (- u top) u))))

(define blob-get (subr hp (i64 i64) i64)
  (lambda (r code)
    (let* ((n (scalar-width code)) (u (bytes-read (blobref-bytes r) (blob-at r) n 0)))
      (cond ((i64= code 0) (i64-word! (int->i64 (signed-from u 8))))
            ((i64= code 2) (real-word! (bits->f64 (int->u64 u))))
            ((i64= code 5) (f32-word (bits->f32 (int->u32 u))))
            ((or (i64= code 3) (i64= code 7)) (int-word! (signed-from u n)))
            (else (int-word! u))))))

(define blob-set! (subr hp (i64 i64 i64) i64)
  (lambda (r code w)
    (let ((x (cond ((i64= code 0) (i64->int (word-i64 w)))
                   ((i64= code 2) (u64->int (f64->bits (word-real w))))
                   ((i64= code 5) (u32->int (f32->bits (word-f32 w))))
                   (else (word-int w)))))
      (begin (bytes-written! (blobref-bytes r) (blob-at r) (scalar-width code) x) w-unit))))

(define blob-length (subr hp (i64 i64 i64) i64)
  (lambda (r size len)
    "A flat array's length: `len`, or, to the end of the suffix
     (268435455), as many as are left."
    (if (i64= len 268435455) (i64-quotient (i64- (obj-size (blobref-bytes r)) (blob-at r)) size) len)))

(define-rec
  (field-holding (subr hp (i64 i64 i64 i64) i64)
    (lambda (owner w i n)
      "The index of `owner`'s field holding `w`, from `i` of its `n`; -1 if none."
      (cond ((i64>= i n) -1)
            ((i64= (obj-ref owner (i64+ i 1)) w) i)
            (else (field-holding owner w (i64+ i 1) n))))))

(define bloblet! (subr hp (i64 i64) i64)
  (lambda (n fields)
    "A bloblet (C215) of `n` bytes, all 0, and `fields`."
    (let* ((bytes (filled-raw! ob-bytes n 0))
           (p (alloc! ob-bloblet (i64+ (list-count fields 0) 1))))
      (begin (obj-set! p 0 bytes) (fields-set! p 1 fields) p))))

"Tables keyed by identity (C220), as Fixpt's `eqtable.rs` (Larceny's
 design, one stamp): hashed by address, every entry rehashed by an
 operation that finds a collection since, relinked, nothing allocated."
(define eq-bucket (subr kfx (i64 i64) i64)
  (lambda (key n)
    (let ((z (i64-xor (i64-shr key 2) (i64-shr key 11))))
      (i64-remainder (i64-and z 1152921504606846975) n))))

(define eqtable-made! (subr hp () i64)
  (lambda ()
    (let* ((bs (alloc! ob-array 8)) (t (alloc! ob-eqtable 3)))
      (begin (fill! bs 0 8 w-false)
             (obj-set! t 0 (fixnum (get collections))) (obj-set! t 1 (fixnum 0)) (obj-set! t 2 bs)
             t))))

(define-rec
  (chain-relinked! (subr hp (i64 i64) unit)
    (lambda (e bs)
      (if (i64= e w-false)
          #u
          (let ((next (obj-ref e 2)) (b (eq-bucket (obj-ref e 0) (obj-size bs))))
            (begin (obj-set! e 2 (obj-ref bs b)) (obj-set! bs b e) (chain-relinked! next bs))))))
  (buckets-relinked! (subr hp (i64 i64 i64) unit)
    (lambda (old i bs)
      (if (i64>= i (obj-size old))
          #u
          (let ((e (obj-ref old i)))
            (begin (obj-set! old i w-false) (chain-relinked! e bs) (buckets-relinked! old (i64+ i 1) bs)))))))

(define eqtable-relinked! (subr hp (i64 i64) unit)
  (lambda (t bs)
    "Every entry of `t` linked into `bs` by its key's address now."
    (begin (buckets-relinked! (obj-ref t 2) 0 bs) (obj-set! t 2 bs) (obj-set! t 0 (fixnum (get collections))))))

(define eqtable-fresh! (subr hp (i64) unit)
  (lambda (t) (if (i64= (obj-ref t 0) (fixnum (get collections))) #u (eqtable-relinked! t (obj-ref t 2)))))

(define-rec
  (chain-find (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
    (lambda (e key)
      "The entry for `key` from `e` on, or `#f`."
      (cond ((i64= e w-false) w-false)
            ((i64= (obj-ref e 0) key) e)
            (else (chain-find (obj-ref e 2) key))))))

(define eq-entry (subr hp (i64 i64) i64)
  (lambda (t key)
    (begin (eqtable-fresh! t)
           (let ((bs (obj-ref t 2))) (chain-find (obj-ref bs (eq-bucket key (obj-size bs))) key)))))

(define eq-set! (subr hp (i64 i64 i64) unit)
  (lambda (t key v)
    (let ((e (eq-entry t key)))
      (if (not (i64= e w-false))
          (obj-set! e 1 v)
          (let ((n (i64+ (fixnum-value (obj-ref t 1)) 1)) (size (obj-size (obj-ref t 2))))
            (begin
              (obj-set! t 1 (fixnum n))
              (if (i64> n (i64* 2 size))
                  (let ((bigger (alloc! ob-array (i64* 2 size)))) (begin (fill! bigger 0 (i64* 2 size) w-false) (eqtable-relinked! t bigger)))
                  #u)
              (let* ((bs (obj-ref t 2)) (b (eq-bucket key (obj-size bs))) (x (alloc! ob-array 3)))
                (begin (obj-set! x 0 key) (obj-set! x 1 v) (obj-set! x 2 (obj-ref bs b)) (obj-set! bs b x)))))))))

(define-rec
  (chain-without! (subr hp (i64 i64) unit)
    (lambda (before key)
      "The entry for `key` after `before` taken out of its chain."
      (let ((e (obj-ref before 2)))
        (cond ((i64= e w-false) #u)
              ((i64= (obj-ref e 0) key) (obj-set! before 2 (obj-ref e 2)))
              (else (chain-without! e key)))))))

(define eq-delete! (subr hp (i64 i64) unit)
  (lambda (t key)
    (if (i64= (eq-entry t key) w-false)
        #u
        (let* ((bs (obj-ref t 2)) (b (eq-bucket key (obj-size bs))) (first (obj-ref bs b)))
          (begin
            (if (i64= (obj-ref first 0) key) (obj-set! bs b (obj-ref first 2)) (chain-without! first key))
            (obj-set! t 1 (fixnum (i64- (fixnum-value (obj-ref t 1)) 1))))))))

"The engine's syscalls (C224; docs/research/syscalls.md), as Fixpt's
 evaluator's, a runtime of its own: each host name's type in canonical
 form, \"\" for none. Its flat arrays are its own words, at no address
 native code could run, so `code:exec-view/1` gives -1 and `code:flush/1`
 has nothing to do."
(define engine-syscall-type (subr kfx (string) string)
  (lambda (host)
    (cond ((string=? host "code:exec-view/1")
           "(poly ((r1 region)) (subr (maxeff (io sys) (write r1)) ((flatarrayof i64 r1) int int) int))")
          ((string=? host "code:page-words/1") "(subr (io sys) () int)")
          ((string=? host "code:flush/1")
           "(poly ((r1 region)) (subr (maxeff (io sys) (read r1)) ((flatarrayof i64 r1) int int) unit))")
          ;; A string's length in UTF-8 bytes (Fixpt 5731f52, C263).
          ((string=? host "kayak:string-utf8-length/1") "(subr pure (string) int)")
          (else ""))))

"A string's length in UTF-8 bytes, as kayak-rt says, the engine's own
 syscall (C263)."
(define-syscall host-utf8-length "kayak:string-utf8-length/1" (subr pure (string) int))

"The words in one page of the machine this runs on, as kayak-rt says,
 asked as the engine's own syscall (C225)."
(define-syscall host-page-words "code:page-words/1" (subr (io sys) () int))
(define engine-page-words (subr (maxeff (read @globals) (io sys)) () i64)
  (lambda () (int->i64 (host-page-words))))

(define apply-op (subr vm (i64 i64) i64)
  (lambda (op args)
    (let* ((a (if (i64= args w-nil) (the i64 0) (pair-car args)))
           (r1 (if (i64= args w-nil) w-nil (pair-cdr args)))
           (b (if (i64= r1 w-nil) (the i64 0) (pair-car r1)))
           (r2 (if (i64= r1 w-nil) w-nil (pair-cdr r1)))
           (c (if (i64= r2 w-nil) (the i64 0) (pair-car r2))))
      (cond
        ((i64= op 0) (i64-word! (i64+ (word-i64 a) (word-i64 b))))
        ((i64= op 1) (i64-word! (i64- (word-i64 a) (word-i64 b))))
        ((i64= op 2) (i64-word! (i64* (word-i64 a) (word-i64 b))))
        ((and (or (i64= op 3) (i64= op 4)) (i64= (word-i64 b) 0))
         (refused-op! (if (i64= op 3) "i64-quotient: division by zero" "i64-remainder: division by zero")))
        ((i64= op 3) (i64-word! (i64-quotient (word-i64 a) (word-i64 b))))
        ((i64= op 4) (i64-word! (i64-remainder (word-i64 a) (word-i64 b))))
        ((i64= op 5) (i64-word! (i64-and (word-i64 a) (word-i64 b))))
        ((i64= op 6) (i64-word! (i64-or (word-i64 a) (word-i64 b))))
        ((i64= op 7) (i64-word! (i64-xor (word-i64 a) (word-i64 b))))
        ((i64= op 8) (i64-word! (i64-not (word-i64 a))))
        ((i64= op 9) (bool-word (i64= (word-i64 a) (word-i64 b))))
        ((i64= op 10) (bool-word (i64< (word-i64 a) (word-i64 b))))
        ((i64= op 11) (bool-word (i64> (word-i64 a) (word-i64 b))))
        ((i64= op 12) (bool-word (i64<= (word-i64 a) (word-i64 b))))
        ((i64= op 13) (bool-word (i64>= (word-i64 a) (word-i64 b))))
        ((i64= op 14) (i64-word! (i64-shl (word-i64 a) (word-int b))))
        ((i64= op 15) (i64-word! (i64-shr (word-i64 a) (word-int b))))
        ((i64= op 16) (int-word! (+ (word-int a) (word-int b))))
        ((i64= op 17) (int-word! (- (word-int a) (word-int b))))
        ((i64= op 18) (int-word! (* (word-int a) (word-int b))))
        ((and (i64>= op 19) (i64<= op 21) (zero? (word-int b)))
         (refused-op! (if (i64= op 19) "quotient: division by zero" "remainder: division by zero")))
        ((i64= op 19) (int-word! (quotient (word-int a) (word-int b))))
        ((i64= op 20) (int-word! (remainder (word-int a) (word-int b))))
        ((i64= op 21) (int-word! (modulo (word-int a) (word-int b))))
        ((i64= op 22) (bool-word (= (word-int a) (word-int b))))
        ((i64= op 23) (bool-word (< (word-int a) (word-int b))))
        ((i64= op 24) (bool-word (> (word-int a) (word-int b))))
        ((i64= op 25) (bool-word (<= (word-int a) (word-int b))))
        ((i64= op 26) (bool-word (>= (word-int a) (word-int b))))
        ((i64= op 27) (int-word! (max (word-int a) (word-int b))))
        ((i64= op 28) (int-word! (min (word-int a) (word-int b))))
        ((i64= op 29) (bool-word (zero? (word-int a))))
        ((i64= op 30) (int-word! (bitwise-and (word-int a) (word-int b))))
        ((i64= op 31) (int-word! (bitwise-ior (word-int a) (word-int b))))
        ((i64= op 32) (int-word! (bitwise-xor (word-int a) (word-int b))))
        ((i64= op 33) (int-word! (bitwise-not (word-int a))))
        ((and (i64= op 34) (> (word-int b) 4294967296) (not (zero? (word-int a))))
         (refused-op! "arithmetic-shift: the count is too large"))
        ((i64= op 34) (int-word! (arithmetic-shift (word-int a) (word-int b))))
        ((i64= op 35) (i64-word! (int->i64 (word-int a))))
        ((i64= op 36) a)
        ((i64= op 37) (int-text! a))
        ((i64= op 38) (int-text! a))
        ((i64= op 39) (bool-word (not (truthy? a))))
        ((i64= op 40) (bool-word (i64= a b)))
        ((i64= op 41) (string-append-w! a b))
        ((i64= op 42) (bool-word (i64= (string-compare-w a b 0) 0)))
        ((i64= op 43) (bool-word (i64< (string-compare-w a b 0) 0)))
        ((i64= op 44) (bool-word (i64> (string-compare-w a b 0) 0)))
        ((i64= op 45) (bool-word (i64<= (string-compare-w a b 0) 0)))
        ((i64= op 46) (bool-word (i64>= (string-compare-w a b 0) 0)))
        ((i64= op 47) (fixnum (string-compare-w a b 0)))
        ((i64= op 48) (fixnum (string-search-w a b (fixnum-value c))))
        ((i64= op 49) (string-word! (string-downcase (word-string a))))
        ((i64= op 50) (fixnum (string-length-w a)))
        ((i64= op 51) (fixnum (string-length-w a)))
        ((i64= op 52) (string-ref-w a (fixnum-value b)))
        ((i64= op 53) (string-ref-w a (fixnum-value b)))
        ((i64= op 54) (substring-w! a (fixnum-value b) (fixnum-value c)))
        ((i64= op 55) (fixnum (immediate-value a)))
        ((i64= op 56) (fixnum (immediate-value a)))
        ((and (or (i64= op 57) (i64= op 58)) (not (char-code? (fixnum-value a))))
         (refused-op! "integer->char: no character has that code"))
        ((i64= op 57) (immediate imm-char (fixnum-value a)))
        ((i64= op 58) (immediate imm-char (fixnum-value a)))
        ((i64= op 59) (char-string! a))
        ((i64= op 60) (bool-word (i64= a b)))
        ((i64= op 61) (bool-word (i64< a b)))
        ((i64= op 62) (bool-word (i64> a b)))
