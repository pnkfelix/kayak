"vprims.kfx: the primitives over words (C64), generated from the list in
 table.kfx by scripts/gen-vprims.py: `op-need`, the
 room each may allocate, made sure of before it runs; `apply-op`, each by
 its number. The helpers they use are in vwords.kfx."

(define op-need (subr vm (i64 i64) i64)
  (lambda (op args)
    (let ((a (if (i64= args w-nil) (the i64 0) (pair-car args)))
          (b (if (or (i64= args w-nil) (i64= (pair-cdr args) w-nil)) (the i64 0) (pair-car (pair-cdr args)))))
      (cond
        ((i64= op 16) (int-room a b))
        ((i64= op 17) (int-room a b))
        ((i64= op 18) (int-room-mul a b))
        ((i64= op 19) (int-room a b))
        ((i64= op 20) (int-room a b))
        ((i64= op 21) (int-room a b))
        ((i64= op 30) (int-room a b))
        ((i64= op 31) (int-room a b))
        ((i64= op 32) (int-room a b))
        ((i64= op 33) (int-room a a))
        ((i64= op 34) (shift-room a b))
        ((i64= op 37) (text-room a))
        ((i64= op 38) (text-room a))
        ((i64= op 41) (i64+ (i64+ (string-length-w a) (string-length-w b)) 1))
        ;; A symbol made the first time (C321): it, its name's string, a keyword.
        ((i64= op 72) (i64+ (string-length-w a) 16))
        ((i64= op 257) (i64+ (raw-length (obj-ref a 0)) 16))
        ((i64= op 49) (i64* 2 (i64+ (string-length-w a) 1)))
        ((i64= op 54) (i64+ (string-length-w a) 1))
        ((i64= op 70) (i64* 3 (i64+ (string-length-w a) 1)))
        ((i64= op 71) (i64+ (list-count a 0) 1))
        ((i64= op 73) (i64+ (raw-length (obj-ref a 0)) 2))
        ((i64= op 83) (i64* 3 (i64+ (list-count a 0) 1)))
        ((i64= op 84) (i64* 6 (i64+ (list-count a 0) 1)))
        ((i64= op 90) (i64+ (fixnum-value a) 2))
        ((i64= op 94) (i64* 3 (i64+ (obj-size a) 1)))
        ((i64= op 95) (i64+ (list-count a 0) 2))
        ((i64= op 96) (i64+ (fixnum-value b) 2))
        ((i64= op 97) (i64+ (fixnum-value a) 4))
        ((i64= op 101) (i64+ (fixnum-value a) 1))
        ((i64= op 105) (i64+ (obj-size a) 1))
        ((i64= op 108) (i64+ (i64* 4 (string-length-w a)) 2))
        ((i64= op 109) (i64+ (utf8-byte-count a) 8))
        ;; UTF-8 text's (C525), hand-written: `bytes->utf8`, `utf8->bytes`.
        ((i64= op 278) (i64+ (raw-length a) 8))
        ((i64= op 279) (i64+ (utf8-byte-count a) 8))
        ((i64= op 130) (args-room))
        ((i64= op 131) (line-room!))
        ((i64= op 244) (byte-room!))
        ((i64= op 245) (bytes-room! (i64- (fixnum-value (pair-car (pair-cdr (pair-cdr args)))) (fixnum-value b))))
        ((i64= op 247) (term-room! 0))
        ((i64= op 248) (term-room! 1))
        ((i64= op 249) (term-room! 2))
        ((i64= op 132) (file-room! a))
        ((i64= op 134) (dir-room! a))
        ((i64= op 259) (info-room! a))
        ((i64= op 260) (link-room! a))
        ((i64= op 261) (started-room! a b))
        ((i64= op 262) (output-room! a))
        ((i64= op 175) (i64+ (list-count a 0) 1))
        ((i64= op 187) (i64+ (i64-quotient (fixnum-value a) 8) (i64+ (list-count (pair-cdr args) 0) 4)))
        ((i64= op 207) 4096)
        ((i64= op 269) 65536)
        ((i64= op 270) 65536)
        ((i64= op 212) (i64+ (fixnum-value b) 8))
        ((i64= op 222) 8192)
        ((i64= op 223) 24)
        ((i64= op 227) (i64+ (i64* 2 (obj-size (slot-of a 3))) 16))
        ((i64>= op fixed-base) 8)
        ;; Strings at a region (C285): their room, a word a character.
        ((or (i64= op 250) (i64= op 255)) (i64+ (fixnum-value (if (i64= op 250) a (pair-car (pair-cdr args)))) 1))
        ((i64= op 253) (i64+ (obj-size a) 1))
        (else 64)))))

"What kayak-rt would fail at, beneath a primitive, said first as the
 engine's failure (C110), in kayak-rt's words: a failure there would end
 the REPL, the program's own computation, which nothing catches."
(define refused-op! (subr hp (string) i64)
  (lambda (message) (begin (failed-with! message) 0)))

"`f32`'s operation `i` (`f32-names`) on `a` and `b` (C220): IEEE's,
 binary32, as KFX's own `f32`."
(define f32-op-word (subr (maxeff hp (alloc @c)) (i64 i64 i64) i64)
  (lambda (i a b)
    (cond
      ((i64= i 24) (f32-value (int->f32 (int-of a))))
      ((i64= i 25) (f32-value (f64->f32 (flonum-of a))))
      ((i64= i 26) (bool-word (is-f32? a)))
      ((i64= i 28) (f32-value (bits->f32 (int->u32 (int-of a)))))
      ((not (is-f32? a)) (refused-op! "an f32 expected"))
      ((i64>= i 11)
       (let ((x (f32-of a)))
         (cond ((i64= i 11) (f32-value (f32-abs x)))
               ((i64= i 12) (f32-value (f32-neg x)))
               ((i64= i 13) (f32-value (f32-sqrt x)))
               ((i64= i 14) (f32-value (f32-floor x)))
               ((i64= i 15) (f32-value (f32-ceiling x)))
               ((i64= i 16) (f32-value (f32-truncate x)))
               ((i64= i 17) (f32-value (f32-round x)))
               ((i64= i 18) (bool-word (f32-nan? x)))
               ((i64= i 19) (bool-word (f32-infinite? x)))
               ((i64= i 20) (bool-word (f32-finite? x)))
               ((i64= i 21) (string-word! (f32->string x)))
               ((i64= i 22)
                (if (and (f32-finite? x) (f32= (f32-truncate x) x)) (int-value! (f32->int x)) (refused-op! "f32->int: not an integer")))
               ((i64= i 23) (make-flonum! (f32->f64 x)))
               (else (int-value! (u32->int (f32->bits x)))))))
      ((not (is-f32? b)) (refused-op! "an f32 expected"))
      (else
       (let ((x (f32-of a)) (y (f32-of b)))
         (cond ((i64= i 0) (f32-value (f32+ x y)))
               ((i64= i 1) (f32-value (f32- x y)))
               ((i64= i 2) (f32-value (f32* x y)))
               ((i64= i 3) (f32-value (f32/ x y)))
               ((i64= i 4) (f32-value (f32-min x y)))
               ((i64= i 5) (f32-value (f32-max x y)))
               ((i64= i 6) (bool-word (f32< x y)))
               ((i64= i 7) (bool-word (f32<= x y)))
               ((i64= i 8) (bool-word (f32> x y)))
               ((i64= i 9) (bool-word (f32>= x y)))
               (else (bool-word (f32= x y)))))))))

(define char-code? (subr kfx (i64) bool)
  (lambda (n) (and (i64>= n 0) (i64<= n 1114111) (not (and (i64>= n 55296) (i64<= n 57343))))))

(define integral? (subr kfx (f64) bool)
  (lambda (x) (and (f64-finite? x) (f64= (f64-floor x) x))))

(define-rec
  (fields-set! (subr hp (i64 i64 i64) unit)
    (lambda (p i xs)
      "Slots from `i` of `p` the elements of list `xs`, in order."
      (if (i64= xs w-nil) #u (begin (obj-set! p i (pair-car xs)) (fields-set! p (i64+ i 1) (pair-cdr xs)))))))

"Blobrefs (C215), as kayak-rt's `BlobRef`: a flat in a bloblet's bytes,
 `at` bytes in; each scalar read and written little-endian, its code
 (`%blobref-get`): 0 `i64`, 1 `u64`, 2 `f64`, 3 `i32`, 4 `u32`, 5 `f32`,
 6 `u8`, 7 `i8`."
(define blobref-bytes (subr cread (i64) i64) (lambda (r) (sref-owner r)))
(define blob-at (subr kfx (i64) i64) (lambda (r) (sref-offset r)))

(define blobref! (subr hp (i64 i64 i64) i64)
  (lambda (owner at size)
    "A blobref, a suffix ref (C326), to a flat of `size` bytes `at` bytes
     into `owner`'s suffix, which it lies within whole, as FX-26 checks it
     where one is made."
    (if (or (i64< at 0) (i64> (i64+ at size) (suffix-bytes owner)))
        (refused-op! (string-append "suffix ref: a flat of " (string-append (i64->string size) (string-append " bytes at byte " (string-append (i64->string at) " runs past the end of the suffix")))))
        (suffix-ref owner at))))

(define-rec
  (bytes-read (subr hp (i64 i64 i64 int) int)
    (lambda (b at n acc)
      "Bytes `at` to `at + n - 1` of `b`, little-endian, onto `acc`."
      (if (i64<= n 0) acc (bytes-read b at (i64- n 1) (+ (* acc 256) (i64->int (suffix-byte b (i64+ at (i64- n 1))))))))))

(define-rec
  (bytes-written! (subr hp (i64 i64 i64 int) unit)
    (lambda (b at n x)
      (if (i64<= n 0) #u
          (begin (suffix-byte-set! b at (int->i64 (modulo x 256))) (bytes-written! b (i64+ at 1) (i64- n 1) (quotient (- x (modulo x 256)) 256)))))))

(define scalar-width (subr kfx (i64) i64)
  (lambda (code) (cond ((i64<= code 2) 8) ((i64<= code 5) 4) (else 1))))

(define signed-from (subr kfx (int i64) int)
  (lambda (u n) (let ((top (arithmetic-shift 1 (i64->int (i64* n 8))))) (if (>= u (quotient top 2)) (- u top) u))))

(define blob-get (subr hp (i64 i64) i64)
  (lambda (r code)
    (let* ((n (scalar-width code)) (u (bytes-read (blobref-bytes r) (blob-at r) n 0)))
      (cond ((i64= code 0) (i64-word! (int->i64 (signed-from u 8))))
            ((i64= code 2) (make-flonum! (bits->f64 (int->u64 u))))
            ((i64= code 5) (f32-value (bits->f32 (int->u32 u))))
            ((or (i64= code 3) (i64= code 7)) (int-value! (signed-from u n)))
            (else (int-value! u))))))

(define blob-set! (subr hp (i64 i64 i64) i64)
  (lambda (r code w)
    (let ((x (cond ((i64= code 0) (i64->int (word-i64 w)))
                   ((i64= code 2) (u64->int (f64->bits (flonum-of w))))
                   ((i64= code 5) (u32->int (f32->bits (f32-of w))))
                   (else (int-of w)))))
      (begin (bytes-written! (blobref-bytes r) (blob-at r) (scalar-width code) x) w-unit))))

(define blob-length (subr hp (i64 i64 i64) i64)
  (lambda (r size len)
    "A flat array's length: `len`, or, to the end of the suffix
     (268435455), as many as are left."
    (if (i64= len 268435455) (i64-quotient (i64- (suffix-bytes (blobref-bytes r)) (blob-at r)) size) len)))

"Flat arrays (C327): Fixpt's (`make_flat_array`), kind `flat-array`, its
 layout's code in its one slot (`layout.rs`'s `FLAT_*`: 0 `i32`, 1 `u32`,
 2 `i64`, 3 `u64`, 4 `f32`, 5 `f64`), its elements' bits its suffix, 4 or
 8 bytes each, two to a word when 4. KFX's `make-flatarray-i64` is one of
 `i64`s."
(define flat-size (subr kfx (i64) i64)
  (lambda (code) (if (or (i64= code 0) (i64= code 1) (i64= code 4)) 4 8)))
(define flat-array-code (subr hp (i64) i64) (lambda (a) (fixnum-value (bloblet-value a 0))))
(define flat-count (subr hp (i64) i64)
  (lambda (a) (i64-quotient (suffix-bytes a) (flat-size (flat-array-code a)))))

(define flat-made! (subr hp (i64 i64) i64)
  (lambda (code n)
    (let ((p (bloblet-alloc! 1 (i64* n (flat-size code)))))
      (begin (mem-set! (header-at p) (header ob-flatx 2 (i64* n (flat-size code)))) (bloblet-value-set! p 0 (fixnum code)) p))))

(define flat-bits (subr hp (i64 i64) i64)
  (lambda (a i)
    (if (i64= (flat-size (flat-array-code a)) 8)
        (mem-at (i64+ (address a) i))
        (i64-and (i64-shr (mem-at (i64+ (address a) (i64-quotient i 2))) (i64->int (i64* 32 (i64-remainder i 2)))) 4294967295))))

(define flat-bits-set! (subr hp (i64 i64 i64) unit)
  (lambda (a i x)
    (if (i64= (flat-size (flat-array-code a)) 8)
        (mem-set! (i64+ (address a) i) x)
        (let* ((at (i64+ (address a) (i64-quotient i 2))) (sh (i64->int (i64* 32 (i64-remainder i 2)))))
          (mem-set! at (i64-or (i64-and (mem-at at) (i64-not (i64-shl 4294967295 sh))) (i64-shl (i64-and x 4294967295) sh)))))))

(define flat-value (subr hp (i64 i64) i64)
  (lambda (code bits)
    "The value bits of layout `code` stand for (`flat_value`)."
    (cond ((i64= code 0) (int-value! (signed-from (unsigned-int bits) 4)))
          ((i64= code 2) (i64-word! bits))
          ((i64= code 4) (f32-value (bits->f32 (int->u32 (unsigned-int bits)))))
          ((i64= code 5) (make-flonum! (bits->f64 (int->u64 (unsigned-int bits)))))
          (else (int-value! (unsigned-int bits))))))

(define flat-bits-of (subr hp (i64 i64) i64)
  (lambda (code w)
    "A value of layout `code`, as the bits a flat array keeps (`flat_bits_of`)."
    (cond ((or (i64= code 0) (i64= code 1)) (i64-and (word-i64 w) 4294967295))
          ((i64= code 2) (word-i64 w))
          ((i64= code 3) (limb-word (modulo (int-of w) two-64)))
          ((i64= code 4) (limb-word (u32->int (f32->bits (f32-of w)))))
          (else (limb-word (u64->int (f64->bits (flonum-of w))))))))

(define-rec
  (flat-filled! (subr hp (i64 i64 i64 i64) unit)
    (lambda (a i n x) (if (i64>= i n) #u (begin (flat-bits-set! a i x) (flat-filled! a (i64+ i 1) n x))))))

(define flat-filled-made! (subr hp (i64 i64 i64) i64)
  (lambda (code n w)
    (if (i64< n 0)
        (refused-op! "make-flatarray: a negative length")
        (let ((a (flat-made! code n)) (x (flat-bits-of code w)))
          (begin (if (i64= x 0) #u (flat-filled! a 0 n x)) a)))))

(define flat-index (subr hp (i64 i64) i64)
  (lambda (a i) (if (or (i64< i 0) (i64>= i (flat-count a))) (begin (refused-op! "flatarray: index out of range") -1) i)))

(define-rec
  (field-holding (subr hp (i64 i64 i64 i64) i64)
    (lambda (owner w i n)
      "The index of `owner`'s field holding `w`, from `i` of its `n`; -1 if none."
      (cond ((i64>= i n) -1)
            ((i64= (bloblet-value owner i) w) i)
            (else (field-holding owner w (i64+ i 1) n))))))

(define bloblet! (subr hp (i64 i64) i64)
  (lambda (n fields)
    "A bloblet (C215) of `n` bytes, all 0, and `fields`: Fixpt's plain
     bloblet (C326)."
    (if (or (i64< n 0) (i64> n 4294967295))
        (refused-op! "a bloblet's suffix is 0 to 4 GiB")
        (list-bloblet! n fields))))

"Tables keyed by identity (C220), Fixpt's (`eqtable.rs`, C329; Larceny's
 design, one stamp): a bloblet of kind `eqtable`, no trailer, its fields
 the count of collections when its keys were last hashed (1), its count
 (2) and its buckets (3), a vector of chains; an entry a vector of its key
 (0), value (1) and next entry (2), `#f` at a chain's end. Hashed by
 address, SplitMix64's finalizer as Fixpt's `bucket_of`; every entry
 rehashed by an operation that finds a collection since, relinked,
 nothing allocated."
(define eq-mixed (subr kfx (i64 i64) i64)
  (lambda (z s)
    "`z` xor `z` shifted right `s` bits, logically: as a `u64`'s."
    (i64-xor z (i64-and (i64-shr z (i64->int s)) (i64- (i64-shl 1 (i64->int (i64- 64 s))) 1)))))
(define eq-bucket (subr kfx (i64 i64) i64)
  (lambda (key n)
    (let* ((z1 (i64* (eq-mixed key 30) -4658895280553007687))
           (z2 (i64* (eq-mixed z1 27) -7723592293110705685))
           (z (eq-mixed z2 31)))
      ;; `z` modulo `n`, `z` read as a `u64`'s bits.
      (if (i64>= z 0)
          (i64-remainder z n)
          (i64-remainder (i64+ (i64* 2 (i64-remainder (i64-and (i64-shr z 1) 9223372036854775807) n)) (i64-and z 1)) n)))))

(define eq-vector! (subr hp (i64) i64)
  (lambda (n) (let ((v (alloc! ob-vector n))) (begin (fill! v 0 n w-false) v))))

(define eqtable-made! (subr hp () i64)
  (lambda ()
    (let* ((bs (eq-vector! 8)) (t (fields-alloc! ob-eqtable 3)))
      (begin (slot-set! t 1 (fixnum (get collections))) (slot-set! t 2 (fixnum 0)) (slot-set! t 3 bs)
             t))))

(define-rec
  (chain-relinked! (subr hp (i64 i64) unit)
    (lambda (e bs)
      (if (i64= e w-false)
          #u
          (let ((next (obj-ref e 2)) (b (eq-bucket (obj-ref e 0) (obj-size bs))))
            (begin (obj-set! e 2 (obj-ref bs b)) (obj-set! bs b e) (chain-relinked! next bs))))))
  (buckets-relinked! (subr hp (i64 i64 i64) unit)
    (lambda (old i bs)
      (if (i64>= i (obj-size old))
          #u
          (let ((e (obj-ref old i)))
            (begin (obj-set! old i w-false) (chain-relinked! e bs) (buckets-relinked! old (i64+ i 1) bs)))))))

(define eqtable-relinked! (subr hp (i64 i64) unit)
  (lambda (t bs)
    "Every entry of `t` linked into `bs` by its key's address now."
    (begin (buckets-relinked! (slot-of t 3) 0 bs) (slot-set! t 3 bs) (slot-set! t 1 (fixnum (get collections))))))

(define eqtable-fresh! (subr hp (i64) unit)
  (lambda (t) (if (i64= (slot-of t 1) (fixnum (get collections))) #u (eqtable-relinked! t (slot-of t 3)))))

(define-rec
  (chain-find (subr (maxeff (read @globals) spin (read @c)) (i64 i64) i64)
    (lambda (e key)
      "The entry for `key` from `e` on, or `#f`."
      (cond ((i64= e w-false) w-false)
            ((i64= (obj-ref e 0) key) e)
            (else (chain-find (obj-ref e 2) key))))))

(define eq-entry (subr hp (i64 i64) i64)
  (lambda (t key)
    (begin (eqtable-fresh! t)
           (let ((bs (slot-of t 3))) (chain-find (obj-ref bs (eq-bucket key (obj-size bs))) key)))))

(define eq-count (subr (maxeff (read @globals) spin (read @c)) (i64) i64)
  (lambda (t) (fixnum-value (slot-of t 2))))

(define eq-set! (subr hp (i64 i64 i64) unit)
  (lambda (t key v)
    (let ((e (eq-entry t key)))
      (if (not (i64= e w-false))
          (obj-set! e 1 v)
          (let ((n (i64+ (eq-count t) 1)) (size (obj-size (slot-of t 3))))
            (begin
              (slot-set! t 2 (fixnum n))
              (if (i64> n (i64* 2 size)) (eqtable-relinked! t (eq-vector! (i64* 2 size))) #u)
              (let* ((bs (slot-of t 3)) (b (eq-bucket key (obj-size bs))) (x (alloc! ob-vector 3)))
                (begin (obj-set! x 0 key) (obj-set! x 1 v) (obj-set! x 2 (obj-ref bs b)) (obj-set! bs b x)))))))))

(define-rec
  (chain-without! (subr hp (i64 i64) unit)
    (lambda (before key)
      "The entry for `key` after `before` taken out of its chain."
      (let ((e (obj-ref before 2)))
        (cond ((i64= e w-false) #u)
              ((i64= (obj-ref e 0) key) (obj-set! before 2 (obj-ref e 2)))
              (else (chain-without! e key)))))))

(define eq-delete! (subr hp (i64 i64) unit)
  (lambda (t key)
    (if (i64= (eq-entry t key) w-false)
        #u
        (let* ((bs (slot-of t 3)) (b (eq-bucket key (obj-size bs))) (first (obj-ref bs b)))
          (begin
            (if (i64= (obj-ref first 0) key) (obj-set! bs b (obj-ref first 2)) (chain-without! first key))
            (slot-set! t 2 (fixnum (i64- (eq-count t) 1))))))))

"The engine's syscalls (C224; docs/research/syscalls.md), as Fixpt's
 evaluator's, a runtime of its own: each host name's type in canonical
 form, \"\" for none. Its flat arrays are its own words, at no address
 native code could run, so `code:exec-view/1` gives -1 and `code:flush/1`
 has nothing to do."
(define engine-syscall-type (subr kfx (string) string)
  (lambda (host)
    (cond ((string=? host "code:exec-view/1")
           "(poly ((r1 region)) (subr (maxeff (io sys) (write r1)) ((flatarrayof i64 r1) int int) int))")
          ((string=? host "code:page-words/1") "(subr (io sys) () int)")
          ((string=? host "code:flush/1")
           "(poly ((r1 region)) (subr (maxeff (io sys) (read r1)) ((flatarrayof i64 r1) int int) unit))")
          ;; A string's length in UTF-8 bytes (Fixpt 5731f52, C263).
          ((string=? host "kayak:string-utf8-length/1") "(subr pure (string) int)")
          (else ""))))

"A string's length in UTF-8 bytes, as kayak-rt says, the engine's own
 syscall (C263)."
(define-syscall host-utf8-length "kayak:string-utf8-length/1" (subr pure (string) int))

"The words in one page of the machine this runs on, as kayak-rt says,
 asked as the engine's own syscall (C225)."
(define-syscall host-page-words "code:page-words/1" (subr (io sys) () int))
(define engine-page-words (subr (maxeff (read @globals) spin (io sys)) () i64)
  (lambda () (int->i64 (host-page-words))))

(define apply-op (subr vm (i64 i64) i64)
  (lambda (op args)
    (let* ((a (if (i64= args w-nil) (the i64 0) (pair-car args)))
           (r1 (if (i64= args w-nil) w-nil (pair-cdr args)))
           (b (if (i64= r1 w-nil) (the i64 0) (pair-car r1)))
           (r2 (if (i64= r1 w-nil) w-nil (pair-cdr r1)))
           (c (if (i64= r2 w-nil) (the i64 0) (pair-car r2))))
      (cond
        ((i64= op 0) (i64-word! (i64+ (word-i64 a) (word-i64 b))))
