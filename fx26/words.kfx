"words.kfx: the engine's values as words and heap objects (C64): making
 them, taking them apart, and the conversions to and from KFX's `int`,
 strings and `f64`, which allocate KFX data and so are for loading, I/O
 and bignums alone, never a step's work."

(define-effect hp (maxeff (read @globals) spin (read @c) (write @c)))

(define-effect vm (maxeff (read @globals) spin (read @c) (write @c) (alloc @c)
                          (io stdin) (io stdout) (io stderr) (io clock) (io fs-read) (io fs-write) (io args) (io exit) (io sys) (io terminal) (io process)
                          ;; A stage's check, a worker's (C305).
                          (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet))


"Integers: a fixnum if it fits, else a bignum, Fixpt's (C324), tier 1's
 (`int-value!`, `int-of`; C333)."
(define big-words (subr kfx (int) i64)
  (lambda (n) "How many words a bignum of `n` needs." (i64+ 3 (limbs-count (if (< n 0) (- 0 n) n) 0))))

(define word-i64 (subr hp (i64) i64)
  (lambda (w) "An `i64`'s value: a fixnum's, or the low 64 bits of a bignum's." (if (fixnum? w) (fixnum-value w) (int->i64 (int-of w)))))

(define i64-room (subr kfx (i64) i64)
  (lambda (n) "The room an `i64` result may need: a bignum's, if it is no fixnum." (if (fits-fixnum? n) (the i64 0) (the i64 4))))

(define i64-word! (subr hp (i64) i64)
  (lambda (n) (if (fits-fixnum? n) (fixnum n) (int-value! (i64->int n)))))

"Characters, booleans, symbols."
(define char-word (subr kfx (char) i64) (lambda (c) (immediate imm-char (char->i64 c))))
(define word-char (subr kfx (i64) char) (lambda (w) (i64->char (immediate-value w))))
(define bool-word (subr kfx (bool) i64) (lambda (b) (if b w-true w-false)))
(define truthy? (subr kfx (i64) bool) (lambda (w) (not (i64= w w-false))))

(define is-imm? (subr kfx (i64 i64) bool) (lambda (w kind) (and (immediate? w) (i64= (immediate-kind w) kind))))

"`f32`s (C220): tier 1's (`f32-value`, `f32-of`, `is-f32?`; C333),
 Fixpt's immediate of subtag 9, its bits from bit 32 (the engine's were
 from bit 8, C318)."

"Objects of a kind."
(define is-obj? (subr (maxeff (read @globals) spin (read @c)) (i64 i64) bool)
  (lambda (w kind)
    "A pair by its tag; any other object by its header (C318)."
    (if (i64= kind ob-pair)
        (is-pair? w)
        (and (i64= (i64-and w 7) 4) (i64= (header-kind (mem-at (header-at w))) kind)))))

"Pairs: their car and cdr, written in place."
(define pair! (subr hp (i64 i64) i64)
  (lambda (a d) (let ((i (bump! 2))) (begin (mem-set! i a) (mem-set! (i64+ i 1) d) (pair-at i)))))

"Strings and bytevectors, Fixpt's (`heap.rs`, as tier 1 has them; C320):
 a bloblet of no fields, its suffix a word of the length, then the code
 points two to a word, or the bytes eight to a word, the first in the
 low bits."

(define raw-made! (subr hp (i64 i64 i64) i64)
  (lambda (kind words n)
    (let ((p (alloc! kind words)))
      (begin (mem-set! (address p) n) (words-zeroed! (i64+ (address p) 1) (i64- words 1)) p))))

(define string-alloc! (subr hp (i64) i64)
  (lambda (n) (raw-made! ob-string (i64+ 1 (i64-quotient (i64+ n 1) 2)) n)))
(define bytes-alloc! (subr hp (i64) i64)
  (lambda (n) (raw-made! ob-bytes (i64+ 1 (i64-quotient (i64+ n 7) 8)) n)))

(define raw-length (subr (maxeff (read @globals) spin (read @c)) (i64) i64)
  (lambda (v) (mem-at (address v))))
(define string-length-w (subr (maxeff (read @globals) spin (read @c)) (i64) i64) (lambda (s) (raw-length s)))

(define char-at (subr (maxeff (read @globals) spin (read @c)) (i64 i64) i64)
  (lambda (s i)
    (let ((w (mem-at (i64+ (address s) (i64+ 1 (i64-quotient i 2))))))
      (if (i64= (i64-remainder i 2) 0) (i64-and w 4294967295) (i64-and (i64-shr w 32) 4294967295)))))
(define char-set! (subr hp (i64 i64 i64) unit)
  (lambda (s i cp)
    (let* ((at (i64+ (address s) (i64+ 1 (i64-quotient i 2)))) (w (mem-at at)))
      (mem-set! at (if (i64= (i64-remainder i 2) 0)
                   (i64-or (i64-and w -4294967296) cp)
                   (i64-or (i64-and w 4294967295) (i64-shl cp 32)))))))

(define byte-at (subr (maxeff (read @globals) spin (read @c)) (i64 i64) i64)
  (lambda (b i)
    (i64-and (i64-shr (mem-at (i64+ (address b) (i64+ 1 (i64-quotient i 8)))) (i64->int (i64* 8 (i64-remainder i 8)))) 255)))
(define byte-set! (subr hp (i64 i64 i64) unit)
  (lambda (b i x)
    (let* ((at (i64+ (address b) (i64+ 1 (i64-quotient i 8))))
           (sh (i64->int (i64* 8 (i64-remainder i 8)))))
      (mem-set! at (i64-or (i64-and (mem-at at) (i64-not (i64-shl 255 sh))) (i64-shl (i64-and x 255) sh))))))

"A bloblet's suffix's byte (C326): its bytes from the suffix's start."
(define suffix-byte (subr (maxeff (read @globals) spin (read @c)) (i64 i64) i64)
  (lambda (b i)
    (i64-and (i64-shr (mem-at (i64+ (address b) (i64-quotient i 8))) (i64->int (i64* 8 (i64-remainder i 8)))) 255)))
(define suffix-byte-set! (subr hp (i64 i64 i64) unit)
  (lambda (b i x)
    (let* ((at (i64+ (address b) (i64-quotient i 8)))
           (sh (i64->int (i64* 8 (i64-remainder i 8)))))
      (mem-set! at (i64-or (i64-and (mem-at at) (i64-not (i64-shl 255 sh))) (i64-shl (i64-and x 255) sh))))))

"A string's or a bytevector's element, by its kind: for what both share."
(define raw-ref (subr (maxeff (read @globals) spin (read @c)) (i64 i64) i64)
  (lambda (v i) (if (is-obj? v ob-string) (char-at v i) (byte-at v i))))
(define raw-set! (subr hp (i64 i64 i64) unit)
  (lambda (v i x) (if (is-obj? v ob-string) (char-set! v i x) (byte-set! v i x))))

(define-rec
  (chars-set! (subr hp (i64 (listof char acyclic) i64) unit)
    (lambda (p cs i) (if (null? cs) #u (begin (char-set! p i (char->i64 (car cs))) (chars-set! p (cdr cs) (i64+ i 1)))))))

(define string-word! (subr hp (string) i64)
  (lambda (s)
    "A KFX string made a heap string (room for its length and a header
     made sure of): for loading and I/O."
    (let* ((cs (the (listof char acyclic) (string->list s)))
           (p (string-alloc! (size cs))))
      (begin (chars-set! p cs 0) p))))

(define-rec
  (string-chars-from (subr (maxeff (read @globals) spin (read @c)) (i64 i64 (listof char acyclic)) (listof char acyclic))
    (lambda (p i acc) (if (i64< i 0) acc (string-chars-from p (i64- i 1) (cons (i64->char (char-at p i)) acc))))))

(define word-string (subr (maxeff (read @globals) spin (read @c)) (i64) string)
  (lambda (p) "A heap string as a KFX string: for I/O." (list->string (string-chars-from p (i64- (raw-length p) 1) nil))))

"Symbols and keywords (C321): Fixpt's objects, interned, one a name."
(define-rec
  (objects-copied! (subr (maxeff (read @globals) spin (read @c) (write @c)) ((flatarrayof i64 @c) (flatarrayof i64 @c) i64 i64) unit)
    (lambda (from to i n) (if (i64>= i n) #u (begin (flatarray-set-i64! to i (flatarray-ref-i64 from i)) (objects-copied! from to (i64+ i 1) n))))))

(define room-for-name! (subr (maxeff hp (alloc @c)) ((flatarrayof i64 @c) i64) (flatarrayof i64 @c))
  (lambda (t n)
    "Table `t`, or a larger copy, with a place for name `n`."
    (if (i64< n (flatarray-length-i64 t))
        t
        (let ((bigger (the (flatarrayof i64 @c) (make-flatarray-i64 (i64* (i64+ n 1) 2) 0))))
          (begin (objects-copied! t bigger 0 (flatarray-length-i64 t)) bigger)))))

(define symbol-word (subr (maxeff hp (alloc @c)) (i64) i64)
  (lambda (n)
    "Name `n`'s symbol, tier 1's (`symbol!`, C332: one table of them in
     the one heap), found the first time: its name, its hash, and in its
     global slot, which tier 1 leaves 0, its name's number here, plus 1."
    (begin
      (set symbol-objects (room-for-name! (get symbol-objects) n))
      (let ((had (flatarray-ref-i64 (get symbol-objects) n)))
        (if (not (i64= had 0))
            had
            (let ((sym (symbol! (name-of-number n))))
              (begin
                (elt-set! sym 2 (fixnum (i64+ n 1)))
                (flatarray-set-i64! (get symbol-objects) n sym)
                sym)))))))

(define symbol-number (subr (maxeff (read @globals) spin (read @c)) (i64) i64)
  (lambda (w)
    "A symbol's name's number: what its global slot holds, less 1; one tier
     1 made (`symbol!`, a stage's failure's tag, C336), its slot 0, by its
     name, -1 if the engine has none of it."
    (let ((k (fixnum-value (obj-ref w 2))))
      (if (i64> k 0) (i64- k 1) (name-at (symbol-text w) 0 (get name-count))))))

(define keyword-word (subr (maxeff hp (alloc @c)) (i64) i64)
  (lambda (n)
    "Name `n`'s keyword, made the first time: its symbol (Fixpt's
     `make_keyword`)."
    (begin
      (set keyword-objects (room-for-name! (get keyword-objects) n))
      (let ((had (flatarray-ref-i64 (get keyword-objects) n)))
        (if (not (i64= had 0))
            had
            (let* ((sym (symbol-word n)) (k (alloc! ob-keyword 1)))
              (begin (obj-set! k 0 sym) (flatarray-set-i64! (get keyword-objects) n k) k)))))))
(define keyword-word? (subr (maxeff (read @globals) spin (read @c)) (i64) bool)
  (lambda (w) (is-obj? w ob-keyword)))

"Sums (C322): Fixpt's (`make_frozen`), frozen, its tag (a symbol) slot 0,
 its value slot 1."
(define sum-made! (subr (maxeff hp (alloc @c)) (i64 i64) i64)
  (lambda (tag w)
    (let ((x (alloc! ob-sum 2))) (begin (bloblet-value-set! x 0 tag) (bloblet-value-set! x 1 w) (frozen-whole! x) x))))
(define sum-tag-number (subr (maxeff (read @globals) spin (read @c)) (i64) i64)
  (lambda (s) (symbol-number (bloblet-value s 0))))
(define sum-value (subr (maxeff (read @globals) spin (read @c)) (i64) i64)
  (lambda (s) (bloblet-value s 1)))

"Products (C323): Fixpt's, its fields in slots 0 on, in its type's order,
 no labels, frozen once filled (`frozen!`)."
(define product-made! (subr (maxeff hp (alloc @c)) (i64) i64)
  (lambda (n) (alloc! ob-product n)))
(define-rec
  (product-filled! (subr hp (i64 i64 (listof i64 acyclic)) unit)
    (lambda (p i ws) (if (null? ws) #u (begin (bloblet-value-set! p i (car ws)) (product-filled! p (i64+ i 1) (cdr ws)))))))
(define product-of! (subr (maxeff hp (alloc @c)) ((listof i64 acyclic)) i64)
  (lambda (ws)
    "A product of `ws`, frozen."
    (let ((p (product-made! (size ws))))
      (begin (product-filled! p 0 ws) (frozen-whole! p) p))))

"Reals: tier 1's flonums (`make-flonum!`, `flonum-of`; C333)."

"Lists of words, counted, and made arrays: loading makes a quoted
 vector so (C80), and the primitives (vwords.kfx)."
(define-rec
  (list-count (subr (maxeff (read @globals) spin (read @c)) (i64 i64) i64)
    (lambda (xs n) (if (i64= xs w-nil) n (list-count (pair-cdr xs) (i64+ n 1))))))

(define-rec
  (proper-count (subr (maxeff (read @globals) spin (read @c)) (i64 i64 i64) i64)
    (lambda (slow fast n)
      "How many elements the list at `fast` has (`n` so far), `slow` half
       as far along: -1 if it ends in no `()` or meets itself, a cycle."
      (cond ((i64= fast w-nil) n)
            ((not (is-obj? fast ob-pair)) -1)
            ((i64= (pair-cdr fast) w-nil) (i64+ n 1))
            ((not (is-obj? (pair-cdr fast) ob-pair)) -1)
            ((and (i64> n 0) (i64= (pair-cdr slow) (pair-cdr (pair-cdr fast)))) -1)
            (else (proper-count (pair-cdr slow) (pair-cdr (pair-cdr fast)) (i64+ n 2)))))))

(define-rec
  (from-list! (subr hp (i64 i64 i64) unit)
    (lambda (p i xs) (if (i64= xs w-nil) #u (begin (obj-set! p i (pair-car xs)) (from-list! p (i64+ i 1) (pair-cdr xs)))))))

(define list-array! (subr hp (i64 i64) i64)
  (lambda (kind xs) (let ((p (alloc! kind (list-count xs 0)))) (begin (from-list! p 0 xs) p))))

