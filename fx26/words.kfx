"words.kfx: the engine's values as words and heap objects (C64): making
 them, taking them apart, and the conversions to and from KFX's `int`,
 strings and `f64`, which allocate KFX data and so are for loading, I/O
 and bignums alone, never a step's work."

(define-effect hp (maxeff (read @globals) spin (read @h) (write @h)))

(define-effect vm (maxeff (read @globals) spin (read @h) (write @h) (alloc @h)
                          (io stdin) (io stdout) (io stderr) (io clock) (io fs-read) (io fs-write) (io args) (io exit) (io sys) (io terminal) (io process)
                          ;; A stage's check, a worker's (C305).
                          (alloc @q) (alloc @w) (init @q) (await @q) (send @q) nondet))


"Integers: a fixnum if it fits, else a bignum, its sign and 32-bit limbs,
 the low first. Taken apart and put together by halves, so that a step on
 a bignum of n limbs costs some n log n, and not n squared: a step is how
 long the REPL's keys may wait (live-repl.kfx, C99)."
(define-rec
  (below-limbs? (subr kfx (int i64) bool)
    (lambda (n k) "Whether `n`, at least 0, has at most `k` limbs." (zero? (arithmetic-shift n (i64->int (i64- 0 (i64* k 32)))))))
  (limbs-within (subr kfx (int i64 i64) i64)
    (lambda (n lo hi)
      "The limbs of `n`, between `lo` (too few) and `hi` (enough)."
      (if (i64<= (i64- hi lo) 1)
          hi
          (let ((mid (i64+ lo (i64-quotient (i64- hi lo) 2))))
            (if (below-limbs? n mid) (limbs-within n lo mid) (limbs-within n mid hi))))))
  (limbs-above (subr kfx (int i64) i64)
    (lambda (n k) (if (below-limbs? n k) (limbs-within n (i64-quotient k 2) k) (limbs-above n (i64* k 2))))))

(define limbs-count (subr kfx (int i64) i64)
  (lambda (n k) "`k` and the limbs of `n`, at least 0." (i64+ k (if (zero? n) 0 (limbs-above n 1)))))

(define-rec
  (limbs-set! (subr hp (i64 int i64 i64) unit)
    (lambda (p n i k)
      "`n`'s `k` limbs, from object `p`'s word `i` on."
      (cond ((i64< k 1) #u)
            ((i64= k 1) (obj-set! p i (int->i64 n)))
            (else
             (let* ((h (i64-quotient k 2))
                    (bits (i64->int (i64* h 32))))
               (begin
                 (limbs-set! p (bitwise-and n (- (arithmetic-shift 1 bits) 1)) i h)
                 (limbs-set! p (arithmetic-shift n (- 0 bits)) (i64+ i h) (i64- k h)))))))))

(define big-words (subr kfx (int) i64)
  (lambda (n) "How many words a bignum of `n` needs." (i64+ 2 (limbs-count (if (< n 0) (- 0 n) n) 0))))

(define int-word! (subr hp (int) i64)
  (lambda (n)
    "`n` as a word: a fixnum, or a bignum made (room for `big-words` made
     sure of before)."
    (let ((x (int->i64 n)))
      (if (and (= (i64->int x) n) (fits-fixnum? x))
          (fixnum x)
          (let* ((mag (if (< n 0) (- 0 n) n))
                 (k (limbs-count mag 0))
                 (p (alloc! ob-big (i64+ k 1))))
            (begin (obj-set! p 0 (if (< n 0) (the i64 1) (the i64 0))) (limbs-set! p mag 1 k) p))))))

(define-rec
  (limbs-value (subr hp (i64 i64 i64) int)
    (lambda (p i k)
      "The integer of object `p`'s `k` limbs from word `i` on."
      (cond ((i64< k 1) 0)
            ((i64= k 1) (i64->int (obj-ref p i)))
            (else
             (let ((h (i64-quotient k 2)))
               (+ (limbs-value p i h) (arithmetic-shift (limbs-value p (i64+ i h) (i64- k h)) (i64->int (i64* h 32))))))))))

(define word-int (subr hp (i64) int)
  (lambda (w)
    "A word's integer: a fixnum's, or a bignum's."
    (if (fixnum? w)
        (i64->int (fixnum-value w))
        (let ((mag (limbs-value w 1 (i64- (obj-size w) 1))))
          (if (i64= (obj-ref w 0) 1) (- 0 mag) mag)))))

(define word-i64 (subr hp (i64) i64)
  (lambda (w) "An `i64`'s value: a fixnum's, or the low 64 bits of a bignum's." (if (fixnum? w) (fixnum-value w) (int->i64 (word-int w)))))

(define i64-room (subr kfx (i64) i64)
  (lambda (n) "The room an `i64` result may need: a bignum's, if it is no fixnum." (if (fits-fixnum? n) (the i64 0) (the i64 4))))

(define i64-word! (subr hp (i64) i64)
  (lambda (n) (if (fits-fixnum? n) (fixnum n) (int-word! (i64->int n)))))

"Characters, booleans, symbols."
(define char-word (subr kfx (char) i64) (lambda (c) (immediate imm-char (char->i64 c))))
(define word-char (subr kfx (i64) char) (lambda (w) (i64->char (immediate-value w))))
(define bool-word (subr kfx (bool) i64) (lambda (b) (if b w-true w-false)))
(define truthy? (subr kfx (i64) bool) (lambda (w) (not (i64= w w-false))))

(define is-imm? (subr kfx (i64 i64) bool) (lambda (w kind) (and (immediate? w) (i64= (immediate-kind w) kind))))

"`f32`s (C220): Fixpt's immediate of subtag 9, its bits the payload (C318)."
(define f32-word (subr kfx (f32) i64)
  (lambda (x) (imm-word sub-f32 (int->i64 (u32->int (f32->bits x))))))
(define f32-word? (subr kfx (i64) bool)
  (lambda (w) (and (immediate? w) (i64= (immediate-sub w) sub-f32))))
(define word-f32 (subr kfx (i64) f32)
  (lambda (w) (bits->f32 (int->u32 (i64->int (immediate-value w))))))

"Objects of a kind."
(define is-obj? (subr (maxeff (read @globals) spin (read @h)) (i64 i64) bool)
  (lambda (w kind)
    "A pair by its tag; any other object by its header (C318)."
    (if (i64= kind ob-pair)
        (pair-tagged? w)
        (and (i64= (i64-and w 7) 4) (i64= (header-kind (at-word (header-at w))) kind)))))

"Pairs: their car and cdr, written in place."
(define pair! (subr hp (i64 i64) i64)
  (lambda (a d) (let ((i (bump! 2))) (begin (put! i a) (put! (i64+ i 1) d) (pair-at i)))))
(define pair-car (subr (maxeff (read @globals) spin (read @h)) (i64) i64) (lambda (p) (at-word (pointer-index p))))
(define pair-cdr (subr (maxeff (read @globals) spin (read @h)) (i64) i64) (lambda (p) (at-word (i64+ (pointer-index p) 1))))

"Strings and bytevectors, Fixpt's (`heap.rs`, as tier 1 has them; C320):
 a bloblet of no fields, its suffix a word of the length, then the code
 points two to a word, or the bytes eight to a word, the first in the
 low bits."
(define-rec
  (zeroed! (subr hp (i64 i64) unit)
    (lambda (i n) (if (i64< n 1) #u (begin (put! i 0) (zeroed! (i64+ i 1) (i64- n 1)))))))

(define raw-made! (subr hp (i64 i64 i64) i64)
  (lambda (kind words n)
    (let ((p (alloc! kind words)))
      (begin (put! (pointer-index p) n) (zeroed! (i64+ (pointer-index p) 1) (i64- words 1)) p))))

(define string-alloc! (subr hp (i64) i64)
  (lambda (n) (raw-made! ob-string (i64+ 1 (i64-quotient (i64+ n 1) 2)) n)))
(define bytes-alloc! (subr hp (i64) i64)
  (lambda (n) (raw-made! ob-bytes (i64+ 1 (i64-quotient (i64+ n 7) 8)) n)))

(define raw-length (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (v) (at-word (pointer-index v))))
(define string-length-w (subr (maxeff (read @globals) spin (read @h)) (i64) i64) (lambda (s) (raw-length s)))

(define char-at (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
  (lambda (s i)
    (let ((w (at-word (i64+ (pointer-index s) (i64+ 1 (i64-quotient i 2))))))
      (if (i64= (i64-remainder i 2) 0) (i64-and w 4294967295) (i64-and (i64-shr w 32) 4294967295)))))
(define char-set! (subr hp (i64 i64 i64) unit)
  (lambda (s i cp)
    (let* ((at (i64+ (pointer-index s) (i64+ 1 (i64-quotient i 2)))) (w (at-word at)))
      (put! at (if (i64= (i64-remainder i 2) 0)
                   (i64-or (i64-and w -4294967296) cp)
                   (i64-or (i64-and w 4294967295) (i64-shl cp 32)))))))

(define byte-at (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
  (lambda (b i)
    (i64-and (i64-shr (at-word (i64+ (pointer-index b) (i64+ 1 (i64-quotient i 8)))) (i64->int (i64* 8 (i64-remainder i 8)))) 255)))
(define byte-set! (subr hp (i64 i64 i64) unit)
  (lambda (b i x)
    (let* ((at (i64+ (pointer-index b) (i64+ 1 (i64-quotient i 8))))
           (sh (i64->int (i64* 8 (i64-remainder i 8)))))
      (put! at (i64-or (i64-and (at-word at) (i64-not (i64-shl 255 sh))) (i64-shl (i64-and x 255) sh))))))

"A string's or a bytevector's element, by its kind: for what both share."
(define raw-ref (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
  (lambda (v i) (if (is-obj? v ob-string) (char-at v i) (byte-at v i))))
(define raw-set! (subr hp (i64 i64 i64) unit)
  (lambda (v i x) (if (is-obj? v ob-string) (char-set! v i x) (byte-set! v i x))))

(define-rec
  (chars-set! (subr hp (i64 (listof char acyclic) i64) unit)
    (lambda (p cs i) (if (null? cs) #u (begin (char-set! p i (char->i64 (car cs))) (chars-set! p (cdr cs) (i64+ i 1)))))))

(define string-word! (subr hp (string) i64)
  (lambda (s)
    "A KFX string made a heap string (room for its length and a header
     made sure of): for loading and I/O."
    (let* ((cs (the (listof char acyclic) (string->list s)))
           (p (string-alloc! (size cs))))
      (begin (chars-set! p cs 0) p))))

(define-rec
  (string-chars-from (subr (maxeff (read @globals) spin (read @h)) (i64 i64 (listof char acyclic)) (listof char acyclic))
    (lambda (p i acc) (if (i64< i 0) acc (string-chars-from p (i64- i 1) (cons (i64->char (char-at p i)) acc))))))

(define word-string (subr (maxeff (read @globals) spin (read @h)) (i64) string)
  (lambda (p) "A heap string as a KFX string: for I/O." (list->string (string-chars-from p (i64- (raw-length p) 1) nil))))

"Symbols and keywords (C321): Fixpt's objects, interned, one a name."
(define-rec
  (objects-copied! (subr (maxeff (read @globals) spin (read @h) (write @h)) ((flatarrayof i64 @h) (flatarrayof i64 @h) i64 i64) unit)
    (lambda (from to i n) (if (i64>= i n) #u (begin (flatarray-set-i64! to i (flatarray-ref-i64 from i)) (objects-copied! from to (i64+ i 1) n))))))

(define room-for-name! (subr (maxeff hp (alloc @h)) ((flatarrayof i64 @h) i64) (flatarrayof i64 @h))
  (lambda (t n)
    "Table `t`, or a larger copy, with a place for name `n`."
    (if (i64< n (flatarray-length-i64 t))
        t
        (let ((bigger (the (flatarrayof i64 @h) (make-flatarray-i64 (i64* (i64+ n 1) 2) 0))))
          (begin (objects-copied! t bigger 0 (flatarray-length-i64 t)) bigger)))))

(define symbol-word (subr (maxeff hp (alloc @h)) (i64) i64)
  (lambda (n)
    "Name `n`'s symbol, made the first time: its name, its hash, and its
     name's number."
    (begin
      (set symbol-objects (room-for-name! (get symbol-objects) n))
      (let ((had (flatarray-ref-i64 (get symbol-objects) n)))
        (if (not (i64= had 0))
            had
            (let* ((name (name-of-number n))
                   (s (string-word! name))
                   (sym (alloc! ob-symbol 3)))
              (begin
                (obj-set! sym 0 s)
                (obj-set! sym 1 (fixnum (int->i64 (symbol-name-hash (string->symbol name)))))
                (obj-set! sym 2 (fixnum n))
                (flatarray-set-i64! (get symbol-objects) n sym)
                sym)))))))

(define symbol-number (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (w) (fixnum-value (obj-ref w 2))))
(define symbol-text (subr (maxeff (read @globals) spin (read @h)) (i64) string)
  (lambda (w) (word-string (obj-ref w 0))))

(define keyword-word (subr (maxeff hp (alloc @h)) (i64) i64)
  (lambda (n)
    "Name `n`'s keyword, made the first time: its symbol (Fixpt's
     `make_keyword`)."
    (begin
      (set keyword-objects (room-for-name! (get keyword-objects) n))
      (let ((had (flatarray-ref-i64 (get keyword-objects) n)))
        (if (not (i64= had 0))
            had
            (let* ((sym (symbol-word n)) (k (alloc! ob-keyword 1)))
              (begin (obj-set! k 0 sym) (flatarray-set-i64! (get keyword-objects) n k) k)))))))
(define keyword-word? (subr (maxeff (read @globals) spin (read @h)) (i64) bool)
  (lambda (w) (is-obj? w ob-keyword)))

"Sums (C322): Fixpt's (`make_frozen`), frozen, its tag (a symbol) slot 0,
 its value slot 1."
(define sum-made! (subr (maxeff hp (alloc @h)) (i64 i64) i64)
  (lambda (tag w)
    (let ((x (alloc! ob-sum 2))) (begin (slot-set! x 0 tag) (slot-set! x 1 w) (frozen! x) x))))
(define sum-tag-number (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (s) (symbol-number (slot-ref s 0))))
(define sum-value (subr (maxeff (read @globals) spin (read @h)) (i64) i64)
  (lambda (s) (slot-ref s 1)))

"Reals: an `f64`'s bits."
(define real-word! (subr hp (f64) i64)
  (lambda (x) (let ((p (alloc! ob-real 1))) (begin (obj-set! p 0 (int->i64 (u64->int (f64->bits x)))) p))))
(define word-real (subr (maxeff (read @globals) spin (read @h)) (i64) f64)
  (lambda (p) (bits->f64 (int->u64 (i64->int (obj-ref p 0))))))

"Lists of words, counted, and made arrays: loading makes a quoted
 vector so (C80), and the primitives (vwords.kfx)."
(define-rec
  (list-count (subr (maxeff (read @globals) spin (read @h)) (i64 i64) i64)
    (lambda (xs n) (if (i64= xs w-nil) n (list-count (pair-cdr xs) (i64+ n 1))))))

(define-rec
  (proper-count (subr (maxeff (read @globals) spin (read @h)) (i64 i64 i64) i64)
    (lambda (slow fast n)
      "How many elements the list at `fast` has (`n` so far), `slow` half
       as far along: -1 if it ends in no `()` or meets itself, a cycle."
      (cond ((i64= fast w-nil) n)
            ((not (is-obj? fast ob-pair)) -1)
            ((i64= (pair-cdr fast) w-nil) (i64+ n 1))
            ((not (is-obj? (pair-cdr fast) ob-pair)) -1)
            ((and (i64> n 0) (i64= (pair-cdr slow) (pair-cdr (pair-cdr fast)))) -1)
            (else (proper-count (pair-cdr slow) (pair-cdr (pair-cdr fast)) (i64+ n 2)))))))

(define-rec
  (from-list! (subr hp (i64 i64 i64) unit)
    (lambda (p i xs) (if (i64= xs w-nil) #u (begin (obj-set! p i (pair-car xs)) (from-list! p (i64+ i 1) (pair-cdr xs)))))))

(define list-array! (subr hp (i64 i64) i64)
  (lambda (kind xs) (let ((p (alloc! kind (list-count xs 0)))) (begin (from-list! p 0 xs) p))))

