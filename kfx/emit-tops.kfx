"emit-tops.kfx: writing a program's top-level forms as Rust (emit.kfx):
 definitions, modules and their traits, shapes, and `kfx --toplevel`'s
 values. Split from emit.kfx."

(define-datatype mparts (mparts ctx sexps))

"A top-level procedure probed for being a leaf (C377): its name and the
 names of the program's procedures it calls."
(define-datatype calling (calling string strings))
(define-type callings (listof calling acyclic))

"A depth-first search's state (C379): the names seen, and those finished,
 latest first."
(define-datatype visited (visited strings strings))

"Writing the top level is a module (C92): the emitter included, hidden;
 its helpers hidden too."
(define writing
  (module
    (hide
      (include emitter)

      "Top-level forms"

      "Modules as parameters (C24): a module type, a trait; its abstract types,
       associated types; its values, functions of no receiver. A module defined at
       the top level that is given for one is a marker type, `m::Module`, which
       implements the trait by calling the module's items."

      (define-rec
        (subst-descs (subr kfx (sexp (listof sexps acyclic)) sexp)
          (lambda (e descs)
            "A type written in a module type, its descriptions' names replaced by
             what they describe."
            (tagcase e
              (sym (n at-file at-pos)
                (let ((found (concat (map (lambda ((d sexps)) (if (string=? (sym-name (second d)) n) (the sexps (list (third d))) nil)) descs))))
                  (if (null? found) e (car found))))
              (lst (xs f l p) (lst (map (lambda ((x sexp)) (subst-descs x descs)) xs) f l p))
              (else other e)))))

      (define spec-of (subr kfx (sexp string) (listof sexps acyclic))
        (lambda (spec kind)
          (concat (map (lambda ((x sexp)) (if (head-is? x kind) (the (listof sexps acyclic) (list (items x))) nil)) (cdr (items spec))))))

      (define abs-of (subr kfx (sexp) strings)
        (lambda (spec)
          (concat (map (lambda ((a sexps)) (tagcase (second a) (sym (n at-file at-pos) (the strings (list n))) (lst (ns f l p) (map sym-name ns)) (else other nil)))
                       (spec-of spec "abs")))))

      (define in-trait (subr kfx (ctx sexp) ctx)
        (lambda (c spec)
          "`c` where a module type's abstract types are `Self`'s."
          (with-locals c (cons "%with Self" (map (lambda ((t string)) (string-append "%type " t)) (abs-of spec))))))

      (define-rec
        (put-arg-params (subr kfx (ctx sexps i64 chars) chars)
          (lambda (c ts i acc)
            (if (null? ts)
                acc
                (put-arg-params c (cdr ts) (i64+ i 1)
                                (put-type c (car ts) (put ": " (put (i64->string i) (put (if (i64= i 0) "a__" ", a__") acc)))))))))

      (define put-generics (subr kfx (sexps bool chars) chars)
        (lambda (binders first acc)
          "A poly's binders as a fn's generics: a type is a Rust type parameter,
           `Copy` and `'static` as every KFX value is; an effect is erased, and so,
           until places come (TODO.md section 14), is a region, every one's place
           being the heap."
          (if (null? binders)
              (if first acc (put ">" acc))
              (let* ((b (items (car binders)))
                     (kind (sym-name (second b))))
                (cond ((string=? kind "type")
                       (let* ((acc (put (if first "<" ", ") acc))
                              (acc (put (camel (sym-name (car b))) acc)))
                         (put-generics (cdr binders) #f (put ": Copy + 'static + kayak_rt::Trace" acc))))
                      ((or (string=? kind "effect") (string=? kind "region")) (put-generics (cdr binders) first acc))
                      (else (error (string-append "kfx: KFX-0 has no poly over a " kind))))))))

      (define put-val-sig (subr kfx (ctx sexps (listof sexps acyclic) chars) chars)
        (lambda (c0 val descs acc)
          "`fn x(a0: P0, ...) -> R`, a module type's value `(val x T)`; of a
           `poly`, generic as a top-level procedure is (C119); a procedure's an
           `async fn` in the async mode (C375), as every procedure is, its
           module parameters being types, never `dyn`."
          (let* ((t0 (subst-descs (third val) descs))
                 (binders (if (head-is? t0 "poly") (items (second (items t0))) nil))
                 (c (with-locals c0 (concat (map (lambda ((b sexp))
                                                   (cond ((sym-is? (second (items b)) "type") (the strings (list (string-append "%tvar " (sym-name (car (items b)))))))
                                                         ((sym-is? (second (items b)) "effect") (the strings (list (string-append "%evar " (sym-name (car (items b)))))))
                                                         (else nil)))
                                                 binders))))
                 (t (if (head-is? t0 "poly") (third (items t0)) t0))
                 (acc (put-generics binders #t (put (mangle (sym-name (second val)))
                                                    (put (if (and (in-async-mode? c) (head-is? t "subr")) "async fn " "fn ") acc)))))
            (if (head-is? t "subr")
                (let ((acc (put ") -> " (put-arg-params c (items (third (items t))) 0 (put "(" acc)))))
                  (if (fallible-effect? c (second (items t)))
                      (put ", Unwind>" (put-type c (fourth (items t)) (put "Result<" acc)))
                      (put-type c (fourth (items t)) acc)))
                (put-type c t (put "() -> " acc))))))

      (define put-trait (subr kfx (ctx string sexp chars) chars)
        (lambda (c name spec acc)
          (let* ((inner (in-trait c spec))
                 (descs (spec-of spec "desc"))
                 (acc (put " {\n" (put (camel name) (put "pub trait " acc))))
                 (acc (put-sep (lambda ((t string) (acc chars)) (put ": Copy + 'static + kayak_rt::Trace;\n" (put (camel t) (put "    type " acc)))) "" (abs-of spec) acc))
                 (acc (put-sep (lambda ((v sexps) (acc chars)) (put ";\n" (put-val-sig inner v descs (put "    " acc)))) "" (spec-of spec "val") acc)))
            (put "}\n\n" acc))))

      (define module-impls (subr kfx (ctx) strings)
        (lambda (c)
          "Each module given for a module type, `m x`, once."
          (tagcase c
            (ctx (ds ts ks ls xs fs fx ms es mods)
              (reverse-strings
               (concat (map (lambda ((f fact))
                              (tagcase f (fact (ff fp fw) (if (has-prefix? fw "module-impl ") (the strings (list (after-prefix fw "module-impl "))) nil))))
                            fs))
               nil)))))

      (define-rec
        (deduped (subr kfx (strings strings) strings)
          (lambda (xs seen)
            (cond ((null? xs) (reverse-strings seen nil))
                  ((string-member? (car xs) seen) (deduped (cdr xs) seen))
                  (else (deduped (cdr xs) (cons (car xs) seen)))))))

      (define put-impl (subr kfx (ctx string string chars) chars)
        (lambda (c m x acc)
          (let* ((spec (car (module-body c (string-append "%moduleof " x))))
                 (inner (in-trait c spec))
                 (descs (spec-of spec "desc"))
                 (consts (item-constants (module-items c m)))
                 (acc (put " {\n" (put "::Module" (put (mangle m) (put " for " (put (camel x) (put "impl " acc)))))))
                 (acc (put-sep (lambda ((t string) (acc chars)) (put ";\n" (put (type-path c m t) (put " = " (put (camel t) (put "    type " acc))))))
                               "" (abs-of spec) acc))
                 (acc (put-sep (lambda ((v sexps) (acc chars))
                                 (let* ((t1 (subst-descs (third v) descs))
                                        (t (if (head-is? t1 "poly") (third (items t1)) t1))
                                        (name (sym-name (second v)))
                                        (acc (put " {\n        " (put-val-sig inner v descs (put "    " acc))))
                                        (acc (put (mangle name) (put "::" (put (mangle m) acc))))
                                        (acc (if (string-member? name consts) (put "()" acc) acc))
                                        (acc (if (head-is? t "subr")
                                                 (put (if (in-async-mode? c) ").await" ")") (put-arg-names 0 (size (items (third (items t)))) (put "(" acc)))
                                                 acc)))
                                   (put "\n    }\n" acc)))
                               "" (spec-of spec "val") acc)))
            (put "}\n\n" acc))))

      (define module-params (subr kfx (ctx sexps sexps) strings)
        (lambda (c names types)
          "The parameters of a module type, each `m x`."
          (if (or (null? names) (null? types))
              nil
              (let ((rest (module-params c (cdr names) (cdr types))))
                (tagcase (car types)
                  (sym (t at-file at-pos) (if (null? (module-body c (string-append "%moduleof " t)))
                               rest
                               (cons (string-append (sym-name (tagcase (car names) (lst (xs f l p) (car xs)) (else other other)))
                                                    (string-append " " t))
                                     rest)))
                  (else other rest))))))

      (define-rec
        (unmoduled (subr kfx (ctx sexps sexps bool) sexps)
          (lambda (c names types want-names)
            "`names` or `types`, without the module parameters."
            (cond ((or (null? names) (null? types)) nil)
                  ((tagcase (car types) (sym (t at-file at-pos) (not (null? (module-body c (string-append "%moduleof " t))))) (else other #f))
                   (unmoduled c (cdr names) (cdr types) want-names))
                  (else (cons (if want-names (car names) (car types)) (unmoduled c (cdr names) (cdr types) want-names)))))))

      (define put-params (subr kfx (ctx sexps sexps bool chars) chars)
        (lambda (c names types mutable acc)
          "Parameters, from a lambda's names and its `subr` type's; `mut` if
           `mutable`, for a procedure that loops."
          (if (null? names)
              acc
              (let* ((name (tagcase (car names) (lst (xs src-file src-line src-pos) (car xs)) (else other other)))
                     (acc (if mutable (put "mut " acc) acc))
                     (acc (put (mangle (sym-name name)) acc))
                     (acc (put ": " acc))
                     (acc (put-type c (car types) acc)))
                (put-params c (cdr names) (cdr types) mutable
                            (if (null? (cdr names)) acc (put ", " acc)))))))

      (define unpoly (subr kfx (sexp) sexp)
        (lambda (e)
          "A poly type's body, or a plambda's: what is under the binders."
          (if (or (head-is? e "poly") (head-is? e "plambda")) (third (items e)) e)))

      (define put-place-generics (subr kfx (ctx string sexps strings strings chars) chars)
        (lambda (c name binders lives places acc)
          "A procedure given places' generics (C34): each place a lifetime, `'p`,
           and a type, `Place_P`, bound to hold what the procedure makes there,
           by itself or by those it gives the place to; the types `Copy`."
          (let* ((maker (concat (map (lambda ((k string)) (if (has-prefix? k "%maker-needs ") (the strings (list (after-prefix k "%maker-needs "))) nil)) (ctx-locals c))))
                 ;; A module maker's item, bound as the maker is (C274).
                 (name (if (null? maker) name (car maker)))
                 (needs (all-facts-prefixed c (string-append "place-needs " (string-append name " "))))
                 (types (concat (map (lambda ((b sexp)) (if (sym-is? (second (items b)) "type") (the strings (list (camel (sym-name (car (items b)))))) nil)) binders)))
                 (bounds (lambda ((p string))
                           (distinct-strings
                             (concat (map (lambda ((n string))
                                            (let ((ws (read-all n "" 1)))
                                              (if (and (string=? (sym-name (car ws)) (string-append "'" p))
                                                       ;; A datatype's value only where it has lived regions (C270).
                                                       (or (not (sym-is? (second ws) "data"))
                                                           (tagcase (third ws) (lst (ys f l q) (not (null? (module-body c (string-append "%lived " (sym-name (car ys))))))) (else other #f))))
                                                  (the strings (list (string-append "Holds<" (string-append (held-rust c (sym-name (second ws)) (lifetime p) (third ws)) ">"))))
                                                  nil)))
                                          needs)))))
                 (params (onto (map (lambda ((p string)) (lifetime p)) (onto lives places))
                               (onto (map (lambda ((t string)) (string-append t ": Copy + 'static + kayak_rt::Trace")) types)
                                     (map (lambda ((p string))
                                            (let ((bs (bounds p)))
                                              ;; Traced (C492): a closure or a module's state may hold it.
                                              (string-append "Place_" (string-append (camel p) (string-append ": " (words-of-sep (cons "kayak_rt::Visit" bs) " + "))))))
                                          places)))))
            (put (string-append "<" (string-append (words-of-sep params ", ") ">")) acc))))

      (define free-regions (subr kfx (sexps) strings)
        (lambda (binders)
          "A poly's region binders not within a place, `(r region)` or `(r region
           distinct)`: each a lifetime of the procedure, `'r` (C42)."
          (concat (map (lambda ((b sexp))
                         (let ((bs (items b)))
                           (if (and (sym-is? (second bs) "region") (or (i64= (size bs) 2) (sym-is? (third bs) "distinct")))
                               (the strings (list (sym-name (car bs))))
                               nil)))
                       binders))))

      (define-rec
        (mentions-suspension? (subr kfx (ctx sexp) bool)
          (lambda (c t)
            "Whether a type is, or holds, a procedure that may suspend: one whose
             future, `'static`, can hold no lifetime's data (C46)."
            (tagcase (without-conv (family-expanded c t))
              (lst (xs f l p)
                (cond ((null? xs) #f)
                      ((and (sym-is? (car xs) "subr") (comefrom-effect? c (second xs))) #t)
                      ((sym-is? (car xs) "subr")
                       (or (any? (lambda ((x sexp)) (mentions-suspension? c x)) (items (third xs)))
                           (mentions-suspension? c (fourth xs))))
                      (else (any? (lambda ((x sexp)) (mentions-suspension? c x)) (cdr xs)))))
              (sym (n f p)
                (let ((found (module-body c (string-append "%abbreviation " n))))
                  (if (null? found) #f (mentions-suspension? c (second (items (car found)))))))
              (else other #f)))))

      (define may-suspend? (subr kfx (ctx sexps sexp) bool)
        (lambda (c binders typ)
          "Whether a definition is of a procedure that may suspend, or that takes
           or gives one: its effect says so, or names one of its effect binders,
           or its type holds such a procedure. Its regions then have no
           lifetimes (C46): its future is `'static`, as a capture's must be, and
           it touches no `letrena`'s data, since none may be suspended in (C45)."
          (let ((t (if (head-is? typ "poly") (third (items typ)) typ))
                (c (with-locals c (concat (map (lambda ((b sexp))
                                                 (if (sym-is? (second (items b)) "effect")
                                                     (the strings (list (string-append "%evar " (sym-name (car (items b))))))
                                                     nil))
                                               binders)))))
            (mentions-suspension? c t))))

      (define put-lifetime-generics (subr kfx (strings sexps chars) chars)
        (lambda (lives binders acc)
          "A procedure's generics: its regions' lifetimes, then its types'."
          (let ((types (concat (map (lambda ((b sexp)) (if (sym-is? (second (items b)) "type") (the strings (list (string-append (camel (sym-name (car (items b)))) ": Copy + 'static + kayak_rt::Trace"))) nil)) binders))))
            (put (string-append "<" (string-append (words-of-sep (onto (map lifetime lives) types) ", ") ">")) acc))))

      (define-rec
        (put-rust-chars (subr kfx (chars chars) chars)
          (lambda (cs acc)
            "`cs` inside a Rust string literal: `\\` and `\"` escaped."
            (cond ((null? cs) acc)
                  ((or (char=? (car cs) #\\) (char=? (car cs) #\")) (put-rust-chars (cdr cs) (put (char->string (car cs)) (put "\\" acc))))
                  (else (put-rust-chars (cdr cs) (put (char->string (car cs)) acc)))))))

      (define put-str-lit (subr kfx (string chars) chars)
        (lambda (s acc) (put "\")" (put-rust-chars (string-chars s) (put "str_lit!(\"" acc)))))

      (define-rec
        (put-syscall-params (subr kfx (ctx sexps i64 chars) chars)
          (lambda (c ps i acc)
            "`x1: T1, x2: T2, …`."
            (if (null? ps)
                acc
                (put-syscall-params c (cdr ps) (i64+ i 1)
                                    (put-type c (car ps) (put (string-append (if (i64= i 1) "x" ", x") (string-append (i64->string i) ": ")) acc))))))
        (put-syscall-args (subr kfx (i64 i64 chars) chars)
          (lambda (i n acc) (if (i64> i n) acc (put-syscall-args (i64+ i 1) n (put (string-append ", x" (i64->string i)) acc))))))

      (define put-syscall (subr kfx (ctx sexp sexps chars) chars)
        (lambda (c form xs acc)
          "A syscall's declaration (C225): the two definitions it is, written
           out: `%syscall-available:NAME`, whether kayak-rt has it (for a
           required one, `syscall_require`'s check first, so that a use of
           either checks it, KFX's constants running where used); and
           `NAME`, a `fn` of the declared type calling `syscallN`, which
           checks a required one first too."
          (let* ((name (sym-name (second xs)))
                 (host (tagcase (third xs) (str (h f p) h) (else other "")))
                 (required (head-is? form "define-syscall"))
                 (found (split-words (fact-said c form "syscall ")))
                 (text (words-of (cdr found)))
                 (label (string-append "syscall " (string-append name (string-append " (\"" (string-append host "\")")))))
                 (t (fourth xs))
                 (sub (if (head-is? t "poly") (third (items t)) t))
                 (parts (if (and (head-is? sub "subr") (i64= (size (items sub)) 4))
                            (items sub)
                            (error (string-append "kfx: a syscall's type is written out, a `subr` (C225): " name))))
                 (params (items (third parts)))
                 (avail (mangle (string-append "%syscall-available:" name)))
                 (acc (put (string-append "pub fn " (string-append avail "() -> bool {\n    ")) acc))
                 (acc (if required
                          (put ");\n    true\n}\n\n" (put-str-lit text (put ", " (put-str-lit host (put ", " (put-str-lit label (put "kayak_rt::syscall_require(" acc)))))))
                          (put ")\n}\n\n" (put-str-lit text (put ", " (put-str-lit host (put "kayak_rt::syscall_available(" acc)))))))
                 (acc (put (string-append (if (in-async-mode? c) "pub async fn " "pub fn ") (string-append (mangle name) "(")) acc))
                 (acc (put-syscall-params c params 1 acc))
                 (acc (put ") -> " acc))
                 (acc (put-type c (fourth parts) acc))
                 (acc (put " {\n    " acc))
                 (acc (if required (put "();\n    " (put avail acc)) acc))
                 (acc (put (string-append "kayak_rt::syscall" (string-append (i64->string (size params)) "(")) acc))
                 (acc (put-str-lit text (put ", " (put-str-lit host (put ", " (put-str-lit label acc))))))
                 (acc (put-syscall-args 1 (size params) acc)))
            (put ")\n}\n\n" acc))))

      (define-rec
        (weight-under (subr kfx (sexps i64) i64)
          (lambda (xs budget)
            "What is left of `budget` once `xs`'s atoms and lists are counted,
             each one; the count stopped once it is below 0."
            (if (or (null? xs) (i64< budget 0))
                budget
                (weight-under (cdr xs) (tagcase (car xs) (lst (ys f l p) (weight-under ys (i64- budget 1))) (else other (i64- budget 1))))))))

      (define put-define (subr kfx (ctx sexp sexp sexp chars) chars)
        (lambda (c name typ defined acc)
          "A definition, a `fn`: a procedure's of its parameters; a constant's of
           none, run at each use, or, if it allocates, made at its first use and
           kept (C21). It may call itself: in the async mode, it and the
           procedures of its recursion group (`recs`, C379) are `%rec`, whose
           calls are boxed (C371)."
          (let* ((c (if (in-async-mode? c)
                        (with-locals c (cons (string-append "%rec " (sym-name name))
                                             (map (lambda ((x string)) (string-append "%rec " x)) (split-words (fact-said c name "recs ")))))
                        c))
                 (binders (if (head-is? typ "poly") (items (second (items typ))) nil))
                 (places (concat (map (lambda ((b sexp)) (if (sym-is? (second (items b)) "place") (the strings (list (sym-name (car (items b))))) nil)) binders)))
                 (lives (if (may-suspend? c binders typ) nil (free-regions binders)))
                 (c (with-locals c (onto (onto (map (lambda ((r string)) (string-append "%letrena " r)) lives)
                                               (concat (map (lambda ((p string)) (the strings (list (string-append "%letrena " p) (string-append "%placeparam " p)))) places)))
                                         (onto (concat (map (lambda ((b sexp))
                                                              (let ((bs (items b)))
                                                                (if (and (i64= (size bs) 3) (sym-is? (second bs) "region") (not (sym-is? (third bs) "distinct")))
                                                                    (the strings (list (string-append "%within " (string-append (sym-name (car bs)) (string-append " " (sym-name (third bs)))))))
                                                                    nil)))
                                                            binders))
                                         (concat (map (lambda ((b sexp))
                                                        (cond ((sym-is? (second (items b)) "type") (the strings (list (string-append "%tvar " (sym-name (car (items b)))))))
                                                              ((sym-is? (second (items b)) "effect") (the strings (list (string-append "%evar " (sym-name (car (items b)))))))
                                                              (else nil)))
                                                      binders))))))
                 (written (fact-said c defined "def-type "))
                 (typ (without-conv (if (string=? written "")
                                        (family-expanded c (unpoly typ))
                                        (car (read-all written "" 1)))))
                 (defined (unpoly defined))
                 (lambda? (head-is? defined "lambda"))
                 (body (if lambda? (cdr (cdr (items defined))) (the sexps (list defined))))
                 (doc? (and (comment? (car body)) (not (null? (cdr body)))))
                 (acc (if doc? (put "\n" (put-comment (string-chars (comment-text (car body))) "///" 0 #t acc)) acc))
                 (body (if doc? (cdr body) body))
                 (fallible (and lambda? (fallible-effect? c (second (items typ)))))
                 ;; A leaf, in the async mode, is no `async fn` (C377).
                 (suspends (and lambda? (suspending-effect? c (second (items typ)))
                                (not (and (in-async-mode? c) (fact-at? c name "leaf")))))
                 (mparams (if lambda? (module-params c (items (second (items defined))) (items (third (items typ)))) nil))
                 (t (if lambda?
                        (returns (sym-name name) (map param-name (items (second (items defined)))) (null? mparams) fallible)
                        (value)))
                 (loops? (and lambda? (tail-calls? t (last body))))
                 (inner (if lambda?
                            (with-locals c (onto (cons (if suspends "%async" "%sync") (cons (if fallible "%fallible" "%infallible")
                                                       (map param-name (items (second (items defined))))))
                                                 (map (lambda ((mp string)) (string-append "%modparam " mp)) mparams)))
                            c))
                 ;; A small one marked `#[inline]` (C332): rustc inlines no `fn` into
                 ;; another codegen unit unless it is, and a unit's files are
                 ;; modules apart; the engine's heap reads are tier 1's.
                 (acc (if (and (not suspends) (not loops?) (i64>= (weight-under body 24) 0)) (put "#[inline]\n" acc) acc))
                 (acc (put (if suspends "pub async fn " "pub fn ") acc))
                 (acc (put (mangle (sym-name name)) acc))
                 (acc (cond ((not (null? places)) (put-place-generics c (sym-name name) binders lives places acc))
                            ((not (null? lives)) (put-lifetime-generics lives binders acc))
                            (else (put-generics binders #t acc))))
                 (acc (cond ((null? mparams) acc)
                            ((not (null? binders)) (error "kfx: a poly procedure with a module parameter, which KFX does not write yet"))
                            (else (put ">" (put-sep (lambda ((mp string) (acc chars))
                                                      (let ((ws (split-words mp))) (put (camel (car (cdr ws))) (put ": " (put (camel (car ws)) (put "Mod_" acc))))))
                                                    ", " mparams (put "<" acc))))))
                 (acc (if lambda?
                          (let* ((acc (put "(" acc))
                                 (acc (put-params c (unmoduled c (items (second (items defined))) (items (third (items typ))) #t)
                                                  (unmoduled c (items (second (items defined))) (items (third (items typ))) #f)
                                                  loops? acc))
                                 (acc (put ") -> " acc)))
                            (if fallible
                                (put ", Unwind>" (put-type c (fourth (items typ)) (put "Result<" acc)))
                                (put-type c (fourth (items typ)) acc)))
                          (put-type c typ (put "() -> " acc))))
                 (acc (put " {" acc)))
            (cond
             ((and lambda? (not suspends) (not fallible) (string=? (sym-name name) "string-list-append")
                   (i64= (size (items (second (items defined)))) 1))
              "`string-list-append` (base.kfx; C476): its strings joined at once, one
               new string (kayak-rt's `strings_joined`), where its KFX joins
               them pairwise, a new string each round, all kept for the run (an edit
               build's save, 50 MB for a shard of 265 KB). The same value; the KFX
               the meaning, which Fixpt, tier 1 and the engine run."
              (put ")\n}\n\n" (put (mangle (param-name (car (items (second (items defined)))))) (put "\n    kayak_rt::strings_joined(" acc))))
             (loops?
                (let* ((acc (put-nl 2 (put "loop {" (put-nl 1 acc))))
                       ;; Fuel, each turn, if it awaits (C378).
                       (acc (if (and suspends (charging? c))
                                (put-charged-loop (put-stmts inner body 2 t nil) 2 acc)
                                (put-stmts inner body 2 t acc))))
                  (put "\n    }\n}\n\n" acc)))
             (else
                (if (and (not lambda?) (fact-at? c defined "once"))
                    (let* ((acc (put-nl 1 acc))
                           (acc (if (fact-at? c defined "shared")
                                    (put "> = std::sync::OnceLock::new();" (put-type c typ (put "static ONCE: std::sync::OnceLock<" acc)))
                                    (put ");" (put-type c typ (put "kayak_rt::kept_constant!(ONCE: " acc)))))
                           (acc (put-nl 1 acc))
                           (acc (put "once(&ONCE, || {" acc))
                           (acc (put-stmts inner body 2 (value) (put-nl 2 acc))))
                      (put "\n    })\n}\n\n" acc))
                    (put "\n}\n\n" (put-stmts inner body 1 (if fallible (ok-value) (value))
                                                (put-nl 1 acc)))))))))

      (define put-rec-each (subr kfx (ctx sexps chars) chars)
        (lambda (c bindings acc)
          (if (null? bindings)
              acc
              (let ((b (items (car bindings))))
                (put-rec-each c (cdr bindings) (put-define c (car b) (second b) (third b) acc))))))

      (define put-rec (subr kfx (ctx sexps chars) chars)
        (lambda (c bindings acc)
          "A group's definitions; in the async mode, each knowing its own
           recursion group, which may be less than the group (`put-define`,
           C379)."
          (put-rec-each c bindings acc)))

      (define put-variants (subr kfx (ctx sexps chars) chars)
        (lambda (c variants acc)
          (if (null? variants)
              acc
              (let* ((v (items (car variants)))
                     (acc (put "    " acc))
                     (acc (put (camel (sym-name (car v))) acc))
                     (acc (put "(" acc))
                     (acc (put-types c (cdr v) acc)))
                (put-variants c (cdr variants) (put "),\n" acc))))))

      (define put-fields (subr kfx (ctx sexps i64 bool chars) chars)
        (lambda (c types i typed acc)
          "Fields `f0`, `f1`, ..., from `i`, with their types if `typed`."
          (if (null? types)
              acc
              (let* ((acc (if (i64= i 0) acc (put ", " acc)))
                     (acc (put "f" acc))
                     (acc (put (i64->string i) acc))
                     (acc (if typed (put-type c (car types) (put ": " acc)) acc)))
                (put-fields c (cdr types) (i64+ i 1) typed acc)))))

      (define put-constructors (subr kfx (ctx string strings strings sexps chars) chars)
        (lambda (c d lived params variants acc)
          "A constructor for each variant: in the heap, `&'static`; with lived
           regions (C270), at their lifetimes, made in the heap (kayak-rt's
           `alloc`, as an arena of the heap holds only what lives for the run),
           and, with one, its `_in` twin, made in a place's arena."
          (if (null? variants)
              acc
              (let* ((v (items (car variants)))
                     (tag (sym-name (car v)))
                     (gen (lambda ((more string))
                            (string-append "<" (string-append (words-of-sep (onto (map lifetime lived) (onto (map (lambda ((p string)) (string-append (camel p) ": Copy + 'static + kayak_rt::Trace")) params) (if (string=? more "") nil (the strings (list more))))) ", ") ">"))))
                     (named (string-append (camel d) (if (and (null? lived) (null? params)) "" (string-append "<" (string-append (words-of-sep (onto (map lifetime lived) (map camel params)) ", ") ">")))))
                     (at (if (null? lived) "'static" (lifetime (car lived))))
                     (made (string-append (camel d) (string-append "::" (variant-name tag))))
                     (acc (put "pub fn " acc))
                     (acc (put (mangle tag) acc))
                     (acc (if (null? lived) (put-generics-of params #t acc) (put (gen "") acc)))
                     (acc (put "(" acc))
                     (acc (put-fields c (cdr v) 0 #t acc))
                     ;; A handle (C478), the heap's or the region's.
                     (acc (put (string-append ") -> kayak_rt::Handle<" (string-append at ", ")) acc))
                     (acc (put ">" (put named acc)))
                     (acc (put (if (null? lived) " {\n    kayak_rt::heap_alloc(" " {\n    kayak_rt::alloc(") acc))
                     (acc (put made acc))
                     (acc (put "(" acc))
                     (acc (put "))\n}\n\n" (put-fields c (cdr v) 0 #f acc)))
                     (acc (if (null? lived)
                              acc
                              ;; Its heap twin (C271): at `'static`, in the heap's
                              ;; arena, for a call at no region of a lifetime.
                              (let* ((acc (put "pub fn " acc))
                                     (acc (put (string-append (mangle tag) "_heap") acc))
                                     (acc (put-generics-of params #t acc))
                                     (acc (put "(" acc))
                                     (acc (put-fields (in-heap c) (cdr v) 0 #t acc))
                                     (acc (put ") -> kayak_rt::Handle<'static, " acc))
                                     (acc (put (string-append (camel d) (string-append "<" (string-append (words-of-sep (onto (map (lambda ((r string)) "'static") lived) (map camel params)) ", ") ">>"))) acc))
                                     (acc (put " {\n    kayak_rt::heap_alloc(" acc))
                                     (acc (put made acc))
                                     (acc (put "(" acc)))
                                (put "))\n}\n\n" (put-fields c (cdr v) 0 #f acc)))))
                     (acc (if (not (i64= (size lived) 1))
                              acc
                              (let* ((acc (put "pub fn " acc))
                                     (acc (put (string-append (mangle tag) "_in") acc))
                                     (acc (put (gen (string-append "Place_: Holds<" (string-append named ">"))) acc))
                                     (acc (put (string-append "(place_: &" (string-append at " Place_")) acc))
                                     (acc (if (null? (cdr v)) acc (put-fields c (cdr v) 0 #t (put ", " acc))))
                                     (acc (put (string-append ") -> kayak_rt::Handle<" (string-append at ", ")) acc))
                                     (acc (put ">" (put named acc)))
                                     (acc (put " {\n    place_.arena().alloc(" acc))
                                     (acc (put made acc))
                                     (acc (put "(" acc)))
                                (put "))\n}\n\n" (put-fields c (cdr v) 0 #f acc))))))
                (put-constructors c d lived params (cdr variants) acc)))))

      (define put-datatype (subr kfx (ctx sexps chars) chars)
        (lambda (c xs acc)
          "An enum, generic in its type parameters, and a constructor for each
           variant; its regions erased, or, a top-level datatype's its variants
           name, lifetimes (C270)."
          (let* ((d (type-head-name (car xs)))
                 (params (head-type-params (car xs)))
                 (lived (if (string=? (module-here c) "") (lived-regions (lst (cons (sym "define-datatype" "" 0) xs) "" 0 0)) nil))
                 (inner (with-locals c (map (lambda ((r string)) (string-append "%letrena " r)) lived)))
                 (acc (put "pub enum " acc))
                 (acc (put (camel d) acc))
                 (acc (if (null? lived)
                          (put-generics-of params #t acc)
                          (put (string-append "<" (string-append (words-of-sep (onto (map lifetime lived) (map (lambda ((p string)) (string-append (camel p) ": Copy + 'static + kayak_rt::Trace")) params)) ", ") ">")) acc)))
                 (acc (put " {\n" acc))
                 (acc (put-variants inner (cdr xs) acc))
                 (acc (put "}\n\n" acc))
                 (acc (put-trace-impl d lived params (cdr xs) acc)))
            (put-constructors inner d lived params (cdr xs) acc))))

      (define put-trace-impl (subr kfx (string strings strings sexps chars) chars)
        (lambda (d lived params variants acc)
          "Its `Visit` (C479, C481; kayak-rt's `trace.rs`): what a handle
           points to, each variant's fields traced, what of the heap they reach
           told the tracer; its type parameters traceable."
          (let* ((generic (onto (map lifetime lived)
                                (map (lambda ((p string)) (string-append (camel p) ": Copy + 'static + kayak_rt::Trace")) params)))
                 (args (onto (map lifetime lived) (map camel params)))
                 (acc (put (string-append "impl" (string-append (if (null? generic) "" (string-append "<" (string-append (words-of-sep generic ", ") ">"))) " kayak_rt::Visit for ")) acc))
                 (acc (put (camel d) acc))
                 (acc (if (null? args) acc (put (string-append "<" (string-append (words-of-sep args ", ") ">")) acc)))
                 (acc (put " {\n    fn visit<'a>(&'a self, t: &mut kayak_rt::Tracer<'a>) {\n" acc))
                 (acc (if (null? variants) (put "        let _ = t;\n        match *self {}\n" acc) (put "        match self {\n" acc)))
                 (acc (put-trace-arms variants acc))
                 (acc (if (null? variants) acc (put "        }\n" acc))))
            (put "    }\n}\n\n" acc))))

      (define-rec
        (put-trace-arms (subr kfx (sexps chars) chars)
          (lambda (variants acc)
            (if (null? variants)
                acc
                (let* ((v (items (car variants)))
                       (fields (map (lambda ((i i64)) (string-append "f" (i64->string i))) (counting 0 (size (cdr v)))))
                       (acc (put (string-append "            Self::" (string-append (camel (sym-name (car v))) (string-append "(" (string-append (words-of-sep fields ", ") ") => {")))) acc))
                       (acc (put (string-list-append (map (lambda ((f string)) (string-append " kayak_rt::Trace::trace(*" (string-append f ", t);"))) fields)) acc)))
                  (put-trace-arms (cdr variants) (put " }\n" acc)))))))

      (define put-generics-list (subr kfx (strings chars) chars)
        (lambda (ps acc)
          "Type parameters, each as Rust names it, each followed by `,`."
          (if (null? ps) acc (put-generics-list (cdr ps) (put ", " (put (camel (car ps)) acc))))))

      (define put-generative (subr kfx (ctx sexps string string chars) chars)
        (lambda (c xs seal unseal acc)
          "A generative type: a new type, a newtype in Rust, and its conversions,
           `seal` and `unseal` as its form names them (C428)."
          (let* ((t (type-head-name (car xs)))
                 (params (head-type-params (car xs)))
                 (inside (not (string=? (module-here c) "")))
                 ;; Its `Trace` (C480, C481): its one field's, split as it is.
                 (acc (put (string-append "impl" (if (null? params) "" (string-append "<" (string-append (words-of-sep (map (lambda ((p string)) (string-append (camel p) ": Copy + 'static + kayak_rt::Trace")) params) ", ") ">")))) acc))
                 (acc (put (string-append " kayak_rt::Trace for " (camel t)) acc))
                 (acc (if (null? params) acc (put (string-append "<" (string-append (words-of-sep (map camel params) ", ") ">")) acc)))
                 (acc (put " {\n    type Field = <" acc))
                 (acc (put-type c (second xs) acc))
                 (acc (put " as kayak_rt::Trace>::Field;\n    type Byte = <" acc))
                 (acc (put-type c (second xs) acc))
                 (acc (put " as kayak_rt::Trace>::Byte;\n    fn split(self) -> (Self::Field, Self::Byte) {\n        kayak_rt::Trace::split(self.0)\n    }\n    fn join(f: Self::Field, b: Self::Byte) -> Self {\n        " acc))
                 (acc (put (camel t) acc))
                 (acc (put (if (null? params) "(kayak_rt::Trace::join(f, b))\n    }\n" "(kayak_rt::Trace::join(f, b), std::marker::PhantomData)\n    }\n") acc))
                 ;; Held as its field is (C495): a Fixpt word where that is one.
                 (acc (put "    type Stored = <" acc))
                 (acc (put-type c (second xs) acc))
                 (acc (put " as kayak_rt::Trace>::Stored;\n    fn store(self) -> Self::Stored {\n        kayak_rt::Trace::store(self.0)\n    }\n    fn load(s: Self::Stored) -> Self {\n        " acc))
                 (acc (put (camel t) acc))
                 (acc (put (if (null? params) "(kayak_rt::Trace::load(s))\n    }\n" "(kayak_rt::Trace::load(s), std::marker::PhantomData)\n    }\n") acc))
                 (acc (put "    fn trace<'a>(self, t: &mut kayak_rt::Tracer<'a>) where Self: 'a {\n        kayak_rt::Trace::trace(self.0, t);\n    }\n}\n\n" acc))
                 (acc (put "#[derive(Clone, Copy)]\npub struct " acc))
                 (acc (put (camel t) acc))
                 (acc (put-generics-of params #t acc))
                 (acc (put (if inside "(" "(pub ") acc))
                 (acc (put-type c (second xs) acc))
                 ;; Its parameters, held: a sum's payloads' types are not in its
                 ;; Rust type (C409), and a parameter only they use would be
                 ;; none of the newtype's.
                 (acc (if (null? params) acc (put ")>" (put-generics-list params (put ", std::marker::PhantomData<(" acc)))))
                 ;; In the async mode (C373), as every procedure, `async`.
                 (acc (put (if inside (if (in-async-mode? c) ");\n\nasync fn " ");\n\nfn ") (if (in-async-mode? c) ");\n\npub async fn " ");\n\npub fn ")) acc))
                 (acc (put (mangle seal) acc))
                 (acc (put-generics-of params #t acc))
                 (acc (put "(x: " acc))
                 (acc (put-type c (second xs) acc))
                 (acc (put ") -> " acc))
                 (acc (put (camel t) acc))
                 (acc (put-generics-of params #f acc))
                 (acc (put " {\n    " acc))
                 (acc (put (camel t) acc))
                 (acc (put (if (null? params) "" "(x, std::marker::PhantomData") acc))
                 (acc (put (cond ((and inside (null? params)) (if (in-async-mode? c) "(x)\n}\n\nasync fn " "(x)\n}\n\nfn "))
                                 (inside (if (in-async-mode? c) ")\n}\n\nasync fn " ")\n}\n\nfn "))
                                 ((null? params) (if (in-async-mode? c) "(x)\n}\n\npub async fn " "(x)\n}\n\npub fn "))
                                 (else (if (in-async-mode? c) ")\n}\n\npub async fn " ")\n}\n\npub fn ")))
                           acc))
                 (acc (put (mangle unseal) acc))
                 (acc (put-generics-of params #t acc))
                 (acc (put "(x: " acc))
                 (acc (put (camel t) acc))
                 (acc (put-generics-of params #f acc))
                 (acc (put ") -> " acc))
                 (acc (put-type c (second xs) acc)))
            (put " {\n    x.0\n}\n\n" acc))))

      (define-rec
        (indented (subr kfx (chars bool chars) chars)
          (lambda (cs start acc)
            "Lines, each not empty four spaces in: `acc`, a module's items."
            (cond ((null? cs) acc)
                  ((char=? (car cs) #\newline) (indented (cdr cs) #t (cons (car cs) acc)))
                  (start (indented (cdr cs) #f (cons (car cs) (put "    " acc))))
                  (else (indented (cdr cs) #f (cons (car cs) acc)))))))

      (define-rec
        (trimmed (subr kfx (chars) chars)
          (lambda (cs)
            "Written text, its last newlines dropped."
            (if (and (not (null? cs)) (char=? (car cs) #\newline)) (trimmed (cdr cs)) cs))))

      (define without (subr kfx (strings strings) strings)
        (lambda (xs ys)
          (if (null? xs) nil
              (if (string-member? (car xs) ys) (without (cdr xs) ys) (cons (car xs) (without (cdr xs) ys))))))

      "The shapes a program has, each declared once: every `productof`,
       `sumof` and `product` in it, and in the types the checker elaborated and
       found for sums. A shape's key is `P` or `S`, then its labels."

      (define standard-shape? (subr kfx (string) bool)
        (lambda (key)
          "A shape kayak-rt declares, as the program's would be (`world.rs`): what
           FX-26's I/O and bytes primitives answer with (C49)."
          (string-member? key (list "S text bad" "S done failed" "S line eof failed" "S data failed" "S names failed" "P kind detail"
                                    "S byte eof failed" "S count eof failed" "S done not-a-terminal failed" "S size not-a-terminal failed" "P rows columns"
                                    "S info failed" "S target failed" "S file directory symlink other" "P kind size modified mode"
                                    "S started failed" "S running exited signalled unknown" "S exited signalled unknown"
                                    "P 1 2" "P 1 2 3" "P 1 2 3 4 5" "S node bound hole const sym int flag"
                                    "S not-found permission-denied already-exists not-a-directory is-a-directory broken-pipe invalid-data other"))))

      (define shape-key (subr kfx (sexp) strings)
        (lambda (e)
          "The key of the shape `e` writes, if it writes one."
          (tagcase e
            (lst (xs f l p)
              (if (and (not (null? xs))
                       (or (sym-is? (car xs) "productof") (sym-is? (car xs) "product") (sym-is? (car xs) "sumof"))
                       (not (any? (lambda ((x sexp)) (tagcase x (lst (ys f2 l2 p2) (null? ys)) (else other #t))) (cdr xs))))
                  (the strings
                    (list (string-append (if (sym-is? (car xs) "sumof") "S" "P")
                                         (concat-strings (map (lambda ((x sexp)) (string-append " " (label-of (car (items x))))) (cdr xs))))))
                  nil))
            (else other nil))))

      (define-rec
        (shapes-in (subr kfx (sexp strings) strings)
          (lambda (e acc)
            (tagcase e
              (lst (xs f l p)
                (let ((acc (shapes-in-all xs acc))
                      (key (shape-key e)))
                  (if (or (null? key) (string-member? (car key) acc) (standard-shape? (car key))) acc (cons (car key) acc))))
              (else other acc))))
        (shapes-in-all (subr kfx (sexps strings) strings)
          (lambda (es acc) (if (null? es) acc (shapes-in-all (cdr es) (shapes-in (car es) acc))))))

      (define program-shapes (subr kfx (ctx sexps) strings)
        (lambda (c forms)
          (tagcase c
            (ctx (ds ts ks ls xs fs fx ms es mods)
              (reverse-strings
               (shapes-in-all (onto (map (lambda ((x typed)) (tagcase x (typed (n t) t))) xs)
                                    (concat (map (lambda ((f fact))
                                                   (tagcase f
                                                     (fact (ff fp fw)
                                                       (if (has-prefix? fw "sum-type ")
                                                           (read-all (after-prefix fw "sum-type ") "" 1)
                                                           nil))))
                                                 fs)))
                              (shapes-in-all forms nil))
               nil)))))

      (define-rec
        (put-params-of (subr kfx (i64 i64 chars) chars)
          (lambda (i n acc)
            (if (i64< i n)
                (put-params-of (i64+ i 1) n (put (i64->string i) (put (if (i64= i 0) "A" ", A") acc)))
                acc))))

      (define put-generic-params (subr kfx (i64 chars) chars)
        (lambda (n acc) (if (i64= n 0) acc (put ">" (put-params-of 0 n (put "<" acc))))))

      (define-rec
        (put-variants-of (subr kfx (strings i64 chars) chars)
          (lambda (tags i acc)
            (if (null? tags)
                acc
                (put-variants-of (cdr tags) (i64+ i 1)
                                 (put "),\n" (put (i64->string i) (put "(A" (put (variant-name (car tags)) (put "    " acc))))))))))

      (define put-shape-trace (subr kfx (string bool strings i64 chars) chars)
        (lambda (name product labels n acc)
          "A shape's `Trace` (C479, C481): a product's fields traced, and split
           apart, each field's as it is (kayak-rt's `trace_product!`); or a
           sum's payload, the sum kept whole among the traced fields; each
           type parameter traceable."
          (let ((ps (map (lambda ((i i64)) (string-append "A" (i64->string i))) (counting 0 n))))
            (cond ((and product (i64> n 0))
                   (put ");\n\n"
                        (put (string-list-append (map (lambda ((i i64)) (string-append ", A" (string-append (i64->string i) (string-append " " (i64->string i))))) (counting 0 n)))
                             (put (string-append "kayak_rt::trace_product!(" name) acc))))
                  (else
                   (let* ((acc (put (string-append "impl" (if (i64= n 0) "" (string-append "<" (string-append (words-of-sep (map (lambda ((a string)) (string-append a ": kayak_rt::Trace")) ps) ", ") ">")))) acc))
                          (acc (put (string-append " kayak_rt::Trace for " name) acc))
                          (acc (if (i64= n 0) acc (put (string-append "<" (string-append (words-of-sep ps ", ") ">")) acc)))
                          (acc (put " {\n    kayak_rt::trace_whole!();\n    fn trace<'a>(self, t: &mut kayak_rt::Tracer<'a>) where Self: 'a {\n" acc)))
                     (put "    }\n}\n\n"
                          (cond (product (put "        let _ = t;\n" acc))
                                ((null? labels) (put "        let _ = t;\n        match self {}\n" acc))
                                (else
                                 (put "        }\n"
                                      (put (string-list-append (map (lambda ((l string)) (string-append "            " (string-append name (string-append "::" (string-append (variant-name l) "(x) => kayak_rt::Trace::trace(x, t),\n"))))) labels))
                                           (put "        match self {\n" acc))))))))))))

      (define put-shape-decls (subr kfx (strings bool bool chars) chars)
        (lambda (keys shows flats acc)
          "Each shape's declaration, and, for `kfx --toplevel`, its `Show`, as
           Fixpt writes one: `#<product of 2>`, `#<sum leaf>`; with `flats`, a
           product's `Flat`, for a typed suffix (C32): all zero bytes valid, as
           each of its fields' are (C487)."
          (if (null? keys)
              acc
              (let* ((key (car keys))
                     (product (string=? (substring-of key 1) "P"))
                     (labels (split-words (after-prefix key (substring-of key 1))))
                     (name (shape-name product labels))
                     (n (size labels))
                     (acc (put "#[allow(non_camel_case_types)]\n" acc))
                     (acc (if product
                              (put ");\n\n" (put-sep (lambda ((i i64) (acc chars)) (put (i64->string i) (put "pub A" acc))) ", " (counting 0 n)
                                                   (put "(" (put-generic-params n (put name (put "#[derive(Clone, Copy)]\npub struct " acc))))))
                              (put "}\n\n" (put-variants-of labels 0 (put " {\n" (put-generic-params n (put name (put "pub enum " acc))))))))
                     (acc (put-shape-trace name product labels n acc))
                     (acc (if (not shows)
                              acc
                              (let ((acc (put " {\n    fn show(&self, out: &mut String) {\n" (put-generic-params n (put name (put " Show for " (put-generic-params n (put "impl" acc))))))))
                                (put "    }\n}\n\n"
                                     (if product
                                         (put ">\");\n" (put (i64->string n) (put "        out.push_str(\"#<product of " acc)))
                                         (put "        }\n"
                                              (put-sep (lambda ((l string) (acc chars))
                                                         (put ">\"),\n" (put l (put "(..) => out.push_str(\"#<sum " (put (variant-name l) (put "::" (put name (put "            " acc))))))))
                                                       "" labels (put "        match self {\n" acc)))))))))
                (put-shape-decls (cdr keys) shows flats
                                 (if (and flats product)
                                     (put " {}\n\n"
                                          (put-generic-params n (put name (put " Flat for "
                                            (put ">" (put-sep (lambda ((i i64) (acc chars)) (put ": Flat" (put (i64->string i) (put "A" acc)))) ", " (counting 0 n)
                                                              (put "// SAFETY: a product of flats, each all zero bytes valid and needing\n// no drop, is so too (C487).\n#[allow(unsafe_code)]\nunsafe impl<" acc)))))))
                                     acc))))))

      "A program's top-level expressions, for running Fixpt's programs as Rust
       (`kfx --toplevel`, scripts/run-fixpt-programs.py): a `Show` for each
       datatype, writing a value as Fixpt does, `#<sum TAG>`; and
       `kfx_toplevel`, which writes each top-level expression's value on a line,
       top-level strings too, as `fixpt eval` does."

      (define put-show-arms (subr kfx (string sexps chars) chars)
        (lambda (d variants acc)
          (if (null? variants)
              acc
              (let* ((tag (sym-name (car (items (car variants)))))
                     (acc (put "            " acc))
                     (acc (put (camel d) acc))
                     (acc (put "::" acc))
                     (acc (put (variant-name tag) acc))
                     (acc (put "(..) => out.push_str(str_lit!(\"#<sum " acc))
                     (acc (put tag acc)))
                (put-show-arms d (cdr variants) (put ">\").as_str()),\n" acc))))))

      (define put-show-impls (subr kfx (sexps chars) chars)
        (lambda (forms acc)
          (cond ((null? forms) acc)
                ((head-is? (car forms) "define-datatype")
                 (let* ((xs (cdr (items (car forms))))
                        (d (type-head-name (car xs)))
                        (params (head-type-params (car xs)))
                        (lived (lived-regions (car forms)))
                        (acc (put "impl" acc))
                        (acc (if (null? lived)
                                 (put-generics-of params #t acc)
                                 (put (string-append "<" (string-append (words-of-sep (onto (map lifetime lived) (map (lambda ((p string)) (string-append (camel p) ": Copy + 'static + kayak_rt::Trace")) params)) ", ") ">")) acc)))
                        (acc (put " Show for " acc))
                        (acc (put (camel d) acc))
                        (acc (if (null? lived)
                                 (put-generics-of params #f acc)
                                 (put (string-append "<" (string-append (words-of-sep (onto (map lifetime lived) (map camel params)) ", ") ">")) acc)))
                        (acc (put " {\n    fn show(&self, out: &mut String) {\n        match self {\n" acc))
                        (acc (put-show-arms d (cdr xs) acc)))
                   (put-show-impls (cdr forms) (put "        }\n    }\n}\n\n" acc))))
                ((head-is? (car forms) "define-generative")
                 (let* ((h (second (items (car forms))))
                        (params (head-type-params h))
                        (acc (put "impl" acc))
                        (acc (if (null? params)
                                 acc
                                 (put ">" (put-sep (lambda ((n string) (acc chars))
                                                     (put ": Copy + 'static + kayak_rt::Trace + Show" (put (camel n) acc)))
                                                   ", " params (put "<" acc)))))
                        (acc (put " Show for " acc))
                        (acc (put (camel (type-head-name h)) acc))
                        (acc (put-generics-of params #f acc)))
                   (put-show-impls (cdr forms) (put " {\n    fn show(&self, out: &mut String) {\n        self.0.show(out)\n    }\n}\n\n" acc))))
                (else (put-show-impls (cdr forms) acc)))))

      "What a module's items are written in, and its items (C91)."

      (define toplevel-form? (subr kfx (sexp) bool)
        (lambda (f) (not (or (definition? f) (head-is? f "define-effect")))))

      (define put-toplevel-lines (subr kfx (ctx sexps chars) chars)
        (lambda (c forms acc)
          "Each top-level expression's value written; a `void` one, which never
           gives one, run, its type said; one that may suspend, a future run to
           its end (C45). Between two forms, and after the last, the processes
           that can run run (`quiesce`), as Fixpt ends a form (C101)."
          (cond ((null? forms) (put "    kayak_rt::process::quiesce();\n" acc))
                ((toplevel-form? (car forms))
                 (let ((acc (put "    kayak_rt::process::quiesce();\n" acc)))
                 (cond
                   ((mfact? c (car forms) "suspends")
                    (if (fact-at? c (car forms) "void")
                        (let* ((acc (put "    let _: () = kayak_rt::suspend::block(kayak_rt::suspend::body(async move { let _: Void = " acc))
                               (acc (put-exp (with-locals c (list "%async" "%fallible")) (car forms) 1 (value) acc)))
                          (put-toplevel-lines c (cdr forms) (put "; Ok(()) })).unwrap_or_else(|u| unreachable_unwind(u));\n" acc)))
                        (let* ((acc (put "    kayak_rt::show_line(&mut out_, kayak_rt::suspend::block(kayak_rt::suspend::body(async move { Ok(" acc))
                               (acc (put-exp (with-locals c (list "%async" "%fallible")) (car forms) 1 (value) acc)))
                          (put-toplevel-lines c (cdr forms) (put ") })).unwrap_or_else(|u| unreachable_unwind(u)));\n" acc)))))
                   ((fact-at? c (car forms) "procedure")
                    "A procedure, as Fixpt writes one, whatever made it: a global's
                     own `fn` is no `dyn Fn`, whose `Show` this would otherwise be."
                    (let* ((acc (put "    kayak_rt::show_line(&mut out_, (|| -> Result<_, Unwind> { let _ = " acc))
                           (acc (put-exp (with-locals c (list "%fallible")) (car forms) 1 (value) acc)))
                      (put-toplevel-lines c (cdr forms) (put "; Ok(kayak_rt::Procedure) })().unwrap_or_else(|u| unreachable_unwind(u)));\n" acc))))
                   (else
                 (if (fact-at? c (car forms) "void")
                     (let* ((acc (put "    let _: () = (|| -> Result<(), Unwind> { let _: Void = " acc))
                            (acc (put-exp (with-locals c (list "%fallible")) (car forms) 1 (value) acc)))
                       (put-toplevel-lines c (cdr forms) (put "; Ok(()) })().unwrap_or_else(|u| unreachable_unwind(u));\n" acc)))
                     (let* ((acc (put "    kayak_rt::show_line(&mut out_, (|| -> Result<_, Unwind> { Ok(" acc))
                            (acc (put-exp (with-locals c (list "%fallible")) (car forms) 1 (value) acc)))
                       (put-toplevel-lines c (cdr forms) (put ") })().unwrap_or_else(|u| unreachable_unwind(u)));\n" acc))))))))
                ((made-here? c (car forms))
                 "A global's value made where it is defined, as FX-26 makes it, so
                  that one that fails fails there (a Rust global is made when first
                  read)."
                 (put-toplevel-lines c (cdr forms)
                                     (put "();\n" (put (mangle (sym-name (second (items (car forms))))) (put "    let _ = " acc)))))
                (else (put-toplevel-lines c (cdr forms) acc))))))

    (define made-here? (subr kfx (ctx sexp) bool)
      (lambda (c f)
        "A typed global's value, of no type parameters, no procedure and not
         suspending: a Rust `fn` of no arguments."
        (and (head-is? f "define")
             (i64= (size (items f)) 4)
             (not (mfact? c f "suspends"))
             (not (any? (lambda ((h string)) (head-is? (third (items f)) h)) (list "poly" "subr" "vsubr" "moduleof" "dsubr")))
             (not (any? (lambda ((h string)) (head-is? (fourth (items f)) h)) (list "lambda" "plambda" "vlambda" "dlambda" "case-lambda"))))))

    (define put-module-impls (subr kfx (ctx chars) chars)
      (lambda (c acc)
        (put-sep (lambda ((k string) (acc chars))
                   (let ((ws (split-words k))) (put-impl c (car ws) (car (cdr ws)) acc)))
                 "" (deduped (module-impls c) nil) acc)))

    (define definition? (subr kfx (sexp) bool)
      (lambda (e)
        (or (head-is? e "define") (head-is? e "define*") (head-is? e "define-rec") (module-def? e)
            (head-is? e "define-datatype") (head-is? e "define-type") (head-is? e "define-generative"))))

    (define-rec
      (maker-defs (subr kfx (sexps) sexps)
        (lambda (forms)
          "A module maker's module's items, each `(name type lambda)` (C274)."
          (cond ((null? forms) nil)
                ((comment? (car forms)) (maker-defs (cdr forms)))
                ((and (head-is? (car forms) "define") (i64= (size (items (car forms))) 4) (lambda-form? (fourth (items (car forms)))))
                 (cons (lst (cdr (items (car forms))) "" 0 0) (maker-defs (cdr forms))))
                ((head-is? (car forms) "define-rec") (onto (cdr (items (car forms))) (maker-defs (cdr forms))))
                ((maker-state? (car forms)) (maker-defs (cdr forms)))
                ((maker-type? (car forms)) (maker-defs (cdr forms)))
                ((head-is? (car forms) "include") (maker-defs (cdr forms)))
                ;; A file of a place's mark (C442), the checker's alone.
                ((head-is? (car forms) "%loaded") (maker-defs (cdr forms)))
                (else (error (string-append "kfx: a module maker's item not a procedure's definition, typed, nor a ref, which KFX writes not yet (C274, C433): "
                                            (show-sexp (car forms)))))))))

    (define maker-type? (subr kfx (sexp) bool)
      (lambda (f)
        "A module maker's type abbreviation or effect (C436), one naming its
         place: written in its module, as a module's are. Not a datatype,
         which the checker reads as a structural sum in a module value."
        (cond ((head-is? f "define-datatype")
               (error "kfx: a datatype in a module maker's module, which the checker reads as a structural sum: define it outside (C436)"))
              ;; A module it includes, a `use` of its Rust module (C437).
              (else (or (head-is? f "define-type") (head-is? f "define-effect") (head-is? f "include"))))))

    (define maker-state? (subr kfx (sexp) bool)
      (lambda (f)
        "A module maker's value that is no procedure, `(define x T e)`, a ref
         `(define n (ref T p) (new e))` among them (C433): its instance's
         state, made when the maker is called."
        (and (head-is? f "define") (i64= (size (items f)) 4) (not (lambda-form? (fourth (items f)))))))

    (define maker-states (subr kfx (sexps) sexps)
      (lambda (forms)
        "A module maker's values, in order, each `(x T e)` (C433)."
        (concat (map (lambda ((f sexp)) (if (maker-state? f) (the sexps (list (lst (cdr (items f)) "" 0 0))) nil)) forms))))

    (define-rec
      (maker-needy (subr kfx (string strings sexps strings) strings)
        (lambda (p states defs needy)
          "The items that take the instance (C434): each whose type names the
           place `p`, or whose lambda names it, a value of the module, or an
           item that takes it; found to a fixed point. The others are plain
           functions, which may be given as values as they are."
          (let ((more (concat (map (lambda ((d sexp))
                                     (let* ((ys (items d)) (n (sym-name (car ys))))
                                       (if (and (not (string-member? n needy))
                                                (or (any? (lambda ((m string)) (or (string=? m p) (string-member? m states))) (names-in (second ys)))
                                                    (any? (lambda ((m string)) (or (string=? m p) (string-member? m states) (string-member? m needy)))
                                                          (names-named-onto (third ys) nil))))
                                           (the strings (list n))
                                           nil)))
                                   defs))))
            (if (null? more) needy (maker-needy p states defs (onto more needy)))))))

    (define-rec
      (maker-placed (subr kfx (string sexps strings) strings)
        (lambda (p forms got)
          "The names of a module maker's abbreviations and effects that name
           its place `p`, or one of these (C437); found to a fixed point."
          (let ((more (concat (map (lambda ((f sexp))
                                     (let ((n (tagcase (second (items f)) (sym (m f2 p2) m) (else other ""))))
                                       (if (and (not (string=? n "")) (not (string-member? n got))
                                                (any? (lambda ((m string)) (or (string=? m p) (string-member? m got))) (names-in (third (items f)))))
                                           (the strings (list n))
                                           nil)))
                                   forms))))
            (if (null? more) got (maker-placed p forms (onto more got)))))))

    (define maker-item-type (subr kfx (string sexp) sexp)
      (lambda (p t)
        "A module maker's item's type, given the maker's place `p` first (C274),
         then its instance's state (C433)."
        (let* ((binder (lst (list (sym p "" 0) (sym "place" "" 0)) "" 0 0))
               (bs (if (head-is? t "poly") (items (second (items t))) nil))
               (s (items (unpoly t))))
          (lst (list (sym "poly" "" 0) (lst (cons binder bs) "" 0 0)
                     (lst (list (car s) (second s)
                                (lst (cons (lst (list (sym "place" "" 0) (sym p "" 0)) "" 0 0) (cons (sym "%maker-state" "" 0) (items (third s)))) "" 0 0)
                                (fourth s)) "" 0 0))
               "" 0 0))))

    (define-rec
      (pg-bound (subr kfx (sexp) string)
        (lambda (b)
          "The name a parameter or binding binds: `x`, `(x T)`."
          (tagcase b (sym (n f p) n) (lst (ys f l p) (if (null? ys) "" (pg-bound (car ys)))) (else other "")))))

    (define pg-relist (subr kfx (sexp sexps) sexp)
      (lambda (e xs) (tagcase e (lst (ys f l p) (lst xs f l p)) (else other (lst xs "" 0 0)))))

    (define pg-without (subr kfx (strings strings) strings)
      (lambda (names bound) (filter (lambda ((n string)) (not (string-member? n bound))) names)))

    (define-rec
      (pg-take (subr kfx (sexps i64) sexps)
        (lambda (xs k) (if (or (null? xs) (i64<= k 0)) nil (cons (car xs) (pg-take (cdr xs) (i64- k 1)))))))

    (define-rec
      (pg-drop (subr kfx (sexps i64) sexps)
        (lambda (xs k) (if (or (null? xs) (i64<= k 0)) xs (pg-drop (cdr xs) (i64- k 1))))))

    (define pg-nth (subr kfx (sexps i64) sexp)
      (lambda (xs k) (car (pg-drop xs k))))

    (define-rec
      (place-given (subr kfx (string strings sexp) sexp)
        (lambda (p names e)
          "`e`, its calls of `names` given the place `p` first (C274), then the
           instance's state (C433); a name a binding form binds there not one
           of them, nor a binding, nor a `cond`'s test, a call (C437)."
          (tagcase e
            (lst (xs f l q)
              (let ((h (tagcase (if (null? xs) e (car xs)) (sym (n f2 p2) n) (else other ""))))
                (cond ((null? xs) e)
                      ((string=? h "quote") e)
                      ((and (or (string=? h "lambda") (string=? h "rlambda")) (i64>= (size xs) 3))
                       (let* ((at (if (string=? h "rlambda") (the i64 2) (the i64 1)))
                              (ps (pg-nth xs at))
                              (inner (pg-without names (map pg-bound (items ps)))))
                         (lst (onto (pg-take xs (i64+ at 1)) (map (lambda ((x sexp)) (place-given p inner x)) (pg-drop xs (i64+ at 1)))) f l q)))
                      ((and (or (string=? h "let") (string=? h "let*") (string=? h "letrec")) (i64>= (size xs) 3)
                            (tagcase (second xs) (lst (bs f3 l3 p3) #t) (else other #f)))
                       (let* ((bs (items (second xs)))
                              (bound (map (lambda ((b sexp)) (pg-bound (car (items b)))) bs))
                              (inner (pg-without names bound))
                              (init-names (if (string=? h "let") names inner)))
                         (lst (cons (car xs)
                                    (cons (pg-relist (second xs)
                                                  (map (lambda ((b sexp))
                                                         (let ((ys (items b)))
                                                           (pg-relist b (cons (car ys) (onto (if (i64= (size ys) 3) (the sexps (list (second ys))) nil)
                                                                                         (the sexps (list (place-given p init-names (last ys)))))))))
                                                       bs))
                                          (map (lambda ((x sexp)) (place-given p inner x)) (cdr (cdr xs)))))
                              f l q)))
                      ((and (string=? h "tagcase") (i64>= (size xs) 2))
                       (lst (cons (car xs)
                                  (cons (place-given p names (second xs))
                                        (map (lambda ((arm sexp))
                                               (tagcase arm
                                                 (lst (ys f4 l4 p4)
                                                   (if (i64< (size ys) 2)
                                                       arm
                                                       (let ((vs (tagcase (second ys) (lst (zs f5 l5 p5) (map pg-bound zs)) (sym (n f5 p5) (the strings (list n))) (else other nil))))
                                                         (pg-relist arm (cons (car ys) (cons (second ys) (map (lambda ((x sexp)) (place-given p (pg-without names vs) x)) (cdr (cdr ys)))))))))
                                                 (else other arm)))
                                             (cdr (cdr xs)))))
                            f l q))
                      ((string=? h "cond")
                       (lst (cons (car xs) (map (lambda ((cl sexp))
                                                  (tagcase cl
                                                    (lst (ys f4 l4 p4) (pg-relist cl (map (lambda ((x sexp)) (place-given p names x)) ys)))
                                                    (else other cl)))
                                                (cdr xs)))
                            f l q))
                      ((string-member? h names)
                       (lst (cons (car xs) (cons (sym p "" 0) (cons (sym "maker-st" "" 0) (map (lambda ((x sexp)) (place-given p names x)) (cdr xs))))) f l q))
                      (else (lst (map (lambda ((x sexp)) (place-given p names x)) xs) f l q)))))
            (else other e)))))

    (define maker-item-lambda (subr kfx (string strings sexp) sexp)
      (lambda (p names lam)
        "A module maker's item's lambda, given the maker's place `p` first, and
         its calls of the maker's items (C274)."
        (let ((ys (items lam)))
          (lst (cons (car ys) (cons (lst (cons (sym p "" 0) (cons (sym "maker-st" "" 0) (items (second ys)))) "" 0 0) (map (lambda ((x sexp)) (place-given p names x)) (cdr (cdr ys))))) "" 0 0))))

    (define-rec
      (sum-tags-of (subr kfx (strings strings) strings)
        (lambda (keys acc)
          "The tags of the sums' keys, each once."
          (cond ((null? keys) acc)
                ((has-prefix? (car keys) "S ")
                 (sum-tags-of (cdr keys) (onto (filter (lambda ((t string)) (not (string-member? t acc))) (split-words (after-prefix (car keys) "S "))) acc)))
                (else (sum-tags-of (cdr keys) acc))))))

    (define put-shapes (subr kfx (ctx sexps bool chars) chars)
      (lambda (c forms shows acc)
        "The program's products, declared; its sums, kayak-rt's one `Sum`, need
         none (C409), but that their tags, and kayak-rt's, hash apart, asserted
         as rustc builds: a collision fails the build, never takes a wrong arm."
        (let* ((keys (program-shapes c forms))
               (tags (reverse-strings (sum-tags-of keys nil) nil))
               (acc (put-shape-decls (filter (lambda ((k string)) (not (has-prefix? k "S "))) keys) shows (uses-blobrefs? c) acc)))
          (if (null? tags)
              acc
              (put "]);\n\n"
                   (put (words-of-sep (map (lambda ((t string)) (string-append "\"" (string-append t "\""))) tags) ", ")
                        (put "const _: () = kayak_rt::tags_apart_from_runtime(&[" acc)))))))

    (define put-show-generatives (subr kfx (sexps chars) chars)
      (lambda (forms acc)
        "In toplevel mode, a module's datatypes' and generative types' `Show`,
         inside it, where their representations are seen."
        (put-show-impls (concat (map (lambda ((f sexp)) (if (or (head-is? f "define-generative") (head-is? f "define-datatype")) (the sexps (list f)) nil)) forms)) acc)))

    (define-rec
      (put-top (subr kfx (ctx sexp chars) chars)
        (lambda (c form acc)
          (let* ((xs (tagcase form (lst (ys f l p) ys) (else other nil)))
                 (h (if (null? xs) "" (tagcase (car xs) (sym (n at-file at-pos) n) (else other "")))))
            (cond ((or (string=? h "define-effect") (string=? h "define-convention")) acc)
                  ((or (string=? h "define-syscall") (string=? h "define-optional-syscall")) (put-syscall c form xs acc))
                  ((or (string=? h "include") (string=? h "%use"))
                   (let* ((n (sym-name (second xs)))
                          (its (module-items c n))
                          (skip (concat (map (lambda ((x sexp)) (if (head-is? x "skip") (map sym-name (cdr (items x))) nil)) (cdr (cdr xs)))))
                          (ex (concat (map (lambda ((x sexp))
                                             (cond ((head-is? x "except") (map sym-name (cdr (items x))))
                                                   ((head-is? x "except-module")
                                                    (let ((b (module-items c (sym-name (second (items x)))))) (onto (item-values b) (item-types b))))
                                                   (else nil)))
                                           (cdr (cdr xs)))))
                          (names (onto (map mangle (concat (map (lambda ((t string)) (if (string-member? t ex) nil (the strings (list t)))) (item-values its))))
                                       (map camel (concat (map (lambda ((t string))
                                                                   ;; An abbreviation of a module's family is no Rust
                                                                   ;; item, expanded where applied (C89, C119).
                                                                   (if (or (string-member? t skip) (string-member? t ex)
                                                                           (not (null? (module-body c (string-append "%expand " t)))))
                                                                       nil
                                                                       (the strings (list t))))
                                                                 (item-types its)))))))
                     (if (null? names)
                         acc
                         (put "};\n\n" (put-sep (lambda ((x string) (acc chars)) (put x acc)) ", " names
                                                 (put "::{" (put (mangle n) (put (if (string=? h "include") "pub use super::" "use super::") acc))))))))
                  ((and (string=? h "define-type")
                        (or (head-is? (third xs) "arrayof")
                            (and (head-is? (third xs) "sumof") (not (null? (cdr (items (third xs)))))
                                 (tagcase (second (items (third xs))) (sym (n f p) #t) (else other #f)))))
                   "A flat array or a keyed flat sum: a layout in a bloblet's suffix
                    (C31, C33), no value's type, and so no Rust type's."
                   acc)
                  ((and (string=? h "define-type") (head-is? (third xs) "moduleof")
                        (tagcase (second xs) (lst (ys f l p) #t) (else other #f)))
                   "A module maker's interface (C274): the maker's struct, written
                    with it."
                   acc)
                  ((and (string=? h "define-type") (head-is? (third xs) "moduleof"))
                   (put-trait c (sym-name (second xs)) (third xs) acc))
                  ((and (string=? h "define-type")
                        (tagcase (second xs)
                          (lst (hs hf hl hp)
                            (any? (lambda ((b sexp)) (tagcase b (lst (bs bf bl bp) (and (i64= (size bs) 2) (sym-is? (second bs) "effect"))) (else other #f))) (cdr hs)))
                          (else other #f)))
                   "An abbreviation over an effect (C46): no Rust alias, since what
                    it stands for in Rust depends on the effect; each use expanded."
                   acc)
                  ((and (string=? h "define-type")
                        (not (null? (module-body c (string-append "%expand " (type-head-name (second xs)))))))
                   "An abbreviation of a module's family: expanded where applied (C89)."
                   acc)
                  ((and (string=? h "define-type") (tagcase (second xs) (lst (ys f l p) #t) (else other #f))
                        (any? (lambda ((k string)) (has-prefix? k "%in ")) (ctx-locals c)))
                   "A module's family: expanded where applied (C89), no Rust alias."
                   acc)
                  ((string=? h "define-type")
                   "A type abbreviation; its regions, Rust lifetimes (C39), as a
                    `letrena`'s are, so that a use of it at one is at its lifetime."
                   (let* ((places (head-place-params (second xs)))
                          (regions (onto (head-region-params (second xs)) places))
                          (inner (with-locals c (onto (map (lambda ((r string)) (string-append "%letrena " r)) regions)
                                                      (map (lambda ((p string)) (string-append "%placeparam " p)) places))))
                          (acc (put "pub type " acc))
                          (acc (put (camel (type-head-name (second xs))) acc))
                          (params (onto (map (lambda ((r string)) (lifetime r)) regions)
                                        (onto (map camel (head-type-params (second xs)))
                                              (map (lambda ((p string)) (string-append "Place_" (camel p)))
                                                   (concat (map (lambda ((p string)) (if (string-member? p (places-used (third xs))) (the strings (list p)) nil)) places))))))
                          (acc (if (null? params) acc (put (string-append "<" (string-append (words-of-sep params ", ") ">")) acc)))
                          (acc (put " = " acc))
                          (acc (put-type inner (third xs) acc)))
                     (put ";\n\n" acc)))
                  ((string=? h "define-datatype") (put-datatype c (cdr xs) acc))
                  ((string=? h "define-generative") (put-generative c (cdr xs) (generative-seal form) (generative-unseal form) acc))
                  ((module-def? form) (put-module c (sym-name (second xs)) (module-noted form) acc))
                  ((and (string=? h "define") (i64= (size xs) 3)
                        (not (null? (ctx-typed c (sym-name (second xs)))))
                        (head-is? (car (ctx-typed c (sym-name (second xs)))) "%reexport"))
                   "A module's poly procedure given on (C107): that procedure, `pub use`d."
                   (let* ((r (items (car (ctx-typed c (sym-name (second xs))))))
                          (y (sym-name (third r)))
                          (x (sym-name (second xs))))
                     (put ";\n\n" (put (if (string=? x y) "" (string-append " as " (mangle x)))
                                       (put (value-path c (sym-name (second r)) y) (put "pub use " acc))))))
                  ((maker-form? c form) (put-maker c xs acc))
                  ((or (string=? h "define") (string=? h "define*"))
                   (if (i64= (size xs) 4)
                       (put-define c (second xs) (third xs) (fourth xs) acc)
                       (put-define c (second xs) (car (ctx-typed c (sym-name (second xs)))) (third xs) acc)))
                  ((string=? h "define-rec") (put-rec c (cdr xs) acc))
                  (else acc)))))

      (put-maker (subr kfx (ctx sexps chars) chars)
        (lambda (c xs acc)
          "A module maker (C274), `(define m (poly ((p place)) (subr E ((place
           p)) (i p))) (lambda (p) (module item ...)))`: in Rust, a `mod m` of
           its items, each a procedure given the place first, as the maker
           is, then the instance's state, their calls of each other given
           them too; the struct `I<'p, Place_P>`, the place and the state,
           whose methods are the items; and `m`, making one. The state (C433):
           the module's refs, `IState`'s fields, each made in the place, in
           order, when the maker is called, its first value's expression able
           to call the items. Each bound to hold what any item makes in the
           place: the maker's `place-needs`."
          (let* ((name (sym-name (second xs)))
                 (typ (third xs))
                 (binders (items (second (items typ))))
                 (lam (fourth xs))
                 (ps (items (second (items lam))))
                 (p (if (and (i64= (size binders) 1) (i64= (size ps) 1))
                        (sym-name (car ps))
                        (error (string-append "kfx: a module maker of other than one place, which KFX writes not yet (C274): " name))))
                 (iface-name (type-head-name (fourth (items (third (items typ))))))
                 (iface (camel iface-name))
                 ;; Its interface's values, the struct's methods.
                 (shown (concat (map (lambda ((it sexp)) (if (head-is? it "val") (the strings (list (sym-name (second (items it))))) nil))
                                     (let ((found (module-body c (string-append "%maker-iface " iface-name)))) (if (null? found) nil (cdr (items (car found))))))))
                 (written (cdr (items (third (items lam)))))
                 ;; Its abbreviations written out where named (C437), not Rust aliases.
                 (abbrevs (filter (lambda ((f sexp)) (and (head-is? f "define-type") (i64= (size (items f)) 3)
                                                          (tagcase (second (items f)) (sym (n f2 p2) #t) (else other #f))))
                                  written))
                 (types (filter (lambda ((f sexp)) (and (maker-type? f) (not (string-member? (show-sexp f) (map show-sexp abbrevs))))) written))
                 ;; Its types, abbreviations and effects (C436), as a top-level module's:
                 ;; its items written where they are known, as `m`'s.
                 (parts (module-parts c name types))
                 (c (with-locals (tagcase parts (mparts (inner forms) inner))
                                 (map (lambda ((f sexp)) (string-append "%maker-abbrev " (string-append (sym-name (second (items f))) (string-append " " (show-sexp (third (items f)))))))
                                      abbrevs)))
                 ;; Each `->*` item at its type as found (C437), which its signature,
                 ;; whether it may fail, and whether it needs the instance, are
                 ;; read from: noted at its lambda, which is rewritten below.
                 (defs (map (lambda ((d sexp))
                              (let* ((ys (items d)) (found (fact-said c (third ys) "def-type "))
                                     ;; A `plambda` of types, its lambda (C437): its Rust a generic
                                     ;; function, its type's binders.
                                     (d (if (head-is? (third ys) "plambda") (lst (list (car ys) (second ys) (third (items (third ys)))) "" 0 0) d))
                                     (ys (items d)))
                                (if (string=? found "")
                                    d
                                    (let ((t (car (read-all found "" 1))))
                                      (lst (list (car ys)
                                                 (if (head-is? (second ys) "poly") (lst (list (car (items (second ys))) (second (items (second ys))) t) "" 0 0) t)
                                                 (third ys))
                                           "" 0 0)))))
                            (maker-defs written)))
                 (states (maker-states written))
                 ;; Its abbreviations and effects that name the place, or another
                 ;; that does (C437): an item whose type names one takes the place.
                 (placed (maker-placed p (filter (lambda ((f sexp)) (or (head-is? f "define-type") (head-is? f "define-effect"))) written) nil))
                 (siblings (maker-needy p (onto placed (map (lambda ((d sexp)) (sym-name (car (items d)))) states)) defs nil))
                 (pt (string-append "Place_" (camel p)))
                 (named (concat-strings (list iface "<" (lifetime p) ", " pt ">")))
                 (state-named (concat-strings (list iface "State<" (lifetime p) ", " pt ">")))
                 ;; The state's struct is in the module, where the types its fields
                 ;; name are (C436).
                 (state-path (concat-strings (list (mangle name) "::" state-named)))
                 (c (with-locals c (cons (string-append "%maker-needs " name) (cons (string-append "%maker-place " p)
                                         (cons (concat-strings (list "%maker-state-type &" (lifetime p) " " state-named))
                                               (onto (map (lambda ((d sexp)) (string-append "%maker-state " (sym-name (car (items d))))) states)
                                                     ;; An item that takes the instance, given as a value: a
                                                     ;; closure over it, of its arity (C434).
                                                     ;; Or, a plain function, one in the async mode (C434).
                                                     (map (lambda ((d sexp))
                                                            (let* ((ys (items d)) (t (unpoly (second ys))))
                                                              (concat-strings (list (if (string-member? (sym-name (car ys)) siblings) "%maker-item " "%maker-plain ")
                                                                                    (sym-name (car ys)) " "
                                                                                    (i64->string (size (items (second (items (unpoly (third ys)))))))
                                                                                    (if (and (head-is? t "subr") (i64= (size (items t)) 4) (fallible-effect? c (second (items t)))) " 1" " 0")))))
                                                          defs)))))))
                 (cp (with-locals c (list (string-append "%letrena " p) (string-append "%placeparam " p))))
                 (body (put-sep (lambda ((d sexp) (acc chars))
                                  (let ((ys (items d)))
                                    (if (string-member? (sym-name (car ys)) siblings)
                                        (put-define c (car ys) (maker-item-type p (second ys)) (maker-item-lambda p siblings (third ys)) acc)
                                        ;; One that takes no instance: as it is, its calls of
                                        ;; those that do given it (C434).
                                        (put-define c (car ys) (second ys) (place-given p siblings (third ys)) acc))))
                                "" defs nil))
                 ;; The state made (C433), in the module, where the items are named:
                 ;; each ref made, in order, its first value's expression able to
                 ;; call the items, which are given the state, its refs so far made.
                 (body (put "pub fn maker_state" (put "\n\n" body)))
                 (body (put-place-generics c name binders nil (list p) body))
                 (body (put (concat-strings (list "(" (mangle p) ": &" (lifetime p) " " pt ") -> &" (lifetime p) " " state-named " {\n"
                                                  "    let maker_st: &" (lifetime p) " " state-named " = kayak_rt::alloc(" iface "State {\n"))
                            body))
                 (body (put-sep (lambda ((d sexp) (acc chars)) (put (concat-strings (list "        " (mangle (sym-name (car (items d)))) ": std::cell::Cell::new(None),\n")) acc))
                                "" states body))
                 (body (put "        phantom_: std::marker::PhantomData,\n    }).to_ref();\n" body))
                 (body (put-sep (lambda ((d sexp) (acc chars))
                                  (let ((ys (items d)))
                                    (put "));\n" (put-exp (with-locals cp (list p "maker-st")) (place-given p siblings (third ys)) 1 (value)
                                                          (put (concat-strings (list "    maker_st." (mangle (sym-name (car ys))) ".set(Some(")) acc)))))
                                "" states body))
                 (body (put "    maker_st\n}" body))
                 ;; Before the items: the module's types, then the state's struct.
                 (head (tagcase parts (mparts (inner forms) (put-tops inner forms nil))))
                 (head (put (concat-strings (list "/// What " name " makes (C274): its module's items, the place given, and its\n"
                                                  "/// values, made as it is made (C433).\n"
                                                  "pub struct " state-named " {\n"))
                            head))
                 (head (put-sep (lambda ((d sexp) (acc chars))
                                  (put ">>,\n" (put-type cp (second (items d)) (put (concat-strings (list "    pub " (mangle (sym-name (car (items d)))) ": std::cell::Cell<Option<")) acc))))
                                "" states head))
                 (head (put (concat-strings (list "    pub phantom_: std::marker::PhantomData<&" (lifetime p) " " pt ">,\n}\n\n")) head))
                 ;; Its `Visit` (C492): each value it holds, once made.
                 (head (put "    }\n}\n\n"
                            (put-sep (lambda ((d sexp) (acc chars))
                                       (put (concat-strings (list "        if let Some(v) = self." (mangle (sym-name (car (items d)))) ".get() {\n            kayak_rt::Trace::trace(v, t);\n        }\n")) acc))
                                     "" states
                                     (put (concat-strings (list "impl<" (lifetime p) ", " pt "> kayak_rt::Visit for " state-named " {\n"
                                                                (if (null? states) "    fn visit<'a>(&'a self, _: &mut kayak_rt::Tracer<'a>) {\n" "    fn visit<'a>(&'a self, t: &mut kayak_rt::Tracer<'a>) {\n")))
                                          head))))
                 (body (onto body head))
                 (acc (put (concat-strings (list "pub struct " named "(pub &" (lifetime p) " " pt ", pub &" (lifetime p) " " state-path ");\n\n"
                                                 "impl<" (lifetime p) ", " pt "> Clone for " named " {\n    fn clone(&self) -> Self {\n        *self\n    }\n}\n\n"
                                                 "impl<" (lifetime p) ", " pt "> Copy for " named " {}\n\n"
                                                 ;; Its `Trace` (C481): two references, the place and the
                                                 ;; state, each visited (C492).
                                                 "impl<" (lifetime p) ", " pt ": kayak_rt::Visit> kayak_rt::Trace for " named " {\n    kayak_rt::trace_whole!();\n"
                                                 "    fn trace<'a>(self, t: &mut kayak_rt::Tracer<'a>) where Self: 'a {\n"
                                                 "        kayak_rt::Trace::trace(self.0, t);\n        kayak_rt::Trace::trace(self.1, t);\n    }\n}\n\n"))
                           acc))
                 (acc (put-module-around c name body acc))
                 (acc (put (string-append " " (string-append named " {\n")) (put-place-generics c name binders nil (list p) (put "impl" acc))))
                 (acc (put-sep (lambda ((d sexp) (acc chars))
                                 (let* ((ys (items d))
                                        (t (unpoly (second ys)))
                                        (params (items (second (items (third ys))))))
                                   (if (or (not (head-is? t "subr")) (not (i64= (size (items t)) 4)) (comefrom-effect? c (second (items t))))
                                       (error (string-append "kfx: a module maker's item suspending, which KFX writes not yet (C274): " (sym-name (car ys))))
                                       ;; In the async mode, `async`, as each item is (C376). One
                                       ;; that fails, a `Result`; one that is `poly`, generic
                                       ;; (C434).
                                       (let* ((async (in-async-mode? c))
                                              (fails (fallible-effect? c (second (items t))))
                                              (acc (put (string-append (if async "    pub async fn " "    pub fn ") (mangle (sym-name (car ys)))) acc))
                                              (acc (if (head-is? (second ys) "poly") (put-generics (items (second (items (second ys)))) #t acc) acc))
                                              (acc (put "(self" acc))
                                              (acc (if (null? params) acc (put-params cp params (items (third (items t))) #f (put ", " acc))))
                                              (acc (if fails
                                                       (put ", Unwind>" (put-type cp (fourth (items t)) (put ") -> Result<" acc)))
                                                       (put-type cp (fourth (items t)) (put ") -> " acc))))
                                              (needy (string-member? (sym-name (car ys)) siblings))
                                              (args (words-of-sep (onto (if needy (the strings (list "self.0" "self.1")) nil)
                                                                        (map (lambda ((x sexp)) (mangle (param-name x))) params))
                                                                  ", "))
                                              (acc (put (concat-strings (list " {\n        " (mangle name) "::" (mangle (sym-name (car ys))) "(" args)) acc)))
                                         (put (if async ").await\n    }\n" ")\n    }\n") acc)))))
                               "\n" (filter (lambda ((d sexp)) (string-member? (sym-name (car (items d))) shown)) defs) acc))
                 (acc (put "}\n\n" acc))
                 (acc (put (string-append (if (in-async-mode? c) "pub async fn " "pub fn ") (mangle name)) acc))
                 (acc (put-place-generics c name binders nil (list p) acc))
                 (acc (put (concat-strings (list "(" (mangle p) ": &" (lifetime p) " " pt ") -> " named " {\n")) acc)))
            (put (concat-strings (list "    " iface "(" (mangle p) ", " (mangle name) "::maker_state(" (mangle p) "))\n}\n\n")) acc))))

      (types-once (subr kfx (ctx sexps strings) sexps)
        (lambda (c forms given)
          "A module's `include`s, each marked with the types one before it gave
           already, which it does not import again (C86: the same type, given by
           two, is one name)."
          (cond ((null? forms) nil)
                ((or (head-is? (car forms) "include") (head-is? (car forms) "%use"))
                 (let* ((xs (items (car forms)))
                        (ts (item-types (module-items c (sym-name (second xs))))))
                   (cons (lst (cons (car xs) (cons (second xs) (cons (lst (cons (sym "skip" "" 0) (map (lambda ((t string)) (sym t "" 0)) given)) "" 0 0) (cdr (cdr xs))))) "" 0 0)
                         (types-once c (cdr forms) (onto ts given)))))
                (else (cons (car forms) (types-once c (cdr forms) given))))))

      (put-module (subr kfx (ctx string sexps chars) chars)
        (lambda (c m written acc)
          "A module, a Rust `mod` (C19): its items as a program's, the program's
           names in scope, its own hiding them."
          (tagcase (module-parts c m written)
            (mparts (inner forms)
              (let* ((body (put-tops inner forms nil))
                     (body (if (string-member? "%toplevel" (ctx-locals c)) (put-show-generatives forms body) body)))
                (put-module-around c m body acc))))))

      (module-parts (subr kfx (ctx string sexps) mparts)
        (lambda (c m written)
          "What a module's items are written in, and the items (C91: shared
           with the emitter that keeps memos, incr.kfx)."
          (let* ((forms (concat (map (lambda ((f sexp))
                                       (if (head-is? f "hide")
                                           (map (lambda ((g sexp))
                                                  (if (head-is? g "include") (lst (cons (sym "%use" "" 0) (cdr (items g))) "" 0 0) g))
                                                (cdr (items f)))
                                           (the sexps (list f))))
                                     written)))
                 (forms (types-once c forms nil))
                 (outer (tagcase c (ctx (ds ts ks ls xs fs fx ms es mods)
                                     ;; An included module's datatypes are this one's by their
                                     ;; names, references as every datatype is (C116: Fixpt's
                                     ;; `convention.fx`, its types included hidden).
                                     (ctx (onto (concat (map (lambda ((f sexp))
                                                               (if (or (head-is? f "include") (head-is? f "%use"))
                                                                   (concat (map (lambda ((g sexp))
                                                                                  (if (head-is? g "define-datatype")
                                                                                      (the strings (list (type-head-name (second (items g)))))
                                                                                      nil))
                                                                                (module-items c (sym-name (second (items f))))))
                                                                   nil))
                                                             forms))
                                                ds)
                                          ;; And their tags first, before any other datatype's of the
                                          ;; same tags, which another load of the same file has (C116:
                                          ;; KFX's tags are found by name, the latest first).
                                          (onto (concat (map (lambda ((f sexp))
                                                               (if (or (head-is? f "include") (head-is? f "%use"))
                                                                   (let ((n (sym-name (second (items f)))))
                                                                     (concat (map (lambda ((g sexp))
                                                                                    (if (head-is? g "define-datatype")
                                                                                        (tags-noted (cdr (cdr (items g)))
                                                                                                   (string-append n (string-append ".." (type-head-name (second (items g)))))
                                                                                                   nil)
                                                                                        nil))
                                                                                  (module-items c n))))
                                                                   nil))
                                                             forms))
                                                ts)
                                          (onto (concat (map (lambda ((f sexp))
                                                               (if (or (head-is? f "include") (head-is? f "%use"))
                                                                   (item-constants (module-items c (sym-name (second (items f)))))
                                                                   nil))
                                                             forms))
                                                (without ks (item-values forms)))
                                          ls xs fs fx ms es mods)))))
            (mparts (with-locals (collect forms outer) (list (string-append "%in " m))) forms))))

      (put-module-around (subr kfx (ctx string chars chars) chars)
        (lambda (c m body acc)
          "A module's `pub mod`, around its items' Rust, `body`, newest first."
          (let* ((acc (put "pub mod " acc))
                 (acc (put (mangle m) acc))
                 (acc (put " {\n    use super::*;\n\n" acc))
                 (acc (if (any? (lambda ((k string)) (string=? (car (split-words k)) m)) (module-impls c))
                          (put "    /// This module, given for a module type (C24).\n    pub struct Module;\n\n" acc)
                          acc)))
            (put "\n}\n\n" (indented (rev-onto (trimmed body) nil) #t acc)))))

      (put-tops (subr kfx (ctx sexps chars) chars)
        (lambda (c forms acc)
          "A string at the top level is a comment. A procedure's documentation is
           a string first in its body, as a Lisp docstring is: see `put-define`."
          (cond ((null? forms) acc)
                ((comment? (car forms))
                 (let* ((doc (and (not (null? (cdr forms))) (definition? (second forms))))
                        (acc (put-comment (string-chars (comment-text (car forms))) "//" 0 #t acc)))
                   (put-tops c (cdr forms) (put (if doc "\n" "\n\n") acc))))
                (else (put-tops c (cdr forms) (put-top c (car forms) acc)))))))

    "Recursion groups (C379): in the async mode, a call is boxed only where
     a cycle of calls may pass, as Rust needs (E0733), and fuel is paid
     there (C378). A scope's procedures, the program's top level or a
     module's body (a maker's too), may call each other with no
     `define-rec` in a module, and a `define-rec`'s members need not all
     recur: the groups are the strongly connected components of the
     scope's graph of direct calls (Kosaraju's two passes). Each procedure
     of a group of more than one, or that calls itself, has the fact `recs
     NAME ...` at its name, its group's names."
    (define rec-facts (subr kfx (ctx sexps) facts)
      (lambda (c forms)
        (concat (map (lambda ((scope sexps)) (scope-rec-facts c scope))
                     (cons forms (module-bodies forms nil))))))

    (define-rec
      (module-bodies (subr kfx (sexps (listof sexps acyclic)) (listof sexps acyclic))
        (lambda (es acc)
          "Onto `acc`, the body of each `module` form in `es`, at any depth."
          (if (null? es)
              acc
              (module-bodies (cdr es)
                (tagcase (car es)
                  (lst (xs f l p)
                    (module-bodies xs (if (head-is? (car es) "module") (cons (cdr xs) acc) acc)))
                  (else other acc)))))))

    (define scope-rec-facts (subr kfx (ctx sexps) facts)
      (lambda (c scope)
        (let* ((defs (concat (map scope-definitions scope)))
               (names (map (lambda ((d sexp)) (sym-name (car (items d)))) defs))
               (graph (map (lambda ((d sexp))
                             (let ((callees (calls-in c (cdr (items d)) nil)))
                               (calling (sym-name (car (items d))) (filter (lambda ((m string)) (string-member? m names)) callees))))
                           defs))
               (groups (sccs graph)))
          (concat (map (lambda ((d sexp))
                         (let* ((n (car (items d)))
                                (group (group-of (sym-name n) groups graph)))
                           (if (null? group) nil (the facts (list (fact (datum-file n) (datum-pos n) (string-append "recs " (words-of group))))))))
                       defs)))))

    (define scope-definitions (subr kfx (sexp) sexps)
      (lambda (f)
        "A scope's form's procedures, each `(name body ...)`: a `define`'s, a
         `define-rec`'s members, those in a `hide`."
        (cond ((head-is? f "hide") (concat (map scope-definitions (cdr (items f)))))
              ((and (or (head-is? f "define") (head-is? f "define*")) (i64>= (size (items f)) 3))
               (tagcase (second (items f))
                 (sym (n nf np) (the sexps (list (lst (cdr (items f)) "" 0 0))))
                 (else other nil)))
              ((head-is? f "define-rec")
               (concat (map (lambda ((b sexp)) (tagcase b (lst (bs bf bl bp) (the sexps (list b))) (else other nil))) (cdr (items f)))))
              (else nil))))

    (define group-of (subr kfx (string (listof strings acyclic) callings) strings)
      (lambda (n groups graph)
        "`n`'s group, if it is more than `n`, or `n` calls itself; else none."
        (let ((found (concat (map (lambda ((g strings)) (if (string-member? n g) (the (listof strings acyclic) (list g)) nil)) groups))))
          (cond ((null? found) nil)
                ((not (null? (cdr (car found)))) (car found))
                ((string-member? n (callees-of n graph)) (car found))
                (else nil)))))

    (define callees-of (subr kfx (string callings) strings)
      (lambda (n graph)
        (let ((found (concat (map (lambda ((x calling)) (tagcase x (calling (m cs) (if (string=? m n) cs nil)))) graph))))
          found)))

    (define sccs (subr kfx (callings) (listof strings acyclic))
      (lambda (graph)
        "The graph's strongly connected components: names in the order a
         depth-first search finishes them, then, latest first, each not yet
         placed with all it reaches in the graph reversed and not yet placed."
        (let* ((order (finish-all graph (map (lambda ((x calling)) (tagcase x (calling (n cs) n))) graph) nil nil))
               (reversed (map (lambda ((x calling))
                                (tagcase x
                                  (calling (n cs)
                                    (calling n (concat (map (lambda ((y calling)) (tagcase y (calling (m ds) (if (string-member? n ds) (the strings (list m)) nil)))) graph))))))
                              graph)))
          (components reversed order nil nil))))

    (define-rec
      (finish-all (subr kfx (callings strings strings strings) strings)
        (lambda (graph todo seen done)
          "`done`, the names finished, latest first, after a search from each
           of `todo` not `seen`."
          (if (null? todo)
              done
              (if (string-member? (car todo) seen)
                  (finish-all graph (cdr todo) seen done)
                  (tagcase (visit graph (car todo) seen done)
                    (visited (seen2 done2) (finish-all graph (cdr todo) seen2 done2)))))))
      (visit (subr kfx (callings string strings strings) visited)
        (lambda (graph n seen done)
          "A search from `n`: what is seen then, and `n` finished after all it reaches."
          (tagcase (visit-each graph (callees-of n graph) (cons n seen) done)
            (visited (seen2 done2) (visited seen2 (cons n done2))))))
      (visit-each (subr kfx (callings strings strings strings) visited)
        (lambda (graph ns seen done)
          (cond ((null? ns) (visited seen done))
                ((string-member? (car ns) seen) (visit-each graph (cdr ns) seen done))
                (else (tagcase (visit graph (car ns) seen done)
                        (visited (seen2 done2) (visit-each graph (cdr ns) seen2 done2))))))))

    (define-rec
      (components (subr kfx (callings strings strings (listof strings acyclic)) (listof strings acyclic))
        (lambda (reversed order placed acc)
          (cond ((null? order) acc)
                ((string-member? (car order) placed) (components reversed (cdr order) placed acc))
                (else (tagcase (visit reversed (car order) placed nil)
                        (visited (placed2 group) (components reversed (cdr order) placed2 (cons group acc)))))))))

    "Leaves (C377): in the async mode, a top-level procedure that calls only
     primitives, constructors and leaves is a plain `fn`: it can wait for
     nothing. Found by the emitter itself: each procedure written once with
     every call of the program's procedures taken as a leaf's; one whose
     Rust awaits nothing is a candidate (calling itself only in a tail call,
     a loop), and the leaves are the least set of candidates whose callees,
     but themselves, are leaves (no recursion but loops, then). A leaf's loop
     is no point to be preempted at: when fuel is charged, a leaf charges it
     and yields to none. Said by facts: `leaf` at its name, `leaf-call` at
     each call of it, `leaf-ref` at each use of it as a value. `main` is not
     one, as its caller awaits it."
    (define leaf-facts (subr kfx (ctx sexps) facts)
      (lambda (c forms)
        (let* ((defs (concat (map leaf-definitions forms)))
               (probed (concat (map (lambda ((d sexp))
                                      (if (leaf-candidate? c d)
                                          ;; Its calls of itself, loops (a call that is no tail call awaits).
                                          (let ((n (sym-name (car (items d)))))
                                            (the callings (list (calling n (without (calls-in c (list (third (items d))) nil) (list n))))))
                                          nil))
                                    defs)))
               (leaves (least-leaves probed nil)))
          (if (null? leaves)
              nil
              (onto (concat (map (lambda ((d sexp))
                                   (let ((n (car (items d))))
                                     (if (string-member? (sym-name n) leaves)
                                         (the facts (list (fact (datum-file n) (datum-pos n) "leaf")))
                                         nil)))
                                 defs))
                    (leaf-uses c leaves forms nil))))))

    (define leaf-definitions (subr kfx (sexp) sexps)
      (lambda (f)
        "A top-level form's procedures, each `(name type lambda group ...)`:
         a `define`'s, of no group; each of a `define-rec`'s, its group the
         names it defines."
        (cond ((and (or (head-is? f "define") (head-is? f "define*")) (i64= (size (items f)) 4))
               (the sexps (list (lst (cdr (items f)) "" 0 0))))
              ((head-is? f "define-rec")
               (let ((group (map (lambda ((b sexp)) (car (items b))) (cdr (items f)))))
                 (map (lambda ((b sexp)) (lst (onto (items b) group) "" 0 0)) (cdr (items f)))))
              (else nil))))

    (define leaf-candidate? (subr kfx (ctx sexp) bool)
      (lambda (c d)
        (let ((xs (items d)))
          (and (i64>= (size xs) 3)
               (tagcase (car xs) (sym (n at-file at-pos) (not (string=? n "main"))) (else other #f))
               (head-is? (unpoly (third xs)) "lambda")
               ;; A module maker is written as one (`put-maker`, C274), not as a
               ;; procedure: no leaf (C433: its values a procedure's writing
               ;; takes not).
               (not (and (i64= (size (items (unpoly (third xs)))) 3) (head-is? (third (items (unpoly (third xs)))) "module")))
               (head-is? (unpoly (second xs)) "subr")
               (not (comefrom-effect? c (second (items (unpoly (second xs))))))
               (let ((written (put-define (with-locals c (list "%probe")) (car xs) (second xs) (third xs) nil)))
                 ;; The Rust newest first, so `.await` backwards.
                 (not (chars-have? written (string-chars "tiawa."))))))))

    (define-rec
      (calls-in (subr kfx (ctx sexps strings) strings)
        (lambda (c es acc)
          "Onto `acc`, the names of the program's procedures `es` calls."
          (if (null? es)
              acc
              (calls-in c (cdr es)
                (tagcase (car es)
                  (lst (xs f l p)
                    (calls-in c xs (if (kfx-call-head? c (car es)) (cons (sym-name (car xs)) acc) acc)))
                  (else other acc)))))))

    (define-rec
      (least-leaves (subr kfx (callings strings) strings)
        (lambda (cs leaves)
          "The candidates `cs` whose callees are all leaves, added to `leaves`
           until none is."
          (let ((more (concat (map (lambda ((x calling))
                                     (tagcase x
                                       (calling (n callees)
                                         (if (and (not (string-member? n leaves))
                                                  (all? (lambda ((m string)) (string-member? m leaves)) callees))
                                             (the strings (list n))
                                             nil))))
                                   cs))))
            (if (null? more) leaves (least-leaves cs (onto more leaves)))))))

    (define-rec
      (names-defined-in (subr kfx (sexps strings) strings)
        (lambda (es acc)
          "Onto `acc`, the names `define`d, at any depth, in `es`."
          (if (null? es)
              acc
              (names-defined-in (cdr es)
                (tagcase (car es)
                  (lst (xs f l p)
                    (names-defined-in xs
                      (cond ((and (or (head-is? (car es) "define") (head-is? (car es) "define*")) (not (null? (cdr xs))))
                             (tagcase (second xs) (sym (n nf np) (cons n acc)) (else other acc)))
                            ((head-is? (car es) "define-rec")
                             (onto (concat (map (lambda ((b sexp)) (tagcase b (lst (bs bf bl bp) (tagcase (car bs) (sym (n nf np) (the strings (list n))) (else other nil))) (else other nil))) (cdr xs))) acc))
                            (else acc))))
                  (else other acc)))))))

    (define-rec
      (leaf-uses (subr kfx (ctx strings sexps facts) facts)
        (lambda (c leaves es acc)
          "Onto `acc`, the facts at each call of a leaf in `es` and each use of
           one as a value."
          (if (null? es)
              acc
              (leaf-uses c leaves (cdr es)
                (tagcase (car es)
                  (lst (xs f l p)
                    ;; In a module, or a maker's, not the leaves its own names hide.
                    (leaf-uses c (if (or (module-def? (car es)) (maker-form? c (car es))) (without leaves (names-defined-in xs nil)) leaves) xs
                               (if (and (kfx-call-head? c (car es)) (string-member? (sym-name (car xs)) leaves))
                                   (cons (fact f p "leaf-call") acc)
                                   acc)))
                  (sym (n f p)
                    (if (and (not (string=? n "")) (not (string=? (fact-said c (car es) "proc-value ") "")) (string-member? n leaves))
                        (cons (fact f p "leaf-ref") acc)
                        acc))
                  (else other acc)))))))

    (define put-toplevel (subr kfx (ctx sexps chars) chars)
      (lambda (c forms acc)
        (let* ((acc (put-show-impls forms acc))
               (acc (put "/// The program's top-level expressions' values, as Fixpt writes them.\npub fn kfx_toplevel() -> Str {\n    let mut out_ = String::new();\n" acc))
               (acc (put-toplevel-lines c forms acc)))
          (put "    kayak_rt::shown(out_)\n}\n" acc))))))
