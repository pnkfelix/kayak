(define built-in-text (subr kfx (string) string)
  (lambda (path)
    "A built-in module's text, by its name; `` for none."
    (cond ((string=? path "fx26:conditions.fx") built-in-0)
          ((string=? path "fx26:arm64-types.fx") built-in-1)
          ((string=? path "fx26:arm64.fx") built-in-2)
          ((string=? path "fx26:convention-types.fx") built-in-3)
          ((string=? path "fx26:convention.fx") built-in-4)
          ((string=? path "fx26:layout.fx") built-in-5)
          ((string=? path "fx26:layout-types.fx") built-in-6)
          ((string=? path "fx26:native-layout.fx") built-in-7)
          (else ""))))
