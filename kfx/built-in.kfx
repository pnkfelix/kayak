"built-in.kfx: the modules Fixpt builds in that KFX has (C107), each
 loaded by its name, `(load-module \"fx26:NAME\")`, its text Fixpt's at
 0c2e4dd. Written by scripts/built-in.py: edit that, not this."

(define built-in-0 string
  ";; Conditions, design B (`docs/research/conditions.md`, `TODO.md` §89): a
;; module file of three procedures, a first library, built in: a program
;; loads it as `(load-module \"fx26:conditions.fx\")`.
;;
;; - `handle`: runs `body` given a tag of a region made for it alone, and
;;   `on-escape` with what an `escape` to the tag carries. `body` is
;;   polymorphic in the region (rank 2), so nothing it gives can name the
;;   region, and the prompt removes the escape's `(goto r)`.
;; - `with-handler`: runs `body` given a key, in a region made for it alone,
;;   whose mark is `handler`.
;; - `raise`: the handler a key's mark holds, called with the condition
;;   where `raise` is, before anything unwinds; its value is `raise`'s. With
;;   no handler, a panic. A handler that escapes to a `handle` outside is a
;;   restart.
(define handle
  (poly ((a type) (h type) (e effect))
    (subr e ((poly ((r region)) (subr (maxeff e (goto r)) ((escape-tag a h r)) a)) (subr e (h) a))
          a))
  (plambda ((a type) (h type) (e effect))
    (lambda (body on-escape)
      (letregion r
        (let ((t ((proj (proj make-escape-tag r) a h))))
          (prompt t ((proj body r) t) on-escape))))))
(define with-handler
  (poly ((c type) (v type) (a type) (e effect) (eh effect))
    (subr (maxeff e eh)
          ((subr eh (c) v)
           (poly ((k region)) (subr (maxeff e eh (read k)) ((mark-key (subr eh (c) v) k)) a)))
          a))
  (plambda ((c type) (v type) (a type) (e effect) (eh effect))
    (lambda (handler body)
      (letregion k
        (let ((key ((proj (proj make-continuation-mark-key k) (subr eh (c) v)))))
          ((proj (proj with-mark k) (subr eh (c) v) a (maxeff e eh (read k)))
           key
           handler
           (lambda () ((proj body k) key))))))))
(define raise
  (poly ((k region)) (poly ((c type) (v type) (eh effect))
    (subr (maxeff (read k) eh) ((mark-key (subr eh (c) v) k) c) v)))
  (plambda ((k region)) (plambda ((c type) (v type) (eh effect))
    (lambda (key condition)
      (((proj (proj first-mark k) (subr eh (c) v))
        key
        (lambda ((x c)) (error \"a condition raised with no handler\")))
       condition)))))
")

(define built-in-1 string
  ";;; The types of `arm64.fx`, and the signature of its module as its
;;; clients use it: a module file of no state, which it loads, and so may
;;; its clients (`TODO.md` §68).

;; What the encoders do: read the encoders, and count down.
(define-effect encodes (maxeff (read @globals) spin))
;; The encoders of two, three and four operands.
(define-type arm-op2 (subr encodes (int int) int))
(define-type arm-op3 (subr encodes (int int int) int))
(define-type arm-op4 (subr encodes (int int int int) int))
;; Instructions, in order.
(define-type arm-code (listof int @k))

;;; ------------------------------------------------------------ signatures

;; What `native.fx` uses of the encoders (`TODO.md` §68).
(define-type arm64-sig
  (moduleof (val arm-ldr-post arm-op3)
            (val arm-str-post arm-op3)
            (val arm-str-pre arm-op3)
            (val arm-ldur arm-op3)
            (val arm-stur arm-op3)
            (val arm-ldr arm-op3)
            (val arm-str arm-op3)
            (val arm-ldr-reg arm-op3)
            (val arm-stp-pre arm-op4)
            (val arm-ldp-post arm-op4)
            (val arm-stp arm-op4)
            (val arm-ldp arm-op4)
            (val arm-add-imm arm-op3)
            (val arm-sub-imm arm-op3)
            (val arm-subs-imm arm-op3)
            (val arm-cmp-imm arm-op2)
            (val arm-add arm-op3)
            (val arm-sub arm-op3)
            (val arm-adds arm-op3)
            (val arm-subs arm-op3)
            (val arm-orr arm-op3)
            (val arm-cmp arm-op2)
            (val arm-mov arm-op2)
            (val arm-and-low arm-op3)
            (val arm-tst-low arm-op2)
            (val arm-ubfx arm-op4)
            (val arm-asr-imm arm-op3)
            (val arm-lsr-imm arm-op3)
            (val arm-strb arm-op2)
            (val arm-csel arm-op4)
            (val arm-movz arm-op3)
            (val arm-mov-imm64 (subr (maxeff (alloc @k) (read @globals) spin) (int int) arm-code))
            (val arm-b (subr (maxeff (read @globals) spin) (int) int))
            (val arm-b-cond arm-op2)
            (val arm-cbz arm-op2)
            (val arm-cbnz arm-op2)
            (val arm-br (subr (maxeff (read @globals) spin) (int) int))
            (val arm-blr (subr (maxeff (read @globals) spin) (int) int))))
")

(define built-in-2 string
  ";;; An arm64 encoder, in FX-26 (PLAN.md §11, step 11b): the instructions the
;;; native machine uses, each a function to its 32-bit word, exactly as
;;; `fixpt-native/src/arm64.rs` encodes them. That encoder is this one's
;;; oracle (`tests/arm64.rs` in this crate), as the system assembler is
;;; that one's.
;;;
;;; FX-26 has no bitwise operations and needs none here: an instruction is
;;; fields that do not overlap, so shifting is multiplying by a power of
;;; two and combining is adding. A signed field is masked by `modulo`,
;;; which is never negative for a positive divisor. What does not fit gives
;;; -1, which no instruction is: the encoders are pure, and whoever places
;;; the code checks.

;; Registers are 0–30; 31 is sp or xzr, as the instruction takes it.
;; Conditions: eq 0, ne 1, hs 2, lo 3, vs 6, vc 7, hi 8, ls 9, ge 10,
;; lt 11, gt 12, le 13.

;; A file of one expression (`load-input`, `TODO.md` §68): the module, of no
;; state and given nothing, which the conductor gives `native.fx`. Its types
;; (`arm64-types.fx`) are loaded around it, so that they are not among its
;; values; the module names what it uses of them.
(let ((arm64-types (load-module \"fx26:arm64-types.fx\")))
  (module
(hide (include arm64-types))

;; 2 to the `n`, `n` ≥ 0: a shift (in line natively), not `n` doublings.
(define arm-pow2 (->* (int) int)
  (lambda (n) (arithmetic-shift 1 n)))

;; `v` as a `bits`-bit two's-complement field, or -1 if it does not fit.
(define arm-simm (->* (int int) int)
  (lambda (v bits)
    (let ((half (arm-pow2 (- bits 1))))
      (if (or (< v (- 0 half)) (>= v half)) -1 (modulo v (* 2 half))))))

;; Fields at their places: each is -1 if it did not fit, and so the sum.
(define arm-f (->* (int int) int)
  (lambda (v shift) (if (< v 0) -1 (arithmetic-shift v shift))))
(define arm-sum (->* (int int) int)
  (lambda (a b) (if (or (< a 0) (< b 0)) -1 (+ a b))))
(define arm-sum3 (->* (int int int) int)
  (lambda (a b c) (arm-sum a (arm-sum b c))))
(define arm-sum4 (->* (int int int int) int)
  (lambda (a b c d) (arm-sum a (arm-sum3 b c d))))
(define arm-reg (->* (int) int)
  (lambda (x) (if (and (>= x 0) (<= x 31)) x -1)))
;; `v` if `ok`, else -1.
(define arm-check (->* (bool int) int)
  (lambda (ok v) (if ok v -1)))
;; Whether lo ≤ v < hi.
(define arm-in? (->* (int int int) bool)
  (lambda (v lo hi) (and (>= v lo) (< v hi))))
;; Register `x` at `shift`, and `v` as a `bits`-bit signed field at `shift`.
(define arm-reg-at (->* (int int) int)
  (lambda (x shift) (arm-f (arm-reg x) shift)))
(define arm-simm-at (->* (int int int) int)
  (lambda (v bits shift) (arm-f (arm-simm v bits) shift)))
;; op | field | n << 5 | t: an instruction on registers `n` and `t` (or
;; `d`), `field` its other operands at their places.
(define arm-n-t (->* (int int int int) int)
  (lambda (op field n t) (arm-sum4 op field (arm-reg-at n 5) (arm-reg t))))

;;; ------------------------------------------------------ loads, stores

;; op | simm9 << 12 | n << 5 | t: the unscaled and indexed forms.
(define arm-mem9 (->* (int int int int) int)
  (lambda (op t n imm) (arm-n-t op (arm-simm-at imm 9 12) n t)))
(define arm-ldr-post arm-op3 (lambda (t n imm) (arm-mem9 #xF8400400 t n imm)))
(define arm-ldr-pre arm-op3 (lambda (t n imm) (arm-mem9 #xF8400C00 t n imm)))
(define arm-str-post arm-op3 (lambda (t n imm) (arm-mem9 #xF8000400 t n imm)))
(define arm-str-pre arm-op3 (lambda (t n imm) (arm-mem9 #xF8000C00 t n imm)))
(define arm-ldur arm-op3 (lambda (t n imm) (arm-mem9 #xF8400000 t n imm)))
(define arm-stur arm-op3 (lambda (t n imm) (arm-mem9 #xF8000000 t n imm)))

;; `ldr`/`str xt, [xn, #off]`, `off` a multiple of 8 below 32768.
(define arm-mem12 (->* (int int int int) int)
  (lambda (op t n off)
    (arm-check (and (= (modulo off 8) 0) (>= off 0) (< off 32768))
               (arm-n-t op (arm-f (quotient off 8) 10) n t))))
(define arm-ldr arm-op3 (lambda (t n off) (arm-mem12 #xF9400000 t n off)))
(define arm-str arm-op3 (lambda (t n off) (arm-mem12 #xF9000000 t n off)))

(define arm-ldr-lit arm-op2
  (lambda (t words) (arm-sum3 #x58000000 (arm-simm-at words 19 5) (arm-reg t))))
(define arm-ldr-reg arm-op3
  (lambda (t n m) (arm-n-t #xF8606800 (arm-reg-at m 16) n t)))

;; The pairs: op | simm7(imm / 8) << 15 | t2 << 10 | n << 5 | t.
(define arm-pair (->* (int int int int int) int)
  (lambda (op t t2 n imm)
    (let ((offset (arm-simm-at (quotient imm 8) 7 15)))
      (arm-check (= (modulo imm 8) 0)
                 (arm-n-t op (arm-sum offset (arm-reg-at t2 10)) n t)))))
(define arm-stp-pre arm-op4 (lambda (t t2 n imm) (arm-pair #xA9800000 t t2 n imm)))
(define arm-ldp-post arm-op4 (lambda (t t2 n imm) (arm-pair #xA8C00000 t t2 n imm)))
(define arm-stp arm-op4 (lambda (t t2 n imm) (arm-pair #xA9000000 t t2 n imm)))
(define arm-ldp arm-op4 (lambda (t t2 n imm) (arm-pair #xA9400000 t t2 n imm)))

;;; ------------------------------------------------------ arithmetic

;; op | imm12 << 10 | n << 5 | d.
(define arm-imm12 (->* (int int int int) int)
  (lambda (op d n imm)
    (arm-check (arm-in? imm 0 4096) (arm-n-t op (arm-f imm 10) n d))))
(define arm-add-imm arm-op3 (lambda (d n imm) (arm-imm12 #x91000000 d n imm)))
(define arm-sub-imm arm-op3 (lambda (d n imm) (arm-imm12 #xD1000000 d n imm)))
(define arm-subs-imm arm-op3 (lambda (d n imm) (arm-imm12 #xF1000000 d n imm)))
(define arm-cmp-imm arm-op2 (lambda (n imm) (arm-imm12 #xF1000000 31 n imm)))

;; op | m << 16 | n << 5 | d.
(define arm-reg3 (->* (int int int int) int)
  (lambda (op d n m) (arm-n-t op (arm-reg-at m 16) n d)))
(define arm-add arm-op3 (lambda (d n m) (arm-reg3 #x8B000000 d n m)))
(define arm-sub arm-op3 (lambda (d n m) (arm-reg3 #xCB000000 d n m)))
(define arm-adds arm-op3 (lambda (d n m) (arm-reg3 #xAB000000 d n m)))
(define arm-subs arm-op3 (lambda (d n m) (arm-reg3 #xEB000000 d n m)))
(define arm-orr arm-op3 (lambda (d n m) (arm-reg3 #xAA000000 d n m)))
(define arm-cmp arm-op2 (lambda (n m) (arm-reg3 #xEB000000 31 n m)))
(define arm-mov arm-op2 (lambda (d m) (arm-reg3 #xAA000000 d 31 m)))

;; The low `bits` bits: 1 ≤ bits < 64. The mask's field is its width less
;; one at 10.
(define arm-low-mask (->* (int) int)
  (lambda (bits) (arm-check (arm-in? bits 1 64) (arm-f (- bits 1) 10))))
(define arm-and-low arm-op3
  (lambda (d n bits) (arm-n-t #x92400000 (arm-low-mask bits) n d)))
(define arm-tst-low arm-op2
  (lambda (n bits) (arm-sum3 #xF240001F (arm-low-mask bits) (arm-reg-at n 5))))
(define arm-ubfx arm-op4
  (lambda (d n lsb width)
    (let ((immr (arm-f lsb 16))
          (imms (arm-f (- (+ lsb width) 1) 10)))
      (arm-check (and (< lsb 64) (>= width 1) (<= (+ lsb width) 64))
                 (arm-n-t #xD3400000 (arm-sum immr imms) n d)))))
;; A shift by `s`, 0 ≤ s < 64.
(define arm-shift-imm (->* (int int int int) int)
  (lambda (op d n s) (arm-check (arm-in? s 0 64) (arm-n-t op (arm-f s 16) n d))))
(define arm-asr-imm arm-op3 (lambda (d n s) (arm-shift-imm #x9340FC00 d n s)))
(define arm-lsr-imm arm-op3 (lambda (d n s) (arm-shift-imm #xD340FC00 d n s)))
;; `strb wt, [xn]`.
(define arm-strb arm-op2 (lambda (t n) (arm-sum3 #x39000000 (arm-reg-at n 5) (arm-reg t))))
(define arm-csel arm-op4
  (lambda (d n m c) (arm-n-t #x9A800000 (arm-sum (arm-reg-at m 16) (arm-f c 12)) n d)))

;; `movz`/`movk xd, #imm16, lsl #(16 hw)`.
(define arm-mov16 (->* (int int int int) int)
  (lambda (op d imm16 hw)
    (arm-check (and (>= imm16 0) (< imm16 65536) (>= hw 0) (< hw 4))
               (arm-sum4 op (arm-f hw 21) (arm-f imm16 5) (arm-reg d)))))
(define arm-movz arm-op3 (lambda (d imm16 hw) (arm-mov16 #xD2800000 d imm16 hw)))
(define arm-movk arm-op3 (lambda (d imm16 hw) (arm-mov16 #xF2800000 d imm16 hw)))
;; Any non-negative 64-bit constant below 2^60 (a fixnum's range): `movz`,
;; then a `movk` for each other nonzero 16 bits, low to high.
(define arm-mov-imm64 (->* (int int) arm-code)
  (lambda (d v)
    (letrec ((ks (subr (maxeff (read @globals) (alloc @k) spin) (int int) arm-code)
                (lambda (hw rest)
                  (if (= hw 4)
                      nil
                      (let ((part (modulo (quotient rest 65536) 65536)))
                        (if (= part 0)
                            (ks (+ hw 1) (quotient rest 65536))
                            (cons (arm-movk d part hw) (ks (+ hw 1) (quotient rest 65536)))))))))
      (the arm-code (cons (arm-movz d (modulo v 65536) 0) (ks 1 v))))))

;;; ------------------------------------------------------ control

(define arm-b (->* (int) int) (lambda (words) (arm-sum #x14000000 (arm-simm words 26))))
(define arm-bl (->* (int) int) (lambda (words) (arm-sum #x94000000 (arm-simm words 26))))
(define arm-b-cond arm-op2
  (lambda (c words) (arm-sum3 #x54000000 (arm-simm-at words 19 5) c)))
(define arm-cbz arm-op2
  (lambda (t words) (arm-sum3 #xB4000000 (arm-simm-at words 19 5) (arm-reg t))))
(define arm-cbnz arm-op2
  (lambda (t words) (arm-sum3 #xB5000000 (arm-simm-at words 19 5) (arm-reg t))))
(define arm-br (->* (int) int) (lambda (n) (arm-sum #xD61F0000 (arm-reg-at n 5))))
(define arm-blr (->* (int) int) (lambda (n) (arm-sum #xD63F0000 (arm-reg-at n 5))))
(define arm-ret int #xD65F03C0)))
")

(define built-in-3 string
  ";;; The types of `x86_64.fx`, and the signature of its module as its
;;; clients use it: a module file of no state, which it loads, and so may
;;; its clients (`TODO.md` §68).

;; What the encoders do: read the encoders, make their bytes (reading the
;; ones they join), and count down.
(define-effect x86-encodes (maxeff (alloc @k) (read @k) (read @globals) spin))
;; An instruction's bytes, in order.
(define-type x86-bytes (listof int @k))
;; The encoders of none to six operands.
(define-type x86-op0 (subr x86-encodes () x86-bytes))
(define-type x86-op1 (subr x86-encodes (int) x86-bytes))
(define-type x86-op2 (subr x86-encodes (int int) x86-bytes))
(define-type x86-op3 (subr x86-encodes (int int int) x86-bytes))
(define-type x86-op4 (subr x86-encodes (int int int int) x86-bytes))
(define-type x86-op5 (subr x86-encodes (int int int int int) x86-bytes))
(define-type x86-op6 (subr x86-encodes (int int int int int int) x86-bytes))

;;; ------------------------------------------------------------ signatures

;; What `native-x64.fx` and `native-x64-regs.fx` use of the encoders
;; (`TODO.md` §68).
(define-type x86-64-sig
  (moduleof (val x86-mov x86-op2)
            (val x86-load x86-op3)
            (val x86-load-ix x86-op5)
            (val x86-store x86-op3)
            (val x86-lea x86-op3)
            (val x86-lea-ix x86-op5)
            (val x86-mov-imm x86-op2)
            (val x86-alu x86-op3)
            (val x86-alu-imm x86-op3)
            (val x86-alu-rm x86-op4)
            (val x86-alu-mi x86-op4)
            (val x86-test x86-op2)
            (val x86-test-imm x86-op2)
            (val x86-cmov x86-op3)
            (val x86-cmov-m x86-op4)
            (val x86-shift-imm x86-op3)
            (val x86-jmp x86-op1)
            (val x86-jcc x86-op2)
            (val x86-jmp-r x86-op1)
            (val x86-jmp-m x86-op4)
            (val x86-call-m x86-op2)
            (val x86-store8-imm x86-op5)
            (val x86-call-m-ix x86-op4)
            (val x86-call x86-op1)
            (val x86-ret x86-op0)
            (val x86-push x86-op1)
            (val x86-pop x86-op1)
            (val x86-push-m x86-op2)
            (val x86-pop-m x86-op2)
            (val x86-neg x86-op1)
            (val x86-neg-m x86-op2)
            (val x86-imul x86-op2)
            (val x86-idiv x86-op1)
            (val x86-cqo x86-op0)
            (val x86-movzx8 x86-op2)
            (val x86-load32-ix x86-op5)
            (val x86-shift-cl x86-op2)
            (val x86-nops x86-op1)
            (val x86-load-rip x86-op2)
            (val x86-lea-rip x86-op2)
            (val x86-store-ix x86-op5)
            (val x86-store-imm x86-op5)
            (val x86-store32-ix x86-op5)
            (val x86-load32s-ix x86-op5)
            (val x86-load8-ix x86-op5)
            (val x86-load16-ix x86-op5)
            (val x86-store8-ix x86-op5)
            (val x86-store16-ix x86-op5)
            (val x86-div x86-op1)
            (val x86-not x86-op1)
            (val x86-call-r x86-op1)
            (val x86-movq-to-xmm x86-op2)
            (val x86-movq-from-xmm x86-op2)
            (val x86-movd-to-xmm x86-op2)
            (val x86-movd-from-xmm x86-op2)
            (val x86-fop x86-op4)
            (val x86-ucomis x86-op3)
            (val x86-cvtsi2sd x86-op2)
            (val x86-cvttsd2si x86-op2)
            (val x86-round x86-op4)))
")

(define built-in-4 string
  ";;; An x86_64 encoder, in FX-26: the instructions the x86_64 machine's
;;; compiled words use, each a function to its bytes, exactly as
;;; `fixpt-native/src/x86_64.rs` encodes them. That encoder is this one's
;;; oracle (`tests/x86_64.rs` in this crate), as the system assembler is
;;; that one's; `arm64.fx` is the same for arm64.
;;;
;;; As there, no bitwise operations: a byte of fields is their sum, each
;;; multiplied to its place, and a register's high bit, which goes in a
;;; REX prefix, is its quotient by 8. Every operation is on 64 bits unless
;;; its name says otherwise. A memory operand is a base, an index (-1 for
;;; none), a scale and a displacement.

;; Registers are 0–15 as the hardware numbers them: rax 0, rcx 1, rdx 2,
;; rbx 3, rsp 4, rbp 5, rsi 6, rdi 7, r8 to r15 8 to 15.
;; Conditions: o 0, no 1, b 2, ae 3, e 4, ne 5, be 6, a 7, s 8, ns 9,
;; l 12, ge 13, le 14, g 15.
;; Arithmetic, as `x86-alu` takes it: add 0, or 1, and 4, sub 5, xor 6,
;; cmp 7. Shifts: shl 4, shr 5, sar 7.

;; A file of one expression (`load-input`, `TODO.md` §68): the module, of no
;; state and given nothing, which the conductor gives `native-x64.fx`.
(let ((x86-64-types (load-module \"fx26:x86_64-types.fx\")))
  (module
(hide (include x86-64-types))

;; Bytes of one and two, as lists of the encoders' region.
(define x86-b1 (subr x86-encodes (int) x86-bytes) (lambda (a) (cons a nil)))
(define x86-b2 (subr x86-encodes (int int) x86-bytes)
  ;; cons-chain: in `@k`, the encoders' region, which `list` would not be
  (lambda (a b) (cons a (cons b nil))))

;; A register's high bit, for a REX prefix, and its low three, for the rest.
(define x86-hi (subr pure (int) int) (lambda (r) (quotient r 8)))
(define x86-lo (subr pure (int) int) (lambda (r) (modulo r 8)))

;; The `n` bytes of `v` modulo 256^n, lowest first.
(define x86-le (subr x86-encodes (int int) x86-bytes)
  (lambda (n v)
    (if (= n 0) nil (cons (modulo v 256) (x86-le (- n 1) (quotient (modulo v 4294967296) 256))))))
;; Eight of them: two halves of four, as `x86-le` keeps four at most.
(define x86-le8 (subr x86-encodes (int) x86-bytes)
  (lambda (v)
    (let ((u (modulo v 18446744073709551616)))
      (append (x86-le 4 (modulo u 4294967296)) (x86-le 4 (quotient u 4294967296))))))

;; Whether `v` fits a signed byte.
(define x86-i8? (subr pure (int) bool) (lambda (v) (and (>= v -128) (< v 128))))

;; A REX prefix: `w` 1 for 64 bits, and the high bits of ModRM's `reg`
;; field, the SIB index and ModRM's `rm` (or SIB base); none when nothing
;; needs one.
(define x86-rex (subr x86-encodes (int int int int) x86-bytes)
  (lambda (w r x b)
    (let ((v (+ (+ 64 (* 8 w)) (+ (* 4 (x86-hi r)) (+ (* 2 (x86-hi x)) (x86-hi b))))))
      (if (= v 64) nil (x86-b1 v)))))

;; A SIB byte's scale field: 1, 2, 4 or 8 as 0 to 3.
(define x86-scale-bits (subr pure (int) int)
  (lambda (scale) (cond ((= scale 8) 3) ((= scale 4) 2) ((= scale 2) 1) (else 0))))

;; ModRM, SIB and displacement for `[base + index * scale + disp]`, with
;; `field` in ModRM's `reg`. rbp and r13 as a base with no displacement
;; mean something else, so they take a zero byte of one; rsp and r12 as a
;; base need a SIB byte, as does an index.
(define x86-modrm-mem (subr x86-encodes (int int int int int) x86-bytes)
  (lambda (field base index scale disp)
    (let* ((b3 (x86-lo base))
           (md (cond ((and (= disp 0) (not (= b3 5))) 0) ((x86-i8? disp) 1) (else 2)))
           (head (if (and (< index 0) (not (= b3 4)))
                     (x86-b1 (+ (+ (* 64 md) (* 8 (x86-lo field))) b3))
                     (x86-b2 (+ (+ (* 64 md) (* 8 (x86-lo field))) 4)
                           (+ (+ (* 64 (x86-scale-bits scale))
                                 (* 8 (if (< index 0) 4 (x86-lo index))))
                              b3)))))
      (append head (cond ((= md 1) (x86-le 1 disp)) ((= md 2) (x86-le 4 disp)) (else nil))))))

;; An instruction on two registers: REX, opcode, ModRM with `field` in its
;; `reg` and `rm` in its `rm`.
(define x86-op-rr (subr x86-encodes (int x86-bytes int int) x86-bytes)
  (lambda (w op field rm)
    (append (x86-rex w field 0 rm)
            (append op (x86-b1 (+ (+ 192 (* 8 (x86-lo field))) (x86-lo rm)))))))
;; The same with a memory operand in `rm`.
(define x86-op-rm (subr x86-encodes (int x86-bytes int int int int int) x86-bytes)
  (lambda (w op field base index scale disp)
    (append (x86-rex w field (if (< index 0) 0 index) base)
            (append op (x86-modrm-mem field base index scale disp)))))

;;; ------------------------------------------------------------ moves

(define x86-mov x86-op2 (lambda (d s) (x86-op-rr 1 (x86-b1 137) s d)))
(define x86-load x86-op3 (lambda (d base disp) (x86-op-rm 1 (x86-b1 139) d base -1 1 disp)))
(define x86-load-ix x86-op5
  (lambda (d base index scale disp) (x86-op-rm 1 (x86-b1 139) d base index scale disp)))
(define x86-store x86-op3 (lambda (base disp s) (x86-op-rm 1 (x86-b1 137) s base -1 1 disp)))
(define x86-lea x86-op3 (lambda (d base disp) (x86-op-rm 1 (x86-b1 141) d base -1 1 disp)))
(define x86-lea-ix x86-op5
  (lambda (d base index scale disp) (x86-op-rm 1 (x86-b1 141) d base index scale disp)))
;; `mov d, imm` in as few bytes as do it: 32 bits zero-extended, 32 bits
;; sign-extended, or all 64 (`movabs`). `imm` is the value as a signed or
;; an unsigned integer, either.
(define x86-mov-imm x86-op2
  (lambda (d imm)
    (cond ((and (>= imm 0) (< imm 4294967296))
           (append (x86-rex 0 0 0 d) (cons (+ 184 (x86-lo d)) (x86-le 4 imm))))
          ((and (>= imm -2147483648) (< imm 2147483648))
           (append (x86-op-rr 1 (x86-b1 199) 0 d) (x86-le 4 imm)))
          (else (append (x86-rex 1 0 0 d) (cons (+ 184 (x86-lo d)) (x86-le8 imm)))))))
(define x86-cmov x86-op3 (lambda (c d s) (x86-op-rr 1 (x86-b2 15 (+ 64 c)) d s)))
(define x86-cmov-m x86-op4
  (lambda (c d base disp) (x86-op-rm 1 (x86-b2 15 (+ 64 c)) d base -1 1 disp)))

;;; ------------------------------------------------------------ arithmetic

(define x86-alu x86-op3 (lambda (op d s) (x86-op-rr 1 (x86-b1 (+ (* 8 op) 1)) s d)))
;; `op d, imm`, sign-extended: a byte of it when it fits one, and the short
;; form for rax otherwise, as the assembler chooses.
(define x86-alu-imm x86-op3
  (lambda (op d imm)
    (cond ((x86-i8? imm) (append (x86-op-rr 1 (x86-b1 131) op d) (x86-le 1 imm)))
          ((= d 0) (cons 72 (cons (+ (* 8 op) 5) (x86-le 4 imm))))
          (else (append (x86-op-rr 1 (x86-b1 129) op d) (x86-le 4 imm))))))
(define x86-alu-rm x86-op4
  (lambda (op d base disp) (x86-op-rm 1 (x86-b1 (+ (* 8 op) 3)) d base -1 1 disp)))
(define x86-alu-mi x86-op4
  (lambda (op base disp imm)
    (if (x86-i8? imm)
        (append (x86-op-rm 1 (x86-b1 131) op base -1 1 disp) (x86-le 1 imm))
        (append (x86-op-rm 1 (x86-b1 129) op base -1 1 disp) (x86-le 4 imm)))))
(define x86-test x86-op2 (lambda (a b) (x86-op-rr 1 (x86-b1 133) b a)))
;; `test a32, imm`: the low 32 bits.
(define x86-test-imm x86-op2
  (lambda (a imm)
    (if (= a 0)
        (cons 169 (x86-le 4 imm))
        (append (x86-op-rr 0 (x86-b1 247) 0 a) (x86-le 4 imm)))))
(define x86-shift-imm x86-op3
  (lambda (op d imm)
    (if (= imm 1)
        (x86-op-rr 1 (x86-b1 209) op d)
        (append (x86-op-rr 1 (x86-b1 193) op d) (x86-b1 imm)))))

;;; ------------------------------------------------------------ control

;; Jumps by `rel` from the end of the instruction.
(define x86-jmp x86-op1 (lambda (rel) (cons 233 (x86-le 4 rel))))
(define x86-jcc x86-op2 (lambda (c rel) (cons 15 (cons (+ 128 c) (x86-le 4 rel)))))
(define x86-jmp-r x86-op1 (lambda (s) (x86-op-rr 0 (x86-b1 255) 4 s)))
(define x86-jmp-m x86-op4
  (lambda (base index scale disp) (x86-op-rm 0 (x86-b1 255) 4 base index scale disp)))
(define x86-call-m x86-op2 (lambda (base disp) (x86-op-rm 0 (x86-b1 255) 2 base -1 1 disp)))
;; `mov byte [mem], imm`.
(define x86-store8-imm x86-op5
  (lambda (base index scale disp imm)
    (append (x86-op-rm 0 (x86-b1 198) 0 base index scale disp) (x86-b1 imm))))
(define x86-call-m-ix x86-op4
  (lambda (base index scale disp) (x86-op-rm 0 (x86-b1 255) 2 base index scale disp)))
(define x86-call x86-op1 (lambda (rel) (cons 232 (x86-le 4 rel))))
(define x86-ret x86-op0 (lambda () (x86-b1 195)))

;;; ------------------------------------------------------------ register code's
;;; What register code (`native-x64-regs.fx`) uses besides: the machine
;;; stack, multiplying and dividing, narrow loads, shifts by `cl`, no-ops.

(define x86-push x86-op1
  (lambda (s) (append (x86-rex 0 0 0 s) (x86-b1 (+ 80 (x86-lo s))))))
(define x86-pop x86-op1
  (lambda (d) (append (x86-rex 0 0 0 d) (x86-b1 (+ 88 (x86-lo d))))))
(define x86-push-m x86-op2 (lambda (base disp) (x86-op-rm 0 (x86-b1 255) 6 base -1 1 disp)))
(define x86-pop-m x86-op2 (lambda (base disp) (x86-op-rm 0 (x86-b1 143) 0 base -1 1 disp)))
(define x86-neg x86-op1 (lambda (d) (x86-op-rr 1 (x86-b1 247) 3 d)))
(define x86-neg-m x86-op2 (lambda (base disp) (x86-op-rm 1 (x86-b1 247) 3 base -1 1 disp)))
(define x86-imul x86-op2 (lambda (d s) (x86-op-rr 1 (x86-b2 15 175) d s)))
(define x86-idiv x86-op1 (lambda (s) (x86-op-rr 1 (x86-b1 247) 7 s)))
(define x86-cqo x86-op0 (lambda () (x86-b2 72 153)))
;; `movzx d32, s8`: a REX prefix for s of 4 to 7 too, so that it names
;; `spl` … `dil`, not `ah` … `bh`.
(define x86-movzx8 x86-op2
  (lambda (d s)
    (append (if (or (>= d 8) (>= s 4)) (x86-b1 (+ 64 (+ (* 4 (x86-hi d)) (x86-hi s)))) nil)
            (cons 15 (cons 182 (x86-b1 (+ (+ 192 (* 8 (x86-lo d))) (x86-lo s))))))))
;; `mov d32, [mem]`: 32 bits, zero-extended.
(define x86-load32-ix x86-op5
  (lambda (d base index scale disp) (x86-op-rm 0 (x86-b1 139) d base index scale disp)))
(define x86-shift-cl x86-op2 (lambda (op d) (x86-op-rr 1 (x86-b1 211) op d)))
;; The no-op of `n` bytes, 1 to 9, as the manuals recommend them.
(define x86-nop x86-op1
  (lambda (n)
    (case n
      ((1) (x86-b1 144))
      ((2) (x86-b2 102 144))
      ((3) (cons 15 (x86-b2 31 0)))
      ((4) (cons 15 (cons 31 (x86-b2 64 0))))
      ((5) (cons 15 (cons 31 (cons 68 (x86-b2 0 0)))))
      ((6) (cons 102 (cons 15 (cons 31 (cons 68 (x86-b2 0 0))))))
      ((7) (cons 15 (cons 31 (cons 128 (x86-le 4 0)))))
      ((8) (cons 15 (cons 31 (cons 132 (cons 0 (x86-le 4 0))))))
      (else (cons 102 (cons 15 (cons 31 (cons 132 (cons 0 (x86-le 4 0))))))))))
;; No-ops of `n` bytes more after `acc`, nine at most each.
(define x86-nops-after (subr x86-encodes (int x86-bytes) x86-bytes)
  (lambda (n acc)
    (cond ((= n 0) acc)
          ((> n 9) (x86-nops-after (- n 9) (append acc (x86-nop 9))))
          (else (append acc (x86-nop n))))))
(define x86-nops x86-op1 (lambda (n) (x86-nops-after n nil)))
;;; ------------------------------------------------------------ the native convention's
;;; What the native convention's compiler (`native-direct-x64.fx`) uses
;;; besides: `rip`-relative operands, narrower and indexed memory, `div`,
;;; `not`, `call` of a register, and scalar floating point (SSE). Flags of
;;; one bit (`double`) are 1 or 0.

;; `[rip + disp]` in ModRM's `rm`, `disp` from the instruction's end.
(define x86-op-rip (subr x86-encodes (int x86-bytes int int) x86-bytes)
  (lambda (w op field disp)
    (append (x86-rex w field 0 0)
            (append op (cons (+ (* 8 (x86-lo field)) 5) (x86-le 4 disp))))))
(define x86-load-rip x86-op2 (lambda (d disp) (x86-op-rip 1 (x86-b1 139) d disp)))
(define x86-lea-rip x86-op2 (lambda (d disp) (x86-op-rip 1 (x86-b1 141) d disp)))
(define x86-store-ix x86-op5
  (lambda (base index scale disp s) (x86-op-rm 1 (x86-b1 137) s base index scale disp)))
;; `mov qword [mem], imm`, sign-extended.
(define x86-store-imm x86-op5
  (lambda (base index scale disp imm)
    (append (x86-op-rm 1 (x86-b1 199) 0 base index scale disp) (x86-le 4 imm))))
(define x86-store32-ix x86-op5
  (lambda (base index scale disp s) (x86-op-rm 0 (x86-b1 137) s base index scale disp)))
;; `movsxd d, dword [mem]`.
(define x86-load32s-ix x86-op5
  (lambda (d base index scale disp) (x86-op-rm 1 (x86-b1 99) d base index scale disp)))
;; `movzx d, byte [mem]`, and of a word.
(define x86-load8-ix x86-op5
  (lambda (d base index scale disp) (x86-op-rm 0 (x86-b2 15 182) d base index scale disp)))
(define x86-load16-ix x86-op5
  (lambda (d base index scale disp) (x86-op-rm 0 (x86-b2 15 183) d base index scale disp)))
;; `mov byte [mem], s8`: a REX prefix for `spl` … `dil` too.
(define x86-store8-ix x86-op5
  (lambda (base index scale disp s)
    (let ((v (+ 64 (+ (* 4 (x86-hi s))
                      (+ (* 2 (x86-hi (if (< index 0) 0 index))) (x86-hi base))))))
      (append (if (or (not (= v 64)) (and (>= s 4) (< s 8))) (x86-b1 v) nil)
              (cons 136 (x86-modrm-mem s base index scale disp))))))
(define x86-store16-ix x86-op5
  (lambda (base index scale disp s)
    (cons 102 (x86-op-rm 0 (x86-b1 137) s base index scale disp))))
(define x86-div x86-op1 (lambda (s) (x86-op-rr 1 (x86-b1 247) 6 s)))
(define x86-not x86-op1 (lambda (d) (x86-op-rr 1 (x86-b1 247) 2 d)))
(define x86-call-r x86-op1 (lambda (s) (x86-op-rr 0 (x86-b1 255) 2 s)))
;; An SSE instruction on two registers: `prefix` (0 for none), REX, 0F and
;; `op`, `field` in ModRM's `reg`, `rm` in its `rm`.
(define x86-sse (subr x86-encodes (int int x86-bytes int int) x86-bytes)
  (lambda (prefix w op field rm)
    (append (if (= prefix 0) nil (x86-b1 prefix))
            (append (x86-rex w field 0 rm)
                    (cons 15 (append op (x86-b1 (+ (+ 192 (* 8 (x86-lo field))) (x86-lo rm)))))))))
(define x86-movq-to-xmm x86-op2 (lambda (x r) (x86-sse 102 1 (x86-b1 110) x r)))
(define x86-movq-from-xmm x86-op2 (lambda (r x) (x86-sse 102 1 (x86-b1 126) x r)))
(define x86-movd-to-xmm x86-op2 (lambda (x r) (x86-sse 102 0 (x86-b1 110) x r)))
(define x86-movd-from-xmm x86-op2 (lambda (r x) (x86-sse 102 0 (x86-b1 126) x r)))
;; `{op}sd d, s` (`double`) or `{op}ss`; `op` sqrt 81, add 88, mul 89,
;; sub 92, div 94.
(define x86-fop x86-op4
  (lambda (double op d s) (x86-sse (if (= double 1) 242 243) 0 (x86-b1 op) d s)))
(define x86-ucomis x86-op3
  (lambda (double a b) (x86-sse (if (= double 1) 102 0) 0 (x86-b1 46) a b)))
(define x86-cvtsi2sd x86-op2 (lambda (x r) (x86-sse 242 1 (x86-b1 42) x r)))
(define x86-cvttsd2si x86-op2 (lambda (r x) (x86-sse 242 1 (x86-b1 44) r x)))
;; `roundsd d, s, mode` (`double`) or `roundss` (SSE4.1).
(define x86-round x86-op4
  (lambda (double d s mode)
    (append (x86-sse 102 0 (x86-b2 58 (if (= double 1) 11 10)) d s) (x86-b1 mode))))
))
")

(define built-in-5 string
  ";;; The types of `convention.fx`: a native convention as data a generator
;;; reads (`TODO.md` §97, `docs/research/declared-conventions.md`, step 6).
;;; A place is a register's number: arm64's `x0` 0 to `x30` 30, `sp` 31;
;;; x86_64's as the hardware numbers them, `rax` 0 to `r15` 15 (`rsp` 4);
;;; or, where a machine keeps it in the state, `cv-in-state` (4096) plus
;;; the offset of the state's field; or -2, `pushed`, a return address on
;;; the stack's top. An offset in the state is in bytes from the state's
;;; register; a frame's are from the frame's register. A module file of no
;;; state, which `convention.fx` loads, and so may its clients, to name the
;;; types.

;; A text read: a name, an integer, or a list of them.
(define-datatype cv-sx (cx-name string) (cx-int int) (cx-list (listof cv-sx acyclic)))
(define-type cv-sxs (listof cv-sx acyclic))
;; What reading does: read the module's procedures, and count down.
(define-effect cvr (maxeff (read @globals) spin))
;; A text read from a place in a string, and the place after it.
(define-type cv-at (productof (x cv-sx) (at int)))
(define-type cv-sxs-at (productof (xs cv-sxs) (at int)))

;; Names and their numbers, in the declaration's order: tags, immediates,
;; kinds, a trap's kinds.
(define-type cv-names (listof (productof (name string) (number int)) acyclic))
(define-type cv-ints (listof int acyclic))
(define-type cv-strs (listof string acyclic))
;; Roles and their places: a routine's inputs.
(define-type cv-regs (listof (productof (name string) (registers cv-ints)) acyclic))

(define-type cv-registers
  (productof (arguments cv-ints) (rest-in int) (count int) (result int) (closure int)
             (link int) (frame int)
             ;; Pinned (or in the state, x86_64's but `state`): never
             ;; changed by code, but fuel as `cv-fuel` says.
             (state int) (fuel int) (stack-limit int) (code-distance int)))

;; A header's field: its first bit and its width.
(define-type cv-bits (listof (productof (name string) (at int) (width int)) acyclic))
(define-type cv-values
  (productof (tags cv-names) (fixnum-shift int) (fixnum-bits int) (immediates cv-names)
             (char-subtag int) (char-payload-shift int)
             ;; A pair's fields, from its reference.
             (car int) (cdr int)
             ;; A bloblet's reference: its suffix plus this, the tag; field
             ;; `k` is `8k` + this before the suffix.
             (bloblet-past-suffix int) (field-k-before-suffix int)
             (header cv-bits) (kinds cv-names)))

;; `code-field` is the code bloblet's. With `code-always-runs` (the clause
;; `(code-always-runs)`, `docs/research/code-stubs.md`), its code runs,
;; native code or a stub that enters `foreign`. Else it is native code when
;; at or past the state's field at `native-when-code-at-least`, and the
;; callee is called through `foreign` when it is not: a test that holds
;; still where the code always runs, so that field is the state's
;; `code-lo` then, for a generator written before.
(define-type cv-closures
  (productof (kind int) (code-field int) (first-free-field int)
             (native-when-code-at-least int) (code-always-runs bool)))

;; A code bloblet's code runs at its reference plus the code distance's
;; register; field `k` is `8k` + this before its first instruction.
(define-type cv-code (productof (field-k-before-code int)))

;; A frame, from its register: its header, link, return, stack map and
;; first value slot. A map's bit `k` below `live-below` is value slot `k`
;; live; above `fields-above`, the count of the frame's fields; negative,
;; every value live. `stub` is a stub's frame's size.
(define-type cv-frames
  (productof (align int) (header int) (link int) (return int) (map int) (values-from int)
             (live-below int) (fields-above int) (stub int)))

;; The state's fields that code reads or writes, by offset; `reg4` is
;; x86_64's REG4, REG5 … REG8 the four words after it, 0 where a machine
;; has none (arm64, whose are registers).
(define-type cv-state
  (productof (fuel int) (reserve int) (trap int) (pc int) (args int) (nargs int) (aux int)
             (callout int) (rust-sp int) (native-sp int) (fp int) (top int) (words int)
             (alloc-limit int) (code int) (clo int) (delta int) (code-lo int) (trap-stub int)
             (foreign int) (closure int) (cards int) (stack-limit int) (overflow int) (poll int)
             (cons int) (bloblet int) (reg4 int)))

;; A routine: its entry's offset in the state, called by `blr` (by `call`
;; on x86_64); its inputs, each a role and its places; its output's place,
;; -1 for none; whether it may collect.
(define-type cv-routine
  (productof (entry int) (in cv-regs) (out int) (may-collect bool)))
;; `overflow`, when `sp` is below the stack's limit once a frame is made:
;; its entry called with the return in `x30` (pushed, on x86_64), the code
;; bloblet in
;; `code`, in `info` the arguments held (`held-width` bits from `held-at`),
;; whether the closure was read and whether the procedure is variadic (bits
;; `closure-read`, `variadic`). It keeps the registers in `keeps`.
(define-type cv-overflow
  (productof (entry int) (code int) (info int) (held-at int) (held-width int)
             (closure-read int) (variadic int) (keeps cv-ints)))
;; `trap`: its kind in `kind`, each kind's number and name.
(define-type cv-trap (productof (entry int) (kind int) (kinds cv-names)))
(define-type cv-routines
  (productof (foreign cv-routine) (overflow cv-overflow) (poll cv-routine) (cons cv-routine)
             (bloblet cv-routine) (trap cv-trap)))

;; Fuel: in the place `register`, less `subtract` on entry and on a back
;; edge; below zero, a call of `poll`.
(define-type cv-fuel (productof (register int) (subtract int)))
;; A store of a value marks `mark` at the card table (at `cards` in the
;; state) plus the address shifted right by `card-shift`.
(define-type cv-barrier (productof (cards int) (card-shift int) (mark int)))

(define-type convention
  (productof (target string) (registers cv-registers) (values cv-values)
             (closures cv-closures) (code cv-code) (frames cv-frames) (state cv-state)
             (routines cv-routines) (fuel cv-fuel) (barrier cv-barrier)))

;; How a convention names its places, as printed: x86_64's or arm64's
;; registers, and the state's fields, each its name and offset.
(define-type cv-nm (productof (x86 bool) (sn cv-names)))

;; A declaration read: the convention, or why not.
(define-type cv-read (sumof (ok convention) (refused string)))
")

(define built-in-6 string
  ";;; A native convention as data a generator reads (`TODO.md` §97,
;;; `docs/research/declared-conventions.md`, step 6): a declaration's
;;; clauses, as `native-convention` gives them (canonical: atoms apart by one
;;; space, integers in decimal), read into a `convention`
;;; (`convention-types.fx`), whose registers, offsets and routines' entries a
;;; generator takes rather than numbers copied out of fixpt. So a generator
;;; is parametric in the convention it is given.
;;;
;;; Reading is total: what a clause does not say reads as 0, or -1 for a
;;; register. Then the convention is printed back, and a declaration it does
;;; not print back to, clause for clause, is refused, naming the first such
;;; clause: one a `convention` cannot hold, or misread, is never handed on.
;;; The rules a declaration states besides its numbers (nothing kept across
;;; a call but the pinned registers, the map stored before every call, …)
;;; are what a `convention` means, and are printed as they are.

;; A file of one expression (`load-input`): the module, of no state and
;; given nothing. Its types (`convention-types.fx`) are loaded around it, so
;; that they are not among its values.
(let ((convention-types (load-module \"fx26:convention-types.fx\")))
  (module
(hide (include convention-types))

;;; ------------------------------------------------------------ reading

;; The character at `i` of `t`, as a string.
(define cv-ch (->* (string int) string) (lambda (t i) (substring t i (+ i 1))))
;; Where the atom from `i` of `t` ends: at a space, a parenthesis or the end.
(define cv-atom-end (->* (string int) int)
  (lambda (t i)
    (if (or (>= i (string-length t)) (string=? (cv-ch t i) \" \") (string=? (cv-ch t i) \"(\")
            (string=? (cv-ch t i) \")\"))
        i
        (cv-atom-end t (+ i 1)))))
;; The decimal digits of `s` from `i`, after `acc`; -1 if one is no digit.
(define cv-digits (->* (string int int) int)
  (lambda (s i acc)
    (cond ((= i (string-length s)) acc)
          ((char-numeric? (string-ref s i))
           (cv-digits s (+ i 1) (+ (* acc 10) (- (char->integer (string-ref s i)) 48))))
          (else -1))))
;; An atom: an integer, in decimal, perhaps negative; else a name.
(define cv-atom (->* (string) cv-sx)
  (lambda (a)
    (let* ((neg (and (> (string-length a) 1) (string=? (substring a 0 1) \"-\")))
           (n (if (= (string-length a) 0) -1 (cv-digits a (if neg 1 0) 0))))
      (cond ((< n 0) (cx-name a))
            (neg (cx-int (- 0 n)))
            (else (cx-int n))))))
(define-rec
  ;; What is at `i` of `t`, and where it ends.
  (cv-read-at (->* (string int) cv-at)
    (lambda (t i)
      (cond ((>= i (string-length t)) (product (x (cx-list nil)) (at i)))
            ((string=? (cv-ch t i) \"(\")
             (let ((r (cv-read-items t (+ i 1))))
               (product (x (cx-list (extract r xs))) (at (extract r at)))))
            (else (let ((e (cv-atom-end t i)))
                    (product (x (cv-atom (substring t i e))) (at e)))))))
  ;; The items from `i` of `t` to the `)` that ends them, and the place past it.
  (cv-read-items (->* (string int) cv-sxs-at)
    (lambda (t i)
      (cond ((>= i (string-length t)) (product (xs nil) (at i)))
            ((string=? (cv-ch t i) \")\") (product (xs nil) (at (+ i 1))))
            ((string=? (cv-ch t i) \" \") (cv-read-items t (+ i 1)))
            (else (let* ((r (cv-read-at t i)) (rest (cv-read-items t (extract r at))))
                    (product (xs (the cv-sxs (cons (extract r x) (extract rest xs))))
                             (at (extract rest at)))))))))

;;; ------------------------------------------------------------ looking up

;; A list's items; none of anything else.
(define cx-items (->* (cv-sx) cv-sxs)
  (lambda (x) (tagcase x (cx-list (xs) xs) (else y nil))))
;; A name, or \"\".
(define cx-name-of (->* (cv-sx) string)
  (lambda (x) (tagcase x (cx-name (n) n) (else y \"\"))))
;; An integer, or 0.
(define cx-int-of (->* (cv-sx) int)
  (lambda (x) (tagcase x (cx-int (n) n) (else y 0))))
;; A clause's role: the name it begins with.
(define cx-role (->* (cv-sx) string)
  (lambda (x) (let ((xs (cx-items x))) (if (null? xs) \"\" (cx-name-of (car xs))))))
;; What follows `role` in the first of `xs` that is `(role …)`; none if none is.
(define cx-get (->* (cv-sxs string) cv-sxs)
  (lambda (xs role)
    (cond ((null? xs) nil)
          ((string=? (cx-role (car xs)) role) (cdr (cx-items (car xs))))
          (else (cx-get (cdr xs) role)))))
;; Whether one of `xs` is `(role …)`.
(define cx-has? (->* (cv-sxs string) bool)
  (lambda (xs role)
    (cond ((null? xs) #f) ((string=? (cx-role (car xs)) role) #t) (else (cx-has? (cdr xs) role)))))
;; The `k`th of `xs`, from 0; an empty list past the end.
(define cx-nth (->* (cv-sxs int) cv-sx)
  (lambda (xs k)
    (cond ((null? xs) (cx-list nil)) ((= k 0) (car xs)) (else (cx-nth (cdr xs) (- k 1))))))
;; In `xs`, `(role n …)`'s `n`; `(role a n …)`'s.
(define cx-int-at (->* (cv-sxs string) int)
  (lambda (xs role) (cx-int-of (cx-nth (cx-get xs role) 0))))
(define cx-int2-at (->* (cv-sxs string) int)
  (lambda (xs role) (cx-int-of (cx-nth (cx-get xs role) 1))))
;; Where a place in the state starts (`convention-types.fx`).
(define cv-in-state int 4096)
;; x86_64's registers, as the hardware numbers them.
(define cv-x86-regs (->* () cv-strs)
  (lambda ()
    (list \"rax\" \"rcx\" \"rdx\" \"rbx\" \"rsp\" \"rbp\" \"rsi\" \"rdi\" \"r8\" \"r9\" \"r10\" \"r11\" \"r12\" \"r13\"
          \"r14\" \"r15\")))
;; Where `n` is in `ns`, from `k`; -1 if it is not.
(define cv-index (->* (cv-strs string int) int)
  (lambda (ns n k)
    (cond ((null? ns) -1) ((string=? (car ns) n) k) (else (cv-index (cdr ns) n (+ k 1))))))
;; A place (`convention-types.fx`): `xN` N, `sp` 31, x86_64's by number,
;; `(state field)` past `cv-in-state` by the field's offset in `st`,
;; `pushed` -2; -1 for anything else.
(define cx-reg (->* (cv-sxs cv-sx) int)
  (lambda (st x)
    (let ((n (cx-name-of x)))
      (cond ((string=? (cx-role x) \"state\")
             (+ cv-in-state (cx-int-at st (cx-name-of (cx-nth (cx-items x) 1)))))
            ((string=? n \"sp\") 31)
            ((string=? n \"pushed\") -2)
            ((and (> (string-length n) 1) (string=? (substring n 0 1) \"x\")) (cv-digits n 1 0))
            (else (cv-index (cv-x86-regs) n 0))))))
(define cx-reg-at (->* (cv-sxs cv-sxs string) int)
  (lambda (st xs role) (cx-reg st (cx-nth (cx-get xs role) 0))))
(define cx-regs (->* (cv-sxs cv-sxs) cv-ints)
  (lambda (st xs)
    (if (null? xs) nil (the cv-ints (cons (cx-reg st (car xs)) (cx-regs st (cdr xs)))))))
;; `((name n) …)`, each name and its number; `((n name) …)`, a trap's kinds.
(define cx-names (->* (cv-sxs) cv-names)
  (lambda (xs)
    (if (null? xs)
        nil
        (let ((i (cx-items (car xs))))
          (the cv-names
               (cons (product (name (cx-name-of (cx-nth i 0))) (number (cx-int-of (cx-nth i 1))))
                              (cx-names (cdr xs))))))))
(define cx-numbered (->* (cv-sxs) cv-names)
  (lambda (xs)
    (if (null? xs)
        nil
        (let ((i (cx-items (car xs))))
          (the cv-names
               (cons (product (name (cx-name-of (cx-nth i 1))) (number (cx-int-of (cx-nth i 0))))
                              (cx-numbered (cdr xs))))))))
;; `((name at width) …)`: a header's fields.
(define cx-bits (->* (cv-sxs) cv-bits)
  (lambda (xs)
    (if (null? xs)
        nil
        (let ((i (cx-items (car xs))))
          (the cv-bits (cons (product (name (cx-name-of (cx-nth i 0))) (at (cx-int-of (cx-nth i 1)))
                                      (width (cx-int-of (cx-nth i 2))))
                             (cx-bits (cdr xs))))))))
;; `((role place …) …)`: a routine's inputs.
(define cx-in (->* (cv-sxs cv-sxs) cv-regs)
  (lambda (st xs)
    (if (null? xs)
        nil
        (let ((i (cx-items (car xs))))
          (the cv-regs (cons (product (name (cx-name-of (car i))) (registers (cx-regs st (cdr i))))
                             (cx-in st (cdr xs))))))))
;; The first of `xs` that is `(role …)`; an empty list if none is.
(define cx-find (->* (cv-sxs string) cv-sx)
  (lambda (xs role)
    (cond ((null? xs) (cx-list nil))
          ((string=? (cx-role (car xs)) role) (car xs))
          (else (cx-find (cdr xs) role)))))
;; The offset of the state's field that `(role state field …)` in `xs` names.
(define cx-state-at (->* (cv-sxs string cv-sxs) int)
  (lambda (xs role st) (cx-int-at st (cx-name-of (cx-nth (cx-get xs role) 1)))))

;;; ------------------------------------------------------------ the clauses

(define cv-registers-of (->* (cv-sxs cv-sxs) cv-registers)
  (lambda (rg st)
    (let ((pin (cx-get rg \"pinned\"))
          (at (lambda ((xs cv-sxs) (role string)) (cx-reg-at st xs role))))
      (product (arguments (cx-regs st (cx-get rg \"arguments\"))) (rest-in (at rg \"rest-in\"))
               (count (at rg \"count\")) (result (at rg \"result\"))
               (closure (at rg \"closure\")) (link (at rg \"link\"))
               (frame (at rg \"frame\")) (state (at pin \"state\"))
               (fuel (at pin \"fuel\")) (stack-limit (at pin \"stack-limit\"))
               (code-distance (at pin \"code-distance\"))))))
(define cv-values-of (->* (cv-sxs) cv-values)
  (lambda (vs)
    (let ((fx (cx-get vs \"fixnum\")) (ch (cx-get vs \"character\")) (pr (cx-get vs \"pair\"))
          (bl (cx-get vs \"bloblet\")))
      (product (tags (cx-names (cx-get vs \"tags\"))) (fixnum-shift (cx-int-at fx \"shift\"))
               (fixnum-bits (cx-int-at fx \"bits\")) (immediates (cx-names (cx-get vs \"immediates\")))
               (char-subtag (cx-int-at ch \"subtag\"))
               (char-payload-shift (cx-int-at ch \"payload-shift\"))
               (car (cx-int-at pr \"car\")) (cdr (cx-int-at pr \"cdr\"))
               (bloblet-past-suffix (cx-int2-at bl \"reference\"))
               (field-k-before-suffix (cx-int-at bl \"field-k-before-suffix\"))
               (header (cx-bits (cx-get vs \"header\"))) (kinds (cx-names (cx-get vs \"kinds\")))))))
(define cv-closures-of (->* (cv-sxs cv-sxs) cv-closures)
  (lambda (cl st)
    (product (kind (cx-int-at cl \"kind\")) (code-field (cx-int-at cl \"code-field\"))
             (first-free-field (cx-int-at cl \"first-free-field\"))
             (native-when-code-at-least
              (if (cx-has? cl \"code-always-runs\")
                  (cx-int-at st \"code-lo\")
                  (cx-int-at st
                             (cx-name-of (cx-nth (cx-get cl \"native-when-code-at-least\") 0)))))
             (code-always-runs (cx-has? cl \"code-always-runs\")))))
(define cv-frames-of (->* (cv-sxs) cv-frames)
  (lambda (fr)
    (let ((m (cx-get fr \"map\")))
      (product (align (cx-int-at fr \"align\")) (header (cx-int2-at fr \"header\"))
               (link (cx-int2-at fr \"link\")) (return (cx-int2-at fr \"return\"))
               (map (cx-int-of (cx-nth m 1))) (values-from (cx-int2-at fr \"values-from\"))
               (live-below (cx-int-at m \"live-slots-below\"))
               (fields-above (cx-int-at m \"fields-above\"))
               (stub (cx-int-at fr \"stub\"))))))
(define cv-state-of (->* (cv-sxs) cv-state)
  (lambda (st)
    (let ((at (lambda ((n string)) (cx-int-at st n))))
      (product (fuel (at \"fuel\")) (reserve (at \"reserve\")) (trap (at \"trap\")) (pc (at \"pc\"))
               (args (at \"args\")) (nargs (at \"nargs\")) (aux (at \"aux\")) (callout (at \"callout\"))
               (rust-sp (at \"rust-sp\")) (native-sp (at \"native-sp\")) (fp (at \"fp\")) (top (at \"top\"))
               (words (at \"words\")) (alloc-limit (at \"alloc-limit\")) (code (at \"code\"))
               (clo (at \"clo\"))
               (delta (at \"delta\")) (code-lo (at \"code-lo\")) (trap-stub (at \"trap-stub\"))
               (foreign (at \"foreign\")) (closure (at \"closure\")) (cards (at \"cards\"))
               (stack-limit (at \"stack-limit\")) (overflow (at \"overflow\")) (poll (at \"poll\"))
               (cons (at \"cons\")) (bloblet (at \"bloblet\")) (reg4 (at \"reg4\"))))))
(define cv-routine-of (->* (cv-sxs cv-sxs) cv-routine)
  (lambda (r st)
    (product (entry (cx-state-at r \"entry\" st)) (in (cx-in st (cx-get r \"in\")))
             (out (if (cx-has? r \"out\") (cx-reg-at st r \"out\") -1))
             (may-collect (cx-has? r \"may-collect\")))))
(define cv-overflow-of (->* (cv-sxs cv-sxs) cv-overflow)
  (lambda (o st)
    (let* ((in (cx-get o \"in\")) (info (cx-get in \"info\")) (held (cx-get info \"arguments-held\")))
      (product (entry (cx-state-at o \"entry\" st)) (code (cx-reg-at st in \"code\"))
               (info (cx-reg st (cx-nth info 0))) (held-at (cx-int-of (cx-nth held 0)))
               (held-width (cx-int-of (cx-nth held 1)))
               (closure-read (cx-int-at info \"closure-read\"))
               (variadic (cx-int-at info \"variadic\")) (keeps (cx-regs st (cx-get o \"keeps\")))))))
(define cv-routines-of (->* (cv-sxs cv-sxs) cv-routines)
  (lambda (rt st)
    (let ((t (cx-get rt \"trap\")))
      (product (foreign (cv-routine-of (cx-get rt \"foreign\") st))
               (overflow (cv-overflow-of (cx-get rt \"overflow\") st))
               (poll (cv-routine-of (cx-get rt \"poll\") st))
               (cons (cv-routine-of (cx-get rt \"cons\") st))
               (bloblet (cv-routine-of (cx-get rt \"bloblet\") st))
               (trap (product (entry (cx-state-at t \"entry\" st))
                              (kind (cx-reg-at st (cx-get t \"in\") \"kind\"))
                              (kinds (cx-numbered (cx-get t \"kinds\")))))))))
;; A declaration's clauses, read.
(define cv-of (->* (cv-sxs) convention)
  (lambda (cs)
    (let ((st (cx-get cs \"state\")) (fu (cx-get cs \"fuel\")) (ba (cx-get cs \"barrier\")))
      (product (target (cx-name-of (cx-nth (cx-get cs \"target\") 0)))
               (registers (cv-registers-of (cx-get cs \"registers\") st))
               (values (cv-values-of (cx-get cs \"values\")))
               (closures (cv-closures-of (cx-get cs \"closures\") st))
               (code (product (field-k-before-code (cx-int-at (cx-get cs \"code\")
                                                              \"field-k-before-code\"))))
               (frames (cv-frames-of (cx-get cs \"frames\"))) (state (cv-state-of st))
               (routines (cv-routines-of (cx-get cs \"routines\") st))
               ;; In a register, or, x86_64's, in the state.
               (fuel (product (register (if (cx-has? fu \"register\")
                                            (cx-reg-at st fu \"register\")
                                            (cx-reg st (cx-find fu \"state\"))))
                              (subtract (cx-int-at fu \"subtract\"))))
               (barrier (product (cards (cx-state-at ba \"cards\" st))
                                 (card-shift (cx-int-at ba \"card-shift\"))
                                 (mark (cx-int-at ba \"mark\"))))))))

;;; ------------------------------------------------------------ printing

;; `xs` apart by one space.
(define cv-cat (->* (cv-strs) string)
  (lambda (xs)
    (cond ((null? xs) \"\")
          ((null? (cdr xs)) (car xs))
          (else (string-append (car xs) \" \" (cv-cat (cdr xs)))))))
;; `(role part …)`; `(role n)`.
(define cv-par (->* (string cv-strs) string)
  (lambda (role parts) (string-append \"(\" (cv-cat (the cv-strs (cons role parts))) \")\")))
(define cv-kv (->* (string int) string)
  (lambda (role n) (cv-par role (list (int->string n)))))
;; The `k`th of `ns`, from 0; \"\" past the end.
(define cv-str-at (->* (cv-strs int) string)
  (lambda (ns k) (cond ((null? ns) \"\") ((= k 0) (car ns)) (else (cv-str-at (cdr ns) (- k 1))))))
;; The name of the field at `k` in `ns`; \"\" if none is.
(define cv-name-at (->* (cv-names int) string)
  (lambda (ns k)
    (cond ((null? ns) \"\")
          ((= (extract (car ns) number) k) (extract (car ns) name))
          (else (cv-name-at (cdr ns) k)))))
;; A place, as `nm` names it.
(define cv-reg (->* (cv-nm int) string)
  (lambda (nm r)
    (cond ((>= r cv-in-state)
           (cv-par \"state\" (list (cv-name-at (extract nm sn) (- r cv-in-state)))))
          ((= r -2) \"pushed\")
          ((extract nm x86) (cv-str-at (cv-x86-regs) r))
          ((= r 31) \"sp\")
          (else (string-append \"x\" (int->string r))))))
;; The stack's register.
(define cv-sp (->* (cv-nm) string) (lambda (nm) (cv-reg nm (if (extract nm x86) 4 31))))
(define cv-pr-regs (->* (cv-nm cv-ints) cv-strs)
  (lambda (nm rs)
    (if (null? rs) nil (the cv-strs (cons (cv-reg nm (car rs)) (cv-pr-regs nm (cdr rs)))))))
(define cv-pr-names (->* (cv-names) cv-strs)
  (lambda (ns)
    (if (null? ns)
        nil
        (the cv-strs
             (cons (cv-kv (extract (car ns) name) (extract (car ns) number))
                   (cv-pr-names (cdr ns)))))))
(define cv-pr-numbered (->* (cv-names) cv-strs)
  (lambda (ns)
    (if (null? ns)
        nil
        (the cv-strs
             (cons (cv-par (int->string (extract (car ns) number)) (list (extract (car ns) name)))
                           (cv-pr-numbered (cdr ns)))))))
;; x86_64's REG4 … REG`k`, REG4 at `at`, before `acc`; none if `at` is 0.
(define cv-reg-names (->* (int int cv-names) cv-names)
  (lambda (at k acc)
    (if (or (= at 0) (< k 4))
        acc
        (cv-reg-names at (- k 1)
                      (the cv-names
                           (cons (product (name (string-append \"reg\" (int->string k)))
                                          (number (+ at (* 8 (- k 4)))))
                                 acc))))))
;; The state's fields, each its name and offset, in the declaration's order.
(define cv-state-names (->* (cv-state) cv-names)
  (lambda (s)
    (let ((f (lambda ((n string) (k int)) (product (name n) (number k)))))
      (append
       (list (f \"fuel\" (extract s fuel)) (f \"reserve\" (extract s reserve))
             (f \"trap\" (extract s trap))
             (f \"pc\" (extract s pc)) (f \"args\" (extract s args)) (f \"nargs\" (extract s nargs))
             (f \"aux\" (extract s aux)) (f \"callout\" (extract s callout))
             (f \"rust-sp\" (extract s rust-sp))
             (f \"native-sp\" (extract s native-sp)) (f \"fp\" (extract s fp))
             (f \"top\" (extract s top))
             (f \"words\" (extract s words)) (f \"alloc-limit\" (extract s alloc-limit))
             (f \"code\" (extract s code)) (f \"clo\" (extract s clo)) (f \"delta\" (extract s delta))
             (f \"code-lo\" (extract s code-lo)) (f \"trap-stub\" (extract s trap-stub))
             (f \"foreign\" (extract s foreign)) (f \"closure\" (extract s closure))
             (f \"cards\" (extract s cards)) (f \"stack-limit\" (extract s stack-limit))
             (f \"overflow\" (extract s overflow)) (f \"poll\" (extract s poll))
             (f \"cons\" (extract s cons)) (f \"bloblet\" (extract s bloblet)))
       (cv-reg-names (extract s reg4) 8 nil)))))

(define cv-pr-registers (->* (cv-nm cv-registers) string)
  (lambda (nm r)
    (let ((one (lambda ((role string) (n int)) (cv-par role (list (cv-reg nm n))))))
      (cv-par \"registers\"
              (list (cv-par \"arguments\" (cv-pr-regs nm (extract r arguments)))
                    (one \"rest-in\" (extract r rest-in))
                    (one \"count\" (extract r count)) (one \"result\" (extract r result))
                    (one \"closure\" (extract r closure)) (one \"link\" (extract r link))
                    (one \"frame\" (extract r frame))
                    (cv-par \"pinned\"
                            (list (one \"state\" (extract r state)) (one \"fuel\" (extract r fuel))
                                           (one \"stack-limit\" (extract r stack-limit))
                                           (one \"code-distance\" (extract r code-distance))))
                    \"(lost-across-calls all-but-pinned)\")))))
(define cv-pr-bits (->* (cv-bits) cv-strs)
  (lambda (bs)
    (if (null? bs)
        nil
        (let ((b (car bs)))
          (the cv-strs (cons (cv-par (extract b name) (list (int->string (extract b at))
                                                            (int->string (extract b width))))
                             (cv-pr-bits (cdr bs))))))))
(define cv-pr-values (->* (cv-values) string)
  (lambda (v)
    (cv-par \"values\"
            (list (cv-par \"tags\" (cv-pr-names (extract v tags)))
                  (cv-par \"fixnum\" (list (cv-kv \"shift\" (extract v fixnum-shift))
                                         (cv-kv \"bits\" (extract v fixnum-bits))))
                  (cv-par \"immediates\" (cv-pr-names (extract v immediates)))
                  (cv-par \"character\" (list (cv-kv \"subtag\" (extract v char-subtag))
                                            (cv-kv \"payload-shift\" (extract v char-payload-shift))))
                  (cv-par \"pair\" (list (cv-kv \"car\" (extract v car)) (cv-kv \"cdr\" (extract v cdr))))
                  (cv-par \"bloblet\"
                          (list (cv-par \"reference\"
                                        (list \"suffix\"
                                              (int->string (extract v bloblet-past-suffix))))
                                (cv-kv \"field-k-before-suffix\" (extract v field-k-before-suffix))))
                  (cv-par \"header\" (cv-pr-bits (extract v header)))
                  (cv-par \"kinds\" (cv-pr-names (extract v kinds)))))))
;; How a frame is made: arm64's `sub`, `stp` and `add`; x86_64's return
;; address popped, the link and it stored, and the frame's register set.
(define cv-pr-made (->* (cv-nm cv-frames int int) string)
  (lambda (nm f fp lr)
    (let ((sp (cv-sp nm)) (above (lambda ((k int)) (int->string (- k (extract f header))))))
      (cv-par \"made\"
              (if (extract nm x86)
                  (list \"pop\" \"return\" \"sub\" sp \"store\" (cv-reg nm fp) sp (above (extract f link))
                        \"store\" \"return\" sp (above (extract f return)) \"lea\" (cv-reg nm fp) sp
                        (above 0))
                  (list \"sub\" sp \"stp\" (cv-reg nm fp) (cv-reg nm lr) \"add\" (cv-reg nm fp) sp
                        (above 0)))))))
(define cv-pr-frames (->* (cv-nm cv-frames int int) string)
  (lambda (nm f fp lr)
    (let ((at (lambda ((role string) (k int)) (cv-par role (list (cv-reg nm fp) (int->string k))))))
      (cv-par \"frames\"
              (list (cv-kv \"align\" (extract f align)) (at \"header\" (extract f header))
                    (at \"link\" (extract f link)) (at \"return\" (extract f return))
                    (cv-par \"map\" (list (cv-reg nm fp) (int->string (extract f map))
                                        (cv-kv \"live-slots-below\" (extract f live-below))
                                        (cv-par \"fields-above\"
                                                (list (int->string (extract f fields-above))
                                                      \"link\" \"return\" \"map\" \"values\"))
                                        \"(all-live negative)\"))
                    (at \"values-from\" (extract f values-from)) \"(raw-after-values)\"
                    \"(keeps-its-code)\" \"(map-stored-before calls routines-that-collect)\"
                    (cv-pr-made nm f fp lr)
                    (cv-kv \"stub\" (extract f stub)))))))
;; `(entry state field)`, the field's name from its offset.
(define cv-pr-entry (->* (cv-names int) string)
  (lambda (sn k) (cv-par \"entry\" (list \"state\" (cv-name-at sn k)))))
(define cv-pr-in (->* (cv-nm cv-regs) cv-strs)
  (lambda (nm rs)
    (if (null? rs)
        nil
        (the cv-strs
             (cons (cv-par (extract (car rs) name) (cv-pr-regs nm (extract (car rs) registers)))
                           (cv-pr-in nm (cdr rs)))))))
;; A routine, `more` after what every routine says.
(define cv-pr-routine (->* (string cv-routine cv-nm cv-strs) string)
  (lambda (name r nm more)
    (let* ((tail (if (extract r may-collect) (the cv-strs (cons \"(may-collect)\" more)) more))
           (tail (if (= (extract r out) -1)
                     tail
                     (the cv-strs (cons (cv-par \"out\" (list (cv-reg nm (extract r out)))) tail)))))
      (cv-par name (the cv-strs (cons (cv-pr-entry (extract nm sn) (extract r entry))
                                      (cons (cv-par \"in\" (cv-pr-in nm (extract r in))) tail)))))))
(define cv-pr-overflow (->* (cv-overflow cv-nm int int) string)
  (lambda (o nm limit lr)
    (cv-par \"overflow\"
            (list (cv-par \"when\" (list (cv-sp nm) \"below\" (cv-reg nm limit) \"after-frame-made\"))
                  (cv-par \"entry\" (list \"state\" (cv-name-at (extract nm sn) (extract o entry)) \"by\"
                                        (if (= lr -2) \"call\" (cv-reg nm lr))))
                  (cv-par \"in\"
                          (list (cv-par \"code\" (list (cv-reg nm (extract o code))))
                                (cv-par \"info\"
                                        (list (cv-reg nm (extract o info))
                                              (cv-par \"arguments-held\"
                                                      (list (int->string (extract o held-at))
                                                            (int->string (extract o held-width))))
                                              (cv-kv \"closure-read\" (extract o closure-read))
                                              (cv-kv \"variadic\" (extract o variadic))))))
                  (cv-par \"keeps\" (cv-pr-regs nm (extract o keeps)))))))
(define cv-pr-routines (->* (convention cv-nm) string)
  (lambda (c nm)
    (let ((rs (extract c routines)) (sn (extract nm sn)) (rg (extract c registers)))
      (cv-par \"routines\"
              (list (cv-pr-routine \"foreign\" (extract rs foreign) nm nil)
                    (cv-pr-overflow (extract rs overflow) nm (extract rg stack-limit)
                                    (extract rg link))
                    (cv-pr-routine \"poll\" (extract rs poll) nm (list \"(traps-when-spent 1)\"))
                    (cv-pr-routine \"cons\" (extract rs cons) nm nil)
                    (cv-pr-routine \"bloblet\" (extract rs bloblet) nm
                                   (list \"(makes (kind bloblet) (trailer 1) zeroed)\"
                                         \"(traps-when-refused 3)\"))
                    (let ((t (extract rs trap)))
                      (cv-par \"trap\"
                              (list (cv-pr-entry sn (extract t entry))
                                    (cv-par \"in\"
                                            (list (cv-par \"kind\"
                                                          (list (cv-reg nm (extract t kind))))))
                                    (cv-par \"kinds\" (cv-pr-numbered (extract t kinds)))))))))))
;; How `c` names its places.
(define cv-naming (->* (convention) cv-nm)
  (lambda (c)
    (product (x86 (string=? (extract c target) \"x86_64\"))
             (sn (cv-state-names (extract c state))))))
;; A convention's clauses, as a declaration says them, in fixpt's order.
(define cv-print (->* (convention) cv-strs)
  (lambda (c)
    (let* ((rg (extract c registers)) (cl (extract c closures)) (nm (cv-naming c))
           (sn (extract nm sn)) (fu (extract c fuel)) (ba (extract c barrier)))
      (list (cv-par \"target\" (list (extract c target)))
            (cv-pr-registers nm rg)
            (cv-pr-values (extract c values))
            (cv-par \"closures\"
                    (list (cv-kv \"kind\" (extract cl kind))
                          (cv-kv \"code-field\" (extract cl code-field))
                          (cv-kv \"first-free-field\" (extract cl first-free-field))
                          (if (extract cl code-always-runs)
                              (cv-par \"code-always-runs\" nil)
                              (cv-par \"native-when-code-at-least\"
                                      (list (cv-name-at sn
                                                        (extract cl native-when-code-at-least)))))))
            (cv-par \"code\"
                    (list (cv-par \"runs-at\"
                                  (list \"reference\" \"plus\" (cv-reg nm (extract rg code-distance))))
                          (cv-kv \"field-k-before-code\"
                                 (extract (extract c code) field-k-before-code))))
            (cv-pr-frames nm (extract c frames) (extract rg frame) (extract rg link))
            (cv-par \"state\" (cv-pr-names sn))
            (cv-pr-routines c nm)
            (cv-par \"fuel\" (list (if (>= (extract fu register) cv-in-state)
                                     (cv-reg nm (extract fu register))
                                     (cv-par \"register\" (list (cv-reg nm (extract fu register)))))
                                 (cv-kv \"subtract\" (extract fu subtract)) \"(on entry back-edge)\"
                                 \"(borrow poll)\"))
            (cv-par \"barrier\"
                    (list (cv-par \"cards\" (list \"state\" (cv-name-at sn (extract ba cards))))
                          (cv-kv \"card-shift\" (extract ba card-shift))
                          (cv-kv \"mark\" (extract ba mark))))))))

;;; ------------------------------------------------------------ reading back

;; A clause's role, from its text: up to its first space or `)`.
(define cv-role-of (->* (string) string)
  (lambda (t) (substring t 1 (cv-atom-end t 1))))
;; The clause of `ts` whose role is `role`; \"\" if none is.
(define cv-clause (->* (cv-strs string) string)
  (lambda (ts role)
    (cond ((null? ts) \"\")
          ((string=? (cv-role-of (car ts)) role) (car ts))
          (else (cv-clause (cdr ts) role)))))
;; Why `ts`, declared, is not `back`, printed: \"\" if it is.
(define cv-differs (->* (cv-strs cv-strs) string)
  (lambda (ts back)
    (if (null? back)
        \"\"
        (let* ((b (car back)) (role (cv-role-of b)) (t (cv-clause ts role)))
          (cond ((string=? t \"\") (string-append \"no `\" role \"` clause\"))
                ((string=? t b) (cv-differs ts (cdr back)))
                (else (string-append \"the `\" role \"` clause is not one a convention holds: \"
                                     t)))))))
;; A clause of `ts` none of `back` has the role of: \"\" if none.
(define cv-extra (->* (cv-strs cv-strs) string)
  (lambda (ts back)
    (cond ((null? ts) \"\")
          ((string=? (cv-clause back (cv-role-of (car ts))) \"\")
           (string-append \"a `\" (cv-role-of (car ts))
                          \"` clause, which a convention has no room for\"))
          (else (cv-extra (cdr ts) back)))))
(define cv-parse-all (->* (cv-strs) cv-sxs)
  (lambda (ts)
    (if (null? ts)
        nil
        (the cv-sxs (cons (extract (cv-read-at (car ts) 0) x) (cv-parse-all (cdr ts)))))))
;; A declaration's clauses, read: the convention, or why not.
(define cv-read-clauses (->* (cv-strs) cv-read)
  (lambda (ts)
    (let* ((c (cv-of (cv-parse-all ts))) (back (cv-print c))
           (why (let ((d (cv-differs ts back))) (if (string=? d \"\") (cv-extra ts back) d))))
      (if (string=? why \"\") (sum ok c) (sum refused why)))))
;; fixpt's own native convention, read.
(define cv-native (->* () cv-read)
  (lambda () (cv-read-clauses (the cv-strs (native-convention)))))))
")

(define built-in-7 string
  ";;; The object layout, generated from `crates/fixpt-heap/src/layout.rs`.
;;; Do not edit: change the table there and regenerate, with
;;;   FIXPT_BLESS=1 cargo test -p fixpt-fx26 --test layout
;;; See `docs/object-model.md`. A module file, which the conductor loads.

;;; Tags: the low three bits of every word.
(define tag-fixnum int 0)  ; 61-bit signed integer; also what a zeroed word is
(define tag-pair int 1)  ; index of a two-word car/cdr cell, which has no header
;; a pointer into a bloblet's binary suffix: owner in bits 3..37, byte offset in 37..64
(define tag-suffix-ref int 2)
(define tag-immediate int 3)  ; #f, #t, (), unit, eof, characters, …
(define tag-bloblet int 4)  ; index of the start of a bloblet's suffix
(define tag-trailer int 5)  ; the last field of a bloblet that has one; runtime-reserved payload
(define tag-header int 6)  ; never a value: starts an object
(define tag-forward int 7)  ; a forwarding pointer, only during a collection
(define tag-bits int 3)

;;; The header word's bit fields: lowest bit, and width.
(define header-tag-lo int 0)
(define header-tag-width int 3)  ; 110, the header tag
(define header-kind-lo int 3)
(define header-kind-width int 8)  ; what the object is to the language
(define header-large-lo int 11)
(define header-large-width int 1)  ; F is too big for this word: it is in the next one
(define header-fields-frozen-lo int 12)
(define header-fields-frozen-width int 1)  ; the fields are immutable
(define header-suffix-frozen-lo int 13)
(define header-suffix-frozen-width int 1)  ; the suffix is immutable
(define header-fields-lo int 14)
(define header-fields-width int 18)  ; F, the number of tagged fields
(define header-bytes-lo int 32)
(define header-bytes-width int 32)  ; B, the suffix length in bytes
(define extension-fields-lo int 11)
(define extension-fields-width int 53)  ; F, for an object whose F does not fit the main header

;;; Kinds.
(define kind-string int 1)
(define kind-symbol int 2)
(define kind-vector int 3)
(define kind-bytevector int 4)
(define kind-flonum int 5)
(define kind-bignum int 6)
(define kind-ratnum int 7)
(define kind-closure int 8)
(define kind-code int 9)
(define kind-box int 10)
(define kind-record int 11)
(define kind-record-type int 12)
(define kind-port int 13)
(define kind-continuation int 14)
(define kind-values int 15)
(define kind-promise int 16)
(define kind-hash-table int 17)
(define kind-environment int 18)
(define kind-primitive int 19)
(define kind-bloblet int 32)
(define kind-cellular-code int 33)
(define kind-compiled-code int 34)
(define kind-env-frame int 35)
(define kind-sum int 36)
(define kind-product int 37)
(define kind-cellular-closure int 38)
(define kind-cellular-continuation int 39)
(define kind-register-code int 40)
(define kind-native-closure int 41)
(define kind-flat-array int 42)
(define kind-eqtable int 43)
(define kind-weak-pair int 44)
(define kind-native-frame int 45)
(define kind-icell int 46)
(define kind-mailbox int 47)
(define kind-extension int 255)

;;; A closure's fields, and an environment frame's, by negative offset.
(define closure-code int 3)
(define closure-extra0 int 4)
(define frame-parent int 2)
(define frame-slot0 int 3)

;;; A code bloblet's fields, by negative offset from its code. 1 is the trailer.
(define code-entry int 2)
(define code-frame int 3)
(define code-free int 4)
(define code-has-rest int 5)
(define code-arity int 6)
(define code-name int 7)
(define code-items int 8)
(define code-item0 int 9)

;;; A cellular word's fields, by negative offset, and its routines by number.
(define word-entry int 2)
(define word-name int 3)
(define word-twin int 4)
(define word-cell0 int 5)
(define cellular-closure-word int 2)
(define cellular-closure-free0 int 3)
(define global-value int 2)
(define global-writes int 4)
(define routine-docol int 0)  ; run a word's cells
(define routine-exit int 1)  ; return to the calling word
(define routine-halt int 2)  ; stop, leaving the data stack as the result
(define routine-lit int 3)  ; ( -- x ), x the next cell
(define routine-branch int 4)  ; skip the next cell's fixnum of cells, counted after it
(define routine-zbranch int 5)  ; ( flag -- ), branch if flag is #f
(define routine-execute int 6)  ; ( w -- ), run a word, or a primitive given as its fixnum
(define routine-dup int 7)  ; ( a -- a a )
(define routine-drop int 8)  ; ( a -- )
(define routine-swap int 9)  ; ( a b -- b a )
(define routine-over int 10)  ; ( a b -- a b a )
(define routine-add int 11)  ; ( a b -- a+b ), fixnums
(define routine-sub int 12)  ; ( a b -- a-b ), fixnums
(define routine-less int 13)  ; ( a b -- a<b ), fixnums
(define routine-eq int 14)  ; ( a b -- flag ), the same Value
(define routine-field-ref int 15)  ; ( obj k -- x ), field k of a bloblet
(define routine-field-set int 16)  ; ( x obj k -- ), field k of a bloblet
(define routine-cons int 17)  ; ( a b -- pair )
(define routine-car int 18)  ; ( pair -- a )
(define routine-cdr int 19)  ; ( pair -- b )
(define routine-slot int 20)  ; ( -- x ), slot i of this frame; i the next cell
(define routine-slot! int 21)  ; ( x -- ), into slot i of this frame
(define routine-free int 22)  ; ( -- x ), free value i of the closure running
(define routine-global int 23)  ; ( -- x ), what the cell that is the next cell holds
(define routine-global! int 24)  ; ( x -- ), into the cell that is the next cell
;; ( v1 … vn -- c ), word w closed over the v's; w and n the next cells
(define routine-closure int 25)
;; ( x1 … xn c -- r ), n the next cell: the x's become the callee's frame
(define routine-call int 26)
(define routine-tailcall int 27)  ; ( x1 … xn c -- r ), the same, the x's replacing this frame
(define routine-return int 28)  ; ( … r -- r ), leave this frame, keeping r, and return
(define routine-prim int 29)  ; ( x1 … xn -- r ), the runtime's primitive p; p and n the next cells
(define routine-prompt int 30)  ; ( tag handler thunk -- r ), run the thunk under a prompt for tag
(define routine-abort int 31)  ; ( tag v -- ), to the nearest prompt for tag, whose handler gets v
;; ( proc tag -- r ), call proc with the continuation up to tag's prompt
(define routine-callcomp int 32)
(define routine-callcc int 33)  ; ( proc -- r ), call proc with the whole continuation
(define routine-withmark int 34)  ; ( key v thunk -- r ), run the thunk with key marked v
(define routine-firstmark int 35)  ; ( key default -- v ), the innermost mark for key
(define routine-currentmarks int 36)  ; ( key -- list ), every mark for key, innermost first
(define routine-marksof int 37)  ; ( k key -- list ), the marks for key in continuation k
;; ( key v thunk -- r ), withmark in tail position: the frame is left, and a mark for key on top
;; replaced
(define routine-withmark-tail int 38)
(define routine-tcall int 39)  ; ( x1 … xn c -- r ), call closure c; n the next cell
(define routine-ttailcall int 40)  ; ( x1 … xn c -- ), tail-call closure c; n the next cell
(define routine-resume int 41)  ; ( v k -- ), give continuation k the value v, in this frame's place
(define routine-undefined int 42)  ; ( -- ), trap: called before it was defined
(define routine-int-add int 43)  ; ( a b -- a+b ), ints: a bignum past a fixnum
(define routine-int-sub int 44)  ; ( a b -- a-b ), ints: a bignum past a fixnum
(define routine-int-less int 45)  ; ( a b -- a<b ), ints
(define routine-pair-car int 46)  ; ( pair -- a ), a pair
(define routine-pair-cdr int 47)  ; ( pair -- b ), a pair
(define routine-field int 48)  ; ( obj -- x ), field k of a bloblet that has it; k the next cell
(define routine-rest int 49)  ; ( -- list ), this frame's values, from slot 0, as a list
(define routine-int-eq int 50)  ; ( a b -- a=b ), ints, fixnums or bignums
;; ( v1 … vn -- c ), word w closed over the v's, in the native convention; w and n the next cells
(define routine-nclosure int 51)
;; ( proc tag -- r ), callcomp, the continuation in the native convention
(define routine-ncallcomp int 52)
(define routine-ncallcc int 53)  ; ( proc -- r ), callcc, the continuation in the native convention
;; ( proc tag -- r ), callcomp, the continuation resumed at most once
(define routine-callone int 54)
;; ( proc tag -- r ), callone, the continuation in the native convention
(define routine-ncallone int 55)

;;; Register code's instructions by number, and how many registers it has.
;; 1: entered with n arguments in REG1…REGn; first, and only first (arities are static: nothing is
;; checked)
(define rop-args int 0)
(define rop-const int 1)  ; 1: RESULT := x, the operand
(define rop-global int 2)  ; 1: RESULT := the value in global cell g
(define rop-setglbl int 3)  ; 1: global cell g := RESULT
(define rop-reg int 4)  ; 1: RESULT := REGk
(define rop-setreg int 5)  ; 1: REGk := RESULT
(define rop-movereg int 6)  ; 2: REGk2 := REGk1
(define rop-lexical int 7)  ; 1: RESULT := free value i of the closure running (REG0)
(define rop-save int 8)  ; 1: push a frame of n slots, each #f
(define rop-pop int 9)  ; 1: pop the frame of n slots
(define rop-stack int 10)  ; 1: RESULT := frame slot n
(define rop-setstk int 11)  ; 1: frame slot n := RESULT
(define rop-load int 12)  ; 2: REGk := frame slot n
(define rop-store int 13)  ; 2: frame slot n := REGk
(define rop-op1 int 14)  ; 1: RESULT := cellular routine r applied to RESULT
(define rop-op2 int 15)  ; 2: RESULT := cellular routine r applied to RESULT and REGk
(define rop-op2imm int 16)  ; 2: RESULT := cellular routine r applied to RESULT and x
(define rop-field int 17)  ; 1: RESULT := field k of the bloblet in RESULT
(define rop-setfield int 18)  ; 2: field k of the bloblet in RESULT := REGj
(define rop-prim int 19)  ; 2: RESULT := runtime primitive p applied to REG1…REGn; may collect
;; 3: RESULT := a closure of cellular word w over REG1…REGn, as stack routine r makes it (`closure`,
;; or `nclosure` in a program whose convention is native); natively, a native closure; may collect
(define rop-lambda int 20)
;; 2: call the procedure in RESULT with REG1…REGn, of convention c by its type (`CONVS`); RESULT :=
;; its value; may collect
(define rop-invoke int 21)
;; 2: the same in tail position, the frame popped: its value is this one's
(define rop-tailinvoke int 22)
(define rop-return int 23)  ; 0: return RESULT, the frame popped
(define rop-branch int 24)  ; 1: skip the operand's count of cells, counted after it
(define rop-branchf int 25)  ; 1: the same if RESULT is #f
;; 2: cellular routine r with REG1…REGn as its data stack operands; RESULT := what it leaves; may
;; collect
(define rop-cellular int 26)
;; 1: call the procedure running (REG0) with REG1…REGn, by its own entry; RESULT := its value; may
;; collect
(define rop-invokeself int 27)
;; 3: unless global cell g has been written n times (`cellular::GLOBAL_WRITES`), as when this code
;; was compiled: what a fast version assumed of the global (a procedure inlined or specialized, a
;; constant folded, a module's member folded through a `with`, `TODO.md` §42) it still holds; else
;; skip the third operand's count of cells, counted after it; RESULT kept
(define rop-global-guard int 28)
(define rop-brancht int 29)  ; 1: the same as branch if RESULT is not #f
;; 0: entered with any number of arguments, their count in a register (x9, natively), in REG1…REGn
;; (past REGS, a list of the rest in the last); first, instead of args, and only first
(define rop-vargs int 30)
;; 1: RESULT := runtime primitive p applied to RESULT: one that never collects
;; (`fixpt_runtime::never_collects`), so that no register need be in the frame
(define rop-prim1 int 31)
(define rop-prim2 int 32)  ; 2: RESULT := such a primitive p applied to RESULT and REGk
(define rop-prim2imm int 33)  ; 2: RESULT := such a primitive p applied to RESULT and x
(define rop-prim3imm int 34)  ; 3: RESULT := such a primitive p applied to RESULT, x and REGk
(define register-regs int 8)

;;; The conventions of an `invoke`'s callee, by its type (its second operand).
(define rconv-fx int 0)  ; any procedure: its kind looked at
(define rconv-cellular int 1)  ; a cellular closure: called as one, with no look
;; a native closure: natively, its code called, with no look; on a cellular machine, as fx, an
;; adapter (`nclosure`) called through what it adapts
(define rconv-native int 2)
")

