(define built-in-9 string
  ";;; Generated by `fixpt_native::cellular::fx26_module` from the hand-encoded
;;; machine; `FIXPT_BLESS=1 cargo test -p fixpt-fx26 --test layout` rewrites it.
;;; A module file, which the conductor loads (`TODO.md` §68).

(define n-base int 19)  ; a register
(define n-ip int 20)  ; a register
(define n-cur int 21)  ; a register
(define n-dsp int 22)  ; a register
(define n-rsp int 23)  ; a register
(define n-st int 24)  ; a register
(define n-table int 25)  ; a register
(define n-fp int 26)  ; a register
(define n-clo int 27)  ; a register
(define n-fuel int 28)  ; a register
(define n-w int 9)  ; a register
(define n-x10 int 10)  ; a register
(define n-x11 int 11)  ; a register
(define n-x13 int 13)  ; a register
(define n-x14 int 14)  ; a register
(define n-x15 int 15)  ; a register
(define n-x16 int 16)  ; a register
(define n-st-base int 0)  ; a State field's offset
(define n-st-cur int 8)  ; a State field's offset
(define n-st-d int 16)  ; a State field's offset
(define n-st-dsp int 24)  ; a State field's offset
(define n-st-rsp int 32)  ; a State field's offset
(define n-st-table int 40)  ; a State field's offset
(define n-st-fuel int 64)  ; a State field's offset
(define n-st-callout int 88)  ; a State field's offset
(define n-st-ds-base int 112)  ; a State field's offset
(define n-st-ds-limit int 128)  ; a State field's offset
(define n-st-rs-limit int 136)  ; a State field's offset
(define n-st-fp int 144)  ; a State field's offset
(define n-st-clo int 152)  ; a State field's offset
(define n-st-resume int 168)  ; a State field's offset
(define n-st-trap int 736)  ; a State field's offset
(define n-st-exit int 744)  ; a State field's offset
(define n-st-cards int 208)  ; a State field's offset
(define n-st-code-lo int 216)  ; a State field's offset
(define n-false int 3)  ; a Value's bits
(define n-true int 11)  ; a Value's bits
(define n-prompt-mark int 51)  ; a Value's bits
(define n-mark-mark int 43)  ; a Value's bits
(define n-tag-bloblet int 4)  ; a tag
(define n-tag-pair int 1)  ; a tag
(define n-tag-trailer int 5)  ; a tag
(define n-kind-word int 33)  ; the kind of a cellular word
(define n-kind-closure int 38)  ; the kind of a cellular closure
(define n-closure-word int 2)  ; a closure's field
(define n-closure-free0 int 3)  ; a closure's field
(define n-word-entry int 2)  ; a word's field
(define n-word-cell0 int 5)  ; a word's field
(define n-primitives int 56)  ; routines that may be cells
(define n-trap-type int 1)  ; a trap's code; a routine's number is its detail
(define n-trap-overflow int 2)  ; a trap's code; a routine's number is its detail
(define n-trap-underflow int 3)  ; a trap's code; a routine's number is its detail
(define n-trap-field int 4)  ; a trap's code; a routine's number is its detail
(define n-trap-no-routine int 5)  ; a trap's code; a routine's number is its detail
(define n-trap-not-a-word int 6)  ; a trap's code; a routine's number is its detail
(define n-trap-out-of-fuel int 7)  ; a trap's code; a routine's number is its detail
(define n-trap-stack-overflow int 8)  ; a trap's code; a routine's number is its detail
(define n-trap-too-deep int 9)  ; a trap's code; a routine's number is its detail

;; How many operand cells follow routine `n`.
(define n-operands (subr pure (int) int)
  (lambda (n)
    (case n
      ((3) 1)  ; lit
      ((4) 1)  ; branch
      ((5) 1)  ; 0branch
      ((20) 1)  ; slot
      ((21) 1)  ; slot!
      ((22) 1)  ; free
      ((23) 1)  ; global
      ((24) 1)  ; global!
      ((25) 2)  ; closure
      ((26) 1)  ; call
      ((27) 1)  ; tailcall
      ((29) 2)  ; prim
      ((39) 1)  ; tcall
      ((40) 1)  ; ttailcall
      ((48) 1)  ; field
      ((51) 2)  ; nclosure
      (else 0))))

;; Whether routine `n`'s call-out may leave the machine anywhere.
(define n-control? (subr pure (int) bool)
  (lambda (n)
    (case n
      ((0) #t)  ; docol
      ((1) #t)  ; exit
      ((2) #t)  ; halt
      ((6) #t)  ; execute
      ((26) #t)  ; call
      ((27) #t)  ; tailcall
      ((28) #t)  ; return
      ((30) #t)  ; prompt
      ((31) #t)  ; abort
      ((32) #t)  ; callcomp
      ((33) #t)  ; callcc
      ((34) #t)  ; withmark
      ((38) #t)  ; withmark-tail
      ((39) #t)  ; tcall
      ((40) #t)  ; ttailcall
      ((41) #t)  ; resume
      ((42) #t)  ; undefined
      ((52) #t)  ; ncallcomp
      ((53) #t)  ; ncallcc
      ((54) #t)  ; callone
      ((55) #t)  ; ncallone
      (else #f))))
")

(define built-in-10 string
  ";;; Generated by `fixpt_fx26::lower::standard_fx26_module` from the lowering's
;;; table of standard names; `FIXPT_BLESS=1 cargo test -p fixpt-fx26 --test layout`
;;; rewrites it. A module file, which the conductor loads (`TODO.md` §68).

;; The runtime primitive a standard operation runs as, `%fx26-identity`
;; if it is the identity, or the empty string if neither: by the name's
;; length first, then among the names of that length (`TODO.md` §43).
(define standard-primitive (subr pure (string) string)
  (lambda (n)
    (let ((k (string-length n)))
    (case k
      ((1)
       (case n
         ((\"+\") \"%fx26-add\")
         ((\"-\") \"%fx26-sub\")
         ((\"=\") \"=\")
         ((\"<\") \"<\")
         ((\">\") \">\")
         ((\"*\") \"%fx26-mul\")
         (else \"\")))
      ((2)
       (case n
         ((\"<=\") \"<=\")
         ((\">=\") \">=\")
         (else \"\")))
      ((3)
       (case n
         ((\"car\") \"car\")
         ((\"cdr\") \"cdr\")
         ((\"not\") \"not\")
         ((\"i8+\") \"%fx26-i8+\")
         ((\"i8-\") \"%fx26-i8-\")
         ((\"i8*\") \"%fx26-i8*\")
         ((\"i8<\") \"%fx26-i8<\")
         ((\"i8>\") \"%fx26-i8>\")
         ((\"i8=\") \"%fx26-i8=\")
         ((\"u8+\") \"%fx26-u8+\")
         ((\"u8-\") \"%fx26-u8-\")
         ((\"u8*\") \"%fx26-u8*\")
         ((\"u8<\") \"%fx26-u8<\")
         ((\"u8>\") \"%fx26-u8>\")
         ((\"u8=\") \"%fx26-u8=\")
         ((\"max\") \"%fx26-max\")
