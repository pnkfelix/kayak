         ((\"flatarray-ref\") \"%fx26-flatarray-ref\")
         ((\"terminal-size\") \"%fx26-terminal-size\")
         ((\"process-start\") \"%fx26-process-start\")
         ((\"process-write\") \"%fx26-process-write\")
         ((\"i32-remainder\") \"%fx26-i32-remainder\")
         ((\"u32-remainder\") \"%fx26-u32-remainder\")
         ((\"i64-remainder\") \"%fx26-i64-remainder\")
         ((\"u64-remainder\") \"%fx26-u64-remainder\")
         ((\"string-search\") \"%fx26-string-search\")
         ((\"pair-identity\") \"%fx26-address-identity\")
         ((\"eqtable-count\") \"%fx26-eqtable-count\")
         ((\"wcell-routine\") \"%fx26-identity\")
         ((\"wcell-closure\") \"%fx26-closure-cell\")
         ((\"wcell-product\") \"%fx26-product-cell\")
         (else \"\")))
      ((14)
       (case n
         ((\"make-flatarray\") \"%fx26-make-flatarray\")
         ((\"flatarray-set!\") \"%fx26-flatarray-set!\")
         ((\"process-output\") \"%fx26-process-output\")
         ((\"process-status\") \"%fx26-process-status\")
         ((\"process-signal\") \"%fx26-process-signal\")
         ((\"string-compare\") \"%fx26-string-compare\")
         ((\"symbol-compare\") \"%fx26-symbol-compare\")
         ((\"certify-length\") \"%fx26-first\")
         ((\"string->symbol\") \"string->symbol\")
         ((\"symbol->string\") \"symbol->string\")
         ((\"array-identity\") \"%fx26-address-identity\")
         ((\"icell-identity\") \"%fx26-address-identity\")
         ((\"wcell-interned\") \"%fx26-intern-datum\")
         ((\"wglobal-writes\") \"%fx26-global-writes\")
         (else \"\")))
      ((15)
       (case n
         ((\"make-bytevector\") \"make-bytevector\")
         ((\"bytevector-copy\") \"%fx26-bytevector-copy\")
         ((\"string-downcase\") \"%fx26-string-downcase\")
         ((\"certify-acyclic\") \"%fx26-identity\")
         ((\"eqtable-delete!\") \"%fx26-eqtable-delete!\")
         (else \"\")))
      ((16)
       (case n
         ((\"char-whitespace?\") \"char-whitespace?\")
         ((\"char-alphabetic?\") \"char-alphabetic?\")
         ((\"flatarray-length\") \"%fx26-flatarray-length\")
         ((\"terminal-restore\") \"%fx26-terminal-restore\")
         ((\"native-procedure\") \"%fx26-native-procedure\")
         ((\"bytevector-copy!\") \"%fx26-bytevector-copy!\")
         ((\"arithmetic-shift\") \"%fx26-arithmetic-shift\")
         ((\"symbol-name-hash\") \"%symbol-hash\")
         ((\"close-over-word!\") \"%fx26-close-over-word!\")
         ((\"%syscall-require\") \"%fx26-syscall-require\")
         (else \"\")))
      ((17)
       (case n
         ((\"native-convention\") \"%fx26-native-convention\")
         ((\"bytevector-length\") \"bytevector-length\")
         ((\"bytevector-u8-ref\") \"bytevector-u8-ref\")
         ((\"set-register-twin\") \"%set-register-twin\")
         ((\"runtime-primitive\") \"%runtime-primitive\")
         (else \"\")))
