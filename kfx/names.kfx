"names.kfx: KFX's names as Rust's."

"Names"

(define rust-keywords (listof string acyclic)
  (list "as" "async" "await" "box" "break" "const" "continue" "do"
        "dyn" "else" "enum" "extern" "false" "final" "fn" "for" "gen"
        "if" "impl" "in" "let" "loop" "macro" "match" "mod" "move"
        "mut" "override" "priv" "pub" "ref" "return" "static"
        "struct" "trait" "true" "try" "type" "typeof" "unsafe"
        "unsized" "use" "virtual" "where" "while" "yield" "abstract" "become"))

(define rust-keyword? (subr kfx (string) bool)
  (lambda (s) (string-member? s rust-keywords)))

(define mangle-char (subr kfx (char) string)
  (lambda (c)
    (case c
      ((#\-) "_") ((#\?) "_p") ((#\!) "_x") ((#\+) "_plus") ((#\*) "_star")
      ((#\/) "_slash") ((#\<) "_lt") ((#\>) "_gt") ((#\=) "_eq") ((#\%) "_pct") ((#\:) "_colon")
      (else (char->string c)))))

(define mangle-chars (subr kfx (chars chars) chars)
  (lambda (cs acc)
    (cond ((null? cs) acc)
          ((and (char=? (car cs) #\-) (not (null? (cdr cs))) (char=? (car (cdr cs)) #\>))
           (mangle-chars (cdr (cdr cs)) (put "_to_" acc)))
          ((and (char=? (car cs) #\-) (null? (cdr cs))) (put "_minus" acc))
          (else (mangle-chars (cdr cs) (put (mangle-char (car cs)) acc))))))

(define mangle (subr kfx (string) string)
  (lambda (s)
    "A KFX name as a Rust value's: `string->list` is `string_to_list`."
    (cond ((string=? s "-") "_minus")
          ((or (string=? s "self") (string=? s "super") (string=? s "crate") (string=? s "Self"))
           "Keywords no raw identifier may be: a trailing `_`."
           (string-append s "_"))
          ((rust-keyword? s) (string-append "r#" s))
          (else (rev->string (mangle-chars (string-chars s) nil))))))

(define mangled-char-length (subr kfx (char) i64)
  (lambda (c)
    "`mangle-char`'s length, making nothing."
    (case c
      ((#\?) 2) ((#\!) 2) ((#\+) 5) ((#\*) 5) ((#\/) 6) ((#\<) 3) ((#\>) 3) ((#\=) 3) ((#\%) 4) ((#\:) 6)
      (else 1))))

(define-rec
  (mangled-length-from (subr kfx (string i64 i64 i64) i64)
    (lambda (s i n acc)
      (cond ((i64= i n) acc)
            ((and (char=? (string-ref-i64 s i) #\-) (i64< (i64+ i 1) n) (char=? (string-ref-i64 s (i64+ i 1)) #\>))
             (mangled-length-from s (i64+ i 2) n (i64+ acc 4)))
            ((and (char=? (string-ref-i64 s i) #\-) (i64= (i64+ i 1) n)) (i64+ acc 6))
            (else (mangled-length-from s (i64+ i 1) n (i64+ acc (mangled-char-length (string-ref-i64 s i)))))))))

(define mangled-length (subr kfx (string) i64)
  (lambda (s)
    "The length of `(mangle s)`, making nothing: to look for a name that
     mangles as another without mangling each."
    (cond ((string=? s "-") 6)
          ((or (string=? s "self") (string=? s "super") (string=? s "crate") (string=? s "Self")) (i64+ (string-length-i64 s) 1))
          ((rust-keyword? s) (i64+ (string-length-i64 s) 2))
          (else (mangled-length-from s 0 (string-length-i64 s) 0)))))

(define mangle-bare (subr kfx (string) string)
  (lambda (s)
    "A KFX name as part of a Rust name the emitter makes (`loop__knot`):
     `mangle`'s, no `r#`."
    (if (rust-keyword? s) s (mangle s))))

(define lifetime (subr kfx (string) string)
  (lambda (s)
    "A region's or place's name as a Rust lifetime: `'r`, `'r#loop`; but
     `'static_`, since `'static` is Rust's own and no raw lifetime."
    (string-append "'" (if (string=? s "static") "static_" (mangle s)))))

(define camel-chars (subr kfx (chars bool chars) chars)
  (lambda (cs up acc)
    "An operator's character as Rust's names write it (`ok?` is `Ok_p`),
     since none is a Rust name's; `-` begins a word."
    (cond ((null? cs) acc)
          ((char=? (car cs) #\-) (camel-chars (cdr cs) #t acc))
          ((not (string=? (mangle-char (car cs)) (char->string (car cs))))
           (camel-chars (cdr cs) #f (put (mangle-char (car cs)) acc)))
          (up (camel-chars (cdr cs) #f (cons (char-upcase (car cs)) acc)))
          (else (camel-chars (cdr cs) #f (cons (car cs) acc))))))

(define camel (subr kfx (string) string)
  (lambda (s)
    "A KFX name as a Rust type's: `got-list` is `GotList`."
    (rev->string (camel-chars (string-chars s) #t nil))))

(define variant-name (subr kfx (string) string)
  (lambda (s)
    "A tag's or a sum's label as a Rust variant's name: camel-cased."
    (camel s)))
