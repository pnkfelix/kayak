"emit.kfx: writing Rust."

"What the program defines"

"A tag, and its datatype's name."
(define-datatype tagof (tagof string string))
(define-type tagofs (listof tagof acyclic))

"Datatypes' names, their tags, constants (definitions not of procedures),
 and the names bound where an expression is. A name named as a value is
 a local, a constant (a call of its `fn`), or else a global procedure (a
 reference to its `fn`, the program's or kayak-rt's)."
"A family: a datatype or type abbreviation with parameters, its name,
 whether it is a datatype, and its parameters' kinds, so that a region's
 argument, erased in Rust, is dropped where it is applied."
(define-datatype family (family string bool strings))
(define-type families (listof family acyclic))

"Modules, by name: each `(module item ...)` (check.kfx, C19)."
(define-datatype ctx (ctx strings tagofs strings strings typeds facts families typeds typeds))

(define filter-typed (subr kfx (string typeds) typeds)
  (lambda (name xs)
    (cond ((null? xs) nil)
          ((tagcase (car xs) (typed (n t) (string=? n name))) (list (car xs)))
          (else (filter-typed name (cdr xs))))))

(define ctx-effects (subr kfx (ctx) typeds)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) es))))

(define-rec
  (fallible-effect? (subr kfx (ctx sexp) bool)
    (lambda (c e)
      "Whether a written effect may abort, its abbreviations seen through: a
       procedure of it returns a `Result` (docs/research/escapes.md)."
      (tagcase e
        (sym (n at-file at-pos) (any? (lambda ((x typed)) (tagcase x (typed (m body) (and (string=? m n) (fallible-effect? c body)))))
                       (ctx-effects c)))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "goto") #t)
                ((sym-is? (car xs) "maxeff") (any? (lambda ((x sexp)) (fallible-effect? c x)) (cdr xs)))
                (else #f)))
        (else other #f)))))

(define ctx-fact? (subr kfx (ctx string i64 string) bool)
  (lambda (c file pos what)
    "Whether the checker found `what` about the place `file`, `pos`."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (any? (lambda ((f fact))
                (tagcase f (fact (ff fp fw) (and (i64= fp pos) (string=? fw what) (string=? ff file)))))
              fs)))))

(define fact-at? (subr kfx (ctx sexp string) bool)
  (lambda (c e what)
    "Whether the checker found `what` about the datum `e`."
    (ctx-fact? c (datum-file e) (datum-pos e) what)))

(define-rec
  (first-fact (subr kfx (facts string i64 string) string)
    (lambda (fs file pos prefix)
      "The rest of the first fact at `file`, `pos` that begins `prefix`; or
       ``. A search, not a list made: the emitter asks at every name."
      (if (null? fs)
          ""
          (tagcase (car fs)
            (fact (ff fp fw)
              (if (and (i64= fp pos) (string=? ff file) (has-prefix? fw prefix))
                  (after-prefix fw prefix)
                  (first-fact (cdr fs) file pos prefix))))))))

(define fact-with (subr kfx (ctx sexp string) string)
  (lambda (c e prefix)
    "What the checker found about the datum `e` that begins `prefix`, the
     rest of it; or ``."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods) (first-fact fs (datum-file e) (datum-pos e) prefix)))))

"Products and sums, FX-26's structural data (check.kfx, `ty-shape`): one
 generic Rust type for each list of labels, a tuple struct for a product,
 `Product_a_b<A0, A1>`, and an enum for a sum, `Sum_leaf_node<A0, A1>`,
 a sum's values references, as a datatype's are. The name holds the labels,
 so that two products of the same labels and types are one type, as in
 FX-26."

(define-rec
  (concat-strings (subr kfx (strings) string)
    (lambda (xs) (if (null? xs) "" (string-append (car xs) (concat-strings (cdr xs)))))))

(define-rec
  (reverse-strings (subr kfx (strings strings) strings)
    (lambda (xs acc) (if (null? xs) acc (reverse-strings (cdr xs) (cons (car xs) acc))))))

(define-rec
  (split-words-from (subr kfx (chars chars strings) strings)
    (lambda (cs word acc)
      (cond ((null? cs) (if (null? word) acc (cons (rev->string word) acc)))
            ((char=? (car cs) #\space) (split-words-from (cdr cs) nil (if (null? word) acc (cons (rev->string word) acc))))
            (else (split-words-from (cdr cs) (cons (car cs) word) acc))))))

(define split-words (subr kfx (string) strings)
  (lambda (s) (reverse-strings (split-words-from (string-chars s) nil nil) nil)))

(define plain-name (subr kfx (string) string)
  (lambda (n)
    "A mangled name without its raw identifier's `r#`."
    (if (has-prefix? n "r#") (after-prefix n "r#") n)))

(define shape-name (subr kfx (bool strings) string)
  (lambda (product labels)
    "`Product_1x_1y`: each label as a Rust name, its length first, so that
     no two lists of labels, nor a type the program names, share one."
    (string-append (if product "Product" "Sum")
                   (concat-strings (map (lambda ((l string))
                                          (let ((n (plain-name (mangle l))))
                                            (string-append "_" (string-append (i64->string (string-length-i64 n)) n))))
                                        labels)))))

(define ctx-datatypes (subr kfx (ctx) strings)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ds))))

(define ctx-tags (subr kfx (ctx) tagofs)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ts))))

(define ctx-constants (subr kfx (ctx) strings)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ks))))

(define ctx-locals (subr kfx (ctx) strings)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ls))))

(define strings-onto (subr kfx (strings strings) strings)
  (lambda (xs ys) (if (null? xs) ys (strings-onto (cdr xs) (cons (car xs) ys)))))

(define module-body (subr kfx (ctx string) sexps)
  (lambda (c name)
    "What `mods` keeps under `name`, as a list of one: a module, or, under
     `%moduleof x`, a module type."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (concat (map (lambda ((x typed)) (tagcase x (typed (n body) (if (string=? n name) (the sexps (list body)) nil))))
                     mods))))))

(define-rec
  (param-module-type (subr kfx (string strings) string)
    (lambda (m ls)
      "The module type of the module parameter `m` in scope, or ``."
      (cond ((null? ls) "")
            ((string=? (car ls) m) "")
            ((has-prefix? (car ls) (string-append "%modparam " (string-append m " ")))
             (after-prefix (car ls) (string-append "%modparam " (string-append m " "))))
            (else (param-module-type m (cdr ls)))))))

(define module-items (subr kfx (ctx string) sexps)
  (lambda (c m)
    "Module `m`'s items; a module parameter's, as its type's values would be
     written (a value not a procedure a constant)."
    (let ((x (param-module-type m (ctx-locals c))))
      (if (string=? x "")
          (let ((found (module-body c m)))
            (if (null? found)
                nil
                (concat (map (lambda ((f sexp))
                               (if (head-is? f "include")
                                   (module-items c (sym-name (second (items f))))
                                   (the sexps (list f))))
                             (cdr (items (car found)))))))
          (let ((spec (module-body c (string-append "%moduleof " x))))
            (if (null? spec)
                nil
                (concat (map (lambda ((it sexp))
                               (let ((ys (items it)))
                                 (cond ((sym-is? (car ys) "val")
                                        (the sexps (list (lst (list (sym "define" "" 0) (second ys) (third ys)
                                                                    (if (head-is? (third ys) "subr") (lst (list (sym "lambda" "" 0)) "" 0 0) (sym "#u" "" 0)))
                                                              "" 0 0))))
                                       ((sym-is? (car ys) "abs")
                                        (map (lambda ((t sexp)) (lst (list (sym "define-type" "" 0) t (sym "i64" "" 0)) "" 0 0))
                                             (tagcase (second ys) (lst (ns f l p) ns) (else other (list (second ys))))))
                                       (else nil))))
                             (cdr (items (car spec)))))))))))

(define module-path (subr kfx (ctx string) string)
  (lambda (c m)
    "A module's Rust path: a module parameter's is its type parameter."
    (if (string=? (param-module-type m (ctx-locals c)) "") (mangle m) (string-append "Mod_" (camel m)))))

(define item-values (subr kfx (sexps) strings)
  (lambda (forms)
    "The names a module's items give values to: its type's values."
    (concat
     (map (lambda ((f sexp))
            (cond ((or (head-is? f "define") (head-is? f "define*")) (the strings (list (sym-name (second (items f))))))
                  ((head-is? f "define-rec") (map (lambda ((b sexp)) (sym-name (car (items b)))) (cdr (items f))))
                  ((head-is? f "define-datatype") (map (lambda ((vt sexp)) (sym-name (car (items vt)))) (cdr (cdr (items f)))))
                  (else nil)))
          forms))))

(define item-constants (subr kfx (sexps) strings)
  (lambda (forms)
    "The names a module's items give values not procedures to."
    (concat
     (map (lambda ((f sexp))
            (if (and (head-is? f "define") (not (procedure? (last (items f)))))
                (the strings (list (sym-name (second (items f)))))
                nil))
          forms))))

(define item-types (subr kfx (sexps) strings)
  (lambda (forms)
    (concat
     (map (lambda ((f sexp))
            (if (or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype"))
                (the strings (list (sym-name (second (items f)))))
                nil))
          forms))))

(define-rec
  (opener (subr kfx (string strings) string)
    (lambda (entry ls)
      "The module whose `with` gave `entry`, a value's or a type's: the
       innermost, and only if no local inside it hides it."
      (cond ((null? ls) "")
            ((string=? (car ls) entry)
             (let ((rest (after-with (cdr ls)))) rest))
            (else (opener entry (cdr ls))))))
  (after-with (subr kfx (strings) string)
    (lambda (ls)
      (cond ((null? ls) "")
            ((has-prefix? (car ls) "%with ") (after-prefix (car ls) "%with "))
            (else (after-with (cdr ls)))))))

(define-rec
  (after-in (subr kfx (strings) string)
    (lambda (ls)
      (cond ((null? ls) "")
            ((has-prefix? (car ls) "%in ") (after-prefix (car ls) "%in "))
            (else (after-in (cdr ls)))))))

(define module-here (subr kfx (ctx) string)
  (lambda (c)
    "The module whose items are being written, or ``."
    (after-in (ctx-locals c))))

(define ctx-typed (subr kfx (ctx string) sexps)
  (lambda (c name)
    "The type the checker found for a definition written with none, as a
     list of one."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (map (lambda ((x typed)) (tagcase x (typed (n t) t)))
             (filter-typed (if (string=? (after-in ls) "") name (string-append (after-in ls) (string-append " " name)))
                           xs))))))

(define with-locals (subr kfx (ctx strings) ctx)
  (lambda (c names)
    "`c`, where `names` are bound too."
    (tagcase c (ctx (ds ts ks ls xs fs ms es mods) (ctx ds ts ks (strings-onto names ls) xs fs ms es mods)))))

(define tag-datatype (subr kfx (string tagofs) string)
  (lambda (tag ts)
    (if (null? ts)
        (error (string-append "kfx: not a datatype's tag: " tag))
        (tagcase (car ts)
          (tagof (t d) (if (string=? t tag) d (tag-datatype tag (cdr ts))))))))

(define note-tags (subr kfx (sexps string tagofs) tagofs)
  (lambda (variants d ts)
    (if (null? variants)
        ts
        (note-tags (cdr variants) d
                   (cons (tagof (sym-name (car (items (car variants)))) d) ts)))))

(define type-head-name (subr kfx (sexp) string)
  (lambda (head)
    "A type definition's name, from its head: a name, or `(name binder ...)`."
    (tagcase head (lst (xs src-file src-line src-pos) (sym-name (car xs))) (else other (sym-name other)))))

(define binder-kinds (subr kfx (sexps) strings)
  (lambda (bs) (map (lambda ((b sexp)) (sym-name (second (items b)))) bs)))

(define type-params-of (subr kfx (sexps) strings)
  (lambda (bs)
    "The names of the binders of kind `type`: Rust's type parameters."
    (cond ((null? bs) nil)
          ((sym-is? (second (items (car bs))) "type")
           (cons (sym-name (car (items (car bs)))) (type-params-of (cdr bs))))
          (else (type-params-of (cdr bs))))))

(define head-type-params (subr kfx (sexp) strings)
  (lambda (head) (tagcase head (lst (xs src-file src-line src-pos) (type-params-of (cdr xs))) (else other nil))))

(define note-family (subr kfx (sexp bool families) families)
  (lambda (head datatype ms)
    (tagcase head
      (lst (xs src-file src-line src-pos) (cons (family (sym-name (car xs)) datatype (binder-kinds (cdr xs))) ms))
      (else other ms))))

(define filter-family (subr kfx (string families) families)
  (lambda (name ms)
    (cond ((null? ms) nil)
          ((tagcase (car ms) (family (n d ks) (string=? n name))) (list (car ms)))
          (else (filter-family name (cdr ms))))))

(define find-family-of (subr kfx (ctx string) families)
  (lambda (c name)
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (let ((found (filter-family name ms))) found)))))

(define put-generics-of (subr kfx (strings bool chars) chars)
  (lambda (names bounded acc)
    "`<T, U>`, or with `bounded`, `<T: Copy + 'static, U: Copy + 'static>`
     as every KFX value is; nothing for no names."
    (if (null? names)
        acc
        (put ">" (put-sep (lambda ((n string) (acc chars))
                            (let ((acc (put (camel n) acc))) (if bounded (put ": Copy + 'static" acc) acc)))
                          ", " names (put "<" acc))))))

(define note-module-datatypes (subr kfx (string sexps ctx) ctx)
  (lambda (m forms c)
    "A module's datatypes, as the program names them, `m..d`, with their tags."
    (cond ((null? forms) c)
          ((head-is? (car forms) "define-datatype")
           (let ((d (string-append m (string-append ".." (type-head-name (second (items (car forms))))))))
             (note-module-datatypes m (cdr forms)
               (tagcase c
                 (ctx (ds ts ks ls xs fs ms es mods)
                   (ctx (cons d ds) (note-tags (cdr (cdr (items (car forms)))) d ts) ks ls xs fs ms es mods))))))
          (else (note-module-datatypes m (cdr forms) c)))))

(define note (subr kfx (sexp ctx) ctx)
  (lambda (form c)
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (cond ((head-is? form "define-datatype")
               (let ((d (type-head-name (second (items form)))))
                 (ctx (cons d ds) (note-tags (cdr (cdr (items form))) d ts) ks ls xs fs
                      (note-family (second (items form)) #t ms) es mods)))
              ((and (head-is? form "define-type") (head-is? (third (items form)) "moduleof"))
               (ctx ds ts ks ls xs fs ms es (cons (typed (string-append "%moduleof " (sym-name (second (items form)))) (third (items form))) mods)))
              ((and (head-is? form "define-type") (tagcase (second (items form)) (sym (n f p) #t) (else other #f)))
               "A type abbreviation's body, kept for the typed suffixes (C32), which
                compare types as written out."
               (ctx ds ts ks ls xs fs (note-family (second (items form)) #f ms) es
                    (cons (typed (string-append "%alias " (sym-name (second (items form)))) (third (items form))) mods)))
              ((or (head-is? form "define-type") (head-is? form "define-generative"))
               (ctx ds ts ks ls xs fs (note-family (second (items form)) #f ms) es mods))
              ((head-is? form "define-effect")
               (ctx ds ts ks ls xs fs ms (cons (typed (sym-name (second (items form))) (third (items form))) es) mods))
              ((module-def? form)
               (let ((m (sym-name (second (items form)))))
                 (note-module-datatypes m (cdr (items (third (items form))))
                                        (ctx ds ts ks ls xs fs ms es (cons (typed m (third (items form))) mods)))))
              ((and (head-is? form "define")
                    (or (i64= (size (items form)) 3) (i64= (size (items form)) 4))
                    (not (procedure? (last (items form)))))
               (ctx ds ts (cons (sym-name (second (items form))) ks) ls xs fs ms es mods))
              (else c))))))

(define collect (subr kfx (sexps ctx) ctx)
  (lambda (forms c)
    (if (null? forms) c (collect (cdr forms) (note (car forms) c)))))

"Writing Rust"

(define escape-char (subr kfx (char char) string)
  (lambda (c q)
    (cond ((char=? c #\\) "\\\\")
          ((char=? c q) (string-append "\\" (char->string c)))
          ((char=? c #\newline) "\\n")
          ((char=? c #\tab) "\\t")
          (else (char->string c)))))

(define put-escaped (subr kfx (chars char chars) chars)
  (lambda (cs q acc)
    "`cs` as the inside of a Rust literal delimited by `q`."
    (if (null? cs) acc (put-escaped (cdr cs) q (put (escape-char (car cs) q) acc)))))

(define-rec
  (dotted-from (subr kfx (chars chars) strings)
    (lambda (seen cs)
      (cond ((or (null? cs) (null? (cdr cs))) nil)
            ((and (char=? (car cs) #\.) (char=? (car (cdr cs)) #\.))
             (the strings (list (rev->string seen) (list->string (cdr (cdr cs))))))
            (else (dotted-from (cons (car cs) seen) (cdr cs)))))))

(define dotted (subr kfx (string) strings)
  (lambda (s)
    "A module's type as the program names it, `m..t`: `m` and `t`; else none."
    (dotted-from nil (string-chars s))))

(define type-path (subr kfx (ctx string string) string)
  (lambda (c m t)
    "Module `m`'s type `t`, from outside it: a datatype's a reference."
    (string-append (if (string-member? (string-append m (string-append ".." t)) (ctx-datatypes c)) "&'static " "")
                   (string-append (if (string=? m "Self") m (module-path c m)) (string-append "::" (camel t))))))

(define datatype-path (subr kfx (string) string)
  (lambda (d)
    "A datatype's enum, a module's named by its path."
    (if (null? (dotted d)) (camel d) (string-append (mangle (car (dotted d))) (string-append "::" (camel (car (cdr (dotted d)))))))))

(define-rec
  (desc-type (subr kfx (ctx string strings) sexps)
    (lambda (c s ls)
      "What a module parameter's described type `s`, opened by a `with`,
       describes, as a list of one; or none."
      (cond ((null? ls) nil)
            ((has-prefix? (car ls) "%with ")
             (let* ((m (after-prefix (car ls) "%with "))
                    (x (param-module-type m (cdr ls)))
                    (spec (if (string=? x "") nil (module-body c (string-append "%moduleof " x))))
                    (found (if (null? spec) nil
                               (concat (map (lambda ((d sexp))
                                              (if (and (head-is? d "desc") (string=? (sym-name (second (items d))) s))
                                                  (the sexps (list (third (items d))))
                                                  nil))
                                            (cdr (items (car spec))))))))
               (if (null? found) (desc-type c s (cdr ls)) found)))
            (else (desc-type c s (cdr ls)))))))

(define-rec
  (words-of-sep (subr kfx (strings string) string)
    (lambda (xs sep)
      (cond ((null? xs) "")
            ((null? (cdr xs)) (car xs))
            (else (string-append (car xs) (string-append sep (words-of-sep (cdr xs) sep))))))))

"`letrena`'s regions (CLAUDES_CHOICES.md C30): each a lifetime of the
 `fn` its body is written as, `'r` for the region `r`, marked in the
 locals `%letrena r`. Every other region is the heap's, `'static`."

(define region-lifetime (subr kfx (ctx sexp) string)
  (lambda (c r)
    "The lifetime of the region `r` names, if a `letrena`'s; or ``."
    (let ((n (tagcase r (sym (x f p) (if (has-prefix? x "'") (after-prefix x "'") x)) (else other ""))))
      (if (and (not (string=? n "")) (string-member? (string-append "%letrena " n) (ctx-locals c)))
          (string-append "'" (mangle n))
          ""))))

(define fact-at-place (subr kfx (ctx string i64 string) string)
  (lambda (c file pos prefix)
    "What the checker found at `file`, `pos` that begins `prefix`, the rest;
     or ``."
    (tagcase c (ctx (ds ts ks ls xs fs ms es mods) (first-fact fs file pos prefix)))))

(define all-facts-at (subr kfx (ctx string i64 string) strings)
  (lambda (c file pos prefix)
    "Everything the checker found at `file`, `pos` that begins `prefix`."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (concat (map (lambda ((f fact))
                       (tagcase f
                         (fact (ff fp fw)
                           (if (and (i64= fp pos) (string=? ff file) (has-prefix? fw prefix)) (the strings (list fw)) nil))))
                     fs))))))

(define all-facts-prefixed (subr kfx (ctx string) strings)
  (lambda (c prefix)
    "Everything the checker found anywhere that begins `prefix`, the rest."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (concat (map (lambda ((f fact))
                       (tagcase f
                         (fact (ff fp fw) (if (has-prefix? fw prefix) (the strings (list (after-prefix fw prefix))) nil))))
                     fs))))))

(define digits-number (subr kfx (string) i64)
  (lambda (s) (i64- 0 (digits-value (string-chars s) 0 "" 0))))

(define uses-blobrefs? (subr kfx (ctx) bool)
  (lambda (c)
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (any? (lambda ((f fact)) (tagcase f (fact (ff fp fw) (has-prefix? fw "blob-at ")))) fs)))))

(define-rec
  (lifetimes-before (subr kfx (strings string) strings)
    (lambda (lives l)
      "Of the `letrena`s' lifetimes, outermost first, those outside `l`."
      (if (or (null? lives) (string=? (car lives) l)) nil (cons (car lives) (lifetimes-before (cdr lives) l))))))

(define owner-lifetime (subr kfx (ctx sexp) string)
  (lambda (c r)
    "A reference's lifetime for data at region `r`: its `letrena`'s, or the heap's."
    (let ((l (region-lifetime c r))) (if (string=? l "") "'static" l))))

(define number-text (subr kfx (sexp) string)
  (lambda (e) (tagcase e (num (k f p) (i64->string k)) (else other "0"))))

(define-rec
  (innermost-lifetime (subr kfx (strings) string)
    (lambda (ls)
      "A procedure's lifetime: the innermost `letrena`'s, whose arena a
       closure may hold; or `'static`."
      (cond ((null? ls) "'static")
            ((has-prefix? (car ls) "%letrena ") (string-append "'" (mangle (after-prefix (car ls) "%letrena "))))
            (else (innermost-lifetime (cdr ls)))))))

(define-rec
  (letrena-lifetimes (subr kfx (strings) strings)
    (lambda (ls)
      "The lifetimes of the `letrena`s around, outermost first."
      (cond ((null? ls) nil)
            ((has-prefix? (car ls) "%letrena ")
             (onto (letrena-lifetimes (cdr ls)) (list (string-append "'" (mangle (after-prefix (car ls) "%letrena "))))))
            (else (letrena-lifetimes (cdr ls)))))))

(define-rec
  (put-type (subr kfx (ctx sexp chars) chars)
    (lambda (c t acc)
      "A type. A name that is no base type or datatype is a type abbreviation
       or a type variable, either way a Rust type of the same name."
      (tagcase t
        (sym (s at-file at-pos)
          (cond ((string=? s "i64") (put "i64" acc))
                ((string=? s "int") (put "Int" acc))
                ((string=? s "nat") (put "Int" acc))
                ((string=? s "f64") (put "f64" acc))
                ((or (fixed-width? s) (string=? s "f32")) (put s acc))
                ((string=? s "bool") (put "bool" acc))
                ((string=? s "char") (put "char" acc))
                ((string=? s "unit") (put "()" acc))
                ((string=? s "void") (put "Void" acc))
                ((string=? s "string") (put "Str" acc))
                ((not (null? (dotted s))) (put (type-path c (car (dotted s)) (car (cdr (dotted s)))) acc))
                ((string-member? s (ctx-datatypes c)) (put (camel s) (put "&'static " acc)))
                ((not (null? (desc-type c s (ctx-locals c)))) (put-type c (car (desc-type c s (ctx-locals c))) acc))
                ((not (string=? (opener (string-append "%type " s) (ctx-locals c)) ""))
                 (put (type-path c (opener (string-append "%type " s) (ctx-locals c)) s) acc))
                (else (put (camel s) acc))))
        (lst (xs src-file src-line src-pos)
          (cond ((and (sym-is? (car xs) "listof") (not (string=? (region-lifetime c (third xs)) "")))
                 (put ">" (put-type c (second xs) (put ", " (put (region-lifetime c (third xs)) (put "ListAt<" acc))))))
                ((sym-is? (car xs) "listof")
                 (put ">" (put-type c (second xs) (put "List<" acc))))
                ((sym-is? (car xs) "flatarrayof")
                 (put ">" (put-type c (second xs) (put "FlatArray<" acc))))
                ((and (sym-is? (car xs) "ref") (not (string=? (region-lifetime c (third xs)) "")))
                 (put ">" (put-type c (second xs) (put ", " (put (region-lifetime c (third xs)) (put "RefAt<" acc))))))
                ((sym-is? (car xs) "ref")
                 (put ">" (put-type c (second xs) (put "Ref<" acc))))
                ((sym-is? (car xs) "subr")
                 (let* ((acc (put " dyn Fn(" (put (innermost-lifetime (ctx-locals c)) (put "&" acc))))
                        (acc (put-types c (items (third xs)) acc))
                        (acc (put ") -> " acc)))
                   (if (fallible-effect? c (second xs))
                       (put ", Unwind>" (put-type c (fourth xs) (put "Result<" acc)))
                       (put-type c (fourth xs) acc))))
                ((and (sym-is? (car xs) "place") (string-member? (string-append "%placeparam " (sym-name (second xs))) (ctx-locals c)))
                 (put (string-append "&'" (string-append (mangle (sym-name (second xs))) (string-append " Place_" (camel (sym-name (second xs)))))) acc))
                ((sym-is? (car xs) "place")
                 (let* ((r (sym-name (second xs)))
                        (lives (letrena-lifetimes (ctx-locals c)))
                        (life (string-append "'" (mangle r))))
                   (put (string-append "&" (string-append life (string-append " Region_" (string-append (camel r)
                          (string-append "<" (string-append (words-of-sep (cons life (lifetimes-before lives life)) ", ") ">"))))))
                        acc)))
                ((and (sym-is? (car xs) "bloblet") (not (null? (typed-flat c t))))
                 (put ">" (put-flat c (car (typed-flat c t))
                                    (put ", " (put-fields-tuple c (cdr (items (second xs)))
                                                                (put "TBloblet<" (put " " (put (owner-lifetime c (third xs)) (put "&" acc)))))))))
                ((sym-is? (car xs) "bloblet")
                 (put ">" (put-fields-tuple c (cdr (items (second xs)))
                                            (put "Bloblet<" (put " " (put (owner-lifetime c (third xs)) (put "&" acc)))))))
                ((and (sym-is? (car xs) "blobref") (not (null? (typed-flat c (second xs)))))
                 (put-flat c (expand-aliases c (third xs))
                           (put " " (put (owner-lifetime c (third (items (expand-aliases c (second xs))))) (put "&" acc)))))
                ((sym-is? (car xs) "blobref")
                 (put ">" (put-type c (second xs) (put "BlobRef<" acc))))
                ((sym-is? (car xs) "prompt-tag")
                 (put ">" (put-type c (third xs) (put ", " (put-type c (second xs) (put "Tag<" acc))))))
                ((sym-is? (car xs) "select")
                 (put (type-path c (sym-name (second xs)) (sym-name (third xs))) acc))
                ((or (sym-is? (car xs) "productof") (sym-is? (car xs) "sumof"))
                 (let* ((product (sym-is? (car xs) "productof"))
                        (fs (map items (cdr xs)))
                        (acc (put (shape-name product (map (lambda ((f sexps)) (label-of (car f))) fs))
                                  (if product acc (put "&'static " acc)))))
                   (if (null? fs) acc (put ">" (put-types c (map second fs) (put "<" acc))))))
                ((sym-is? (car xs) "poly")
                 (error "kfx: a poly type is only a definition's, at its top"))
                ((tagcase (car xs) (sym (n at-file at-pos) (not (null? (find-family-of c n)))) (else other #f))
                 (tagcase (car (find-family-of c (sym-name (car xs))))
                   (family (n datatype kinds)
                     (let* ((acc (if datatype (put "&'static " acc) acc))
                            (acc (put (camel n) acc))
                            (args (type-arguments (cdr xs) kinds)))
                       (if (null? args) acc (put ">" (put-types c args (put "<" acc))))))))
                (else (error "kfx: a type KFX-0 does not have"))))
        (else other (error "kfx: a type KFX-0 does not have")))))

  (put-flat (subr kfx (ctx sexp chars) chars)
    (lambda (c f acc)
      "A flat in a typed suffix (C32): a scalar's cell, a product of them, an
       array of them, `FlatArr<T, n>`."
      (tagcase f
        (sym (n fl p) (put ">" (put-type c f (put "std::cell::Cell<" acc))))
        (lst (xs fl ln p)
          (cond ((sym-is? (car xs) "arrayof")
                 (put ">" (put (number-text (third xs)) (put ", " (put-flat c (second xs) (put "FlatArr<" acc))))))
                (else
                 (let ((fs (map items (cdr xs))))
                   (put ">" (put-sep (lambda ((x sexp) acc) (put-flat c x acc)) ", " (map second fs)
                                     (put "<" (put (shape-name #t (map (lambda ((g sexps)) (label-of (car g))) fs)) acc))))))))
        (else other acc))))

  (expand-aliases (subr kfx (ctx sexp) sexp)
    (lambda (c e)
      "A type, its abbreviations written out, as the checker's facts write it."
      (tagcase e
        (sym (n fl p)
          (let ((found (module-body c (string-append "%alias " n))))
            (if (null? found) e (expand-aliases c (car found)))))
        (lst (xs fl ln p)
          (cond ((null? xs) e)
                ((or (sym-is? (car xs) "productof") (sym-is? (car xs) "sumof"))
                 (lst (cons (car xs) (map (lambda ((g sexp)) (tagcase g (lst (ys f2 l2 p2) (lst (list (car ys) (expand-aliases c (second ys))) f2 l2 p2)) (else other g)))
                                          (cdr xs)))
                      fl ln p))
                (else (lst (cons (car xs) (map (lambda ((g sexp)) (expand-aliases c g)) (cdr xs))) fl ln p))))
        (else other e))))

  (owner-key (subr kfx (ctx sexp) string)
    (lambda (c b)
      "A bloblet type's key: its fields, written out, whatever its region."
      (let ((b (expand-aliases c b)))
        (if (head-is? b "bloblet")
            (rev->string (put-fields-tuple c (cdr (items (second (items b)))) nil))
            ""))))

  (typed-flat (subr kfx (ctx sexp) sexps)
    (lambda (c b)
      "The flat a bloblet type's suffix is typed as (C32), as a list of one;
       or none. Typed if the program makes a blobref into one only by
       `blobref-at` at offset 0, always of one flat, and never reads its
       bytes otherwise (`blobref+`, `-owner`, `-offset`, `bloblet-byte`...);
       and makes every one of literal size, room for that flat."
      (let* ((key (owner-key c b))
             (fs (tagcase c (ctx (ds ts ks ls xs fs ms es mods) fs)))
             (ats (concat (map (lambda ((f fact))
                                 (tagcase f
                                   (fact (file pos what)
                                     (if (has-prefix? what "blob-at ")
                                         (let ((ts (read-all (string-chars (after-prefix what "blob-at ")) "" 1)))
                                           (if (string=? (owner-key c (car ts)) key) (the (listof fact acyclic) (list f)) nil))
                                         nil))))
                               fs))))
        (if (or (string=? key "") (null? ats))
            nil
            (let* ((flat-of (lambda ((f fact)) (tagcase f (fact (file pos what) (second (read-all (string-chars (after-prefix what "blob-at ")) "" 1))))))
                   (first (expand-aliases c (flat-of (car ats))))
                   (text (if (has-sum? first) "" (rev->string (put-flat c first nil))))
                   (size (tagcase (car ats) (fact (file pos what) (fact-at-place c file pos "blob-size "))))
                   (same (not (any? (lambda ((f fact))
                                      (tagcase f
                                        (fact (file pos what)
                                          (or (not (ctx-fact? c file pos "blob-zero"))
                                              (has-sum? (expand-aliases c (flat-of f)))
                                              (not (string=? (rev->string (put-flat c (expand-aliases c (flat-of f)) nil)) text))))))
                                    ats)))
                   (bytewise (any? (lambda ((f fact))
                                (tagcase f
                                  (fact (file pos what)
                                    (and (has-prefix? what "blob-raw ")
                                         (string=? (owner-key c (car (read-all (string-chars (after-prefix what "blob-raw ")) "" 1))) key)))))
                              fs))
                   (short (any? (lambda ((f fact))
                                  (tagcase f
                                    (fact (file pos what)
                                      (and (has-prefix? what "blob-make ")
                                           (string=? (owner-key c (car (read-all (string-chars (after-prefix what "blob-make ")) "" 1))) key)
                                           (let ((bytes (fact-at-place c file pos "blob-bytes ")))
                                             (or (string=? bytes "")
                                                 (i64< (digits-number bytes) (digits-number size))))))))
                                fs)))
              (if (and same (not bytewise) (not short) (not (has-sum? first))) (the sexps (list first)) nil))))))

  (has-sum? (subr kfx (sexp) bool)
    (lambda (f)
      "Whether a flat has a flat sum in it: a typed suffix holds none, since
       a sum's variants share their bytes, which a stale blobref to one sees
       (C33)."
      (tagcase f
        (lst (xs fl ln p) (or (sym-is? (car xs) "sumof") (any? (lambda ((x sexp)) (has-sum? x)) (cdr xs))))
        (else other #f))))

  (put-fields-tuple (subr kfx (ctx sexps chars) chars)
    (lambda (c ts acc)
      "A bloblet's fields, a tuple of cells: `(Cell<T>, ...,)`."
      (put ")" (put-sep (lambda ((t sexp) acc) (put ">," (put-type c t (put "std::cell::Cell<" acc)))) " " ts (put "(" acc)))))

  (type-arguments (subr kfx (sexps strings) sexps)
    (lambda (args kinds)
      "A family's arguments for its parameters of kind `type`: the others,
       regions, are erased."
      (cond ((or (null? args) (null? kinds)) nil)
            ((string=? (car kinds) "type") (cons (car args) (type-arguments (cdr args) (cdr kinds))))
            (else (type-arguments (cdr args) (cdr kinds))))))

  (put-types (subr kfx (ctx sexps chars) chars)
    (lambda (c types acc)
      "Types, separated by commas."
      (put-sep (lambda ((t sexp) acc) (put-type c t acc)) ", " types acc))))

(define local-kind (subr kfx (string strings) string)
  (lambda (s ls)
    "What `s` is where it is named: `local`, `knot` (a procedure of a
     `letrec`, in its group's lambdas, before it is made: reached through
     its knot), or `` (not bound locally). The innermost binding counts."
    (cond ((null? ls) "")
          ((string=? (car ls) s) "local")
          ((string=? (car ls) (string-append "%knot " s)) "knot")
          ((string=? (car ls) (string-append "%item " s)) "item")
          (else (local-kind s (cdr ls))))))

(define item-path (subr kfx (ctx string) string)
  (lambda (c s)
    "A module's value, named in a `with`: `m::x`, called if a constant."
    (let ((m (opener (string-append "%item " s) (ctx-locals c))))
      (string-append (module-path c m)
                     (string-append "::"
                                    (string-append (mangle s)
                                                   (if (string-member? s (item-constants (module-items c m))) "()" "")))))))

(define-rec
  (innermost-fallible (subr kfx (strings) bool)
    (lambda (ls)
      (cond ((null? ls) #f)
            ((string=? (car ls) "%fallible") #t)
            ((string=? (car ls) "%infallible") #f)
            (else (innermost-fallible (cdr ls)))))))

(define fallible-here? (subr kfx (ctx) bool)
  (lambda (c)
    "Whether the function or closure being written returns a `Result`: the
     innermost's mark says."
    (innermost-fallible (ctx-locals c))))

(define callee (subr kfx (ctx string) string)
  (lambda (c h)
    "A call's operator: a knot's procedure, a constant's value (a
     procedure a definition made, not a lambda), or a name."
    (let ((kind (local-kind h (ctx-locals c))))
      (cond ((string=? kind "knot") (string-append "(" (string-append (mangle h) "__knot.get())")))
            ((string=? kind "item") (item-path c h))
            ((and (string=? kind "") (string-member? h (ctx-constants c))) (string-append (mangle h) "()"))
            (else (mangle h))))))

(define put-turbofish (subr kfx (ctx sexp chars) chars)
  (lambda (c e acc)
    "`::<T, ...>`, the types the checker found the datum `e` written at (a
     poly procedure's call, a `nil`), where rustc may have nothing else to
     infer them from; nothing if it found none."
    (let ((found (fact-with c e "turbofish ")))
      (if (string=? found "")
          acc
          (put ">" (put-types c (read-all (string-chars found) "" 1) (put "::<" acc)))))))

(define plain-callee? (subr kfx (ctx string) bool)
  (lambda (c h)
    "Whether a call's operator is written as a function's path, which a
     turbofish may follow."
    (let ((kind (local-kind h (ctx-locals c))))
      (or (string=? kind "item") (and (string=? kind "") (not (string-member? h (ctx-constants c))))))))

(define put-callee (subr kfx (ctx sexp string chars) chars)
  (lambda (c e h acc)
    "A call's operator, and its turbofish if it is a function's path."
    (let ((acc (put (callee c h) acc)))
      (if (plain-callee? c h) (put-turbofish c e acc) acc))))

(define put-var (subr kfx (ctx string chars) chars)
  (lambda (c s acc)
    (cond ((string=? s "#t") (put "true" acc))
          ((string=? s "#f") (put "false" acc))
          ((string=? s "#u") (put "()" acc))
          ((string=? (local-kind s (ctx-locals c)) "knot") (put ".get()" (put "__knot" (put (mangle s) acc))))
          ((string=? (local-kind s (ctx-locals c)) "local") (put (mangle s) acc))
          ((string=? (local-kind s (ctx-locals c)) "item")
           (let ((m (opener (string-append "%item " s) (ctx-locals c))))
             (put (item-path c s) (if (string-member? s (item-constants (module-items c m))) acc (put "&" acc)))))
          ((or (string=? s "nil") (string-member? s (ctx-constants c)))
           (put "()" (put (mangle s) acc)))
          (else (put (mangle s) (put "&" acc))))))

(define put-spaces (subr kfx (i64 chars) chars)
  (lambda (k acc) (if (i64= k 0) acc (put-spaces (i64- k 1) (put "    " acc)))))

(define put-nl (subr kfx (i64 chars) chars)
  (lambda (n acc)
    "A new line, indented `n` levels."
    (put-spaces n (put "\n" acc))))

(define put-comment (subr kfx (chars string i64 bool chars) chars)
  (lambda (cs prefix n fresh acc)
    "A string literal where a body's value is not taken is a comment: KFX's
     comments are strings, since `;` comments do not survive reading. Each of
     its lines is written after `prefix` (`//` or `///`), leading spaces
     dropped; `fresh` says no prefix has been written for this line yet."
    (cond ((null? cs) acc)
          ((char=? (car cs) #\newline)
           (put-comment (cdr cs) prefix n #t (put-nl n (if fresh (put prefix acc) acc))))
          ((and fresh (char=? (car cs) #\space)) (put-comment (cdr cs) prefix n #t acc))
          (fresh (put-comment (cdr cs) prefix n #f (cons (car cs) (put " " (put prefix acc)))))
          (else (put-comment (cdr cs) prefix n #f (cons (car cs) acc))))))

(define comment? (subr kfx (sexp) bool)
  (lambda (e) (tagcase e (str (s at-file at-pos) #t) (else other #f))))

(define comment-text (subr kfx (sexp) string)
  (lambda (e) (tagcase e (str (s at-file at-pos) s) (else other ""))))

(define put-names (subr kfx (sexps chars) chars)
  (lambda (xs acc)
    "Names, separated by commas."
    (put-sep (lambda ((x sexp) acc) (put (mangle (sym-name x)) acc)) ", " xs acc)))

"Self tail calls. Rust has no tail calls, so a procedure that calls itself
 last is a `loop`: the call assigns its parameters and `continue`s, and
 everything else it could end with is `return`ed."

(define-datatype tail
  (value)
  (returns string strings bool bool)
  (ok-value))

"`value`: an expression whose value is used. `returns`: the last thing a
 looping procedure does, with the procedure's name and parameters; the
 flag is false where a binding hides a parameter, since an assignment
 would then reach the binding, not the parameter."

(define binding-name (subr kfx (sexp) string)
  (lambda (binding) (sym-name (car (items binding)))))

(define hide (subr kfx (tail strings) tail)
  (lambda (t names)
    "`t`, under bindings of `names`: no longer a loop if one hides a
     parameter, or the procedure's own name (a call of it is the local's)."
    (tagcase t
      (returns (f ps live ok) (if (and live (any? (lambda ((x string)) (or (string=? x f) (string-member? x ps))) names)) (returns f ps #f ok) t))
      (else other t))))

(define ok-value? (subr kfx (tail) bool)
  (lambda (t) (tagcase t (ok-value () #t) (else other #f))))

(define returns-ok? (subr kfx (tail) bool)
  (lambda (t) (tagcase t (returns (f ps live ok) ok) (else other #f))))

(define returns? (subr kfx (tail) bool)
  (lambda (t) (tagcase t (returns (f ps live ok) #t) (else other #f))))

(define-rec
  (map2-params (subr kfx (sexps sexps) sexps)
    (lambda (params types)
      (if (or (null? params) (null? types))
          params
          (cons (tagcase (car params)
                  (sym (n at-file at-pos) (lst (list (car params) (car types)) "" 0 0))
                  (else other other))
                (map2-params (cdr params) (cdr types)))))))

(define typed-lambda (subr kfx (sexp sexp) sexp)
  (lambda (lam typ)
    "A letrec's lambda, its parameters given the types its binding's says,
     so that Rust need not infer a closure's from its uses: it cannot, where
     the first is a `match` (a lambda's place kept, for its facts)."
    (tagcase lam
      (lst (xs file line pos)
        (lst (cons (car xs)
                   (cons (lst (map2-params (items (second xs)) (items (third (items typ)))) "" 0 0)
                         (cdr (cdr xs))))
             file line pos))
      (else other lam))))

(define module-name? (subr kfx (ctx sexp) bool)
  (lambda (c x)
    "Whether `x` names a module defined at the top level, not hidden."
    (tagcase x
      (sym (n at-file at-pos) (and (string=? (local-kind n (ctx-locals c)) "") (not (null? (module-body c n)))))
      (else other #f))))

(define case-kind (subr kfx (ctx sexp) string)
  (lambda (c e)
    "What a case is on, as the checker found."
    (cond ((fact-at? c e "case int") "int")
          ((fact-at? c e "case string") "string")
          ((fact-at? c e "case bool") "bool")
          (else "char"))))

(define lambda-params-typed (subr kfx (ctx sexp sexps) sexps)
  (lambda (c e params)
    "A lambda's parameters, each written with no type given the one the
     checker found, where it found them all: Rust may not find a closure's
     parameter's type from its uses."
    (let ((found (fact-with c e "param-types ")))
      (if (string=? found "")
          params
          (map2-params params (items (car (read-all (string-chars found) "" 1))))))))

(define-rec
  (put-arg-names (subr kfx (i64 i64 chars) chars)
    (lambda (i n acc)
      (if (i64< i n) (put-arg-names (i64+ i 1) n (put (i64->string i) (put (if (i64= i 0) "a__" ", a__") acc))) acc))))

(define abort? (subr kfx (ctx sexp) bool)
  (lambda (c e)
    "An abort: `return Err(...)` in Rust, so no value to return or wrap."
    (and (head-is? e "abort-current-continuation")
         (string=? (local-kind "abort-current-continuation" (ctx-locals c)) ""))))

(define self-call? (subr kfx (tail sexp) bool)
  (lambda (t e)
    (tagcase t
      (returns (f ps live ok)
        (and live (head-is? e f) (i64= (size (cdr (items e))) (size ps))))
      (else other #f))))

(define control? (subr kfx (sexp) bool)
  (lambda (e)
    "The forms whose last parts stand where they do."
    (or (head-is? e "if") (head-is? e "cond") (head-is? e "case") (head-is? e "tagcase")
        (head-is? e "let") (head-is? e "let*") (head-is? e "begin") (head-is? e "letrec")
        (head-is? e "letregion") (head-is? e "with"))))

(define with-opened (subr kfx (ctx sexp) ctx)
  (lambda (c e)
    "`c` in `(with m ...)`: `m`'s values and types, hiding what is outside."
    (let* ((m (sym-name (second (items e))))
           (forms (module-items c m)))
      (with-locals c (cons (string-append "%with " m)
                           (onto (map (lambda ((x string)) (string-append "%type " x)) (item-types forms))
                                 (map (lambda ((x string)) (string-append "%item " x)) (item-values forms))))))))

(define opened-tail (subr kfx (ctx sexp tail) tail)
  (lambda (c e t)
    "`t` in `(with m ...)`: a procedure `m` gives, named as the one written,
     is not it, and a parameter `m` hides is not to be assigned."
    (let ((names (item-values (module-items c (sym-name (second (items e)))))))
      (tagcase t
        (returns (f ps live ok)
          (if (string-member? f names) (returns f ps #f ok) (hide t names)))
        (else other t)))))

(define-rec
  (tail-calls? (subr kfx (tail sexp) bool)
    (lambda (t e)
      "Whether `e`, standing at `t`, makes a self tail call: whether its
       procedure loops."
      (cond ((self-call? t e) #t)
            ((head-is? e "if")
             (let ((xs (cdr (items e))))
               (or (tail-calls? t (second xs)) (tail-calls? t (third xs)))))
            ((head-is? e "cond") (arms-tail-calls? t (cdr (items e))))
            ((head-is? e "case") (arms-tail-calls? t (cdr (cdr (items e)))))
            ((head-is? e "tagcase") (tag-arms-tail-calls? t (cdr (cdr (items e)))))
            ((or (head-is? e "let") (head-is? e "let*") (head-is? e "letrec"))
             (let ((xs (cdr (items e))))
               (tail-calls? (hide t (map binding-name (items (car xs)))) (last (cdr xs)))))
            ((head-is? e "begin") (tail-calls? t (last (cdr (items e)))))
            ((head-is? e "letregion") (tail-calls? t (last (cdr (cdr (items e))))))
            (else #f))))
  (arms-tail-calls? (subr kfx (tail sexps) bool)
    (lambda (t arms)
      "A `cond`'s clauses, or a `case`'s arms: each a test or data, then a body."
      (cond ((null? arms) #f)
            ((tail-calls? t (last (cdr (items (car arms))))) #t)
            (else (arms-tail-calls? t (cdr arms))))))
  (tag-arms-tail-calls? (subr kfx (tail sexps) bool)
    (lambda (t arms)
      (if (null? arms)
          #f
          (let* ((arm (items (car arms)))
                 (bound (if (or (sym-is? (car arm) "else") (tagcase (second arm) (sym (x at-file at-pos) #t) (else other #f)))
                            (the strings (list (sym-name (second arm))))
                            (map sym-name (items (second arm))))))
            (or (tail-calls? (hide t bound) (last (cdr (cdr arm))))
                (tag-arms-tail-calls? t (cdr arms))))))))

(define-datatype assign (assign strings sexps))

(define changes (subr kfx (strings sexps) assign)
  (lambda (ps args)
    "The parameters a self tail call changes, and their new values: an
     argument that is the parameter itself changes nothing."
    (if (null? ps)
        (assign nil nil)
        (tagcase (changes (cdr ps) (cdr args))
          (assign (names values)
            (if (sym-is? (car args) (car ps))
                (assign names values)
                (assign (cons (car ps) names) (cons (car args) values))))))))

(define put-strings (subr kfx (strings chars) chars)
  (lambda (xs acc)
    "Names, mangled, separated by commas."
    (put-sep (lambda ((x string) acc) (put (mangle x) acc)) ", " xs acc)))

(define-rec
  (distinct-strings (subr kfx (strings) strings)
    (lambda (xs)
      "`xs`, each once, in the order of its first."
      (if (null? xs)
          nil
          (cons (car xs) (distinct-strings (concat (map (lambda ((x string)) (if (string=? x (car xs)) nil (the strings (list x)))) (cdr xs)))))))))

(define-rec
  (allocations (subr kfx (string sexps) sexps)
    (lambda (r es)
      "The `rcons`es and `rnew`s in `es` that make in the place `r`."
      (concat (map (lambda ((e sexp))
                     (tagcase e
                       (lst (xs f l p)
                         (if (and (or (head-is? e "rcons") (head-is? e "rnew") (head-is? e "rmake-bloblet")) (not (null? (cdr xs))) (sym-is? (second xs) r))
                             (the sexps (cons e (allocations r (cdr xs))))
                             (allocations r xs)))
                       (else other nil)))
                   es)))))

(define-rec
  (put-held-fields (subr kfx (strings i64 chars) chars)
    (lambda (held i acc)
      (if (null? held)
          acc
          (put-held-fields (cdr held) (i64+ i 1)
                           (put (string-append " a" (string-append (i64->string i) (string-append ": Arena<" (string-append (car held) ">,")))) acc))))))

(define-rec
  (put-held-impls (subr kfx (strings i64 string string i64 chars) chars)
    (lambda (held i region lives n acc)
      "`Holds` for each type the region holds: its arena."
      (if (null? held)
          acc
          (put-held-impls (cdr held) (i64+ i 1) region lives n
            (put (string-append "impl<" (string-append lives (string-append "> Holds<" (string-append (car held)
                   (string-append "> for " (string-append region (string-append "<" (string-append lives
                     (string-append "> { fn arena(&self) -> &Arena<" (string-append (car held)
                       (string-append "> { &self.a" (string-append (i64->string i) " } }"))))))))))))
                 (put-nl n acc)))))))

(define-rec
  (datums-in (subr kfx (sexps) sexps)
    (lambda (es)
      "Every list in `es`, at any depth: the places facts are at."
      (concat (map (lambda ((e sexp))
                     (tagcase e
                       (lst (xs f l p) (the sexps (cons e (datums-in xs))))
                       (else other nil)))
                   es)))))

(define-rec
  (split-chars (subr kfx (chars char chars) strings)
    (lambda (cs c acc)
      (cond ((null? cs) (list (rev->string acc)))
            ((char=? (car cs) c) (cons (rev->string acc) (split-chars (cdr cs) c nil)))
            (else (split-chars (cdr cs) c (cons (car cs) acc)))))))

(define split-at-char (subr kfx (string char) strings)
  (lambda (s c) (split-chars (string-chars s) c nil)))

(define second-string (subr kfx (strings) string)
  (lambda (xs) (if (or (null? xs) (null? (cdr xs))) "0" (car (cdr xs)))))

(define blob-typed (subr kfx (ctx sexp string) sexps)
  (lambda (c e prefix)
    "The flat of the typed suffix (C32) of the owner the checker noted at
     `e` under `prefix`, as a list of one; or none."
    (let ((found (fact-with c e prefix)))
      (if (string=? found "") nil (typed-flat c (car (read-all (string-chars found) "" 1)))))))

"Every writer of an expression takes `n`, the indentation of the line it
 starts on, and `t`, where the expression stands."
(define-rec
  (put-exp (subr kfx (ctx sexp i64 tail chars) chars)
    (lambda (c e n t acc)
      (cond ((self-call? t e) (put-continue c (cdr (items e)) n t acc))
            ((and (returns? t) (abort? c e)) (put ";" (put-exp c e n (value) acc)))
            ((and (returns? t) (not (control? e)))
             (if (returns-ok? t)
                 (put ");" (put-exp c e n (value) (put "return Ok(" acc)))
                 (put ";" (put-exp c e n (value) (put "return " acc)))))
            ((and (ok-value? t) (not (control? e)) (not (abort? c e)))
             (put ")" (put-exp c e n (value) (put "Ok(" acc))))
            ((and (not (string=? (fact-with c e "lift ") ""))
                  (not (string-member? (string-append "%lifted " (string-append (datum-file e) (i64->string (datum-pos e)))) (ctx-locals c))))
             "A procedure that cannot abort where one that may is wanted: a
              closure that returns its value `Ok`."
             (let* ((lift (digits-number (fact-with c e "lift ")))
                    (acc (put (i64->string lift) (put "lambda" acc)))
                    (acc (put "(move |" acc))
                    (acc (put-arg-names 0 lift acc))
                    (acc (put "| Ok((" acc))
                    (acc (put-exp (with-locals c (list (string-append "%lifted " (string-append (datum-file e) (i64->string (datum-pos e)))))) e n (value) acc))
                    (acc (put ")(" acc))
                    (acc (put-arg-names 0 lift acc)))
               (put ")))" acc)))
            (else
             (tagcase e
               (num (k num-file num-pos)
                 (cond ((ctx-fact? c num-file num-pos "int") (put ")" (put (i64->string k) (put "int_lit(" acc))))
                       ((ctx-fact? c num-file num-pos "fixed i32") (put "i32" (put (i64->string k) acc)))
                       ((ctx-fact? c num-file num-pos "fixed u32") (put "u32" (put (i64->string k) acc)))
                       ((ctx-fact? c num-file num-pos "fixed u64") (put "u64" (put (i64->string k) acc)))
                       (else (put "i64" (put (i64->string k) acc)))))
               (big (text f p)
                 (if (ctx-fact? c f p "fixed u64")
                     (put "u64" (put text acc))
                     (put "\")" (put text (put "int_text(\"" acc)))))
               (chr (ch at-file at-pos) (put "'" (put-escaped (list ch) #\' (put "'" acc))))
               (real (x at-file at-pos)
                 "As Rust writes a double: a digit after the point (`1.` is `1.0`)."
                 (put "f64" (if (char=? (last (string-chars x)) #\.) (put "0" (put x acc)) (put x acc))))
               (str (s at-file at-pos) (put "\")" (put-escaped (string-chars s) #\" (put "str_lit(\"" acc))))
               (sym (s at-file at-pos)
                 (if (and (string=? s "nil") (string=? (local-kind s (ctx-locals c)) ""))
                     (put "()" (put-turbofish c e (put "nil" acc)))
                     (put-var c s acc)))
               (lst (xs src-file src-line src-pos)
                 (cond ((fact-at? c e "void-call") (put " {}" (put-call c e xs n t (put "match " acc))))
                       ((fact-at? c e "void-error") (put ")" (put-call c e xs n t (put "the::<Void>(" acc))))
                       (else (put-call c e xs n t acc)))))))))

  (put-call (subr kfx (ctx sexp sexps i64 tail chars) chars)
    (lambda (c e xs n t acc)
      "A list form; a call giving a `Void` the caller wraps, `match ... {}`,
       which is of any type, as FX-26's `void` is below every type."
      (tagcase (car xs)
        (sym (h at-file at-pos) (put-form c e h (cdr xs) n t acc))
        (else head
          (let* ((acc (put "(" acc))
                 (acc (put-exp c head n (value) acc))
                 (acc (put ")(" acc)))
            (put-question c e (put ")" (if (null? (cdr xs)) acc (put-joined c (cdr xs) ", " n acc)))))))))

  (put-continue (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c args n t acc)
      "A self tail call: the parameters it changes assigned, all at once."
      (tagcase t
        (returns (f ps live ok)
          (tagcase (changes ps args)
            (assign (names values)
              (let ((acc (cond ((null? names) acc)
                               ((null? (cdr names))
                                (let* ((acc (put (mangle (car names)) acc))
                                       (acc (put " = " acc))
                                       (acc (put-exp c (car values) n (value) acc)))
                                  (put-nl n (put ";" acc))))
                               (else
                                (let* ((acc (put "(" acc))
                                       (acc (put-strings names acc))
                                       (acc (put ") = (" acc))
                                       (acc (put-joined c values ", " n acc)))
                                  (put-nl n (put ");" acc)))))))
                (put "continue;" acc)))))
        (else other (error "kfx: a self tail call where no procedure loops")))))

  (put-joined (subr kfx (ctx sexps string i64 chars) chars)
    (lambda (c xs sep n acc)
      "Expressions separated by `sep`."
      (put-sep (lambda ((x sexp) acc) (put-exp c x n (value) acc)) sep xs acc)))

  (put-stmts (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c es n t acc)
      "A body as the inside of a block: each expression on a line of its own,
       the last standing at `t`. A last `let`, `let*`, `begin` or `tagcase`
       is written into the block rather than as a block of its own."
      (let ((e (car es)))
        (cond ((not (null? (cdr es)))
               (let ((acc (if (comment? e)
                              (put-comment (string-chars (comment-text e)) "//" n #t acc)
                              (put ";" (put-exp c e n (value) acc)))))
                 (put-stmts c (cdr es) n t (put-nl n acc))))
              ((or (head-is? e "let") (head-is? e "let*"))
               (let* ((xs (cdr (items e)))
                      (names (map binding-name (items (car xs)))))
                 (put-stmts (with-locals c names) (cdr xs) n (hide t names)
                            (if (head-is? e "let")
                                (put-let c (items (car xs)) n acc)
                                (put-let* c (items (car xs)) n acc)))))
              ((head-is? e "begin") (put-stmts c (cdr (items e)) n t acc))
              ((head-is? e "letregion") (put-stmts c (cdr (cdr (items e))) n t acc))
              ((head-is? e "with") (put-stmts (with-opened c e) (cdr (cdr (items e))) n (opened-tail c e t) acc))
              ((head-is? e "letrec")
               (let* ((xs (cdr (items e)))
                      (bindings (items (car xs)))
                      (names (map binding-name bindings)))
                 (put-stmts (with-locals c names) (cdr xs) n (hide t names)
                            (put-letrec c bindings names n acc))))
              ((head-is? e "tagcase") (put-tagcase c e (cdr (items e)) n t acc))
              (else (put-exp c e n t acc))))))

  (put-block (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c es n t acc)
      (let* ((acc (put-nl (i64+ n 1) (put "{" acc)))
             (acc (put-stmts c es (i64+ n 1) t acc)))
        (put "}" (put-nl n acc)))))

  (put-cond (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c clauses n t acc)
      (let ((clause (items (car clauses))))
        (if (sym-is? (car clause) "else")
            (put-block c (cdr clause) n t acc)
            (let* ((acc (put "if " acc))
                   (acc (put-exp c (car clause) n (value) acc))
                   (acc (put " " acc))
                   (acc (put-block c (cdr clause) n t acc))
                   (acc (put " else " acc)))
              (put-cond c (cdr clauses) n t acc))))))

  (put-let1 (subr kfx (ctx sexp i64 chars) chars)
    (lambda (c binding n acc)
      (let* ((acc (put "let " acc))
             (acc (put (mangle (sym-name (car (items binding)))) acc))
             (acc (put " = " acc))
             (acc (put-exp c (second (items binding)) n (value) acc)))
        (put-nl n (put ";" acc)))))

  (put-let* (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c bindings n acc)
      "Each binding sees those before it."
      (if (null? bindings)
          acc
          (put-let* (with-locals c (map binding-name (list (car bindings)))) (cdr bindings) n
                    (put-let1 c (car bindings) n acc)))))

  (put-binding-values (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c bindings n acc)
      (let ((acc (put-exp c (second (items (car bindings))) n (value) acc)))
        (if (null? (cdr bindings))
            acc
            (put-binding-values c (cdr bindings) n (put ", " acc))))))

  (put-binding-names (subr kfx (sexps chars) chars)
    (lambda (bindings acc)
      (let ((acc (put (mangle (sym-name (car (items (car bindings))))) acc)))
        (if (null? (cdr bindings))
            acc
            (put-binding-names (cdr bindings) (put ", " acc))))))

  (put-let (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c bindings n acc)
      "`let` binds in parallel: more than one binding is a tuple."
      (cond ((null? bindings) acc)
            ((null? (cdr bindings)) (put-let1 c (car bindings) n acc))
            (else
             (let* ((acc (put "let (" acc))
                    (acc (put-binding-names bindings acc))
                    (acc (put ") = (" acc))
                    (acc (put-binding-values c bindings n acc)))
               (put-nl n (put ");" acc)))))))

  (put-case-arms (subr kfx (ctx string sexps i64 tail chars) chars)
    (lambda (c kind arms n t acc)
      "A `match` arm a case arm: a character's and a boolean's data its
       patterns; an int's or a string's, compared in its guard, as Rust has
       no patterns for them."
      (if (null? arms)
          acc
          (let* ((arm (items (car arms)))
                 (acc (put-nl n acc))
                 (acc (cond ((sym-is? (car arm) "else") (put "_" acc))
                            ((or (string=? kind "int") (string=? kind "string"))
                             (put-sep (lambda ((d sexp) (acc chars))
                                        (put ")" (put-exp c d n (value) (put (if (string=? kind "int") "kayak_rt::_eq(case_, " "kayak_rt::string_eq_p(case_, ") acc))))
                                      " || " (items (car arm)) (put "case_ if " acc)))
                            (else (put-joined c (items (car arm)) " | " n acc))))
                 (acc (put " => " acc))
                 (acc (put-block c (cdr arm) n t acc)))
            (put-case-arms c kind (cdr arms) n t acc)))))

  (put-tagcase-arms (subr kfx (ctx string sexps i64 tail chars) chars)
    (lambda (c sum arms n t acc)
      (if (null? arms)
          acc
          (let* ((arm (items (car arms)))
                 (tag (sym-name (car arm)))
                 (else? (string=? tag "else"))
                 (whole? (tagcase (second arm) (sym (x at-file at-pos) #t) (else other #f)))
                 (bound (if (or else? whole?)
                            (the strings (list (sym-name (second arm))))
                            (map sym-name (items (second arm)))))
                 (acc (put-nl n acc))
                 (acc (if else?
                          (let* ((acc (put "_ => {" acc))
                                 (acc (put-nl (i64+ n 1) acc))
                                 (acc (put "let " acc))
                                 (acc (put (mangle (sym-name (second arm))) acc)))
                            (put-nl (i64+ n 1) (put " = tagcase_;" acc)))
                          (let* ((acc (put (if (string=? sum "") (datatype-path (tag-datatype tag (ctx-tags c))) sum) acc))
                                 (acc (put "::" acc))
                                 (acc (put (camel tag) acc))
                                 (acc (put "(" acc)))
                            (cond ((string=? sum "") (put-nl (i64+ n 1) (put ") => {" (put-names (items (second arm)) acc))))
                                  (whole? (put-nl (i64+ n 1) (put ") => {" (put (mangle (sym-name (second arm))) acc))))
                                  (else (put-fields-of (items (second arm)) 0 (i64+ n 1)
                                                       (put-nl (i64+ n 1) (put "product_) => {" acc))))))))
                 (acc (put-stmts (with-locals c bound) (cdr (cdr arm)) (i64+ n 1) (hide t bound) acc))
                 (acc (put "}" (put-nl n acc))))
            (put-tagcase-arms c sum (cdr arms) n t acc)))))

  (put-fields-of (subr kfx (sexps i64 i64 chars) chars)
    (lambda (names i n acc)
      "A sum's member, a product, taken apart: a `let` for each field."
      (if (null? names)
          acc
          (put-fields-of (cdr names) (i64+ i 1) n
                         (put-nl n (put ";" (put (i64->string i) (put " = product_." (put (mangle (sym-name (car names))) (put "let " acc))))))))))

  (put-tagcase (subr kfx (ctx sexp sexps i64 tail chars) chars)
    (lambda (c e xs n t acc)
      "A `tagcase` as statements: its value bound once, then a `match`; of a
       sum, its enum's name from the tags the checker found."
      (if (not (string=? (fact-with c e "blob-tagcase ") ""))
          (put-flat-tagcase c e xs n t acc)
      (let* ((tags (fact-with c e "tagcase-sum "))
             (sum (if (string=? tags "") "" (shape-name #f (split-words tags))))
             (acc (put "let tagcase_ = " acc))
             (acc (put-exp c (car xs) n (value) acc))
             (acc (put-nl n (put ";" acc)))
             (acc (put "match *tagcase_ {" acc))
             (acc (put-tagcase-arms c sum (cdr xs) (i64+ n 1) t acc)))
        (put "}" (put-nl n acc))))))

  (put-flat-tagcase (subr kfx (ctx sexp sexps i64 tail chars) chars)
    (lambda (c e xs n t acc)
      "A `tagcase` on a blobref to a flat sum (C33): its tag read once, of
       the key's width; each arm's name a blobref to the variant, past the
       tag; a tag no arm has, `else`'s, or an error, as in FX-26."
      (let* ((found (split-words (fact-with c e "blob-tagcase ")))
             (acc (put "let tagcase_ = " acc))
             (acc (put-exp c (car xs) n (value) acc))
             (acc (put-nl n (put ";" acc)))
             (acc (put (string-append "match tagcase_.tag(" (string-append (car found) ") {")) acc))
             (acc (put-flat-arms c (second-string found) (cdr xs) (i64+ n 1) t acc))
             (acc (if (any? (lambda ((a sexp)) (sym-is? (car (items a)) "else")) (cdr xs))
                      acc
                      (put "_ => no_flat_tag()," (put-nl (i64+ n 1) acc)))))
        (put "}" (put-nl n acc)))))

  (put-flat-arms (subr kfx (ctx string sexps i64 tail chars) chars)
    (lambda (c off arms n t acc)
      (if (null? arms)
          acc
          (let* ((arm (items (car arms)))
                 (else? (sym-is? (car arm) "else"))
                 (x (sym-name (second arm)))
                 (acc (put-nl n acc))
                 (acc (put (if else? "_ => {" (string-append (number-text (car arm)) " => {")) acc))
                 (acc (put-nl (i64+ n 1) acc))
                 (acc (put (string-append "let " (string-append (mangle x) (if else? " = tagcase_;" (string-append " = tagcase_.field(" (string-append off ");"))))) acc))
                 (acc (put-nl (i64+ n 1) acc))
                 (acc (put-stmts (with-locals c (list x)) (cdr (cdr arm)) (i64+ n 1) (hide t (list x)) acc))
                 (acc (put "}" (put-nl n acc))))
            (put-flat-arms c off (cdr arms) n t acc)))))

  (put-lambda (subr kfx (ctx sexp sexps sexps i64 chars) chars)
    (lambda (c e params body n acc)
      "A lambda as a value: a closure, `move`, since what it captures is
       `Copy`, made a `&'static dyn Fn` by `lambdaN`, `N` its arity."
      (let* ((acc (put "lambda" acc))
             (acc (put (i64->string (size params)) acc))
             (acc (put "(move |" acc))
             (acc (put-lambda-params c (lambda-params-typed c e params) acc))
             (acc (put "| " acc)))
        (if (fact-at? c e "fallible")
            (put ")" (put-block (with-locals c (cons "%fallible" (map param-name params))) body n (ok-value) acc))
            (put ")" (put-block (with-locals c (cons "%infallible" (map param-name params))) body n (value) acc))))))

  (put-lambda-params (subr kfx (ctx sexps chars) chars)
    (lambda (c params acc)
      "`x`, or `(x T)` as `x: T`."
      (if (null? params)
          acc
          (let ((acc (tagcase (car params)
                       (lst (xt src-file src-line src-pos) (put-type c (second xt) (put ": " (put (mangle (sym-name (car xt))) acc))))
                       (else name (put (mangle (sym-name name)) acc)))))
            (put-lambda-params c (cdr params) (if (null? (cdr params)) acc (put ", " acc)))))))

  (put-letrec (subr kfx (ctx sexps strings i64 chars) chars)
    (lambda (c bindings names n acc)
      "A letrec's procedures, made through knots: each knot made, then each
       closure, whose group it reaches through the knots, then each knot
       tied; a statement a line."
      (let* ((inside (with-locals c (map (lambda ((x string)) (string-append "%knot " x)) names)))
             (acc (put-sep (lambda ((b sexp) (acc chars))
                             (let* ((ys (items b))
                                    (acc (put "let " acc))
                                    (acc (put (mangle (sym-name (car ys))) acc))
                                    (acc (put "__knot = knot::<" acc))
                                    (acc (put-type c (second ys) acc)))
                               (put-nl n (put ">();" acc))))
                           "" bindings acc))
             (acc (put-sep (lambda ((b sexp) (acc chars))
                             (let* ((ys (items b))
                                    (acc (put "let " acc))
                                    (acc (put (mangle (sym-name (car ys))) acc))
                                    (acc (put " = " acc))
                                    (acc (put-exp inside (typed-lambda (third ys) (second ys)) n (value) acc)))
                               (put-nl n (put ";" acc))))
                           "" bindings acc)))
        (put-sep (lambda ((x string) (acc chars))
                   (put-nl n (put ");" (put (mangle x) (put "__knot.set(" (put (mangle x) acc))))))
                 "" names acc))))

  (put-list (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c xs n acc)
      (if (null? xs)
          (put "kayak_rt::nil()" acc)
          (let* ((acc (put "kayak_rt::cons(" acc))
                 (acc (put-exp c (car xs) n (value) acc))
                 (acc (put ", " acc))
                 (acc (put-list c (cdr xs) n acc)))
            (put ")" acc)))))

  (put-form (subr kfx (ctx sexp string sexps i64 tail chars) chars)
    (lambda (c e h xs n t acc)
      "`e` is the whole form, `h` its head's name and `xs` the rest."
      (cond ((string=? h "if")
             (let* ((acc (put "if " acc))
                    (acc (put-exp c (car xs) n (value) acc))
                    (acc (put " " acc))
                    (acc (put-block c (list (second xs)) n t acc))
                    (acc (put " else " acc)))
               (put-block c (list (third xs)) n t acc)))
            ((string=? h "cond") (put-cond c xs n t acc))
            ((string=? h "and")
             (if (null? xs) (put "true" acc) (put ")" (put-joined c xs " && " n (put "(" acc)))))
            ((string=? h "or")
             (if (null? xs) (put "false" acc) (put ")" (put-joined c xs " || " n (put "(" acc)))))
            ((and (string=? h "with") (null? (cdr (cdr xs))))
             "A `with` of one expression, no block: only its names are its."
             (put-exp (with-opened c e) (second xs) n (opened-tail c e t) acc))
            ((or (string=? h "begin") (string=? h "let") (string=? h "let*") (string=? h "tagcase") (string=? h "with"))
             (put-block c (list e) n t acc))
            ((string=? h "case")
             (let* ((acc (put "match " acc))
                    (acc (put-exp c (car xs) n (value) acc))
                    (acc (put " {" acc))
                    (acc (put-case-arms c (case-kind c e) (cdr xs) (i64+ n 1) t acc)))
               (put "}" (put-nl n acc))))
            ((string=? h "lambda") (put-lambda c e (items (car xs)) (cdr xs) n acc))
            ((string=? h "product")
             (let* ((fs (map items xs))
                    (acc (put (shape-name #t (map (lambda ((f sexps)) (label-of (car f))) fs)) acc)))
               (put ")" (put-joined c (map second fs) ", " n (put "(" acc)))))
            ((string=? h "extract")
             (cond ((not (null? (blob-typed c e "blob-owner ")))
                    (put ")" (put (fact-with c e "blob-field ") (put ")." (put-exp c (car xs) n (value) (put "(&(" acc))))))
                   ((string=? (fact-with c e "blob-offset ") "")
                    (put (fact-with c e "extract-index ") (put "." (put-exp c (car xs) n (value) acc))))
                   (else (put ")" (put (fact-with c e "blob-offset ") (put ").field(" (put-exp c (car xs) n (value) (put "(" acc))))))))
            ((string=? h "sum")
             "A sum's enum written with its type's arguments, which only the type
              expected, as the checker found it, says."
             (let* ((ty (car (read-all (string-chars (fact-with c e "sum-type ")) "" 1)))
                    (fs (map items (cdr (items ty))))
                    (acc (put "alloc(" acc))
                    (acc (put (shape-name #f (map (lambda ((f sexps)) (label-of (car f))) fs)) acc))
                    (acc (put ">::" (put-types c (map second fs) (put "::<" acc))))
                    (acc (put (camel (label-of (car xs))) acc))
                    (acc (put "(" acc)))
               (put "))" (put-exp c (second xs) n (value) acc))))
            ((and (string=? h "list") (null? xs)) (put "()" (put-turbofish c e (put "kayak_rt::nil" acc))))
            ((string=? h "list") (put-list c xs n acc))
            ((string=? h "the")
             "`the::<T>(e)`: the type said to rustc too, which may need it where
              FX-26's checker did (a tag's payload, a list nothing else types)."
             (let* ((acc (put "the::<" acc))
                    (acc (put-type c (car xs) acc))
                    (acc (put ">(" acc))
                    (acc (put-args c e (cdr xs) 0 n acc)))
               (put ")" acc)))
            ((and (or (string=? h "letrena") (string=? h "letreap")) (string=? (local-kind h (ctx-locals c)) "")) (put-letrena c e xs n acc))
            ((and (or (string=? h "make-bloblet") (string=? h "rmake-bloblet")) (string=? (local-kind h (ctx-locals c)) ""))
             "`make_bloblet(bytes, (Cell::new(e), ...,))`; in a region, `rmake_bloblet(r, ...)`."
             (let* ((placed (string=? h "rmake-bloblet"))
                    (flat (blob-typed c e "blob-make "))
                    (acc (cond ((null? flat) (put (if placed "rmake_bloblet(" "make_bloblet(") acc))
                               (placed (put ", _>(" (put-flat c (car flat) (put "rmake_tbloblet::<_, " acc))))
                               (else (put ">(" (put-flat c (car flat) (put "make_tbloblet::<_, " acc))))))
                    (acc (if placed (put ", " (put-exp c (car xs) n (value) acc)) acc))
                    (rest (if placed (cdr xs) xs))
                    (acc (put ", (" (put-exp c (car rest) n (value) acc)))
                    (acc (put-sep (lambda ((x sexp) acc) (put ")," (put-exp c x n (value) (put "std::cell::Cell::new(" acc)))) " " (cdr rest) acc)))
               (put "))" acc)))
            ((and (or (string=? h "bloblet-ref") (string=? h "bloblet-set!")) (string=? (local-kind h (ctx-locals c)) ""))
             "A field, a cell: `(b).fields.i.get()`, `.set(e)`."
             (let ((acc (put (number-text (second xs)) (put ").fields." (put-exp c (car xs) n (value) (put "(" acc))))))
               (if (string=? h "bloblet-ref")
                   (put ".get()" acc)
                   (put ")" (put-exp c (third xs) n (value) (put ".set(" acc))))))
            ((and (string=? h "blobref-variant!") (string=? (local-kind h (ctx-locals c)) ""))
             "Its tag written, the label as it is, and a blobref to the variant (C33)."
             (put ")" (put (words-of-sep (split-words (fact-with c e "blob-variant ")) ", ") (put ").variant(" (put-exp c (car xs) n (value) (put "(" acc))))))
            ((and (or (string=? h "blobref-get") (string=? h "blobref-set!")) (string=? (local-kind h (ctx-locals c)) ""))
             "A scalar's bytes, read or written as the checker found its flat."
             (let ((acc (if (null? (blob-typed c e "blob-owner "))
                            (put (fact-with c e "blob-scalar ") (put (if (string=? h "blobref-get") ").get_" ").set_") (put-exp c (car xs) n (value) (put "(" acc))))
                            (put (if (string=? h "blobref-get") ").get" ").set") (put-exp c (car xs) n (value) (put "(" acc))))))
               (if (string=? h "blobref-get")
                   (put "()" acc)
                   (put ")" (put-exp c (second xs) n (value) (put "(" acc))))))
            ((and (string=? h "blobref-index") (string=? (local-kind h (ctx-locals c)) "") (not (null? (blob-typed c e "blob-owner "))))
             (put ")" (put-exp c (second xs) n (value) (put ").at(" (put-exp c (car xs) n (value) (put "(" acc))))))
            ((and (string=? h "blobref-at") (string=? (local-kind h (ctx-locals c)) "") (not (null? (blob-typed c e "blob-at "))))
             "A typed suffix's blobref at 0 (C32): a reference to it."
             (put ").suffix)" (put-exp c (car xs) n (value) (put "(&(" acc))))
            ((and (string=? h "blobref-index") (string=? (local-kind h (ctx-locals c)) ""))
             (let* ((acc (put ").index(" (put-exp c (car xs) n (value) (put "(" acc))))
                    (acc (put-exp c (second xs) n (value) acc)))
               (put ")" (put (string-append ", " (words-of-sep (split-words (fact-with c e "blob-element ")) ", ")) acc))))
            ((or (string=? h "letrec") (string=? h "letregion")) (put-block c (list e) n t acc))
            ((abort? c e)
             "An abort: an early return, where a `Result` is returned; else no
              prompt can be running for its tag (the checker masked its region),
              and it fails, as FX-26's does when it runs."
             (let* ((acc (put (if (fallible-here? c) "(return Err(unwind(" "unreachable_unwind(unwind(") acc))
                    (acc (put-joined c xs ", " n acc)))
               (put (if (fallible-here? c) ")))" "))") acc)))
            ((and (string=? h "prompt") (string=? (local-kind h (ctx-locals c)) "")) (put-prompt c e xs n acc))
            ((null? xs) (put-question c e (put "()" (put-callee c e h acc))))
            ((any? (lambda ((x sexp)) (module-name? c x)) xs)
             "A module given: the type parameter's argument, its marker."
             (let* ((acc (put "::<" (put (callee c h) acc)))
                    (acc (put-sep (lambda ((x sexp) (acc chars)) (put "::Module" (put (mangle (sym-name x)) acc)))
                                  ", " (concat (map (lambda ((x sexp)) (if (module-name? c x) (the sexps (list x)) nil)) xs)) acc))
                    (acc (put ">(" acc))
                    (acc (put-joined c (concat (map (lambda ((x sexp)) (if (module-name? c x) nil (the sexps (list x)))) xs)) ", " n acc)))
               (put-question c e (put ")" acc))))
            (else (put-question c e (put ")" (put-args c e xs 0 n (put "(" (put-callee c e h acc)))))))))

  (put-args (subr kfx (ctx sexp sexps i64 i64 chars) chars)
    (lambda (c e xs i n acc)
      "A call's arguments; one the checker found must be lifted, a procedure
       that cannot abort given where one that may is expected, wrapped in a
       closure returning `Ok`."
      (if (null? xs)
          acc
          (let* ((acc (put-exp c (car xs) n (value) acc)))
            (put-args c e (cdr xs) (i64+ i 1) n (if (null? (cdr xs)) acc (put ", " acc)))))))

  (put-letrena (subr kfx (ctx sexp sexps i64 chars) chars)
    (lambda (c e xs n acc)
      "`(letrena r body ...)` (C30): a block that declares the region's type,
       an arena for each type made in it, and a `fn` of the region's
       lifetime, the body, given the arena and the locals the body names;
       makes the arena; and calls the `fn` with them. The arena is dropped
       when the block ends, by a return or an abort."
      (let* ((r (sym-name (car xs)))
             (life (string-append "'" (mangle r)))
             (region (string-append "Region_" (camel r)))
             (outer (letrena-lifetimes (ctx-locals c)))
             (lives (words-of-sep (cons life outer) ", "))
             (names (split-words (fact-with c e "letrena-names ")))
             (types (read-all (string-chars (fact-with c e "letrena-locals ")) "" 1))
             (fallible (fact-at? c e "fallible"))
             (inner (with-locals c (cons (string-append "%letrena " r) (cons (if fallible "%fallible" "%infallible") (cons r names)))))
             (held (distinct-strings (concat (map (lambda ((x sexp)) (held-at inner (string-append "'" r) x)) (datums-in (cdr xs))))))
             (n1 (i64+ n 1))
             (acc (put-nl n1 (put "{" acc)))
             (acc (put (string-append "#[derive(Default)] struct " (string-append region (string-append "<" (string-append lives "> {")))) acc))
             (acc (put-held-fields held 0 acc))
             (acc (put (string-append " phantom_: std::marker::PhantomData<(" (string-append (words-of-sep (map (lambda ((l string)) (string-append "&" (string-append l " ()"))) (cons life outer)) ", ") ",)> }")) acc))
             (acc (put-held-impls held 0 region lives n1 acc))
             (acc (put-nl n1 acc))
             (acc (put (string-append "fn letrena__" (string-append (mangle r) (string-append "<" (string-append (words-of-sep (onto outer (list life)) ", ") ">(")))) acc))
             (acc (put (string-append (mangle r) (string-append ": &" (string-append life (string-append " " (string-append region (string-append "<" (string-append lives ">"))))))) acc))
             (acc (put-letrena-params inner names types acc))
             (acc (put ") -> " acc))
             (acc (if fallible
                      (put ", Unwind>" (put-type inner (car (read-all (string-chars (fact-with c e "letrena-type ")) "" 1)) (put "Result<" acc)))
                      (put-type inner (car (read-all (string-chars (fact-with c e "letrena-type ")) "" 1)) acc)))
             (acc (put " " acc))
             (acc (put-block inner (cdr xs) n1 (if fallible (ok-value) (value)) acc))
             (acc (put-nl n1 acc))
             (acc (put (string-append "let " (string-append (mangle r) (string-append "__arena = " (string-append region "::default();")))) acc))
             (acc (put-nl n1 acc))
             (acc (put (string-append "letrena__" (string-append (mangle r) (string-append "(&" (string-append (mangle r) "__arena")))) acc))
             (acc (put-sep (lambda ((x string) acc) (put-var c x (put ", " acc))) "" names acc))
             (acc (put ")" acc))
             (acc (cond ((not fallible) acc)
                        ((fallible-here? c) (put "?" acc))
                        (else (put ".unwrap_or_else(|u| unreachable_unwind(u))" acc)))))
        (put "}" (put-nl n acc)))))

  (put-letrena-params (subr kfx (ctx strings sexps chars) chars)
    (lambda (c names types acc)
      (if (or (null? names) (null? types))
          acc
          (put-letrena-params c (cdr names) (cdr types)
                              (put-type c (car types) (put ": " (put (mangle (car names)) (put ", " acc))))))))

  (held-at (subr kfx (ctx string sexp) strings)
    (lambda (c place x)
      "What is made, or needed, at the datum `x` in the place `place` (C34):
       each a Rust type an arena holds."
      (concat (map (lambda ((w string))
                     (let* ((rest (if (has-prefix? w "rheld-") (after-prefix w "rheld-") (after-prefix w "rneed-")))
                            (kind (car (split-at-char rest #\@)))
                            (after (after-prefix rest (string-append kind "@")))
                            (ws (read-all (string-chars after) "" 1)))
                       (if (string=? (sym-name (car ws)) place)
                           (the strings (list (held-rust c kind (string-append "'" (mangle (after-prefix place "'"))) (second ws))))
                           nil)))
                   (onto (all-facts-at c (datum-file x) (datum-pos x) "rheld-") (all-facts-at c (datum-file x) (datum-pos x) "rneed-"))))))

  (held-rust (subr kfx (ctx string string sexp) string)
    (lambda (c kind life t)
      "An arena's type, for a making of `kind` in a place of lifetime `life`:
       a pair, `Cons<'r, T>`; a reference's cell; a bloblet."
      (cond ((string=? kind "cons") (string-append "Cons<" (string-append life (string-append ", " (string-append (rev->string (put-type c t nil)) ">")))))
            ((string=? kind "ref") (string-append "std::cell::Cell<" (string-append (rev->string (put-type c t nil)) ">")))
            ((not (null? (typed-flat c t)))
             (string-append "TBloblet<" (string-append (rev->string (put-fields-tuple c (cdr (items (second (items t)))) nil))
               (string-append ", " (string-append (rev->string (put-flat c (car (typed-flat c t)) nil)) ">")))))
            (else (string-append "Bloblet<" (string-append (rev->string (put-fields-tuple c (cdr (items (second (items t)))) nil)) ">"))))))

  (held-type (subr kfx (ctx string sexp) string)
    (lambda (c r call)
      "What an allocation in region `r` makes, as Rust's type: a pair,
       `Cons<'r, T>`, or a reference's cell, `Cell<T>`."
      (let ((t (car (read-all (string-chars (fact-with c call "rheld ")) "" 1))))
        (cond ((head-is? call "rcons")
               (string-append "Cons<'" (string-append (mangle r) (string-append ", " (string-append (rev->string (put-type c t nil)) ">")))))
              ((and (head-is? call "rmake-bloblet") (not (null? (typed-flat c t))))
               (string-append "TBloblet<" (string-append (rev->string (put-fields-tuple c (cdr (items (second (items t)))) nil))
                 (string-append ", " (string-append (rev->string (put-flat c (car (typed-flat c t)) nil)) ">")))))
              ((head-is? call "rmake-bloblet")
               (string-append "Bloblet<" (string-append (rev->string (put-fields-tuple c (cdr (items (second (items t)))) nil)) ">")))
              (else (string-append "std::cell::Cell<" (string-append (rev->string (put-type c t nil)) ">")))))))

  (put-prompt (subr kfx (ctx sexp sexps i64 chars) chars)
    (lambda (c e xs n acc)
      "`(prompt tag body handler)`: the body run in a closure that returns a
       `Result`, and its abort to the tag handled; any other abort passed on,
       if the function written may abort, else none can come (the checker
       found the prompt contains every abort its body may make)."
      (let* ((inner (with-locals c (list "%fallible")))
             (acc (put-nl (i64+ n 1) (put "{" acc)))
             (acc (put "let prompt_tag__ = " acc))
             (acc (put-exp c (car xs) (i64+ n 1) (value) acc))
             (acc (put-nl (i64+ n 1) (put ";" acc)))
             (acc (put "match (move || -> Result<_, Unwind> " acc))
             (acc (put-block inner (list (second xs)) (i64+ n 1) (ok-value) acc))
             (acc (put ")() {" acc))
             (acc (put-nl (i64+ n 2) acc))
             (acc (put "Ok(v_) => v_," acc))
             (acc (put-nl (i64+ n 2) acc))
             (acc (put "Err(u_) if u_.is(prompt_tag__) => (" acc))
             (acc (put-exp c (third xs) (i64+ n 2) (value) acc))
             (acc (put ")(prompt_tag__.payload(u_))," acc))
             (acc (put-nl (i64+ n 2) acc))
             (acc (put (if (or (fact-at? c e "contains") (not (fallible-here? c)))
                           "Err(u_) => unreachable_unwind(u_),"
                           "Err(u_) => return Err(u_),")
                       acc))
             (acc (put-nl (i64+ n 1) acc))
             (acc (put "}" acc)))
        (put "}" (put-nl n acc)))))

  (put-question (subr kfx (ctx sexp chars) chars)
    (lambda (c e acc)
      "A call the checker found may abort takes a `?`."
      (cond ((not (fact-at? c e "fallible-call")) acc)
            ((fallible-here? c) (put "?" acc))
            (else (put ".unwrap_or_else(|u| unreachable_unwind(u))" acc))))))
