"emit.kfx: writing Rust."

"What the program defines"

"A tag, and its datatype's name."
(define-datatype tagof (tagof string string))
(define-type tagofs (listof tagof acyclic))

"Datatypes' names, their tags, constants (definitions not of procedures),
 and the names bound where an expression is. A name named as a value is
 a local, a constant (a call of its `fn`), or else a global procedure (a
 reference to its `fn`, the program's or kayak-rt's)."
"A family: a datatype or type abbreviation with parameters, its name,
 whether it is a datatype, and its parameters' kinds, so that a region's
 argument, erased in Rust, is dropped where it is applied."
(define-datatype family (family string bool strings))
(define-type families (listof family acyclic))

"Modules, by name: each `(module item ...)` (check.kfx, C19)."
(define-datatype ctx (ctx strings tagofs strings strings typeds facts families typeds typeds))

(define filter-typed (subr kfx (string typeds) typeds)
  (lambda (name xs)
    (cond ((null? xs) nil)
          ((tagcase (car xs) (typed (n t) (string=? n name))) (list (car xs)))
          (else (filter-typed name (cdr xs))))))

(define ctx-effects (subr kfx (ctx) typeds)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) es))))

(define-rec
  (fallible-effect? (subr kfx (ctx sexp) bool)
    (lambda (c e)
      "Whether a written effect may abort, its abbreviations seen through: a
       procedure of it returns a `Result` (docs/research/escapes.md)."
      (tagcase e
        (sym (n) (any? (lambda ((x typed)) (tagcase x (typed (m body) (and (string=? m n) (fallible-effect? c body)))))
                       (ctx-effects c)))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "goto") #t)
                ((sym-is? (car xs) "maxeff") (any? (lambda ((x sexp)) (fallible-effect? c x)) (cdr xs)))
                (else #f)))
        (else other #f)))))

(define ctx-fact? (subr kfx (ctx string i64 string) bool)
  (lambda (c file pos what)
    "Whether the checker found `what` about the place `file`, `pos`."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (any? (lambda ((f fact))
                (tagcase f (fact (ff fp fw) (and (i64= fp pos) (string=? fw what) (string=? ff file)))))
              fs)))))

(define fact-at? (subr kfx (ctx sexp string) bool)
  (lambda (c e what)
    "Whether the checker found `what` about the list `e`."
    (tagcase e
      (lst (xs src-file src-line src-pos) (ctx-fact? c src-file src-pos what))
      (else other #f))))

(define fact-with (subr kfx (ctx sexp string) string)
  (lambda (c e prefix)
    "What the checker found about the list `e` that begins `prefix`, the
     rest of it; or ``."
    (tagcase e
      (lst (xs src-file src-line src-pos)
        (tagcase c
          (ctx (ds ts ks ls xs2 fs ms es mods)
            (let ((found (concat (map (lambda ((f fact))
                                        (tagcase f
                                          (fact (ff fp fw)
                                            (if (and (i64= fp src-pos) (string=? ff src-file) (has-prefix? fw prefix))
                                                (the strings (list (after-prefix fw prefix)))
                                                nil))))
                                      fs))))
              (if (null? found) "" (car found))))))
      (else other ""))))

"Products and sums, FX-26's structural data (check.kfx, `ty-shape`): one
 generic Rust type for each list of labels, a tuple struct for a product,
 `Product_a_b<A0, A1>`, and an enum for a sum, `Sum_leaf_node<A0, A1>`,
 a sum's values references, as a datatype's are. The name holds the labels,
 so that two products of the same labels and types are one type, as in
 FX-26."

(define-rec
  (concat-strings (subr kfx (strings) string)
    (lambda (xs) (if (null? xs) "" (string-append (car xs) (concat-strings (cdr xs)))))))

(define-rec
  (reverse-strings (subr kfx (strings strings) strings)
    (lambda (xs acc) (if (null? xs) acc (reverse-strings (cdr xs) (cons (car xs) acc))))))

(define-rec
  (split-words-from (subr kfx (chars chars strings) strings)
    (lambda (cs word acc)
      (cond ((null? cs) (if (null? word) acc (cons (rev->string word) acc)))
            ((char=? (car cs) #\space) (split-words-from (cdr cs) nil (if (null? word) acc (cons (rev->string word) acc))))
            (else (split-words-from (cdr cs) (cons (car cs) word) acc))))))

(define split-words (subr kfx (string) strings)
  (lambda (s) (reverse-strings (split-words-from (string-chars s) nil nil) nil)))

(define shape-name (subr kfx (bool strings) string)
  (lambda (product labels)
    (string-append (if product "Product" "Sum")
                   (concat-strings (map (lambda ((l string)) (string-append "_" (mangle l))) labels)))))

(define ctx-datatypes (subr kfx (ctx) strings)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ds))))

(define ctx-tags (subr kfx (ctx) tagofs)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ts))))

(define ctx-constants (subr kfx (ctx) strings)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ks))))

(define ctx-locals (subr kfx (ctx) strings)
  (lambda (c) (tagcase c (ctx (ds ts ks ls xs fs ms es mods) ls))))

(define strings-onto (subr kfx (strings strings) strings)
  (lambda (xs ys) (if (null? xs) ys (strings-onto (cdr xs) (cons (car xs) ys)))))

(define module-items (subr kfx (ctx string) sexps)
  (lambda (c m)
    "Module `m`'s items."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (concat (map (lambda ((x typed)) (tagcase x (typed (n body) (if (string=? n m) (cdr (items body)) nil))))
                     mods))))))

(define item-values (subr kfx (sexps) strings)
  (lambda (forms)
    "The names a module's items give values to: its type's values."
    (concat
     (map (lambda ((f sexp))
            (cond ((or (head-is? f "define") (head-is? f "define*")) (the strings (list (sym-name (second (items f))))))
                  ((head-is? f "define-rec") (map (lambda ((b sexp)) (sym-name (car (items b)))) (cdr (items f))))
                  ((head-is? f "define-datatype") (map (lambda ((vt sexp)) (sym-name (car (items vt)))) (cdr (cdr (items f)))))
                  (else nil)))
          forms))))

(define item-constants (subr kfx (sexps) strings)
  (lambda (forms)
    "The names a module's items give values not procedures to."
    (concat
     (map (lambda ((f sexp))
            (if (and (head-is? f "define") (not (procedure? (last (items f)))))
                (the strings (list (sym-name (second (items f)))))
                nil))
          forms))))

(define item-types (subr kfx (sexps) strings)
  (lambda (forms)
    (concat
     (map (lambda ((f sexp))
            (if (or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype"))
                (the strings (list (sym-name (second (items f)))))
                nil))
          forms))))

(define-rec
  (opener (subr kfx (string strings) string)
    (lambda (entry ls)
      "The module whose `with` gave `entry`, a value's or a type's: the
       innermost, and only if no local inside it hides it."
      (cond ((null? ls) "")
            ((string=? (car ls) entry)
             (let ((rest (after-with (cdr ls)))) rest))
            (else (opener entry (cdr ls))))))
  (after-with (subr kfx (strings) string)
    (lambda (ls)
      (cond ((null? ls) "")
            ((has-prefix? (car ls) "%with ") (after-prefix (car ls) "%with "))
            (else (after-with (cdr ls)))))))

(define-rec
  (after-in (subr kfx (strings) string)
    (lambda (ls)
      (cond ((null? ls) "")
            ((has-prefix? (car ls) "%in ") (after-prefix (car ls) "%in "))
            (else (after-in (cdr ls)))))))

(define module-here (subr kfx (ctx) string)
  (lambda (c)
    "The module whose items are being written, or ``."
    (after-in (ctx-locals c))))

(define ctx-typed (subr kfx (ctx string) sexps)
  (lambda (c name)
    "The type the checker found for a definition written with none, as a
     list of one."
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (map (lambda ((x typed)) (tagcase x (typed (n t) t)))
             (filter-typed (if (string=? (after-in ls) "") name (string-append (after-in ls) (string-append " " name)))
                           xs))))))

(define with-locals (subr kfx (ctx strings) ctx)
  (lambda (c names)
    "`c`, where `names` are bound too."
    (tagcase c (ctx (ds ts ks ls xs fs ms es mods) (ctx ds ts ks (strings-onto names ls) xs fs ms es mods)))))

(define tag-datatype (subr kfx (string tagofs) string)
  (lambda (tag ts)
    (if (null? ts)
        (error (string-append "kfx: not a datatype's tag: " tag))
        (tagcase (car ts)
          (tagof (t d) (if (string=? t tag) d (tag-datatype tag (cdr ts))))))))

(define note-tags (subr kfx (sexps string tagofs) tagofs)
  (lambda (variants d ts)
    (if (null? variants)
        ts
        (note-tags (cdr variants) d
                   (cons (tagof (sym-name (car (items (car variants)))) d) ts)))))

(define type-head-name (subr kfx (sexp) string)
  (lambda (head)
    "A type definition's name, from its head: a name, or `(name binder ...)`."
    (tagcase head (lst (xs src-file src-line src-pos) (sym-name (car xs))) (else other (sym-name other)))))

(define binder-kinds (subr kfx (sexps) strings)
  (lambda (bs) (map (lambda ((b sexp)) (sym-name (second (items b)))) bs)))

(define type-params-of (subr kfx (sexps) strings)
  (lambda (bs)
    "The names of the binders of kind `type`: Rust's type parameters."
    (cond ((null? bs) nil)
          ((sym-is? (second (items (car bs))) "type")
           (cons (sym-name (car (items (car bs)))) (type-params-of (cdr bs))))
          (else (type-params-of (cdr bs))))))

(define head-type-params (subr kfx (sexp) strings)
  (lambda (head) (tagcase head (lst (xs src-file src-line src-pos) (type-params-of (cdr xs))) (else other nil))))

(define note-family (subr kfx (sexp bool families) families)
  (lambda (head datatype ms)
    (tagcase head
      (lst (xs src-file src-line src-pos) (cons (family (sym-name (car xs)) datatype (binder-kinds (cdr xs))) ms))
      (else other ms))))

(define filter-family (subr kfx (string families) families)
  (lambda (name ms)
    (cond ((null? ms) nil)
          ((tagcase (car ms) (family (n d ks) (string=? n name))) (list (car ms)))
          (else (filter-family name (cdr ms))))))

(define find-family-of (subr kfx (ctx string) families)
  (lambda (c name)
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (let ((found (filter-family name ms))) found)))))

(define put-generics-of (subr kfx (strings bool chars) chars)
  (lambda (names bounded acc)
    "`<T, U>`, or with `bounded`, `<T: Copy + 'static, U: Copy + 'static>`
     as every KFX value is; nothing for no names."
    (if (null? names)
        acc
        (put ">" (put-sep (lambda ((n string) (acc chars))
                            (let ((acc (put (camel n) acc))) (if bounded (put ": Copy + 'static" acc) acc)))
                          ", " names (put "<" acc))))))

(define note-module-datatypes (subr kfx (string sexps ctx) ctx)
  (lambda (m forms c)
    "A module's datatypes, as the program names them, `m..d`, with their tags."
    (cond ((null? forms) c)
          ((head-is? (car forms) "define-datatype")
           (let ((d (string-append m (string-append ".." (type-head-name (second (items (car forms))))))))
             (note-module-datatypes m (cdr forms)
               (tagcase c
                 (ctx (ds ts ks ls xs fs ms es mods)
                   (ctx (cons d ds) (note-tags (cdr (cdr (items (car forms)))) d ts) ks ls xs fs ms es mods))))))
          (else (note-module-datatypes m (cdr forms) c)))))

(define note (subr kfx (sexp ctx) ctx)
  (lambda (form c)
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (cond ((head-is? form "define-datatype")
               (let ((d (type-head-name (second (items form)))))
                 (ctx (cons d ds) (note-tags (cdr (cdr (items form))) d ts) ks ls xs fs
                      (note-family (second (items form)) #t ms) es mods)))
              ((or (head-is? form "define-type") (head-is? form "define-generative"))
               (ctx ds ts ks ls xs fs (note-family (second (items form)) #f ms) es mods))
              ((head-is? form "define-effect")
               (ctx ds ts ks ls xs fs ms (cons (typed (sym-name (second (items form))) (third (items form))) es) mods))
              ((module-def? form)
               (let ((m (sym-name (second (items form)))))
                 (note-module-datatypes m (cdr (items (third (items form))))
                                        (ctx ds ts ks ls xs fs ms es (cons (typed m (third (items form))) mods)))))
              ((and (head-is? form "define")
                    (or (i64= (size (items form)) 3) (i64= (size (items form)) 4))
                    (not (procedure? (last (items form)))))
               (ctx ds ts (cons (sym-name (second (items form))) ks) ls xs fs ms es mods))
              (else c))))))

(define collect (subr kfx (sexps ctx) ctx)
  (lambda (forms c)
    (if (null? forms) c (collect (cdr forms) (note (car forms) c)))))

"Writing Rust"

(define escape-char (subr kfx (char char) string)
  (lambda (c q)
    (cond ((char=? c #\\) "\\\\")
          ((char=? c q) (string-append "\\" (char->string c)))
          ((char=? c #\newline) "\\n")
          ((char=? c #\tab) "\\t")
          (else (char->string c)))))

(define put-escaped (subr kfx (chars char chars) chars)
  (lambda (cs q acc)
    "`cs` as the inside of a Rust literal delimited by `q`."
    (if (null? cs) acc (put-escaped (cdr cs) q (put (escape-char (car cs) q) acc)))))

(define-rec
  (dotted-from (subr kfx (chars chars) strings)
    (lambda (seen cs)
      (cond ((or (null? cs) (null? (cdr cs))) nil)
            ((and (char=? (car cs) #\.) (char=? (car (cdr cs)) #\.))
             (the strings (list (rev->string seen) (list->string (cdr (cdr cs))))))
            (else (dotted-from (cons (car cs) seen) (cdr cs)))))))

(define dotted (subr kfx (string) strings)
  (lambda (s)
    "A module's type as the program names it, `m..t`: `m` and `t`; else none."
    (dotted-from nil (string-chars s))))

(define type-path (subr kfx (ctx string string) string)
  (lambda (c m t)
    "Module `m`'s type `t`, from outside it: a datatype's a reference."
    (string-append (if (string-member? (string-append m (string-append ".." t)) (ctx-datatypes c)) "&'static " "")
                   (string-append (mangle m) (string-append "::" (camel t))))))

(define datatype-path (subr kfx (string) string)
  (lambda (d)
    "A datatype's enum, a module's named by its path."
    (if (null? (dotted d)) (camel d) (string-append (mangle (car (dotted d))) (string-append "::" (camel (car (cdr (dotted d)))))))))

(define-rec
  (put-type (subr kfx (ctx sexp chars) chars)
    (lambda (c t acc)
      "A type. A name that is no base type or datatype is a type abbreviation
       or a type variable, either way a Rust type of the same name."
      (tagcase t
        (sym (s)
          (cond ((string=? s "i64") (put "i64" acc))
                ((string=? s "int") (put "Int" acc))
                ((string=? s "nat") (put "Int" acc))
                ((string=? s "f64") (put "f64" acc))
                ((string=? s "bool") (put "bool" acc))
                ((string=? s "char") (put "char" acc))
                ((string=? s "unit") (put "()" acc))
                ((string=? s "void") (put "!" acc))
                ((string=? s "string") (put "Str" acc))
                ((not (null? (dotted s))) (put (type-path c (car (dotted s)) (car (cdr (dotted s)))) acc))
                ((string-member? s (ctx-datatypes c)) (put (camel s) (put "&'static " acc)))
                ((not (string=? (opener (string-append "%type " s) (ctx-locals c)) ""))
                 (put (type-path c (opener (string-append "%type " s) (ctx-locals c)) s) acc))
                (else (put (camel s) acc))))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "listof")
                 (put ">" (put-type c (second xs) (put "List<" acc))))
                ((sym-is? (car xs) "flatarrayof")
                 (put ">" (put-type c (second xs) (put "FlatArray<" acc))))
                ((sym-is? (car xs) "ref")
                 (put ">" (put-type c (second xs) (put "Ref<" acc))))
                ((sym-is? (car xs) "subr")
                 (let* ((acc (put "&'static dyn Fn(" acc))
                        (acc (put-types c (items (third xs)) acc))
                        (acc (put ") -> " acc)))
                   (if (fallible-effect? c (second xs))
                       (put ", Unwind>" (put-type c (fourth xs) (put "Result<" acc)))
                       (put-type c (fourth xs) acc))))
                ((sym-is? (car xs) "prompt-tag")
                 (put ">" (put-type c (third xs) (put ", " (put-type c (second xs) (put "Tag<" acc))))))
                ((sym-is? (car xs) "select")
                 (put (type-path c (sym-name (second xs)) (sym-name (third xs))) acc))
                ((or (sym-is? (car xs) "productof") (sym-is? (car xs) "sumof"))
                 (let* ((product (sym-is? (car xs) "productof"))
                        (fs (map items (cdr xs)))
                        (acc (put (shape-name product (map (lambda ((f sexps)) (label-of (car f))) fs))
                                  (if product acc (put "&'static " acc)))))
                   (if (null? fs) acc (put ">" (put-types c (map second fs) (put "<" acc))))))
                ((sym-is? (car xs) "poly")
                 (error "kfx: a poly type is only a definition's, at its top"))
                ((tagcase (car xs) (sym (n) (not (null? (find-family-of c n)))) (else other #f))
                 (tagcase (car (find-family-of c (sym-name (car xs))))
                   (family (n datatype kinds)
                     (let* ((acc (if datatype (put "&'static " acc) acc))
                            (acc (put (camel n) acc))
                            (args (type-arguments (cdr xs) kinds)))
                       (if (null? args) acc (put ">" (put-types c args (put "<" acc))))))))
                (else (error "kfx: a type KFX-0 does not have"))))
        (else other (error "kfx: a type KFX-0 does not have")))))

  (type-arguments (subr kfx (sexps strings) sexps)
    (lambda (args kinds)
      "A family's arguments for its parameters of kind `type`: the others,
       regions, are erased."
      (cond ((or (null? args) (null? kinds)) nil)
            ((string=? (car kinds) "type") (cons (car args) (type-arguments (cdr args) (cdr kinds))))
            (else (type-arguments (cdr args) (cdr kinds))))))

  (put-types (subr kfx (ctx sexps chars) chars)
    (lambda (c types acc)
      "Types, separated by commas."
      (put-sep (lambda ((t sexp) acc) (put-type c t acc)) ", " types acc))))

(define local-kind (subr kfx (string strings) string)
  (lambda (s ls)
    "What `s` is where it is named: `local`, `knot` (a procedure of a
     `letrec`, in its group's lambdas, before it is made: reached through
     its knot), or `` (not bound locally). The innermost binding counts."
    (cond ((null? ls) "")
          ((string=? (car ls) s) "local")
          ((string=? (car ls) (string-append "%knot " s)) "knot")
          ((string=? (car ls) (string-append "%item " s)) "item")
          (else (local-kind s (cdr ls))))))

(define item-path (subr kfx (ctx string) string)
  (lambda (c s)
    "A module's value, named in a `with`: `m::x`, called if a constant."
    (let ((m (opener (string-append "%item " s) (ctx-locals c))))
      (string-append (mangle m)
                     (string-append "::"
                                    (string-append (mangle s)
                                                   (if (string-member? s (item-constants (module-items c m))) "()" "")))))))

(define-rec
  (innermost-fallible (subr kfx (strings) bool)
    (lambda (ls)
      (cond ((null? ls) #f)
            ((string=? (car ls) "%fallible") #t)
            ((string=? (car ls) "%infallible") #f)
            (else (innermost-fallible (cdr ls)))))))

(define fallible-here? (subr kfx (ctx) bool)
  (lambda (c)
    "Whether the function or closure being written returns a `Result`: the
     innermost's mark says."
    (innermost-fallible (ctx-locals c))))

(define callee (subr kfx (ctx string) string)
  (lambda (c h)
    "A call's operator: a knot's procedure, a constant's value (a
     procedure a definition made, not a lambda), or a name."
    (let ((kind (local-kind h (ctx-locals c))))
      (cond ((string=? kind "knot") (string-append "(" (string-append (mangle h) "__knot.get())")))
            ((string=? kind "item") (item-path c h))
            ((and (string=? kind "") (string-member? h (ctx-constants c))) (string-append (mangle h) "()"))
            (else (mangle h))))))

(define put-var (subr kfx (ctx string chars) chars)
  (lambda (c s acc)
    (cond ((string=? s "#t") (put "true" acc))
          ((string=? s "#f") (put "false" acc))
          ((string=? s "#u") (put "()" acc))
          ((string=? (local-kind s (ctx-locals c)) "knot") (put ".get()" (put "__knot" (put (mangle s) acc))))
          ((string=? (local-kind s (ctx-locals c)) "local") (put (mangle s) acc))
          ((string=? (local-kind s (ctx-locals c)) "item")
           (let ((m (opener (string-append "%item " s) (ctx-locals c))))
             (put (item-path c s) (if (string-member? s (item-constants (module-items c m))) acc (put "&" acc)))))
          ((or (string=? s "nil") (string-member? s (ctx-constants c)))
           (put "()" (put (mangle s) acc)))
          (else (put (mangle s) (put "&" acc))))))

(define put-spaces (subr kfx (i64 chars) chars)
  (lambda (k acc) (if (i64= k 0) acc (put-spaces (i64- k 1) (put "    " acc)))))

(define put-nl (subr kfx (i64 chars) chars)
  (lambda (n acc)
    "A new line, indented `n` levels."
    (put-spaces n (put "\n" acc))))

(define put-comment (subr kfx (chars string i64 bool chars) chars)
  (lambda (cs prefix n fresh acc)
    "A string literal where a body's value is not taken is a comment: KFX's
     comments are strings, since `;` comments do not survive reading. Each of
     its lines is written after `prefix` (`//` or `///`), leading spaces
     dropped; `fresh` says no prefix has been written for this line yet."
    (cond ((null? cs) acc)
          ((char=? (car cs) #\newline)
           (put-comment (cdr cs) prefix n #t (put-nl n (if fresh (put prefix acc) acc))))
          ((and fresh (char=? (car cs) #\space)) (put-comment (cdr cs) prefix n #t acc))
          (fresh (put-comment (cdr cs) prefix n #f (cons (car cs) (put " " (put prefix acc)))))
          (else (put-comment (cdr cs) prefix n #f (cons (car cs) acc))))))

(define comment? (subr kfx (sexp) bool)
  (lambda (e) (tagcase e (str (s) #t) (else other #f))))

(define comment-text (subr kfx (sexp) string)
  (lambda (e) (tagcase e (str (s) s) (else other ""))))

(define put-names (subr kfx (sexps chars) chars)
  (lambda (xs acc)
    "Names, separated by commas."
    (put-sep (lambda ((x sexp) acc) (put (mangle (sym-name x)) acc)) ", " xs acc)))

"Self tail calls. Rust has no tail calls, so a procedure that calls itself
 last is a `loop`: the call assigns its parameters and `continue`s, and
 everything else it could end with is `return`ed."

(define-datatype tail
  (value)
  (returns string strings bool bool)
  (ok-value))

"`value`: an expression whose value is used. `returns`: the last thing a
 looping procedure does, with the procedure's name and parameters; the
 flag is false where a binding hides a parameter, since an assignment
 would then reach the binding, not the parameter."

(define binding-name (subr kfx (sexp) string)
  (lambda (binding) (sym-name (car (items binding)))))

(define hide (subr kfx (tail strings) tail)
  (lambda (t names)
    "`t`, under bindings of `names`."
    (tagcase t
      (returns (f ps live ok) (if (and live (any? (lambda ((x string)) (string-member? x ps)) names)) (returns f ps #f ok) t))
      (else other t))))

(define ok-value? (subr kfx (tail) bool)
  (lambda (t) (tagcase t (ok-value () #t) (else other #f))))

(define returns-ok? (subr kfx (tail) bool)
  (lambda (t) (tagcase t (returns (f ps live ok) ok) (else other #f))))

(define returns? (subr kfx (tail) bool)
  (lambda (t) (tagcase t (returns (f ps live ok) #t) (else other #f))))

(define-rec
  (map2-params (subr kfx (sexps sexps) sexps)
    (lambda (params types)
      (if (or (null? params) (null? types))
          params
          (cons (tagcase (car params)
                  (sym (n) (lst (list (car params) (car types)) "" 0 0))
                  (else other other))
                (map2-params (cdr params) (cdr types)))))))

(define typed-lambda (subr kfx (sexp sexp) sexp)
  (lambda (lam type)
    "A letrec's lambda, its parameters given the types its binding's says,
     so that Rust need not infer a closure's from its uses: it cannot, where
     the first is a `match` (a lambda's place kept, for its facts)."
    (tagcase lam
      (lst (xs file line pos)
        (lst (cons (car xs)
                   (cons (lst (map2-params (items (second xs)) (items (third (items type)))) "" 0 0)
                         (cdr (cdr xs))))
             file line pos))
      (else other lam))))

(define case-kind (subr kfx (ctx sexp) string)
  (lambda (c e)
    "What a case is on, as the checker found."
    (cond ((fact-at? c e "case int") "int")
          ((fact-at? c e "case string") "string")
          ((fact-at? c e "case bool") "bool")
          (else "char"))))

(define abort? (subr kfx (ctx sexp) bool)
  (lambda (c e)
    "An abort: `return Err(...)` in Rust, so no value to return or wrap."
    (and (head-is? e "abort-current-continuation")
         (string=? (local-kind "abort-current-continuation" (ctx-locals c)) ""))))

(define self-call? (subr kfx (tail sexp) bool)
  (lambda (t e)
    (tagcase t
      (returns (f ps live ok)
        (and live (head-is? e f) (i64= (size (cdr (items e))) (size ps))))
      (else other #f))))

(define control? (subr kfx (sexp) bool)
  (lambda (e)
    "The forms whose last parts stand where they do."
    (or (head-is? e "if") (head-is? e "cond") (head-is? e "case") (head-is? e "tagcase")
        (head-is? e "let") (head-is? e "let*") (head-is? e "begin") (head-is? e "letrec")
        (head-is? e "letregion") (head-is? e "with"))))

(define with-opened (subr kfx (ctx sexp) ctx)
  (lambda (c e)
    "`c` in `(with m ...)`: `m`'s values and types, hiding what is outside."
    (let* ((m (sym-name (second (items e))))
           (forms (module-items c m)))
      (with-locals c (cons (string-append "%with " m)
                           (onto (map (lambda ((x string)) (string-append "%type " x)) (item-types forms))
                                 (map (lambda ((x string)) (string-append "%item " x)) (item-values forms))))))))

(define opened-tail (subr kfx (ctx sexp tail) tail)
  (lambda (c e t)
    "`t` in `(with m ...)`: a procedure `m` gives, named as the one written,
     is not it, and a parameter `m` hides is not to be assigned."
    (let ((names (item-values (module-items c (sym-name (second (items e)))))))
      (tagcase t
        (returns (f ps live ok)
          (if (string-member? f names) (returns f ps #f ok) (hide t names)))
        (else other t)))))

(define-rec
  (tail-calls? (subr kfx (tail sexp) bool)
    (lambda (t e)
      "Whether `e`, standing at `t`, makes a self tail call: whether its
       procedure loops."
      (cond ((self-call? t e) #t)
            ((head-is? e "if")
             (let ((xs (cdr (items e))))
               (or (tail-calls? t (second xs)) (tail-calls? t (third xs)))))
            ((head-is? e "cond") (arms-tail-calls? t (cdr (items e))))
            ((head-is? e "case") (arms-tail-calls? t (cdr (cdr (items e)))))
            ((head-is? e "tagcase") (tag-arms-tail-calls? t (cdr (cdr (items e)))))
            ((or (head-is? e "let") (head-is? e "let*") (head-is? e "letrec"))
             (let ((xs (cdr (items e))))
               (tail-calls? (hide t (map binding-name (items (car xs)))) (last (cdr xs)))))
            ((head-is? e "begin") (tail-calls? t (last (cdr (items e)))))
            ((head-is? e "letregion") (tail-calls? t (last (cdr (cdr (items e))))))
            (else #f))))
  (arms-tail-calls? (subr kfx (tail sexps) bool)
    (lambda (t arms)
      "A `cond`'s clauses, or a `case`'s arms: each a test or data, then a body."
      (cond ((null? arms) #f)
            ((tail-calls? t (last (cdr (items (car arms))))) #t)
            (else (arms-tail-calls? t (cdr arms))))))
  (tag-arms-tail-calls? (subr kfx (tail sexps) bool)
    (lambda (t arms)
      (if (null? arms)
          #f
          (let* ((arm (items (car arms)))
                 (bound (if (or (sym-is? (car arm) "else") (tagcase (second arm) (sym (x) #t) (else other #f)))
                            (the strings (list (sym-name (second arm))))
                            (map sym-name (items (second arm))))))
            (or (tail-calls? (hide t bound) (last (cdr (cdr arm))))
                (tag-arms-tail-calls? t (cdr arms))))))))

(define-datatype assign (assign strings sexps))

(define changes (subr kfx (strings sexps) assign)
  (lambda (ps args)
    "The parameters a self tail call changes, and their new values: an
     argument that is the parameter itself changes nothing."
    (if (null? ps)
        (assign nil nil)
        (tagcase (changes (cdr ps) (cdr args))
          (assign (names values)
            (if (sym-is? (car args) (car ps))
                (assign names values)
                (assign (cons (car ps) names) (cons (car args) values))))))))

(define put-strings (subr kfx (strings chars) chars)
  (lambda (xs acc)
    "Names, mangled, separated by commas."
    (put-sep (lambda ((x string) acc) (put (mangle x) acc)) ", " xs acc)))

"Every writer of an expression takes `n`, the indentation of the line it
 starts on, and `t`, where the expression stands."
(define-rec
  (put-exp (subr kfx (ctx sexp i64 tail chars) chars)
    (lambda (c e n t acc)
      (cond ((self-call? t e) (put-continue c (cdr (items e)) n t acc))
            ((and (returns? t) (abort? c e)) (put ";" (put-exp c e n (value) acc)))
            ((and (returns? t) (not (control? e)))
             (if (returns-ok? t)
                 (put ");" (put-exp c e n (value) (put "return Ok(" acc)))
                 (put ";" (put-exp c e n (value) (put "return " acc)))))
            ((and (ok-value? t) (not (control? e)) (not (abort? c e)))
             (put ")" (put-exp c e n (value) (put "Ok(" acc))))
            (else
             (tagcase e
               (num (k num-file num-pos)
                 (if (ctx-fact? c num-file num-pos "int")
                     (put ")" (put (i64->string k) (put "int_lit(" acc)))
                     (put "i64" (put (i64->string k) acc))))
               (big (text f p) (put "\")" (put text (put "int_text(\"" acc))))
               (chr (ch) (put "'" (put-escaped (list ch) #\' (put "'" acc))))
               (real (x)
                 "As Rust writes a double: a digit after the point (`1.` is `1.0`)."
                 (put "f64" (if (char=? (last (string-chars x)) #\.) (put "0" (put x acc)) (put x acc))))
               (str (s) (put "\")" (put-escaped (string-chars s) #\" (put "str_lit(\"" acc))))
               (sym (s) (put-var c s acc))
               (lst (xs src-file src-line src-pos)
                 (tagcase (car xs)
                   (sym (h) (put-form c e h (cdr xs) n t acc))
                   (else head
                     (let* ((acc (put "(" acc))
                            (acc (put-exp c head n (value) acc))
                            (acc (put ")(" acc)))
                       (put-question c e (put ")" (if (null? (cdr xs)) acc (put-joined c (cdr xs) ", " n acc)))))))))))))

  (put-continue (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c args n t acc)
      "A self tail call: the parameters it changes assigned, all at once."
      (tagcase t
        (returns (f ps live ok)
          (tagcase (changes ps args)
            (assign (names values)
              (let ((acc (cond ((null? names) acc)
                               ((null? (cdr names))
                                (let* ((acc (put (mangle (car names)) acc))
                                       (acc (put " = " acc))
                                       (acc (put-exp c (car values) n (value) acc)))
                                  (put-nl n (put ";" acc))))
                               (else
                                (let* ((acc (put "(" acc))
                                       (acc (put-strings names acc))
                                       (acc (put ") = (" acc))
                                       (acc (put-joined c values ", " n acc)))
                                  (put-nl n (put ");" acc)))))))
                (put "continue;" acc)))))
        (else other (error "kfx: a self tail call where no procedure loops")))))

  (put-joined (subr kfx (ctx sexps string i64 chars) chars)
    (lambda (c xs sep n acc)
      "Expressions separated by `sep`."
      (put-sep (lambda ((x sexp) acc) (put-exp c x n (value) acc)) sep xs acc)))

  (put-stmts (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c es n t acc)
      "A body as the inside of a block: each expression on a line of its own,
       the last standing at `t`. A last `let`, `let*`, `begin` or `tagcase`
       is written into the block rather than as a block of its own."
      (let ((e (car es)))
        (cond ((not (null? (cdr es)))
               (let ((acc (if (comment? e)
                              (put-comment (string-chars (comment-text e)) "//" n #t acc)
                              (put ";" (put-exp c e n (value) acc)))))
                 (put-stmts c (cdr es) n t (put-nl n acc))))
              ((or (head-is? e "let") (head-is? e "let*"))
               (let* ((xs (cdr (items e)))
                      (names (map binding-name (items (car xs)))))
                 (put-stmts (with-locals c names) (cdr xs) n (hide t names)
                            (if (head-is? e "let")
                                (put-let c (items (car xs)) n acc)
                                (put-let* c (items (car xs)) n acc)))))
              ((head-is? e "begin") (put-stmts c (cdr (items e)) n t acc))
              ((head-is? e "letregion") (put-stmts c (cdr (cdr (items e))) n t acc))
              ((head-is? e "with") (put-stmts (with-opened c e) (cdr (cdr (items e))) n (opened-tail c e t) acc))
              ((head-is? e "letrec")
               (let* ((xs (cdr (items e)))
                      (bindings (items (car xs)))
                      (names (map binding-name bindings)))
                 (put-stmts (with-locals c names) (cdr xs) n (hide t names)
                            (put-letrec c bindings names n acc))))
              ((head-is? e "tagcase") (put-tagcase c e (cdr (items e)) n t acc))
              (else (put-exp c e n t acc))))))

  (put-block (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c es n t acc)
      (let* ((acc (put-nl (i64+ n 1) (put "{" acc)))
             (acc (put-stmts c es (i64+ n 1) t acc)))
        (put "}" (put-nl n acc)))))

  (put-cond (subr kfx (ctx sexps i64 tail chars) chars)
    (lambda (c clauses n t acc)
      (let ((clause (items (car clauses))))
        (if (sym-is? (car clause) "else")
            (put-block c (cdr clause) n t acc)
            (let* ((acc (put "if " acc))
                   (acc (put-exp c (car clause) n (value) acc))
                   (acc (put " " acc))
                   (acc (put-block c (cdr clause) n t acc))
                   (acc (put " else " acc)))
              (put-cond c (cdr clauses) n t acc))))))

  (put-let1 (subr kfx (ctx sexp i64 chars) chars)
    (lambda (c binding n acc)
      (let* ((acc (put "let " acc))
             (acc (put (mangle (sym-name (car (items binding)))) acc))
             (acc (put " = " acc))
             (acc (put-exp c (second (items binding)) n (value) acc)))
        (put-nl n (put ";" acc)))))

  (put-let* (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c bindings n acc)
      "Each binding sees those before it."
      (if (null? bindings)
          acc
          (put-let* (with-locals c (map binding-name (list (car bindings)))) (cdr bindings) n
                    (put-let1 c (car bindings) n acc)))))

  (put-binding-values (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c bindings n acc)
      (let ((acc (put-exp c (second (items (car bindings))) n (value) acc)))
        (if (null? (cdr bindings))
            acc
            (put-binding-values c (cdr bindings) n (put ", " acc))))))

  (put-binding-names (subr kfx (sexps chars) chars)
    (lambda (bindings acc)
      (let ((acc (put (mangle (sym-name (car (items (car bindings))))) acc)))
        (if (null? (cdr bindings))
            acc
            (put-binding-names (cdr bindings) (put ", " acc))))))

  (put-let (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c bindings n acc)
      "`let` binds in parallel: more than one binding is a tuple."
      (cond ((null? bindings) acc)
            ((null? (cdr bindings)) (put-let1 c (car bindings) n acc))
            (else
             (let* ((acc (put "let (" acc))
                    (acc (put-binding-names bindings acc))
                    (acc (put ") = (" acc))
                    (acc (put-binding-values c bindings n acc)))
               (put-nl n (put ");" acc)))))))

  (put-case-arms (subr kfx (ctx string sexps i64 tail chars) chars)
    (lambda (c kind arms n t acc)
      "A `match` arm a case arm: a character's and a boolean's data its
       patterns; an int's or a string's, compared in its guard, as Rust has
       no patterns for them."
      (if (null? arms)
          acc
          (let* ((arm (items (car arms)))
                 (acc (put-nl n acc))
                 (acc (cond ((sym-is? (car arm) "else") (put "_" acc))
                            ((or (string=? kind "int") (string=? kind "string"))
                             (put-sep (lambda ((d sexp) (acc chars))
                                        (put ")" (put-exp c d n (value) (put (if (string=? kind "int") "_eq(case_, " "string_eq_p(case_, ") acc))))
                                      " || " (items (car arm)) (put "case_ if " acc)))
                            (else (put-joined c (items (car arm)) " | " n acc))))
                 (acc (put " => " acc))
                 (acc (put-block c (cdr arm) n t acc)))
            (put-case-arms c kind (cdr arms) n t acc)))))

  (put-tagcase-arms (subr kfx (ctx string sexps i64 tail chars) chars)
    (lambda (c sum arms n t acc)
      (if (null? arms)
          acc
          (let* ((arm (items (car arms)))
                 (tag (sym-name (car arm)))
                 (else? (string=? tag "else"))
                 (whole? (tagcase (second arm) (sym (x) #t) (else other #f)))
                 (bound (if (or else? whole?)
                            (the strings (list (sym-name (second arm))))
                            (map sym-name (items (second arm)))))
                 (acc (put-nl n acc))
                 (acc (if else?
                          (let* ((acc (put "_ => {" acc))
                                 (acc (put-nl (i64+ n 1) acc))
                                 (acc (put "let " acc))
                                 (acc (put (mangle (sym-name (second arm))) acc)))
                            (put-nl (i64+ n 1) (put " = tagcase_;" acc)))
                          (let* ((acc (put (if (string=? sum "") (datatype-path (tag-datatype tag (ctx-tags c))) sum) acc))
                                 (acc (put "::" acc))
                                 (acc (put (camel tag) acc))
                                 (acc (put "(" acc)))
                            (cond ((string=? sum "") (put-nl (i64+ n 1) (put ") => {" (put-names (items (second arm)) acc))))
                                  (whole? (put-nl (i64+ n 1) (put ") => {" (put (mangle (sym-name (second arm))) acc))))
                                  (else (put-fields-of (items (second arm)) 0 (i64+ n 1)
                                                       (put-nl (i64+ n 1) (put "product_) => {" acc))))))))
                 (acc (put-stmts (with-locals c bound) (cdr (cdr arm)) (i64+ n 1) (hide t bound) acc))
                 (acc (put "}" (put-nl n acc))))
            (put-tagcase-arms c sum (cdr arms) n t acc)))))

  (put-fields-of (subr kfx (sexps i64 i64 chars) chars)
    (lambda (names i n acc)
      "A sum's member, a product, taken apart: a `let` for each field."
      (if (null? names)
          acc
          (put-fields-of (cdr names) (i64+ i 1) n
                         (put-nl n (put ";" (put (i64->string i) (put " = product_." (put (mangle (sym-name (car names))) (put "let " acc))))))))))

  (put-tagcase (subr kfx (ctx sexp sexps i64 tail chars) chars)
    (lambda (c e xs n t acc)
      "A `tagcase` as statements: its value bound once, then a `match`; of a
       sum, its enum's name from the tags the checker found."
      (let* ((tags (fact-with c e "tagcase-sum "))
             (sum (if (string=? tags "") "" (shape-name #f (split-words tags))))
             (acc (put "let tagcase_ = " acc))
             (acc (put-exp c (car xs) n (value) acc))
             (acc (put-nl n (put ";" acc)))
             (acc (put "match *tagcase_ {" acc))
             (acc (put-tagcase-arms c sum (cdr xs) (i64+ n 1) t acc)))
        (put "}" (put-nl n acc)))))

  (put-lambda (subr kfx (ctx sexp sexps sexps i64 chars) chars)
    (lambda (c e params body n acc)
      "A lambda as a value: a closure, `move`, since what it captures is
       `Copy`, made a `&'static dyn Fn` by `lambdaN`, `N` its arity."
      (let* ((acc (put "lambda" acc))
             (acc (put (i64->string (size params)) acc))
             (acc (put "(move |" acc))
             (acc (put-lambda-params c params acc))
             (acc (put "| " acc)))
        (if (fact-at? c e "fallible")
            (put ")" (put-block (with-locals c (cons "%fallible" (map param-name params))) body n (ok-value) acc))
            (put ")" (put-block (with-locals c (cons "%infallible" (map param-name params))) body n (value) acc))))))

  (put-lambda-params (subr kfx (ctx sexps chars) chars)
    (lambda (c params acc)
      "`x`, or `(x T)` as `x: T`."
      (if (null? params)
          acc
          (let ((acc (tagcase (car params)
                       (lst (xt src-file src-line src-pos) (put-type c (second xt) (put ": " (put (mangle (sym-name (car xt))) acc))))
                       (else name (put (mangle (sym-name name)) acc)))))
            (put-lambda-params c (cdr params) (if (null? (cdr params)) acc (put ", " acc)))))))

  (put-letrec (subr kfx (ctx sexps strings i64 chars) chars)
    (lambda (c bindings names n acc)
      "A letrec's procedures, made through knots: each knot made, then each
       closure, whose group it reaches through the knots, then each knot
       tied; a statement a line."
      (let* ((inside (with-locals c (map (lambda ((x string)) (string-append "%knot " x)) names)))
             (acc (put-sep (lambda ((b sexp) (acc chars))
                             (let* ((ys (items b))
                                    (acc (put "let " acc))
                                    (acc (put (mangle (sym-name (car ys))) acc))
                                    (acc (put "__knot = knot::<" acc))
                                    (acc (put-type c (second ys) acc)))
                               (put-nl n (put ">();" acc))))
                           "" bindings acc))
             (acc (put-sep (lambda ((b sexp) (acc chars))
                             (let* ((ys (items b))
                                    (acc (put "let " acc))
                                    (acc (put (mangle (sym-name (car ys))) acc))
                                    (acc (put " = " acc))
                                    (acc (put-exp inside (typed-lambda (third ys) (second ys)) n (value) acc)))
                               (put-nl n (put ";" acc))))
                           "" bindings acc)))
        (put-sep (lambda ((x string) (acc chars))
                   (put-nl n (put ");" (put (mangle x) (put "__knot.set(" (put (mangle x) acc))))))
                 "" names acc))))

  (put-list (subr kfx (ctx sexps i64 chars) chars)
    (lambda (c xs n acc)
      (if (null? xs)
          (put "nil()" acc)
          (let* ((acc (put "cons(" acc))
                 (acc (put-exp c (car xs) n (value) acc))
                 (acc (put ", " acc))
                 (acc (put-list c (cdr xs) n acc)))
            (put ")" acc)))))

  (put-form (subr kfx (ctx sexp string sexps i64 tail chars) chars)
    (lambda (c e h xs n t acc)
      "`e` is the whole form, `h` its head's name and `xs` the rest."
      (cond ((string=? h "if")
             (let* ((acc (put "if " acc))
                    (acc (put-exp c (car xs) n (value) acc))
                    (acc (put " " acc))
                    (acc (put-block c (list (second xs)) n t acc))
                    (acc (put " else " acc)))
               (put-block c (list (third xs)) n t acc)))
            ((string=? h "cond") (put-cond c xs n t acc))
            ((string=? h "and")
             (if (null? xs) (put "true" acc) (put ")" (put-joined c xs " && " n (put "(" acc)))))
            ((string=? h "or")
             (if (null? xs) (put "false" acc) (put ")" (put-joined c xs " || " n (put "(" acc)))))
            ((and (string=? h "with") (null? (cdr (cdr xs))))
             "A `with` of one expression, no block: only its names are its."
             (put-exp (with-opened c e) (second xs) n (opened-tail c e t) acc))
            ((or (string=? h "begin") (string=? h "let") (string=? h "let*") (string=? h "tagcase") (string=? h "with"))
             (put-block c (list e) n t acc))
            ((string=? h "case")
             (let* ((acc (put "match " acc))
                    (acc (put-exp c (car xs) n (value) acc))
                    (acc (put " {" acc))
                    (acc (put-case-arms c (case-kind c e) (cdr xs) (i64+ n 1) t acc)))
               (put "}" (put-nl n acc))))
            ((string=? h "lambda") (put-lambda c e (items (car xs)) (cdr xs) n acc))
            ((string=? h "product")
             (let* ((fs (map items xs))
                    (acc (put (shape-name #t (map (lambda ((f sexps)) (label-of (car f))) fs)) acc)))
               (put ")" (put-joined c (map second fs) ", " n (put "(" acc)))))
            ((string=? h "extract")
             (put (fact-with c e "extract-index ") (put "." (put-exp c (car xs) n (value) acc))))
            ((string=? h "sum")
             "A sum's enum written with its type's arguments, which only the type
              expected, as the checker found it, says."
             (let* ((ty (car (read-all (string-chars (fact-with c e "sum-type ")) "" 1)))
                    (fs (map items (cdr (items ty))))
                    (acc (put "alloc(" acc))
                    (acc (put (shape-name #f (map (lambda ((f sexps)) (label-of (car f))) fs)) acc))
                    (acc (put ">::" (put-types c (map second fs) (put "::<" acc))))
                    (acc (put (camel (label-of (car xs))) acc))
                    (acc (put "(" acc)))
               (put "))" (put-exp c (second xs) n (value) acc))))
            ((string=? h "list") (put-list c xs n acc))
            ((string=? h "the")
             "`the::<T>(e)`: the type said to rustc too, which may need it where
              FX-26's checker did (a tag's payload, a list nothing else types)."
             (let* ((acc (put "the::<" acc))
                    (acc (put-type c (car xs) acc))
                    (acc (put ">(" acc))
                    (acc (put-exp c (second xs) n (value) acc)))
               (put ")" acc)))
            ((or (string=? h "letrec") (string=? h "letregion")) (put-block c (list e) n t acc))
            ((abort? c e)
             "An abort: an early return, where a `Result` is returned; else no
              prompt can be running for its tag (the checker masked its region),
              and it fails, as FX-26's does when it runs."
             (let* ((acc (put (if (fallible-here? c) "(return Err(unwind(" "unreachable_unwind(unwind(") acc))
                    (acc (put-joined c xs ", " n acc)))
               (put (if (fallible-here? c) ")))" "))") acc)))
            ((and (string=? h "prompt") (string=? (local-kind h (ctx-locals c)) "")) (put-prompt c e xs n acc))
            ((null? xs) (put-question c e (put "()" (put (callee c h) acc))))
            (else (put-question c e (put ")" (put-joined c xs ", " n (put "(" (put (callee c h) acc)))))))))

  (put-prompt (subr kfx (ctx sexp sexps i64 chars) chars)
    (lambda (c e xs n acc)
      "`(prompt tag body handler)`: the body run in a closure that returns a
       `Result`, and its abort to the tag handled; any other abort passed on,
       if the function written may abort, else none can come (the checker
       found the prompt contains every abort its body may make)."
      (let* ((inner (with-locals c (list "%fallible")))
             (acc (put-nl (i64+ n 1) (put "{" acc)))
             (acc (put "let prompt_tag__ = " acc))
             (acc (put-exp c (car xs) (i64+ n 1) (value) acc))
             (acc (put-nl (i64+ n 1) (put ";" acc)))
             (acc (put "match (move || -> Result<_, Unwind> " acc))
             (acc (put-block inner (list (second xs)) (i64+ n 1) (ok-value) acc))
             (acc (put ")() {" acc))
             (acc (put-nl (i64+ n 2) acc))
             (acc (put "Ok(v) => v," acc))
             (acc (put-nl (i64+ n 2) acc))
             (acc (put "Err(u) if u.is(prompt_tag__) => (" acc))
             (acc (put-exp c (third xs) (i64+ n 2) (value) acc))
             (acc (put ")(prompt_tag__.payload(u))," acc))
             (acc (put-nl (i64+ n 2) acc))
             (acc (put (if (or (fact-at? c e "contains") (not (fallible-here? c)))
                           "Err(u) => unreachable_unwind(u),"
                           "Err(u) => return Err(u),")
                       acc))
             (acc (put-nl (i64+ n 1) acc))
             (acc (put "}" acc)))
        (put "}" (put-nl n acc)))))

  (put-question (subr kfx (ctx sexp chars) chars)
    (lambda (c e acc)
      "A call the checker found may abort takes a `?`."
      (cond ((not (fact-at? c e "fallible-call")) acc)
            ((fallible-here? c) (put "?" acc))
            (else (put ".unwrap_or_else(unreachable_unwind)" acc))))))

"Top-level forms"

(define put-params (subr kfx (ctx sexps sexps bool chars) chars)
  (lambda (c names types mutable acc)
    "Parameters, from a lambda's names and its `subr` type's; `mut` if
     `mutable`, for a procedure that loops."
    (if (null? names)
        acc
        (let* ((name (tagcase (car names) (lst (xs src-file src-line src-pos) (car xs)) (else other other)))
               (acc (if mutable (put "mut " acc) acc))
               (acc (put (mangle (sym-name name)) acc))
               (acc (put ": " acc))
               (acc (put-type c (car types) acc)))
          (put-params c (cdr names) (cdr types) mutable
                      (if (null? (cdr names)) acc (put ", " acc)))))))

(define put-generics (subr kfx (sexps bool chars) chars)
  (lambda (binders first acc)
    "A poly's binders as a fn's generics: a type is a Rust type parameter,
     `Copy` and `'static` as every KFX value is; an effect is erased, and so,
     until places come (TODO.md section 14), is a region, every one's place
     being the heap."
    (if (null? binders)
        (if first acc (put ">" acc))
        (let* ((b (items (car binders)))
               (kind (sym-name (second b))))
          (cond ((string=? kind "type")
                 (let* ((acc (put (if first "<" ", ") acc))
                        (acc (put (camel (sym-name (car b))) acc)))
                   (put-generics (cdr binders) #f (put ": Copy + 'static" acc))))
                ((or (string=? kind "effect") (string=? kind "region")) (put-generics (cdr binders) first acc))
                (else (error (string-append "kfx: KFX-0 has no poly over a " kind))))))))

(define unpoly (subr kfx (sexp) sexp)
  (lambda (e)
    "A poly type's body, or a plambda's: what is under the binders."
    (if (or (head-is? e "poly") (head-is? e "plambda")) (third (items e)) e)))

(define put-define (subr kfx (ctx sexp sexp sexp chars) chars)
  (lambda (c name type defined acc)
    "A definition, a `fn`: a procedure's of its parameters; a constant's of
     none, run at each use, or, if it allocates, made at its first use and
     kept (C21)."
    (let* ((binders (if (head-is? type "poly") (items (second (items type))) nil))
           (type (unpoly type))
           (defined (unpoly defined))
           (lambda? (head-is? defined "lambda"))
           (body (if lambda? (cdr (cdr (items defined))) (the sexps (list defined))))
           (doc? (and (comment? (car body)) (not (null? (cdr body)))))
           (acc (if doc? (put "\n" (put-comment (string-chars (comment-text (car body))) "///" 0 #t acc)) acc))
           (body (if doc? (cdr body) body))
           (fallible (and lambda? (fallible-effect? c (second (items type)))))
           (t (if lambda?
                  (returns (sym-name name) (map param-name (items (second (items defined)))) #t fallible)
                  (value)))
           (loops? (and lambda? (tail-calls? t (last body))))
           (inner (if lambda?
                      (with-locals c (cons (if fallible "%fallible" "%infallible")
                                           (map param-name (items (second (items defined))))))
                      c))
           (acc (put "pub fn " acc))
           (acc (put (mangle (sym-name name)) acc))
           (acc (put-generics binders #t acc))
           (acc (if lambda?
                    (let* ((acc (put "(" acc))
                           (acc (put-params c (items (second (items defined))) (items (third (items type)))
                                            loops? acc))
                           (acc (put ") -> " acc)))
                      (if fallible
                          (put ", Unwind>" (put-type c (fourth (items type)) (put "Result<" acc)))
                          (put-type c (fourth (items type)) acc)))
                    (put-type c type (put "() -> " acc))))
           (acc (put " {" acc)))
      (if loops?
          (let* ((acc (put-nl 2 (put "loop {" (put-nl 1 acc))))
                 (acc (put-stmts inner body 2 t acc)))
            (put "\n    }\n}\n\n" acc))
          (if (and (not lambda?) (fact-at? c defined "once"))
              (let* ((acc (put-nl 1 acc))
                     (acc (put "thread_local!(static ONCE: OnceCell<" acc))
                     (acc (put-type c type acc))
                     (acc (put "> = const { OnceCell::new() });" acc))
                     (acc (put-nl 1 acc))
                     (acc (put "once(&ONCE, || {" acc))
                     (acc (put-stmts inner body 2 (value) (put-nl 2 acc))))
                (put "\n    })\n}\n\n" acc))
              (put "\n}\n\n" (put-stmts inner body 1 (if fallible (ok-value) (value)) (put-nl 1 acc))))))))

(define put-rec (subr kfx (ctx sexps chars) chars)
  (lambda (c bindings acc)
    (if (null? bindings)
        acc
        (let ((b (items (car bindings))))
          (put-rec c (cdr bindings) (put-define c (car b) (second b) (third b) acc))))))

(define put-variants (subr kfx (ctx sexps chars) chars)
  (lambda (c variants acc)
    (if (null? variants)
        acc
        (let* ((v (items (car variants)))
               (acc (put "    " acc))
               (acc (put (camel (sym-name (car v))) acc))
               (acc (put "(" acc))
               (acc (put-types c (cdr v) acc)))
          (put-variants c (cdr variants) (put "),\n" acc))))))

(define put-fields (subr kfx (ctx sexps i64 bool chars) chars)
  (lambda (c types i typed acc)
    "Fields `f0`, `f1`, ..., from `i`, with their types if `typed`."
    (if (null? types)
        acc
        (let* ((acc (if (i64= i 0) acc (put ", " acc)))
               (acc (put "f" acc))
               (acc (put (i64->string i) acc))
               (acc (if typed (put-type c (car types) (put ": " acc)) acc)))
          (put-fields c (cdr types) (i64+ i 1) typed acc)))))

(define put-constructors (subr kfx (ctx string strings sexps chars) chars)
  (lambda (c d params variants acc)
    (if (null? variants)
        acc
        (let* ((v (items (car variants)))
               (tag (sym-name (car v)))
               (acc (put "pub fn " acc))
               (acc (put (mangle tag) acc))
               (acc (put-generics-of params #t acc))
               (acc (put "(" acc))
               (acc (put-fields c (cdr v) 0 #t acc))
               (acc (put ") -> &'static " acc))
               (acc (put (camel d) acc))
               (acc (put-generics-of params #f acc))
               (acc (put " {\n    alloc(" acc))
               (acc (put (camel d) acc))
               (acc (put "::" acc))
               (acc (put (camel tag) acc))
               (acc (put "(" acc))
               (acc (put-fields c (cdr v) 0 #f acc)))
          (put-constructors c d params (cdr variants) (put "))\n}\n\n" acc))))))

(define put-datatype (subr kfx (ctx sexps chars) chars)
  (lambda (c xs acc)
    "An enum, generic in its type parameters (its regions are erased), and a
     constructor for each variant."
    (let* ((d (type-head-name (car xs)))
           (params (head-type-params (car xs)))
           (acc (put "pub enum " acc))
           (acc (put (camel d) acc))
           (acc (put-generics-of params #t acc))
           (acc (put " {\n" acc))
           (acc (put-variants c (cdr xs) acc))
           (acc (put "}\n\n" acc)))
      (put-constructors c d params (cdr xs) acc))))

(define put-generative (subr kfx (ctx sexps chars) chars)
  (lambda (c xs acc)
    "A generative type: a new type, a newtype in Rust, and its conversions."
    (let* ((t (type-head-name (car xs)))
           (params (head-type-params (car xs)))
           (inside (not (string=? (module-here c) "")))
           (acc (put "#[derive(Clone, Copy)]\npub struct " acc))
           (acc (put (camel t) acc))
           (acc (put-generics-of params #t acc))
           (acc (put (if inside "(" "(pub ") acc))
           (acc (put-type c (second xs) acc))
           (acc (put (if inside ");\n\nfn up_" ");\n\npub fn up_") acc))
           (acc (put (mangle t) acc))
           (acc (put-generics-of params #t acc))
           (acc (put "(x: " acc))
           (acc (put-type c (second xs) acc))
           (acc (put ") -> " acc))
           (acc (put (camel t) acc))
           (acc (put-generics-of params #f acc))
           (acc (put " {\n    " acc))
           (acc (put (camel t) acc))
           (acc (put (if inside "(x)\n}\n\nfn down_" "(x)\n}\n\npub fn down_") acc))
           (acc (put (mangle t) acc))
           (acc (put-generics-of params #t acc))
           (acc (put "(x: " acc))
           (acc (put (camel t) acc))
           (acc (put-generics-of params #f acc))
           (acc (put ") -> " acc))
           (acc (put-type c (second xs) acc)))
      (put " {\n    x.0\n}\n\n" acc))))

(define-rec
  (indented (subr kfx (chars bool chars) chars)
    (lambda (cs start acc)
      "Lines, each not empty four spaces in: `acc`, a module's items."
      (cond ((null? cs) acc)
            ((char=? (car cs) #\newline) (indented (cdr cs) #t (cons (car cs) acc)))
            (start (indented (cdr cs) #f (cons (car cs) (put "    " acc))))
            (else (indented (cdr cs) #f (cons (car cs) acc)))))))

(define-rec
  (trimmed (subr kfx (chars) chars)
    (lambda (cs)
      "Written text, its last newlines dropped."
      (if (and (not (null? cs)) (char=? (car cs) #\newline)) (trimmed (cdr cs)) cs))))

(define without (subr kfx (strings strings) strings)
  (lambda (xs ys)
    (if (null? xs) nil
        (if (string-member? (car xs) ys) (without (cdr xs) ys) (cons (car xs) (without (cdr xs) ys))))))

(define definition? (subr kfx (sexp) bool)
  (lambda (e)
    (or (head-is? e "define") (head-is? e "define*") (head-is? e "define-rec") (module-def? e)
        (head-is? e "define-datatype") (head-is? e "define-type") (head-is? e "define-generative"))))

"The shapes a program has, each declared once: every `productof`,
 `sumof` and `product` in it, and in the types the checker elaborated and
 found for sums. A shape's key is `P` or `S`, then its labels."

(define shape-key (subr kfx (sexp) strings)
  (lambda (e)
    "The key of the shape `e` writes, if it writes one."
    (tagcase e
      (lst (xs f l p)
        (if (and (not (null? xs))
                 (or (sym-is? (car xs) "productof") (sym-is? (car xs) "product") (sym-is? (car xs) "sumof"))
                 (not (any? (lambda ((x sexp)) (tagcase x (lst (ys f2 l2 p2) (null? ys)) (else other #t))) (cdr xs))))
            (the strings
              (list (string-append (if (sym-is? (car xs) "sumof") "S" "P")
                                   (concat-strings (map (lambda ((x sexp)) (string-append " " (label-of (car (items x))))) (cdr xs))))))
            nil))
      (else other nil))))

(define-rec
  (shapes-in (subr kfx (sexp strings) strings)
    (lambda (e acc)
      (tagcase e
        (lst (xs f l p)
          (let ((acc (shapes-in-all xs acc))
                (key (shape-key e)))
            (if (or (null? key) (string-member? (car key) acc)) acc (cons (car key) acc))))
        (else other acc))))
  (shapes-in-all (subr kfx (sexps strings) strings)
    (lambda (es acc) (if (null? es) acc (shapes-in-all (cdr es) (shapes-in (car es) acc))))))

(define program-shapes (subr kfx (ctx sexps) strings)
  (lambda (c forms)
    (tagcase c
      (ctx (ds ts ks ls xs fs ms es mods)
        (reverse-strings
         (shapes-in-all (onto (map (lambda ((x typed)) (tagcase x (typed (n t) t))) xs)
                              (concat (map (lambda ((f fact))
                                             (tagcase f
                                               (fact (ff fp fw)
                                                 (if (has-prefix? fw "sum-type ")
                                                     (read-all (string-chars (after-prefix fw "sum-type ")) "" 1)
                                                     nil))))
                                           fs)))
                        (shapes-in-all forms nil))
         nil)))))

(define-rec
  (put-params-of (subr kfx (i64 i64 chars) chars)
    (lambda (i n acc)
      (if (i64< i n)
          (put-params-of (i64+ i 1) n (put (i64->string i) (put (if (i64= i 0) "A" ", A") acc)))
          acc))))

(define put-generic-params (subr kfx (i64 chars) chars)
  (lambda (n acc) (if (i64= n 0) acc (put ">" (put-params-of 0 n (put "<" acc))))))

(define-rec
  (put-variants-of (subr kfx (strings i64 chars) chars)
    (lambda (tags i acc)
      (if (null? tags)
          acc
          (put-variants-of (cdr tags) (i64+ i 1)
                           (put "),\n" (put (i64->string i) (put "(A" (put (camel (car tags)) (put "    " acc))))))))))

(define put-shape-decls (subr kfx (strings bool chars) chars)
  (lambda (keys shows acc)
    "Each shape's declaration, and, for `kfx --toplevel`, its `Show`, as
     Fixpt writes one: `#<product of 2>`, `#<sum leaf>`."
    (if (null? keys)
        acc
        (let* ((key (car keys))
               (product (string=? (substring-of key 1) "P"))
               (labels (split-words (after-prefix key (substring-of key 1))))
               (name (shape-name product labels))
               (n (size labels))
               (acc (put "#[allow(non_camel_case_types)]\n" acc))
               (acc (if product
                        (put ");\n\n" (put-sep (lambda ((i i64) (acc chars)) (put (i64->string i) (put "pub A" acc))) ", " (counting 0 n)
                                             (put "(" (put-generic-params n (put name (put "#[derive(Clone, Copy)]\npub struct " acc))))))
                        (put "}\n\n" (put-variants-of labels 0 (put " {\n" (put-generic-params n (put name (put "pub enum " acc))))))))
               (acc (if (not shows)
                        acc
                        (let ((acc (put " {\n    fn show(&self, out: &mut String) {\n" (put-generic-params n (put name (put " Show for " (put-generic-params n (put "impl" acc))))))))
                          (put "    }\n}\n\n"
                               (if product
                                   (put ">\");\n" (put (i64->string n) (put "        out.push_str(\"#<product of " acc)))
                                   (put "        }\n"
                                        (put-sep (lambda ((l string) (acc chars))
                                                   (put ">\"),\n" (put l (put "(..) => out.push_str(\"#<sum " (put (camel l) (put "::" (put name (put "            " acc))))))))
                                                 "" labels (put "        match self {\n" acc)))))))))
          (put-shape-decls (cdr keys) shows acc)))))

(define put-shapes (subr kfx (ctx sexps bool chars) chars)
  (lambda (c forms shows acc) (put-shape-decls (program-shapes c forms) shows acc)))

"A program's top-level expressions, for running Fixpt's programs as Rust
 (`kfx --toplevel`, scripts/run-fixpt-programs.py): a `Show` for each
 datatype, writing a value as Fixpt does, `#<sum TAG>`; and
 `kfx_toplevel`, which writes each top-level expression's value on a line,
 top-level strings too, as `fixpt eval` does."

(define put-show-arms (subr kfx (string sexps chars) chars)
  (lambda (d variants acc)
    (if (null? variants)
        acc
        (let* ((tag (sym-name (car (items (car variants)))))
               (acc (put "            " acc))
               (acc (put (camel d) acc))
               (acc (put "::" acc))
               (acc (put (camel tag) acc))
               (acc (put "(..) => out.push_str(str_lit(\"#<sum " acc))
               (acc (put tag acc)))
          (put-show-arms d (cdr variants) (put ">\").as_str()),\n" acc))))))

(define put-show-impls (subr kfx (sexps chars) chars)
  (lambda (forms acc)
    (cond ((null? forms) acc)
          ((head-is? (car forms) "define-datatype")
           (let* ((xs (cdr (items (car forms))))
                  (d (type-head-name (car xs)))
                  (params (head-type-params (car xs)))
                  (acc (put "impl" acc))
                  (acc (put-generics-of params #t acc))
                  (acc (put " Show for " acc))
                  (acc (put (camel d) acc))
                  (acc (put-generics-of params #f acc))
                  (acc (put " {\n    fn show(&self, out: &mut String) {\n        match self {\n" acc))
                  (acc (put-show-arms d (cdr xs) acc)))
             (put-show-impls (cdr forms) (put "        }\n    }\n}\n\n" acc))))
          ((head-is? (car forms) "define-generative")
           (let* ((h (second (items (car forms))))
                  (params (head-type-params h))
                  (acc (put "impl" acc))
                  (acc (if (null? params)
                           acc
                           (put ">" (put-sep (lambda ((n string) (acc chars))
                                               (put ": Copy + 'static + Show" (put (camel n) acc)))
                                             ", " params (put "<" acc)))))
                  (acc (put " Show for " acc))
                  (acc (put (camel (type-head-name h)) acc))
                  (acc (put-generics-of params #f acc)))
             (put-show-impls (cdr forms) (put " {\n    fn show(&self, out: &mut String) {\n        self.0.show(out)\n    }\n}\n\n" acc))))
          (else (put-show-impls (cdr forms) acc)))))

(define put-show-generatives (subr kfx (sexps chars) chars)
  (lambda (forms acc)
    "In toplevel mode, a module's datatypes' and generative types' `Show`,
     inside it, where their representations are seen."
    (put-show-impls (concat (map (lambda ((f sexp)) (if (or (head-is? f "define-generative") (head-is? f "define-datatype")) (the sexps (list f)) nil)) forms)) acc)))

(define-rec
  (put-top (subr kfx (ctx sexp chars) chars)
    (lambda (c form acc)
      (let* ((xs (tagcase form (lst (ys f l p) ys) (else other nil)))
             (h (if (null? xs) "" (tagcase (car xs) (sym (n) n) (else other "")))))
        (cond ((string=? h "define-effect") acc)
              ((string=? h "define-type")
               (let* ((acc (put "pub type " acc))
                      (acc (put (camel (type-head-name (second xs))) acc))
                      (acc (put-generics-of (head-type-params (second xs)) #f acc))
                      (acc (put " = " acc))
                      (acc (put-type c (third xs) acc)))
                 (put ";\n\n" acc)))
              ((string=? h "define-datatype") (put-datatype c (cdr xs) acc))
              ((string=? h "define-generative") (put-generative c (cdr xs) acc))
              ((module-def? form) (put-module c (sym-name (second xs)) (cdr (items (third xs))) acc))
              ((or (string=? h "define") (string=? h "define*"))
               (if (i64= (size xs) 4)
                   (put-define c (second xs) (third xs) (fourth xs) acc)
                   (put-define c (second xs) (car (ctx-typed c (sym-name (second xs)))) (third xs) acc)))
              ((string=? h "define-rec") (put-rec c (cdr xs) acc))
              (else acc)))))

  (put-module (subr kfx (ctx string sexps chars) chars)
    (lambda (c m forms acc)
      "A module, a Rust `mod` (C19): its items as a program's, the program's
       names in scope, its own hiding them."
      (let* ((outer (tagcase c (ctx (ds ts ks ls xs fs ms es mods)
                                 (ctx ds ts (without ks (item-values forms)) ls xs fs ms es mods))))
             (inner (with-locals (collect forms outer) (list (string-append "%in " m))))
             (body (put-tops inner forms nil))
             (body (if (string-member? "%toplevel" (ctx-locals c)) (put-show-generatives forms body) body))
             (acc (put "pub mod " acc))
             (acc (put (mangle m) acc))
             (acc (put " {\n    use super::*;\n\n" acc)))
        (put "\n}\n\n" (indented (rev-onto (trimmed body) nil) #t acc)))))

  (put-tops (subr kfx (ctx sexps chars) chars)
    (lambda (c forms acc)
      "A string at the top level is a comment. A procedure's documentation is
       a string first in its body, as a Lisp docstring is: see `put-define`."
      (cond ((null? forms) acc)
            ((comment? (car forms))
             (let* ((doc (and (not (null? (cdr forms))) (definition? (second forms))))
                    (acc (put-comment (string-chars (comment-text (car forms))) "//" 0 #t acc)))
               (put-tops c (cdr forms) (put (if doc "\n" "\n\n") acc))))
            (else (put-tops c (cdr forms) (put-top c (car forms) acc)))))))

(define toplevel-form? (subr kfx (sexp) bool)
  (lambda (f) (not (or (definition? f) (head-is? f "define-effect")))))

(define put-toplevel-lines (subr kfx (ctx sexps chars) chars)
  (lambda (c forms acc)
    (cond ((null? forms) acc)
          ((toplevel-form? (car forms))
           (let* ((acc (put "    show_line(&mut out, (|| -> Result<_, Unwind> { Ok(" acc))
                  (acc (put-exp (with-locals c (list "%fallible")) (car forms) 1 (value) acc)))
             (put-toplevel-lines c (cdr forms) (put ") })().unwrap_or_else(|u| unreachable_unwind(u)));\n" acc))))
          (else (put-toplevel-lines c (cdr forms) acc)))))

(define put-toplevel (subr kfx (ctx sexps chars) chars)
  (lambda (c forms acc)
    (let* ((acc (put-show-impls forms acc))
           (acc (put "/// The program's top-level expressions' values, as Fixpt writes them.\npub fn kfx_toplevel() -> Str {\n    let mut out = String::new();\n" acc))
           (acc (put-toplevel-lines c forms acc)))
      (put "    shown(out)\n}\n" acc))))
