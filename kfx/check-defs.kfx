"FX-26's forms of processes that are calls (C101), at the types FX-26's
 checker gives them: a call headed by one is the form, whatever a program
 binds the name to, as FX-26 parses it; `send` and `receive` are no
 values, and `icell-get` and `icell-put!` are the primitives too."
(define process-forms string
  "(send (poly ((r region) (m type)) (subr (send r) ((addr m r) m) unit)))
   (receive (poly ((r region) (m type)) (subr (maxeff (receive r) nondet) ((inbox m r)) m)))
   (icell-get (poly ((r region) (t type)) (subr (await r) ((icell t r)) t)))
   (icell-put! (poly ((r region) (t type)) (subr (init r) ((icell t r) t) unit)))")

"kayak-rt's primitives at KFX's types: the prelude's (kfx/prelude.fx), and
 FX-26's standard environment's at `acyclic`, where making and reading
 lists are pure."

(define prelude string
  "(string-length-i64 (subr pure (string) i64)) (string-ref-i64 (subr pure (string i64) char))
   (char->i64 (subr pure (char) i64)) (i64->char (subr pure (i64) char)) (i64->string (subr pure (i64) string))
   (make-flatarray-i64 (poly ((r region)) (subr (alloc r) (i64 i64) (flatarrayof i64 r))))
   (flatarray-ref-i64 (poly ((r region)) (subr (read r) ((flatarrayof i64 r) i64) i64)))
   (flatarray-set-i64! (poly ((r region)) (subr (write r) ((flatarrayof i64 r) i64 i64) unit)))
   (flatarray-length-i64 (poly ((r region)) (subr pure ((flatarrayof i64 r)) i64)))")

"The prelude's (kfx/prelude.fx), at the types it gives them. To FX-26
 they are globals, the prelude's definitions: calling one reads it."

(define table-binds (subr kfx (cv string string string) binds)
  (lambda (v table file wher)
    (map (lambda ((p sexp))
           (let ((xs (items p)))
             (bind (name-of v (car xs)) (parse-scheme-of v (second xs) #f) wher)))
         (read-all (string-chars table) file 1))))

(define prim-binds (subr kfx (cv) binds)
  (lambda (v)
    (onto (table-binds v primitives "kayak-rt's primitives" "prim")
          (onto (map (lambda ((b bind)) (tagcase b (bind (n sc w) (bind (string-append "%form " n) sc w))))
                     (table-binds v process-forms "FX-26's processes" "prim"))
                (table-binds v prelude "kfx/prelude.fx" "global")))))

(define head-name (subr kfx (cv sexp) string)
  (lambda (v head)
    (tagcase head (lst (xs src-file src-line src-pos) (name-of v (car xs))) (else other (name-of v other)))))

(define datatype-of (subr kfx (cv sexps) dt)
  (lambda (v xs)
    "A define-datatype's name, parameters and variants, whose fields'
     types may name the parameters; no two tags camel-cased alike in Rust."
   (if (repeated? (map (lambda ((vt sexp)) (variant-name (tagcase (car (items vt)) (sym (n at-file at-pos) n) (else other "")))) (cdr xs)))
       (refuse v "two tags of one datatype named alike in Rust (camel-cased)")
    (let ((params (family-params v (car xs))))
      (dt (head-name v (car xs))
          params
          (map (lambda ((vt sexp))
                 (let ((ys (items vt)))
                   (variant (name-of v (car ys)) (parse-types v params (cdr ys)))))
               (cdr xs)))))))

(define constructors (subr kfx (dt) binds)
  (lambda (d)
    (tagcase d
      (dt (name ps vs)
        (map (lambda ((vt variant))
               (tagcase vt
                 (variant (tag fields)
                   (bind tag (scheme ps (ty-proc nil fields (ty-data name (map (lambda ((p string)) (ty-var p)) ps))))
                         "global"))))
             vs)))))

"Types and datatypes are declared ahead: every one is in scope in every
 definition, as FX-26 has it. Effect abbreviations and values are seen
 only after their definitions."

(define type-name (subr kfx (cv sexp) string)
  (lambda (v form)
    "A define-type's or define-datatype's name, from its head: a name, or
     `(name (p kind) ...)` for a family."
    (tagcase form
      (lst (xs src-file src-line src-pos) (head-name (near v src-file src-line src-pos) (second xs)))
      (else other (refuse v "a definition is expected")))))

(define type-params (subr kfx (cv sexp) strings)
  (lambda (v form)
    (tagcase form
      (lst (xs src-file src-line src-pos) (family-params (near v src-file src-line src-pos) (second xs)))
      (else other nil))))

(define declared-convention (subr kfx (cv sexps) string)
  (lambda (v xs)
    "`(define-convention name clause ...)` (C116, Fixpt's TODO §97): its
     name, if its clauses, each printed as Fixpt prints it, are in any
     order those of the native convention of the machine this runs on
     (`(native-convention)`: Fixpt's for that machine, which kayak-jit
     keeps, as Fixpt's checkers compare with its own machine's); else
     refused. The convention it names is then `native`."
    (cond ((or (i64< (size xs) 3) (not (tagcase (second xs) (sym (n f p) #t) (else other #f))))
           (refuse v "(define-convention name clause ...)"))
          ((not (strings=? (sorted-strings (map show-sexp (cdr (cdr xs))))
                           (sorted-strings (the strings (native-convention)))))
           (refuse v (string-append "a convention not the native one, which alone this implementation supports: "
                                    (sym-name (second xs)))))
          (else (sym-name (second xs))))))

(define declare-types (subr kfx (cv sexps aliases) aliases)
  (lambda (v forms als)
    (cond ((null? forms) als)
          ((head-is? (car forms) "define-type")
           (let ((xs (items (car forms))))
             (declare-types v (cdr forms)
                            (cons (alias (type-name v (car forms)) (type-params v (car forms)) (third xs)) als))))
          ((head-is? (car forms) "define-convention")
           "A convention's name (C116), `%conv name`, standing for `native`."
           (let ((n (tagcase (car forms)
                      (lst (xs f l p) (declared-convention (near v f l p) xs))
                      (else other (declared-convention v (items other))))))
             (declare-types v (cdr forms) (cons (alias (string-append "%conv " n) nil (sym "native" "" 0)) als))))
          (else (declare-types v (cdr forms) als)))))

(define datatype-names (subr kfx (cv sexps dts) dts)
  (lambda (v forms ds)
    "The datatypes' names, before their variants' types can be read."
    (cond ((null? forms) ds)
          ((or (head-is? (car forms) "define-datatype") (head-is? (car forms) "define-generative"))
           (datatype-names v (cdr forms)
                           (cons (dt (type-name v (car forms)) (type-params v (car forms)) nil) ds)))
          (else (datatype-names v (cdr forms) ds)))))

(define with-effdef (subr kfx (cv sexps) cv)
  (lambda (v xs)
    "`v`, with a define-effect's abbreviation."
    (tagcase v
      (cv (bs ds als es here group file line fs tv at)
        (cv bs ds als (cons (effdef (name-of v (second xs)) (parse-effect v nil (third xs))) es) here group file line fs tv at)))))

(define-rec
  (selects? (subr kfx (sexp) bool)
    (lambda (e)
      "Whether `e` selects from a module not made yet: not a shared load's,
       `made--load--K`, which is made before the module that loads it
       (C119), so that an effect selected from it is read with the module's
       own, and those after it may name it."
      (tagcase e
        (lst (xs f l p)
          (or (and (sym-is? (car xs) "select") (not (null? (cdr xs)))
                   (tagcase (second xs) (sym (n f2 p2) (not (has-prefix? n "made--load--"))) (else other #t)))
              (any? selects? xs)))
        (else other #f)))))

(define declare-datatypes (subr kfx (cv sexps dts) dts)
  (lambda (v forms ds)
    "Each datatype's variants' types, as an effect abbreviation before it
     has them read."
    (cond ((null? forms) ds)
          ((head-is? (car forms) "define-datatype")
           (declare-datatypes v (cdr forms) (cons (datatype-of v (cdr (items (car forms)))) ds)))
          ((head-is? (car forms) "define-generative")
           (declare-datatypes v (cdr forms)
                              (cons (dt (type-name v (car forms)) (type-params v (car forms)) nil) ds)))
          ((and (head-is? (car forms) "define-effect") (not (selects? (car forms))))
           "An effect abbreviation, for the datatypes' fields' types; one that
            selects a module's is read where it stands, after the module."
           (declare-datatypes (with-effdef v (items (car forms))) (cdr forms) ds))
          (else (declare-datatypes v (cdr forms) ds)))))

(define at (subr kfx (cv string strings) cv)
  (lambda (v here group)
    (tagcase v (cv (bs ds als es h g file line fs tv at) (cv bs ds als es here group file line fs tv at)))))

(define runtime-name? (subr kfx (string) bool)
  (lambda (name)
    "kayak-rt's own names, which the generated modules import with the
     program's: a global of one of them would be ambiguous in Rust."
    (or (string=? name "alloc") (string=? name "leak-string") (string=? name "with-big-stack")
        (string=? name "abort-current-continuation") (string=? name "make-continuation-prompt-tag")
        (string=? name "the") (string=? name "unwind") (string=? name "knot")
        (string=? name "lambda0") (string=? name "lambda1") (string=? name "lambda2")
        (string=? name "lambda3") (string=? name "lambda4"))))

(define scheme-text (subr kfx (scheme) string)
  (lambda (sc) (tagcase sc (scheme (tvars t) (string-append (words-of tvars) (string-append " | " (show-ty (st nil 0 nil) t)))))))

(define global (subr kfx (cv string scheme) bind)
  (lambda (v name sc0)
    "A global. FX-26 may define a name again, at the same type (C61), and
     what used it sees the new one; at another type its users would break,
     which FX-26 says at their use, and the checker here at the
     redefinition, so that the two still refuse the one program. KFX
     defines each name once, and none kayak-rt has: the restriction pass's
     (restrict.kfx), as the generated modules each import every other's
     names and kayak-rt's. A module's item may shadow a primitive or a
     global (C87), as FX-26's may, and as a Rust `mod`'s item shadows what
     it imports by a glob."
    (cond ((and (keyword? name) (null? (find-bind "%module" (cv-binds v))))
           (refuse v (string-append "a keyword names nothing: " name)))
          (else
           (let ((found (find-bind name (cv-binds v)))
                 ;; A module value's abstract types named for it (C170).
                 (sc (tagcase sc0 (scheme (tv t) (scheme tv (mtype-named name t))))))
             (if (null? found)
                 (bind name sc (if (null? (find-bind "%module" (cv-binds v))) "global" "item"))
                 (tagcase (car found)
                   (bind (n sc0 wher)
                     (if (or (string=? (scheme-text sc0) (scheme-text sc))
                             ;; FX-26's program shadows the standard environment (C171);
                             ;; KFX's names none of it (the restriction pass).
                             (string=? wher "prim")
                             (and (not (null? (find-bind "%module" (cv-binds v)))) (or (string=? wher "prim") (string=? wher "global"))))
                         (bind name sc (if (null? (find-bind "%module" (cv-binds v))) "global" "item"))
                         (refuse v (string-append name " is defined again, at another type, which would break what uses it")))))))))))

(define conversions (subr kfx (cv sexps) binds)
  (lambda (v xs)
    "A `define-generative`'s conversions, `up-t` from what it is made of and
     `down-t` back: a new type, distinct from its representation, as
     FX-26's top-level generative type is (not abstract: anyone may convert)."
    (let* ((name (head-name v (second xs)))
           (params (family-params v (second xs)))
           (made (ty-data name (map (lambda ((p string)) (ty-var p)) params)))
           (repr (parse-type (with-tvars v params) params (third xs))))
      (list (bind (string-append "up-" name) (scheme params (ty-proc nil (list repr) made)) "global")
            (bind (string-append "down-" name) (scheme params (ty-proc nil (list made) repr)) "global")))))

(define defined-once (subr kfx (cv binds) cv)
  (lambda (v bs)
    "`v` with each of `bs`, each refused if its name is taken (`global`)."
    (if (null? bs)
        v
        (tagcase (car bs)
          (bind (n sc wher) (defined-once (with-binds v (list (global v n sc))) (cdr bs)))))))

(define new-state (subr kfx () st) (lambda () (st nil 0 nil)))

(define with-facts (subr kfx (cv facts) cv)
  (lambda (v more)
    "`v`, with a definition's facts."
    (tagcase v (cv (bs ds als es here group file line fs tv at) (cv bs ds als es here group file line (onto more fs) tv at)))))


(define no-reaching-itself (subr kfx (cv strings scheme) cv)
  (lambda (v group sc)
    "A global whose latent effect reads itself, or a member of its group,
     may reach itself through the store: its type says `spin`, as FX-26's
     must (`no_reaching_itself`)."
    (tagcase sc
      (scheme (tvars t)
        (tagcase t
          (ty-proc (es ps r)
            (if (and (not (string-member? "spin" es))
                     (any? (lambda ((n string)) (string-member? (string-append "g:" n) es)) group))
                (refuse v (string-append "calling it reads " (string-append (words-of group)
                          ": it may reach itself through a global, so its type must say spin")))
                v))
          (else other v))))))

(define ends-alone? (subr kfx (cv string scheme sexp) bool)
  (lambda (v name sc defined)
    "Whether a definition of one procedure ends however it calls itself, so
     that its calls of itself need no `spin` (`terminates?`)."
    (tagcase sc (scheme (tvars t) (with termination (terminates? v (list name) (list t) (list defined)))))))

(define-rec
  (makes-pairs? (subr kfx (sexp) bool)
    (lambda (e)
      "Whether `e` makes a list, `list` or `cons`: an acyclic one's making
       has no effect, but a constant of one is made once all the same, not
       at each use (`rust-keywords`), FX-26's list being immutable."
      (tagcase e
        (lst (xs file line pos)
          (and (not (null? xs))
               (or (sym-is? (car xs) "list") (sym-is? (car xs) "cons") (any? makes-pairs? (cdr xs)))))
        (else other #f)))))

(define constant-made (subr kfx (cv st sexp strings ty) st)
  (lambda (v s e es t)
    "A constant's value, of effect `es`: it may read globals, and allocate,
     and is then made once, at its first use, and kept (C21), which the
     emitter is told; nothing else, since when it is made is not when
     FX-26 makes it, where it is defined."
    (cond ((any? (lambda ((x string))
                   (not (or (string=? x "spin") (string=? x "@globals") (global-atom? x) (has-prefix? x "alloc:"))))
                 es)
           (kfx-restricted v s (string-append "a constant whose value has the effect " (string-append (show-effs es)
                     ": KFX makes a constant at its first use, so its value may only read globals and allocate"))))
          ((and (not (null? (find-bind "%loaded" (cv-binds v))))
                (any? (lambda ((x string)) (not (or (string=? x "@globals") (global-atom? x)))) es))
           "In a file loaded (C88): FX-26 makes it once, for all its loads, so
            making it must be pure but for reading globals."
           (if (null? (find-bind "%instance" (cv-binds v)))
               (refuse v (string-append "a loaded file is one value for all its loads, made once, so making it must be pure, and this one has "
                                        (string-append (show-effs es) ": make its state in a `lambda` it gives, which each caller applies")))
               ;; A file of module parameters, made for each call in FX-26 (C171).
               (kfx-restricted v s (string-append "a loaded file is one value for all its loads, made once, so making it must be pure, and this one has "
                                        (string-append (show-effs es) ": make its state in a `lambda` it gives, which each caller applies")))))
          ((or (any? (lambda ((x string)) (has-prefix? x "alloc:")) es) (makes-pairs? e))
           "Kept for the whole program if its type's Rust is `Sync`, which a
            process may hold; else for each thread, which none may (C102)."
           (tagcase e
             (lst (xs file line pos)
               (let ((s (note-fact s file pos "once")))
                 (if (with expressions (sync-type? v s t nil)) (note-fact s file pos "shared") s)))
             (else other s)))
          (else s))))

(define place-marks-of (subr kfx (ty) strings)
  (lambda (t)
    "The places a procedure is given, `%place 'p` each, from its
     parameters' types: where its body may write `(place p)` (C34)."
    (tagcase t
      (ty-proc (es ps r)
        (concat (map (lambda ((p ty))
                       (tagcase p
                         (ty-data (d args)
                           (if (string=? d "%place")
                               (tagcase (car args) (ty-var (n) (the strings (list (string-append "%place " n)))) (else other nil))
                               nil))
                         (else other nil)))
                     ps)))
      (else other nil))))

(define check-procedure (subr kfx (cv sexp scheme) cv)
  (lambda (v defined sc)
    "A procedure's lambda against its type; `v` already has its name."
    (let ((lam (items (if (head-is? defined "plambda") (third (items defined)) defined)))
          (v (with-binds v (list (bind "%toplambda" (scheme nil (ty-unit)) "yes")))))
      (tagcase sc
        (scheme (tvars t)
          ;; A plambda whose body is no lambda, a `proj` of one (Fixpt's
          ;; `sizes/finite-one-arg.fx`): that expression against the type, the
          ;; binders in scope (C158).
          (if (and (head-is? defined "plambda") (tagcase t (ty-data (d a) (string=? d "%poly")) (else other #f)))
              ;; Of a poly type an abbreviation names (rank 2, C107): the plambda
              ;; checked against it whole.
              (tagcase (with expressions (check v (new-state) defined t))
                (res (u es s) (with-facts v (with expressions (settle-facts s)))))
          (if (and (head-is? defined "plambda") (not (lambda-form? (third (items defined)))))
              (tagcase (with expressions (check (with-tvars v (onto (place-marks-of t) tvars)) (new-state) (third (items defined)) t))
                (res (u es s) (with-facts v (with expressions (settle-facts s)))))
              (tagcase (with expressions (check-lambda (with-tvars v (onto (place-marks-of t) tvars)) (new-state) (items (second lam)) (cdr (cdr lam)) t))
                (res (u es s) (with-facts v (with expressions (settle-facts s))))))))))))

(define variants-dt (subr kfx (cv string) dt)
  (lambda (v d)
    (let ((found (find-family d (cv-dts v))))
      (if (null? found) (refuse v (string-append "no datatype is named " d)) found))))

(define check-members (subr kfx (cv sexps strings strings) cv)
  (lambda (v bindings group names)
    "A define-rec's members, one by one, each one's facts kept: `group`,
     those whose calls are recursion (none if the group ends); `names`, all
     of them, whose reading is reaching itself, ending or not."
    (if (null? bindings)
        v
        (let ((ys (items (car bindings))))
          (if (lambda-form? (third ys))
              (check-members (check-procedure (no-reaching-itself (at v (name-of v (car ys)) group) names (parse-scheme v (second ys)))
                                              (third ys)
                                              (parse-scheme v (second ys)))
                             (cdr bindings) group names)
              (refuse v "a define-rec binds only lambdas"))))))

(define-rec
  (first-n (subr kfx (facts i64) facts)
    (lambda (fs n) (if (or (null? fs) (i64< n 1)) nil (cons (car fs) (first-n (cdr fs) (i64- n 1)))))))

(define-rec
  (chars-before (subr kfx (chars char chars) string)
    (lambda (cs c acc)
      (if (or (null? cs) (char=? (car cs) c)) (rev->string acc) (chars-before (cdr cs) c (cons (car cs) acc))))))

(define before-char (subr kfx (string char) string)
  (lambda (s c) (chars-before (string-chars s) c nil)))

(define place-need (subr kfx (string strings) string)
  (lambda (what places)
    "A fact of a making in, or a need of, one of `places`, as `'p kind T`;
     or ``. The facts are `rheld-kind@'p T` and `rneed-kind@'p T`."
    (let* ((held (cond ((has-prefix? what "rheld-") (after-prefix what "rheld-"))
                       ((has-prefix? what "rneed-") (after-prefix what "rneed-"))
                       (else "")))
           (kind (before-char held #\@))
           (rest (after-prefix held (string-append kind "@")))
           (place (before-char rest #\space)))
      (if (and (not (string=? held "")) (string-member? place places))
          (string-append place (string-append " " (string-append kind (string-append " " (after-prefix rest (string-append place " "))))))
          ""))))

(define with-place-needs (subr kfx (cv string scheme i64 string i64) cv)
  (lambda (v name sc before file pos)
    "A procedure given places (C34): what it makes in each, by itself or by
     the procedures it gives the place to, kept as `place-needs name 'p
     kind T` at its definition, for its calls and for the Rust it is: a
     place's type, a type parameter bound to hold each."
    (let* ((places (concat (map (lambda ((m string)) (the strings (list (after-prefix m "%place ")))) (place-marks-of (tagcase sc (scheme (tv t) t))))))
           (fs (cv-facts v))
           (new (first-n fs (i64- (size fs) before))))
      (if (null? places)
          v
          (with-facts v
            (concat (map (lambda ((f fact))
                           (tagcase f
                             (fact (ff fp what)
                               (let ((need (place-need what places)))
                                 (if (string=? need "")
                                     nil
                                     (the facts (list (fact file pos (string-append "place-needs " (string-append name (string-append " " need)))))))))))
                         new)))))))

(define-rec
  (split-words-check (subr kfx (string) strings)
    (lambda (s)
      "`s`'s words, split at spaces."
      (map (lambda ((x sexp)) (sym-name x)) (read-all (string-chars s) "" 1)))))

(define with-group-needs (subr kfx (cv sexps i64) cv)
  (lambda (v bindings before)
    "A define-rec's procedures given places (C34): its members call each
     other before any one's needs are summed, so each is given all the
     group makes in a place of its name, by any member: more bounds than
     some need, which Rust takes, since every caller then holds them."
    (let* ((fs (cv-facts v))
           (new (first-n fs (i64- (size fs) before)))
           (members (map (lambda ((b sexp))
                           (let ((ys (items b)))
                             (fact (datum-file b) (datum-pos b)
                                   (string-append (sym-name (car ys))
                                     (string-append " " (words-of (map (lambda ((m string)) (after-prefix m "%place "))
                                                                       (place-marks-of (tagcase (parse-scheme v (second ys)) (scheme (tv t) t))))))))))
                         bindings))
           (all-places (concat (map (lambda ((m fact)) (tagcase m (fact (f p w) (cdr (split-words-check w))))) members)))
           (needs (concat (map (lambda ((f fact)) (tagcase f (fact (ff fp what) (let ((n (place-need what all-places))) (if (string=? n "") nil (the strings (list n)))))))
                               new))))
      (if (null? all-places)
          v
          (with-facts v
            (concat (map (lambda ((m fact))
                           (tagcase m
                             (fact (f p w)
                               (let* ((ws (split-words-check w))
                                      (mine (cdr ws)))
                                 (concat (map (lambda ((n string))
                                                (if (string-member? (before-char n #\space) mine)
                                                    (the facts (list (fact f p (string-append "place-needs " (string-append (car ws) (string-append " " n))))))
                                                    nil))
                                              needs))))))
                         members)))))))

(define check-rec (subr kfx (cv sexps) cv)
  (lambda (v bindings)
    "A define-rec: every member in scope in each, and each a lambda."
    (let* ((names (map (lambda ((b sexp)) (name-of v (car (items b)))) bindings))
           (ends (with termination (terminates? v names (map (lambda ((b sexp)) (tagcase (parse-scheme v (second (items b))) (scheme (tvars t) t))) bindings)
                              (map (lambda ((b sexp)) (third (items b))) bindings))))
           (named (with-binds v (map (lambda ((b sexp))
                                       (let ((ys (items b)))
                                         (global v (name-of v (car ys)) (parse-scheme v (second ys)))))
                                     bindings))))
      (with-group-needs (check-members named bindings (if ends nil names) names) bindings (size (cv-facts named))))))

(define global-reads (subr kfx (strings) strings)
  (lambda (es)
    (if (null? es)
        nil
        (if (or (string=? (car es) "@globals") (global-atom? (car es)))
            (cons (car es) (global-reads (cdr es)))
            (global-reads (cdr es))))))

(define check-define* (subr kfx (cv sexps string i64) cv)
  (lambda (v xs src-file src-pos)
    "`(define* name type lambda)`: as FX-26 has it, the globals its body
     reads are found, not written. The body is checked as though the type
     read every global, and a call of itself read itself (C71: FX-26's
     effect, `(read (globals name))`, not every global's); the global is then of the type written, its effect
     with the globals found. A place it is given is as a `define`'s: what
     it makes there kept (C34)."
    (let* ((name (name-of v (second xs)))
           (defined (fourth xs))
           (v (at v name (if (ends-alone? v name (parse-scheme v (third xs)) defined) nil (list name))))
           (lam (items (if (head-is? defined "plambda") (third (items defined)) defined))))
      (if (not (lambda-form? defined))
          (refuse v "a define* is of a lambda")
          (tagcase (parse-scheme v (third xs))
            (scheme (tvars t)
              (tagcase t
                (ty-proc (declared ps r)
                  (let* ((wide (ty-proc (effs-union (list "@globals") declared) ps r))
                         (itself (ty-proc (effs-union (list (string-append "g:" name)) declared) ps r))
                         (named (with-binds v (list (global v name (scheme tvars itself)))))
                         (found (with expressions (lambda-effects (with-tvars (with-tvars named tvars) (place-marks (third xs))) (new-state) (items (second lam)) (cdr (cdr lam)) wide)))
                         (es (tagcase found (res (u es s) es)))
                         (fs (tagcase found (res (u es s) (with expressions (settle-facts s))))))
                    (if (effs-within? es (effs-union (list "@globals") declared))
                        (let* ((sc (scheme tvars (ty-proc (effs-union (global-reads es) declared) ps r)))
                               (w (with-binds (no-reaching-itself v (list name) sc) (list (global v name sc)))))
                          (with-facts (with-place-needs (with-facts w fs) name sc (size (cv-facts w)) src-file src-pos)
                            (concat (map (lambda ((m string))
                                           (if (has-prefix? m "%within ")
                                               (the facts (list (fact src-file src-pos (string-append "region-within " (string-append name (string-append " " (after-prefix m "%within ")))))))
                                               nil))
                                         (place-marks (third xs))))))
                        (refuse v (string-append "a define* whose effect " (string-append (show-effs es)
                                  (string-append " is not within " (show-effs declared))))))))
                (else other (refuse v "a define* is of a procedure")))))))))

"FX-26's `(->* (T ...) R)` (Fixpt 2a0e6fd..99bc9b1, the user's,
 2026-10-16), read as `(subr %found (T ...) R)` (`imports-in`): a
 definition's type whose effect its `lambda` says, found in one pass and
 written in, so that the definition is then checked, and emitted, as
 though its type had said it."
(define-rec
  (arrow-star? (subr kfx (sexp) bool)
    (lambda (t)
      "Whether a definition's type is `->*`'s, under any `poly`s."
      (tagcase t
        (lst (xs f l p)
          (cond ((null? xs) #f)
                ((and (sym-is? (car xs) "subr") (i64= (size xs) 4)) (sym-is? (second xs) "%found"))
                ((and (sym-is? (car xs) "poly") (i64= (size xs) 3)) (arrow-star? (third xs)))
                (else #f)))
        (else other #f))))
  (effect-put (subr kfx (sexp sexp) sexp)
    (lambda (t e)
      "`->*`'s type `t`, its effect `e`."
      (tagcase t
        (lst (xs f l p)
          (if (sym-is? (car xs) "poly")
              (lst (list (car xs) (second xs) (effect-put (third xs) e)) f l p)
              (lst (list (car xs) e (third xs) (fourth xs)) f l p)))
        (else other t)))))

(define bare-sym (subr kfx (string) sexp) (lambda (n) (sym n "" 0)))

(define atom-sexp (subr kfx (string) sexp)
  (lambda (a)
    "An effect's atom, as `parse-effect` reads it: written again."
    (cond ((or (string=? a "spin") (string=? a "nondet")) (bare-sym a))
          ((string=? a "@globals") (lst (list (bare-sym "read") (bare-sym "@globals")) "" 0 0))
          ((has-prefix? a "g:") (lst (list (bare-sym "read") (lst (list (bare-sym "globals") (bare-sym (after-prefix a "g:"))) "" 0 0)) "" 0 0))
          ((has-prefix? a "io:") (lst (list (bare-sym "io") (bare-sym (after-prefix a "io:"))) "" 0 0))
          ((has-prefix? a "~") (bare-sym (after-prefix a "~")))
          (else (let ((k (before-char a #\:))) (lst (list (bare-sym k) (bare-sym (after-prefix a (string-append k ":")))) "" 0 0))))))

(define effect-sexp (subr kfx (strings) sexp)
  (lambda (es) (lst (cons (sym "maxeff" "" 0) (map atom-sexp es)) "" 0 0)))

(define found-latent (subr kfx (cv string sexp sexp) strings)
  (lambda (v name type defined)
    "The effect of `->*` definition `name`'s lambda (Fixpt's
     `arrow_star_latent`): its body checked against the parameters and
     result its type says, but not an effect. Its calls of itself read
     itself, as a `define*`'s do (C71); what reads itself is `spin` too
     (`arrow_star_spins`)."
    (if (not (lambda-form? defined))
        (refuse v "`->*` finds a procedure's effect from its `lambda`: define it as one")
        (let ((lam (items (if (head-is? defined "plambda") (third (items defined)) defined))))
          (tagcase (parse-scheme v (effect-put type (sym "pure" "" 0)))
            (scheme (tvars t)
              (tagcase t
                (ty-proc (declared ps r)
                  (let* ((found (with expressions (lambda-effects (with-tvars (with-tvars v tvars) (place-marks type)) (new-state) (items (second lam)) (cdr (cdr lam)) t)))
                         (es (tagcase found (res (u es s) es))))
                    (if (string-member? (string-append "g:" name) es) (effs-union (list "spin") es) es)))
                (else other (refuse v "`->*` is a procedure's type")))))))))

(define found-define (subr kfx (cv sexps) sexps)
  (lambda (v xs)
    "A `define` of `->*`, its effect found (a component of one, which saw
     no placeholder but itself, read as reading itself)."
    (let* ((name (name-of v (second xs)))
           (itself (effect-put (third xs) (effect-sexp (list (string-append "g:" name)))))
           (sc (parse-scheme v itself))
           (named (with-binds (at v name (if (ends-alone? v name sc (fourth xs)) nil (list name))) (list (global v name sc)))))
      (list (car xs) (second xs) (effect-put (third xs) (effect-sexp (found-latent named name (third xs) (fourth xs)))) (fourth xs)))))

(define poly-type? (subr kfx (sexp) bool) (lambda (t) (head-is? t "poly")))

(define-rec
  (shared-effects (subr kfx (sexps (listof strings acyclic)) strings)
    (lambda (bs es)
      "The effects of a group's members but its `poly` ones'."
      (if (or (null? bs) (null? es))
          nil
          (effs-union (if (poly-type? (second (items (car bs)))) nil (car es)) (shared-effects (cdr bs) (cdr es)))))))

(define-rec
  (found-members (subr kfx (sexps (listof strings acyclic) strings strings) sexps)
    (lambda (bs es shared names)
      "Each `->*` member at its own effect and the shared ones, `spin` too
       if they read a member's global."
      (if (or (null? bs) (null? es))
          nil
          (cons (tagcase (car bs)
                  (lst (ys f l p)
                    (if (not (arrow-star? (second ys)))
                        (car bs)
                        (let* ((all (effs-union (car es) shared))
                               (all (if (any? (lambda ((n string)) (string-member? (string-append "g:" n) all)) names) (effs-union (list "spin") all) all)))
                          (lst (list (car ys) (effect-put (second ys) (effect-sexp all)) (third ys)) f l p))))
                  (else other (car bs)))
                (found-members (cdr bs) (cdr es) shared names))))))

(define found-rec (subr kfx (cv sexps) sexps)
  (lambda (v bindings)
    "A `define-rec` with `->*` members, each one's effect found (Fixpt's
     `arrow_star_group`): first in one pass, every `->*` member standing
     for nothing (`pure`), the rest at their types; then each with the
     effects of the others (but a `poly` one's, which say its own binders),
     and `spin` if that reads a member's global. Fixpt takes the group's
     components, callees first; KFX takes the group as one, so each member
     is given what any finds: no less than Fixpt's, never more accepted."
    (let* ((names (map (lambda ((b sexp)) (name-of v (car (items b)))) bindings))
           (placed (map (lambda ((b sexp))
                          (let ((ys (items b)))
                            (if (arrow-star? (second ys))
                                (lst (list (car ys) (effect-put (second ys) (sym "pure" "" 0)) (third ys)) "" 0 0)
                                b)))
                        bindings))
           (ends (with termination (terminates? v names (map (lambda ((b sexp)) (tagcase (parse-scheme v (second (items b))) (scheme (tvars t) t))) placed)
                              (map (lambda ((b sexp)) (third (items b))) bindings))))
           (named (with-binds v (map (lambda ((b sexp)) (let ((ys (items b))) (global v (name-of v (car ys)) (parse-scheme v (second ys))))) placed)))
           (own (map (lambda ((b sexp))
                       (let ((ys (items b)))
                         (if (arrow-star? (second ys))
                             (found-latent (at named (name-of v (car ys)) (if ends nil names)) (name-of v (car ys)) (second ys) (third ys))
                             (tagcase (parse-scheme v (second ys)) (scheme (tvars t) (tagcase t (ty-proc (es ps r) es) (else other nil)))))))
                     bindings))
           (shared (shared-effects bindings own)))
      (found-members bindings own shared names))))

(define star-items (subr kfx (sexps) strings)
  (lambda (forms)
    "The names of a module's items whose type is `->*`'s."
    (concat (map (lambda ((f sexp))
                   (cond ((and (head-is? f "define") (i64= (size (items f)) 4) (arrow-star? (third (items f))))
                          (the strings (list (sym-name (second (items f))))))
                         ((head-is? f "define-rec")
                          (concat (map (lambda ((b sexp)) (if (and (i64= (size (items b)) 3) (arrow-star? (second (items b)))) (the strings (list (sym-name (car (items b))))) nil))
                                       (cdr (items f)))))
                         (else nil)))
                 forms))))

(define check-top (subr kfx (cv sexp) cv)
  (lambda (v form)
    "One top-level form, which may add to what the forms after it see."
    (tagcase form
      (str (x at-file at-pos) v)
      (lst (xs src-file src-line src-pos)
        (let* ((v (near v src-file src-line src-pos))
               (h (if (null? xs) "" (tagcase (car xs) (sym (n at-file at-pos) n) (else other ""))))
               (xs (cond ((and (string=? h "define") (i64= (size xs) 4) (arrow-star? (third xs))) (found-define v xs))
                         ((and (string=? h "define-rec") (any? (lambda ((b sexp)) (and (i64= (size (items b)) 3) (arrow-star? (second (items b))))) (cdr xs)))
                          (the sexps (cons (car xs) (found-rec v (cdr xs)))))
                         (else xs))))
          (cond ((string=? h "define-effect") (with-effdef v xs))
                ((string=? h "define-convention") v)
                ((string=? h "define-type")
                 "Its body read where it stands, used or not: so that one that
                  mentions itself, or names no type, is refused."
                 (cond ((and (head-is? (third xs) "moduleof") (trait-moduleof? (third xs)) (tagcase (second xs) (sym (n f p) #t) (else other #f)))
                     (begin (with expressions (spec-well-formed v (third xs)))
                            (with expressions (module-type-values (with expressions (module-scope v (third xs) "" "")) (third xs)))
                            v))
                       ((and (head-is? (third xs) "select")
                             (let ((found (find-alias (string-append (name-of v (second (items (third xs)))) (string-append " " (name-of v (third (items (third xs)))))) (cv-aliases v))))
                               (and (not (null? found)) (tagcase (car found) (alias (n ps b) (not (null? ps)))))))
                        "An abbreviation of a module's family (C89): read where applied."
                        v)
                       (else
                     (let* ((name (head-name v (second xs)))
                            (params (family-params v (second xs)))
                            (body (mu-wrapped v name (parse-type v (cons "%fun-ok" (cons (string-append "%expanding " name)
                                                      (onto (map (lambda ((p string)) (string-append "%place " p))
                                                                 (concat (map (lambda ((p string)) (if (has-prefix? p "'") (the strings (list p)) nil)) params)))
                                                            params)))
                                              (third xs)))))
                       v))))
                ((string=? h "define-datatype")
                 (let ((d (variants-dt v (head-name v (second xs)))))
                   (defined-once v (constructors d))))
                ((string=? h "define-generative") (defined-once v (conversions v xs)))
                ((string=? h "define")
                 (if (not (i64= (size xs) 4))
                     (refuse v "a definition needs a type")
                     (let* ((name (name-of v (second xs)))
                            (sc (parse-scheme v (third xs)))
                            (v (at v name (if (ends-alone? v name sc (fourth xs)) nil (list name))))
                            (v (no-reaching-itself v (list name) sc))
                            (named (with-binds v (list (global v name sc)))))
                       (if (lambda-form? (fourth xs))
                           (with-facts (with-place-needs (check-procedure (with-tvars named (place-marks (third xs))) (fourth xs) sc) name sc (size (cv-facts named)) src-file src-pos)
                             (onto (concat (map (lambda ((m string))
                                                  (if (has-prefix? m "%within ")
                                                      (the facts (list (fact src-file src-pos (string-append "region-within " (string-append name (string-append " " (after-prefix m "%within ")))))))
                                                      nil))
                                                (place-marks (third xs))))
                                   ;; A procedure's type written as a name, an abbreviation's
                                   ;; perhaps an included module's (C116: Fixpt's encoder's
                                   ;; `arm-op3`): written out, for the emitter, at its lambda.
                                   (tagcase (third xs)
                                     (sym (n f p)
                                       (tagcase sc
                                         (scheme (tvars t)
                                           (the facts (list (fact (datum-file (fourth xs)) (datum-pos (fourth xs))
                                                                  (string-append "def-type " (show-ty (new-state) t))))))))
                                     (else other nil))))
                           (tagcase sc
                             (scheme (tvars t)
                               (if (null? tvars)
                                   (tagcase (with expressions (check v (new-state) (fourth xs) t))
                                     (res (u es s) (with-facts named (with expressions (settle-facts (constant-made v s (fourth xs) es t))))))
                                   (refuse v "a poly constant: only a procedure may be poly"))))))))
                ((string=? h "define-rec") (check-rec v (cdr xs)))
                ((string=? h "define*") (check-define* v xs src-file src-pos))
                (else (tagcase (with expressions (synth (at v "a top-level expression" nil) (new-state) form))
                        (res (t es s)
                          (with-facts v (with expressions (settle-facts (let ((s (if (suspends? es) (note-fact s src-file src-pos "suspends") s)))
                                                        (cond ((void? s t) (note-fact s src-file src-pos "void"))
                                                              ((proc-type? s t) (note-fact s src-file src-pos "procedure"))
                                                              (else s))))))))))))
      (else other (tagcase (with expressions (synth (at v "a top-level expression" nil) (new-state) form))
                    (res (t es s)
                      (with-facts v (with expressions (settle-facts (if (proc-type? s t) (note-fact s (datum-file form) (datum-pos form) "procedure") s))))))))))

(define item-names (subr kfx (sexp) strings)
  (lambda (f)
    "The names an item defines: values and types."
    (cond ((or (head-is? f "define") (head-is? f "define*") (head-is? f "define-type") (head-is? f "define-generative"))
           (tagcase (second (items f)) (sym (n at-file at-pos) (the strings (list n))) (else other nil)))
          ((head-is? f "define-rec") (map (lambda ((b sexp)) (sym-name (car (items b)))) (cdr (items f))))
          ((head-is? f "define-datatype")
           (tagcase (second (items f)) (sym (n at-file at-pos) (the strings (list n))) (else other nil)))
          (else nil))))

(define module-def? (subr kfx (sexp) bool)
  (lambda (form)
    (and (head-is? form "define") (i64= (size (items form)) 3)
         (or (head-is? (third (items form)) "module") (head-is? (third (items form)) "extend")))))

(define uncommented (subr kfx (sexps) sexps)
  (lambda (forms)
    "Module items without their strings, a `hide`'s too: FX-26's, a string
     among a module's items is a comment (Fixpt, 2026-10-12)."
    (concat (map (lambda ((f sexp))
                   (tagcase f
                     (str (s file pos) nil)
                     (lst (xs file line pos)
                       (if (head-is? f "hide")
                           (the sexps (list (lst (cons (car xs) (uncommented (cdr xs))) file line pos)))
                           (the sexps (list f))))
                     (else other (the sexps (list f)))))
                 forms))))

"`(extend e0 e1)` (C87, FX-91's): a module of both's values and types,
 `e1`'s where both give a name; `e1` sees `e0`'s, its own shadowing them.
 KFX's, of an `e0` defined at the top level: the module `(include e0
 (except ...))` then `e1`'s items, or `(include e1)` if `e1` is a name: the
 names `e1` gives are not taken from `e0`. So the Rust is a `mod` of `pub
 use`s, and its own items, which Rust's scope lets shadow a glob's."
(define module-noted (subr kfx (sexp) sexps)
  (lambda (form)
    "A module definition's items, as written, or as its `extend` is, its
     strings among them: what the emitter writes, each string a comment."
    (let ((x (third (items form))))
      (if (head-is? x "module")
          (cdr (items x))
          (tagcase x
            (lst (xs file line pos)
              (let ((e0 (second xs)) (e1 (third xs)))
                (cond ((not (i64= (size xs) 3)) (error "kfx: an extend of two modules"))
                      ((not (tagcase e0 (sym (n f p) #t) (else other #f)))
                       (error "kfx: an extend of a module made where it is extended, which KFX does not have yet: its first module is one defined at the top level"))
                      ((tagcase e1 (sym (n f p) #t) (else other #f))
                       (list (lst (list (sym "include" file pos) e0 (lst (list (sym "except-module" file pos) e1) file line pos)) file line pos)
                             (lst (list (sym "include" file pos) e1) file line pos)))
                      ((head-is? e1 "module")
                       (let ((own (cdr (items e1))))
                         (cons (lst (list (sym "include" file pos) e0
                                          (lst (cons (sym "except" file pos)
                                                     (map (lambda ((n string)) (sym n file pos))
                                                          (concat (map item-names (concat (map (lambda ((g sexp)) (if (head-is? g "hide") (cdr (items g)) (the sexps (list g)))) (uncommented own)))))))
                                               file line pos))
                                    file line pos)
                               own)))
                      (else (error "kfx: an extend's second module is a name or a module")))))
            (else other nil))))))

(define module-written (subr kfx (sexp) sexps)
  (lambda (form)
    "A module definition's items, as written, or as its `extend` is, without
     the strings among them."
    (uncommented (module-noted form))))

(define include-except (subr kfx (sexp) sexps)
  (lambda (f)
    "An `include`'s exception, `(except n ...)` or `(except-module m)`, as a
     list of one, or none."
    (if (i64> (size (items f)) 2) (the sexps (list (third (items f)))) nil)))

(define type-level-names (subr kfx (sexps) strings)
  (lambda (forms)
    "The names of the types and modules `forms` define, one Rust scope's."
    (concat
     (map (lambda ((f sexp))
            (cond ((or (head-is? f "define-type") (head-is? f "define-datatype") (head-is? f "define-generative"))
                   (tagcase (second (items f))
                     (sym (n at-file at-pos) (the strings (list n)))
                     (lst (ys fl ln ps) (tagcase (car ys) (sym (n at-file at-pos) (the strings (list n))) (else other nil)))
                     (else other nil)))
                  ((module-def? f) (the strings (list (sym-name (second (items f))))))
                  (else nil)))
          forms))))

(define type-scopes (subr kfx (sexps) (listof strings acyclic))
  (lambda (forms)
    "Each Rust scope's type and module names: the program's, then each module's."
    (cons (type-level-names forms)
          (concat (map (lambda ((f sexp))
                         (if (module-def? f)
                             (the (listof strings acyclic)
                               (list (type-level-names (concat (map (lambda ((g sexp)) (if (head-is? g "hide") (cdr (items g)) (the sexps (list g))))
                                                                    (module-written f))))))
                             nil))
                       forms)))))

(define-rec
  (type-namer (subr kfx (sexps string) sexps)
    (lambda (forms name)
      "The form among `forms`, or in their modules, that defines the type or
       module `name`: a list of it, or none."
      (cond ((null? forms) nil)
            ((string-member? name (type-level-names (list (car forms)))) (list (car forms)))
            ((module-def? (car forms))
             (let ((inner (type-namer (concat (map (lambda ((g sexp)) (if (head-is? g "hide") (cdr (items g)) (the sexps (list g))))
                                                   (module-written (car forms))))
                                      name)))
               (if (null? inner) (type-namer (cdr forms) name) inner)))
            (else (type-namer (cdr forms) name))))))

(define type-namer-near (subr kfx (cv sexps string) cv)
  (lambda (v forms name)
    "`v` at the form that defines the type or module `name`, if one does."
    (let ((fs (type-namer forms name)))
      (if (null? fs) v (tagcase (car fs) (lst (xs file line pos) (near v file line pos)) (else other v))))))

(define-rec
  (label-lists (subr kfx (sexps) (listof strings acyclic))
    (lambda (es)
      "The labels of every product and sum written in `es`, types and
       `product` forms alike, each a shape the Rust names by its labels."
      (concat (map (lambda ((e sexp))
                     (tagcase e
                       (lst (xs f l p)
                         (let ((here (if (and (not (null? xs))
                                              (or (sym-is? (car xs) "productof") (sym-is? (car xs) "sumof") (sym-is? (car xs) "product"))
                                              (not (null? (cdr xs)))
                                              (not (any? (lambda ((x sexp)) (tagcase x (lst (ys f2 l2 p2) (null? ys)) (else other #t))) (cdr xs))))
                                         (the (listof strings acyclic)
                                           (list (map (lambda ((x sexp)) (tagcase (car (items x)) (sym (n f3 p3) n) (else other ""))) (cdr xs))))
                                         nil)))
                           (onto here (label-lists xs))))
                       (else other nil)))
                   es)))))

(define shapes-apart (subr kfx (cv sexps) unit)
  (lambda (v forms)
    "No two shapes of different labels named alike in Rust, their labels
     mangled (`a?` and `a-p` are both `a_p`)."
    (let ((lists (label-lists forms)))
      (if (any? (lambda ((ls strings))
                  (any? (lambda ((ms strings))
                          (and (not (string=? (words-of ls) (words-of ms)))
                               (string=? (words-of (map mangle ls)) (words-of (map mangle ms)))))
                        lists))
                lists)
          (refuse v "two products or sums whose labels are one in Rust, mangled (`a?` and `a-p` are both `a_p`)")
          #u))))

(define type-names-free (subr kfx (cv sexps) unit)
  (lambda (v forms)
    "Types' names as FX-26 has them; as Rust has them (none named as a type
     the generated Rust names, kayak-rt's `Str` and the few of Rust's it
     writes; KFX's names, C27; none two in Rust) is the restriction
     pass's (restrict.kfx, C61)."
    (begin
      (shapes-apart v forms)
      (map (lambda ((f sexp))
             (if (and (or (head-is? f "define-type") (head-is? f "define-datatype") (head-is? f "define-generative"))
                      (string-member? (tagcase (second (items f)) (sym (n at-file at-pos) n) (lst (ys fl ln ps) (tagcase (car ys) (sym (n at-file at-pos) n) (else other ""))) (else other ""))
                                      (concat (map (lambda ((g sexp)) (if (head-is? g "define-effect")
                                                                          (tagcase (second (items g)) (sym (n at-file at-pos) (the strings (list n))) (else other nil))
                                                                          nil))
                                                   forms))))
                 (tagcase f
                   (lst (xs file line pos) (refuse (near v file line pos) "a type named as an effect: FX-26's are one namespace, the effect hiding the type"))
                   (else other #u))
                 #u))
           forms)
      (map (lambda ((f sexp))
             (if (and (or (head-is? f "define-type") (head-is? f "define-datatype"))
                      (tagcase (second (items f)) (lst (ys fl ln ps) #t) (else other #f)))
                 (tagcase f
                   (lst (xs file line pos)
                     (let ((v (near v file line pos)))
                       (type-binders-apart v (family-params v (second xs)) (concat (type-scopes forms)))))
                   (else other #u))
                 #u))
           forms)
      #u)))

"Elaboration. A definition with no type, `(define x e)`, has the type the
 checker finds for `e`; the emitter, which knows no types, is told it, as
 though it had been written. It is never `poly`, and must be known whole."

(define-datatype typed (typed string sexp))
(define-type typeds (listof typed acyclic))
(define-datatype elab (elab cv typeds))

(define reexported (subr kfx (cv sexp) (listof scheme acyclic))
  (lambda (v e)
    "`(with m y)`, `m` a module defined at the top level and `y` its poly
     item: `y`'s scheme; else none (C107)."
    (if (and (head-is? e "with") (i64= (size (items e)) 3)
             (tagcase (second (items e)) (sym (n f p) #t) (else other #f))
             (tagcase (third (items e)) (sym (n f p) #t) (else other #f)))
        (let ((m (find-bind (sym-name (second (items e))) (cv-binds v))))
          (if (or (null? m) (not (tagcase (car m) (bind (n sc w) (string=? w "module")))))
              nil
              (let ((y (find-bind (sym-name (third (items e))) (opened-binds (sym-name (second (items e))) (cv-binds v)))))
                (if (null? y)
                    nil
                    (tagcase (car y)
                      (bind (n sc w) (tagcase sc (scheme (tvars t) (if (null? tvars) nil (list sc))))))))))
        nil)))

(define check-untyped (subr kfx (cv sexp) elab)
  (lambda (v form)
    "`(define x e)`: `e`'s type found, `x` not in scope in `e` (as FX-26
     has it, for a lambda too), and the type kept for the emitter."
    (let* ((xs (items form))
           (name (name-of v (second xs)))
           (v (at v name nil))
           (e (third xs))
           (again (reexported v e)))
      (if (not (null? again))
          ;; A module's poly procedure given on, `(define x (with m y))` (C107):
          ;; at `y`'s scheme, and in Rust `y` itself, `pub use`d.
          (elab (with-binds v (list (global v name (car again))))
                (list (typed name (lst (list (sym "%reexport" "" 0) (second (items e)) (third (items e))) "" 0 0))))
      (tagcase (with expressions (synth v (new-state) e))
        (res (t es s)
          (let ((written (if (with expressions (has-var? s t))
                             (refuse v "a definition with no type, of a type over a binder: write its type")
                             (with expressions (ty-sexp v s t))))
                (s (if (lambda-form? e) s (constant-made v s e es t))))
            (elab (with-facts (with-binds v (list (global v name (scheme nil (zonk s t))))) (with expressions (settle-facts s)))
                  (list (typed name written))))))))))

"Modules (CLAUDES_CHOICES.md C19): `(define m (module item ...))` at the
 top level, a Rust `mod`. Its items are a program's definitions, each
 seeing those before it; its types are named `m..t` for the program, so
 that a module's and the program's never meet, and a generative type's
 conversions stay inside. Outside, `m`'s values and types are named `m x`,
 found by `with` and `select`."

(define tag-taken? (subr kfx (string dts) bool)
  (lambda (tag ds)
    (any? (lambda ((d dt))
            (tagcase d (dt (n ps vs) (any? (lambda ((x variant)) (tagcase x (variant (t fs) (string=? t tag)))) vs))))
          ds)))

(define-rec
  (module-types (subr kfx (cv sexps) strings)
    (lambda (v forms)
      "A module's types' names, each refused if the program has a type of
       that name; and the items KFX's modules do not have, refused."
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (cond ((and (head-is? f "define-datatype")
                        (any? (lambda ((vt sexp)) (tag-taken? (sym-name (car (items vt))) (cv-dts v))) (cdr (cdr (items f)))))
                   (refuse v "a module's datatype whose tag another datatype has: KFX's tags name one datatype each"))
                  ((or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype"))
                   (let ((name (head-name v (second (items f)))))
                     (if (dt-named? name (cv-dts v))
                         (refuse v (string-append "a module's type named as the program's: KFX names them apart, " name))
                         (cons name (module-types v (cdr forms))))))
                  ((and (head-is? f "define-effect") (i64= (size (items f)) 3) (not (selects? f)))
                   "Each read with the module's effects before it (C116), one that may
                    abort too, as Fixpt's checker's `checks` does."
                   (module-types (with-effdef v (items f)) (cdr forms)))
                  ((and (head-is? f "define-effect") (i64= (size (items f)) 3)
                        (escapes? (parse-effect v nil (third (items f)))))
                   (refuse v "a module's effect that may abort, which KFX's modules do not have yet"))
                  ((head-is? f "hide")
                   (refuse v (string-append "an item KFX's modules do not have yet: " (show-sexp (car (items f))))))
                  (else (module-types v (cdr forms)))))))))

(define-rec
  (qualify-type (subr kfx (string strings sexp) sexp)
    (lambda (m names t)
      "A type written in module `m`, its types named as the program names them;
       `(select n u)` is `n`'s type `u`, no name of this module's (C88)."
      (tagcase t
        (sym (n at-file at-pos) (if (string-member? n names) (sym (string-append m (string-append ".." n)) at-file at-pos) t))
        (lst (xs file line pos)
          (if (head-is? t "select")
              t
              (lst (map (lambda ((x sexp)) (qualify-type m names x)) xs) file line pos)))
        (else other t)))))

(define module-aliases (subr kfx (cv string strings sexps bool) aliases)
  (lambda (v m names forms inside)
    "A module's types: each `m..t`; and `t` inside it, `m t` outside. A
     family, `(t (p kind) ...)` (C89), the same, applied: `t` stands for
     `(m..t p ...)`."
    (concat
     (map (lambda ((f sexp))
            (cond ((not (or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype"))) nil)
                  (else
                   (let* ((xs (items f))
                          (t (head-name v (second xs)))
                          (ps (family-params v (second xs)))
                          (q (string-append m (string-append ".." t)))
                          (name (if inside t (string-append m (string-append " " t))))
                          (named (alias name ps (if (null? ps)
                                                    (sym q "" 0)
                                                    (lst (cons (sym q "" 0)
                                                               (map (lambda ((p string)) (sym (if (has-prefix? p "'") (after-prefix p "'") p) "" 0)) ps))
                                                         "" 0 0)))))
                     (if (head-is? f "define-type")
                         (the aliases (list named (alias q ps (qualify-type m names (third xs)))))
                         (the aliases (list named)))))))
          forms))))

(define module-dts (subr kfx (cv string sexps) dts)
  (lambda (v m forms)
    (concat
     (map (lambda ((f sexp))
            (if (or (head-is? f "define-generative") (head-is? f "define-datatype"))
                (the dts (list (dt (string-append m (string-append ".." (head-name v (second (items f))))) (family-params v (second (items f))) nil)))
                nil))
          forms))))

(define module-conversions (subr kfx (cv string sexps) binds)
  (lambda (v m forms)
    "A module's generative types' conversions, `up-t` and `down-t`: its
     items', not in its type, so that outside `m..t` is abstract."
    (concat
     (map (lambda ((f sexp))
            (if (head-is? f "define-generative")
                (let* ((xs (items f))
                       (t (sym-name (second xs)))
                       (made (ty-data (string-append m (string-append ".." t)) nil))
                       (repr (parse-type v nil (third xs))))
                  (the binds (list (bind (string-append "up-" t) (scheme nil (ty-proc nil (list repr) made)) "item")
                                   (bind (string-append "down-" t) (scheme nil (ty-proc nil (list made) repr)) "item"))))
                nil))
          forms))))

(define module-datatypes (subr kfx (cv string sexps) dts)
  (lambda (v m forms)
    "A module's datatypes, their variants read where its types are named."
    (concat
     (map (lambda ((f sexp))
            (if (head-is? f "define-datatype")
                (tagcase (datatype-of v (cdr (items f)))
                  (dt (n ps vs) (the dts (list (dt (string-append m (string-append ".." n)) ps vs)))))
                nil))
          forms))))

(define module-effects (subr kfx (string sexps effdefs) effdefs)
  (lambda (m forms es)
    "A module's effect abbreviations, as `m e`: what each is, as the module
     read it."
    (concat (map (lambda ((f sexp))
                   (if (head-is? f "define-effect")
                       (let ((name (sym-name (second (items f)))))
                         (concat (map (lambda ((d effdef))
                                        (tagcase d (effdef (n atoms) (if (string=? n name) (the effdefs (list (effdef (string-append m (string-append " " n)) atoms))) nil))))
                                      es)))
                       nil))
                 forms))))

(define-rec
  (own-items (subr kfx (binds) binds)
    (lambda (bs)
      "A module's own items, those bound after its mark."
      (if (or (null? bs) (tagcase (car bs) (bind (n sc w) (string=? n "%module")))) nil (cons (car bs) (own-items (cdr bs)))))))

(define items-kept-in (subr kfx (cv binds) binds)
  (lambda (v bs)
    "A module's items, none of a type that mentions an abstract type of a
     module an item names, `m..t`, which is not known outside it (C170;
     Fixpt's `modules/inner-escape.fx`)."
    (let ((mods (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (if (tagcase sc (scheme (tv t) (mtype? t))) (the strings (list n)) nil)))) (own-items bs)))))
      (begin
        (map (lambda ((b bind))
               (tagcase b
                 (bind (n sc w)
                   (let ((m (if (null? mods) "" (tagcase sc (scheme (tv t) (mentions-module-of? t (filter (lambda ((x string)) (not (string=? x n))) mods)))))))
                     (if (string=? m "")
                         #u
                         (refuse v (string-append "`" (string-append n (string-append "`'s type mentions `" (string-append m "`, which is not known outside the module"))))))))))
             (own-items bs))
        bs))))

(define-rec
  (module-exports (subr kfx (string strings binds) binds)
    (lambda (m conversions bs)
      "The items' values, before the module's mark, as `m x`."
      (if (null? bs)
          nil
          (tagcase (car bs)
            (bind (n sc wher)
              (cond ((string=? n "%module") nil)
                    ((string-member? n conversions) (module-exports m conversions (cdr bs)))
                    (else (cons (bind (string-append m (string-append " " n)) sc "export")
                                (module-exports m conversions (cdr bs)))))))))))

(define untyped? (subr kfx (sexp) bool)
  (lambda (form) (and (head-is? form "define") (i64= (size (items form)) 3))))

"A module's `(include n)` and `(hide item ...)` (FX-26's): an included
 module's values and types are the module's own, in scope in all its
 items, and in its type unless hidden; a hidden item is the module's, not
 in its type. The module included is one defined at the top level."

(define unhidden (subr kfx (sexps) sexps)
  (lambda (forms)
    "The items, those of a `hide` among them."
    (concat (map (lambda ((f sexp)) (if (head-is? f "hide") (cdr (items f)) (the sexps (list f)))) forms))))

(define-rec
  (item-names-in (subr kfx (sexp strings) strings)
    (lambda (e names)
      "The names among `names` that `e` mentions (a local of the same name
       taken for the item: more references, never fewer)."
      (tagcase e
        (sym (n f p) (if (string-member? n names) (the strings (list n)) nil))
        (lst (xs f l p) (concat (map (lambda ((x sexp)) (item-names-in x names)) xs)))
        (else other nil)))))

(define item-value-names (subr kfx (sexp) strings)
  (lambda (f)
    "The values an item defines."
    (if (or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype")) nil (item-names f))))

(define item-type-names (subr kfx (sexp) strings)
  (lambda (f)
    "The types an item defines."
    (if (or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype")) (item-names f) nil)))

(define-rec
  (resolved-alias (subr kfx (sexp aliases) sexp)
    (lambda (body als)
      "A type as written, a name of an abbreviation with no parameters
       followed to what it stands for."
      (tagcase body
        (sym (n f p)
          (let ((found (find-alias n als)))
            (if (null? found)
                body
                (tagcase (car found) (alias (m ps b) (if (null? ps) (resolved-alias b als) body))))))
        (else other body)))))

"A module's names: values and types named apart, as at the top level; a
 type two modules included both give is one where it is the same type
 both times (C86, FX-26's)."
(define-rec
  (distinct-aliases (subr kfx (aliases) aliases)
    (lambda (als)
      "Aliases, one of each name that stands for the same type each time
       (written alike, naming none of the types the modules give, which
       could be two types written alike); else kept twice, and refused."
      (cond ((null? als) nil)
            ((any? (lambda ((b alias)) (tagcase (car als) (alias (n ps body) (tagcase b (alias (m qs body2) (and (string=? n m) (string=? (show-sexp body) (show-sexp body2))
                                                                                     (null? (item-names-in body (map (lambda ((a alias)) (tagcase a (alias (k ks kb) k))) als)))))))))
                   (cdr als))
             (distinct-aliases (cdr als)))
            (else (cons (car als) (distinct-aliases (cdr als))))))))

(define hidden-items (subr kfx (sexps) sexps)
  (lambda (forms) (concat (map (lambda ((f sexp)) (if (head-is? f "hide") (cdr (items f)) nil)) forms))))

(define hidden-value-names (subr kfx (sexps) strings)
  (lambda (forms)
    "The values hidden items define: a hidden datatype's constructors too.
     A hidden type does not hide a value of its name, nor a value a type's
     (C86, FX-26's)."
    (concat (map (lambda ((g sexp))
                   (if (head-is? g "define-datatype")
                       (map (lambda ((x sexp)) (tagcase x (lst (ys f l p) (sym-name (car ys))) (sym (n f p) n) (else other "")))
                            (cdr (cdr (items g))))
                       (item-value-names g)))
                 (hidden-items forms)))))

(define hidden-type-names (subr kfx (sexps) strings)
  (lambda (forms) (concat (map item-type-names (hidden-items forms)))))

(define made-in-place? (subr kfx (string) bool)
  (lambda (n)
    "Whether module `n` is one made in place, defined before its user as
     `made--P` (C90), not a `load-input`'s module bound by name (C116)."
    (and (has-prefix? n "made--") (not (has-prefix? n "made--input--")))))

(define hidden-escapes (subr kfx (cv sexps) unit)
  (lambda (v forms)
    "A hidden datatype or generative type in a type the module shows is
     refused, as FX-26 refuses it, for now (`modules/hide-escape.fx`)."
    (let ((abstract (concat (map (lambda ((g sexp))
                                   (cond ((or (head-is? g "define-datatype") (head-is? g "define-generative")) (item-names g))
                                         ((and (head-is? g "include") (made-in-place? (sym-name (second (items g)))))
                                          "A hidden include's abstract types are hidden too (C90), of a
                                           module made in place, which are the includer's own; a named
                                           module's stay its own, as FX-26 has it (C116: Fixpt's
                                           `convention.fx`, its `let`'s module included)."
                                          (let ((n (sym-name (second (items g)))))
                                            (concat (map (lambda ((d dt)) (tagcase d (dt (dn ps vs)
                                                                            (if (has-prefix? dn (string-append n "..")) (the strings (list (after-prefix dn (string-append n "..")))) nil))))
                                                         (cv-dts v)))))
                                         (else nil)))
                                 (hidden-items forms)))))
      (if (null? abstract)
          #u
          (begin
            (map (lambda ((f sexp))
                   (let ((ts (cond ((and (head-is? f "define") (i64= (size (items f)) 4)) (the sexps (list (third (items f)))))
                                   ((head-is? f "define*") (the sexps (list (third (items f)))))
                                   ((head-is? f "define-rec") (map (lambda ((b sexp)) (second (items b))) (cdr (items f))))
                                   ((head-is? f "define-type") (the sexps (list (third (items f)))))
                                   (else nil))))
                     (if (any? (lambda ((t sexp)) (not (null? (item-names-in t abstract)))) ts)
                         (refuse v (string-append "a hidden type in a type the module shows: " (words-of abstract)))
                         #u)))
                 (concat (map (lambda ((f sexp)) (if (head-is? f "hide") nil (the sexps (list f)))) forms)))
            #u)))))

(define included (subr kfx (cv sexps) strings)
  (lambda (v forms)
    "The modules `forms` include, each defined at the top level."
    (concat (map (lambda ((f sexp))
                   (if (head-is? f "include")
                       (let ((n (name-of v (second (items f)))))
                         (if (or (null? (find-bind n (cv-binds v)))
                                 (not (tagcase (car (find-bind n (cv-binds v))) (bind (x sc w) (string=? w "module")))))
                             (refuse v (string-append "KFX includes a module defined at the top level, by its name: " n))
                             (the strings (list n))))
                       nil))
                 forms))))

(define except-names (subr kfx (cv sexps string) strings)
  (lambda (v written n)
    "The names an `include` of `n` among `written` does not take (C87): an
     `extend`'s second module's."
    (let ((incs (concat (map (lambda ((f sexp))
                               (if (and (head-is? f "include") (string=? (sym-name (second (items f))) n)) (include-except f) nil))
                             (onto written (concat (map (lambda ((f sexp)) (if (head-is? f "hide") (cdr (items f)) nil)) written)))))))
      (if (null? incs)
          nil
          (let ((x (car incs)))
            (if (head-is? x "except-module")
                (let ((b (sym-name (second (items x)))))
                  (onto (map (lambda ((d bind)) (tagcase d (bind (k sc w) k))) (opened-binds b (cv-binds v)))
                        (map (lambda ((a alias)) (tagcase a (alias (k ps body) k))) (with expressions (opened-aliases b (cv-aliases v))))))
                (map sym-name (cdr (items x)))))))))

(define excepted-binds (subr kfx (cv sexps string binds) binds)
  (lambda (v written n bs)
    (let ((ex (except-names v written n)))
      (concat (map (lambda ((d bind)) (tagcase d (bind (k sc w) (if (string-member? k ex) nil (the binds (list d)))))) (opened-binds n bs))))))

"Each module a module includes, with the values it gives it, found once."
(define-datatype typed-binds (typed-binds string binds))

(define-rec
  (binds-of-include (subr kfx (string (listof typed-binds acyclic)) binds)
    (lambda (n ibs)
      (cond ((null? ibs) nil)
            ((tagcase (car ibs) (typed-binds (k bs) (string=? k n))) (tagcase (car ibs) (typed-binds (k bs) bs)))
            (else (binds-of-include n (cdr ibs)))))))

(define excepted-aliases (subr kfx (cv sexps string aliases) aliases)
  (lambda (v written n als)
    (let ((ex (except-names v written n)))
      (concat (map (lambda ((a alias)) (tagcase a (alias (k ps body) (if (string-member? k ex) nil (the aliases (list a)))))) (with expressions (opened-aliases n als)))))))

(define opened-effdefs (subr kfx (string effdefs) effdefs)
  (lambda (m es)
    "Module `m`'s effects, named as `m` names them: an `include` gives them
     the module, as a `with` gives them its body (C87, FX-26's)."
    (concat (map (lambda ((d effdef))
                   (tagcase d (effdef (n atoms)
                                (if (has-prefix? n (string-append m " "))
                                    (the effdefs (list (effdef (after-prefix n (string-append m " ")) atoms)))
                                    nil))))
                 es))))

(define unhidden-includes (subr kfx (cv sexps) strings)
  (lambda (v written)
    "The modules included not in a `hide`: their types are the module's."
    (included v (concat (map (lambda ((f sexp)) (if (head-is? f "hide") nil (the sexps (list f)))) written)))))

(define renamed-aliases (subr kfx (string string aliases) aliases)
  (lambda (n m als)
    "Module `n`'s types, opened, as module `m`'s: `m t`."
    (map (lambda ((a alias)) (tagcase a (alias (t ps body) (alias (string-append m (string-append " " t)) ps body)))) als)))

(define without-aliases (subr kfx (strings string aliases) aliases)
  (lambda (hidden m als)
    "A module's exported types, those hidden dropped."
    (concat (map (lambda ((a alias))
                   (tagcase a (alias (t ps body)
                                (if (string-member? (after-prefix t (string-append m " ")) hidden) nil (the aliases (list a))))))
                 als))))

"A module's items as FX-26's `letrec*` (C85, docs/research/modules.md
 stage 1): a typed lambda may name any item, earlier or later; any other
 value is made when its item is, so what it names, and what the lambdas it
 names name, must be made before it. KFX checks the items in an order
 their references allow, each set of procedures that reach one another a
 `define-rec` (so `spin` and termination are as a group's); Rust's items
 are in no order, and the emitter writes them as they were."
(define-rec
  (marked-in? (subr kfx ((listof char acyclic)) bool)
    (lambda (cs)
      (and (not (null? cs)) (not (null? (cdr cs)))
           (or (and (char=? (car cs) #\space) (char=? (car (cdr cs)) #\%)) (marked-in? (cdr cs)))))))

(define marker-name? (subr kfx (string) bool)
  (lambda (n)
    "A binding's name that is a marker, `%x`, or a module's marker, `m %x`
     (C119), which no program names."
    (or (has-prefix? n "%") (marked-in? (string-chars n)))))

(define-datatype mitem (mitem sexp strings strings bool))
(define-type mitems (listof mitem acyclic))

(define item-value (subr kfx (sexp) sexps)
  (lambda (f)
    "A value item's value, under a `%found`, or none."
    (let ((xs (items f)))
      (cond ((and (head-is? f "define") (i64= (size xs) 4))
             (the sexps (list (if (head-is? (fourth xs) "%found") (second (items (fourth xs))) (fourth xs)))))
            ((module-def? f)
             "A module item is made where it is written (C88): what uses it
              must come after it, as FX-26's `reexport-too-soon` has it."
             (module-written f))
            ((and (head-is? f "define") (i64= (size xs) 3)) (the sexps (list (third xs))))
            ((head-is? f "define*") (the sexps (list (fourth xs))))
            ((head-is? f "define-rec") (map (lambda ((b sexp)) (third (items b))) (cdr xs)))
            (else nil)))))

(define-rec
  (nset-names (subr kfx (nset) strings)
    (lambda (s) (tagcase s (nempty () nil) (nnode (l k r) (onto (nset-names l) (cons k (nset-names r))))))))

(define nset-without (subr kfx (nset strings) nset)
  (lambda (s out) (nset-of (concat (map (lambda ((n string)) (if (string-member? n out) nil (the strings (list n)))) (nset-names s))))))

(define-rec
  (refs-in (subr kfx (sexp nset sexps binds) strings)
    (lambda (e names forms bs)
      "The items among `names` that `e` names; in a `(with m ...)` of a
       module item, not the names `m` gives, which are `m`'s (C88, FX-26's
       `(define x (with m x))`); of a module outside, bound in `bs`, the
       same (C119: `import` writes it so). `names` a tree (C92): this walks
       every item's body, every compile."
      (tagcase e
        (sym (n f p) (if (in-nset? n names) (the strings (list n)) nil))
        (lst (xs f l p)
          (if (and (head-is? e "with") (not (null? (cdr xs))) (tagcase (second xs) (sym (n f2 p2) #t) (else other #f)))
              (let* ((m (sym-name (second xs)))
                     (own (concat (map (lambda ((g sexp))
                                         (if (and (module-def? g) (string=? (sym-name (second (items g))) m))
                                             (onto (concat (map item-names (module-written g)))
                                                   ;; An included module's names too, given by its items, `x y`
                                                   ;; (C171: a loaded file's, `modules/load-reexport.fx`).
                                                   (concat (map (lambda ((h sexp))
                                                                  (if (and (head-is? h "include") (tagcase (second (items h)) (sym (n f2 p2) #t) (else other #f)))
                                                                      (filter (lambda ((n string)) (not (null? (find-bind (string-append (sym-name (second (items h))) (string-append " " n)) bs))))
                                                                              (nset-names names))
                                                                      nil))
                                                                (module-written g))))
                                             nil))
                                       forms)))
                     (given (if (or (not (null? own)) (any? (lambda ((g sexp)) (and (module-def? g) (string=? (sym-name (second (items g))) m))) forms))
                                own
                                (filter (lambda ((n string)) (not (null? (find-bind (string-append m (string-append " " n)) bs))))
                                        (nset-names names))))
                     (inner (if (null? given) names (nset-without names given))))
                (onto (if (in-nset? m names) (the strings (list m)) nil)
                      (concat (map (lambda ((x sexp)) (refs-in x inner forms bs)) (cdr (cdr xs))))))
              (concat (map (lambda ((x sexp)) (refs-in x names forms bs)) xs))))
        (else other nil)))))

(define standard-scope (subr kfx (cv strings) cv)
  (lambda (v sees)
    "What a file loaded sees (C88, FX-26's M7): the standard environment
     alone, not the program's globals, types or effects, so that a file
     means the same wherever it is read; the facts so far kept. And the
     modules `sees`, which a `load-input`'s `let` bound, lifted (C116):
     their binds, types and effects; and the shared loads' modules, whose
     names no program writes."
    (tagcase v
      (cv (bs ds als es here group file line fs tv at)
        (let* ((of (lambda ((n string))
                     (or (has-prefix? n "made--load--")
                         (any? (lambda ((m string)) (or (string=? n m) (has-prefix? n (string-append m " ")) (has-prefix? n (string-append m "..")))) sees))))
               (bare (cv (filter (lambda ((b bind)) (tagcase b (bind (n sc w) (of n)))) bs)
                         (filter (lambda ((d dt)) (tagcase d (dt (n ps vs) (of n)))) ds)
                         (filter (lambda ((a alias)) (tagcase a (alias (n ps b) (of n)))) als)
                         (filter (lambda ((e effdef)) (tagcase e (effdef (n xs) (of n)))) es)
                         here group file line fs tv at)))
          (with-binds bare (cons (bind "%loaded" (scheme nil (ty-unit)) "mark")
                                 (onto (if (string-member? "%instance" sees) (the binds (list (bind "%instance" (scheme nil (ty-unit)) "mark"))) nil)
                                       (prim-binds bare)))))))))

(define letrec-items (subr kfx (sexps binds) mitems)
  (lambda (forms bs)
    "The value items: each its form, its names, the items it names, and
     whether it is procedures (made, not run, when its item is)."
    (let* ((values (concat (map (lambda ((f sexp)) (if (null? (item-value f)) nil (the sexps (list f)))) forms)))
           (names (concat (map item-names values))))
      (map (lambda ((f sexp))
             (mitem f (item-names f)
                    (let ((own (if (module-def? f) (concat (map item-names (unhidden (module-written f)))) nil)))
                      (let ((set (nset-of (concat (map (lambda ((n string)) (if (string-member? n own) nil (the strings (list n)))) names)))))
                        (concat (map (lambda ((e sexp)) (refs-in e set forms bs)) (item-value f)))))
                    (and (or (head-is? f "define-rec") (head-is? f "define*") (i64= (size (items f)) 4))
                         (not (any? (lambda ((e sexp)) (not (lambda-form? e))) (item-value f))))))
           values))))

(define-datatype reached (reached string strings))

(define-rec
  (reached-of (subr kfx (string (listof reached acyclic)) strings)
    (lambda (n rs)
      (cond ((null? rs) nil)
            ((tagcase (car rs) (reached (k ks) (string=? k n))) (tagcase (car rs) (reached (k ks) ks)))
            (else (reached-of n (cdr rs)))))))

"Items by name, a tree (C92)."
(define-datatype itree (ileaf) (inode itree string mitem itree))
(define-datatype named-item (named-item string mitem))

(define-rec
  (itree-built (subr kfx ((listof named-item acyclic) i64) itree)
    (lambda (xs n)
      (if (i64<= n 0)
          (ileaf)
          (let* ((half (i64-quotient n 2))
                 (rest (named-dropped xs half)))
            (tagcase (car rest)
              (named-item (k it) (inode (itree-built xs half) k it (itree-built (cdr rest) (i64- (i64- n half) 1)))))))))
  (named-dropped (subr kfx ((listof named-item acyclic) i64) (listof named-item acyclic))
    (lambda (xs n) (if (or (null? xs) (i64<= n 0)) xs (named-dropped (cdr xs) (i64- n 1)))))
  (named-sorted (subr kfx ((listof named-item acyclic)) (listof named-item acyclic))
    (lambda (xs)
      (if (or (null? xs) (null? (cdr xs)))
          xs
          (named-merged (named-sorted (named-halves xs #t)) (named-sorted (named-halves xs #f))))))
  (named-halves (subr kfx ((listof named-item acyclic) bool) (listof named-item acyclic))
    (lambda (xs first) (cond ((null? xs) nil) (first (cons (car xs) (named-halves (cdr xs) #f))) (else (named-halves (cdr xs) #t)))))
  (named-merged (subr kfx ((listof named-item acyclic) (listof named-item acyclic)) (listof named-item acyclic))
    (lambda (a b)
      (cond ((null? a) b)
            ((null? b) a)
            ((tagcase (car b) (named-item (kb ib) (tagcase (car a) (named-item (ka ia) (string<? kb ka)))))
             (cons (car b) (named-merged a (cdr b))))
            (else (cons (car a) (named-merged (cdr a) b)))))))

(define itree-of (subr kfx (mitems) itree)
  (lambda (its)
    (let ((pairs (named-sorted (concat (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) (map (lambda ((n string)) (named-item n it)) ns)))) its)))))
      (itree-built pairs (size pairs)))))

(define-rec
  (in-itree (subr kfx (string itree) mitems)
    (lambda (x t)
      (tagcase t
        (ileaf () nil)
        (inode (l k it r) (cond ((string=? x k) (the mitems (list it))) ((string<? x k) (in-itree x l)) (else (in-itree x r))))))))

(define-rec
  (nset-added (subr kfx (string nset) nset)
    (lambda (x s)
      "`s` with `x`, unbalanced: for what a walk has seen."
      (tagcase s
        (nempty () (nnode (nempty) x (nempty)))
        (nnode (l k r) (cond ((string=? x k) s) ((string<? x k) (nnode (nset-added x l) k r)) (else (nnode l k (nset-added x r)))))))))

(define-rec
  (item-of (subr kfx (string mitems) mitems)
    (lambda (n its)
      (cond ((null? its) nil)
            ((tagcase (car its) (mitem (f ns rs l) (string-member? n ns))) (the mitems (list (car its))))
            (else (item-of n (cdr its))))))
  (reach (subr kfx (strings itree strings bool) strings)
    (lambda (todo t seen through-lambdas)
      "The items `todo` reach, through every item's references, or, with
       `through-lambdas`, only through procedures' (what making a value
       runs); by trees, the items found and those seen (C92: by lists, it
       had been cubic in a module's items)."
      (reach-in todo t (nempty) seen through-lambdas)))
  (reach-in (subr kfx (strings itree nset strings bool) strings)
    (lambda (todo t seen-set seen through-lambdas)
      (cond ((null? todo) seen)
            ((in-nset? (car todo) seen-set) (reach-in (cdr todo) t seen-set seen through-lambdas))
            (else
             (let ((it (in-itree (car todo) t)))
               (reach-in (onto (if (null? it)
                                   nil
                                   (tagcase (car it)
                                     (mitem (f ns rs l) (if (or l (not through-lambdas)) rs nil))))
                               (cdr todo))
                         t (nset-added (car todo) seen-set) (cons (car todo) seen) through-lambdas)))))))

(define-rec
  (index-in (subr kfx (string strings i64) i64)
    (lambda (n ns i) (cond ((null? ns) -1) ((string=? (car ns) n) i) (else (index-in n (cdr ns) (i64+ i 1)))))))

(define made-before (subr kfx (cv mitems itree) unit)
  (lambda (v its t)
    "FX-26's rule: a value that is no procedure is made when its item is,
     so every item it reaches through procedures must be made before it."
    (let ((order (concat (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) ns))) its))))
      (begin
        (map (lambda ((it mitem))
               (tagcase it
                 (mitem (f ns rs l)
                   (if l
                       #u
                       (let ((late (concat (map (lambda ((n string))
                                                  (if (i64>= (index-in n order 0) (index-in (car ns) order 0)) (the strings (list n)) nil))
                                                (reach rs t nil #t)))))
                         (if (null? late)
                             #u
                             (refuse v (string-append (car ns) (string-append " is made from " (string-append (car late)
                                       ", which is not made before it: a module's value sees only the items made before it, as FX-26's letrec* has it"))))))))))
             its)
        #u))))

(define-rec
  (components (subr kfx (mitems mitems (listof reached acyclic)) (listof mitems acyclic))
    (lambda (todo its rs)
      "The items, as sets that reach one another, each set after those it
       reaches: the order they are checked in. `rs`, what each reaches,
       found once (C92: found here again for each pair, it had cost a
       module of 160 items a tenth of a second)."
      (if (null? todo)
          nil
          (let* ((it (car todo))
                 (n (tagcase it (mitem (f ns rs2 l) (car ns))))
                 (mine (reached-of n rs))
                 (same (concat (map (lambda ((x mitem))
                                      (tagcase x (mitem (f ns rs2 l)
                                                   (if (and (string-member? (car ns) mine) (string-member? n (reached-of (car ns) rs)))
                                                       (the mitems (list x)) nil))))
                                    its)))
                 (rest (concat (map (lambda ((x mitem))
                                      (tagcase x (mitem (f ns rs2 l)
                                                   (if (any? (lambda ((y mitem)) (tagcase y (mitem (g ms qs k) (string=? (car ms) (car ns))))) same)
                                                       nil (the mitems (list x))))))
                                    todo)))
                 (deps (concat (map (lambda ((x mitem))
                                      (tagcase x (mitem (f ns rs2 l)
                                                   (if (and (string-member? (car ns) mine)
                                                            (not (any? (lambda ((y mitem)) (tagcase y (mitem (g ms qs k) (string=? (car ms) (car ns))))) same)))
                                                       (the mitems (list x)) nil))))
                                    rest)))
                 (later (concat (map (lambda ((x mitem))
                                       (if (any? (lambda ((y mitem)) (tagcase y (mitem (g ms qs k) (tagcase x (mitem (f ns rs2 l) (string=? (car ms) (car ns))))))) deps)
                                           nil (the mitems (list x))))
                                     rest))))
            (onto (components deps its rs) (cons same (components later its rs))))))))

(define rec-of (subr kfx (sexps) sexps)
  (lambda (members)
    "Items that reach one another, as one `define-rec` of their procedures,
     each where its item is (incr.kfx keys the group by their texts)."
    (tagcase (car members)
      (lst (xs file line pos)
        (the sexps
          (list (lst (cons (sym "define-rec" file pos)
                           (concat (map (lambda ((g sexp))
                                          (if (head-is? g "define-rec")
                                              (cdr (items g))
                                              (let ((ys (items g)))
                                                (the sexps (list (lst (list (second ys) (third ys) (car (item-value g))) (datum-file g) line (datum-pos g)))))))
                                        members)))
                     file line pos))))
      (else other nil))))

(define alone? (subr kfx (mitems) bool)
  (lambda (group)
    "Whether a set of items is checked as written: one, reaching not itself."
    (and (null? (cdr group))
         (tagcase (car group) (mitem (f ns rs l) (or (not l) (head-is? f "define-rec") (head-is? f "define*") (not (any? (lambda ((r string)) (string-member? r ns)) rs))))))))

(define as-group (subr kfx (cv mitems) sexps)
  (lambda (v group)
    "A set of items to check: one alone, as written, unless it reaches
     itself; else one `define-rec` of their procedures."
    (cond ((alone? group) (the sexps (list (tagcase (car group) (mitem (f ns rs l) f)))))
          ((any? (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) (or (not l) (head-is? f "define*"))))) group)
           (refuse v (string-append "items that reach one another, not each a typed lambda: "
                                    (words-of (concat (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) ns))) group))))))
          (else (rec-of (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) f))) group))))))

"A module's order, and its code (C92): `(s P)` for an item checked as
 written, `(r P ...)` for items checked as one `define-rec`, `P` where
 each is, from where the module's first item is (an edit before the
 module moves every item, and the order with them); which incr.kfx keeps,
 so that an unchanged module's order is not found again, its every body
 walked."
(define-rec
  (least-position (subr kfx (sexps i64) i64)
    (lambda (forms least)
      (cond ((null? forms) least)
            ((and (i64> (datum-pos (car forms)) 0) (or (i64< least 0) (i64< (datum-pos (car forms)) least)))
             (least-position (cdr forms) (datum-pos (car forms))))
            (else (least-position (cdr forms) least))))))

(define first-position (subr kfx (sexps) i64)
  (lambda (forms) (least-position forms -1)))
(define-datatype ordered (ordered sexps string))

(define first-checked (subr kfx (sexps) sexps)
  (lambda (forms)
    "A module's types and modules, as written, checked before its values."
    (concat (map (lambda ((f sexp)) (if (or (null? (item-value f)) (module-def? f)) (the sexps (list f)) nil)) forms))))

(define module-order-coded (subr kfx (cv sexps) ordered)
  (lambda (v forms)
    "A module's items in the order KFX checks them: its types and modules
     as written (a type may select a module's), then its values, each after
     what it reaches, those that reach one another as one group. A module
     item is made where it is written all the same (C88)."
    (let* ((its (letrec-items forms (cv-binds v)))
           (t (itree-of its))
           (values (concat (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) (if (module-def? f) nil (the mitems (list it)))))) its)))
           (groups (begin
                     (made-before v its t)
                     (components values its (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) (reached (car ns) (reach (list (car ns)) t nil #f))))) its)))))
      (ordered (onto (first-checked forms) (concat (map (lambda ((g mitems)) (as-group v g)) groups)))
               (words-of (map (lambda ((g mitems))
                                (string-append (if (alone? g) "(s " "(r ")
                                               (string-append (words-of (map (lambda ((it mitem)) (tagcase it (mitem (f ns rs l) (i64->string (i64- (datum-pos f) (first-position forms)))))) g)) ")")))
                              groups))))))

(define module-order (subr kfx (cv sexps) sexps)
  (lambda (v forms) (tagcase (module-order-coded v forms) (ordered (fs code) fs))))

(define-rec
  (form-at (subr kfx (i64 sexps) sexps)
    (lambda (p forms)
      (cond ((null? forms) nil)
            ((i64= (datum-pos (car forms)) p) (the sexps (list (car forms))))
            (else (form-at p (cdr forms)))))))

(define order-from-code (subr kfx (sexps string) sexps)
  (lambda (forms code)
    "An order kept (`module-order-coded`'s code), made again."
    (onto (first-checked forms)
          (concat (map (lambda ((g sexp))
                         (let ((members (concat (map (lambda ((p sexp)) (form-at (tagcase p (num (k f q) (i64+ k (first-position forms))) (else other -1)) forms)) (cdr (items g))))))
                           (if (head-is? g "s") members (rec-of members))))
                       (read-all (string-chars code) "" 1))))))

"A module checked (C91): its scope made (`module-prep`), its items checked
 in order, and what it gives the forms after it (`module-finish`); split so
 that incr.kfx checks the items with memos, between the two."
(define-datatype mprep (mprep cv cv cv string bind sexps bool sexps strings strings strings binds))

(define prep-inner (subr kfx (mprep) cv)
  (lambda (p) (tagcase p (mprep (outer v inner m made written loaded forms hidden hidden-types names conversions) inner))))

(define prep-name (subr kfx (mprep) string)
  (lambda (p) (tagcase p (mprep (outer v inner m made written loaded forms hidden hidden-types names conversions) m))))

(define prep-forms (subr kfx (mprep) sexps)
  (lambda (p) (tagcase p (mprep (outer v inner m made written loaded forms hidden hidden-types names conversions) forms))))

(define-rec
  (own-effects (subr kfx (cv sexps) cv)
    (lambda (v forms)
      "A module's `define-effect`s, each defined in turn, as its items will be."
      (cond ((null? forms) v)
            ((and (head-is? (car forms) "define-effect") (not (selects? (car forms))))
             (own-effects (tagcase (car forms) (lst (xs f l p) (with-effdef (near v f l p) xs)) (else other v)) (cdr forms)))
            (else (own-effects v (cdr forms)))))))

(define module-prep (subr kfx (cv sexp) mprep)
  (lambda (v form)
    (let* ((xs (items form))
             (m (name-of v (second xs)))
             (v (at v m nil))
             (v (if (string-member? (mangle m) (list "kayak_rt" "std" "core" "alloc"))
                    (refuse v (string-append "a module named as a Rust crate the program sees: " m))
                    v))
             (made (tagcase (global v m (scheme nil (ty-unit))) (bind (n sc wher) (bind n sc "module"))))
             (written (module-written form))
             (loaded (and (not (null? written)) (head-is? (car written) "%loaded")))
             (outer v)
             (v (if loaded (standard-scope v (map sym-name (cdr (cdr (items (car written)))))) v))
             (forms (unhidden written))
             (escapes (hidden-escapes v written))
             (hidden-types (hidden-type-names written))
             (all-includes (onto (included v forms) (included v (concat (map (lambda ((f sexp)) (if (head-is? f "hide") (cdr (items f)) nil)) written)))))
             (include-binds (map (lambda ((n string)) (typed-binds n (excepted-binds v written n (cv-binds v)))) all-includes))
             (hidden (onto (hidden-value-names written)
                           (map (lambda ((b bind)) (tagcase b (bind (n sc w) n)))
                                (concat (map (lambda ((n string)) (binds-of-include n include-binds))
                                             (included v (concat (map (lambda ((f sexp)) (if (head-is? f "hide") (cdr (items f)) nil)) written))))))))
             (includes (included v forms))
             (names (module-types v forms))
             (given-values (onto (concat (map item-value-names forms))
                                 (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (if (marker-name? n) nil (the strings (list n))))))
                                              (concat (map (lambda ((n string)) (binds-of-include n include-binds)) includes))))))
             (given-types (concat (map item-type-names forms)))
             (included-aliases (map (lambda ((a alias)) (tagcase a (alias (n ps body) (alias n ps (resolved-alias body (cv-aliases v))))))
                                    (concat (map (lambda ((n string)) (excepted-aliases v written n (cv-aliases v))) includes))))
             (all-types (onto given-types (map (lambda ((a alias)) (tagcase a (alias (n ps b) n))) (distinct-aliases included-aliases))))
             (v (if (or (repeated? given-values) (repeated? all-types))
                    (refuse v (string-append "a name defined twice in this module, its own or included: "
                                             (if (repeated? given-values) (first-repeated given-values) (first-repeated all-types))))
                    v))
             (typed (tagcase v
                      (cv (bs ds als es here group file line fs tv at)
                        (cv (bind-onto (concat (map (lambda ((n string)) (binds-of-include n include-binds)) includes))
                                       (cons (bind "%module" (scheme nil (ty-unit)) m) bs))
                            (onto (module-dts v m forms) ds)
                            (onto (module-aliases v m names forms #t)
                                  (onto (concat (map (lambda ((n string)) (excepted-aliases v written n als)) includes)) als))
                            (onto (concat (map (lambda ((n string)) (opened-effdefs n es)) includes)) es)
                            here group file line fs tv at))))
             ;; Its own effects too, in order, before its types are read, which
             ;; may name them (C116: Fixpt's `check-types-types.fx`'s `kstate`).
             (typed (own-effects typed forms))
             (datatypes (module-datatypes typed m forms))
             (typed (tagcase typed
                      (cv (bs ds als es here group file line fs tv at)
                        (cv bs (onto datatypes ds) als es here group file line fs tv at))))
             (conversions (module-conversions typed m forms))
             (inner (defined-once typed (onto conversions (concat (map constructors datatypes))))))
      (mprep outer v inner m made written loaded forms hidden hidden-types names conversions))))

(define module-finish (subr kfx (mprep elab) elab)
  (lambda (p checked)
    (tagcase p
      (mprep (outer v inner m made written loaded forms hidden hidden-types names conversions)
        (tagcase checked
          (elab (done found)
            (tagcase done
              (cv (bs ds als es here group file line fs tv at)
                (elab (cv (cons made (bind-onto (module-exports m (onto hidden (map (lambda ((b bind)) (tagcase b (bind (n sc w) n))) conversions)) (items-kept-in v bs))
                                                (cv-binds outer)))
                          (if loaded (onto ds (cv-dts outer)) ds)
                          (onto (without-aliases hidden-types m (module-aliases v m names forms #f))
                                   (onto (concat (map (lambda ((n string)) (renamed-aliases n m (excepted-aliases v written n als)))
                                                      (unhidden-includes v written)))
                                         (cv-aliases outer)))
                          (onto (module-effects m forms es)
                                (onto (concat (map (lambda ((n string))
                                                     (map (lambda ((d effdef)) (tagcase d (effdef (k atoms) (effdef (string-append m (string-append " " k)) atoms))))
                                                          (opened-effdefs n es)))
                                                   (unhidden-includes v written)))
                                      (cv-effdefs outer)))
                          here group file line fs tv at)
                      found)))))))))

(define-rec
  (check-item (subr kfx (cv string sexp) elab)
    (lambda (v m form)
      "One of a module's items: as a program's form, but that its generative
       types are made already, and its elaborated types are named `m x`."
      (cond ((or (head-is? form "define-generative") (head-is? form "define-datatype")
                 (head-is? form "include") (head-is? form "%loaded"))
             (elab v nil))
            ((module-def? form)
             "A module in a module (C88): checked as one, its names the outer's
              items, `n x` for its `x`, which the outer gives on as `m n x`."
             (tagcase form
               (lst (xs src-file src-line src-pos)
                 (tagcase (check-module (near v src-file src-line src-pos) form)
                   (elab (v2 more) (elab (at v2 "" nil) nil))))
               (else other (elab v nil))))
            ((untyped? form)
             (tagcase form
               (lst (xs src-file src-line src-pos)
                 (tagcase (check-untyped (near v src-file src-line src-pos) form)
                   (elab (v2 more)
                     (elab (at v2 "" nil)
                           (map (lambda ((x typed)) (tagcase x (typed (n t) (typed (string-append m (string-append " " n)) t)))) more)))))
               (else other (elab v nil))))
            (else (elab (check-top v form) nil)))))

  (check-items (subr kfx (cv string sexps typeds) elab)
    (lambda (v m forms found)
      "A module's items, in order."
      (if (null? forms)
          (elab v found)
          (tagcase (check-item v m (car forms))
            (elab (v2 more) (check-items v2 m (cdr forms) (onto more found)))))))

  (check-module (subr kfx (cv sexp) elab)
    (lambda (v form)
      (let* ((p (module-prep v form))
             (stars (star-items (prep-forms p))))
        (if (any? (lambda ((f sexp))
                    (and (head-is? f "define") (i64= (size (items f)) 4) (not (lambda-form? (fourth (items f))))
                         (any? (lambda ((n string)) (string-member? n stars)) (names-in (fourth (items f))))))
                  (prep-forms p))
            (refuse v "a module's value names a `->*` procedure of the module, whose effect is found only after the module's values are made (Fixpt's)")
            (module-finish p (check-items (prep-inner p) (prep-name p) (module-order (prep-inner p) (prep-forms p)) nil)))))))

(define check-tops (subr kfx (cv sexps typeds) elab)
  (lambda (v forms found)
    "The forms in order; `found`, the types elaborated so far."
    (cond ((null? forms) (elab v found))
          ((module-def? (car forms))
           (tagcase (car forms)
             (lst (xs src-file src-line src-pos)
               (tagcase (check-module (near v src-file src-line src-pos) (car forms))
                 (elab (v2 more) (check-tops (at v2 "" nil) (cdr forms) (onto more found)))))
             (else other (check-tops v (cdr forms) found))))
          ((untyped? (car forms))
           (tagcase (car forms)
             (lst (xs src-file src-line src-pos)
               (tagcase (check-untyped (near v src-file src-line src-pos) (car forms))
                 (elab (v2 more) (check-tops (at v2 "" nil) (cdr forms) (onto more found)))))
             (else other (check-tops v (cdr forms) found))))
          (else (check-tops (check-top v (car forms)) (cdr forms) found)))))

"What checking a program gives the emitter: the types of the definitions
 written with none, and the facts."
(define-datatype verdict (verdict typeds facts))

(define verdict-typeds (subr kfx (verdict) typeds)
  (lambda (x) (tagcase x (verdict (ts fs) ts))))

(define verdict-facts (subr kfx (verdict) facts)
  (lambda (x) (tagcase x (verdict (ts fs) fs))))

(define check-program (subr kfx (sexps) verdict)
  (lambda (forms)
    "Every form, in order; the first error stops the compiler. What it gives
     is the types of the definitions written with none."
    (let* ((empty (cv nil nil nil nil "a type" nil "the program" 0 nil nil 0))
           (start (cv nil nil (declare-types empty forms nil) nil "a type" nil "the program" 0 nil nil 0))
           (types (type-names-free start forms))
           (named (tagcase start (cv (bs ds als es here group file line fs tv at) (cv bs (datatype-names start forms nil) als es here group file line fs tv at))))
           (typed (tagcase named (cv (bs ds als es here group file line fs tv at) (cv bs (declare-datatypes named forms nil) als es here group file line fs tv at))))
           (v (with-binds typed (prim-binds typed))))
      (tagcase (check-tops v forms nil) (elab (done found) (verdict found (cv-facts done)))))))

"A file read, for a load: its path and text (C88)."
(define-datatype filed (filed string string))
(define-type fileds (listof filed acyclic))

(define-rec
  (before-last (subr kfx (chars char chars chars) chars)
    (lambda (cs c seen before)
      "`cs`'s characters before its last `c`, newest first, onto nothing if
       it has none: `seen` the characters since the last `c` so far, newest
       first, `before` those before it."
      (cond ((null? cs) before)
            ((char=? (car cs) c) (before-last (cdr cs) c nil (cons c (onto seen before))))
            (else (before-last (cdr cs) c (cons (car cs) seen) before))))))

(define-rec
  (after-last (subr kfx (chars char chars) chars)
    (lambda (cs c acc)
      "`cs`'s characters after its last `c`, or all of them, newest first."
      (cond ((null? cs) acc)
            ((char=? (car cs) c) (after-last (cdr cs) c nil))
            (else (after-last (cdr cs) c (cons (car cs) acc)))))))

(define directory-of (subr kfx (string) string)
  (lambda (path)
    "Where `path` is: before its last `/`, without it; `` for a name alone."
    (let ((before (before-last (string-chars path) #\/ nil nil)))
      (if (null? before) "" (rev->string (cdr before))))))

(define stem (subr kfx (string) string)
  (lambda (path)
    "A file's name, without where it is or its extension."
    (let* ((name (rev->string (after-last (string-chars path) #\/ nil)))
           (before (before-last (string-chars name) #\. nil nil)))
      (if (or (null? before) (null? (cdr before))) name (rev->string (cdr before))))))

(define built-in-path? (subr kfx (string) bool)
  (lambda (path)
    "Whether `path` names a module Fixpt builds in, `fx26:NAME` (C107)."
    (has-prefix? path "fx26:")))

(define path-joined (subr kfx (string string) string)
  (lambda (dir name)
    "`name` from `dir`; an absolute `name` as it is (C121: a nested load's
     path, made absolute by `loads-from`, was joined again)."
    (if (or (string=? dir "") (has-prefix? name "/")) name (string-append dir (string-append "/" name)))))

"A `load-module` of a path (C88, FX-26's M7): a file's forms as a
 module's items, the path from the loading file's directory. The driver
 reads the files (`loads-read`); here each load is the module whose first
 item is `%loaded` and its path, which the checker checks in the standard
 environment alone, as FX-26 reads a file."
(define-rec
  (load-paths (subr kfx (sexp string) strings)
    (lambda (e dir)
      (tagcase e
        (lst (xs f l p)
          (if (and (or (head-is? e "load-module") (head-is? e "load-input")) (i64= (size xs) 2) (tagcase (second xs) (str (s f2 p2) #t) (else other #f)))
              ;; A module built in (C107) is read from no file.
              (tagcase (second xs) (str (s f2 p2) (if (built-in-path? s) nil (the strings (list (path-joined dir s))))) (else other nil))
              (concat (map (lambda ((x sexp)) (load-paths x dir)) xs))))
        (else other nil)))))

(define-rec
  (loads? (subr kfx (sexp) bool)
    (lambda (e)
      "Whether `e` has a `load-module` in it: of a module built in, perhaps,
       which no file is read for (C107)."
      (tagcase e
        (lst (xs f l p) (or (head-is? e "load-module") (head-is? e "load-input") (any? loads? xs)))
        (else other #f)))))

(define load-paths-all (subr kfx (sexps string) strings)
  (lambda (forms dir) (concat (map (lambda ((f sexp)) (load-paths f dir)) forms))))

(define-rec
  (renamed (subr kfx (sexp string string) sexp)
    (lambda (e from to)
      (tagcase e
        (sym (n f p) (if (string=? n from) (sym to f p) e))
        (lst (xs f l p) (lst (map (lambda ((x sexp)) (renamed x from to)) xs) f l p))
        (else other e)))))

(define-rec
  (renamed-all (subr kfx (sexps strings strings) sexps)
    (lambda (es froms tos)
      (if (null? froms)
          es
          (renamed-all (map (lambda ((e sexp)) (renamed e (car froms) (car tos))) es) (cdr froms) (cdr tos))))))

"A load's module, shared (C116): FX-26 makes a path once, one value for
 all its loads (and a file of `module-parameters` once for each call), so
 its datatypes are one; KFX's are Rust enums, one for each module, so a
 path, with what it is given, is one module, `made--load--K`, defined at
 the top level before the form that first loads it, which each load
 includes. `keyed`: a path and its arguments, written, and its module's
 name; `spliced-to`: a form spliced, the modules it defined first, and
 every path's so far."
(define-datatype keyed (keyed string string))
(define-type keyeds (listof keyed acyclic))
(define-datatype spliced-to (spliced-to sexp sexps keyeds))

(define load-of (subr kfx (sexp) sexps)
  (lambda (e)
    "What `e` loads: `(load-module \"p\")`, as a list of its path and no
     arguments; `((proj (load-module \"p\") r ...))`, of its path and its
     regions (a file of `module-parameters`); else nothing."
    (tagcase e
      (lst (xs f l p)
        (cond ((and (head-is? e "load-module") (i64= (size xs) 2) (tagcase (second xs) (str (s f2 p2) #t) (else other #f)))
               (list (second xs)))
              ((and (i64= (size xs) 1) (head-is? (car xs) "proj") (i64> (size (items (car xs))) 1)
                    (tagcase (second (items (car xs)))
                      (lst (ys f2 l2 p2) (and (head-is? (second (items (car xs))) "load-module") (i64= (size ys) 2)
                                              (tagcase (second ys) (str (s f3 p3) #t) (else other #f))))
                      (else other #f)))
               (cons (second (items (second (items (car xs))))) (cdr (cdr (items (car xs))))))
              (else nil)))
      (else other nil))))

(define spliced-form (subr kfx (spliced-to) sexp) (lambda (s) (tagcase s (spliced-to (x d k) x))))
(define spliced-defs (subr kfx (spliced-to) sexps) (lambda (s) (tagcase s (spliced-to (x d k) d))))
(define spliced-known (subr kfx (spliced-to) keyeds) (lambda (s) (tagcase s (spliced-to (x d k) k))))

(define file-tag (subr kfx (string) string)
  (lambda (f)
    "File `f`'s name as a part of a name: its letters and digits, each
     other character `-`; so that the loads of two files of one program,
     each counted from 0, are not named alike."
    (rev->string (reverse (the chars (map (lambda ((c char)) (if (or (char-lower? c) (char-numeric? c)) c #\-))
                                          (string-chars (stem f))))))))

(define included-module (subr kfx (string string i64 i64) sexp)
  (lambda (name f l p)
    "A load of a module already made: a module that includes it."
    (lst (list (sym "module" f p) (lst (list (sym "include" f p) (sym name f p)) f l p)) f l p)))

(define-rec
  (shared-names (subr kfx (sexps) keyeds)
    (lambda (its)
      "Among a form's items, perhaps hidden, each `(define m L)` whose `L`
       was a load, now a module including the shared one: `m` and that
       module's name."
      (concat (map (lambda ((g sexp))
                     (cond ((and (head-is? g "define") (i64= (size (items g)) 3) (head-is? (third (items g)) "module")
                                 (i64= (size (items (third (items g)))) 2) (head-is? (second (items (third (items g)))) "include"))
                            (tagcase (second (items (second (items (third (items g))))))
                              (sym (n f p)
                                (if (has-prefix? n "made--load--")
                                    (the keyeds (list (keyed (tagcase (second (items g)) (sym (m f2 p2) m) (else other "")) n)))
                                    nil))
                              (else other nil)))
                           ((head-is? g "hide") (shared-names (cdr (items g))))
                           (else nil)))
                   its)))))

(define-rec
  (selects-renamed (subr kfx (sexp keyeds) sexp)
    (lambda (e shared)
      "`e`, each `(select m x)` of a shared load's `m` the shared module's:
       one module, so the same meaning, and one defined at the top level,
       whose types a `select` may name (C118)."
      (tagcase e
        (lst (xs f l p)
          (let ((to (if (and (head-is? e "select") (i64= (size xs) 3))
                        (tagcase (second xs)
                          (sym (n f2 p2) (concat (map (lambda ((k keyed)) (tagcase k (keyed (m made) (if (string=? m n) (the strings (list made)) nil)))) shared)))
                          (else other nil))
                        nil)))
            (if (null? to)
                (lst (map (lambda ((x sexp)) (selects-renamed x shared)) xs) f l p)
                (lst (list (car xs) (sym (car to) f p) (third xs)) f l p))))
        (else other e)))))

(define parameters-given (subr kfx (sexps sexps string) sexps)
  (lambda (forms args path)
    "A loaded file's items: of a file of `module-parameters`, the rest, each
     of its regions the one given; of any other, all, given nothing."
    (if (and (not (null? forms)) (head-is? (car forms) "module-parameters"))
        (let ((params (items (second (items (car forms))))))
          (if (or (not (i64= (size params) (size args)))
                  (any? (lambda ((b sexp)) (not (sym-is? (second (items b)) "region"))) params))
              (error (string-append "kfx: " (string-append path ": module parameters KFX gives regions alone, as many as the file has")))
              (renamed-all (cdr forms) (map (lambda ((b sexp)) (sym-name (car (items b)))) params)
                           (map (lambda ((a sexp)) (tagcase a (sym (n f p) n) (else other "?"))) args))))
        (if (null? args)
            forms
            (error (string-append "kfx: " (string-append path ": given regions, and no module-parameters")))))))

"FX-26's `(import m name ... (type name ...) (effect name ...))` (C119),
 expanded as it is read, as FX-26 expands it: each value `(define x (with m
 x))`, each type `(define-type t (select m t))`, each effect
 `(define-effect e (select m e))`; an item wherever a definition is, at the
 top level, in a `module`, in a `hide`."
(define import-defs (subr kfx (sexp) sexps)
  (lambda (g)
    (tagcase g
      (lst (xs f l p)
        (let ((where (string-append "kfx: " (string-append f (string-append ":" (i64->string l))))))
          (if (tagcase (second xs) (sym (n f2 p2) #f) (else other #t))
              (error (string-append where ": an import names its module by a variable"))
              (let ((m (second xs)))
                (concat (map (lambda ((x sexp))
                               (tagcase x
                                 (sym (n f2 p2) (the sexps (list (lst (list (sym "define" f p) x (lst (list (sym "with" f p) m x) f l p)) f l p))))
                                 (lst (ys f2 l2 p2)
                                   (if (and (or (head-is? x "type") (head-is? x "effect"))
                                            (not (any? (lambda ((y sexp)) (tagcase y (sym (n f3 p3) #f) (else other #t))) (cdr ys))))
                                       (map (lambda ((y sexp))
                                              (lst (list (sym (if (head-is? x "type") "define-type" "define-effect") f p) y
                                                         (lst (list (sym "select" f p) m y) f l p))
                                                   f l p))
                                            (cdr ys))
                                       (error (string-append where ": an import's names are names, (type name ...) or (effect name ...)"))))
                                 (else other (error (string-append where ": an import's names are names, (type name ...) or (effect name ...)")))))
                             (cdr (cdr xs))))))))
      (else other nil))))

(define-rec
  (import-items (subr kfx (sexps) sexps)
    (lambda (its)
      "Items, each `import` its definitions, each other its imports expanded."
      (concat (map (lambda ((g sexp))
                     (if (and (head-is? g "import") (i64> (size (items g)) 1))
                         (import-defs g)
                         (the sexps (list (imports-in g)))))
                   its))))
  (imports-in (subr kfx (sexp) sexp)
    (lambda (e)
      "Imports expanded; and FX-26's procedure types written short (Fixpt
       2a0e6fd, 38df01e): `(-> (T ...) R)` as `(subr pure (T ...) R)`, which
       it is, and `(->* (T ...) R)` as `(subr %found (T ...) R)`, whose
       effect a definition finds (`found-define`); in no quoted datum."
      (tagcase e
        (lst (xs f l p)
          (cond ((or (head-is? e "quote") (head-is? e "quasiquote")) e)
                ((or (head-is? e "module") (head-is? e "hide"))
                 (lst (cons (car xs) (import-items (cdr xs))) f l p))
                ((and (or (head-is? e "->") (head-is? e "->*")) (i64= (size xs) 3))
                 (lst (list (sym "subr" f p) (sym (if (head-is? e "->") "pure" "%found") f p) (imports-in (second xs)) (imports-in (third xs))) f l p))
                (else (lst (map imports-in xs) f l p))))
        (else other e)))))

(define-rec
  (spliced (subr kfx (sexp string fileds strings keyeds) spliced-to)
    (lambda (e dir loaded chain known)
      "`e`, each load in it the module its file is, shared."
      (tagcase e
        (lst (xs f l p)
          (let ((load (load-of e)))
            (cond
             ((and (head-is? e "load-input") (i64= (size xs) 2) (tagcase (second xs) (str (s f2 p2) #t) (else other #f)))
              "A file of one expression, its value (C171; FX-26's `load-input`):
               FX-26's alone, a value made once for all its loads, here a global
               defined before the form that first loads it,
               `%shared:input:PATH` as Fixpt names it, which the restriction pass
               refuses."
              (let* ((path (tagcase (second xs) (str (s f2 p2) (if (built-in-path? s) s (path-joined dir s))) (else other "")))
                     (key (string-append "input:" path))
                     (had (concat (map (lambda ((k keyed)) (tagcase k (keyed (kk n) (if (string=? kk key) (the strings (list n)) nil)))) known))))
                (if (not (null? had))
                    (spliced-to (sym (car had) f p) nil known)
                    (let ((found (if (built-in-path? path)
                                     (if (string=? (built-in-text path) "") nil (the strings (list (built-in-text path))))
                                     (concat (map (lambda ((x filed)) (tagcase x (filed (n text) (if (string=? n path) (the strings (list text)) nil)))) loaded)))))
                      (if (null? found)
                          (error (string-append "kfx: cannot read " path))
                          (let ((es (read-all (string-chars (car found)) path 1)))
                            (if (not (i64= (size es) 1))
                                (error (string-append "kfx: " (string-append path ": not a file of one expression")))
                                (let* ((inner (spliced (imports-in (car es)) (directory-of path) loaded (cons path chain) known))
                                       (name (string-append "%shared:" key))
                                       (made (lst (list (sym "define" f p) (sym name f p) (spliced-form inner)) f l p)))
                                  (spliced-to (sym name f p) (onto (spliced-defs inner) (list made))
                                              (cons (keyed key name) (spliced-known inner)))))))))))
             ((and (null? load) (head-is? e "proj") (i64> (size xs) 2) (head-is? (second xs) "load-module"))
              "A file of module parameters given them, not called (C171): the
               procedure that makes the module, `(lambda () ((proj ...)))`."
              (spliced (lst (list (sym "lambda" f p) (lst nil f l p) (lst (list e) f l p)) f l p) dir loaded chain known))
             ((null? load)
                (spliced-each xs dir loaded chain known nil nil f l p))
             (else
                (let* ((path (tagcase (car load) (str (s f2 p2) (if (built-in-path? s) s (path-joined dir s))) (else other "")))
                       (args (cdr load))
                       (key (string-append path (string-append " " (show-sexps args))))
                       (had (concat (map (lambda ((k keyed)) (tagcase k (keyed (kk n) (if (string=? kk key) (the strings (list n)) nil)))) known))))
                  (if (not (null? had))
                      (spliced-to (included-module (car had) f l p) nil known)
                      (let ((found (if (built-in-path? path)
                                       (if (string=? (built-in-text path) "") nil (the strings (list (built-in-text path))))
                                       (concat (map (lambda ((x filed)) (tagcase x (filed (n text) (if (string=? n path) (the strings (list text)) nil)))) loaded)))))
                        (cond ((string-member? path chain)
                               (error (string-append "kfx: " (string-append f (string-append ": a load cycle: " (words-of (reverse (the strings (cons path chain)))))))))
                              ((null? found) (error (string-append "kfx: cannot read " path)))
                              (else
                               (let* ((forms (import-items (read-all (string-chars (car found)) path 1)))
                                      (its (parameters-given forms args path))
                                      (inner (spliced-each its (directory-of path) loaded (cons path chain) known nil nil f l p))
                                      (name (string-append "made--load--" (string-append (i64->string (size (spliced-known inner))) (string-append "--" (file-tag f)))))
                                      (sees (map (lambda ((k keyed)) (tagcase k (keyed (kk n) (sym n f p)))) (spliced-known inner)))
                                      (made (lst (list (sym "define" f p) (sym name f p)
                                                       (lst (cons (sym "module" f p)
                                                                  (cons (lst (cons (sym "%loaded" f p) (cons (str path f p) (if (null? args) sees (cons (sym "%instance" f p) sees)))) f l p)
                                                                        (items (spliced-form inner))))
                                                            f l p))
                                                 f l p)))
                                 (spliced-to (included-module name f l p)
                                             (onto (spliced-defs inner) (list made))
                                             (cons (keyed key name) (spliced-known inner)))))))))))))
        (else other (spliced-to e nil known)))))
  (spliced-each (subr kfx (sexps string fileds strings keyeds sexps sexps string i64 i64) spliced-to)
    (lambda (xs dir loaded chain known done defs f l p)
      "Each of `xs` spliced in turn, `done` those so far, reversed."
      (if (null? xs)
          (let* ((its (the sexps (reverse done)))
                 (shared (shared-names its)))
            (spliced-to (lst (if (null? shared) its (map (lambda ((x sexp)) (selects-renamed x shared)) its)) f l p) defs known))
          (tagcase (spliced (car xs) dir loaded chain known)
            (spliced-to (x more known2)
              (spliced-each (cdr xs) dir loaded chain known2 (cons x done) (onto defs more) f l p)))))))

"A module made where it is included or extended (C90): FX-26 makes it
 before the module's items, seeing none of them, so it is defined before
 the module that uses it, at the top level, named `made--P` (`P` where it
 is written), a name no KFX name is (C27's `--`), and used by that name."
(define made-name (subr kfx (sexp) string)
  (lambda (e) (string-append "made--" (i64->string (datum-pos e)))))

(define made-here? (subr kfx (sexp) bool)
  (lambda (e) (head-is? e "module")))

(define-rec
  (made-in (subr kfx (sexps) sexps)
    (lambda (its)
      "The modules made in place among a module's items, each defined."
      (concat (map (lambda ((g sexp))
                     (cond ((and (head-is? g "include") (made-here? (second (items g))))
                            (the sexps (list (lst (list (sym "define" "" 0) (sym (made-name (second (items g))) "" 0) (second (items g))) "" 0 0))))
                           ((head-is? g "hide") (made-in (cdr (items g))))
                           (else nil)))
                   its))))
  (named-made (subr kfx (sexps) sexps)
    (lambda (its)
      "A module's items, each module made in place named."
      (map (lambda ((g sexp))
             (cond ((and (head-is? g "include") (made-here? (second (items g))))
                    (lst (cons (car (items g)) (cons (sym (made-name (second (items g))) "" 0) (cdr (cdr (items g))))) "" 0 0))
                   ((head-is? g "hide") (lst (cons (car (items g)) (named-made (cdr (items g)))) "" 0 0))
                   (else g)))
           its))))

(define hoisted (subr kfx (sexp) sexps)
  (lambda (f)
    "A top-level form, after the modules it makes in place, each defined."
    (if (not (module-def? f))
        (the sexps (list f))
        (tagcase f
          (lst (xs file line pos)
            (let ((x (third xs)))
              (cond ((head-is? x "module")
                     (onto (made-in (cdr (items x)))
                           (the sexps (list (lst (list (car xs) (second xs) (lst (cons (car (items x)) (named-made (cdr (items x)))) file line pos)) file line pos)))))
                    ((head-is? x "extend")
                     (let* ((ys (items x))
                            (e0 (second ys)))
                       (if (made-here? e0)
                           (the sexps (list (lst (list (sym "define" "" 0) (sym (made-name e0) "" 0) e0) "" 0 0)
                                            (lst (list (car xs) (second xs) (lst (list (car ys) (sym (made-name e0) "" 0) (third ys)) file line pos)) file line pos)))
                           (the sexps (list f)))))
                    (else (the sexps (list f))))))
          (else other (the sexps (list f)))))))

(define-rec
  (flat-plambda (subr kfx (sexp) sexp)
    (lambda (e)
      "A `plambda` directly in a `plambda`, as FX-26's library writes one
       whose type is a `poly` in a `poly` (C70, C107): one, the binders in
       order."
      (if (and (head-is? e "plambda") (i64= (size (items e)) 3) (head-is? (third (items e)) "plambda"))
          (let ((inner (flat-plambda (third (items e)))))
            (lst (list (car (items e)) (lst (onto (items (second (items e))) (items (second (items inner)))) "" 0 0) (third (items inner)))
                 (datum-file e) 0 (datum-pos e)))
          e)))
  (flat-definition (subr kfx (sexp) sexp)
    (lambda (f)
      "A definition whose type is a `poly` in a `poly` and whose value a
       `plambda` in a `plambda`, as one of each; a module's, each of its
       items'."
      (tagcase f
        (lst (xs file line pos)
          (cond ((and (or (head-is? f "define") (head-is? f "define*")) (i64= (size xs) 4))
                 (lst (list (car xs) (second xs) (flat-poly (third xs)) (flat-plambda (fourth xs))) file line pos))
                ((head-is? f "define-rec")
                 (lst (cons (car xs) (map (lambda ((m sexp))
                                            (tagcase m
                                              (lst (ys f2 l2 p2)
                                                (if (i64= (size ys) 3) (lst (list (car ys) (flat-poly (second ys)) (flat-plambda (third ys))) f2 l2 p2) m))
                                              (else other m)))
                                          (cdr xs)))
                      file line pos))
                ((or (head-is? f "module") (head-is? f "hide"))
                 (lst (cons (car xs) (map flat-definition (cdr xs))) file line pos))
                ((and (head-is? f "define-type") (i64= (size xs) 3) (head-is? (third xs) "moduleof"))
                 "A module type's value whose type is a `poly` in a `poly`, as
                  Fixpt's `tables-sig` writes `make-table`: one (C119)."
                 (lst (list (car xs) (second xs)
                            (lst (map (lambda ((it sexp))
                                        (if (and (head-is? it "val") (i64= (size (items it)) 3))
                                            (lst (list (car (items it)) (second (items it)) (flat-poly (third (items it)))) (datum-file it) 0 (datum-pos it))
                                            it))
                                      (items (third xs)))
                                 file line (datum-pos (third xs))))
                      file line pos))
                ((and (head-is? f "define") (i64= (size xs) 3) (head-is? (third xs) "module"))
                 (lst (list (car xs) (second xs) (flat-definition (third xs))) file line pos))
                (else f)))
        (else other f)))))

(define-rec
  (loads-from (subr kfx (sexp string) sexp)
    (lambda (e dir)
      "`e`, each `load-module` of a path of a file its path from `dir`, the
       directory of the file `e` was read from (C116: a `load-input`'s
       file's, whose forms are read where the program is)."
      (tagcase e
        (lst (xs f l p)
          (if (and (head-is? e "load-module") (i64= (size xs) 2))
              (tagcase (second xs)
                (str (t f2 p2) (if (built-in-path? t) e (lst (list (car xs) (str (path-joined dir t) f2 p2)) f l p)))
                (else other e))
              (lst (map (lambda ((x sexp)) (loads-from x dir)) xs) f l p)))
        (else other e)))))

(define input-expanded (subr kfx (sexp string fileds) sexps)
  (lambda (f dir loaded)
    "`(define x (load-input \"fx26:p\"))` (C116, FX-26's M7): the built-in
     file's one expression, as Fixpt's code generators are written: a
     module, or a `let` of loaded modules around one. The module is a
     loaded one, which sees the standard environment alone; the `let`'s
     modules are defined before it, each `made--input--P--n` (`P` where the
     load is), which it alone sees, by that name. A file of the program's
     from the loading file's directory, as `load-module`'s."
    (tagcase f
      (lst (xs fl l p)
        (if (and (head-is? f "define") (i64= (size xs) 3) (head-is? (third xs) "load-input"))
            (let* ((load (items (third xs)))
                   (written (tagcase (second load) (str (t f2 p2) t) (else other "")))
                   (path (if (built-in-path? written) written (path-joined dir written)))
                   (text (if (built-in-path? path)
                             (built-in-text path)
                             (let ((found (concat (map (lambda ((x filed)) (tagcase x (filed (n t) (if (string=? n path) (the strings (list t)) nil)))) loaded))))
                               (if (null? found) "" (car found)))))
                   (es (if (string=? text "")
                           (error (string-append "kfx: " (string-append fl (string-append ": cannot read " path))))
                           (map (lambda ((x sexp)) (imports-in (if (built-in-path? path) x (loads-from x (directory-of path)))))
                                (read-all (string-chars text) path 1))))
                   (e (if (i64= (size es) 1) (car es) (error (string-append "kfx: " (string-append path ": not a file of one expression")))))
                   (bound (if (head-is? e "let") (items (second (items e))) nil))
                   (body (if (head-is? e "let") (third (items e)) e))
                   (names (map (lambda ((b sexp)) (sym-name (car (items b)))) bound))
                   (lifted (map (lambda ((n string)) (string-append "made--input--" (string-append (i64->string (datum-pos (third xs))) (string-append "--" n)))) names)))
              (if (or (not (head-is? body "module"))
                      (and (head-is? e "let") (not (i64= (size (items e)) 3)))
                      (any? (lambda ((b sexp)) (not (head-is? (second (items b)) "load-module"))) bound))
                  ;; Any other file of one expression, a value (C171): `spliced`'s.
                  (list f)
                  (onto (map2 (lambda ((b sexp) (n string)) (lst (list (sym "define" fl p) (sym n fl p) (second (items b))) fl l p)) bound lifted)
                        (list (lst (list (car xs) (second xs)
                                         (lst (cons (sym "module" fl p)
                                                    (cons (lst (cons (sym "%loaded" fl p) (cons (str path fl p) (map (lambda ((n string)) (sym n fl p)) lifted))) fl l p)
                                                          (renamed-all (cdr (items body)) names lifted)))
                                              fl l p))
                                   fl l p)))))
            (list f)))
      (else other (list f)))))

(define-rec
  (spliced-tops (subr kfx (sexps string fileds keyeds) sexps)
    (lambda (forms dir loaded known)
      "The program's forms, each load shared, the modules each first makes
       defined before it."
      (if (null? forms)
          nil
          (tagcase (spliced (car forms) dir loaded nil known)
            (spliced-to (x defs known2) (onto defs (cons x (spliced-tops (cdr forms) dir loaded known2)))))))))

"A module defined at the top level that KFX's modules cannot be (C171): one
 that includes a module made where it is (but a module written there,
 C90), or has a module of its own that includes one not named. It is a
 module value, `(%module-value item ...)`, as FX-26's are all (C170)."
(define-rec
  (include-of-value? (subr kfx (sexps bool) bool)
    (lambda (its outer)
      "Whether module items `its` include a module neither named nor (where
       `outer`, a module defined at the top level) written in place."
      (any? (lambda ((f sexp))
              (cond ((and (head-is? f "include") (i64> (size (items f)) 1))
                     (let ((e (second (items f))))
                       (not (or (tagcase e (sym (n f2 p2) #t) (else other #f))
                                (and outer (or (head-is? e "module") (head-is? e "load-module")))))))
                    ((head-is? f "hide") (include-of-value? (cdr (items f)) outer))
                    ((and (head-is? f "define") (i64= (size (items f)) 3) (head-is? (third (items f)) "module"))
                     (include-of-value? (cdr (items (third (items f)))) #f))
                    (else #f)))
            its))))

(define as-module-value (subr kfx (sexp) sexp)
  (lambda (f)
    (if (and (module-def? f) (head-is? (third (items f)) "module") (include-of-value? (cdr (items (third (items f)))) #t))
        (tagcase f
          (lst (xs fl l p)
            (lst (list (car xs) (second xs)
                       (tagcase (third xs) (lst (ys f2 l2 p2) (lst (cons (sym "%module-value" f2 p2) (cdr ys)) f2 l2 p2)) (else other (third xs))))
                 fl l p))
          (else other f))
        f)))

(define with-loads (subr kfx (sexps string fileds) sexps)
  (lambda (forms file loaded)
    "A program's forms: what it loads spliced in (C88), and what its modules
     make in place defined before them (C90); a `poly` in a `poly` around a
     definition, one (C107); a `load-input` of a module, the module (C116);
     a module KFX's cannot be, a module value (C171)."
    (let ((forms (map as-module-value (concat (map (lambda ((f sexp)) (input-expanded f (directory-of file) loaded)) (import-items forms))))))
      (map flat-definition
           (concat (map hoisted (if (and (null? loaded) (not (any? loads? forms)))
                                    forms
                                    (spliced-tops forms (directory-of file) loaded nil))))))))


