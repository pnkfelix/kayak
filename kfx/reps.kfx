"reps.kfx: the checker's types as reps (C301; `docs/research/type-reps.md`,
 after Fixpt's `check-reps.fx` and its `reps.rs` table of heads): a type's
 nodes, given the runtime, which makes the rep canonical (`rep-of-nodes`,
 Fixpt's `fixpt-reps` taken whole). The export is a value threaded through
 the walk, as the checker's state is, not a global."

"A node as `rep-of-nodes` takes it: its slot, its head, whether it is a set,
 its binders' names, its operands."
(define-type rp-operand
  (sumof (node int) (bound (productof (1 int) (2 int))) (hole int)
         (const (productof (1 string) (2 int) (3 string))) (sym symbol) (int int) (flag bool)))
(define-type rp-operands (listof rp-operand acyclic))
(define-type rp-node (productof (1 int) (2 symbol) (3 bool) (4 (listof symbol acyclic)) (5 rp-operands)))
(define-type rp-nodes (listof rp-node acyclic))

"A variable in scope where the walk is: its name, its binder's slot and its
 place there; a recursive type's (`%mu`) place -1, its name the node of the
 slot."
(define-datatype rpbind (rpbind string i64 i64))
(define-type rpbinds (listof rpbind acyclic))

"The export so far: the nodes made, newest first; the next slot; the holes'
 names, newest first; why a part of the type is no rep's (declined), the
 first found, or none."
"What the export knows of the program's types (C347): whether it has the
 checker's environment, which it then has, so as to make a datatype the
 sum it is and a generative type's definition (`gendef`); and the nodes
 it made of those, by a key, so that a recursive one is a cycle and each
 definition is made once."
(define-datatype rxenv (rxenv bool cv rpbinds))
(define rxenv-none rxenv (rxenv #f (cv nil nil nil nil "a type" nil "the program" 0 nil nil 0 (bempty) nil) nil))
(define-datatype rx (rx rp-nodes i64 strings string rxenv))
(define-datatype rxa (rxa rx rp-operand))
(define-datatype rxs (rxs rx rp-operands))
(define-datatype rxi (rxi rx i64))

(define rx-empty rx (rx nil 0 nil "" rxenv-none))
(define rx-in (subr kfx (cv) rx) (lambda (v) (rx nil 0 nil "" (rxenv #t v nil))))

(define rx-reserve (subr kfx (rx) rxi)
  (lambda (x) (tagcase x (rx (ns k hs d e) (rxi (rx ns (i64+ k 1) hs d e) k)))))

"A binder's name as written, as Fixpt's reps name binders (C346): kayak's
 marks of its kind, its place (`@P`) and its distinctness gone, which its
 binder node says; a spec's unnamed one empty."
(define rp-binder-written (subr kfx (string) string)
  (lambda (b)
    (cond ((string=? b "%none") "")
          ((or (has-suffix? b "%p") (has-suffix? b "%d")) (written-binder (list->string (reverse (cdr (cdr (reverse (string-chars b))))))))
          (else (written-binder b)))))

(define rx-fill (subr kfx (rx i64 string bool strings rp-operands) rx)
  (lambda (x slot head set binders args)
    (tagcase x
      (rx (ns k hs d e)
        (rx (cons (product (1 (i64->int slot)) (2 (string->symbol head)) (3 set) (4 (map (lambda ((b string)) (string->symbol (rp-binder-written b))) binders)) (5 args)) ns)
            k hs d e)))))

(define rx-declined (subr kfx (rx string) rx)
  (lambda (x why) (tagcase x (rx (ns k hs d e) (rx ns k hs (if (string=? d "") why d) e)))))

(define rx-node (subr kfx (rx string bool rp-operands) rxa)
  (lambda (x head set args)
    "A node of no binders, as an operand."
    (tagcase (rx-reserve x)
      (rxi (x slot) (rxa (rx-fill x slot head set nil args) (the rp-operand (sum node (i64->int slot))))))))

(define rx-sym (subr kfx (string) rp-operand)
  (lambda (s) (the rp-operand (sum sym (string->symbol s)))))

(define-rec
  (index-from-end (subr kfx (strings string i64) i64)
    (lambda (xs n i)
      "`n`'s place in `xs`, which is newest first, counted from its oldest; -1."
      (cond ((null? xs) -1) ((string=? (car xs) n) (i64- (size xs) 1)) (else (index-from-end (cdr xs) n i))))))

(define-rec
  (rx-bases (subr kfx (rx strings) rxs)
    (lambda (x ns)
      (if (null? ns)
          (rxs x nil)
          (tagcase (rx-node x "base" #f (the rp-operands (list (rx-sym (car ns)))))
            (rxa (x b) (tagcase (rx-bases x (cdr ns)) (rxs (x bs) (rxs x (cons b bs))))))))))

"`datum` (C346), as Fixpt's standard abbreviation of it is: the union of
 the base types a datum may be and an acyclic pair of datums, at `slot`."
(define rx-datum (subr kfx (rx i64) rx)
  (lambda (x slot)
    (tagcase (rx-bases x (list "int" "f64" "char" "bool" "string" "symbol" "keyword"))
      (rxs (x as1)
        (tagcase (rx-node x "frozen" #f (the rp-operands (list (the rp-operand (sum flag #t)))))
          (rxa (x fr)
            (tagcase (rx-node x "pairof" #f (the rp-operands (list (the rp-operand (sum node (i64->int slot))) (the rp-operand (sum node (i64->int slot))) fr (the rp-operand (sum flag #t)))))
              (rxa (x p)
                (tagcase (rx-bases x (list "vector" "bytevector"))
                  (rxs (x as2) (rx-fill x slot "oneof" #f (the strings nil) (onto as1 (cons p as2)))))))))))))

(define rx-hole (subr kfx (rx string) rxa)
  (lambda (x n)
    "A variable free in the type: a hole, one for each name."
    (tagcase x
      (rx (ns k hs d e)
        (let ((at (index-from-end hs n 0)))
          (if (i64>= at 0)
              (rxa x (the rp-operand (sum hole (i64->int at))))
              (rxa (rx ns k (cons n hs) d e) (the rp-operand (sum hole (i64->int (size hs)))))))))))

(define-rec
  (scope-var (subr kfx (rpbinds string) rpbinds)
    (lambda (sc n)
      (cond ((null? sc) nil)
            ((tagcase (car sc) (rpbind (m slot pos) (string=? m n))) (list (car sc)))
            (else (scope-var (cdr sc) n))))))

(define rx-var (subr kfx (rx rpbinds string) rxa)
  (lambda (x sc n)
    "Variable `n`: bound, by its binder and place; a recursive type's, its
     node; else a hole."
    (let ((found (scope-var sc n)))
      (if (null? found)
          (rx-hole x n)
          (tagcase (car found)
            (rpbind (m slot pos)
              (if (i64< pos 0)
                  (rxa x (the rp-operand (sum node (i64->int slot))))
                  (rxa x (the rp-operand (sum bound (product (1 (i64->int slot)) (2 (i64->int pos)))))))))))))

(define rx-var-ty (subr kfx (rx rpbinds string) rxa)
  (lambda (x sc n)
    "Variable `n` standing as a type: the `var` node over it, as both of
     Fixpt's checkers write one (`reps.rs`, `check-reps.fx`; C346), so that
     a filled hole's node is its filler; a recursive type's variable, its
     node itself."
    (tagcase (rx-var x sc n)
      (rxa (x a)
        (tagcase a
          (node k (rxa x a))
          (else other (rx-node x "var" #f (the rp-operands (list a)))))))))

"Regions, as `reps.rs` writes them: `(rconst a)`, `@heap` too, as
 Fixpt reads a written `@heap` (C346); `(heap)`, the heap's place, `heap`
 (C348); `(frozen acyclic? [place])`, `(global g)`, `(globals)`, or a
 variable."
(define rx-region-named (subr kfx (rx rpbinds string) rxa)
  (lambda (x sc r)
    (cond ((string=? r "heap") (rx-node x "heap" #f (the rp-operands nil)))
          ((string=? r "acyclic") (rx-node x "frozen" #f (the rp-operands (list (the rp-operand (sum flag #t))))))
          ((string=? r "const") (rx-node x "frozen" #f (the rp-operands (list (the rp-operand (sum flag #f))))))
          ((frozen-place? r)
           (tagcase (rx-var x sc (frozen-place-of r))
             (rxa (x p) (rx-node x "frozen" #f (the rp-operands (list (the rp-operand (sum flag (string=? (frozen-place-kind r) "acyclic"))) p))))))
          ((or (has-prefix? r "'") (has-prefix? r "?")) (rx-var x sc r))
          (else (rx-node x "rconst" #f (the rp-operands (list (rx-sym r))))))))

(define rx-region (subr kfx (st rx rpbinds ty) rxa)
  (lambda (s x sc r)
    (tagcase (walk s r)
      (ty-meta (k) (rxa (rx-declined x "a region not solved") (rx-sym "?")))
      (else other (rx-region-named x sc (region-string s other))))))

"An effect: a set of its atoms (`reps.rs`), in no order of the checker's."
(define rx-atom (subr kfx (rx rpbinds string) rxa)
  (lambda (x sc a)
    (cond ((string=? a "spin") (rx-node x "spin" #f (the rp-operands nil)))
          ((string=? a "nondet") (rx-node x "nondet" #f (the rp-operands nil)))
          ((string=? a "stage") (rx-node x "stage" #f (the rp-operands nil)))
          ((string=? a "@globals") (tagcase (rx-node x "globals" #f (the rp-operands nil)) (rxa (x g) (rx-node x "read" #f (the rp-operands (list g))))))
          ((global-atom? a)
           (tagcase (rx-node x "global" #f (the rp-operands (list (rx-sym (after-prefix a "g:"))))) (rxa (x g) (rx-node x "read" #f (the rp-operands (list g))))))
          ((has-prefix? a "io:") (rx-node x "io" #f (the rp-operands (list (rx-sym (after-prefix a "io:"))))))
          ((region-atom? a)
           (let ((kind (atom-kind a)))
             (tagcase (rx-region-named x sc (atom-region a))
               (rxa (x r) (rx-node x (substring-of kind (i64- (string-length-i64 kind) 1)) #f (the rp-operands (list r)))))))
          ((and (has-prefix? a "~") (not (has-prefix? a "~@")) (not (string=? a "~!"))) (rx-var x sc a))
          (else (rxa (rx-declined x (string-append "the atom " a)) (rx-sym "?"))))))

(define-rec
  (rx-atoms (subr kfx (rx rpbinds strings) rxs)
    (lambda (x sc es)
      (if (null? es)
          (rxs x nil)
          (tagcase (rx-atom x sc (car es))
            (rxa (x a) (tagcase (rx-atoms x sc (cdr es)) (rxs (x as) (rxs x (cons a as))))))))))

(define rx-effect (subr kfx (rx rpbinds strings) rxa)
  (lambda (x sc es) (tagcase (rx-atoms x sc es) (rxs (x as) (rx-node x "effect" #t as)))))

(define rp-nil-or-pair (subr kfx (st tys) bool)
  (lambda (s ms)
    "Whether union members `ms` are `nil` and a `%pairof`, in either order."
    (let ((nil? (lambda ((t ty)) (tagcase (walk s t) (ty-data (n as) (and (string=? n "nil") (null? as))) (else other #f))))
          (pair? (lambda ((t ty)) (tagcase (walk s t) (ty-data (n as) (and (string=? n "%pairof") (i64= (size as) 3))) (else other #f)))))
      (or (and (nil? (car ms)) (pair? (car (cdr ms)))) (and (pair? (car ms)) (nil? (car (cdr ms))))))))

(define base-type-names strings
  (list "symbol" "keyword" "datum" "vector" "f32" "i8" "u8" "i16" "u16" "i32" "u32" "u64"))

(define-rec
  (binders-in (subr kfx (rpbinds strings i64 i64) rpbinds)
    (lambda (sc ns slot pos)
      "Binders `ns` of node `slot` in scope, from place `pos`."
      (if (null? ns) sc (binders-in (cons (rpbind (car ns) slot pos) sc) (cdr ns) slot (i64+ pos 1))))))

"A kind's node (C347): `(type)`, `(region)` …; an arrow kind, as kayak
 spells one, `(=> (K …) R)`, Fixpt's `(=> K … R)`."
(define-rec
  (rx-kind-sexp (subr kfx (rx sexp) rxa)
    (lambda (x k)
      (tagcase k
        (lst (xs f l p)
          (if (and (i64= (size xs) 3) (sym-is? (car xs) "=>"))
              (tagcase (rx-kind-sexps x (onto (items (second xs)) (list (third xs))))
                (rxs (x ks) (rx-node x "=>" #f ks)))
              (rx-node x "?" #f (the rp-operands nil))))
        (sym (n f p) (rx-node x n #f (the rp-operands nil)))
        (else other (rx-node x "?" #f (the rp-operands nil))))))
  (rx-kind-sexps (subr kfx (rx sexps) rxs)
    (lambda (x ks)
      (if (null? ks)
          (rxs x nil)
          (tagcase (rx-kind-sexp x (car ks)) (rxa (x k) (tagcase (rx-kind-sexps x (cdr ks)) (rxs (x rest) (rxs x (cons k rest))))))))))
(define rx-kind-node (subr kfx (rx string) rxa)
  (lambda (x kind)
    (if (has-prefix? kind "(")
        (let ((forms (read-all (string-chars kind) "" 1))) (if (null? forms) (rx-node x "?" #f (the rp-operands nil)) (rx-kind-sexp x (car forms))))
        (rx-node x kind #f (the rp-operands nil)))))

(define-rec
  (rx-binder-nodes (subr kfx (rx strings) rxs)
    (lambda (x ns)
      "Each binder's node: `(binder KIND distinct)`."
      (if (null? ns)
          (rxs x nil)
          (tagcase (rx-kind-node x (if (and (has-prefix? (car ns) "'") (has-suffix? (car ns) "%p")) "place" (binder-kind (car ns))))
            (rxa (x k)
              (tagcase (rx-node x "binder" #f (the rp-operands (list k (the rp-operand (sum flag (has-suffix? (car ns) "%d"))))))
                (rxa (x b) (tagcase (rx-binder-nodes x (cdr ns)) (rxs (x bs) (rxs x (cons b bs))))))))))))

(define-rec
  (rx-kind-binders (subr kfx (rx strings) rxs)
    (lambda (x ks)
      "A binder node of each kind, `(binder (KIND) #f)`, as a `gendef`'s."
      (if (null? ks)
          (rxs x nil)
          (tagcase (rx-kind-node x (car ks))
            (rxa (x k)
              (tagcase (rx-node x "binder" #f (the rp-operands (list k (the rp-operand (sum flag #f)))))
                (rxa (x b) (tagcase (rx-kind-binders x (cdr ks)) (rxs (x bs) (rxs x (cons b bs))))))))))))

"A module type's descriptions, in the order written (C315): a type's,
 `%desc d`, and an effect's, `%edesc e`, the latter a description function
 giving it (`%effdesc`)."
(define desc-of? (subr kfx (ty) bool)
  (lambda (it) (tagcase it (ty-data (k as) (or (has-prefix? k "%desc ") (has-prefix? k "%edesc "))) (else other #f))))

(define desc-labels (subr kfx (tys) strings)
  (lambda (items)
    (map (lambda ((it ty)) (tagcase it (ty-data (k as) (if (has-prefix? k "%desc ") (after-prefix k "%desc ") (after-prefix k "%edesc "))) (else other "?")))
         (filter desc-of? items))))

(define desc-types (subr kfx (tys) tys)
  (lambda (items)
    (map (lambda ((it ty)) (tagcase it (ty-data (k as) (if (has-prefix? k "%desc ") (car as) (ty-data "%effdesc" (list (car as))))) (else other (ty-void))))
         (filter desc-of? items))))

"kayak's types that are Fixpt's generative types (C301): each a named
 constant applied to descriptions, as a datatype is."
(define rp-generative-heads strings (list "%addr" "%inbox" "%blobref" "%stringof" "%bytes" "%eqtable" "%identity" "%escape-tag"))
"Fixpt's standard generative types, in its numbering (`check.rs`): a
 constant's key is made of its name and its number there (C303)."
(define rp-standard-generatives strings
  (list "vsubr" "flatlayout" "flatarrayof" "identity" "eqtable" "blobref" "flat-arrayof" "flat-keyed"
        "bytevectorof" "escape-tag" "addr" "inbox" "process" "event" "stringof" "sessionof" "pending"
        "effectrep" "regionrep" "typerep" "effectbound" "typebound"))
(define-rec
  (rp-index-of (subr kfx (strings string i64) i64)
    (lambda (xs n i) (cond ((null? xs) 0) ((string=? (car xs) n) i) (else (rp-index-of (cdr xs) n (i64+ i 1)))))))
(define rp-const (subr kfx (string i64) rp-operand)
  (lambda (name arity)
    "The constant of generative type `name`, of `arity` parameters."
    (the rp-operand (sum const (product (1 name) (2 (i64->int (rp-index-of rp-standard-generatives name 0)))
                                        (3 (if (i64= arity 0) "type" (string-append "generative/" (i64->string arity)))))))))

(define rp-generative-name (subr kfx (string) string)
  (lambda (d) (if (string=? d "%bytes") "bytevectorof" (after-prefix d "%"))))
(define rp-generative-head (subr kfx (string) string)
  (lambda (n) (if (string=? n "bytevectorof") "%bytes" (string-append "%" n))))

"The environment's memo (C347): the node made for `key`, or -1; and one
 noted."
(define rx-memo (subr kfx (rx string) i64)
  (lambda (x key)
    (tagcase x
      (rx (ns k hs d e)
        (tagcase e
          (rxenv (on v ms) (let ((f (scope-var ms key))) (if (null? f) -1 (tagcase (car f) (rpbind (m slot pos) slot))))))))))
(define rx-memo-put (subr kfx (rx string i64) rx)
  (lambda (x key slot)
    (tagcase x (rx (ns k hs d e) (tagcase e (rxenv (on v ms) (rx ns k hs d (rxenv on v (cons (rpbind key slot 0) ms)))))))))
(define rx-cv (subr kfx (rx) (listof cv acyclic))
  (lambda (x) (tagcase x (rx (ns k hs d e) (tagcase e (rxenv (on v ms) (if on (list v) nil)))))))

(define-rec
  (rp-dt-named (subr kfx (dts string) (listof dt acyclic))
    (lambda (ds n)
      (cond ((null? ds) nil)
            ((tagcase (car ds) (dt (m ps vs) (string=? m n))) (list (car ds)))
            (else (rp-dt-named (cdr ds) n))))))
(define rp-dts (subr kfx (cv) dts) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at ix mk) ds))))

"Datatype `d`, a `define-datatype`'s, if the export has the environment
 and `args` are its parameters' many: FX-26's datatype is a `define-type`
 of a sum, which is what Fixpt's rep of it is (C347)."
(define rp-datatype (subr kfx (rx string tys) (listof dt acyclic))
  (lambda (x d args)
    (let ((vs (rx-cv x)))
      (if (null? vs)
          nil
          (let ((f (rp-dt-named (rp-dts (car vs)) d)))
            (if (and (not (null? f)) (tagcase (car f) (dt (m ps vts) (and (not (null? vts)) (i64= (size ps) (size args))))))
                f
                nil))))))
(define-rec
  (rp-labels (subr kfx (i64 i64) strings)
    (lambda (i n) (if (i64> i n) nil (cons (i64->string i) (rp-labels (i64+ i 1) n))))))
(define rp-datatype-sum (subr kfx (dt tys) ty)
  (lambda (d args)
    "Datatype `d` applied to `args`: a sum of its variants, each a product
     of its fields, labelled from 1."
    (tagcase d
      (dt (n ps vs)
        (reduced
         (substitute ps args
          (ty-shape #f (map (lambda ((v variant)) (tagcase v (variant (tag ts) tag))) vs)
                    (map (lambda ((v variant)) (tagcase v (variant (tag ts) (ty-shape #t (rp-labels 1 (size ts)) ts)))) vs))))))))

"A generative type's definition, as Fixpt's `gendef` has it (C347): its
 parameters as kayak's checker names them, their kinds, their variances
 (`+`, `-`, `=`), and its representation, a type naming the parameters.
 Fixpt's standard ones from their declarations (`check.rs`, `VSUBR` …
 `TYPEBOUND`, in `rp-standard-generatives`' order), read as kayak reads a
 type; a program's from its checker's own: its parameters, its marks
 (`%variance NAME`) and the representation `up-NAME` takes."
(define-datatype gdecl (gdecl strings strings strings ty))
"fixpt-source: crates/fixpt-fx26/src/check.rs@1311497"
(define rp-generative-decls strings
  (list "(vsubr (e effect +) (t type -) (r type +)) (subr e ((listof t acyclic)) r)"
        "(flatlayout (t type)) int"
        "(flatarrayof (t type) (r region)) (arrayof t r)"
        "(identity (k type) (r region)) int"
        "(eqtable (k type) (v type) (kr region) (r region)) (arrayof (pairof k v r) r)"
        "(blobref (b type +) (f flat)) b"
        "(flat-arrayof (f flat) (n size)) int"
        "(flat-keyed (w size) (s flat)) int"
        "(bytevectorof (r region)) (arrayof u8 r)"
        "(escape-tag (a type) (h type) (r region)) (prompt-tag a h pure r)"
        "(addr (m type) (r region)) (ref m r)"
        "(inbox (m type) (r region)) (ref m r)"
        "(process (m type) (e effect +)) (poly ((r place)) (subr e ((inbox m r) (place r)) unit))"
        "(event (e effect +)) (subr e () bool)"
        "(stringof (r region)) (arrayof char r)"
        "(sessionof (m type) (r region)) (ref m r)"
        "(pending (e effect +) (r region)) (subr (maxeff e (read r)) () unit)"
        "(effectrep (e effect)) string"
        "(regionrep (r region)) string"
        "(typerep (t type)) string"
        "(effectbound (e effect +)) string"
        "(typebound (t type +)) string"))

(define-rec
  (rp-nth-string (subr kfx (strings i64) string)
    (lambda (xs k) (cond ((null? xs) "?") ((i64= k 0) (car xs)) (else (rp-nth-string (cdr xs) (i64- k 1)))))))

(define rp-standard-gdecl (subr kfx (cv string) (listof gdecl acyclic))
  (lambda (v n)
    (if (not (string-member? n rp-standard-generatives))
        nil
        (let* ((forms (read-all (string-chars (rp-nth-string rp-generative-decls (rp-index-of rp-standard-generatives n 0))) "" 1))
               (ps (cdr (items (car forms))))
               (names (map (lambda ((p sexp)) (sym-name (car (items p)))) ps))
               (kinds (map (lambda ((p sexp)) (sym-name (second (items p)))) ps))
               (marks (map (lambda ((p sexp)) (if (i64= (size (items p)) 3) (sym-name (third (items p))) "=")) ps))
               (spelt (map2 (lambda ((k string) (m string)) (binder-named k m)) kinds names))
               (places (concat (map2 (lambda ((k string) (m string)) (if (string=? k "place") (the strings (list (string-append "%place " m))) nil)) kinds spelt))))
          (list (gdecl spelt kinds marks (parse-type v (onto places spelt) (second forms))))))))

(define rp-program-gdecl (subr kfx (cv string) (listof gdecl acyclic))
  (lambda (v n)
    (let ((f (rp-dt-named (rp-dts v) n)) (up (scope-bind (string-append "up-" n) v)))
      (if (or (null? f) (null? up) (tagcase (car f) (dt (m ps vs) (not (null? vs)))))
          nil
          (tagcase (car up)
            (bind (b sc w)
              (tagcase sc
                (scheme (ps t)
                  (tagcase t
                    (ty-proc (es rs r)
                      (let ((marks (variance-marks v n)))
                        (list (gdecl ps (map binder-kind ps) (if (null? marks) (map (lambda ((p string)) "=") ps) marks) (car rs)))))
                    (else other nil))))))))))

"A program's generative type's number, as Fixpt's: after the standard
 ones, in the order defined (the environment's datatypes are newest
 first)."
(define-rec
  (rp-program-index (subr kfx (dts string i64) i64)
    (lambda (ds n k)
      "Generative types defined before `n`, from `ds` on, plus `k`."
      (cond ((null? ds) k)
            ((tagcase (car ds) (dt (m ps vs) (string=? m n))) (i64+ k (rp-program-count (cdr ds) 0)))
            (else (rp-program-index (cdr ds) n k)))))
  (rp-program-count (subr kfx (dts i64) i64)
    (lambda (ds k)
      (if (null? ds) k (rp-program-count (cdr ds) (if (tagcase (car ds) (dt (m ps vs) (and (null? vs) (not (string-member? m rp-standard-generatives))))) (i64+ k 1) k))))))

(define rp-generative-index (subr kfx (rx string) i64)
  (lambda (x n)
    (cond ((string-member? n rp-standard-generatives) (rp-index-of rp-standard-generatives n 0))
          ((null? (rx-cv x)) 0)
          (else (rp-program-index (rp-dts (car (rx-cv x))) n (size rp-standard-generatives))))))

(define rp-const-at (subr kfx (string i64 i64) rp-operand)
  (lambda (name index arity)
    (the rp-operand (sum const (product (1 name) (2 (i64->int index))
                                        (3 (if (i64= arity 0) "type" (string-append "generative/" (i64->string arity)))))))))

"Fixpt's shapes, by number (`check.rs`'s `SHAPES`), and its relations'
 names (`Rel`), for specifications (C303)."
(define rp-shapes strings
  (list "int" "f64" "f32" "char" "bool" "nil" "pair" "string" "symbol" "procedure" "bloblet" "box" "sum" "product"
        "vector" "bytevector" "keyword"))
(define rp-rels strings (list "lt" "le" "eq" "ne"))
(define sexp-int (subr kfx (sexp) i64) (lambda (e) (tagcase e (num (k f p) k) (else other -1))))

(define rp-key-width (subr kfx (ty) i64)
  (lambda (k)
    "A flat sum's key's width in bytes, as Fixpt's `k-key-width`."
    (tagcase k (ty-rconst (n) (cond ((string=? n "u8") 1) ((string=? n "u16") 2) (else 4))) (else other 4))))
(define rp-key-of-width (subr kfx (i64) ty)
  (lambda (w) (ty-rconst (cond ((i64= w 1) "u8") ((i64= w 2) "u16") (else "u32")))))

(define rp-region-like? (subr kfx (st ty) bool)
  (lambda (s t)
    "Whether `t` is a region: a constant, a region variable (`'r`), frozen."
    (tagcase (walk s t)
      (ty-rconst (n) #t)
      (ty-var (n) (has-prefix? n "'"))
      (ty-data (d args) (string=? d "%frozen"))
      (else other #f))))

(define-rec
  (rx-sexps (subr kfx (rx sexps bool) rxs)
    (lambda (x es formula)
      "Formulas, or expressions, each its node."
      (if (null? es)
          (rxs x nil)
          (tagcase (if formula (rx-formula x (car es)) (rx-expr x (car es)))
            (rxa (x a) (tagcase (rx-sexps x (cdr es) formula) (rxs (x as) (rxs x (cons a as)))))))))
  (rx-formula (subr kfx (rx sexp) rxa)
    (lambda (x f)
      "A specification's formula, as Fixpt's `rp-formula` writes one."
      (let ((h (logic-head f)) (xs (tagcase f (lst (ys a b c) (if (null? ys) nil (cdr ys))) (else other nil))))
        (cond ((or (string=? h "true") (string=? h "false")) (rx-node x h #f (the rp-operands nil)))
              ((and (string=? h "rel") (i64= (size xs) 3))
               (tagcase (rx-sexps x (cdr xs) #f)
                 (rxs (x as) (rx-node x "rel" #f (cons (rx-sym (rp-nth-string rp-rels (sexp-int (car xs)))) as)))))
              ((and (string=? h "holds") (i64= (size xs) 1))
               (tagcase (rx-named x (car xs)) (rxa (x a) (rx-node x "holds" #f (the rp-operands (list a))))))
              ((or (string=? h "not") (string=? h "and") (string=? h "or") (string=? h "implies"))
               (tagcase (rx-sexps x xs #t) (rxs (x as) (rx-node x h #f as))))
              (else (rxa (rx-declined x (string-append "the formula " (show-sexp f))) (rx-sym "?")))))))
  (rx-expr (subr kfx (rx sexp) rxa)
    (lambda (x e)
      "An expression: arithmetic, or a name, as `(atom …)`."
      (let ((h (logic-head e)) (xs (tagcase e (lst (ys a b c) (if (null? ys) nil (cdr ys))) (else other nil))))
        (cond ((and (string=? h "lit") (i64= (size xs) 1)) (rx-node x "lit" #f (the rp-operands (list (the rp-operand (sum int (i64->int (sexp-int (car xs)))))))))
              ((or (string=? h "add") (string=? h "sub") (string=? h "mul"))
               (tagcase (rx-sexps x xs #f) (rxs (x as) (rx-node x h #f as))))
              (else (tagcase (rx-named x e) (rxa (x a) (rx-node x "atom" #f (the rp-operands (list a))))))))))
  (rx-named (subr kfx (rx sexp) rxa)
    (lambda (x e)
      "A name a formula is about: a parameter, the result, a length, a shape,
       acyclicity, a `nat`, a length's, a logic function's call."
      (let* ((h (logic-head e)) (xs (tagcase e (lst (ys a b c) (if (null? ys) nil (cdr ys))) (else other nil)))
             (ints (lambda ((head string)) (rx-node x head #f (map (lambda ((y sexp)) (the rp-operand (sum int (i64->int (sexp-int y))))) xs)))))
        (cond ((string=? h "p") (ints "param"))
              ((string=? h "res") (rx-node x "result" #f (the rp-operands nil)))
              ((string=? h "len") (ints "length"))
              ((string=? h "acyclic") (ints "acyclic"))
              ((string=? h "natp") (ints "nat"))
              ((string=? h "length-is") (ints "length-is"))
              ((and (string=? h "shape") (i64= (size xs) 2))
               (rx-node x "shape" #f (the rp-operands (list (the rp-operand (sum int (i64->int (sexp-int (car xs)))))
                                                            (the rp-operand (sum int (i64->int (rp-index-of rp-shapes (sym-name (car (cdr xs))) 0))))))))
              ((and (string=? h "call") (not (null? xs)))
               (tagcase (rx-sexps x (cdr xs) #f) (rxs (x as) (rx-node x "call" #f (cons (rx-sym (sym-name (car xs))) as)))))
              (else (rxa (rx-declined x (string-append "the name " (show-sexp e))) (rx-sym "?"))))))))

"A specification as a node: `(spec {p … r} requires ensures)`, its names
 its binders (Fixpt's `rp-spec`)."
(define rx-spec (subr kfx (rx string) rxa)
  (lambda (x d)
    (let ((ps (spec-parts d)))
      (tagcase (rx-reserve x)
        (rxi (x slot)
          (tagcase (rx-formula x (car (cdr (cdr (cdr ps)))))
            (rxa (x req)
              (tagcase (rx-formula x (car (cdr (cdr (cdr (cdr ps))))))
                (rxa (x ens)
                  (rxa (rx-fill x slot "spec" #f (onto (map show-sexp (items (second ps))) (list (show-sexp (third ps)))) (the rp-operands (list req ens)))
                       (the rp-operand (sum node (i64->int slot)))))))))))))

(define-rec
  (rx-ty (subr kfx (st rx rpbinds ty) rxa)
    (lambda (s x sc t)
      "Type `t`'s node, as an operand."
      (tagcase (walk s t)
        (ty-var (n) (rx-var-ty x sc n))
        (ty-meta (k) (rxa (rx-declined x "a type not solved") (rx-sym "?")))
        (ty-data (d args)
          (cond ((has-prefix? d "%named ") (rx-ty s x sc (car args)))
                ((and (null? args) (not (null? (scope-var sc d))))
                 "A module type's abstract type, bound by its `moduleof`."
                 (rx-var-ty x sc d))
                ((not (null? (rp-datatype x d args))) (rx-datatype s x sc (car (rp-datatype x d args)) args))
                (else
              (tagcase (rx-reserve x) (rxi (x slot) (rxa (rx-ty-at s x sc (walk s t) slot) (the rp-operand (sum node (i64->int slot)))))))))
        (else other (tagcase (rx-reserve x) (rxi (x slot) (rxa (rx-ty-at s x sc other slot) (the rp-operand (sum node (i64->int slot))))))))))
  (rx-datatype (subr kfx (st rx rpbinds dt tys) rxa)
    (lambda (s x sc d args)
      "Datatype `d` applied to `args`, the sum it is (C347): a node of its
       own, made once for each application, so that a recursive one is a
       cycle."
      (let* ((key (string-append "%dt " (show-ty s (ty-data (tagcase d (dt (n ps vs) n)) args)))) (at (rx-memo x key)))
        (if (i64>= at 0)
            (rxa x (the rp-operand (sum node (i64->int at))))
            (tagcase (rx-reserve x)
              (rxi (x slot)
                (rxa (rx-ty-at s (rx-memo-put x key slot) sc (rp-datatype-sum d args) slot) (the rp-operand (sum node (i64->int slot))))))))))
  (rx-generative (subr kfx (st rx rpbinds string i64 rp-operands i64) rx)
    (lambda (s x sc n arity ds slot)
      "Generative type `n` applied to descriptions `ds`, at `slot`: `(named
       <n KIND key> DEF d …)`, its definition `DEF` where the export has it
       (C347), its key Fixpt's number of it."
      (tagcase (rx-gendef s x n)
        (rxs (x def) (rx-fill x slot "named" #f (the strings nil) (cons (rp-const-at n (rp-generative-index x n) arity) (onto def ds)))))))
  (rx-gendef (subr kfx (st rx string) rxs)
    (lambda (s x n)
      "Generative type `n`'s `(gendef {params} binder… (variances v…) rep)`,
       made once, as an operand list of one; none where the export has no
       environment or no definition of it."
      (let* ((key (string-append "%gendef " n)) (at (rx-memo x key)) (vs (rx-cv x)))
        (cond ((i64>= at 0) (rxs x (the rp-operands (list (the rp-operand (sum node (i64->int at)))))))
              ((null? vs) (rxs x nil))
              (else
                (let ((g (let ((std (rp-standard-gdecl (car vs) n))) (if (null? std) (rp-program-gdecl (car vs) n) std))))
                  (if (null? g)
                      (rxs x nil)
                      (tagcase (car g)
                        (gdecl (ns ks ms rep)
                          (tagcase (rx-reserve x)
                            (rxi (x slot)
                              (tagcase (rx-kind-binders (rx-memo-put x key slot) ks)
                                (rxs (x bs)
                                  (tagcase (rx-node x "variances" #f (map rx-sym ms))
                                    (rxa (x vn)
                                      (tagcase (rx-ty s x (binders-in nil ns slot 0) rep)
                                        (rxa (x r)
                                          (rxs (rx-fill x slot "gendef" #f ns (onto bs (the rp-operands (list vn r))))
                                               (the rp-operands (list (the rp-operand (sum node (i64->int slot)))))))))))))))))))))))
  (rx-tys (subr kfx (st rx rpbinds tys) rxs)
    (lambda (s x sc ts)
      (if (null? ts)
          (rxs x nil)
          (tagcase (rx-ty s x sc (car ts))
            (rxa (x a) (tagcase (rx-tys s x sc (cdr ts)) (rxs (x as) (rxs x (cons a as)))))))))
  (rx-descs (subr kfx (st rx rpbinds tys) rxs)
    (lambda (s x sc ts)
      "A named type's arguments as descriptions: `(d-region R)`, `(d-type T)`."
      (if (null? ts)
          (rxs x nil)
          (tagcase (if (rp-region-like? s (car ts)) (rx-region s x sc (car ts)) (rx-ty s x sc (car ts)))
            (rxa (x a)
              (tagcase (rx-node x (cond ((rp-region-like? s (car ts)) "d-region")
                                        ;; A type function given, Fixpt's `D::Fun` (C347).
                                        ((tagcase (walk s (car ts)) (ty-data (n as) (string=? n "%dlambda")) (else other #f)) "d-fun")
                                        (else "d-type"))
                                 #f (the rp-operands (list a)))
                (rxa (x d) (tagcase (rx-descs s x sc (cdr ts)) (rxs (x ds) (rxs x (cons d ds)))))))))))
  (rx-moduleof (subr kfx (st rx rpbinds tys i64) rx)
    (lambda (s x sc items slot)
      "`(moduleof {t …} (binder type) … (descs d T …) (vals x T …))` at `slot`,
       its abstract types bound there."
      (let* ((abs (filter (lambda ((it ty)) (tagcase it (ty-data (k as) (has-prefix? k "%abs ")) (else other #f))) items))
             (names (map (lambda ((it ty)) (tagcase it (ty-data (k as) (after-prefix k "%abs ")) (else other "?"))) abs))
             (consts (map (lambda ((it ty)) (tagcase it (ty-data (k as) (tagcase (car as) (ty-data (c bs) c) (else other "?"))) (else other "?"))) abs))
             (sc2 (binders-in sc consts slot 0))
             (part (lambda ((prefix string))
                     (filter (lambda ((it ty)) (tagcase it (ty-data (k as) (has-prefix? k prefix)) (else other #f))) items)))
             (labels (lambda ((its tys) (prefix string)) (map (lambda ((it ty)) (tagcase it (ty-data (k as) (after-prefix k prefix)) (else other "?"))) its)))
             (types (lambda ((its tys)) (map (lambda ((it ty)) (tagcase it (ty-data (k as) (car as)) (else other (ty-void)))) its))))
        (tagcase (rx-binder-nodes x (map (lambda ((n string)) n) names))
          (rxs (x bs)
            ;; Descriptions of types and of effects alike, in the order written
            ;; (C315), an effect's as a description function giving it.
            (tagcase (rx-parts s x sc2 (desc-labels items) (desc-types items))
              (rxs (x ds)
                (tagcase (rx-node x "descs" #f ds)
                  (rxa (x dn)
                    (tagcase (rx-parts s x sc2 (labels (part "%val ") "%val ") (types (part "%val ")))
                      (rxs (x vs)
                        (tagcase (rx-node x "vals" #f vs)
                          (rxa (x vn) (rx-fill x slot "moduleof" #f names (onto bs (the rp-operands (list dn vn)))))))))))))))))
  (rx-size (subr kfx (st rx rpbinds ty) rxa)
    (lambda (s x sc z)
      "A size: `(finite)`, or `(lin k (&terms (term v c) …))`, its terms a set."
      (let ((l (size-lin s z)))
        (if (null? l)
            (rx-node x "finite" #f (the rp-operands nil))
            (tagcase (car l)
              (lin (k ts)
                (tagcase (rx-terms x sc ts)
                  (rxs (x as)
                    (tagcase (rx-node x "terms" #t as)
                      (rxa (x tn) (rx-node x "lin" #f (the rp-operands (list (the rp-operand (sum int (i64->int k))) tn)))))))))))))
  (rx-terms (subr kfx (rx rpbinds (listof lterm acyclic)) rxs)
    (lambda (x sc ts)
      (if (null? ts)
          (rxs x nil)
          (tagcase (car ts)
            (lterm (n c)
              (tagcase (if (has-prefix? n "?") (rxa (rx-declined x "a size not solved") (rx-sym "?")) (rx-var x sc n))
                (rxa (x v)
                  (tagcase (rx-node x "term" #f (the rp-operands (list v (the rp-operand (sum int (i64->int c))))))
                    (rxa (x t) (tagcase (rx-terms x sc (cdr ts)) (rxs (x as) (rxs x (cons t as)))))))))))))
  (rx-parts (subr kfx (st rx rpbinds strings tys) rxs)
    (lambda (s x sc ls ts)
      "A product's or sum's parts: each label, then its type."
      (if (or (null? ls) (null? ts))
          (rxs x nil)
          (tagcase (rx-ty s x sc (car ts))
            (rxa (x a) (tagcase (rx-parts s x sc (cdr ls) (cdr ts)) (rxs (x as) (rxs x (cons (rx-sym (car ls)) (cons a as))))))))))
  (rx-subr (subr kfx (st rx rpbinds string strings tys ty i64) rx)
    (lambda (s x sc conv es ps r slot) (rx-subr-spec s x sc conv es ps r slot "")))
  (rx-subr-spec (subr kfx (st rx rpbinds string strings tys ty i64 string) rx)
    (lambda (s x sc conv es ps r slot spec)
      "`(subr C E (params P …) R)` at `slot`."
      (tagcase (rx-node x conv #f (the rp-operands nil))
        (rxa (x c)
          (tagcase (rx-effect x sc es)
            (rxa (x e)
              (tagcase (rx-tys s x sc ps)
                (rxs (x as)
                  (tagcase (rx-node x "params" #f as)
                    (rxa (x p)
                      (tagcase (rx-ty s x sc r)
                        (rxa (x q)
                          (if (string=? spec "")
                              (rx-fill x slot "subr" #f (the strings nil) (the rp-operands (list c e p q)))
                              (tagcase (rx-spec x spec)
                                (rxa (x sp) (rx-fill x slot "subr" #f (the strings nil) (the rp-operands (list c e p q sp))))))))))))))))))
  (rx-ty-at (subr kfx (st rx rpbinds ty i64) rx)
    (lambda (s x sc t slot)
      "Node `slot`, type `t`'s, filled. A datatype's or generative type's value is
       a constant by its name (kayak's key for now, C301), applied to its
       arguments; a part a rep does not take yet is declined."
      (let ((base (lambda ((n string)) (rx-fill x slot "base" #f (the strings nil) (the rp-operands (list (rx-sym n))))))
            (one (lambda ((head string) (args rp-operands)) (rx-fill x slot head #f (the strings nil) args))))
        (tagcase t
          (ty-int () (base "int"))
          (ty-i64 () (base "i64"))
          (ty-f64 () (base "f64"))
          (ty-bool () (base "bool"))
          (ty-char () (base "char"))
          (ty-unit () (base "unit"))
          (ty-string () (base "string"))
          (ty-void () (one "void" (the rp-operands nil)))
          (ty-nat () (tagcase (rx-node x "finite" #f (the rp-operands nil)) (rxa (x z) (rx-fill x slot "nat" #f (the strings nil) (the rp-operands (list z))))))
          (ty-proc (es ps r) (rx-subr s x sc "cellular" es ps r slot))
          (ty-flat (e r) (tagcase (rx-descs s x sc (list e r)) (rxs (x ds) (rx-generative s x sc "flatarrayof" 2 ds slot))))
          (ty-tag (a h es r) (tagcase (rx-ty s x sc a) (rxa (x a2) (tagcase (rx-ty s x sc h) (rxa (x h2) (tagcase (rx-effect x sc es) (rxa (x e2) (tagcase (rx-region s x sc r) (rxa (x r2) (rx-fill x slot "prompt-tag" #f (the strings nil) (the rp-operands (list a2 h2 e2 r2))))))))))))
          (ty-ref (a r) (tagcase (rx-ty s x sc a) (rxa (x a2) (tagcase (rx-region s x sc r) (rxa (x r2) (rx-fill x slot "ref" #f (the strings nil) (the rp-operands (list a2 r2))))))))
          (ty-list (e r) (tagcase (rx-ty s x sc e) (rxa (x e2) (tagcase (rx-region s x sc r) (rxa (x r2) (rx-fill x slot "pairof" #f (the strings nil) (the rp-operands (list e2 (the rp-operand (sum node (i64->int slot))) r2 (the rp-operand (sum flag #t))))))))))
          (ty-shape (p ls ts) (tagcase (rx-parts s x sc ls ts) (rxs (x as) (rx-fill x slot (if p "productof" "sumof") #f (the strings nil) as))))
          (ty-data (d args)
            (cond ((string=? d "nil") (one "nil" (the rp-operands nil)))
                  ((string=? d "false") (one "false" (the rp-operands nil)))
                  ((and (string=? d "datum") (null? args)) (rx-datum x slot))
                  ((string-member? d base-type-names) (base d))
                  ((and (string=? d "%union") (i64= (size args) 2) (rp-nil-or-pair s args))
                   "`nil` or a pair (C346): the pair that may be `nil`, `(pairof A B R
                    #t)`, as Fixpt makes such a union."
                   (let ((p (tagcase (walk s (car args)) (ty-data (n as) (if (string=? n "nil") (walk s (car (cdr args))) (walk s (car args)))) (else other (walk s (car args))))))
                     (tagcase p
                       (ty-data (n as)
                         (tagcase (rx-tys s x sc (list (car as) (car (cdr as))))
                           (rxs (x ab) (tagcase (rx-region s x sc (car (cdr (cdr as)))) (rxa (x r2) (rx-fill x slot "pairof" #f (the strings nil) (onto ab (the rp-operands (list r2 (the rp-operand (sum flag #t)))))))))))
                       (else other (rx-declined x "a union of nil and no pair")))))
                  ((string=? d "%union") (tagcase (rx-tys s x sc args) (rxs (x as) (rx-fill x slot "oneof" #f (the strings nil) as))))
                  ((and (string=? d "%pairof") (i64= (size args) 3)) (tagcase (rx-tys s x sc (list (car args) (car (cdr args)))) (rxs (x as) (tagcase (rx-region s x sc (car (cdr (cdr args)))) (rxa (x r2) (rx-fill x slot "pairof" #f (the strings nil) (onto as (the rp-operands (list r2 (the rp-operand (sum flag #f)))))))))))
                  ((and (string=? d "%mu") (i64= (size args) 2)) (tagcase (car args) (ty-var (n) (rx-ty-at s x (cons (rpbind n slot -1) sc) (walk s (car (cdr args))) slot)) (else other (rx-declined x "a part not a variable"))))
                  ((and (string=? d "%dlambda") (not (null? args)))
                   "A description function (C315): `(dlambda {x …} (binder k) … (d-type
                    T))`, its parameters bound there, as Fixpt's `Ty::Lam`."
                   (let* ((ns (poly-binders-of args)) (sc2 (binders-in sc ns slot 0)))
                     (tagcase (rx-binder-nodes x ns)
                       (rxs (x bs)
                         (tagcase (rx-ty s x sc2 (last args))
                           (rxa (x b)
                             (tagcase (rx-node x "d-type" #f (the rp-operands (list b)))
                               (rxa (x db) (rx-fill x slot "dlambda" #f ns (onto bs (the rp-operands (list db))))))))))))
                  ((and (string=? d "%effdesc") (i64= (size args) 1))
                   "A module's description of an effect (C315): a description function
                    of no parameters giving it, `(dlambda {} (d-effect E))`, as Fixpt's
                    `effect_desc`."
                   (tagcase (rx-effect x sc (tagcase (car args) (ty-proc (es ps r) es) (else other nil)))
                     (rxa (x e)
                       (tagcase (rx-node x "d-effect" #f (the rp-operands (list e)))
                         (rxa (x de) (rx-fill x slot "dlambda" #f (the strings nil) (the rp-operands (list de))))))))
                  ((and (string=? d "%poly") (not (null? args))) (let* ((ns (poly-binders-of args)) (sc2 (binders-in sc ns slot 0))) (tagcase (rx-binder-nodes x ns) (rxs (x bs) (tagcase (rx-ty s x sc2 (last args)) (rxa (x b) (rx-fill x slot "poly" #f ns (onto bs (the rp-operands (list b))))))))))
                  ((and (or (string=? d "%icell") (string=? d "%mark-key")) (i64= (size args) 2)) (tagcase (rx-ty s x sc (car args)) (rxa (x a2) (tagcase (rx-region s x sc (car (cdr args))) (rxa (x r2) (rx-fill x slot (after-prefix d "%") #f (the strings nil) (the rp-operands (list a2 r2))))))))
                  ((and (or (string=? d "%composable") (string=? d "%oneshot")) (i64= (size args) 4))
                   "A composable continuation (C346), `(composable T A D R once?)`, as
                    Fixpt's `Ty::Composable`: `oneshot`'s flag set."
                   (tagcase (rx-tys s x sc (list (car args) (car (cdr args))))
                     (rxs (x ta)
                       (tagcase (rx-effect x sc (tagcase (car (cdr (cdr args))) (ty-proc (es ps r) es) (else other nil)))
                         (rxa (x e2)
                           (tagcase (rx-region s x sc (car (cdr (cdr (cdr args)))))
                             (rxa (x r2)
                               (rx-fill x slot "composable" #f (the strings nil)
                                        (onto ta (the rp-operands (list e2 r2 (the rp-operand (sum flag (string=? d "%oneshot"))))))))))))))
                  ((and (string=? d "%place") (i64= (size args) 1)) (tagcase (rx-region s x sc (car args)) (rxa (x r2) (rx-fill x slot "place" #f (the strings nil) (the rp-operands (list r2))))))
                  ((and (string=? d "%array") (i64= (size args) 2)) (tagcase (rx-ty s x sc (car args)) (rxa (x a2) (tagcase (rx-node x "finite" #f (the rp-operands nil)) (rxa (x z) (tagcase (rx-region s x sc (car (cdr args))) (rxa (x r2) (rx-fill x slot "narrayof" #f (the strings nil) (the rp-operands (list a2 z r2))))))))))
                  ((and (or (string=? d "%cellular") (string=? d "%fx") (string=? d "%native")) (i64= (size args) 1)) (tagcase (walk s (car args)) (ty-proc (es ps r) (rx-subr s x sc (after-prefix d "%") es ps r slot)) (else other (rx-declined x "a part not a variable"))))
                  ((and (or (string=? d "%bloblet") (string=? d "%fbloblet")) (not (null? args))) (tagcase (rx-region s x sc (car args)) (rxa (x r2) (tagcase (rx-tys s x sc (cdr args)) (rxs (x fs) (rx-fill x slot "bloblet" #f (the strings nil) (cons (the rp-operand (sum flag (string=? d "%fbloblet"))) (cons r2 fs))))))))
                  ((and (string=? d "%natof") (i64= (size args) 1)) (tagcase (rx-size s x sc (car args)) (rxa (x z) (rx-fill x slot "nat" #f (the strings nil) (the rp-operands (list z))))))
                  ((and (string=? d "%nlist") (i64= (size args) 2)) (tagcase (rx-ty s x sc (car args)) (rxa (x a2) (tagcase (rx-size s x sc (car (cdr args))) (rxa (x z) (tagcase (rx-node x "frozen" #f (the rp-operands (list (the rp-operand (sum flag #t))))) (rxa (x r2) (rx-fill x slot "nlist" #f (the strings nil) (the rp-operands (list a2 z r2))))))))))
                  ((and (string=? d "%narray") (i64= (size args) 3)) (tagcase (rx-ty s x sc (car args)) (rxa (x a2) (tagcase (rx-size s x sc (car (cdr args))) (rxa (x z) (tagcase (rx-region s x sc (car (cdr (cdr args)))) (rxa (x r2) (rx-fill x slot "narrayof" #f (the strings nil) (the rp-operands (list a2 z r2))))))))))
                  ((and (string=? d "%flat-array") (i64= (size args) 2)) (tagcase (rx-ty s x sc (car args)) (rxa (x a2) (tagcase (rx-size s x sc (flat-length (car (cdr args)))) (rxa (x z) (tagcase (rx-node x "d-type" #f (the rp-operands (list a2))) (rxa (x da) (tagcase (rx-node x "d-size" #f (the rp-operands (list z))) (rxa (x dz) (rx-generative s x sc "flat-arrayof" 2 (the rp-operands (list da dz)) slot))))))))))
                  ((and (string=? d "%flat-sum") (not (null? args)) (unkeyed? args)) (tagcase (rx-parts s x sc (map (lambda ((f fvar)) (tagcase f (fvar (l t) l))) (fvars-of (cdr args))) (map (lambda ((f fvar)) (tagcase f (fvar (l t) t))) (fvars-of (cdr args)))) (rxs (x as) (rx-fill x slot "sumof" #f (the strings nil) as))))
                  ((and (string=? d "%flat-sum") (not (null? args))) (tagcase (rx-parts s x sc (map (lambda ((f fvar)) (tagcase f (fvar (l t) l))) (flat-sum-variants args)) (map (lambda ((f fvar)) (tagcase f (fvar (l t) t))) (flat-sum-variants args))) (rxs (x as) (tagcase (rx-node x "sumof" #f as) (rxa (x sm) (tagcase (rx-size s x sc (size-of-lin (lin (rp-key-width (car args)) nil))) (rxa (x z) (tagcase (rx-node x "d-size" #f (the rp-operands (list z))) (rxa (x dz) (tagcase (rx-node x "d-type" #f (the rp-operands (list sm))) (rxa (x dsm) (rx-generative s x sc "flat-keyed" 2 (the rp-operands (list dz dsm)) slot))))))))))))
                  ((and (string=? d "%vsubr") (i64= (size args) 3)) (tagcase (rx-effect x sc (tagcase (car args) (ty-proc (es ps r) es) (else other nil))) (rxa (x e) (tagcase (rx-node x "d-effect" #f (the rp-operands (list e))) (rxa (x de) (tagcase (rx-descs s x sc (cdr args)) (rxs (x ds) (rx-generative s x sc "vsubr" 3 (cons de ds) slot))))))))
                  ((and (has-prefix? d "%spec ") (not (null? args))) (tagcase (walk s (car args)) (ty-proc (es ps r) (rx-subr-spec s x sc "cellular" es ps r slot d)) (ty-data (c cs) (if (and (or (string=? c "%fx") (string=? c "%cellular") (string=? c "%native")) (not (null? cs))) (tagcase (walk s (car cs)) (ty-proc (es ps r) (rx-subr-spec s x sc (after-prefix c "%") es ps r slot d)) (else other (rx-declined x "a specified type of no procedure"))) (rx-declined x "a specified type of no procedure"))) (else other (rx-declined x "a specified type of no procedure"))))
                  ((string=? d "%mtype") (rx-moduleof s x sc args slot))
                  ((and (string=? d "%app") (not (null? args)))
                   "A type function applied (C347), Fixpt's `(app F d …)`, `F` a type."
                   (tagcase (rx-ty s x sc (car args))
                     (rxa (x f) (tagcase (rx-descs s x sc (cdr args)) (rxs (x ds) (rx-fill x slot "app" #f (the strings nil) (cons f ds)))))))
                  ((and (or (has-prefix? d "%") (has-char-in? d #\space)) (not (string-member? d rp-generative-heads))) (rx-declined x d))
                  (else (tagcase (rx-descs s x sc args) (rxs (x as) (rx-generative s x sc (if (string-member? d rp-generative-heads) (rp-generative-name d) d) (size args) as slot))))))
          (else other (rx-declined x "a type of no head yet")))))))

(define rp-hex-digits string "0123456789abcdef")

(define-rec
  (rp-hex-of (subr (maxeff kfx (read @heap)) ((bytevectorof @heap) int) string)
    (lambda (b i)
      "Bytes `b` from `i` on, two hexadecimal digits each."
      (if (>= i (bytevector-length b))
          ""
          (let ((k (u8->int (bytevector-u8-ref b i))))
            (string-append (substring rp-hex-digits (quotient k 16) (+ (quotient k 16) 1))
              (string-append (substring rp-hex-digits (remainder k 16) (+ (remainder k 16) 1)) (rp-hex-of b (+ i 1)))))))))

"Importing: a rep's nodes, as `rep-nodes` gives them, back to a type of the
 checker's (C301). Each node by its slot; a bound variable by its binder's
 name at its place; a hole by its name; a node met again while it is being
 made, a recursive type's variable, `%mN`, its node then a `%mu`."
(define-type rp-in (productof (1 rp-nodes) (2 (listof symbol acyclic))))

(define-rec
  (rp-node-at (subr kfx (rp-nodes int) rp-nodes)
    (lambda (ns k) (cond ((null? ns) nil) ((= (extract (car ns) 1) k) (list (car ns))) (else (rp-node-at (cdr ns) k))))))

(define-rec
  (nth-symbol (subr kfx ((listof symbol acyclic) int) string)
    (lambda (xs k) (cond ((null? xs) "?") ((= k 0) (symbol->string (car xs))) (else (nth-symbol (cdr xs) (- k 1)))))))

(define-rec
  (drop-sexps (subr kfx (sexps i64) sexps)
    (lambda (xs n) (if (or (null? xs) (i64<= n 0)) xs (drop-sexps (cdr xs) (i64- n 1))))))

(define-rec
  (drop-n (subr kfx (rp-operands i64) rp-operands)
    (lambda (xs n) (if (or (null? xs) (i64<= n 0)) xs (drop-n (cdr xs) (i64- n 1))))))

"A specification's text back, as the checker writes it (C303), from its
 nodes: `(spec (p …) r requires ensures)`."
(define-rec
  (rp-op-text (subr kfx (rp-nodes rp-operand) string)
    (lambda (ns a)
      (tagcase a
        (int k (int->string k))
        (sym n (symbol->string n))
        (node j
          (let ((n (rp-node-at ns j)))
            (if (null? n)
                "?"
              (let* ((h (symbol->string (extract (car n) 2))) (args (extract (car n) 5))
                     (words (lambda ((name string)) (string-append "(" (string-append name (string-append (rp-ops-text ns args) ")"))))))
                (cond ((string=? h "atom") (rp-op-text ns (car args)))
                      ((string=? h "param") (words "p"))
                      ((string=? h "result") "(res)")
                      ((string=? h "length") (words "len"))
                      ((string=? h "nat") (words "natp"))
                      ((string=? h "rel")
                       (string-append "(rel " (string-append (i64->string (rp-index-of rp-rels (tagcase (car args) (sym n (symbol->string n)) (else other "")) 0))
                                                             (string-append (rp-ops-text ns (cdr args)) ")"))))
                      ((string=? h "shape")
                       (string-append "(shape " (string-append (rp-op-text ns (car args))
                         (string-append " " (string-append (rp-nth-string rp-shapes (tagcase (car (cdr args)) (int k (int->i64 k)) (else other -1))) ")")))))
                      (else (words h)))))))
        (else other "?"))))
  (rp-ops-text (subr kfx (rp-nodes rp-operands) string)
    (lambda (ns as) (if (null? as) "" (string-append " " (string-append (rp-op-text ns (car as)) (rp-ops-text ns (cdr as))))))))

(define rp-spec-text (subr kfx (rp-nodes int) string)
  (lambda (ns j)
    (let* ((n (car (rp-node-at ns j))) (bs (map (lambda ((b symbol)) (if (string=? (symbol->string b) "") "%none" (symbol->string b))) (extract n 4))) (args (extract n 5)))
      (string-append "(spec (" (string-append (words-of (reverse (cdr (reverse bs))))
        (string-append ") " (string-append (last bs) (string-append (rp-ops-text ns args) ")"))))))))

"What an import is in: the rep's nodes; its holes' names; the binders in
 scope, each its node's slot and its names; the nodes being made."
(define-datatype ri (ri rp-nodes (listof symbol acyclic) (listof (productof (1 int) (2 (listof symbol acyclic))) acyclic) (listof int acyclic)))

(define-rec
  (ri-binder-names (subr kfx ((listof (productof (1 int) (2 (listof symbol acyclic))) acyclic) int) (listof symbol acyclic))
    (lambda (bs slot) (cond ((null? bs) nil) ((= (extract (car bs) 1) slot) (extract (car bs) 2)) (else (ri-binder-names (cdr bs) slot))))))

(define ri-datum? (subr kfx (rp-nodes int rp-operands) bool)
  (lambda (ns k args)
    "Whether union node `k` is `datum`'s (`rx-datum`)."
    (and (i64= (size args) 10)
         (tagcase (car (drop-n args 7))
           (node j (let ((n (rp-node-at ns j)))
                     (and (not (null? n)) (string=? (symbol->string (extract (car n) 2)) "pairof")
                          (tagcase (car (extract (car n) 5)) (node m (= m k)) (else other #f)))))
           (else other #f)))))

(define-rec
  (ri-kind-text (subr kfx (rp-nodes rp-node) string)
    (lambda (ns n)
      "A kind node as kayak's checker spells the kind: an arrow `(=> (K …) R)`."
      (let ((h (symbol->string (extract n 2))) (as (extract n 5)))
        (if (and (string=? h "=>") (not (null? as)))
            (let ((ks (map (lambda ((a rp-operand)) (tagcase a (node j (let ((m (rp-node-at ns j))) (if (null? m) "?" (ri-kind-text ns (car m))))) (else other "?"))) as)))
              (string-append "(=> (" (string-append (words-of (reverse (cdr (reverse ks)))) (string-append ") " (string-append (last ks) ")")))))
            h)))))

(define rp-gendef-dropped (subr kfx (rp-nodes rp-operands) rp-operands)
  (lambda (ns args)
    "A `named` node's operands, its `gendef` left out."
    (if (or (null? args) (null? (cdr args)))
        args
        (tagcase (car (cdr args))
          (node j (let ((n (rp-node-at ns j)))
                    (if (and (not (null? n)) (string=? (symbol->string (extract (car n) 2)) "gendef")) (cons (car args) (cdr (cdr args))) args)))
          (else other args)))))

(define-rec
  (ri-binders-spelt (subr kfx (rp-nodes int (listof symbol acyclic) rp-operands) (listof symbol acyclic))
    (lambda (ns k bs as)
      "A `poly`'s or `dlambda`'s binders, at node `k`, each spelt as kayak's
       checker spells one (C346): its kind's mark (`binder-named`), `@` and
       the node, so that two binders of one name are two, and `%d` if
       distinct."
      (if (or (null? bs) (null? as))
          nil
          (let* ((bn (tagcase (car as) (node j (rp-node-at ns j)) (else other nil)))
                 (kn (if (null? bn) nil (tagcase (car (extract (car bn) 5)) (node j (rp-node-at ns j)) (else other nil))))
                 (kind (if (null? kn) "type" (ri-kind-text ns (car kn))))
                 (distinct (and (not (null? bn)) (not (null? (cdr (extract (car bn) 5))))
                                (tagcase (car (cdr (extract (car bn) 5))) (flag f f) (else other #f)))))
            (cons (string->symbol (string-append (binder-named kind (symbol->string (car bs)))
                                                 (string-append "@r" (string-append (int->string k) (cond (distinct "%d") ((string=? kind "place") "%p") (else ""))))))
                  (ri-binders-spelt ns k (cdr bs) (cdr as))))))))

(define-rec
  (ri-ty (subr kfx (ri rp-operand) ty)
    (lambda (c a)
      (tagcase c
        (ri (ns hs bs busy)
          (tagcase a
            (node k (if (any? (lambda ((b int)) (= b k)) busy) (ty-var (string-append "%m" (int->string k))) (ri-node c k)))
            (bound p (let ((n (nth-symbol (ri-binder-names bs (extract p 1)) (extract p 2))))
                       (if (has-prefix? n "rp..") (ty-data n nil) (ty-var n))))
            (hole h (ty-var (nth-symbol hs h)))
            (else other (ty-void)))))))
  (ri-tys (subr kfx (ri rp-operands) tys)
    (lambda (c as) (if (null? as) nil (cons (ri-ty c (car as)) (ri-tys c (cdr as))))))
  (ri-descs (subr kfx (ri rp-operands) tys)
    (lambda (c as)
      "Descriptions back: `(d-region R)` a region, `(d-type T)` a type."
      (if (null? as)
          nil
          (cons (tagcase (car as)
                  (node k
                    (let ((n (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) k)))
                      (if (null? n)
                          (ty-void)
                          (cond ((string=? (symbol->string (extract (car n) 2)) "d-region") (ri-region c (car (extract (car n) 5))))
                                ((string=? (symbol->string (extract (car n) 2)) "d-size") (ri-size c (car (extract (car n) 5))))
                                ((string=? (symbol->string (extract (car n) 2)) "d-effect")
                                 (tagcase (car (extract (car n) 5))
                                   (node j (ty-proc (ri-atoms c (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 5)) nil (ty-unit)))
                                   (else other (ty-void))))
                                (else (ri-ty c (car (extract (car n) 5))))))))
                  (else other (ty-void)))
                (ri-descs c (cdr as))))))
  (ri-size (subr kfx (ri rp-operand) ty)
    (lambda (c a)
      "A size back: `finite`, or a linear one, by `size-of-lin`."
      (tagcase c
        (ri (ns hs bs busy)
          (tagcase a
            (node k
              (let ((n (rp-node-at ns k)))
                (if (or (null? n) (not (string=? (symbol->string (extract (car n) 2)) "lin")))
                    (ty-data "%finite" nil)
                    (let* ((args (extract (car n) 5))
                           (k0 (tagcase (car args) (int v v) (else other 0)))
                           (terms (tagcase (car (cdr args)) (node j (extract (car (rp-node-at ns j)) 5)) (else other nil))))
                      (size-of-lin (lin (int->i64 k0) (map (lambda ((t rp-operand))
                                                               (tagcase t
                                                                 (node j (let ((tn (extract (car (rp-node-at ns j)) 5)))
                                                                           (lterm (tagcase (ri-ty c (car tn)) (ty-var (v) v) (else z "?"))
                                                                                  (tagcase (car (cdr tn)) (int v (int->i64 v)) (else other 1)))))
                                                                 (else other (lterm "?" 1))))
                                                             terms)))))))
            (else other (ty-data "%finite" nil)))))))
  (ri-region (subr kfx (ri rp-operand) ty)
    (lambda (c a)
      (tagcase c
        (ri (ns hs bs busy)
          (tagcase a
            (node k
              (let ((n (rp-node-at ns k)))
                (if (null? n)
                    (ty-void)
                    (let ((head (symbol->string (extract (car n) 2))) (args (extract (car n) 5)))
                      (cond ((string=? head "heap") (ty-rconst "heap"))
                            ((string=? head "rconst") (tagcase (car args) (sym s (ty-rconst (symbol->string s))) (else other (ty-void))))
                            ((string=? head "frozen")
                             (let ((kind (tagcase (car args) (flag f (if f "acyclic" "const")) (else other "const"))))
                               (if (null? (cdr args)) (ty-rconst kind) (ty-data "%frozen" (list (ty-rconst kind) (ri-ty c (car (cdr args))))))))
                            (else (ty-void)))))))
            (else other (ri-ty c a)))))))
  (ri-region-string (subr kfx (ri rp-operand) string)
    (lambda (c a) (region-string (st nil 0 nil nil) (ri-region c a))))
  (ri-atoms (subr kfx (ri rp-operands) strings)
    (lambda (c as) (if (null? as) nil (cons (ri-atom c (car as)) (ri-atoms c (cdr as))))))
  (ri-atom (subr kfx (ri rp-operand) string)
    (lambda (c a)
      (tagcase c
        (ri (ns hs bs busy)
          (tagcase a
            (node k
              (let ((n (rp-node-at ns k)))
                (if (null? n)
                    "?"
                    (let ((head (symbol->string (extract (car n) 2))) (args (extract (car n) 5)))
                      (cond ((or (string=? head "spin") (string=? head "nondet") (string=? head "stage")) head)
                            ((string=? head "io") (tagcase (car args) (sym s (string-append "io:" (symbol->string s))) (else other "?")))
                            ((and (string=? head "read") (tagcase (car args) (node j (let ((m (rp-node-at ns j))) (and (not (null? m)) (string=? (symbol->string (extract (car m) 2)) "globals")))) (else other #f)))
                             "@globals")
                            ((and (string=? head "read") (tagcase (car args) (node j (let ((m (rp-node-at ns j))) (and (not (null? m)) (string=? (symbol->string (extract (car m) 2)) "global")))) (else other #f)))
                             (tagcase (car args)
                               (node j (tagcase (car (extract (car (rp-node-at ns j)) 5)) (sym g (string-append "g:" (symbol->string g))) (else other "?")))
                               (else other "?")))
                            (else (string-append head (string-append ":" (ri-region-string c (car args))))))))))
            (else other (tagcase (ri-ty c a) (ty-var (v) v) (else z "?"))))))))
  (ri-parts (subr kfx (ri rp-operands) (listof (productof (1 string) (2 ty)) acyclic))
    (lambda (c as)
      (if (or (null? as) (null? (cdr as)))
          nil
          (cons (product (1 (tagcase (car as) (sym s (symbol->string s)) (else other "?"))) (2 (ri-ty c (car (cdr as)))))
                (ri-parts c (cdr (cdr as)))))))
  (ri-node (subr kfx (ri int) ty)
    (lambda (c k)
      (tagcase c
        (ri (ns hs bs busy)
          (let ((n (rp-node-at ns k)))
            (if (null? n)
                (ty-void)
                (let* ((head (symbol->string (extract (car n) 2))) (args (extract (car n) 5)) (binders (extract (car n) 4))
                       (scoped (cond ((string=? head "moduleof") (map (lambda ((b symbol)) (string->symbol (string-append "rp.." (symbol->string b)))) binders))
                                     ((or (string=? head "poly") (string=? head "dlambda")) (ri-binders-spelt ns k binders args))
                                     (else binders)))
                       (c2 (ri ns hs (cons (product (1 k) (2 scoped)) bs) (cons k busy)))
                       (t (ri-made c2 k head args (if (string=? head "moduleof") binders scoped)))
                       (m (string-append "%m" (int->string k))))
                  (if (ty-names? t m) (ty-data "%mu" (list (ty-var m) t)) t))))))))
  (ri-made (subr kfx (ri int string rp-operands (listof symbol acyclic)) ty)
    (lambda (c k head args binders)
      (let ((base-of (lambda ((n string))
                       (cond ((string=? n "int") (ty-int)) ((string=? n "i64") (ty-i64)) ((string=? n "f64") (ty-f64))
                             ((string=? n "bool") (ty-bool)) ((string=? n "char") (ty-char)) ((string=? n "unit") (ty-unit))
                             ((string=? n "string") (ty-string)) (else (ty-data n nil))))))
        (cond ((string=? head "base") (tagcase (car args) (sym s (base-of (symbol->string s))) (else other (ty-void))))
              ((string=? head "void") (ty-void))
              ((string=? head "nil") (ty-data "nil" nil))
              ((string=? head "false") (ty-data "false" nil))
              ((string=? head "nat")
               (tagcase (car args)
                 (node j (if (string=? (symbol->string (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 2)) "finite")
                             (ty-nat)
                             (ty-data "%natof" (list (ri-size c (car args))))))
                 (else other (ty-nat))))
              ((string=? head "nlist") (ty-data "%nlist" (list (ri-ty c (car args)) (ri-size c (car (cdr args))))))
              ((or (string=? head "oneof") (string=? head "union")) (if (ri-datum? (tagcase c (ri (ns hs bs busy) ns)) k args) (ty-data "datum" nil) (ty-data "%union" (ri-tys c args))))
              ((string=? head "subr")
               (let* ((conv (tagcase (car args) (node j (symbol->string (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 2))) (else other "cellular")))
                      (es (tagcase (car (cdr args)) (node j (ri-atoms c (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 5))) (else other nil)))
                      (ps (tagcase (car (cdr (cdr args))) (node j (ri-tys c (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 5))) (else other nil)))
                      (p (ty-proc es ps (ri-ty c (car (cdr (cdr (cdr args))))))))
                 (let ((q (if (string=? conv "cellular") p (ty-data (string-append "%" conv) (list p))))
                       (spec (drop-n args 4)))
                   (tagcase (if (null? spec) (the rp-operand (sum int 0)) (car spec))
                     (node j (ty-data (string-append "%spec " (rp-spec-text (tagcase c (ri (ns hs bs busy) ns)) j)) (list q)))
                     (else other q)))))
              ((string=? head "poly")
               (ty-data "%poly" (onto (map (lambda ((b symbol)) (ty-var (symbol->string b))) binders) (list (ri-ty c (last args))))))
              ((string=? head "ref") (ty-ref (ri-ty c (car args)) (ri-region c (car (cdr args)))))
              ((string=? head "pairof")
               (if (tagcase (car (cdr args)) (node j (= j k)) (else other #f))
                   (ty-list (ri-ty c (car args)) (ri-region c (car (cdr (cdr args)))))
                   (let ((p (ty-data "%pairof" (list (ri-ty c (car args)) (ri-ty c (car (cdr args))) (ri-region c (car (cdr (cdr args))))))))
                     ;; One that may be `nil`: the union it was (C346, `rp-nil-or-pair`).
                     (if (and (i64>= (size args) 4) (tagcase (car (drop-n args 3)) (flag f f) (else other #f)))
                         (ty-data "%union" (list (ty-data "nil" nil) p))
                         p))))
              ((or (string=? head "productof") (string=? head "sumof"))
               (let ((ps (ri-parts c args)))
                 (ty-shape (string=? head "productof") (map (lambda ((p (productof (1 string) (2 ty)))) (extract p 1)) ps)
                           (map (lambda ((p (productof (1 string) (2 ty)))) (extract p 2)) ps))))
              ((or (string=? head "icell") (string=? head "mark-key"))
               (ty-data (string-append "%" head) (list (ri-ty c (car args)) (ri-region c (car (cdr args))))))
              ((string=? head "place") (ty-data "%place" (list (ri-region c (car args)))))
              ((string=? head "narrayof")
               (tagcase (car (cdr args))
                 (node j (if (string=? (symbol->string (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 2)) "finite")
                             (ty-data "%array" (list (ri-ty c (car args)) (ri-region c (car (cdr (cdr args))))))
                             (ty-data "%narray" (list (ri-ty c (car args)) (ri-size c (car (cdr args))) (ri-region c (car (cdr (cdr args))))))))
                 (else other (ty-void))))
              ((string=? head "named")
               ;; A definition after the constant (`gendef`, C347) is not a
               ;; description: the import knows the type by its constant.
               (let ((args (rp-gendef-dropped (tagcase c (ri (ns hs bs busy) ns)) args)))
               (tagcase (car args)
                 (const p (cond ((string=? (extract p 1) "flat-arrayof") (ty-data "%flat-array" (ri-descs c (cdr args))))
                              ((string=? (extract p 1) "flatarrayof")
                               (let ((ds (ri-descs c (cdr args)))) (ty-flat (car ds) (car (cdr ds)))))
                              ((string=? (extract p 1) "flat-keyed")
                               (let* ((ds (ri-descs c (cdr args))) (w (size-lin (st nil 0 nil nil) (car ds))) (sm (car (cdr ds))))
                                 (ty-data "%flat-sum"
                                          (cons (rp-key-of-width (if (null? w) 4 (tagcase (car w) (lin (k ts) k))))
                                                (tagcase sm
                                                  (ty-shape (pp ls ts) (concat (map2 (lambda ((l string) (t ty)) (the tys (list (ty-rconst l) t))) ls ts)))
                                                  (else other nil))))))
                              ((string=? (extract p 1) "vsubr")
                               (let ((ds (ri-descs c (cdr args))))
                                 (ty-data "%vsubr" (cons (ty-proc (tagcase (car ds) (ty-proc (es ps r) es) (else other nil)) nil (ty-unit)) (cdr ds)))))
                              (else
                              (ty-data (if (string-member? (rp-generative-head (extract p 1)) rp-generative-heads) (rp-generative-head (extract p 1)) (extract p 1))
                                   (ri-descs c (cdr args))))))
                 (else other (ty-void)))))
              ((string=? head "bloblet")
               (ty-data (if (tagcase (car args) (flag f f) (else other #f)) "%fbloblet" "%bloblet")
                        (cons (ri-region c (car (cdr args))) (ri-tys c (cdr (cdr args))))))
              ((string=? head "moduleof")
               (let* ((n (size binders)) (rest (drop-n args n))
                      (part-of (lambda ((a rp-operand) (prefix string))
                                 (tagcase a
                                   (node j (map (lambda ((pt (productof (1 string) (2 ty))))
                                                  ;; An effect's description back as one (C315).
                                                  (tagcase (extract pt 2)
                                                    (ty-data (k as) (if (string=? k "%effdesc")
                                                                        (ty-data (string-append "%edesc " (extract pt 1)) as)
                                                                        (ty-data (string-append prefix (extract pt 1)) (list (extract pt 2)))))
                                                    (else other (ty-data (string-append prefix (extract pt 1)) (list (extract pt 2))))))
                                                (ri-parts c (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 5))))
                                   (else other nil)))))
                 (ty-data "%mtype"
                          (onto (map (lambda ((b symbol)) (ty-data (string-append "%abs " (symbol->string b)) (list (ty-data (string-append "rp.." (symbol->string b)) nil)))) binders)
                                (onto (part-of (car rest) "%desc ") (part-of (car (cdr rest)) "%val "))))))
              ((string=? head "dlambda")
               "A description function back (C315): of no parameters and an
                effect, a module's description of an effect (`%effdesc`)."
               (let ((body (car (ri-descs c (drop-n args (size binders))))))
                 (if (and (null? binders) (tagcase body (ty-proc (es ps r) #t) (else other #f)))
                     (ty-data "%effdesc" (list body))
                     (ty-data "%dlambda" (onto (map (lambda ((b symbol)) (ty-var (symbol->string b))) binders) (list body))))))
              ((string=? head "var") (ri-ty c (car args)))
              ((and (string=? head "app") (not (null? args))) (ty-data "%app" (cons (ri-ty c (car args)) (ri-descs c (cdr args)))))
              ((string=? head "composable")
               (ty-data (if (tagcase (car (cdr (cdr (cdr (cdr args))))) (flag f f) (else other #f)) "%oneshot" "%composable")
                        (list (ri-ty c (car args)) (ri-ty c (car (cdr args)))
                              (ty-proc (tagcase (car (cdr (cdr args))) (node j (ri-atoms c (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 5))) (else other nil)) nil (ty-unit))
                              (ri-region c (car (cdr (cdr (cdr args))))))))
              ((string=? head "prompt-tag")
               (ty-tag (ri-ty c (car args)) (ri-ty c (car (cdr args)))
                       (tagcase (car (cdr (cdr args))) (node j (ri-atoms c (extract (car (rp-node-at (tagcase c (ri (ns hs bs busy) ns)) j)) 5))) (else other nil))
                       (ri-region c (car (cdr (cdr (cdr args)))))))
              (else (ty-void)))))))

"A rep, from its binary form, as a type of the checker's."
(define rep-ty (poly ((r region)) (subr (maxeff kfx (read r)) ((bytevectorof r)) ty))
  (plambda ((r region))
    (lambda (b)
      (let ((got ((proj rep-nodes r) b nil)))
        (ri-ty (ri (extract got 1) (extract got 2) nil nil) (the rp-operand (sum node 0)))))))

"Each module type a type names by its abbreviation (`%module NAME`, C166)
 its module type, by the checker's environment `v` (C346), as Fixpt's
 types hold the module type itself: what the export, which has no
 environment, would decline."
(define-rec
  (mtypes-expanded (subr kfx (cv st ty) ty)
    (lambda (v s t0)
      (let ((t (walk s t0)))
        (tagcase t
          (ty-list (a b) (ty-list (mtypes-expanded v s a) (mtypes-expanded v s b)))
          (ty-data (d args)
            (if (has-prefix? d "%module ")
                (let ((m (as-mtype v t))) (if (mtype? m) (mtypes-expanded v s m) t))
                (ty-data d (mtypes-each v s args))))
          (ty-flat (a b) (ty-flat (mtypes-expanded v s a) (mtypes-expanded v s b)))
          (ty-ref (a b) (ty-ref (mtypes-expanded v s a) (mtypes-expanded v s b)))
          (ty-tag (a b ns c) (ty-tag (mtypes-expanded v s a) (mtypes-expanded v s b) ns (mtypes-expanded v s c)))
          (ty-proc (es ps r) (ty-proc es (mtypes-each v s ps) (mtypes-expanded v s r)))
          (ty-shape (p ls ts) (ty-shape p ls (mtypes-each v s ts)))
          (else other t)))))
  (mtypes-each (subr kfx (cv st tys) tys)
    (lambda (v s ts) (if (null? ts) nil (cons (mtypes-expanded v s (car ts)) (mtypes-each v s (cdr ts)))))))

"A type's export, its nodes made and not yet canonical (C305): what
 `rep-of-nodes` takes, as text (`rp-nodes-text`) a fact may carry; or why
 not, the first part declined."
(define-datatype rexp (rexp rp-nodes strings int string))

(define ty-export-from (subr kfx (st rx ty) rexp)
  (lambda (s x0 t)
    (tagcase (rx-ty s x0 nil t)
      (rxa (x root)
        (tagcase x
          (rx (ns k hs d e)
            (tagcase root
              (node slot (rexp ns (reverse hs) slot d))
              (else other (rexp ns (reverse hs) 0 (if (string=? d "") "no node" d))))))))))
(define ty-export (subr kfx (st ty) rexp) (lambda (s t) (ty-export-from s rx-empty t)))
"With the checker's environment `v` (C347): a datatype the sum it is, a
 generative type with its definition, as Fixpt's."
(define ty-export-in (subr kfx (cv st ty) rexp) (lambda (v s t) (ty-export-from s (rx-in v) t)))

"Evidence as nodes (C307; Fixpt's `k-evidence-rep`): its root an
 `evidence` node of what it is of, an effect (a type `t`'s latent one,
 `kind` \"effect\"), a type, or a region."
(define evidence-export (subr kfx (st string ty) rexp)
  (lambda (s kind t)
    (tagcase (cond ((string=? kind "effect") (rx-effect rx-empty nil (tagcase t (ty-proc (es ps r) es) (else other nil))))
                   ((string=? kind "region") (rx-region s rx-empty nil t))
                   (else (rx-ty s rx-empty nil t)))
      (rxa (x of)
        (tagcase (rx-node x "evidence" #f (the rp-operands (list of)))
          (rxa (x root)
            (tagcase x
              (rx (ns k hs d e)
                (tagcase root
                  (node slot (rexp ns (reverse hs) slot d))
                  (else other (rexp ns (reverse hs) 0 "no node")))))))))))

"Type `t` as a rep in its binary form, or none if a part is declined."
(define ty-rep-from (poly ((r region)) (subr (maxeff kfx (alloc r)) (st rx ty) (listof (bytevectorof r) acyclic)))
  (plambda ((r region))
    (lambda (s x0 t)
      (tagcase (ty-export-from s x0 t)
        (rexp (ns hs root d)
          (if (not (string=? d ""))
              nil
              (list (the (bytevectorof r) (rep-of-nodes ns (map (lambda ((h string)) (string->symbol h)) hs) root)))))))))
(define ty-rep (poly ((r region)) (subr (maxeff kfx (alloc r)) (st ty) (listof (bytevectorof r) acyclic)))
  (plambda ((r region)) (lambda (s t) ((proj ty-rep-from r) s rx-empty t))))
(define ty-rep-in (poly ((r region)) (subr (maxeff kfx (alloc r)) (cv st ty) (listof (bytevectorof r) acyclic)))
  (plambda ((r region)) (lambda (v s t) ((proj ty-rep-from r) s (rx-in v) t))))

"A node list as text (C305), for a fact: `(ROOT (HOLE …) NODE …)`, a node
 `(SLOT HEAD SET (BINDER …) (ARG …))`, each argument as its sum's tag and
 its payload, every name written as a string, so that no name breaks the
 reading."
(define rp-quoted (subr kfx (string) string) (lambda (n) (string-append "\"" (string-append n "\""))))
(define-rec
  (rp-words (subr kfx (strings) string)
    (lambda (ws) (cond ((null? ws) "") ((null? (cdr ws)) (car ws)) (else (string-append (car ws) (string-append " " (rp-words (cdr ws)))))))))
(define rp-arg-text (subr kfx (rp-operand) string)
  (lambda (a)
    (tagcase a
      (node k (string-append "(node " (string-append (int->string k) ")")))
      (bound p (string-append "(bound " (string-append (int->string (extract p 1)) (string-append " " (string-append (int->string (extract p 2)) ")")))))
      (hole h (string-append "(hole " (string-append (int->string h) ")")))
      (const p (string-append "(const " (string-append (rp-quoted (extract p 1)) (string-append " " (string-append (int->string (extract p 2))
                 (string-append " " (string-append (rp-quoted (extract p 3)) ")")))))))
      (sym n (string-append "(sym " (string-append (rp-quoted (symbol->string n)) ")")))
      (int k (string-append "(int " (string-append (int->string k) ")")))
      (flag f (if f "(flag #t)" "(flag #f)")))))
(define rp-node-text (subr kfx (rp-node) string)
  (lambda (n)
    (string-append "(" (string-append (int->string (extract n 1)) (string-append " " (string-append (rp-quoted (symbol->string (extract n 2)))
      (string-append (if (extract n 3) " #t (" " #f (") (string-append (rp-words (map (lambda ((b symbol)) (rp-quoted (symbol->string b))) (extract n 4)))
        (string-append ") (" (string-append (rp-words (map rp-arg-text (extract n 5))) "))"))))))))))
(define rp-nodes-text (subr kfx (rp-nodes strings int) string)
  (lambda (ns hs root)
    (string-append "(" (string-append (int->string root) (string-append " (" (string-append (rp-words (map rp-quoted hs))
      (string-append ") " (string-append (rp-words (map rp-node-text ns)) ")"))))))))

"The text back (C305): the nodes, the holes' names, the root."
(define sexp-string (subr kfx (sexp) string) (lambda (e) (tagcase e (str (t f p) t) (sym (t f p) t) (else other ""))))
(define rp-arg-of (subr kfx (sexp) rp-operand)
  (lambda (e)
    (let* ((xs (items e)) (h (sym-name (car xs))) (k (lambda ((i i64)) (i64->int (sexp-int (car (drop-sexps (cdr xs) i)))))))
      (cond ((string=? h "node") (the rp-operand (sum node (k 0))))
            ((string=? h "bound") (the rp-operand (sum bound (product (1 (k 0)) (2 (k 1))))))
            ((string=? h "hole") (the rp-operand (sum hole (k 0))))
            ((string=? h "const") (the rp-operand (sum const (product (1 (sexp-string (second xs))) (2 (k 1)) (3 (sexp-string (car (cdr (cdr (cdr xs))))))))))
            ((string=? h "sym") (the rp-operand (sum sym (string->symbol (sexp-string (second xs))))))
            ((string=? h "int") (the rp-operand (sum int (k 0))))
            (else (the rp-operand (sum flag (string=? (sym-name (second xs)) "#t"))))))))
(define rp-node-of (subr kfx (sexp) rp-node)
  (lambda (e)
    (let ((xs (items e)))
      (product (1 (i64->int (sexp-int (car xs)))) (2 (string->symbol (sexp-string (second xs))))
               (3 (string=? (sym-name (third xs)) "#t"))
               (4 (map (lambda ((b sexp)) (string->symbol (sexp-string b))) (items (car (cdr (cdr (cdr xs)))))))
               (5 (map rp-arg-of (items (car (cdr (cdr (cdr (cdr xs))))))))))))
(define rp-nodes-of-text (subr kfx (string) rexp)
  (lambda (text)
    (let ((xs (items (car (read-all (string-chars text) "" 1)))))
      (rexp (map rp-node-of (cdr (cdr xs))) (map sexp-string (items (second xs))) (i64->int (sexp-int (car xs))) ""))))

"Why type `t` is declined: the first part a rep does not take, or none."
(define ty-declined (subr kfx (cv st ty) string)
  (lambda (v s t) (tagcase (rx-ty s (rx-in v) nil t) (rxa (x root) (tagcase x (rx (ns k hs d e) d))))))

"A scheme's type as a `poly` of its binders (C349): its marks (`%place
 'p`, `%distinct 'r`) not binders but each its binder marked, `'p%p` a
 place, `'r%d` distinct, as a `poly` type's binders are."
(define scheme-poly (subr kfx (strings ty) ty)
  (lambda (tvars t)
    (let* ((bs (filter (lambda ((n string)) (not (has-prefix? n "%"))) tvars))
           (mark (lambda ((n string))
                   (cond ((string-member? (string-append "%place " n) tvars) (string-append n "%p"))
                         ((string-member? (string-append "%distinct " n) tvars) (string-append n "%d"))
                         (else n))))
           (marked (map mark bs)))
      (if (null? bs)
          t
          (ty-data "%poly" (onto (map (lambda ((n string)) (ty-var n)) marked)
                                 (list (substitute bs (map (lambda ((n string)) (ty-var n)) marked) t))))))))

"A definition's scheme as a rep, its binary form in hexadecimal, and whether
 it comes back as itself: imported, and exported again, the same rep
 (`same`) or not (`differs`, and the second); or `declined` if a part of it
 is no rep's yet. Its variables a `poly`'s binders."
(define scheme-rep-hex (subr (maxeff kfx (alloc @heap) (read @heap)) (cv st scheme) string)
  (lambda (v s sc)
    (tagcase sc
      (scheme (tvars t)
        (let* ((t2 (scheme-poly tvars t))
               (got ((proj ty-rep-in @heap) v s t2)))
          (if (null? got)
              (string-append "declined: " (ty-declined v s t2))
              (let* ((h1 (rp-hex-of (car got) 0)) (again ((proj ty-rep-in @heap) v (st nil 0 nil nil) ((proj rep-ty @heap) (car got)))))
                (cond ((null? again) (string-append h1 " differs: declined again"))
                      ((string=? (rp-hex-of (car again) 0) h1) (string-append h1 " same"))
                      (else (string-append h1 (string-append " differs " (rp-hex-of (car again) 0))))))))))))
