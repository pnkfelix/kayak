"read.kfx: the reader, from characters to `sexp`s, and taking them apart."

"Reading"

"A list remembers where it began: its file's name, and the line of its
 `(`, from 1. Messages say where (check.kfx's `refuse`)."
(define-datatype sexp
  (sym string)
  (str string)
  (num i64)
  (chr char)
  (lst (listof sexp acyclic) string i64))

(define-type sexps (listof sexp acyclic))

"A datum, the text after it, and that text's line; the same for the items
 of a list; a token, and the text after it, which a token's end leaves on
 its line; the text after whitespace and comments, and its line."
(define-datatype got (got sexp chars i64))
(define-datatype gots (gots sexps chars i64))
(define-datatype tok (tok string chars))
(define-datatype skipped (skipped chars i64))

(define read-error (subr kfx (string i64 string) void)
  (lambda (file line message)
    (error (string-append "kfx: " (string-append file (string-append ":"
             (string-append (i64->string line) (string-append ": " message))))))))

(define skip-line (subr kfx (chars) chars)
  (lambda (cs)
    "A comment's text, to the newline that ends it, which is left."
    (cond ((null? cs) cs)
          ((char=? (car cs) #\newline) cs)
          (else (skip-line (cdr cs))))))

(define skip (subr kfx (chars i64) skipped)
  (lambda (cs line)
    "Skips whitespace and comments, counting lines."
    (cond ((null? cs) (skipped cs line))
          ((char=? (car cs) #\newline) (skip (cdr cs) (i64+ line 1)))
          ((char-whitespace? (car cs)) (skip (cdr cs) line))
          ((char=? (car cs) #\;) (skip (skip-line (cdr cs)) line))
          (else (skipped cs line)))))

(define delimiter? (subr kfx (char) bool)
  (lambda (c)
    (or (char-whitespace? c) (char=? c #\() (char=? c #\)) (char=? c #\") (char=? c #\;))))

(define token-chars (subr kfx (chars chars) tok)
  (lambda (cs acc)
    "A token's characters, onto `acc`, newest first."
    (if (or (null? cs) (delimiter? (car cs)))
        (tok (rev->string acc) cs)
        (token-chars (cdr cs) (cons (car cs) acc)))))

(define unescape (subr kfx (char) char)
  (lambda (c) (case c ((#\n) #\newline) ((#\t) #\tab) (else c))))

(define string-body (subr kfx (chars chars string i64 i64) got)
  (lambda (cs acc file start line)
    "A string's characters, after its opening quote on line `start`."
    (cond ((null? cs) (read-error file start "a string is not closed"))
          ((char=? (car cs) #\") (got (str (rev->string acc)) (cdr cs) line))
          ((char=? (car cs) #\\)
           (string-body (cdr (cdr cs)) (cons (unescape (car (cdr cs))) acc) file start line))
          ((char=? (car cs) #\newline)
           (string-body (cdr cs) (cons (car cs) acc) file start (i64+ line 1)))
          (else (string-body (cdr cs) (cons (car cs) acc) file start line)))))

(define digits-value (subr kfx (chars i64 string i64) i64)
  (lambda (cs n file line)
    "Digits onto `n`, negated: so that -9223372036854775808, whose
     magnitude is no i64, reads. A literal past an i64 is refused, as FX-26
     refuses it where an i64 is expected."
    (if (null? cs)
        n
        (let ((d (i64- (char->i64 (car cs)) 48)))
          (if (or (i64< n -922337203685477580)
                  (and (i64= n -922337203685477580) (i64> d 8)))
              (read-error file line "a literal past an i64")
              (digits-value (cdr cs) (i64- (i64* n 10) d) file line))))))

(define numeric? (subr kfx (chars) bool)
  (lambda (cs)
    (and (not (null? cs))
         (or (char-numeric? (car cs))
             (and (char=? (car cs) #\-) (not (null? (cdr cs))) (char-numeric? (car (cdr cs))))))))

(define token-atom (subr kfx (string string i64) sexp)
  (lambda (s file line)
    (let ((cs (string-chars s)))
      (cond ((not (numeric? cs)) (sym s))
            ((char=? (car cs) #\-) (num (digits-value (cdr cs) 0 file line)))
            (else
             (let ((negated (digits-value cs 0 file line)))
               (if (i64= negated -9223372036854775808)
                   (read-error file line "a literal past an i64")
                   (num (i64- 0 negated)))))))))

(define char-named (subr kfx (string string i64) char)
  (lambda (s file line)
    (cond ((i64= (string-length-i64 s) 1) (string-ref-i64 s 0))
          ((string=? s "space") #\space)
          ((string=? s "newline") #\newline)
          ((string=? s "tab") #\tab)
          (else (read-error file line (string-append "no character is named " s))))))

(define-rec
  (read-datum (subr kfx (chars string i64) got)
    (lambda (cs file line)
      "A datum at the start of `cs`, on `line` of `file`."
      (let ((c (car cs)))
        (cond ((char=? c #\()
               (tagcase (read-items (cdr cs) file line)
                 (gots (xs after end) (got (lst xs file line) after end))))
              ((char=? c #\)) (read-error file line "a ) with no ("))
              ((char=? c #\") (string-body (cdr cs) nil file line line))
              ((and (char=? c #\#) (not (null? (cdr cs))) (char=? (car (cdr cs)) #\\))
               (let ((name (cdr (cdr cs))))
                 (tagcase (token-chars (cdr name) (list (car name)))
                   (tok (s after) (got (chr (char-named s file line)) after line)))))
              (else
               (tagcase (token-chars cs nil)
                 (tok (s after) (got (token-atom s file line) after line))))))))
  (read-items (subr kfx (chars string i64) gots)
    (lambda (cs file line)
      (tagcase (skip cs line)
        (skipped (cs line)
          (cond ((null? cs) (read-error file line "a ( with no )"))
                ((char=? (car cs) #\)) (gots nil (cdr cs) line))
                (else
                 (tagcase (read-datum cs file line)
                   (got (x after line)
                     (tagcase (read-items after file line)
                       (gots (xs rest end) (gots (cons x xs) rest end))))))))))))

(define read-all (subr kfx (chars string i64) sexps)
  (lambda (cs file line)
    "Every datum in `cs`, the text of `file` from `line`."
    (tagcase (skip cs line)
      (skipped (cs line)
        (if (null? cs)
            nil
            (tagcase (read-datum cs file line)
              (got (x after line) (cons x (read-all after file line)))))))))

"Taking `sexp`s apart"

(define sym-name (subr kfx (sexp) string)
  (lambda (e) (tagcase e (sym (s) s) (else other (error "kfx: a name is expected")))))

(define sym-is? (subr kfx (sexp string) bool)
  (lambda (e s) (tagcase e (sym (n) (string=? n s)) (else other #f))))

(define items (subr kfx (sexp) sexps)
  (lambda (e) (tagcase e (lst (xs src-file src-line) xs) (else other (error "kfx: a list is expected")))))

(define head-is? (subr kfx (sexp string) bool)
  (lambda (e s)
    (tagcase e
      (lst (xs src-file src-line) (and (not (null? xs)) (sym-is? (car xs) s)))
      (else other #f))))

(define second (subr kfx (sexps) sexp) (lambda (xs) (car (cdr xs))))
(define third (subr kfx (sexps) sexp) (lambda (xs) (car (cdr (cdr xs)))))
(define fourth (subr kfx (sexps) sexp) (lambda (xs) (car (cdr (cdr (cdr xs))))))

(define param-name (subr kfx (sexp) string)
  (lambda (param)
    "A lambda's parameter's name: it is `x` or `(x T)`."
    (sym-name (tagcase param (lst (xs src-file src-line) (car xs)) (else other other)))))

(define procedure? (subr kfx (sexp) bool)
  (lambda (e) (or (head-is? e "lambda") (head-is? e "plambda"))))
