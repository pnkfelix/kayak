"read.kfx: the reader, from characters to `sexp`s, and taking them apart."

"Reading"

"A list remembers where it began: its file's name, the line of its `(`,
 from 1, and its offset, in characters from 0; a number its file and
 offset. Messages say where (check.kfx's `refuse`), and the checker's
 facts about a place are keyed by its file and offset (`fact`), which no
 two nodes of a file share."
(define-datatype sexp
  (sym string string i64)
  (str string string i64)
  (num i64 string i64)
  (big string string i64)
  (chr char string i64)
  (lst (listof sexp acyclic) string i64 i64)
  (real string string i64))

(define-type sexps (listof sexp acyclic))

"Where reading is: the text left, its line, and its offset."
(define-datatype here (here chars i64 i64))

"A datum, and where reading is after it; the same for the items of a
 list; a token, the text after it, and its length, which a token's end
 leaves on its line."
(define-datatype got (got sexp here))
(define-datatype gots (gots sexps here))
(define-datatype tok (tok string chars i64))

(define read-error (subr kfx (string i64 string) void)
  (lambda (file line message)
    (error (string-append "kfx: " (string-append file (string-append ":"
             (string-append (i64->string line) (string-append ": " message))))))))

(define skip-line (subr kfx (chars i64) here)
  (lambda (cs pos)
    "A comment's text, to the newline that ends it, which is left. The line
     is not counted here, but by `skip`, which meets the newline."
    (cond ((null? cs) (here cs 0 pos))
          ((char=? (car cs) #\newline) (here cs 0 pos))
          (else (skip-line (cdr cs) (i64+ pos 1))))))

(define skip-at (subr kfx (chars i64 i64) here)
  (lambda (cs line pos)
    "Skips whitespace and comments, counting lines and characters; a `here`
     made only where they end (C363)."
    (cond ((null? cs) (here cs line pos))
          ((char=? (car cs) #\newline) (skip-at (cdr cs) (i64+ line 1) (i64+ pos 1)))
          ((char-whitespace? (car cs)) (skip-at (cdr cs) line (i64+ pos 1)))
          ((char=? (car cs) #\;)
           (tagcase (skip-line (cdr cs) (i64+ pos 1))
             (here (rest zero after) (skip-at rest line after))))
          (else (here cs line pos)))))

(define skip (subr kfx (here) here)
  (lambda (h) (tagcase h (here (cs line pos) (skip-at cs line pos)))))

(define delimiter? (subr kfx (char) bool)
  (lambda (c)
    (or (char-whitespace? c) (char=? c #\() (char=? c #\)) (char=? c #\") (char=? c #\;))))

(define token-at (subr kfx (chars string i64 i64) tok)
  (lambda (cs text from n)
    "A token, `n` characters of it already read, from offset `from` of
     `text`, whose rest is `cs`: its text, a `substring` of `text` (C363),
     and `n`, how many."
    (if (or (null? cs) (delimiter? (car cs)))
        (tok (substring text (i64->int from) (i64->int (i64+ from n))) cs n)
        (token-at (cdr cs) text from (i64+ n 1)))))

(define unescape (subr kfx (char) char)
  (lambda (c) (case c ((#\n) #\newline) ((#\t) #\tab) ((#\r) (i64->char 13)) (else c))))

(define hex-escape (subr kfx (chars i64 i64) tok)
  (lambda (cs n k)
    "R7RS's hex escape in a string (a backslash, `x41;`), after its `x`: the hex digits' value `n`,
     `k` of them read, up to the `;`; the rest, as a token's text, the
     character it names."
    (cond ((null? cs) (tok "" cs k))
          ((i64= (char->i64 (car cs)) 59) (tok (char->string (i64->char n)) (cdr cs) (i64+ k 1)))
          (else
           (let* ((c (car cs)) (d (char->i64 c)))
             (hex-escape (cdr cs)
                         (i64+ (i64* n 16)
                               (cond ((and (i64>= d 48) (i64<= d 57)) (i64- d 48))
                                     ((and (i64>= d 97) (i64<= d 102)) (i64- d 87))
                                     ((and (i64>= d 65) (i64<= d 70)) (i64- d 55))
                                     (else 0)))
                         (i64+ k 1)))))))

(define string-body (subr kfx (chars string strings i64 string i64 i64 i64 i64) got)
  (lambda (cs text runs from file start at line pos)
    "A string's characters, after its opening quote on line `start`, at
     offset `at`: its runs between escapes, `substring`s of `text` (C363),
     newest first, the one now from `from`."
    (cond ((null? cs) (read-error file start "a string is not closed"))
          ((char=? (car cs) #\")
           (got (str (string-list-append (reverse (cons (substring text (i64->int from) (i64->int pos)) runs))) file at)
                (here (cdr cs) line (i64+ pos 1))))
          ((and (char=? (car cs) #\\) (not (null? (cdr cs))) (i64= (char->i64 (car (cdr cs))) 120))
           (tagcase (hex-escape (cdr (cdr cs)) 0 0)
             (tok (t rest k)
               (if (string=? t "")
                   (read-error file start "a string's hex escape is not closed by ;")
                   (string-body rest text (cons t (cons (substring text (i64->int from) (i64->int pos)) runs))
                                (i64+ pos (i64+ k 2)) file start at line (i64+ pos (i64+ k 2)))))))
          ((char=? (car cs) #\\)
           (string-body (cdr (cdr cs)) text (cons (char->string (unescape (car (cdr cs)))) (cons (substring text (i64->int from) (i64->int pos)) runs))
                        (i64+ pos 2) file start at line (i64+ pos 2)))
          ((char=? (car cs) #\newline)
           (string-body (cdr cs) text runs from file start at (i64+ line 1) (i64+ pos 1)))
          (else (string-body (cdr cs) text runs from file start at line (i64+ pos 1))))))

(define digits-value (subr kfx (chars i64 string i64) i64)
  (lambda (cs n file line)
    "Digits onto `n`, negated: so that -9223372036854775808, whose
     magnitude is no i64, reads. A literal past an i64 is refused, as FX-26
     refuses it where an i64 is expected."
    (if (null? cs)
        n
        (let ((d (i64- (char->i64 (car cs)) 48)))
          (if (or (i64< n -922337203685477580)
                  (and (i64= n -922337203685477580) (i64> d 8)))
              (read-error file line "a literal past an i64")
              (digits-value (cdr cs) (i64- (i64* n 10) d) file line))))))

(define numeric? (subr kfx (chars) bool)
  (lambda (cs)
    (and (not (null? cs))
         (or (char-numeric? (car cs))
             (and (char=? (car cs) #\-) (not (null? (cdr cs))) (char-numeric? (car (cdr cs))))))))

(define has-char? (subr kfx (chars char) bool)
  (lambda (cs c) (and (not (null? cs)) (or (char=? (car cs) c) (has-char? (cdr cs) c)))))

(define point-count (subr kfx (chars i64) i64)
  (lambda (cs n)
    "How many points `cs` has, or -1 if it has a character that is no
     digit and no point."
    (cond ((null? cs) n)
          ((char=? (car cs) #\.) (point-count (cdr cs) (i64+ n 1)))
          ((char-numeric? (car cs)) (point-count (cdr cs) n))
          (else -1))))

(define real-token? (subr kfx (chars) bool)
  (lambda (cs)
    "Digits, after a `-` if any, with one point among them: a real, as FX-26
     reads it (and Rust, written with a digit either side of the point)."
    (i64= (point-count (if (char=? (car cs) #\-) (cdr cs) cs) 0) 1)))

(define-rec
  (digits-after-zeros (subr kfx (chars) chars)
    (lambda (cs) (if (and (not (null? cs)) (not (null? (cdr cs))) (char=? (car cs) #\0)) (digits-after-zeros (cdr cs)) cs))))

(define-rec
  (digits-at-most? (subr kfx (chars chars) bool)
    (lambda (cs most)
      "Whether digits `cs` are at most `most`, of as many digits."
      (cond ((null? cs) #t)
            ((i64< (char->i64 (car cs)) (char->i64 (car most))) #t)
            ((i64> (char->i64 (car cs)) (char->i64 (car most))) #f)
            (else (digits-at-most? (cdr cs) (cdr most)))))))

(define fits-i64? (subr kfx (chars) bool)
  (lambda (cs)
    "Whether an integer literal is an i64's; one past is an `int`'s alone."
    (let* ((negative (char=? (car cs) #\-))
           (ds (digits-after-zeros (if negative (cdr cs) cs)))
           (n (size ds)))
      (cond ((i64< n 19) #t)
            ((i64> n 19) #f)
            (else (digits-at-most? ds (string-chars (if negative "9223372036854775808" "9223372036854775807"))))))))

"Reals as FX-26 reads them past KFX's own (C155): its point first, `.5`,
 or an exponent, `1e-3`, as Rust's `f64` syntax has them. kfx's
 restriction pass refuses both, KFX writing a real as it is written."
(define-rec
  (all-digits? (subr kfx (chars) bool)
    (lambda (cs) (or (null? cs) (and (char-numeric? (car cs)) (all-digits? (cdr cs)))))))

(define point-first-real? (subr kfx (chars) bool)
  (lambda (cs)
    (let ((body (if (and (not (null? cs)) (char=? (car cs) #\-)) (cdr cs) cs)))
      (and (not (null? body)) (char=? (car body) #\.) (not (null? (cdr body))) (all-digits? (cdr body))))))

(define-rec
  (before-exponent (subr kfx (chars) chars)
    (lambda (cs)
      "A real's mantissa, before its `e`."
      (if (or (null? cs) (char=? (car cs) #\e) (char=? (car cs) #\E)) nil (cons (car cs) (before-exponent (cdr cs)))))))

(define-rec
  (after-exponent (subr kfx (chars) chars)
    (lambda (cs)
      "A real's exponent, after its `e`; none if it has none."
      (cond ((null? cs) nil) ((or (char=? (car cs) #\e) (char=? (car cs) #\E)) (cdr cs)) (else (after-exponent (cdr cs)))))))

(define exponent-real? (subr kfx (chars) bool)
  (lambda (cs)
    "`[-]M e [+-]D`, `M` digits with at most one point among them, `D`
     digits."
    (let* ((body (if (char=? (car cs) #\-) (cdr cs) cs))
           (m (before-exponent body))
           (x (after-exponent body))
           (ds (if (and (not (null? x)) (or (char=? (car x) #\+) (char=? (car x) #\-))) (cdr x) x)))
      (and (not (null? ds)) (all-digits? ds)
           (not (null? (filter (lambda ((c char)) (char-numeric? c)) m)))
           (i64<= (point-count m 0) 1)
           (all-digits? (filter (lambda ((c char)) (not (char=? c #\.))) m))))))

(define written-out-real? (subr kfx (string) bool)
  (lambda (t)
    "Whether a real is written as KFX writes one: neither its point first nor
     with an exponent."
    (let ((cs (string-chars t)))
      (not (or (point-first-real? cs) (has-char? cs #\e) (has-char? cs #\E))))))

(define only-of? (subr kfx (chars string) bool)
  (lambda (cs allowed)
    "Whether every character of `cs` is one of `allowed`'s: `allowed`'s
     characters made once, not again for each of `cs` (C476: a list of them
     each, the reader's most of an edit build's character lists)."
    (let ((as (string-chars allowed)))
      (not (any? (lambda ((c char)) (not (has-char? as c))) cs)))))

(define hex-value (subr kfx (chars i64 string i64) i64)
  (lambda (cs n file line)
    "Hex digits onto `n`, as `digits-value`'s are, negated; one past an i64
     refused (C116: Fixpt's arm64 encoder writes its instructions so)."
    (if (null? cs)
        n
        (let* ((c (char-downcase (car cs)))
               (d (if (char-numeric? c) (i64- (char->i64 c) 48) (i64+ 10 (i64- (char->i64 c) 97)))))
          (if (i64< n -576460752303423487)
              (read-error file line "a hex literal past an i64, which KFX reads not yet")
              (hex-value (cdr cs) (i64- (i64* n 16) d) file line))))))

(define token-atom (subr kfx (string string i64 i64) sexp)
  (lambda (s file line pos)
    (let ((cs (string-chars s)))
      (cond ((and (char=? (car cs) #\#) (not (null? (cdr cs))) (or (char=? (car (cdr cs)) #\x) (char=? (car (cdr cs)) #\X))
                  (not (null? (cdr (cdr cs)))))
             "A hex literal, `#x1f`, `#x-1f`, R7RS's, as FX-26 reads it."
             (let* ((ds (cdr (cdr cs)))
                    (negative (char=? (car ds) #\-))
                    (ds (if (or negative (char=? (car ds) #\+)) (cdr ds) ds)))
               (if (or (null? ds) (not (only-of? ds "0123456789abcdefABCDEF")))
                   (read-error file line (string-append "no number KFX reads: " s))
                   (let ((n (hex-value ds 0 file line)))
                     (if negative (num n file pos)
                         (if (i64= n -9223372036854775808)
                             (read-error file line "a hex literal past an i64, which KFX reads not yet")
                             (num (i64- 0 n) file pos)))))))
            ((point-first-real? cs) (real s file pos))
            ((not (numeric? cs)) (sym s file pos))
            ((not (only-of? (if (char=? (car cs) #\-) (cdr cs) cs) "0123456789.eE+-"))
             "Not a number, though a digit begins it (`1x`, `0x10`): a name, as
              FX-26 reads it."
             (sym s file pos))
            ((or (has-char? cs #\e) (has-char? cs #\E))
             (if (exponent-real? cs) (real s file pos) (read-error file line (string-append "no number KFX reads: " s))))
            ((has-char? cs #\.)
             (if (and (real-token? cs) (only-of? (if (char=? (car cs) #\-) (cdr cs) cs) "0123456789."))
                 ;; A real of 1e21 or more too: FX-26 read it as an int,
                 ;; and Fixpt's checkers disagreed, until both read the
                 ;; Rust reader's syntax (Fixpt's 6864363b, C427).
                 (real s file pos)
                 (read-error file line (string-append "no number KFX reads: " s))))
            ((not (only-of? (if (char=? (car cs) #\-) (cdr cs) cs) "0123456789"))
             (read-error file line (string-append "no number KFX reads: " s)))
            ((not (fits-i64? cs)) (big s file pos))
            ((char=? (car cs) #\-) (num (digits-value (cdr cs) 0 file line) file pos))
            (else (num (i64- 0 (digits-value cs 0 file line)) file pos))))))

(define-rec
  (ascii-lowered (subr kfx (chars) chars)
    (lambda (cs)
      (if (null? cs)
          nil
          (cons (let ((k (char->i64 (car cs)))) (if (and (i64>= k 65) (i64<= k 90)) (i64->char (i64+ k 32)) (car cs)))
                (ascii-lowered (cdr cs))))))
  (char-hex-value (subr kfx (chars i64) i64)
    (lambda (cs n)
      "The hexadecimal number `cs` writes, onto `n`; -1 if it writes none."
      (if (null? cs)
          n
          (let* ((k (char->i64 (car cs)))
                 (d (cond ((and (i64>= k 48) (i64<= k 57)) (i64- k 48))
                          ((and (i64>= k 97) (i64<= k 102)) (i64- k 87))
                          (else (the i64 -1)))))
            (if (or (i64< d 0) (i64> n 1114111)) (the i64 -1) (char-hex-value (cdr cs) (i64+ (i64* n 16) d))))))))

(define char-named (subr kfx (string string i64) char)
  (lambda (s file line)
    "A character's name after `#\\`, as Fixpt's reader takes it
     (`fixpt-read`'s `read_char`, C401): one character, itself; else a name,
     its case aside, or `x` and its code in hexadecimal."
    (if (i64= (string-length-i64 s) 1)
        (string-ref-i64 s 0)
        (let ((n (list->string (ascii-lowered (string-chars s)))))
          (cond ((string=? n "space") #\space)
                ((or (string=? n "newline") (string=? n "linefeed") (string=? n "nl")) #\newline)
                ((string=? n "tab") #\tab)
                ((string=? n "return") (i64->char 13))
                ((or (string=? n "null") (string=? n "nul")) (i64->char 0))
                ((string=? n "alarm") (i64->char 7))
                ((string=? n "backspace") (i64->char 8))
                ((or (string=? n "delete") (string=? n "rubout")) (i64->char 127))
                ((or (string=? n "escape") (string=? n "altmode") (string=? n "esc")) (i64->char 27))
                ((char=? (string-ref-i64 n 0) #\x)
                 (let ((k (char-hex-value (cdr (string-chars n)) 0)))
                   (if (or (i64< k 0) (i64> k 1114111) (and (i64>= k 55296) (i64<= k 57343)))
                       (read-error file line (string-append "bad character name `#\\" (string-append s "`")))
                       (i64->char k))))
                (else (read-error file line (string-append "no character is named " s))))))))

(define chars-begin? (subr kfx (chars chars) bool)
  (lambda (cs want)
    "Whether `cs` begins with `want`."
    (cond ((null? want) #t)
          ((null? cs) #f)
          ((char=? (car cs) (car want)) (chars-begin? (cdr cs) (cdr want)))
          (else #f))))

(define utf8-opening? (subr kfx (chars) bool)
  (lambda (cs) "Whether `cs` begins `#utf8\"`." (chars-begin? cs (string-chars "#utf8\""))))

"`#u8(…)` and `#u8\"…\"` (Fixpt 3569ce51; C527): bytes, each `0` to `255`,
 read `(#u8 BYTE …)`, a head no KFX name is, as `#(…)`'s. A byte string's
 characters ASCII, each its byte, a string's escapes, `\\xHH;` any byte;
 its bytes' nodes at offsets within its text, one apart."
(define-rec
  (byte-text-ascii? (subr kfx (chars) bool)
    (lambda (cs)
      "Whether a byte string's characters, to its closing quote, are ASCII."
      (cond ((null? cs) #t)
            ((char=? (car cs) #\") #t)
            ((i64> (char->i64 (car cs)) 127) #f)
            ((and (char=? (car cs) #\\) (not (null? (cdr cs))))
             (and (i64<= (char->i64 (car (cdr cs))) 127) (byte-text-ascii? (cdr (cdr cs)))))
            (else (byte-text-ascii? (cdr cs))))))
  (text-bytes (subr kfx (chars string i64 i64 i64) sexps)
    (lambda (cs file line at n)
      "The text's characters, each at most `FF`, as bytes."
      (cond ((null? cs) nil)
            ((i64> (char->i64 (car cs)) 255) (read-error file line "a byte string's `\\x` escape is at most `FF`"))
            (else (cons (num (char->i64 (car cs)) file (i64+ at n)) (text-bytes (cdr cs) file line at (i64+ n 1)))))))
  (bytes-checked (subr kfx (sexps string i64) sexps)
    (lambda (xs file line)
      "`#u8(…)`'s items, each a byte."
      (cond ((null? xs) nil)
            ((tagcase (car xs) (num (k f p) (and (i64>= k 0) (i64<= k 255))) (else other #f))
             (cons (car xs) (bytes-checked (cdr xs) file line)))
            (else (read-error file line "a bytevector's items are bytes, 0 to 255"))))))

(define-rec
  (read-datum (subr kfx (here string string) got)
    (lambda (h text file)
      "A datum at the start of `h`'s text, the rest of `text`, which `file`
       holds."
      (tagcase h
        (here (cs line pos)
          (let ((c (car cs)))
            (cond ((char=? c #\()
                   (tagcase (read-items (here (cdr cs) line (i64+ pos 1)) text file)
                     (gots (xs after) (got (lst xs file line pos) after))))
                  ((char=? c #\)) (read-error file line "a ) with no ("))
                  ((and (i64= (char->i64 c) 39) (not (null? (cdr cs))) (not (string=? file "")))
                   "`'d`, FX-26's `(quote d)` (C56), in a program's text; in the
                    checker's own (a file named ``), `'r` is a region binder's name."
                   (tagcase (read-datum (skip-at (cdr cs) line (i64+ pos 1)) text file)
                     (got (x after) (got (lst (list (sym "quote" file pos) x) file line pos) after))))
                  ((and (or (i64= (char->i64 c) 96) (i64= (char->i64 c) 44)) (not (null? (cdr cs))) (not (string=? file "")))
                   "`` `d ``, `,d` and `,@d`: FX-26's `quasiquote`, `unquote` and
                    `unquote-splicing` (C79), in a program's text."
                   (let* ((splice (and (i64= (char->i64 c) 44) (char=? (car (cdr cs)) #\@)))
                          (rest (if splice (cdr (cdr cs)) (cdr cs)))
                          (head (cond ((i64= (char->i64 c) 96) "quasiquote") (splice "unquote-splicing") (else "unquote"))))
                     (tagcase (read-datum (skip-at rest line (i64+ pos (if splice 2 1))) text file)
                       (got (x after) (got (lst (list (sym head file pos) x) file line pos) after)))))
                  ((and (char=? c #\#) (not (null? (cdr cs))) (char=? (car (cdr cs)) #\() (not (string=? file "")))
                   "`#(d ...)`, a vector (C80): `(#vector d ...)`, a head no KFX name
                    is, which only a quote takes."
                   (tagcase (read-items (here (cdr (cdr cs)) line (i64+ pos 2)) text file)
                     (gots (xs after) (got (lst (cons (sym "#vector" file pos) xs) file line pos) after))))
                  ((and (utf8-opening? cs) (not (string=? file "")))
                   "`#utf8\"…\"`, UTF-8 text (Fixpt 06a3666): `(#utf8 \"…\")`, a
                    head no KFX name is, as `#(…)`'s; a string's escapes. Its
                    three nodes at three offsets, the `#`, the `u`, the `\"`."
                   (let ((body (cdr (cdr (cdr (cdr (cdr (cdr cs))))))))
                     (tagcase (string-body body text nil (i64+ pos 6) file line (i64+ pos 5) line (i64+ pos 6))
                       (got (x after) (got (lst (list (sym "#utf8" file (i64+ pos 1)) x) file line pos) after)))))
                  ((and (chars-begin? cs (string-chars "#u8(")) (not (string=? file "")))
                   (tagcase (read-items (here (cdr (cdr (cdr (cdr cs)))) line (i64+ pos 4)) text file)
                     (gots (xs after) (got (lst (cons (sym "#u8" file (i64+ pos 1)) (bytes-checked xs file line)) file line pos) after))))
                  ((and (chars-begin? cs (string-chars "#u8\"")) (not (string=? file "")))
                   (let ((body (cdr (cdr (cdr (cdr cs))))))
                     (if (not (byte-text-ascii? body))
                         (read-error file line "a byte string's characters are ASCII: `\\xHH;` for another byte")
                         (tagcase (string-body body text nil (i64+ pos 4) file line (i64+ pos 3) line (i64+ pos 4))
                           (got (x after)
                             (got (lst (cons (sym "#u8" file (i64+ pos 1))
                                             (text-bytes (string-chars (tagcase x (str (t f p) t) (else other ""))) file line (i64+ pos 4) 0))
                                       file line pos)
                                  after))))))
                  ((char=? c #\") (string-body (cdr cs) text nil (i64+ pos 1) file line pos line (i64+ pos 1)))
                  ((and (char=? c #\#) (not (null? (cdr cs))) (char=? (car (cdr cs)) #\\))
                   (let ((name (cdr (cdr cs))))
                     (tagcase (token-at (cdr name) text (i64+ pos 2) 1)
                       (tok (s after n) (got (chr (char-named s file line) file pos) (here after line (i64+ pos (i64+ n 2))))))))
                  (else
                   (tagcase (token-at cs text pos 0)
                     (tok (s after n) (got (token-atom s file line pos) (here after line (i64+ pos n))))))))))))
  (read-items (subr kfx (here string string) gots)
    (lambda (h text file) (read-items-onto h text file nil)))
  (read-items-onto (subr kfx (here string string sexps) gots)
    (lambda (h text file acc)
      "A list's items, onto `acc` reversed, to its `)`: a loop (C524), not a
       frame for each, each holding what it read (pinning a page as a
       collection runs). `at`, not `h`, which a binding of it would hide."
      (let ((at (skip h)))
        (tagcase at
          (here (cs line pos)
            (cond ((null? cs) (read-error file line "a ( with no )"))
                  ((char=? (car cs) #\)) (gots (reverse acc) (here (cdr cs) line (i64+ pos 1))))
                  (else
                   (tagcase (read-datum at text file)
                     (got (x after) (read-items-onto after text file (cons x acc))))))))))))

"Each datum from `h`, onto `acc` reversed, then in order: a loop (C524)."
(define read-onto (subr kfx (here string string sexps) sexps)
  (lambda (h text file acc)
    (let ((at (skip h)))
      (tagcase at
        (here (cs line pos)
          (if (null? cs)
              (reverse acc)
              (tagcase (read-datum at text file)
                (got (x after) (read-onto after text file (cons x acc))))))))))

(define read-from (subr kfx (here string string) sexps)
  (lambda (h text file) (read-onto h text file nil)))

(define read-all (subr kfx (string string i64) sexps)
  (lambda (text file line)
    "Every datum in `text`, of `file` from `line`."
    (read-from (here (string-chars text) line 0) text file)))

"Datum labels (C417), as Fixpt's reader has them for data
 (`fixpt-read`'s `datum_labels`) and its listings write them: `#N=` before
 a datum where it is first written, `#N#` for it after, so that what is
 written once is read once and shared. For data only (`read-data`): FX-26's
 program text has none (`fx26-grammar.md`), so `read-all` reads `#0=` as a
 name, which no program defines. Read as the reader reads any token, then
 resolved, in the order written."
"The labels made so far: an AVL tree by number."
(define-datatype labels (lb-none) (lb-node labels i64 sexp i64 labels))
(define-datatype resolved (resolved sexps labels))

(define lb-height (subr kfx (labels) i64)
  (lambda (t) (tagcase t (lb-none () 0) (lb-node (l k x h r) h))))

(define lb-make (subr kfx (labels i64 sexp labels) labels)
  (lambda (l k x r) (lb-node l k x (i64+ 1 (let ((a (lb-height l)) (b (lb-height r))) (if (i64> a b) a b))) r)))

(define lb-balanced (subr kfx (labels i64 sexp labels) labels)
  (lambda (l k x r)
    (let ((hl (lb-height l)) (hr (lb-height r)))
      (cond ((i64> hl (i64+ hr 1))
             (tagcase l
               (lb-node (ll lk lx lh lr)
                 (if (i64>= (lb-height ll) (lb-height lr))
                     (lb-make ll lk lx (lb-make lr k x r))
                     (tagcase lr (lb-node (rl rk rx rh rr) (lb-make (lb-make ll lk lx rl) rk rx (lb-make rr k x r))) (else o (lb-make l k x r)))))
               (else o (lb-make l k x r))))
            ((i64> hr (i64+ hl 1))
             (tagcase r
               (lb-node (rl rk rx rh rr)
                 (if (i64>= (lb-height rr) (lb-height rl))
                     (lb-make (lb-make l k x rl) rk rx rr)
                     (tagcase rl (lb-node (ll lk lx lh lr) (lb-make (lb-make l k x ll) lk lx (lb-make lr rk rx rr))) (else o (lb-make l k x r)))))
               (else o (lb-make l k x r))))
            (else (lb-make l k x r))))))

(define-rec
  (lb-put (subr kfx (labels i64 sexp) labels)
    (lambda (t k x)
      (tagcase t
        (lb-none () (lb-node (lb-none) k x 1 (lb-none)))
        (lb-node (l j y h r)
          (cond ((i64= k j) (lb-node l j x h r))
                ((i64< k j) (lb-balanced (lb-put l k x) j y r))
                (else (lb-balanced l j y (lb-put r k x))))))))
  (lb-get (subr kfx (labels i64) sexps)
    (lambda (t k)
      (tagcase t
        (lb-none () nil)
        (lb-node (l j y h r) (cond ((i64= k j) (list y)) ((i64< k j) (lb-get l k)) (else (lb-get r k))))))))

(define datum-label-of (subr kfx (sexp string) i64)
  (lambda (e mark)
    "`N` of a name `#N=` (`mark` `=`) or `#N#` (`#`); -1 if it is none."
    (tagcase e
      (sym (n f p)
        (let ((k (string-length-i64 n)))
          (if (and (i64>= k 3) (char=? (string-ref-i64 n 0) #\#)
                   (string=? (substring n (i64->int (i64- k 1)) (i64->int k)) mark)
                   (only-of? (string-chars (substring n 1 (i64->int (i64- k 1)))) "0123456789"))
              (i64- 0 (digits-value (string-chars (substring n 1 (i64->int (i64- k 1)))) 0 f 0))
              -1)))
      (else other -1))))

(define-rec
  (labels-resolved (subr kfx (sexps labels sexps) resolved)
    (lambda (xs ls acc)
      "Items `xs`, each label made and each reference to one resolved, onto
       `acc` (newest first); and the labels after."
      (if (null? xs)
          (resolved (reverse acc) ls)
          (let ((def (datum-label-of (car xs) "=")) (use (datum-label-of (car xs) "#")))
            (cond ((and (i64>= def 0) (not (null? (cdr xs))))
                   (tagcase (datum-resolved (car (cdr xs)) ls)
                     (resolved (ys ls2)
                       (labels-resolved (cdr (cdr xs)) (lb-put ls2 def (car ys)) (cons (car ys) acc)))))
                  ((i64>= use 0)
                   (let ((found (lb-get ls use)))
                     (if (null? found)
                         (begin (error (string-append "kfx: no datum is labelled #" (string-append (i64->string use) "="))) (resolved nil ls))
                         (labels-resolved (cdr xs) ls (cons (car found) acc)))))
                  (else
                   (tagcase (datum-resolved (car xs) ls)
                     (resolved (ys ls2) (labels-resolved (cdr xs) ls2 (cons (car ys) acc))))))))))
  (datum-resolved (subr kfx (sexp labels) resolved)
    (lambda (e ls)
      "A datum, its labels resolved: of a list, its items'."
      (tagcase e
        (lst (xs f l p) (tagcase (labels-resolved xs ls nil) (resolved (ys ls2) (resolved (list (lst ys f l p)) ls2))))
        (else other (resolved (list e) ls))))))

(define read-data (subr kfx (string string) sexps)
  (lambda (text file)
    "Every datum in `text`, data of `file`, its datum labels resolved."
    (tagcase (labels-resolved (read-all text file 1) (lb-none) nil) (resolved (xs ls) xs))))

"Taking `sexp`s apart"

(define datum-file (subr kfx (sexp) string)
  (lambda (e)
    "The file a datum was read from; ``, for one the compiler made."
    (tagcase e
      (sym (n file pos) file) (str (t file pos) file) (num (i file pos) file) (big (t file pos) file)
      (chr (c file pos) file) (lst (xs file line pos) file) (real (t file pos) file))))

(define datum-pos (subr kfx (sexp) i64)
  (lambda (e)
    "Where in its file a datum begins."
    (tagcase e
      (sym (n file pos) pos) (str (t file pos) pos) (num (i file pos) pos) (big (t file pos) pos)
      (chr (c file pos) pos) (lst (xs file line pos) pos) (real (t file pos) pos))))

(define sym-name (subr kfx (sexp) string)
  (lambda (e) (tagcase e (sym (s at-file at-pos) s) (else other (error "kfx: a name is expected")))))

(define sym-is? (subr kfx (sexp string) bool)
  (lambda (e s) (tagcase e (sym (n at-file at-pos) (string=? n s)) (else other #f))))

(define items (subr kfx (sexp) sexps)
  (lambda (e) (tagcase e (lst (xs src-file src-line src-pos) xs) (else other (error "kfx: a list is expected")))))

(define head-is? (subr kfx (sexp string) bool)
  (lambda (e s)
    (tagcase e
      (lst (xs src-file src-line src-pos) (and (not (null? xs)) (sym-is? (car xs) s)))
      (else other #f))))

(define utf8-literal? (subr kfx (sexp) bool)
  (lambda (e)
    "Whether `e` is `#utf8\"…\"` as read, `(#utf8 \"…\")`."
    (and (head-is? e "#utf8")
         (i64= (size (items e)) 2)
         (tagcase (car (cdr (items e))) (str (x f p) #t) (else other #f)))))

(define bytes-literal? (subr kfx (sexp) bool)
  (lambda (e) "Whether `e` is `#u8(…)` or `#u8\"…\"` as read, `(#u8 BYTE …)`." (head-is? e "#u8")))

(define bytes-literal-bytes (subr kfx (sexp) (listof i64 acyclic))
  (lambda (e)
    "Its bytes."
    (map (lambda ((x sexp)) (tagcase x (num (k f p) k) (else other (the i64 0)))) (cdr (items e)))))

(define utf8-literal-text (subr kfx (sexp) string)
  (lambda (e)
    "`#utf8\"…\"`'s text, as a string."
    (tagcase (car (cdr (items e))) (str (x f p) x) (else other ""))))

(define without-conv (subr kfx (sexp) sexp)
  (lambda (t)
    "A type `(subr (conv C) E (T ...) R)` as `(subr E (T ...) R)`: a native
     procedure is in Rust as any is (C116), so past the checker no pass
     need know its convention."
    (tagcase t
      (lst (xs f l p)
        (if (and (head-is? t "subr") (i64= (size xs) 5) (head-is? (car (cdr xs)) "conv"))
            (lst (cons (car xs) (cdr (cdr xs))) f l p)
            t))
      (else other t))))

(define second (subr kfx (sexps) sexp) (lambda (xs) (car (cdr xs))))
(define third (subr kfx (sexps) sexp) (lambda (xs) (car (cdr (cdr xs)))))
(define fourth (subr kfx (sexps) sexp) (lambda (xs) (car (cdr (cdr (cdr xs))))))

(define generative-core (subr kfx (sexp) sexp)
  (lambda (f)
    "A `define-generative`, `(define-generative t T #:seal mk #:unseal get)`,
     as its type and representation alone, `(define-generative t T)`: its
     conversions' names (Fixpt cb172689, C428) are `generative-seal`'s and
     `generative-unseal`'s. Any other form as it is."
    (tagcase f
      (lst (xs fl l p) (if (and (head-is? f "define-generative") (i64> (size xs) 3)) (lst (list (car xs) (second xs) (third xs)) fl l p) f))
      (else other f))))

(define-rec
  (keyed-name (subr kfx (sexps string) string)
    (lambda (xs k)
      "The name after the keyword `k` among `xs`, pairs of a keyword and a
       name; or the empty string."
      (cond ((or (null? xs) (null? (cdr xs))) "")
            ((and (sym-is? (car xs) k) (tagcase (second xs) (sym (n f p) #t) (else other #f))) (sym-name (second xs)))
            (else (keyed-name (cdr (cdr xs)) k))))))

(define generative-named (subr kfx (sexp string) string)
  (lambda (f k)
    (tagcase f
      (lst (xs fl l p) (if (i64> (size xs) 3) (keyed-name (cdr (cdr (cdr xs))) k) ""))
      (else other ""))))

(define generative-seal (subr kfx (sexp) string)
  (lambda (f) "A `define-generative`'s conversion into its type, `#:seal`'s name." (generative-named f "#:seal")))

(define generative-unseal (subr kfx (sexp) string)
  (lambda (f) "Its conversion out of it, `#:unseal`'s." (generative-named f "#:unseal")))

(define param-name (subr kfx (sexp) string)
  (lambda (param)
    "A lambda's parameter's name: it is `x` or `(x T)`."
    (sym-name (tagcase param (lst (xs src-file src-line src-pos) (car xs)) (else other other)))))

(define lambda-form? (subr kfx (sexp) bool)
  (lambda (e) (or (head-is? e "lambda") (head-is? e "plambda"))))
