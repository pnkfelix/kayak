"read.kfx: the reader, from characters to `sexp`s, and taking them apart."

"Reading"

"A list remembers where it began: its file's name, the line of its `(`,
 from 1, and its offset, in characters from 0; a number its file and
 offset. Messages say where (check.kfx's `refuse`), and the checker's
 facts about a place are keyed by its file and offset (`fact`), which no
 two nodes of a file share."
(define-datatype sexp
  (sym string string i64)
  (str string string i64)
  (num i64 string i64)
  (big string string i64)
  (chr char string i64)
  (lst (listof sexp acyclic) string i64 i64)
  (real string string i64))

(define-type sexps (listof sexp acyclic))

"Where reading is: the text left, its line, and its offset."
(define-datatype here (here chars i64 i64))

"A datum, and where reading is after it; the same for the items of a
 list; a token, the text after it, and its length, which a token's end
 leaves on its line."
(define-datatype got (got sexp here))
(define-datatype gots (gots sexps here))
(define-datatype tok (tok string chars i64))

(define read-error (subr kfx (string i64 string) void)
  (lambda (file line message)
    (error (string-append "kfx: " (string-append file (string-append ":"
             (string-append (i64->string line) (string-append ": " message))))))))

(define skip-line (subr kfx (chars i64) here)
  (lambda (cs pos)
    "A comment's text, to the newline that ends it, which is left. The line
     is not counted here, but by `skip`, which meets the newline."
    (cond ((null? cs) (here cs 0 pos))
          ((char=? (car cs) #\newline) (here cs 0 pos))
          (else (skip-line (cdr cs) (i64+ pos 1))))))

(define skip (subr kfx (here) here)
  (lambda (h)
    "Skips whitespace and comments, counting lines and characters."
    (tagcase h
      (here (cs line pos)
        (cond ((null? cs) h)
              ((char=? (car cs) #\newline) (skip (here (cdr cs) (i64+ line 1) (i64+ pos 1))))
              ((char-whitespace? (car cs)) (skip (here (cdr cs) line (i64+ pos 1))))
              ((char=? (car cs) #\;)
               (tagcase (skip-line (cdr cs) (i64+ pos 1))
                 (here (rest zero after) (skip (here rest line after)))))
              (else h))))))

(define delimiter? (subr kfx (char) bool)
  (lambda (c)
    (or (char-whitespace? c) (char=? c #\() (char=? c #\)) (char=? c #\") (char=? c #\;))))

(define token-chars (subr kfx (chars chars i64) tok)
  (lambda (cs acc n)
    "A token's characters, onto `acc`, newest first, and `n`, how many."
    (if (or (null? cs) (delimiter? (car cs)))
        (tok (rev->string acc) cs n)
        (token-chars (cdr cs) (cons (car cs) acc) (i64+ n 1)))))

(define unescape (subr kfx (char) char)
  (lambda (c) (case c ((#\n) #\newline) ((#\t) #\tab) ((#\r) (i64->char 13)) (else c))))

(define hex-escape (subr kfx (chars i64 i64) tok)
  (lambda (cs n k)
    "R7RS's hex escape in a string (a backslash, `x41;`), after its `x`: the hex digits' value `n`,
     `k` of them read, up to the `;`; the rest, as a token's text, the
     character it names."
    (cond ((null? cs) (tok "" cs k))
          ((i64= (char->i64 (car cs)) 59) (tok (char->string (i64->char n)) (cdr cs) (i64+ k 1)))
          (else
           (let* ((c (car cs)) (d (char->i64 c)))
             (hex-escape (cdr cs)
                         (i64+ (i64* n 16)
                               (cond ((and (i64>= d 48) (i64<= d 57)) (i64- d 48))
                                     ((and (i64>= d 97) (i64<= d 102)) (i64- d 87))
                                     ((and (i64>= d 65) (i64<= d 70)) (i64- d 55))
                                     (else 0)))
                         (i64+ k 1)))))))

(define string-body (subr kfx (chars chars string i64 i64 i64 i64) got)
  (lambda (cs acc file start at line pos)
    "A string's characters, after its opening quote on line `start`, at
     offset `at`."
    (cond ((null? cs) (read-error file start "a string is not closed"))
          ((char=? (car cs) #\") (got (str (rev->string acc) file at) (here (cdr cs) line (i64+ pos 1))))
          ((and (char=? (car cs) #\\) (not (null? (cdr cs))) (i64= (char->i64 (car (cdr cs))) 120))
           (tagcase (hex-escape (cdr (cdr cs)) 0 0)
             (tok (text rest k)
               (if (string=? text "")
                   (read-error file start "a string's hex escape is not closed by ;")
                   (string-body rest (cons (string-ref-i64 text 0) acc) file start at line (i64+ pos (i64+ k 2)))))))
          ((char=? (car cs) #\\)
           (string-body (cdr (cdr cs)) (cons (unescape (car (cdr cs))) acc) file start at line (i64+ pos 2)))
          ((char=? (car cs) #\newline)
           (string-body (cdr cs) (cons (car cs) acc) file start at (i64+ line 1) (i64+ pos 1)))
          (else (string-body (cdr cs) (cons (car cs) acc) file start at line (i64+ pos 1))))))

(define digits-value (subr kfx (chars i64 string i64) i64)
  (lambda (cs n file line)
    "Digits onto `n`, negated: so that -9223372036854775808, whose
     magnitude is no i64, reads. A literal past an i64 is refused, as FX-26
     refuses it where an i64 is expected."
    (if (null? cs)
        n
        (let ((d (i64- (char->i64 (car cs)) 48)))
          (if (or (i64< n -922337203685477580)
                  (and (i64= n -922337203685477580) (i64> d 8)))
              (read-error file line "a literal past an i64")
              (digits-value (cdr cs) (i64- (i64* n 10) d) file line))))))

(define numeric? (subr kfx (chars) bool)
  (lambda (cs)
    (and (not (null? cs))
         (or (char-numeric? (car cs))
             (and (char=? (car cs) #\-) (not (null? (cdr cs))) (char-numeric? (car (cdr cs))))))))

(define has-char? (subr kfx (chars char) bool)
  (lambda (cs c) (and (not (null? cs)) (or (char=? (car cs) c) (has-char? (cdr cs) c)))))

(define point-count (subr kfx (chars i64) i64)
  (lambda (cs n)
    "How many points `cs` has, or -1 if it has a character that is no
     digit and no point."
    (cond ((null? cs) n)
          ((char=? (car cs) #\.) (point-count (cdr cs) (i64+ n 1)))
          ((char-numeric? (car cs)) (point-count (cdr cs) n))
          (else -1))))

(define real-token? (subr kfx (chars) bool)
  (lambda (cs)
    "Digits, after a `-` if any, with one point among them: a real, as FX-26
     reads it (and Rust, written with a digit either side of the point)."
    (i64= (point-count (if (char=? (car cs) #\-) (cdr cs) cs) 0) 1)))

(define-rec
  (digits-after-zeros (subr kfx (chars) chars)
    (lambda (cs) (if (and (not (null? cs)) (not (null? (cdr cs))) (char=? (car cs) #\0)) (digits-after-zeros (cdr cs)) cs))))

(define-rec
  (digits-at-most? (subr kfx (chars chars) bool)
    (lambda (cs most)
      "Whether digits `cs` are at most `most`, of as many digits."
      (cond ((null? cs) #t)
            ((i64< (char->i64 (car cs)) (char->i64 (car most))) #t)
            ((i64> (char->i64 (car cs)) (char->i64 (car most))) #f)
            (else (digits-at-most? (cdr cs) (cdr most)))))))

(define fits-i64? (subr kfx (chars) bool)
  (lambda (cs)
    "Whether an integer literal is an i64's; one past is an `int`'s alone."
    (let* ((negative (char=? (car cs) #\-))
           (ds (digits-after-zeros (if negative (cdr cs) cs)))
           (n (size ds)))
      (cond ((i64< n 19) #t)
            ((i64> n 19) #f)
            (else (digits-at-most? ds (string-chars (if negative "9223372036854775808" "9223372036854775807"))))))))

(define only-of? (subr kfx (chars string) bool)
  (lambda (cs allowed)
    "Whether every character of `cs` is one of `allowed`'s."
    (not (any? (lambda ((c char)) (not (has-char? (string-chars allowed) c))) cs))))

(define-rec
  (before-point (subr kfx (chars) chars)
    (lambda (cs) (if (or (null? cs) (char=? (car cs) #\.)) nil (cons (car cs) (before-point (cdr cs)))))))

(define hex-value (subr kfx (chars i64 string i64) i64)
  (lambda (cs n file line)
    "Hex digits onto `n`, as `digits-value`'s are, negated; one past an i64
     refused (C116: Fixpt's arm64 encoder writes its instructions so)."
    (if (null? cs)
        n
        (let* ((c (char-downcase (car cs)))
               (d (if (char-numeric? c) (i64- (char->i64 c) 48) (i64+ 10 (i64- (char->i64 c) 97)))))
          (if (i64< n -576460752303423487)
              (read-error file line "a hex literal past an i64, which KFX reads not yet")
              (hex-value (cdr cs) (i64- (i64* n 16) d) file line))))))

(define token-atom (subr kfx (string string i64 i64) sexp)
  (lambda (s file line pos)
    (let ((cs (string-chars s)))
      (cond ((and (char=? (car cs) #\#) (not (null? (cdr cs))) (or (char=? (car (cdr cs)) #\x) (char=? (car (cdr cs)) #\X))
                  (not (null? (cdr (cdr cs)))))
             "A hex literal, `#x1f`, `#x-1f`, R7RS's, as FX-26 reads it."
             (let* ((ds (cdr (cdr cs)))
                    (negative (char=? (car ds) #\-))
                    (ds (if (or negative (char=? (car ds) #\+)) (cdr ds) ds)))
               (if (or (null? ds) (not (only-of? ds "0123456789abcdefABCDEF")))
                   (read-error file line (string-append "no number KFX reads: " s))
                   (let ((n (hex-value ds 0 file line)))
                     (if negative (num n file pos)
                         (if (i64= n -9223372036854775808)
                             (read-error file line "a hex literal past an i64, which KFX reads not yet")
                             (num (i64- 0 n) file pos)))))))
            ((not (numeric? cs)) (sym s file pos))
            ((not (only-of? (if (char=? (car cs) #\-) (cdr cs) cs) "0123456789.eE+-"))
             "Not a number, though a digit begins it (`1x`, `0x10`): a name, as
              FX-26 reads it."
             (sym s file pos))
            ((or (has-char? cs #\e) (has-char? cs #\E))
             (read-error file line (string-append "a number with an exponent, which KFX reads not: write it out, " s)))
            ((has-char? cs #\.)
             (if (and (real-token? cs) (only-of? (if (char=? (car cs) #\-) (cdr cs) cs) "0123456789."))
                 (if (i64> (size (digits-after-zeros (before-point (if (char=? (car cs) #\-) (cdr cs) cs)))) 21)
                     (read-error file line (string-append "a real of 1e21 or more, which FX-26 reads as an int: " s))
                     (real s file pos))
                 (read-error file line (string-append "no number KFX reads: " s))))
            ((not (only-of? (if (char=? (car cs) #\-) (cdr cs) cs) "0123456789"))
             (read-error file line (string-append "no number KFX reads: " s)))
            ((not (fits-i64? cs)) (big s file pos))
            ((char=? (car cs) #\-) (num (digits-value (cdr cs) 0 file line) file pos))
            (else (num (i64- 0 (digits-value cs 0 file line)) file pos))))))

(define char-named (subr kfx (string string i64) char)
  (lambda (s file line)
    (cond ((i64= (string-length-i64 s) 1) (string-ref-i64 s 0))
          ((string=? s "space") #\space)
          ((string=? s "newline") #\newline)
          ((string=? s "tab") #\tab)
          (else (read-error file line (string-append "no character is named " s))))))

(define-rec
  (read-datum (subr kfx (here string) got)
    (lambda (h file)
      "A datum at the start of `h`'s text, which `file` holds."
      (tagcase h
        (here (cs line pos)
          (let ((c (car cs)))
            (cond ((char=? c #\()
                   (tagcase (read-items (here (cdr cs) line (i64+ pos 1)) file)
                     (gots (xs after) (got (lst xs file line pos) after))))
                  ((char=? c #\)) (read-error file line "a ) with no ("))
                  ((and (i64= (char->i64 c) 39) (not (null? (cdr cs))) (not (string=? file "")))
                   "`'d`, FX-26's `(quote d)` (C56), in a program's text; in the
                    checker's own (a file named ``), `'r` is a region binder's name."
                   (tagcase (read-datum (skip (here (cdr cs) line (i64+ pos 1))) file)
                     (got (x after) (got (lst (list (sym "quote" file pos) x) file line pos) after))))
                  ((and (or (i64= (char->i64 c) 96) (i64= (char->i64 c) 44)) (not (null? (cdr cs))) (not (string=? file "")))
                   "`` `d ``, `,d` and `,@d`: FX-26's `quasiquote`, `unquote` and
                    `unquote-splicing` (C79), in a program's text."
                   (let* ((splice (and (i64= (char->i64 c) 44) (char=? (car (cdr cs)) #\@)))
                          (rest (if splice (cdr (cdr cs)) (cdr cs)))
                          (head (cond ((i64= (char->i64 c) 96) "quasiquote") (splice "unquote-splicing") (else "unquote"))))
                     (tagcase (read-datum (skip (here rest line (i64+ pos (if splice 2 1)))) file)
                       (got (x after) (got (lst (list (sym head file pos) x) file line pos) after)))))
                  ((and (char=? c #\#) (not (null? (cdr cs))) (char=? (car (cdr cs)) #\() (not (string=? file "")))
                   "`#(d ...)`, a vector (C80): `(#vector d ...)`, a head no KFX name
                    is, which only a quote takes."
                   (tagcase (read-items (here (cdr (cdr cs)) line (i64+ pos 2)) file)
                     (gots (xs after) (got (lst (cons (sym "#vector" file pos) xs) file line pos) after))))
                  ((char=? c #\") (string-body (cdr cs) nil file line pos line (i64+ pos 1)))
                  ((and (char=? c #\#) (not (null? (cdr cs))) (char=? (car (cdr cs)) #\\))
                   (let ((name (cdr (cdr cs))))
                     (tagcase (token-chars (cdr name) (list (car name)) 1)
                       (tok (s after n) (got (chr (char-named s file line) file pos) (here after line (i64+ pos (i64+ n 2))))))))
                  (else
                   (tagcase (token-chars cs nil 0)
                     (tok (s after n) (got (token-atom s file line pos) (here after line (i64+ pos n))))))))))))
  (read-items (subr kfx (here string) gots)
    (lambda (h file)
      (let ((h (skip h)))
        (tagcase h
          (here (cs line pos)
            (cond ((null? cs) (read-error file line "a ( with no )"))
                  ((char=? (car cs) #\)) (gots nil (here (cdr cs) line (i64+ pos 1))))
                  (else
                   (tagcase (read-datum h file)
                     (got (x after)
                       (tagcase (read-items after file)
                         (gots (xs rest) (gots (cons x xs) rest)))))))))))))

(define read-from (subr kfx (here string) sexps)
  (lambda (h file)
    (let ((h (skip h)))
      (tagcase h
        (here (cs line pos)
          (if (null? cs)
              nil
              (tagcase (read-datum h file)
                (got (x after) (cons x (read-from after file))))))))))

(define read-all (subr kfx (chars string i64) sexps)
  (lambda (cs file line)
    "Every datum in `cs`, the text of `file` from `line`."
    (read-from (here cs line 0) file)))

"Taking `sexp`s apart"

(define datum-file (subr kfx (sexp) string)
  (lambda (e)
    "The file a datum was read from; ``, for one the compiler made."
    (tagcase e
      (sym (n file pos) file) (str (t file pos) file) (num (i file pos) file) (big (t file pos) file)
      (chr (c file pos) file) (lst (xs file line pos) file) (real (t file pos) file))))

(define datum-pos (subr kfx (sexp) i64)
  (lambda (e)
    "Where in its file a datum begins."
    (tagcase e
      (sym (n file pos) pos) (str (t file pos) pos) (num (i file pos) pos) (big (t file pos) pos)
      (chr (c file pos) pos) (lst (xs file line pos) pos) (real (t file pos) pos))))

(define sym-name (subr kfx (sexp) string)
  (lambda (e) (tagcase e (sym (s at-file at-pos) s) (else other (error "kfx: a name is expected")))))

(define sym-is? (subr kfx (sexp string) bool)
  (lambda (e s) (tagcase e (sym (n at-file at-pos) (string=? n s)) (else other #f))))

(define items (subr kfx (sexp) sexps)
  (lambda (e) (tagcase e (lst (xs src-file src-line src-pos) xs) (else other (error "kfx: a list is expected")))))

(define head-is? (subr kfx (sexp string) bool)
  (lambda (e s)
    (tagcase e
      (lst (xs src-file src-line src-pos) (and (not (null? xs)) (sym-is? (car xs) s)))
      (else other #f))))

(define without-conv (subr kfx (sexp) sexp)
  (lambda (t)
    "A type `(subr (conv C) E (T ...) R)` as `(subr E (T ...) R)`: a native
     procedure is in Rust as any is (C116), so past the checker no pass
     need know its convention."
    (tagcase t
      (lst (xs f l p)
        (if (and (head-is? t "subr") (i64= (size xs) 5) (head-is? (car (cdr xs)) "conv"))
            (lst (cons (car xs) (cdr (cdr xs))) f l p)
            t))
      (else other t))))

(define second (subr kfx (sexps) sexp) (lambda (xs) (car (cdr xs))))
(define third (subr kfx (sexps) sexp) (lambda (xs) (car (cdr (cdr xs)))))
(define fourth (subr kfx (sexps) sexp) (lambda (xs) (car (cdr (cdr (cdr xs))))))

(define param-name (subr kfx (sexp) string)
  (lambda (param)
    "A lambda's parameter's name: it is `x` or `(x T)`."
    (sym-name (tagcase param (lst (xs src-file src-line src-pos) (car xs)) (else other other)))))

(define lambda-form? (subr kfx (sexp) bool)
  (lambda (e) (or (head-is? e "lambda") (head-is? e "plambda"))))
