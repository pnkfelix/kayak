"check-exprs.kfx: checking expressions (check.kfx), and what they need
 of shapes and modules. Split from check.kfx."

"The checking of expressions is a module (C92): its many helpers hidden,
 what checking definitions needs (check-defs.kfx) given."
(define expressions
  (module
    (hide
      (define unplaced? (subr kfx (ty) bool)
        (lambda (t)
          "A cell or array whose region nothing named, and so was taken as
           `acyclic`: FX-26's is a fresh region, KFX's would be no region, its
           effects lost."
          (tagcase t
            (ty-ref (e r) (tagcase r (ty-rconst (n) (string=? n "acyclic")) (else other #f)))
            (ty-flat (e r) (tagcase r (ty-rconst (n) (string=? n "acyclic")) (else other #f)))
            (ty-tag (a h d r) (tagcase r (ty-rconst (n) (or (string=? n "acyclic") (string=? n "%fresh"))) (else other #f)))
            (else other #f))))

      (define knot-free-call (subr kfx (cv res) res)
        (lambda (v r)
          "A call's value, whose type, an instance, ties no knot through the store."
          (tagcase r
            (res (t es s)
              (begin (no-knot v (lambda ((x string)) (resolve-atom s x)) (zonk s t))
                     (if (unplaced? (zonk s t))
                         (refuse v "mutable data at no region a type names: write its region, (the (ref T @r) ...)")
                         r))))))

      (define-rec
        (distinct (subr kfx (strings) strings)
          (lambda (xs)
            "`xs`, each once, in the order of its last."
            (cond ((null? xs) nil)
                  ((string-member? (car xs) (cdr xs)) (distinct (cdr xs)))
                  (else (cons (car xs) (distinct (cdr xs))))))))

      (define blob-form? (subr kfx (string) bool)
        (lambda (h)
          (string-member? h (list "make-bloblet" "rmake-bloblet" "bloblet-ref" "bloblet-set!" "bloblet-byte" "bloblet-set-byte!"
                                  "bloblet-bytes" "blobref-at" "blobref+" "blobref-owner" "blobref-offset" "blobref-get"
                                  "blobref-set!" "blobref-index" "blobref-variant!" "blobref-length"))))

      (define-rec
        (list-ref-i64 (subr kfx (tys i64) ty)
          (lambda (ts i) (if (i64= i 0) (car ts) (list-ref-i64 (cdr ts) (i64- i 1))))))

      (define blob-noted (subr kfx (cv st string) st)
        (lambda (v s what)
          "`s`, `what` noted at the form being checked, if it is not ``."
          (if (string=? what "") s (note-fact s (cv-file v) (cv-pos v) what))))

      "Turbofish: the types a poly procedure is called at, and a `nil`'s or an
       empty list's element, which rustc may find nothing else to infer from.
       Noted as inference variables, `turbofish-metas ?k ...`, at the call's or
       the datum's place; settled when the definition is, each a type as written,
       an unsolved one `void`: a type nothing in FX-26 says, of no value, which
       rustc needs one of and the program never meets."

      (define-rec
        (settled-sexp (subr kfx (st ty bool) sexp)
          (lambda (s t region)
            "A type, or with `region` a region, as written, after the definition:
             an inference variable unsolved is `void`, or the heap."
            (tagcase (walk s t)
              (ty-meta (k) (sym (if region "@heap" "void") "" 0))
              (ty-var (n) (sym n "" 0))
              (ty-rconst (n) (sym n "" 0))
              (ty-list (e r) (lst (list (sym "listof" "" 0) (settled-sexp s e #f) (settled-sexp s r #t)) "" 0 0))
              (ty-flat (e r) (lst (list (sym "flatarrayof" "" 0) (settled-sexp s e #f) (settled-sexp s r #t)) "" 0 0))
              (ty-ref (e r) (lst (list (sym "ref" "" 0) (settled-sexp s e #f) (settled-sexp s r #t)) "" 0 0))
              (ty-tag (a h d r) (lst (list (sym "prompt-tag" "" 0) (settled-sexp s a #f) (settled-sexp s h #f) (sym "pure" "" 0) (settled-sexp s r #t)) "" 0 0))
              (ty-data (d args)
                (cond ((null? args) (sym d "" 0))
                      ((string=? d "%bloblet")
                       (lst (list (sym "bloblet" "" 0) (lst (cons (sym "fields" "" 0) (map (lambda ((x ty)) (settled-sexp s x #f)) (cdr args))) "" 0 0)
                                  (settled-sexp s (car args) #t)) "" 0 0))
                      ((string=? d "%blobref") (lst (cons (sym "blobref" "" 0) (map (lambda ((x ty)) (settled-sexp s x #f)) args)) "" 0 0))
                      ((string=? d "%bytes") (lst (list (sym "bytevectorof" "" 0) (settled-sexp s (car args) #t)) "" 0 0))
                      ((string=? d "%array") (lst (list (sym "arrayof" "" 0) (settled-sexp s (car args) #f) (settled-sexp s (car (cdr args)) #t)) "" 0 0))
                      ((string=? d "%flat-array") (lst (cons (sym "arrayof" "" 0) (map (lambda ((x ty)) (settled-sexp s x #f)) args)) "" 0 0))
                      ((string=? d "%place") (lst (list (sym "place" "" 0) (settled-sexp s (car args) #t)) "" 0 0))
                      ((string=? d "%mark-key")
                       (lst (list (sym "mark-key" "" 0) (settled-sexp s (car args) #f) (settled-sexp s (car (cdr args)) #t)) "" 0 0))
                      ((string=? d "%poly")
                       (lst (list (sym "poly" "" 0)
                                  (lst (map (lambda ((n string)) (lst (list (sym (written-binder n) "" 0) (sym (binder-kind n) "" 0)) "" 0 0)) (poly-binders-of args)) "" 0 0)
                                  (settled-sexp s (poly-written args) #f))
                            "" 0 0))
                      ((string=? d "%escape-tag")
                       (lst (list (sym "escape-tag" "" 0) (settled-sexp s (car args) #f) (settled-sexp s (car (cdr args)) #f) (settled-sexp s (car (cdr (cdr args))) #t)) "" 0 0))
                      ((or (string=? d "%addr") (string=? d "%inbox") (string=? d "%icell"))
                       (lst (list (sym (after-prefix d "%") "" 0) (settled-sexp s (car args) #f) (settled-sexp s (car (cdr args)) #t)) "" 0 0))
                      ((string=? d "%flat-sum")
                       (lst (cons (sym "sumof" "" 0)
                                  (cons (tagcase (car args) (ty-rconst (n) (sym n "" 0)) (else other (sym "u8" "" 0)))
                                        (map (lambda ((f fvar)) (tagcase f (fvar (l x) (lst (list (sym l "" 0) (settled-sexp s x #f)) "" 0 0))))
                                             (flat-sum-variants args))))
                            "" 0 0))
                      (else (lst (cons (sym d "" 0) (map (lambda ((x ty)) (settled-sexp s x #f)) args)) "" 0 0))))
              (ty-shape (p ls ts) (lst (cons (sym (if p "productof" "sumof") "" 0) (settled-fields s ls ts)) "" 0 0))
              (ty-proc (es ps r)
                (lst (list (sym "subr" "" 0) (cond ((suspends? es) (lst (list (sym "maxeff" "" 0) (lst (list (sym "goto" "" 0) (sym "@escape" "" 0)) "" 0 0) (lst (list (sym "comefrom" "" 0) (sym "@escape" "" 0)) "" 0 0)) "" 0 0))
                                                      ((escapes? es) (lst (list (sym "goto" "" 0) (sym "@escape" "" 0)) "" 0 0))
                                                      ((crossing? (map (lambda ((a string)) (resolve-atom s a)) es)) (sym "pure" "" 0))
                                                      (else (sym "%local" "" 0)))
                           (lst (map (lambda ((p ty)) (settled-sexp s p #f)) ps) "" 0 0) (settled-sexp s r #f)) "" 0 0))
              (else other (sym (show-ty s other) "" 0)))))
        (settled-fields (subr kfx (st strings tys) sexps)
          (lambda (s ls ts)
            (if (or (null? ls) (null? ts))
                nil
                (cons (lst (list (sym (car ls) "" 0) (settled-sexp s (car ts) #f)) "" 0 0) (settled-fields s (cdr ls) (cdr ts)))))))

      (define-rec
        (facts-after (subr kfx (facts string) strings)
          (lambda (fs prefix)
            "Of the facts `fs`, each that begins `prefix`, the rest: one pass,
             making a pair only for each found."
            (cond ((null? fs) nil)
                  ((tagcase (car fs) (fact (ff fp what) (has-prefix? what prefix)))
                   (cons (tagcase (car fs) (fact (ff fp what) (after-prefix what prefix))) (facts-after (cdr fs) prefix)))
                  (else (facts-after (cdr fs) prefix))))))

      (define given-place? (subr kfx (scheme) bool)
        (lambda (sc)
          "Whether a procedure is given a place, `(place p)` (C34): only then has
           it `place-needs` or `region-within` facts to look for."
          (tagcase sc
            (scheme (tvars t)
              (tagcase t
                (ty-proc (es ps r)
                  (any? (lambda ((p ty)) (tagcase p (ty-data (d args) (string=? d "%place")) (else other #f))) ps))
                (else other #f))))))

      (define-datatype fresh-metas (fresh-metas (listof i64 acyclic) st))

      (define-rec
        (fresh-for (subr kfx (st tys) fresh-metas)
          (lambda (s ts)
            "An inference variable for each of `ts`, solved to it: what a
             turbofish notes, settled with the definition."
            (if (null? ts)
                (fresh-metas nil s)
                (tagcase (walk s (car ts))
                  (ty-meta (k) (tagcase (fresh-for s (cdr ts)) (fresh-metas (ks s) (fresh-metas (cons k ks) s))))
                  (else other
                    (tagcase (fresh s)
                      (res (m es s)
                        (tagcase m
                          (ty-meta (k) (tagcase (fresh-for (solve s k other) (cdr ts)) (fresh-metas (ks s) (fresh-metas (cons k ks) s))))
                          (else other2 (fresh-metas nil s)))))))))))

      (define note-types (subr kfx (st string i64 string tys) st)
        (lambda (s file pos what ts)
          "That the datum at `file`, `pos` has `what`, types `ts`, settled with
           the definition: `what T ...`."
          (tagcase (fresh-for s ts)
            (fresh-metas (ks s)
              (note-fact s file pos (string-append "%metas " (string-append what (string-append " " (words-of (map meta-name ks))))))))))

      (define note-turbofish (subr kfx (st string i64 tys) st)
        (lambda (s file pos ts)
          "That the datum at `file`, `pos` is written at types `ts`."
          (if (null? ts) s (note-types s file pos "turbofish" ts))))

      (define binder-metas (subr kfx (i64 i64 (listof i64 acyclic)) (listof i64 acyclic))
        (lambda (from to regions)
          "The inference variables a poly's instantiation made, `from` to `to`,
           its type binders': not its regions'."
          (if (not (i64< from to))
              nil
              (let ((rest (binder-metas (i64+ from 1) to regions)))
                (if (any? (lambda ((r i64)) (i64= r from)) regions) rest (cons from rest))))))

      (define-rec
        (member-type (subr kfx (string strings tys) ty)
          (lambda (l ls ts)
            (if (string=? (car ls) l) (car ts) (member-type l (cdr ls) (cdr ts))))))

      (define sum-arm (subr kfx (sexp) sexp)
        (lambda (arm)
          "A tagcase arm of a sum, as a datatype's: `(tag x body ...)`, binding
           the member, is `(tag (x) body ...)`."
          (tagcase arm
            (lst (xs file line pos)
              (if (or (sym-is? (car xs) "else") (null? (cdr xs)))
                  arm
                  (tagcase (second xs)
                    (sym (x at-file at-pos) (lst (cons (car xs) (cons (lst (list (second xs)) "" 0 0) (cdr (cdr xs)))) file line pos))
                    (else other arm))))
            (else other arm))))

      (define-rec
        (unholed (subr kfx (sexps) sexps)
          (lambda (xs) (cond ((null? xs) nil) ((draft-hole? (car xs)) (unholed (cdr xs))) (else (cons (car xs) (unholed (cdr xs))))))))

      (define sum-variants (subr kfx (cv strings tys sexps) variants)
        (lambda (v ls ts arms)
          "A sum's tags as variants: a member taken apart by its arm, `(tag (x y)
           ...)`, of the fields of the product it is; else of the member."
          (if (null? ls)
              nil
              (let ((arm (concat (map (lambda ((a sexp))
                                        (if (and (not (null? (items a))) (string=? (label-of (car (items a))) (car ls))) (the sexps (list a)) nil))
                                      arms))))
                (cons (variant (car ls)
                               (if (and (not (null? arm)) (i64> (size (items (car arm))) 1)
                                        (tagcase (second (items (car arm))) (lst (xs f l p) #t) (else other #f)))
                                   (tagcase (car ts)
                                     (ty-shape (p ms us) (if p us (refuse v (string-append "the arm for " (string-append (car ls) " takes apart a sum")))))
                                     (else other (refuse v (string-append "the arm for " (string-append (car ls) " takes apart no product")))))
                                   (list (car ts))))
                      (sum-variants v (cdr ls) (cdr ts) arms))))))

      "Modules as parameters (CLAUDES_CHOICES.md C24): a `define-type` of a
       `(moduleof (abs t type) (desc u T) (val x T) ...)` names a module type, a
       Rust trait; a top-level procedure's parameter of it, a type parameter.
       `(abs (a b) type)` gives several. Within, a parameter `m`'s abstract types
       are `m..t`, as FX-26 names them."

      (define spec-items (subr kfx (sexp string) (listof sexps acyclic))
        (lambda (spec kind)
          "A moduleof's items of `kind`: `abs`, `desc` or `val`."
          (concat (map (lambda ((x sexp)) (if (head-is? x kind) (the (listof sexps acyclic) (list (items x))) nil))
                       (cdr (items spec))))))

      (define spec-abs (subr kfx (sexp) strings)
        (lambda (spec)
          (concat (map (lambda ((a sexps))
                         (tagcase (second a)
                           (sym (n at-file at-pos) (the strings (list n)))
                           (lst (ns f l p) (map sym-name ns))
                           (else other nil)))
                       (spec-items spec "abs")))))

      (define spec-value-words (subr kfx (sexp) string)
        (lambda (spec)
          "A moduleof's values' names, in order: where a module of its type
           keeps each, which FX-26's cellular code is told (C144)."
          (words-of (map (lambda ((x sexps)) (sym-name (second x))) (spec-items spec "val")))))

      (define mtype-value-names (subr kfx (ty) strings)
        (lambda (t) (map mitem-name (filter (lambda ((x ty)) (string=? (mitem-kind x) "%val")) (mtype-items t)))))

      (define mtype-opened (subr kfx (cv ty) cv)
        (lambda (v t)
          "`v` in a `with` of a module of type `t` (C170): its values, its types
           (an abstract one as its type names it) and its effects in scope,
           shadowing what is outside."
          (let ((its (mtype-items t)))
            (with-binds
              (with-type-binds v
                (concat (map (lambda ((x ty))
                               (tagcase x
                                 (ty-data (d args)
                                   (cond ((string=? (mitem-kind x) "%desc") (the binds (list (type-bind (mitem-name x) (car args)))))
                                         ((string=? (mitem-kind x) "%abs") (the binds (list (type-bind (mitem-name x) (car args)))))
                                         (else nil)))
                                 (else other nil)))
                             its))
                (concat (map (lambda ((x ty))
                               (if (string=? (mitem-kind x) "%edesc")
                                   (tagcase x (ty-data (d args) (the effdefs (list (effdef (mitem-name x) (tagcase (car args) (ty-proc (es ps r) es) (else other nil)))))) (else other nil))
                                   nil))
                             its)))
              (concat (map (lambda ((x ty))
                             (if (string=? (mitem-kind x) "%val")
                                 (tagcase x (ty-data (d args) (the binds (list (local v (mitem-name x) (car args))))) (else other nil))
                                 nil))
                           its))))))

      (define module-spec (subr kfx (cv ty) sexps)
        (lambda (v t)
          "The moduleof a module type names, as a list of one; or none."
          (tagcase t
            (ty-data (d args)
              (if (has-prefix? d "%module ")
                  (let ((found (find-alias (after-prefix d "%module ") (cv-aliases v))))
                    (if (null? found) nil (tagcase (car found) (alias (n ps body) (the sexps (list body))))))
                  nil))
            (else other nil))))

      (define-rec
        (fold-values (subr kfx (cv st string binds) st)
          (lambda (v s m bs)
            (if (null? bs)
                s
                (tagcase (car bs)
                  (bind (n sc w)
                    (let ((found (scope-bind (string-append m (string-append " " n)) v)))
                      (if (null? found)
                          (refuse v (string-append m (string-append " gives no value " n)))
                          (tagcase (car found)
                            (bind (n2 sc2 w2)
                              (tagcase (instantiate s sc2)
                                (inst (t s regions effects)
                                  (tagcase sc (scheme (tv want) (fold-values v (fits v s t want) m (cdr bs))))))))))))))))

      (define conforms (subr kfx (cv st string string sexp) st)
        (lambda (v s m x spec)
          "That the module `m`, defined at the top level, is a `x`: a type for each
           abstract one, the same type for each description, and each value, of a
           type that fits. The emitter is told, to write the trait's impl."
          (let ((w (module-scope v spec "" m)))
            (begin
              (map (lambda ((t string))
                     (if (null? (find-alias (string-append m (string-append " " t)) (cv-aliases v)))
                         (refuse v (string-append m (string-append " gives no type " t)))
                         #u))
                   (spec-abs spec))
              (map (lambda ((d sexps))
                     (let ((mine (string-append m (string-append " " (sym-name (second d))))))
                       (if (null? (find-alias mine (cv-aliases v)))
                           (refuse v (string-append m (string-append " gives no type " (sym-name (second d)))))
                           (let ((a (parse-type v nil (sym mine "" 0))) (b (parse-type w nil (third d))))
                             (begin (fits v (fits v s a b) b a) #u)))))
                   (spec-items spec "desc"))
              (note-fact
               (fold-values v s m (module-type-values w spec))
               "" 0 (string-append "module-impl " (string-append m (string-append " " x))))))))

      (define top-lambda? (subr kfx (cv) bool)
        (lambda (v)
          "Whether the lambda checked is a top-level definition's, as a procedure of
           a module parameter must be (C24)."
          (let ((found (scope-bind "%toplambda" v)))
            (and (not (null? found)) (tagcase (car found) (bind (n sc w) (string=? w "yes")))))))

      (define-rec
        (freshened (subr kfx (st ty) st)
          (lambda (s t)
            "`s`, a list's region in `t` that nothing solved made fresh, as FX-26
             makes it where it finds a value by itself."
            (tagcase (walk s t)
              (ty-list (e r)
                (let ((s (freshened s e)))
                  (tagcase (walk s r) (ty-meta (k) (solve s k (ty-rconst "%fresh"))) (else other s))))
              (ty-proc (es ps r) (freshened s r))
              (else other s)))))

      (define-rec
        (mentions-tvar? (subr kfx (ty strings) bool)
          (lambda (t vs)
            (tagcase t
              (ty-var (n) (string-member? n vs))
              (ty-list (e r) (mentions-tvar? e vs))
              (ty-ref (e r) (mentions-tvar? e vs))
              (ty-tag (a h d r) (or (mentions-tvar? a vs) (mentions-tvar? h vs)))
              (ty-data (d args) (any? (lambda ((x ty)) (mentions-tvar? x vs)) args))
              (ty-shape (p ls ts) (any? (lambda ((x ty)) (mentions-tvar? x vs)) ts))
              (ty-proc (es ps r) (or (mentions-tvar? r vs) (any? (lambda ((x ty)) (mentions-tvar? x vs)) ps)))
              (else other #f)))))

      (define-rec
        (procs-within (subr kfx (st ty) tys)
          (lambda (s t)
            "The procedure types `t` is or holds: in a product's or a sum's fields,
             a list's, a reference's, a datatype's arguments (F17 sees them so)."
            (tagcase (walk s t)
              (ty-proc (es ps r) (the tys (list (walk s t))))
              (ty-shape (p ls ts) (concat (map (lambda ((x ty)) (procs-within s x)) ts)))
              (ty-list (e r) (procs-within s e))
              (ty-ref (e r) (procs-within s e))
              (ty-data (d args) (concat (map (lambda ((x ty)) (procs-within s x)) args)))
              (else other nil)))))

      (define poly-self-application (subr kfx (cv scheme ty res) res)
        (lambda (v sc inst r)
          "A call of a `poly` procedure one of whose parameters is a procedure over
           a type variable: given a type that may hold a procedure, it may apply a
           procedure to itself, a loop with no recursive call, and so says `spin`,
           as FX-26 says it (its F17), more cautiously."
          (tagcase r
            (res (t es s)
              (tagcase sc
                (scheme (tvars st)
                  (let ((types (concat (map (lambda ((n string)) (if (char=? (string-ref-i64 n 0) #\') nil (the strings (list n)))) tvars))))
                    (if (and (not (null? types))
                             (tagcase st
                               (ty-proc (es0 ps r0)
                                 (any? (lambda ((p ty)) (any? (lambda ((q ty)) (mentions-tvar? q types)) (procs-within s p))) ps))
                               (else other #f))
                             (tagcase (walk s inst)
                               (ty-proc (es1 ps1 r1) (any? (lambda ((p ty)) (any? (lambda ((q ty)) (self-applicable? v s q)) (procs-within s p))) ps1))
                               (else other #f)))
                        (res t (effs-union (list "spin") es) s)
                        r))))))))

      (define void-call (subr kfx (cv bool bool res) res)
        (lambda (v error unknown r)
          "A call that gives a `void`: in Rust a `Void`, which, unlike FX-26's
           `void`, is below no other type; the emitter writes `match f(...) {}`,
           which is of any. Not `error`, whose Rust type, `!`, is so already."
          (tagcase r
            (res (t es s)
              (cond ((and (not error) (void? s t)) (res t es (note-fact s (cv-file v) (cv-pos v) "void-call")))
                    ((and error unknown)
                     "An `error` given for an inference variable (a call's argument, a
                      list's element): `the::<Void>(error(...))`, so that Rust finds
                      `Void` there, not `!`, which nothing shows."
                     (res t es (note-fact s (cv-file v) (cv-pos v) "void-error")))
                    (else r))))))

      (define control-form? (subr kfx (string) bool)
        (lambda (h)
          (or (string=? h "if") (string=? h "cond") (string=? h "case") (string=? h "tagcase") (string=? h "typecase")
              (string=? h "let") (string=? h "let*") (string=? h "begin") (string=? h "letrec")
              (string=? h "letregion") (string=? h "with")
              (string=? h "confirm-nat") (string=? h "confirm-length") (string=? h "acyclic") (string=? h "letfreeze"))))

      (define-rec
        (metas-of (subr kfx (ty) i64s)
          (lambda (t)
            "The inference variables in `t` as it stands, solved or not."
            (tagcase t
              (ty-meta (k) (the i64s (list k)))
              (ty-list (e r) (onto (metas-of e) (metas-of r)))
              (ty-flat (e r) (onto (metas-of e) (metas-of r)))
              (ty-ref (e r) (onto (metas-of e) (metas-of r)))
              (ty-tag (a h d r) (onto (metas-of a) (onto (metas-of h) (metas-of r))))
              (ty-data (d args) (concat (map metas-of args)))
              (ty-shape (p ls ts) (concat (map metas-of ts)))
              (ty-proc (es ps r) (onto (metas-of r) (concat (map metas-of ps))))
              (else other nil)))))

      (define fixed-by (subr kfx (st st i64s) i64s)
        (lambda (before after ks)
          "Of `ks`, those that fitting the result expected solved."
          (concat (map (lambda ((k i64))
                         (if (and (tagcase (walk before (ty-meta k)) (ty-meta (j) #t) (else other #f))
                                  (tagcase (walk after (ty-meta k)) (ty-meta (j) #f) (else other #t)))
                             (the i64s (list k))
                             nil))
                       ks))))

      (define-rec
        (raw-meta? (subr kfx (ty) bool)
          (lambda (t)
            "Whether `t` has an inference variable in it, solved or not: a
             parameter's type that is an instance's."
            (tagcase t
              (ty-meta (k) #t)
              (ty-list (e r) (or (raw-meta? e) (raw-meta? r)))
              (ty-flat (e r) (or (raw-meta? e) (raw-meta? r)))
              (ty-ref (e r) (or (raw-meta? e) (raw-meta? r)))
              (ty-tag (a h d r) (or (raw-meta? a) (raw-meta? h) (raw-meta? r)))
              (ty-data (d args) (any? raw-meta? args))
              (ty-shape (p ls ts) (any? raw-meta? ts))
              (ty-proc (es ps r) (or (raw-meta? r) (any? raw-meta? ps)))
              (else other #f)))))

      (define opened (subr kfx (cv string) cv)
        (lambda (v m)
          "`v`, in a `(with m ...)`: `m`'s values, types and effects."
          (tagcase v
            (cv (bs ds als es here group file line fs tv at ix mk)
              (cv (bind-onto (opened-binds m bs) bs) ds (onto (opened-aliases m als) als)
                  (onto (concat (map (lambda ((d effdef))
                                       (tagcase d (effdef (n atoms)
                                                    (if (has-prefix? n (string-append m " "))
                                                        (the effdefs (list (effdef (after-prefix n (string-append m " ")) atoms)))
                                                        nil))))
                                     es))
                        es)
                  here group file line fs tv at
                  (bix-adds ix (opened-binds m bs)) (marks-adds mk (opened-binds m bs)))))))

      (define case-data? (subr kfx (string sexps) bool)
        (lambda (kind xs)
          "Whether `xs` are literals a case on a `kind` compares with."
          (not (any? (lambda ((x sexp))
                       (not (tagcase x
                              (chr (c at-file at-pos) (string=? kind "char"))
                              (num (k text pos) (string=? kind "int"))
                              (big (text f p) (string=? kind "int"))
                              (str (t at-file at-pos) (string=? kind "string"))
                              (sym (n at-file at-pos) (if (or (string=? n "#t") (string=? n "#f")) (string=? kind "bool") (string=? kind "symbol")))
                              (else other #f))))
                     xs))))

      (define-rec
        (big-digits (subr kfx (chars) chars)
          (lambda (cs)
            "A big literal's sign and digits, its leading zeros dropped."
            (cond ((null? cs) nil)
                  ((char=? (car cs) #\-) (cons #\- (big-digits (cdr cs))))
                  ((and (char=? (car cs) #\0) (not (null? (cdr cs)))) (big-digits (cdr cs)))
                  (else cs)))))

      (define datum-key (subr kfx (sexp) string)
        (lambda (d)
          "A case datum, as a key that two data equal share."
          (tagcase d
            (chr (c at-file at-pos) (string-append "c" (char->string c)))
            (num (k f p) (string-append "n" (i64->string k)))
            (big (text f p) (string-append "b" (list->string (big-digits (string-chars text)))))
            (str (x at-file at-pos) (string-append "s" x))
            (sym (n at-file at-pos) (string-append "y" n))
            (else other "?"))))

      (define all-chars? (subr kfx (sexps) bool)
        (lambda (xs) (not (any? (lambda ((x sexp)) (tagcase x (chr (c at-file at-pos) #f) (else other #t))) xs))))

      (define bind-fields (subr kfx (cv sexps tys) binds)
        (lambda (v names types)
          (if (null? names)
              nil
              (cons (local v (name-of v (car names)) (car types)) (bind-fields v (cdr names) (cdr types))))))

      (define bind-params (subr kfx (cv sexps tys) binds)
        (lambda (v params types)
          (if (null? params)
              nil
              (cons (local v (param-name (car params)) (car types)) (bind-params v (cdr params) (cdr types))))))

      (define find-dt (subr kfx (string dts) (listof variants acyclic))
        (lambda (d ds)
          (cond ((null? ds) nil)
                (else (tagcase (car ds) (dt (n ps vs) (if (string=? n d) (list vs) (find-dt d (cdr ds)))))))))

      (define family-of (subr kfx (cv string) strings)
        (lambda (v d)
          "A datatype's parameters."
          (let ((found (find-family d (cv-dts v))))
            (if (null? found) nil (tagcase found (dt (n ps vs) ps))))))

      (define instantiate-variants (subr kfx (strings tys variants) variants)
        (lambda (params args vs)
          "Variants whose fields' types are of the datatype's parameters, at
           `args`."
          (map (lambda ((x variant))
                 (tagcase x (variant (tag fields) (variant tag (map (lambda ((f ty)) (let ((u (substitute params args f))) (if (has-app? u) (reduced u) u))) fields)))))
               vs)))

      (define variants-of (subr kfx (cv string) variants)
        (lambda (v d)
          (let ((found (find-dt d (cv-dts v))))
            (if (null? found) (refuse v (string-append "no datatype is named " d)) (car found)))))

      (define variant-fields (subr kfx (cv string string variants) tys)
        (lambda (v d tag vs)
          (cond ((null? vs)
                 (refuse v (string-append tag (string-append " is no tag of " (string-append d ", or has an arm already")))))
                (else (tagcase (car vs)
                        (variant (t fields) (if (string=? t tag) fields (variant-fields v d tag (cdr vs)))))))))

      (define without-tag (subr kfx (string variants) variants)
        (lambda (tag vs)
          (cond ((null? vs) nil)
                (else (tagcase (car vs)
                        (variant (t fields) (if (string=? t tag) (cdr vs) (cons (car vs) (without-tag tag (cdr vs))))))))))

      "Pairs (C68): a local whose type is a pair; a pair expected, alone or a
       union's member."

      (define local-pair (subr kfx (cv st sexp) tys)
        (lambda (v s x)
          (tagcase x
            (sym (n f p)
              (let ((found (scope-bind n v)))
                (if (null? found)
                    nil
                    (tagcase (car found)
                      (bind (n2 sc w)
                        (tagcase sc (scheme (tv t) (if (string=? (shape-of (walk s t)) "pair") (list (walk s t)) nil))))))))
            (else other nil))))

      (define pair-expected (subr kfx (st ty) tys)
        (lambda (s t)
          (let ((x (walk s t)))
            (cond ((string=? (shape-of x) "pair") (list x))
                  ((string=? (shape-of x) "union") (member-of-shape (members-of x) "pair"))
                  (else nil)))))

      "Narrowing (C62): a shape's test of a local of a union, `(int? x)`, says
       in its `if`'s first branch, and its `cond`'s clause, that `x` is the
       member of that shape, and after it that `x` is one of the rest."

      (define tested-shape (subr kfx (string) string)
        (lambda (p)
          (cond ((string=? p "int?") "int") ((string=? p "string?") "string") ((string=? p "bool?") "bool")
                ((string=? p "char?") "char") ((string=? p "symbol?") "symbol") ((string=? p "array?") "bloblet")
                ((string=? p "procedure?") "procedure") ((string=? p "null?") "nil") ((string=? p "pair?") "pair")
                ((string=? p "f64?") "f64") ((string=? p "ref?") "box") ((string=? p "sum?") "sum")
                ((string=? p "product?") "product") ((string=? p "bytevector?") "bytevector") ((string=? p "vector?") "vector") ((string=? p "f32?") "f32")
                (else ""))))

      (define-rec
        (members-but (subr kfx (tys string) tys)
          (lambda (ts shape)
            "Members not of `shape`: a list stays for `nil` and `pair` both."
            (cond ((null? ts) nil)
                  ((or (string=? (shape-of (car ts)) shape)) (members-but (cdr ts) shape))
                  (else (cons (car ts) (members-but (cdr ts) shape)))))))

      (define union-of (subr kfx (tys) ty)
        (lambda (ts)
          "Members as one type: one alone is itself; `nil` and a list's pair are
           the list again (C68)."
          (cond ((null? (cdr ts)) (car ts))
                ((and (i64= (size ts) 2) (not (null? (member-of-shape ts "nil"))) (not (null? (member-of-shape ts "pair")))
                      (tagcase (car (member-of-shape ts "pair"))
                        (ty-data (d args) (tagcase (car (cdr args)) (ty-list (e r) #t) (else other #f)))
                        (else other #f)))
                 (tagcase (car (member-of-shape ts "pair")) (ty-data (d args) (car (cdr args))) (else other (car ts))))
                (else (ty-data "%union" ts)))))

      (define-rec
        (lists-split (subr kfx (tys) tys)
          (lambda (ts)
            "Members, a list taken as `nil` or its pair (C68), so that a test of
             `nil` or of a pair narrows it."
            (cond ((null? ts) nil)
                  ((tagcase (car ts) (ty-list (e r) #t) (else other #f))
                   (tagcase (car ts)
                     (ty-list (e r) (cons (ty-data "nil" nil) (cons (ty-data "%pairof" (list e (car ts) r)) (lists-split (cdr ts)))))
                     (else other (lists-split (cdr ts)))))
                  (else (cons (car ts) (lists-split (cdr ts))))))))

      (define narrowed-to (subr kfx (tys string) tys)
        (lambda (ms shape)
          "The member a test of `shape` proves; a list for `nil` or `pair`."
          (if (and (or (string=? shape "nil") (string=? shape "pair")) (null? (member-of-shape ms shape))) (member-of-shape ms "list") (member-of-shape ms shape))))

      (define narrowed-from (subr kfx (tys string) tys)
        (lambda (ms shape)
          (if (and (or (string=? shape "nil") (string=? shape "pair")) (null? (member-of-shape ms shape))) ms (members-but ms shape))))

      (define literal-shape (subr kfx (sexp) string)
        (lambda (e)
          (tagcase e
            (num (k f p) "int") (big (t f p) "int") (chr (c f p) "char") (str (x f p) "string") (real (x f p) "f64")
            (else other ""))))

      (define-datatype narrowing (narrowing cv cv))


      (define-rec
        (counting-labels (subr kfx (i64 i64) strings)
          (lambda (i n) (if (i64> i n) nil (cons (i64->string i) (counting-labels (i64+ i 1) n))))))

      (define with-alias (subr kfx (cv alias) cv)
        (lambda (v a)
          (tagcase v (cv (bs ds als es here group file line fs tv at ix mk) (cv bs ds (cons a als) es here group file line fs tv at ix mk)))))

      "Uniform values (C75; docs/research/uniform-values.md): a union's value
       is a `Value` in Rust. A member given for its union is boxed there, and a
       union narrowed to a member unboxed: each a fact at the expression, for
       the emitter. `nil`, a list narrowed so, is a list still, of the element
       type Rust finds."

      (define general-pair? (subr kfx (st ty) bool)
        (lambda (s t)
          "A pair whose tail is no list: a union's pair, `Value`s in Rust (C77)."
          (tagcase (walk s t)
            (ty-data (d args)
              (and (string=? d "%pairof")
                   (not (tagcase (walk s (car (cdr args))) (ty-list (e r) #t) (else other #f)))))
            (else other #f))))

      (define valued? (subr kfx (st ty) bool)
        (lambda (s t)
          "Whether a type's Rust is `Value`: a union's, `datum`'s, a pair's whose
           tail is no list (C77)."
          (let ((x (walk s t)))
            (or (string=? (shape-of x) "union") (general-pair? s x)))))

      (define-rec
        (quotable? (subr kfx (sexp) bool)
          (lambda (d)
            "Whether a quoted datum is one KFX builds (C77, C80): a `.` only
             before a dotted list's last item, a vector's `#vector` only at its
             head."
            (tagcase d
              (sym (n f p) (and (not (string=? n ".")) (not (string=? n "#vector"))))
              (lst (xs f l p) (quotable-items? (if (head-is? d "#vector") (cdr xs) xs)))
              (else other #t))))
        (quotable-items? (subr kfx (sexps) bool)
          (lambda (xs)
            (cond ((null? xs) #t)
                  ((and (sym-is? (car xs) ".") (not (null? (cdr xs))) (null? (cdr (cdr xs))))
                   (quotable? (car (cdr xs))))
                  (else (and (quotable? (car xs)) (quotable-items? (cdr xs))))))))

      (define pair-member (subr kfx (st ty) tys)
        (lambda (s t)
          "The pair a value of type `t` is taken apart as, where it is a union's
           (C77): a pair whose tail is no list; a union's pair member, or its list
           member's pair."
          (let ((x (walk s t)))
            (cond ((general-pair? s x) (list x))
                  ((string=? (shape-of x) "union")
                   (let ((ms (members-of x)))
                     (cond ((not (null? (member-of-shape ms "pair"))) (member-of-shape ms "pair"))
                           ((not (null? (member-of-shape ms "list")))
                            (tagcase (car (member-of-shape ms "list"))
                              (ty-list (e r) (list (ty-data "%pairof" (list e (car (member-of-shape ms "list")) r))))
                              (else other nil)))
                           (else nil))))
                  (else nil)))))

      (define-rec
        (chain-type (subr kfx (cv st sexp) tys)
          (lambda (v s e)
            "The type of `e`, a name, or a `car` or `cdr` of one, found from the
             names' types alone, nothing checked; or none."
            (tagcase e
              (sym (n f p)
                (let ((b (scope-bind n v)))
                  (if (null? b)
                      nil
                      (tagcase (car b)
                        (bind (n2 sc w)
                          (tagcase sc (scheme (tv t) (if (and (null? tv) (not (string=? w "prim"))) (list (walk s t)) nil))))))))
              (lst (xs f l p)
                (if (and (i64= (size xs) 2) (or (sym-is? (car xs) "car") (sym-is? (car xs) "cdr")))
                    (let ((inner (chain-type v s (second xs))))
                      (if (null? inner)
                          nil
                          (let ((x (car inner)))
                            (tagcase x
                              (ty-list (el r) (list (if (sym-is? (car xs) "car") el x)))
                              (else other
                                (let ((ps (tagcase x (ty-data (d args) (if (string=? d "%pairof") (the tys (list x)) (pair-member s x))) (else other nil))))
                                  (if (null? ps)
                                      nil
                                      (tagcase (car ps)
                                        (ty-data (d parts) (list (walk s (if (sym-is? (car xs) "car") (car parts) (car (cdr parts))))))
                                        (else other nil)))))))))
                    nil))
              (else other nil)))))

      (define as-member (subr kfx (st ty) ty)
        (lambda (s t)
          "A member's type as Rust has it: a pair whose tail is a list is that
           list (C68)."
          (let ((x (walk s t)))
            (tagcase x
              (ty-data (d args)
                (if (and (string=? d "%pairof") (tagcase (walk s (car (cdr args))) (ty-list (e r) #t) (else other #f)))
                    (walk s (car (cdr args)))
                    x))
              (else other x)))))

      (define scalar-member? (subr kfx (st ty) bool)
        (lambda (s t)
          "Whether a member is one `Value` holds unboxed."
          (tagcase (walk s t)
            (ty-i64 () #t) (ty-int () #t) (ty-nat () #t) (ty-f64 () #t) (ty-char () #t) (ty-bool () #t)
            (ty-string () #t) (ty-unit () #t)
            (ty-data (d args) (or (string=? d "false") (string=? d "symbol")))
            (else other #f))))

      (define rust-shape (subr kfx (string) string)
        (lambda (shape)
          "A shape as kayak-rt's `Shape` names it, for a member boxed whole."
          (cond ((string=? shape "procedure") "Procedure") ((string=? shape "box") "Box")
                ((string=? shape "bloblet") "Bloblet") ((string=? shape "sum") "Sum")
                ((string=? shape "product") "Product") ((string=? shape "f32") "F32")
                ((string=? shape "bytevector") "Bytevector") ((string=? shape "int") "Int")
                ((string=? shape "vector") "Vector")
                (else ""))))

      (define boxed-elements? (subr kfx (st ty ty) bool)
        (lambda (s t expected)
          "Whether a list's elements are boxed where it is given: no union's,
           where a union's are expected."
          (tagcase (walk s t)
            (ty-list (x xr)
              (tagcase (walk s expected)
                (ty-list (y yr) (and (valued? s y) (not (valued? s x)) (not (tagcase (walk s x) (ty-void () #t) (ty-meta (k) #t) (else other #f)))))
                (else other #f)))
            (else other #f))))

      (define box-how (subr kfx (st ty ty) string)
        (lambda (s from to)
          "How a value of `from` is boxed where a `to` is wanted, as a wrapper's
           word (C82): `-` not at all, `scalar`, `list`, `other:Shape`, or `none`
           where kayak-rt boxes no such member."
          (if (or (not (valued? s to)) (valued? s from))
              "-"
              (let ((m (as-member s from)))
                (cond ((scalar-member? s m) "scalar")
                      ((or (string=? (shape-of m) "list") (string=? (shape-of m) "nil")) "list")
                      ((string=? (rust-shape (shape-of m)) "") "none")
                      (else (string-append "other:" (rust-shape (shape-of m)))))))))

      (define-rec
        (box-hows (subr kfx (st tys tys) strings)
          (lambda (s froms tos)
            (if (or (null? froms) (null? tos))
                nil
                (cons (box-how s (car froms) (car tos)) (box-hows s (cdr froms) (cdr tos)))))))

      (define wrap-hows (subr kfx (st ty ty) strings)
        (lambda (s t expected)
          "A procedure given where one of the same arity is wanted: how each
           argument the caller gives is boxed for it, then how its result is boxed
           for the caller (C82); none if nothing is."
          (tagcase (walk s t)
            (ty-proc (tes tps tr)
              (tagcase (walk s expected)
                (ty-proc (ees eps er)
                  (if (not (i64= (size tps) (size eps)))
                      nil
                      (let ((hows (onto (box-hows s eps tps) (list (box-how s tr er)))))
                        (if (any? (lambda ((h string)) (not (string=? h "-"))) hows) hows nil))))
                (else other nil)))
            (else other nil))))

      (define coerced (subr kfx (cv st string i64 ty ty) st)
        (lambda (v s file pos t expected)
          "What is of type `t` where an `expected` is wanted, at `file`, `pos`:
           boxed into a union, unboxed out of one, or as it is; a member KFX
           cannot box yet is the emitter's to refuse, not the checker's, which
           the engine shares."
          (let ((from (valued? s t)) (to (valued? s expected)))
            (cond ((string=? file "") s)
                  ((and (not from) (not to) (not (null? (wrap-hows s t expected))))
                   "A procedure given where one of a union's parameters or result is
                    wanted (C82): wrapped, each argument and its result boxed."
                   (if (any? (lambda ((h string)) (string=? h "none")) (wrap-hows s t expected))
                       (note-types s file pos "box none" (list t))
                       (let ((s (note-fact s file pos (string-append "wrap " (words-of (wrap-hows s t expected))))))
                         "Its closure `Send + Sync` where the procedure wanted is (C102)."
                         (tagcase (walk s expected)
                           (ty-proc (es ps r) (if (crossing? (map (lambda ((a string)) (resolve-atom s a)) es)) (note-fact s file pos "wrap-sync") s))
                           (else other s)))))
                  ((and (not from) (not to) (boxed-elements? s (as-member s t) (as-member s expected)))
                   "A list at `acyclic` given as a list of a union (C78): copied,
                    each element boxed, which nothing can tell from FX-26's, the
                    list being frozen."
                   (note-fact s file pos "box elements"))
                  ((or (and from to) (and (not from) (not to))) s)
                  (to
                   (let ((m (as-member s t)))
                     (cond ((scalar-member? s m) (note-fact s file pos "box scalar"))
                           ((string=? (shape-of m) "nil") (note-fact s file pos "box nil"))
                           ((string=? (shape-of m) "list") (note-fact s file pos "box list"))
                           ((string=? (rust-shape (shape-of m)) "") (note-types s file pos "box none" (list m)))
                           (else (note-fact s file pos (string-append "box other " (rust-shape (shape-of m))))))))
                  (else
                   (let ((m (as-member s expected)))
                     (cond ((scalar-member? s m) (note-types s file pos "unbox" (list m)))
                           ((or (string=? (shape-of m) "list") (string=? (shape-of m) "nil")) (note-types s file pos "unbox-list" (list m)))
                           ((string=? (rust-shape (shape-of m)) "") (note-types s file pos "unbox-none" (list m)))
                           (else (note-types s file pos "unbox-other" (list m))))))))))

      (define head-unboxed (subr kfx (cv st string string ty) st)
        (lambda (v s h wher t)
          "A call of a local narrowed to a procedure from a union (C75): the
           procedure unboxed, a fact at the call."
          (if (not (string=? wher "narrowed"))
              s
              (let ((origin (bind-origin h (cv-binds v))))
                (if (or (null? origin) (not (valued? s (car origin))) (valued? s t) (string=? (cv-file v) ""))
                    s
                    (note-types s (cv-file v) (cv-pos v) "head-unbox" (list t)))))))

      (define narrowing-unboxed (subr kfx (cv st string string i64 ty) st)
        (lambda (v s name file pos t)
          "A narrowed local named: unboxed if its own type is a union's, and what
           it is narrowed to is not."
          (let ((found (scope-bind name v)))
            (if (or (null? found) (not (tagcase (car found) (bind (n sc w) (string=? w "narrowed")))))
                s
                (let ((origin (bind-origin name (cv-binds v))))
                  (if (null? origin) s (coerced v s file pos (car origin) t)))))))

      (define union-local (subr kfx (cv st sexp) tys)
        (lambda (v s x)
          "The members of the local `x`'s union, if it is one; its type alone if
           narrowed to one (a `typecase`'s later arms)."
          (tagcase x
            (sym (n f p)
              (let ((found (scope-bind n v)))
                (if (null? found)
                    nil
                    (tagcase (car found)
                      (bind (n2 sc w)
                        (if (or (string=? w "local") (string=? w "narrowed"))
                            (tagcase sc (scheme (tv t) (tagcase (walk s t)
                                                         (ty-data (d args) (if (string=? (shape-of (walk s t)) "union") (lists-split (members-of (walk s t))) (if (string=? (shape-of (walk s t)) "") nil (list (walk s t)))))
                                                         (ty-list (e r) (lists-split (list (walk s t))))
                                                         (else other (if (string=? (shape-of (walk s t)) "") nil (list (walk s t)))))))
                            nil))))))
            (else other nil))))

      (define latent-shape (subr kfx (sexps string) string)
        (lambda (ps head)
          "The shape of `(head (shape 0 S))` among `ps`, or \"\"."
          (let ((found (filter (lambda ((q sexp)) (has-prefix? (show-sexp q) head)) ps)))
            (if (null? found)
                ""
                (let ((held (if (has-prefix? head "(not") (second (items (car found))) (car found))))
                  (show-sexp (car (reverse (items (second (items held)))))))))))

      (define latent-narrowings (subr kfx (cv st sexps (listof ty acyclic)) (listof narrowing acyclic))
        (lambda (v s xs ms)
          "`(f x)`, `f` a procedure whose type says what its result proves of
           its argument's shape (C163): `x`, a local of a union, narrowed as a
           shape's test narrows it, in a branch where that is said."
          (let ((d (if (null? ms) "" (callee-spec v s xs))))
            (if (string=? d "")
                nil
                (let* ((ens (spec-ensures d))
                       (yes (latent-shape (latent-claims ens #t) "(holds (shape 0 "))
                       (no (latent-shape (latent-claims ens #f) "(not (holds (shape 0 "))
                       (x (sym-name (second xs)))
                       (in (if (string=? yes "") ms (narrowed-to ms yes)))
                       (out (if (string=? no "") ms (narrowed-from ms no))))
                  (if (or (and (string=? yes "") (string=? no "")) (null? in) (null? out))
                      nil
                      (list (narrowing (if (string=? yes "") v (with-binds v (list (narrowed v x (union-of in)))))
                                       (if (string=? no "") v (with-binds v (list (narrowed v x (union-of out)))))))))))))

      (define narrowings-of-test (subr kfx (cv st sexp) (listof narrowing acyclic))
        (lambda (v s test)
          "What a test proves: `x` narrowed in the branch it holds in and in the
           other, or nothing."
          (tagcase test
            (lst (xs f l p)
              (if (and (i64= (size xs) 2) (tagcase (car xs) (sym (n f2 p2) #t) (else other #f)))
                  (let* ((pred (sym-name (car xs)))
                         (shape (tested-shape pred))
                         (ms (union-local v s (second xs))))
                    (if (or (string=? shape "") (null? ms)
                            (tagcase (car (scope-bind pred v)) (bind (n sc w) (not (string=? w "prim")))))
                        (latent-narrowings v s xs ms)
                        (let ((yes (narrowed-to ms shape)) (no (narrowed-from ms shape)) (x (sym-name (second xs))))
                          (if (or (null? yes) (null? no))
                              nil
                              (list (narrowing (with-binds v (list (narrowed v x (union-of yes))))
                                               (with-binds v (list (narrowed v x (union-of no))))))))))
                  nil))
            (else other nil))))

      (define-rec
        (poly-fresh-metas (subr kfx (st i64 tys) res)
          (lambda (s n acc)
            (if (i64<= n 0)
                (res (ty-data "%metas" acc) nil s)
                (tagcase (fresh s) (res (m u s2) (poly-fresh-metas s2 (i64- n 1) (cons m acc))))))))

      (define poly-callee (subr kfx (res) res)
        (lambda (c)
          "A callee of a poly type, a `letrec`'s or a parameter's, called as
           FX-26 calls it: instantiated, each binder a new inference variable
           (C158)."
          (tagcase c
            (res (t es s)
              (tagcase (walk s t)
                (ty-data (d args)
                  (if (string=? d "%poly")
                      (tagcase (poly-fresh-metas s (size (poly-binders-of args)) nil)
                        (res (ms u s2) (res (poly-instance args (tagcase ms (ty-data (d2 xs) xs) (else other nil))) es s2)))
                      c))
                (else other c))))))

      "Sizes' facts (C157): what a comparison of integers shows in each of its
       branches, of the locals it names."
      (define std-prim? (subr kfx (cv string) bool)
        (lambda (v h) (let ((b (scope-bind h v))) (and (not (null? b)) (prim? (car b))))))

      (define-rec
        (linear-of (subr kfx (cv st sexp) lins)
          (lambda (v s e)
            "`e` as a linear expression of its locals of type `int` or `nat`: a
             literal, such a local, `(+ a b)`, `(- a b)`, `(* k a)`; none if not."
            (tagcase e
              (num (k f p) (list (lin k nil)))
              (sym (n f p)
                (let ((b (scope-bind n v)))
                  (if (and (not (null? b))
                           (tagcase (car b) (bind (m sc w) (tagcase sc (scheme (tv t) (and (null? tv) (sized? (walk s t) "%natof")))))))
                      ;; A `(nat s)`: its size (C158).
                      (tagcase (car b) (bind (m sc w) (tagcase sc (scheme (tv t) (size-lin s (sized-size (walk s t)))))))
                  (if (and (not (null? b))
                           (tagcase (car b)
                             (bind (m sc w)
                               (and (or (string=? w "local") (string=? w "narrowed"))
                                    (tagcase sc (scheme (tv t) (and (null? tv) (tagcase (walk s t) (ty-int () #t) (ty-nat () #t) (else other #f)))))))))
                      (list (lin 0 (list (lterm n 1))))
                      nil))))
              (lst (xs f l p)
                (if (and (i64= (size xs) 3) (tagcase (car xs) (sym (h f2 p2) (std-prim? v h)) (else other #f)))
                    (let ((h (sym-name (car xs))) (a (linear-of v s (second xs))) (b (linear-of v s (third xs))))
                      (cond ((or (null? a) (null? b)) nil)
                            ((string=? h "+") (list (lin-add (car a) (car b) 1)))
                            ((string=? h "-") (list (lin-add (car a) (car b) -1)))
                            ((and (string=? h "*") (tagcase (car a) (lin (c ts) (null? ts))))
                             (list (lin-scaled (car b) (tagcase (car a) (lin (c ts) c)))))
                            (else nil)))
                    nil))
              (else other nil)))))

      (define with-size-fact (subr kfx (cv string lin) cv)
        (lambda (v kind l) (with-binds v (list (bind "%size-fact" (scheme nil (ty-unit)) (string-append "fact " (string-append kind (string-append " " (lin-text l)))))))))

      (define callee-spec (subr kfx (cv st sexps) string)
        (lambda (v s xs)
          "The specification of `(f a ...)`'s `f`, a name, if its type has one
           (C162)."
          (if (or (null? xs) (not (tagcase (car xs) (sym (n f p) #t) (else other #f))))
              ""
              (let ((b (scope-bind (sym-name (car xs)) v)))
                (if (null? b) "" (tagcase (car b) (bind (n sc w) (tagcase sc (scheme (tv t) (spec-under-poly (walk s t)))))))))))

      (define latent-term-lin (subr kfx (cv st sexps sexp) lins)
        (lambda (v s args x)
          "A term of what a test proves, of the call's arguments `args`: argument
           `i` as an integer, its list's length, a literal; none if not known."
          (let ((hd (logic-head x)) (i (tagcase (second (items x)) (num (k f p) k) (else other (the i64 0)))))
            (cond ((string=? hd "lit") (list (lin i nil)))
                  ((i64>= i (size args)) nil)
                  ((string=? hd "p") (linear-of v s (logic-nth args i)))
                  ((string=? hd "len") (nlist-size v s (logic-nth args i)))
                  (else nil)))))

      (define-rec
        (latent-facts-onto (subr kfx (cv st sexps sexps) cv)
          (lambda (v s args ps)
            "`v` with each of `ps`, propositions of the arguments, it may say as
             a size's fact."
            (if (null? ps)
                v
                (let* ((q (car ps)) (hd (logic-head q)) (xs (cdr (items q)))
                       (w (cond ((string=? hd "rel")
                                 (let ((a (latent-term-lin v s args (second xs))) (b (latent-term-lin v s args (third xs)))
                                       (r (tagcase (car xs) (num (k f p) k) (else other (the i64 0)))))
                                   (if (or (null? a) (null? b))
                                       v
                                       (let ((d (lin-add (car b) (car a) -1)))
                                         (cond ((i64= r 0) (with-size-fact v "ge" (lin-add d (lin -1 nil) 1)))
                                               ((i64= r 1) (with-size-fact v "ge" d))
                                               ((i64= r 2) (with-size-fact v "eq" d))
                                               (else (with-size-fact v "ne" d)))))))
                                ((and (string=? hd "holds") (string=? (logic-head (car xs)) "natp"))
                                 (let ((a (latent-term-lin v s args (lst (cons (sym "p" "" 0) (cdr (items (car xs)))) "" 0 0))))
                                   (if (null? a) v (with-size-fact v "ge" (car a)))))
                                (else v))))
                  (latent-facts-onto w s args (cdr ps)))))))

      (define latent-facts-of-call (subr kfx (cv st sexps) (listof narrowing acyclic))
        (lambda (v s xs)
          "A call of a procedure whose type says what its result proves (C163,
           Fixpt's `check-test-facts.fx`): of its arguments' sizes, what each
           branch knows."
          (let ((d (callee-spec v s xs)))
            (if (string=? d "")
                nil
                (let* ((ens (spec-ensures d))
                       (th (latent-claims ens #t)) (el (latent-claims ens #f)))
                  (if (and (null? th) (null? el))
                      nil
                      (list (narrowing (latent-facts-onto v s (cdr xs) th) (latent-facts-onto v s (cdr xs) el)))))))))

      (define size-facts-of-test (subr kfx (cv st sexp) (listof narrowing acyclic))
        (lambda (v s test)
          "`(= a b)`, `(< a b)`, `(<= a b)`, `(> a b)`, `(>= a b)`, of linear
           `a` and `b`: what each branch knows of `a - b` (Fixpt's
           `check-test-facts.fx`)."
          (tagcase test
            (lst (xs f l p)
              (if (and (i64= (size xs) 2) (tagcase (car xs) (sym (h f2 p2) (and (or (string=? h "null?") (string=? h "pair?")) (std-prim? v h))) (else other #f))
                       (not (null? (nlist-size v s (second xs)))))
                  ;; `(null? xs)`, `xs` a list of size `n`: `n = 0` where it holds,
                  ;; `n >= 1` where not (C158).
                  (let* ((n (car (nlist-size v s (second xs)))) (more (with-size-fact v "ge" (lin-add n (lin -1 nil) 1))) (none (with-size-fact v "eq" n)))
                    (list (if (sym-is? (car xs) "null?") (narrowing none more) (narrowing more none))))
              (if (and (i64= (size xs) 2) (tagcase (car xs) (sym (h f2 p2) (and (string=? h "zero?") (std-prim? v h))) (else other #f)))
                  ;; `(zero? a)`, as `(= a 0)` (Fixpt's type for it says so).
                  (size-facts-of-test v s (lst (list (sym "=" f p) (second xs) (num 0 f p)) f l p))
              (if (and (i64= (size xs) 3)
                       (tagcase (car xs) (sym (h f2 p2) (and (string-member? h (list "=" "<" "<=" ">" ">=")) (std-prim? v h))) (else other #f)))
                  (let ((h (sym-name (car xs))) (a (linear-of v s (second xs))) (b (linear-of v s (third xs))))
                    (if (or (null? a) (null? b))
                        nil
                        (let* ((d (lin-add (car a) (car b) -1))
                               (nd (lin-scaled d -1))
                               (one (lin -1 nil)))
                          (list (cond ((string=? h "=") (narrowing (with-size-fact v "eq" d) (with-size-fact v "ne" d)))
                                      ((string=? h "<") (narrowing (with-size-fact v "ge" (lin-add nd one 1)) (with-size-fact v "ge" d)))
                                      ((string=? h "<=") (narrowing (with-size-fact v "ge" nd) (with-size-fact v "ge" (lin-add d one 1))))
                                      ((string=? h ">") (narrowing (with-size-fact v "ge" (lin-add d one 1)) (with-size-fact v "ge" nd)))
                                      (else (narrowing (with-size-fact v "ge" d) (with-size-fact v "ge" (lin-add nd one 1)))))))))
                  (latent-facts-of-call v s xs)))))
            (else other nil))))

      (define-rec
        (nlist-type (subr kfx (cv st sexp) tys)
          (lambda (v s e)
            "The type of `e`, if it is a list of a size by its form (C158): a local
             or global of one, its `cdr`, a `the` of one; none if not."
            (tagcase e
              (sym (n f p)
                (let ((b (scope-bind n v)))
                  (if (and (not (null? b)) (tagcase (car b) (bind (m sc w) (tagcase sc (scheme (tv t) (and (null? tv) (sized? (walk s t) "%nlist")))))))
                      (tagcase (car b) (bind (m sc w) (tagcase sc (scheme (tv t) (list (walk s t))))))
                      nil)))
              (lst (xs f l p)
                (cond ((and (i64= (size xs) 3) (sym-is? (car xs) "the"))
                       (let ((t (parse-type v (cv-tvars v) (second xs)))) (if (sized? t "%nlist") (list t) nil)))
                      ((and (i64= (size xs) 2) (sym-is? (car xs) "cdr") (std-prim? v "cdr"))
                       (let ((inner (nlist-type v s (second xs))))
                         (if (null? inner) nil (list (cdr-size v s (car inner))))))
                      (else nil)))
              (else other nil))))
        (cdr-size (subr kfx (cv st ty) ty)
          (lambda (v s t)
            "A list of size `n`'s `cdr`: of `n - 1`, the facts showing `n >= 1`;
             else `finite`."
            (let ((l (size-lin s (sized-size t))))
              (if (and (not (null? l)) (size-shown? v s (lin-add (car l) (lin -1 nil) 1)))
                  (sized-less t s)
                  (ty-data "%nlist" (list (sized-elem t) size-finite)))))))

      (define nlist-size (subr kfx (cv st sexp) lins)
        (lambda (v s e)
          (let ((t (nlist-type v s e))) (if (null? t) nil (let ((l (size-lin s (sized-size (car t))))) l)))))

      (define-rec
        (narrowings (subr kfx (cv st sexp) (listof narrowing acyclic))
          (lambda (v s test)
            "What a test proves, through `not`, `and` and `or` too (C68): `(not t)`
             swaps `t`'s; `(and a b)` holds where `b` holds in where `a` does;
             `(or a b)` fails where `b` fails in where `a` does."
            (cond ((and (head-is? test "not") (i64= (size (items test)) 2))
                   (let ((ns (narrowings v s (second (items test)))))
                     (if (null? ns) nil (tagcase (car ns) (narrowing (yes no) (list (narrowing no yes)))))))
                  ((and (head-is? test "and") (i64= (size (items test)) 3))
                   (let ((first (narrowings v s (second (items test)))))
                     (let* ((after (if (null? first) v (tagcase (car first) (narrowing (yes no) yes))))
                            (then (narrowings after s (third (items test)))))
                       (cond ((not (null? then)) (tagcase (car then) (narrowing (yes no) (list (narrowing yes v)))))
                             ((not (null? first)) (list (narrowing after v)))
                             (else nil)))))
                  ((and (head-is? test "or") (i64= (size (items test)) 3))
                   (let ((first (narrowings v s (second (items test)))))
                     (let* ((after (if (null? first) v (tagcase (car first) (narrowing (yes no) no))))
                            (then (narrowings after s (third (items test)))))
                       (cond ((not (null? then)) (tagcase (car then) (narrowing (yes no) (list (narrowing v no)))))
                             ((not (null? first)) (list (narrowing v after)))
                             (else nil)))))
                  (else (let ((ns (narrowings-of-test v s test))) (if (null? ns) (size-facts-of-test v s test) ns)))))))

      "The control primitives KFX types by rules of its own (`abort-call`,
       `make-tag-call`), at FX-26's types, for a `proj` of one (C60), as FX-26's
       programs write it."

      (define control-schemes string
        "(make-continuation-prompt-tag (poly ((r region) (a type) (h type) (d effect)) (subr (alloc r) () (prompt-tag a h d r))))
         (abort-current-continuation (poly ((r region) (a type) (h type) (d effect)) (subr (goto r) ((prompt-tag a h d r) h) void)))
         (escape (poly ((r region) (a type) (h type)) (subr (goto r) ((escape-tag a h r) h) void)))")

      (define control-binds (subr kfx (cv) binds)
        (lambda (v)
          (map (lambda ((p sexp)) (let ((xs (items p))) (bind (name-of v (car xs)) (parse-scheme-of v (second xs) #f) "prim")))
               (read-all (string-chars control-schemes) "kfx's control primitives" 1)))))

    (define-rec
      (ty-sexp (subr kfx (cv st ty) sexp)
        (lambda (v s t)
          "A type as written: for the emitter, which reads no effects, so a
           procedure's is written `pure`."
          (tagcase (walk s t)
            (ty-i64 () (sym "i64" "" 0))
            (ty-int () (sym "int" "" 0))
            (ty-nat () (sym "nat" "" 0))
            (ty-f64 () (sym "f64" "" 0))
            (ty-bool () (sym "bool" "" 0))
            (ty-char () (sym "char" "" 0))
            (ty-unit () (sym "unit" "" 0))
            (ty-string () (sym "string" "" 0))
            (ty-void () (sym "void" "" 0))
            (ty-list (e r) (lst (list (sym "listof" "" 0) (ty-sexp v s e) (ty-sexp v s r)) "" 0 0))
            (ty-data (d args)
              (cond ((null? args) (sym d "" 0))
                    ((string=? d "%bloblet")
                     (lst (list (sym "bloblet" "" 0) (lst (cons (sym "fields" "" 0) (map (lambda ((x ty)) (ty-sexp v s x)) (cdr args))) "" 0 0)
                                (ty-sexp v s (car args))) "" 0 0))
                    ((or (string=? d "%native") (string=? d "%fx") (has-prefix? d "%spec ")) (ty-sexp v s (car args)))
                    ((string=? d "%blobref") (lst (cons (sym "blobref" "" 0) (map (lambda ((x ty)) (ty-sexp v s x)) args)) "" 0 0))
                    ((string=? d "%bytes") (lst (list (sym "bytevectorof" "" 0) (ty-sexp v s (car args))) "" 0 0))
                    ((string=? d "%array") (lst (list (sym "arrayof" "" 0) (ty-sexp v s (car args)) (ty-sexp v s (car (cdr args)))) "" 0 0))
                    ((string=? d "%flat-array") (lst (cons (sym "arrayof" "" 0) (map (lambda ((x ty)) (ty-sexp v s x)) args)) "" 0 0))
                    ((string=? d "%place") (lst (list (sym "place" "" 0) (ty-sexp v s (car args))) "" 0 0))
                    ((string=? d "%escape-tag") (lst (cons (sym "escape-tag" "" 0) (map (lambda ((x ty)) (ty-sexp v s x)) args)) "" 0 0))
                    ((string=? d "%mark-key") (lst (list (sym "mark-key" "" 0) (ty-sexp v s (car args)) (ty-sexp v s (car (cdr args)))) "" 0 0))
                    ((string=? d "%poly")
                     (lst (list (sym "poly" "" 0)
                                (lst (map (lambda ((n string)) (lst (list (sym (written-binder n) "" 0) (sym (binder-kind n) "" 0)) "" 0 0)) (poly-binders-of args)) "" 0 0)
                                (ty-sexp v s (poly-written args)))
                          "" 0 0))
                    ((or (string=? d "%addr") (string=? d "%inbox") (string=? d "%icell"))
                     (lst (list (sym (after-prefix d "%") "" 0) (ty-sexp v s (car args)) (ty-sexp v s (car (cdr args)))) "" 0 0))
                    ((string=? d "%flat-sum")
                     (lst (cons (sym "sumof" "" 0)
                                (cons (tagcase (car args) (ty-rconst (n) (sym n "" 0)) (else other (sym "u8" "" 0)))
                                      (map (lambda ((f fvar)) (tagcase f (fvar (l x) (lst (list (sym l "" 0) (ty-sexp v s x)) "" 0 0))))
                                           (flat-sum-variants args))))
                          "" 0 0))
                    (else (lst (cons (sym d "" 0) (map (lambda ((x ty)) (ty-sexp v s x)) args)) "" 0 0))))
            (ty-flat (e r) (lst (list (sym "flatarrayof" "" 0) (ty-sexp v s e) (ty-sexp v s r)) "" 0 0))
            (ty-shape (p ls ts)
              (lst (cons (sym (if p "productof" "sumof") "" 0) (fields-sexp v s ls ts)) "" 0 0))
            (ty-tag (a h d r) (lst (list (sym "prompt-tag" "" 0) (ty-sexp v s a) (ty-sexp v s h) (sym "pure" "" 0) (ty-sexp v s r)) "" 0 0))
            (ty-ref (e r) (lst (list (sym "ref" "" 0) (ty-sexp v s e) (ty-sexp v s r)) "" 0 0))
            (ty-rconst (n) (sym n "" 0))
            (ty-proc (es ps r)
              (lst (list (sym "subr" "" 0) (cond ((suspends? es) (lst (list (sym "maxeff" "" 0) (lst (list (sym "goto" "" 0) (sym "@escape" "" 0)) "" 0 0) (lst (list (sym "comefrom" "" 0) (sym "@escape" "" 0)) "" 0 0)) "" 0 0))
                                                    ((escapes? es) (lst (list (sym "goto" "" 0) (sym "@escape" "" 0)) "" 0 0))
                                                    ((crossing? (map (lambda ((a string)) (resolve-atom s a)) es)) (sym "pure" "" 0))
                                                    (else (sym "%local" "" 0)))
                         (lst (map (lambda ((p ty)) (ty-sexp v s p)) ps) "" 0 0) (ty-sexp v s r)) "" 0 0))
            (ty-var (n)
              "A poly's binder, inside it: as written, a region's without its `'`."
              (sym (if (has-prefix? n "'") (after-prefix n "'") n) "" 0))
            (ty-meta (k) (refuse v "a definition with no type, whose type is not known whole: write it")))))
      (fields-sexp (subr kfx (cv st strings tys) sexps)
        (lambda (v s ls ts)
          (if (or (null? ls) (null? ts))
              nil
              (cons (lst (list (sym (car ls) "" 0) (ty-sexp v s (car ts))) "" 0 0) (fields-sexp v s (cdr ls) (cdr ts)))))))

    (define settle-facts (subr kfx (st) facts)
      (lambda (s)
        "A definition's facts, those of types settled: `%metas what ?k ...`
         is `what T ...`."
        (map (lambda ((f fact))
               (tagcase f
                 (fact (file pos what)
                   (if (has-prefix? what "%metas ")
                       (let ((ws (read-all (string-chars (after-prefix what "%metas ")) "" 1)))
                         (fact file pos
                               (string-append (sym-name (car ws))
                                 (string-append " "
                                   (words-of (map (lambda ((m sexp)) (show-sexp (settled-sexp s (ty-meta (meta-number (sym-name m))) #f)))
                                                  (cdr ws)))))))
                       f))))
             (st-facts s))))

    (define module-scope (subr kfx (cv sexp string string) cv)
      (lambda (v spec m actual)
        "`v`, where a moduleof's type names are in scope: an abstract type
         `m..t` if `m` names a parameter, the module `actual`'s type `t` if one
         is given, or else a type of no representation, for reading the
         moduleof alone; a description, what it describes."
        (tagcase v
          (cv (bs ds als es here group file line fs tv at ix mk)
            (let ((abs (spec-abs spec)))
              (cv bs
                  (onto (map (lambda ((t string)) (dt (string-append (if (string=? m "") "%abstract" m) (string-append ".." t)) nil nil)) abs) ds)
                  (onto (map (lambda ((t string))
                               (alias t nil (sym (cond ((not (string=? actual "")) (string-append actual (string-append " " t)))
                                                       (else (string-append (if (string=? m "") "%abstract" m) (string-append ".." t)))) "" 0)))
                             abs)
                        (onto (map (lambda ((d sexps)) (alias (sym-name (second d)) nil (third d))) (spec-items spec "desc"))
                              als))
                  es here group file line fs tv at ix mk))))))

    (define spec-well-formed (subr kfx (cv sexp) unit)
      (lambda (v spec)
        "A moduleof's items each `(abs name type)`, `(abs (name ...) type)`,
         `(desc name T)` or `(val name T)`; no name twice."
        (begin
          (map (lambda ((x sexp))
                 (let ((ys (items x)))
                   (cond ((and (sym-is? (car ys) "abs") (i64= (size ys) 3) (sym-is? (third ys) "type")
                               (not (any? (lambda ((n string)) (or (string=? (camel n) "Self") (string=? (camel n) "Module")))
                                          (tagcase (second ys) (sym (n at-file at-pos) (list n)) (lst (ns f l p) (map sym-name ns)) (else other nil)))))
                          #u)
                         ((and (or (sym-is? (car ys) "desc") (sym-is? (car ys) "val")) (i64= (size ys) 3)
                               (tagcase (second ys) (sym (n at-file at-pos) #t) (else other #f)))
                          #u)
                         (else (refuse v (string-append "a module type's item KFX does not have: " (show-sexp x)))))))
               (cdr (items spec)))
          (if (or (repeated? (onto (spec-abs spec) (map (lambda ((d sexps)) (sym-name (second d))) (spec-items spec "desc"))))
                  (repeated? (map (lambda ((d sexps)) (sym-name (second d))) (spec-items spec "val"))))
              (refuse v "a name appears twice in a module type")
              (if (any? rust-keyword-clash? (onto (spec-abs spec) (map (lambda ((d sexps)) (sym-name (second d))) (onto (spec-items spec "desc") (spec-items spec "val")))))
                  (refuse v "a module type's name that is `self`, `super` or `crate`, which no Rust name may be (C41)")
              #u)))))

    (define module-type-values (subr kfx (cv sexp) binds)
      (lambda (v spec)
        "A moduleof's values, their types read in `v`, as items. A `poly`'s
         is its scheme (C119): in Rust a generic function of the trait. One
         that may abort returns a `Result`, as a top-level procedure does."
        (map (lambda ((x sexps))
               (let* ((sc (if (head-is? (third x) "poly")
                              (parse-scheme v (third x))
                              (scheme nil (parse-type v (cv-tvars v) (third x)))))
                      (t (tagcase sc (scheme (tv t) t))))
                 (if (suspends? (tagcase t (ty-proc (es ps r) es) (else other nil)))
                     (refuse v "a module type's value that may suspend, which KFX's traits do not have yet")
                     (bind (sym-name (second x)) sc "item"))))
             (spec-items spec "val"))))

    (define-rec
      (has-var? (subr kfx (st ty) bool)
        (lambda (s t)
          "Whether `t` mentions a type or region variable."
          (tagcase (walk s t)
            (ty-var (n) #t)
            ;; A function's own binders are bound in it (C173), a poly's in it.
            (ty-data (d args) (if (or (string=? d "%dlambda") (string=? d "%poly")) #f (any? (lambda ((x ty)) (has-var? s x)) args)))
            (ty-list (e r) (or (has-var? s e) (has-var? s r)))
            (ty-flat (e r) (or (has-var? s e) (has-var? s r)))
            (ty-ref (e r) (or (has-var? s e) (has-var? s r)))
            (ty-tag (a h d r) (or (has-var? s a) (has-var? s h) (has-var? s r)))
            (ty-shape (p ls ts) (any? (lambda ((x ty)) (has-var? s x)) ts))
            (ty-proc (es ps r) (or (has-var? s r) (any? (lambda ((x ty)) (has-var? s x)) ps)))
            (else other #f)))))

    (define opened-aliases (subr kfx (string aliases) aliases)
      (lambda (m als)
        "Module `m`'s types, named as `m` names them."
        (if (null? als)
            nil
            (tagcase (car als)
              (alias (n ps body)
                (if (has-prefix? n (string-append m " "))
                    (cons (alias (after-prefix n (string-append m " ")) ps body) (opened-aliases m (cdr als)))
                    (opened-aliases m (cdr als))))))))

    "Processes and `par` (C101), as FX-26 has them (Fixpt's `docs/fx26.md`,
     \"Processes and `par`\"; its `processes.rs`, rule for rule and in its
     words)."



    (define or-else (subr kfx (string string) string)
      (lambda (why next) (if (string=? why "") next why)))


    (define-rec
      (any-of (subr kfx ((subr kfx (string) bool) strings) strings)
        (lambda (p xs)
          "The first of `xs` that `p` holds of, alone; none if none."
          (cond ((null? xs) nil) ((p (car xs)) (list (car xs))) (else (any-of p (cdr xs)))))))


    (define-rec
      (untransmissible (subr kfx (cv st ty strings strings) string)
        (lambda (v s t bound seen)
          "Why a value of type `t` may not cross into another process, or \"\"
           if it may (`untransmissible`): `bound`, the binders of the polys
           around; `seen`, the datatypes looked into."
          (let ((data-at (lambda ((r ty) (what string))
                           (let ((n (region-string s r)))
                             (if (or (string=? n "acyclic") (string=? n "%fresh") (string-member? n bound))
                                 ""
                                 (string-append "a " (string-append what (string-append " at " (string-append (show-ty s r) ", which can be written")))))))))
            (tagcase (walk s t)
              (ty-meta (k) "a value whose type is not known here: say it, with `the`")
              (ty-var (n) (if (string-member? n bound) "" (string-append "a `" (string-append n "`, which could be anything"))))
              (ty-list (e r) (or-else (data-at r "list") (untransmissible v s e bound seen)))
              (ty-ref (e r) (or-else (data-at r "reference") (untransmissible v s e bound seen)))
              (ty-flat (e r) (data-at r "flat array"))
              (ty-tag (a h d r) (string-append "a " (show-ty s t)))
              (ty-shape (p ls ts) (untransmissible-all v s ts bound seen))
              (ty-proc (es ps r)
                (let ((bad (any-of (lambda ((a string)) (not (crossing-atom? bound a))) es)))
                  (if (null? bad)
                      (untransmissible-all v s (cons r ps) bound seen)
                      (string-append "a procedure that has " (show-effs bad)))))
              (ty-data (d args)
                (cond ((or (null? args) (string=? d "%addr")) "")
                      ((string=? d "%icell") (untransmissible v s (car args) bound seen))
                      ((string=? d "%inbox")
                       (if (string-member? (region-string s (car (cdr args))) bound)
                           ""
                           "a process's own mailbox, which only it may take from"))
                      ((string=? d "%array") (or-else (data-at (car (cdr args)) "array") (untransmissible v s (car args) bound seen)))
                      ((or (string=? d "%pairof") (string=? d "%union") (string=? d "%vsubr"))
                       "kayak's own (C102): FX-26 lets one cross, but its Rust, kayak-rt's
                        `Value` or a variadic closure, is not `Send`."
                       (string-append "a " (string-append (show-ty s t) ", which KFX's Rust does not share between threads (C102)")))
                      ((string=? d "%mu")
                       "A recursive type (C174): as its body is, itself there as it is."
                       (untransmissible v s (car (cdr args)) (cons (tagcase (car args) (ty-var (n) n) (else other "")) bound) seen))
                      ((string-member? d seen) "")
                      ((and (dt-named? d (cv-dts v)) (not (generative? v (walk s t))))
                       "A datatype, FX-26's sum of products: as its fields are."
                       (untransmissible-all v s (concat (map (lambda ((x variant)) (tagcase x (variant (tag fields) fields)))
                                                             (instantiate-variants (family-of v d) args (variants-of v d))))
                                            bound (cons d seen)))
                      (else (string-append "a " (show-ty s t)))))
              (else other "")))))
      (untransmissible-all (subr kfx (cv st tys strings strings) string)
        (lambda (v s ts bound seen)
          (if (null? ts) "" (or-else (untransmissible v s (car ts) bound seen) (untransmissible-all v s (cdr ts) bound seen))))))


    (define-rec
      (sync-type? (subr kfx (cv st ty strings) bool)
        (lambda (v s t seen)
          "Whether a value of type `t` is, in Rust, `Send` and `Sync` (C102): a
           scalar, a string; a list, a product, a sum, a datatype of such; an
           address or an I-cell of one; a procedure whose latent effect a
           process may have, which the emitter writes `Send + Sync`. Not a
           cell (a reference, an array, a bloblet), a union's `Value`, a type
           variable (a Rust type parameter, of no such bound), a tag."
          (tagcase (walk s t)
            (ty-list (e r) (sync-type? v s e seen))
            (ty-ref (e r) #f)
            (ty-flat (e r) #f)
            (ty-tag (a h d r) #f)
            (ty-var (n) #f)
            (ty-shape (p ls ts) (all-sync? v s ts seen))
            (ty-proc (es ps r) (crossing? (map (lambda ((a string)) (resolve-atom s a)) es)))
            (ty-data (d args)
              (cond ((null? args) (not (or (string=? d "datum") (has-prefix? d "%module"))))
                    ((or (string=? d "%addr") (string=? d "%inbox") (string=? d "%icell")) (sync-type? v s (car args) seen))
                    ((string=? d "%pairof")
                     "A pair whose tail is a list is that list, in Rust (C68); any other a
                      union's `Value`."
                     (tagcase (walk s (car (cdr args)))
                       (ty-list (e r) (and (sync-type? v s (car args) seen) (sync-type? v s e seen)))
                       (else other #f)))
                    ((has-prefix? d "%") #f)
                    ((string-member? d seen) #t)
                    ((and (dt-named? d (cv-dts v)) (not (generative? v (walk s t))))
                     (all-sync? v s (concat (map (lambda ((x variant)) (tagcase x (variant (tag fields) fields)))
                                                 (instantiate-variants (family-of v d) args (variants-of v d))))
                                (cons d seen)))
                    (else #f)))
            (else other #t))))
      (all-sync? (subr kfx (cv st tys strings) bool)
        (lambda (v s ts seen)
          (or (null? ts) (and (sync-type? v s (car ts) seen) (all-sync? v s (cdr ts) seen))))))

    (define-rec
      (reverse-effs (subr kfx ((listof strings acyclic) (listof strings acyclic)) (listof strings acyclic))
        (lambda (xs acc) (if (null? xs) acc (reverse-effs (cdr xs) (cons (car xs) acc))))))

    (define held-sync? (subr kfx (cv st sexps) bool)
      (lambda (v s es)
        "Whether every local the expressions `es` name, bound outside them,
         is `Sync` (C102); one bound in them too counts, as `synced-lambda`'s."
        (not (any? (lambda ((n string))
                     (let ((found (scope-bind n v)))
                       (and (not (null? found))
                            (tagcase (car found)
                              (bind (b sc wher)
                                (and (or (string=? wher "local") (string=? wher "narrowed") (string=? wher "rec") (string=? wher "ends"))
                                     (not (sync-type? v s (tagcase sc (scheme (tv t) t)) nil))))))))
                   (distinct (names-in-all es))))))

    (define regions-may-be-one? (subr kfx (string string) bool)
      (lambda (p q)
        "Two regions that may be one: the same, or either not a constant;
         two constants of other names are two."
        (or (string=? p q) (not (has-prefix? p "@")) (not (has-prefix? q "@")))))

    (define-rec
      (fills-before? (subr kfx (strings strings) bool)
        (lambda (a b)
          "Whether a branch of effect `a` fills an I-cell one of effect `b` may
           await: `a` must run first, if they run in turn."
          (any? (lambda ((x string))
                  (and (has-prefix? x "init:")
                       (any? (lambda ((y string)) (and (has-prefix? y "await:") (regions-may-be-one? (atom-region x) (atom-region y)))) b)))
                a))))

    (define-rec
      (par-order (subr kfx ((listof strings acyclic) (listof i64 acyclic) (listof i64 acyclic)) (listof i64 acyclic))
        (lambda (effs left acc)
          "An order to run `par`'s branches in turn, `effs` their effects in
           order: the first left that no branch left must fill for, again and
           again; in their order where a cycle leaves none, which run in turn
           deadlocks (C102: `unsafe-par` runs them at once)."
          (if (null? left)
              (reverse-i64s acc nil)
              (let* ((ready (lambda ((i i64)) (not (any? (lambda ((j i64)) (and (not (i64= i j)) (fills-before? (effs-at effs j) (effs-at effs i)))) left))))
                     (pick (if (any? ready left) (car (concat (map (lambda ((i i64)) (if (ready i) (the (listof i64 acyclic) (list i)) nil)) left))) (car left))))
                (par-order effs (concat (map (lambda ((i i64)) (if (i64= i pick) nil (the (listof i64 acyclic) (list i)))) left)) (cons pick acc))))))
      (effs-at (subr kfx ((listof strings acyclic) i64) strings)
        (lambda (effs i) (if (i64= i 0) (car effs) (effs-at (cdr effs) (i64- i 1)))))
      (reverse-i64s (subr kfx ((listof i64 acyclic) (listof i64 acyclic)) (listof i64 acyclic))
        (lambda (xs acc) (if (null? xs) acc (reverse-i64s (cdr xs) (cons (car xs) acc))))))

    (define par-threads? (subr kfx (cv st (listof strings acyclic) binds sexps) bool)
      (lambda (v s effs bound es)
        "Whether `par`'s branches may run on threads in safe Rust (C102): each
         branch's effect one a process may have, so that it touches nothing
         another can write; what each holds, and gives back, `Sync`. Else they
         share what is written, in regions no other branch touches, which
         only the interference check knows: `par2_shared`."
        (and (not (any? (lambda ((es strings)) (not (crossing? (map (lambda ((a string)) (resolve-atom s a)) es)))) effs))
             (not (any? (lambda ((b bind)) (tagcase b (bind (n sc w) (not (sync-type? v s (tagcase sc (scheme (tv t) t)) nil))))) bound))
             (held-sync? v s es))))

    (define synced-lambda (subr kfx (cv st strings sexps sexps) st)
      (lambda (v s es params forms)
        "A lambda whose latent effect `es` a process may have: its closure, in
         Rust, `Send + Sync` (C102), noted for the emitter, so that it may be
         held on another thread, as FX-26 lets it be; so each local it holds
         must be `Sync` too, which rustc checks of the Rust and KFX here, said
         in KFX's words. A local named by the body but bound in it too is
         taken as held: KFX refuses more than it must, then, never less."
        (if (not (crossing? (map (lambda ((a string)) (resolve-atom s a)) es)))
            s
            (let* ((own (map (lambda ((p sexp)) (tagcase p (lst (ys f l q) (sym-name (car ys))) (else other (sym-name other)))) params))
                   (unshared (filter (lambda ((n string))
                                       (let ((found (scope-bind n v)))
                                         (and (not (null? found)) (not (string-member? n own))
                                              (tagcase (car found)
                                                (bind (b sc wher)
                                                  (and (or (string=? wher "local") (string=? wher "narrowed") (string=? wher "rec") (string=? wher "ends"))
                                                       (not (sync-type? v s (tagcase sc (scheme (tv t) t)) nil))))))))
                                     (distinct (names-in-all forms))))
                   (s (if (null? unshared)
                          s
                          ;; Rust's `Sync`, not FX-26's rule: noted for kfx (C154, C158).
                          (let ((n (car unshared)))
                            (kfx-restricted v s (string-append "a procedure that may be held on another thread, its effect being one a process may have, holds `"
                                                  (string-append n (string-append "`, a " (string-append (show-ty s (tagcase (car (scope-bind n v)) (bind (b sc wher) (tagcase sc (scheme (tv t) t)))))
                                                    ", which may not be: KFX's procedures hold only what they may share (C102)")))))))))
              (note-fact s (cv-file v) (cv-pos v) "sync")))))

    (define-rec
      (binds-from (subr kfx (string binds) binds)
        (lambda (name bs)
          "The bindings from the innermost of `name` on, the older after it."
          (cond ((null? bs) nil)
                ((tagcase (car bs) (bind (n sc w) (string=? n name))) bs)
                (else (binds-from name (cdr bs)))))))

    (define process-marks (subr kfx (strings) strings)
      (lambda (tvars)
        "The processes' bodies being checked, innermost first: each a
         `%process N` among the type variables, and a binding of that name."
        (concat (map (lambda ((n string)) (if (has-prefix? n "%process ") (the strings (list n)) nil)) tvars))))


    (define-rec
      (fold-digits (subr kfx ((listof char acyclic) i64) i64)
        (lambda (cs k) (if (null? cs) k (fold-digits (cdr cs) (i64+ (i64* k 10) (i64- (char->i64 (car cs)) 48)))))))


    (define digits-value (subr kfx (string) i64)
      (lambda (x) (fold-digits (string->list x) 0)))


    (define-rec
      (held (subr kfx (cv st string binds strings) st)
        (lambda (v s name found marks)
          "That a process's body names `name`, bound outside it (as `found`
           is): noted, for each process it is outside of, to be checked
           transmissible once the body is."
          (if (null? marks)
              s
              (let ((mark (binds-from (car marks) (cv-binds v))))
                (held v (if (and (not (null? mark)) (i64< (size (binds-from name (cv-binds v))) (size mark)))
                            (note-fact s "%process" (digits-value (after-prefix (car marks) "%process ")) (string-append "held " name))
                            s)
                      name found (cdr marks)))))))


    (define holds-checked (subr kfx (cv st i64) st)
      (lambda (v s id)
        "Each name a process's body holds from outside it, of a transmissible
         type: but the standard bindings, which are the runtime's."
        (begin
          (map (lambda ((f fact))
                 (tagcase f
                   (fact (file pos what)
                     (if (and (string=? file "%process") (i64= pos id) (has-prefix? what "held "))
                         (let* ((name (after-prefix what "held "))
                                (found (scope-bind name v)))
                           (if (null? found)
                               #u
                               (tagcase (car found)
                                 (bind (n sc wher)
                                   (if (string=? wher "prim")
                                       #u
                                       (tagcase sc
                                         (scheme (tvars t)
                                           (let ((why (untransmissible v s t tvars nil)))
                                             (if (string=? why "")
                                                 #u
                                                 (begin
                                                   (refuse v (string-append "a process may share nothing that can be written, and its body holds `"
                                                               (string-append name (string-append "`: " why))))
                                                   #u))))))))))
                         #u))))
               (st-facts s))
          s)))


    (define interferes? (subr kfx (string string) bool)
      (lambda (a b)
        "Whether atom `a` interferes with `b`, one way, on regions that may be
         one: a write against a read, a write, a fill or an await; a fill
         against a write; a send against a send; a receive against a send
         or a receive; I/O against I/O; an effect variable against all but
         an allocation, `spin` and `nondet` (`interferes`)."
        (let* ((harmless (lambda ((x string)) (or (has-prefix? x "alloc:") (string=? x "spin") (string=? x "nondet")
                                                  (global-atom? x) (string=? x "@globals"))))
               (one (and (region-atom? a) (region-atom? b) (regions-may-be-one? (atom-region a) (atom-region b))))
               (kind (lambda ((x string) (k string)) (has-prefix? x (string-append k ":")))))
          (cond ((and (has-prefix? a "~") (not (string=? a "~!"))) (not (harmless b)))
                ((kind a "write") (and one (or (kind b "read") (kind b "write") (kind b "init") (kind b "await"))))
                ((kind a "init") (and one (kind b "write")))
                ((kind a "send") (and one (kind b "send")))
                ((kind a "receive") (and one (or (kind b "send") (kind b "receive"))))
                ((kind a "io") (kind b "io"))
                (else #f)))))



    (define-rec
      (clash-of (subr kfx (strings strings) strings)
        (lambda (x y)
          "The first pair of atoms, one of `x` and one of `y`, that interfere;
           none if none."
          (if (null? x)
              nil
              (let ((hit (any-of (lambda ((b string)) (or (interferes? (car x) b) (interferes? b (car x)))) y)))
                (if (null? hit) (clash-of (cdr x) y) (list (car x) (car hit))))))))


    (define-rec
      (par-clash (subr kfx (cv (listof strings acyclic)) unit)
        (lambda (v effs)
          "No two branches of `par` interfere, `effs` their effects, the last
           branch's first."
          (if (null? effs)
              #u
              (begin
                (map (lambda ((other strings))
                       (let ((c (clash-of other (car effs))))
                         (if (null? c)
                             #u
                             (begin
                               (refuse v (string-append "`par`'s branches interfere: one has " (string-append (show-effs (list (car c)))
                                           (string-append " and another " (string-append (show-effs (cdr c))
                                             ", so the answer could depend on which runs first")))))
                               #u))))
                     (cdr effs))
                (par-clash v (cdr effs)))))))


    (define pselect-arm? (subr kfx (sexp) bool)
      (lambda (arm)
        "`((icell-get c) x body ...)`, `((receive box) x body ...)`,
         `((sleep-until t) x body ...)`, a deadline (C108), or `((read-byte) x
         body ...)`, a key (C109)."
        (tagcase arm
          (lst (ys f l p)
            (and (i64>= (size ys) 3)
                 (tagcase (second ys) (sym (n f2 p2) #t) (else other #f))
                 (tagcase (car ys)
                   (lst (ws f3 l3 p3) (or (and (i64= (size ws) 2) (or (sym-is? (car ws) "icell-get") (sym-is? (car ws) "receive") (sym-is? (car ws) "sleep-until")))
                                          (and (i64= (size ws) 1) (sym-is? (car ws) "read-byte"))))
                   (else other #f))))
          (else other #f))))


    "A module value made (C170): the scope its items have made so far, its
     items' types (newest first), the effect of making it, the state."
    (define-datatype mres (mres cv tys strings st))

    (define-rec
      (synth (subr kfx (cv st sexp) res)
        (lambda (v s e)
          (if (draft-hole? e)
              (refuse v "the hole: an expression")
          (tagcase e
            (num (k num-file num-pos) (res (ty-int) nil (note-fact s num-file num-pos "int")))
            (big (text f p) (res (ty-int) nil s))
            (chr (c at-file at-pos) (res (ty-char) nil s))
            (real (x at-file at-pos) (res (ty-f64) nil s))
            (str (x at-file at-pos) (res (ty-string) nil s))
            (sym (name at-file at-pos)
              (tagcase (synth-name v s name at-pos)
                (res (t es s)
                  (if (string=? name "nil")
                      (tagcase (walk s t)
                        (ty-list (el r) (res t es (note-turbofish s at-file at-pos (list el))))
                        (else other (res t es s)))
                      (res t es (narrowing-unboxed v (async-global v s name at-file at-pos) name at-file at-pos t))))))
            (lst (xs src-file src-line src-pos)
              (let ((v (near v src-file src-line src-pos)))
                (tagcase (car xs)
                  (sym (h at-file at-pos) (synth-form v s e h (cdr xs)))
                  ;; A procedure computed, not named: `spin` only if its type
                  ;; is cyclic, so that it could be given itself (FX-26's rule,
                  ;; Fixpt's infer.rs; C105).
                  (else head
                    (let ((hr (synth v s head)))
                      (tagcase hr
                        (res (ht hes hs)
                          (cwcc-masked v head (cdr xs)
                          (mark-lifted v (if (head-is? head "proj") (proj-base v head) "") (cdr xs)
                          (void-call v #f #f (synth-call-of v s hr (cdr xs) nil nil
                                                            (effs-union
                                                              (if (head-is? head "proj") (cwcc-spin (proj-base v head) (cdr xs)) nil)
                                                              (if (or (head-is? head "proj") (head-is? head "lambda") (not (self-applicable? v hs ht)))
                                                                  nil
                                                                  (list "spin"))))))))))))))))))

      (async-global (subr kfx (cv st string string i64) st)
        (lambda (v s name file pos)
          "A global procedure that may suspend, named as a value: an `async fn`,
           given as a closure that boxes its future (C46), noted with its arity."
          (let ((found (scope-bind name v)))
            (if (null? found)
                s
                (tagcase (car found)
                  (bind (n sc wher)
                    (if (string=? wher "global")
                        (tagcase sc
                          (scheme (tv t)
                            (tagcase t
                              (ty-proc (es ps r) (if (suspends? es) (note-fact s file pos (string-append "async-global " (i64->string (size ps)))) s))
                              (else other s))))
                        s)))))))

      (synth-name (subr kfx (cv st string i64) res)
        (lambda (v s name at-pos)
          (cond ((or (string=? name "#t") (string=? name "#f")) (res (ty-bool) nil s))
                ((string=? name "#u") (res (ty-unit) nil s))
                (else
                 (let ((found (scope-bind name v)))
                   (if (null? found)
                       (refuse (at-offset v at-pos) (string-append "nothing is named " name))
                       (tagcase (car found)
                         (bind (n sc wher)
                           (cond ((and (not (string=? wher "local")) (not (string=? wher "module")) (tagcase sc (scheme (tv t) (tagcase t (ty-unit () #t) (else other #f))))
                                       (any? (lambda ((b bind)) (tagcase b (bind (m sc2 w2) (has-prefix? m (string-append name " "))))) (cv-binds v)))
                                  "A module in a module (C88), as a value (C172): of its items' type."
                                  (res (module-type-of v name) nil (kfx-restricted v s (string-append "a module as a value: KFX's modules are Rust's, opened by with: " name))))
                                 ((string=? wher "unmade")
                                  (refuse v (string-append "`" (string-append name "` here is the module's own item, made after this, not the one bound outside it"))))
                                 ((string=? wher "module")
                                  "A module defined at the top level, as a value (C170): of the
                                   type its items give. FX-26's; KFX's modules are Rust's."
                                  (res (module-type-of v name) (list (string-append "g:" name))
                                       (kfx-restricted v s (string-append "a module as a value: KFX's modules are Rust's, opened by with: " name))))
                                 (else
                               (tagcase (named-instance v (held v (if (or (not (null? (module-spec v (tagcase sc (scheme (tv t) t)))))
                                                                         (tagcase sc (scheme (tv t) (tagcase t (ty-proc (es ps r) (any? (lambda ((p ty)) (not (null? (module-spec v p)))) ps)) (else other #f)))))
                                                                     (kfx-restricted v s (string-append "a module parameter, or a procedure of one, a Rust generic fn, named as a value: " name))
                                                                     s)
                                                                 name found (process-marks (cv-tvars v))) sc)
                                 (inst (t s regions effects) (res (lengths-named name t) (naming-effs s name wher t (cv-group v)) s)))))))))))))

      (quasi-items (subr kfx (cv st sexps i64) res)
        (lambda (v s ds depth)
          "A quasiquoted list's items at `depth`: what each unquote at depth 1
           holds, checked; their effects."
          (if (null? ds)
              (res (ty-unit) nil s)
              (tagcase (quasi v s (car ds) depth)
                (res (t es s) (with-effs (quasi-items v s (cdr ds) depth) es))))))

      (quasi (subr kfx (cv st sexp i64) res)
        (lambda (v s d depth)
          (tagcase d
            (lst (ys f l p)
              (cond ((null? ys) (res (ty-unit) nil s))
                    ((and (i64= (size ys) 2) (or (head-is? d "unquote") (head-is? d "unquote-splicing")))
                     (cond ((i64> depth 1) (quasi v s (second ys) (i64- depth 1)))
                           ((head-is? d "unquote") (check v s (second ys) (ty-data "datum" nil)))
                           (else
                            (tagcase (synth v s (second ys))
                              (res (t es s1)
                                (tagcase (walk s1 t)
                                  (ty-list (el r)
                                    "A list of datums, as FX-26's `append` takes it: no
                                     list of ints, say (K1)."
                                    (res t es (fits v (fits v s1 el (ty-data "datum" nil)) (ty-data "datum" nil) el)))
                                  (else other (refuse v (string-append "an unquote-splicing of what is no list of datums: " (show-ty s1 t))))))))))
                    ((and (i64= (size ys) 2) (head-is? d "quasiquote")) (quasi v s (second ys) (i64+ depth 1)))
                    (else (quasi-items v s ys depth))))
            (else other (res (ty-unit) nil s)))))

      (check (subr kfx (cv st sexp ty) res)
        (lambda (v s e expected)
          "`e` where an `expected` is wanted; a member boxed for its union (C75)."
          (tagcase (check-plain v s e expected)
            (res (t es s)
              (if (and (valued? s expected) (not (valued? s t)))
                  (res expected es (coerced v s (datum-file e) (datum-pos e) t expected))
                  (res t es (coerced v s (datum-file e) (datum-pos e) t expected)))))))

      (check-plain (subr kfx (cv st sexp ty) res)
        (lambda (v s e expected)
          (let ((x (walk s expected)))
            (if (draft-hole? e)
                (refuse-named v s (string-append "the hole: " (tagcase x (ty-meta (m) "an expression") (else other (string-append "an expression of type " (show-ty s (zonk s x)))))))
            (if (and (tagcase e (sym (n f p) (string=? n "#f")) (else other #f))
                     (or (string=? (show-ty s x) "false")
                         (tagcase x (ty-data (d args) (and (string=? d "%union") (not (null? (member-of-shape args "bool")))
                                                           (string=? (show-ty s (car (member-of-shape args "bool"))) "false")))
                           (else other #f))))
                (res (ty-data "false" nil) nil s)
            (if (and (string=? (shape-of x) "union") (not (string=? (literal-shape e) "")))
                (let ((m (member-of-shape (members-of x) (literal-shape e))))
                  (if (null? m)
                      (refuse-named v s (string-append "a literal is here, where a " (string-append (show-ty s x) " is expected")))
                      (check v s e (car m))))
            (tagcase e
              (num (k num-file num-pos)
                "A literal is an `i64` where one is expected, and otherwise an
                 `int`, as in FX-26: an inference variable it meets is solved
                 to `int`."
                (tagcase x
                  (ty-i64 () (res x nil s))
                  (ty-int () (res x nil (note-fact s num-file num-pos "int")))
                  (ty-nat ()
                    (if (or (i64< k 0) (i64> k 1152921504606846975))
                        (refuse v (string-append (i64->string k) " is no nat: FX-26's nat literals are below 2^60"))
                        (res x nil (note-fact s num-file num-pos "int"))))
                  (ty-meta (m) (res (ty-int) nil (note-fact (solve s m (ty-int)) num-file num-pos "int")))
                  (ty-data (d args)
                    (cond ((string=? d "%natof")
                           "A natural where `(nat s)` is wanted: `s` shown to be it (C158)."
                           (let ((z (size-lin s (car args))))
                             (cond ((i64< k 0) (refuse v (string-append (i64->string k) " is no nat")))
                                   ((and (not (null? z)) (size-shown? v s (lin-add (car z) (lin k nil) -1)) (size-shown? v s (lin-add (lin k nil) (car z) -1)))
                                    (res x nil (note-fact s num-file num-pos "int")))
                                   (else (refuse-named v s (string-append "a literal is here, where a " (string-append (show-ty s x) " is expected")))))))
                          ((and (string=? d "i32") (not (i64< k -2147483648)) (not (i64> k 2147483647)))
                           (res x nil (note-fact s num-file num-pos "fixed i32")))
                          ((and (string=? d "u32") (not (i64< k 0)) (not (i64> k 4294967295)))
                           (res x nil (note-fact s num-file num-pos "fixed u32")))
                          ((and (string=? d "u64") (not (i64< k 0)))
                           (res x nil (note-fact s num-file num-pos "fixed u64")))
                          ((and (string=? d "u8") (not (i64< k 0)) (not (i64> k 255)))
                           (res x nil (note-fact s num-file num-pos "fixed u8")))
                          ((and (string=? d "i8") (not (i64< k -128)) (not (i64> k 127)))
                           (res x nil (note-fact s num-file num-pos "fixed i8")))
                          ((fixed-width? d) (refuse v (string-append (i64->string k) (string-append " is not a " d))))
                          (else (refuse-named v s (string-append "a literal is here, where a " (string-append (show-ty s x) " is expected"))))))
                  (else other (refuse v (string-append "a literal is here, where a "
                                                       (string-append (show-ty s x) " is expected"))))))
              (big (text f p)
                "A literal past an i64: an `int`, or a `nat` if not negative."
                (tagcase x
                  (ty-int () (res x nil s))
                  (ty-nat () (refuse v (string-append text " is no nat: FX-26's nat literals are below 2^60")))
                  (ty-meta (m) (res (ty-int) nil (solve s m (ty-int))))
                  (ty-data (d args)
                    (if (and (string=? d "u64") (not (char=? (string-ref-i64 text 0) #\-))
                             (or (i64< (string-length-i64 text) 20)
                                 (and (i64= (string-length-i64 text) 20) (digits-at-most? (string-chars text) (string-chars "18446744073709551615")))))
                        (res x nil (note-fact s f p "fixed u64"))
                        (refuse v (string-append text (string-append " is not a " d)))))
                  (else other (refuse-named v s (string-append "a literal past an i64 is here, where a " (string-append (show-ty s x) " is expected"))))))
              (lst (xs src-file src-line src-pos)
                (let ((v (near v src-file src-line src-pos)))
                  (tagcase (car xs)
                    (sym (h at-file at-pos) (check-form v s e h (cdr xs) x))
                    (else other (check-by-synth v s e x)))))
              (sym (name at-file at-pos)
                (cond ((and (string=? name "nil") (std-prim? v "nil") (sized? x "%nlist"))
                       "`nil` where a list of a size is wanted: of size 0 (C158)."
                       (res x nil (size-fits v s (size-of-lin (lin 0 nil)) (sized-size x) (ty-data "nil" nil) x)))
                      ((and (string=? name "nil") (string=? (shape-of x) "union")
                            (not (null? (member-of-shape (members-of x) "nil")))
                            (null? (member-of-shape (members-of x) "list")))
                       "`nil` where a union with a `nil` member is wanted (C84): that
                        member, as FX-26 has it."
                       (res (ty-data "nil" nil) nil s))
                      ((string=? name "nil")
                       (tagcase x
                         (ty-list (el r) (res x nil (note-turbofish s at-file at-pos (list el))))
                         (else other (check-by-synth v s e x))))
                      (else (check-by-synth v s e x))))
              (else other (check-by-synth v s e x)))))))))

      (check-by-synth (subr kfx (cv st sexp ty) res)
        (lambda (v s e expected)
          "An expression found, then fitted to what is expected: a procedure
           that cannot abort where one that may is expected is lifted, its Rust
           type returning no `Result` (`lift N` at it, `N` its arity, wherever
           it stands: an argument, a list's element, a branch, a field)."
          (if (draft-hole? e)
              (refuse-named v s (string-append "the hole: " (tagcase (walk s expected) (ty-meta (m) "an expression") (else other (string-append "an expression of type " (show-ty s (zonk s expected)))))))
          (tagcase (synth v s e)
            (res (t es s)
              (res expected es
                   (let ((s (coerced v (fits v s t expected) (datum-file e) (datum-pos e) t expected)))
                     (tagcase (walk-mu s t)
                       (ty-proc (pes ps r)
                         (tagcase (walk s expected)
                           (ty-proc (ees eps er)
                             (cond ((and (suspends? ees) (not (suspends? pes)))
                                    (note-fact s (datum-file e) (datum-pos e) (string-append (if (escapes? pes) "lift-suspend-fallible " "lift-suspend ") (i64->string (size ps)))))
                                   ((and (escapes? ees) (not (escapes? pes)))
                                    (note-fact s (datum-file e) (datum-pos e) (string-append "lift " (i64->string (size ps)))))
                                   (else s)))
                           (else other s)))
                       (else other s)))))))))

      (body (subr kfx (cv st sexps tys) res)
        (lambda (v s es expected)
          "A body: each expression but the last for its effect, the last
           checked against `expected` if it has one type in it, else found."
          (if (null? (cdr es))
              (if (null? expected) (synth v s (car es)) (check v s (car es) (car expected)))
              (tagcase (synth-any v s (car es))
                (res (t es0 s) (with-effs (body v s (cdr es) expected) es0))))))

      (synth-any (subr kfx (cv st sexp) res)
        (lambda (v s e)
          "An expression whose value is dropped: a string is a comment."
          (tagcase e
            (str (x at-file at-pos) (res (ty-unit) nil s))
            (else other (synth v s e)))))

      (spawn-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(spawn (box M r) body ...)`: a process, its value the process's
           address, `(addr M A)`; `box`, its mailbox, `(inbox M r)`; `r`, its
           place, a reap. Its body is checked as a `letreap`'s is, with the
           mailbox bound; what it holds from outside, globals too, and its
           messages, must be transmissible; what it does but on `r`, what a
           process may do. That is the spawn's effect, with `nondet` if it
           does I/O, and the address's allocation (`synth_spawn`)."
          (let ((usage "a process's body is `(spawn (mailbox message-type place) body …)`"))
            (if (or (i64< (size xs) 2) (not (i64= (size (items (car xs))) 3))
                    (tagcase (car (items (car xs))) (sym (n f p) #f) (else other #t))
                    (tagcase (third (items (car xs))) (sym (n f p) #f) (else other #t)))
                (refuse v usage)
                (let* ((header (items (car xs)))
                       (box (sym-name (car header)))
                       (r (sym-name (third header)))
                       (name (string-append "'" r))
                       (m (parse-type v (cv-tvars v) (second header)))
                       (id (st-next s))
                       (s (tagcase (fresh s) (res (u es s2) s2)))
                       (mark (string-append "%process " (i64->string id))))
                  (if (string-member? name (cv-tvars v))
                      (refuse v (string-append "a process's place named as one already: " r))
                      (tagcase (letrena-form (with-binds (with-tvars v (list mark))
                                                         (list (bind mark (scheme nil (ty-unit)) "mark")
                                                               (local v box (ty-data "%inbox" (list m (ty-var name))))))
                                             s (cons (third header) (cdr xs)) nil)
                        (res (t es s)
                          (let* ((s (holds-checked v s id))
                                 (why (untransmissible v s m nil nil))
                                 (seen (masked (map (lambda ((a string)) (resolve-atom s a)) es) name))
                                 (bad (any-of (lambda ((a string)) (not (crossing-atom? nil a))) seen)))
                            (cond ((not (string=? why ""))
                                   (refuse v (string-append "a process's messages are copied to it, so they must be transmissible, and a "
                                               (string-append (show-ty s m) (string-append " is not: " why)))))
                                  ((not (null? bad))
                                   (refuse v (string-append "a process may share nothing that can be written, and its body has "
                                               (string-append (show-effs bad) ", on a region outside it"))))
                                  (else
                                   (let* ((at (tagcase (if (null? expected) (ty-unit) (walk s (car expected)))
                                                (ty-data (d args)
                                                  (if (and (string=? d "%addr") (string=? (show-ty s (car args)) (show-ty s m)))
                                                      (car (cdr args))
                                                      (ty-rconst "@process")))
                                                (else other (ty-rconst "@process"))))
                                          (seen (if (any? (lambda ((a string)) (has-prefix? a "io:")) seen) (effs-union (list "nondet") seen) seen))
                                          (s (note-types s (cv-file v) (cv-pos v) "spawn" (list m))))
                                     (res (ty-data "%addr" (list m at))
                                          (effs-union (list (string-append "alloc:" (region-string s at))) seen)
                                          s)))))))))))))

      (spawn-monitored-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(spawn-monitored w on-failure (box M r) body ...)` (C108): `spawn`,
           but a failure of the process is no failure of the program: its
           watcher, `w`, an `(addr W R)`, is sent `(on-failure message)`,
           `on-failure` a `(subr pure (string) W)`, found, not checked, as
           FX-26 finds it. The effect `spawn`'s, the two's, and `(send R)`
           (`synth_spawn_monitored`)."
          (if (i64< (size xs) 4)
              (refuse v "`(spawn-monitored watcher on-failure (mailbox message-type place) body …)`")
              (tagcase (synth v s (car xs))
                (res (wt wes s)
                  (tagcase (walk s wt)
                    (ty-data (d args)
                      (if (not (string=? d "%addr"))
                          (refuse v (string-append "a watcher is a process's address, `(addr M R)`, and this is a " (show-ty s wt)))
                          (tagcase (synth v s (second xs))
                            (res (ft fes s)
                              (let ((s (fits v s ft (ty-proc nil (list (ty-string)) (car args))))
                                    (sent (string-append "send:" (region-string s (car (cdr args))))))
                                (with-effs (with-effs (spawn-form v s (cdr (cdr xs)) expected) (effs-union wes fes)) (list sent)))))))
                    (else other (refuse v (string-append "a watcher is a process's address, `(addr M R)`, and this is a " (show-ty s wt))))))))))

      (self-form (subr kfx (cv st sexps) res)
        (lambda (v s xs)
          "`(self box)` (C108): the process's own address, at its place, from
           its mailbox: `(subr pure ((inbox M r)) (addr M r))`."
          (if (not (i64= (size xs) 1))
              (refuse v "`(self mailbox)`")
              (tagcase (synth v s (car xs))
                (res (t es s)
                  (tagcase (walk s t)
                    (ty-data (d args)
                      (if (string=? d "%inbox")
                          (res (ty-data "%addr" args) es s)
                          (refuse v (string-append "`self` is given a process's mailbox, and this is a " (show-ty s t)))))
                    (else other (refuse v (string-append "`self` is given a process's mailbox, and this is a " (show-ty s t))))))))))


      (par-values (subr kfx (cv st sexps sexps tys binds (listof strings acyclic) sexps) res)
          (lambda (v s bindings forms expected bound effs all)
            "`par`'s branches, each its own effect, then its body, their values
             bound as a `let`'s: no branch may transfer control out of itself,
             and no two may interfere (`synth_par`)."
            (if (null? bindings)
                (begin
                  (par-clash v effs)
                  (body (with-binds v bound)
                        (if (par-threads? v s effs bound (map (lambda ((b sexp)) (second (items b))) all))
                            (note-fact s (cv-file v) (cv-pos v) "par-threads")
                            (let ((in-order (reverse-effs effs nil)))
                              (note-fact s (cv-file v) (cv-pos v)
                                         (string-append "par-order " (words-of (map i64->string (par-order in-order (counting 0 (size in-order)) nil)))))))
                        forms expected))
                (let ((b (items (car bindings))))
                  (tagcase (synth v s (second b))
                    (res (t es s)
                      (let* ((es (map (lambda ((a string)) (resolve-atom s a)) es))
                             (out (any-of (lambda ((a string)) (or (has-prefix? a "goto:") (has-prefix? a "comefrom:"))) es)))
                        (if (not (null? out))
                            (refuse v (string-append "a `par` branch must end where it began, and this one has " (show-effs out)))
                            (with-effs (par-values v s (cdr bindings) forms expected
                                                   (cons (local v (name-of v (car b)) t) bound) (cons es effs) all)
                                       es)))))))))


      (par-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(par ((x e) ...) body ...)`: the branches, two or more, which may run
           at once, their values bound for the body."
          (cond ((or (i64< (size xs) 2) (tagcase (car xs) (lst (ys f l p) #f) (else other #t)))
                 (refuse v "`(par ((name expression) …) body …)`"))
                ((any? (lambda ((b sexp)) (or (tagcase b (lst (ys f l p) #f) (else other #t)) (not (i64= (size (items b)) 2))
                                              (tagcase (car (items b)) (sym (n f p) #f) (else other #t))))
                       (items (car xs)))
                 (refuse v "a `par` binding is `(name expression)`"))
                ((i64< (size (items (car xs))) 2)
                 (refuse v "`par` runs two branches or more: `(par ((name expression) …) body …)`"))
                (else (par-values v s (items (car xs)) (cdr xs) expected nil nil (items (car xs)))))))


      (race-branches (subr kfx (cv st sexps ty (listof strings acyclic)) res)
          (lambda (v s xs t effs)
            "Each branch of a `race` checked against `t`, each cancellable: it
             does nothing another could see (Fixpt's `k-race-cancellable`)."
            (if (null? xs)
                (begin (race-clash v effs) (res t (effs-union (list "nondet") (fold-effs effs)) s))
                (tagcase (tagcase (synth v s (car xs)) (res (u es s) (res u es (fits v s u t))))
                  (res (u es s)
                    (let* ((es (map (lambda ((a string)) (resolve-atom s a)) es))
                           (seen (any-of (lambda ((a string)) (or (has-prefix? a "write:") (has-prefix? a "init:") (has-prefix? a "send:")
                                                                  (has-prefix? a "io:") (has-prefix? a "goto:") (has-prefix? a "comefrom:")
                                                                  (has-prefix? a "~")))
                                         es)))
                      (if (not (null? seen))
                          (refuse v (string-append "a `race` branch, which loses by being cancelled, must do nothing another could see, and this one has " (show-effs seen)))
                          (race-branches v s (cdr xs) t (cons es effs)))))))))

      (race-clash (subr kfx (cv (listof strings acyclic)) unit)
        (lambda (v effs)
          "No two branches of `race` interfere."
          (if (null? effs)
              #u
              (begin
                (map (lambda ((other strings))
                       (let ((c (clash-of other (car effs))))
                         (if (null? c)
                             #u
                             (begin (refuse v (string-append "`race`'s branches interfere: one has " (string-append (show-effs (list (car c)))
                                                (string-append " and another " (show-effs (cdr c))))))
                                    #u))))
                     (cdr effs))
                (race-clash v (cdr effs))))))

      (race-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "FX-26's `(race e ...)` (C169; Fixpt's `k-race-te`): its branches run
           at once, the first to end gives the value and the rest are
           cancelled; each of one type, cancellable, no two interfering; its
           effect theirs and `nondet`. Not KFX's yet (C108)."
          (if (i64< (size xs) 2)
              (refuse v "`(race expression expression …)`")
              (let ((s (kfx-restricted v s "`(race e …)` is FX-26's form, which KFX does not have yet")))
                (if (null? expected)
                    (race-branches v s xs (race-type v s xs) nil)
                    (race-branches v s xs (car expected) nil))))))

      (race-type (subr kfx (cv st sexps) ty)
        (lambda (v s xs)
          "A `race`'s type, the first of its branches' not `void` (one that
           fails only loses)."
          (if (null? xs)
              (ty-void)
              (tagcase (synth v s (car xs))
                (res (t es s2) (tagcase (walk s2 t) (ty-void () (race-type v s (cdr xs))) (else other t)))))))

      (fold-effs (subr kfx ((listof strings acyclic)) strings)
        (lambda (effs) (if (null? effs) nil (effs-union (car effs) (fold-effs (cdr effs))))))

      (pselect-arms (subr kfx (cv st sexps tys) res)
          (lambda (v s arms expected)
            "Each arm's wait, its value bound for its body; the arms of one type,
             the first found, if none is expected, and the rest checked against
             it."
            (let ((ys (items (car arms))))
              (tagcase (synth v s (car ys))
                (res (w wes s)
                  (tagcase (body (with-binds v (list (local v (name-of v (second ys)) w))) s (cdr (cdr ys)) expected)
                    (res (t es s)
                      (if (null? (cdr arms))
                          (res t (effs-union wes es) s)
                          (tagcase (pselect-arms v s (cdr arms) (next-expected s t expected))
                            (res (t2 es2 s)
                              (res (joined s t t2 expected) (effs-union wes (effs-union es es2)) (join-state v s t t2 expected))))))))))))


      (pselect-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(pselect (W x body ...) ...)`: waits until one arm's wait is ready,
           an I-cell filled, a message come, a deadline passed or a key
           typed, and runs that arm, the first so in order; which are ready
           is the schedule's, so `nondet`."
          (cond ((null? xs)
                 (refuse v "`(pselect ((icell-get i-cell) name body …) ((receive mailbox) name body …) …)`"))
                ((any? (lambda ((a sexp)) (not (pselect-arm? a))) xs)
                 (refuse v "a `pselect` arm is `((icell-get i-cell) name body …)`, `((receive mailbox) name body …)`, `((sleep-until time) name body …)` or `((read-byte) name body …)`"))
                (else (with-effs (pselect-arms v s xs expected) (list "nondet"))))))

      (synth-form (subr kfx (cv st sexp string sexps) res)
        (lambda (v s e h xs)
          (cond ((string=? h "spawn") (spawn-form v s xs nil))
                ((string=? h "spawn-monitored") (spawn-monitored-form v s xs nil))
                ((string=? h "self") (self-form v s xs))
                ((string=? h "race")
                 "FX-26's `race`, a form wherever it heads a list: refused, not a
                  call of what a program names `race` (C108)."
                 (race-form v s xs nil))
                ((string=? h "par") (par-form v s xs nil))
                ((string=? h "pselect") (pselect-form v s xs nil))
                ((string=? h "quote")
                 "A quoted symbol (C56); a quoted datum of another kind is FX-26's
                  `datum`, which KFX has not yet."
                 (if (not (i64= (size xs) 1))
                     (refuse v "a quote of one datum")
                     (tagcase (car xs)
                       (sym (n f p) (if (or (string=? n "#t") (string=? n "#f")) (res (ty-bool) nil s) (res (ty-data "symbol" nil) nil s)))
                       (num (k f p) (res (ty-int) nil s))
                       (big (t f p) (res (ty-int) nil s))
                       (real (x f p) (res (ty-f64) nil s))
                       (str (x f p) (res (ty-string) nil s))
                       (chr (c f p) (res (ty-char) nil s))
                       (lst (ys f l p)
                         "A quoted list (C77): a `datum`, built where it is written."
                         (cond ((null? ys) (refuse v "a quote of (), which FX-26 takes as a nil of any type: write nil"))
                               ((not (quotable? (car xs))) (refuse v "a quoted datum KFX does not build: a `.` not before a dotted list's last item"))
                               (else (res (ty-data "datum" nil) nil s))))
                       (else other (refuse v "a quoted datum KFX does not read")))))
                ((string=? h "quasiquote")
                 "`` `d `` (C79): a quote whose `,e` at depth 1 is `e`, a datum, and
                  whose `,@e` is `e`, a list of datums, appended; a nested `` ` ``
                  deepens, as R7RS counts."
                 (if (not (i64= (size xs) 1))
                     (refuse v "a quasiquote of one datum")
                     (tagcase (car xs)
                       (lst (ys f l p)
                         (cond ((null? ys) (refuse v "a quasiquote of (), which FX-26 takes as a nil of any type: write nil"))
                               ((not (quotable? (car xs))) (refuse v "a quasiquoted datum KFX does not build: a `.` not before a dotted list's last item"))
                               ((head-is? (car xs) "unquote") (check v s (second ys) (ty-data "datum" nil)))
                               (else (tagcase (quasi-items v s ys 1) (res (t es s) (res (ty-data "datum" nil) es s))))))
                       (else other (synth-form v s e "quote" xs)))))
                ((string=? h "the")
                 (let ((want (parse-type v (cv-tvars v) (car xs))))
                   (tagcase (check v s (second xs) want)
                     (res (t es s) (res t es s)))))
                ((string=? h "prompt") (prompt-form v s xs nil))
                ((string=? h "%found")
                 "A definition's value in a module that includes another: found by
                  itself, through a `the` too, as FX-26 finds it."
                 (let ((x (car xs)))
                   (cond ((tagcase x (sym (n at-file at-pos) (string=? n "nil")) (else other #f))
                          (refuse v "a nil, in a module that includes another, where FX-26 finds a poly list"))
                         ((head-is? x "the")
                          (tagcase (synth v s (lst (list (sym "%found" "" 0) (third (items x))) "" 0 0))
                            (res (t es s) (let ((want (parse-type v (cv-tvars v) (second (items x)))))
                                            (res want es (fits v s t want))))))
                         (else (tagcase (synth v s x) (res (t es s) (res t es (freshened s t))))))))
                ((string=? h "product") (product-form v s xs nil))
                ((string=? h "sum") (refuse v "a sum whose type is not known here: write it, (the (sumof ...) (sum ...))"))
                ((string=? h "extract")
                 (if (not (i64= (size xs) 2))
                     (refuse v "(extract e label)")
                     (tagcase (synth v s (car xs))
                       (res (t es s)
                         (tagcase (walk-mu s t)
                           (ty-data (d args)
                             (let ((flat (if (string=? d "%blobref") (walk s (car (cdr args))) (ty-unit))))
                               (tagcase flat
                                 (ty-shape (p ls ts)
                                   (if (string-member? (label-of (second xs)) ls)
                                       (res (ty-data "%blobref" (list (car args) (member-type (label-of (second xs)) ls ts))) es
                                            (note-fact (note-fact (note-types s (cv-file v) (cv-pos v) "blob-owner" (list (car args))) (cv-file v) (cv-pos v)
                                                                  (string-append "blob-field " (i64->string (index-of (label-of (second xs)) ls 0))))
                                                       (cv-file v) (cv-pos v)
                                                       (string-append "blob-offset " (i64->string (field-offset ls ts (label-of (second xs)))))))
                                       (refuse v (string-append "no field " (string-append (label-of (second xs)) (string-append " in a " (show-ty s t)))))))
                                 (else other (refuse v (string-append "an extract from a " (string-append (show-ty s t) ", no product")))))))
                           (ty-shape (p ls ts)
                             (if (and p (string-member? (label-of (second xs)) ls))
                                 (res (member-type (label-of (second xs)) ls ts) es
                                      (note-fact s (cv-file v) (cv-pos v)
                                                 (string-append "extract-index " (i64->string (index-of (label-of (second xs)) ls 0)))))
                                 (refuse v (string-append "no field " (string-append (label-of (second xs)) (string-append " in a " (show-ty s t)))))))
                           (else other (refuse v (string-append "an extract from a " (string-append (show-ty s t) ", no product")))))))))
                ((string=? h "lambda") (synth-lambda v s (items (car xs)) (cdr xs)))
                ((and (string=? h "vlambda") (null? (scope-bind h v))) (vlambda-form v s xs nil))
                ((and (string=? h "rlambda") (null? (scope-bind h v))) (rlambda-form v s e xs nil))
                ((string=? h "proj") (proj-form v s xs))
                ((string=? h "list")
                 (if (null? xs)
                     (refuse v "a (list) of a type nothing here says, as FX-26 finds it: say it, (the (listof T r) (list))")
                     (tagcase (if (head-is? (car xs) "error")
                                  (tagcase (fresh s) (res (m es s) (check v s (car xs) m)))
                                  (synth v s (car xs)))
                       (res (t es0 s)
                         "Its first element's type, a `nat`'s an `int`: FX-26's is that
                          element's own `(nat v)`, which no other `nat` is."
                         ;; A `nat` element's list is of `nat`s, as Fixpt finds it (C159).
                         (with-effs (check v s e (ty-list t (ty-rconst "%fresh"))) es0)))))
                ((control-form? h) (body-form v s h xs nil))
                ((or (string=? h "letrena") (string=? h "letreap")) (letrena-form v s xs nil))
                ((and (blob-form? h) (null? (scope-bind h v))) (blob-form v s h xs nil))
                ((string=? h "and") (bools v s xs #t))
                ((string=? h "or") (bools v s xs #f))
                (else (synth-call v s h xs nil)))))

      (check-form (subr kfx (cv st sexp string sexps ty) res)
        (lambda (v s e h xs expected)
          (cond ((string=? h "spawn") (spawn-form v s xs (list expected)))
                ((string=? h "spawn-monitored") (spawn-monitored-form v s xs (list expected)))
                ((or (string=? h "self") (string=? h "race")) (check-by-synth v s e expected))
                ((and (string=? h "proj") (null? (scope-bind h v))) (check-by-synth v s e expected))
                ((and (string=? h "list") (std-prim? v "list") (sized? (walk s expected) "%nlist"))
                 "`(list e ...)` where a list of size `s` is wanted: each element, and
                  `s` shown to be how many there are (C158)."
                 (let* ((t (walk s expected)) (z (size-lin s (sized-size t))) (n (size xs)))
                   (if (and (not (null? z))
                            (not (and (size-shown? v s (lin-add (car z) (lin n nil) -1)) (size-shown? v s (lin-add (lin n nil) (car z) -1)))))
                       (refuse-named v s (string-append "a list of " (string-append (i64->string n) (string-append " where a " (string-append (show-ty s t) " is expected")))))
                       (tagcase (call-args v s xs (map (lambda ((x sexp)) (sized-elem t)) xs) nil)
                         (res (u es s) (res t es s))))))
                ((string=? h "par") (par-form v s xs (list expected)))
                ((string=? h "pselect") (pselect-form v s xs (list expected)))
                ((control-form? h) (body-form v s h xs (list expected)))
                ((or (string=? h "letrena") (string=? h "letreap")) (letrena-form v s xs (list expected)))
                ((and (blob-form? h) (string-member? h (list "make-bloblet" "rmake-bloblet" "blobref-at" "blobref+"))
                      (null? (scope-bind h v)))
                 "Those made by the type expected; the rest are synthesized, then
                  compared with it, as any form is (C175: `blobref-offset`'s `int`
                  was taken where an `i64` was expected)."
                 (blob-form v s h xs (list expected)))
                ((and (blob-form? h) (null? (scope-bind h v)))
                 (check-by-synth v s e expected))
                ((string=? h "prompt") (prompt-form v s xs (list expected)))
                ((string=? h "%found") (check-by-synth v s e expected))
                ((string=? h "product") (product-form v s xs (list expected)))
                ((string=? h "sum") (sum-form v s xs expected))
                ((and (string=? h "rlambda") (null? (scope-bind h v))) (rlambda-form v s e xs (list expected)))
                ((and (string=? h "plambda") (poly-type? s expected)) (plambda-form v s xs expected))
                ((and (string=? h "vlambda") (null? (scope-bind h v))
                      (tagcase (walk s expected) (ty-data (d args) (string=? d "%vsubr")) (else other #f)))
                 "A vlambda where a `vsubr` is expected (C71): checked as the lambda of
                  one list it is, against the procedure of that list."
                 (tagcase (walk-mu s expected)
                   (ty-data (d args)
                     (let* ((t (car (cdr args)))
                            (binder (car xs))
                            (name (tagcase binder (lst (ys f l p) (car ys)) (else other binder))))
                       (tagcase (check-lambda v s (list name) (cdr xs)
                                              (ty-proc (tagcase (car args) (ty-proc (es ps r) es) (else other nil)) (list (ty-list t (ty-rconst "acyclic"))) (car (cdr (cdr args)))))
                         (res (u es2 s2) (res (walk s expected) es2 s2)))))
                   (else other (refuse v "a vlambda where no variadic procedure is expected"))))
                ((and (string=? h "lambda") (or (proc-type? s expected) (poly-type? s expected)))
                 (check-lambda v s (items (car xs)) (cdr xs) (walk s expected)))
                ((and (string=? h "list") (datum? (walk s expected)))
                 "A list where a datum is expected (C77): a list of datums, at
                  `acyclic`, given as it is."
                 (check v s e (ty-list (ty-data "datum" nil) (ty-rconst "acyclic"))))
                ((and (string=? h "list") (string=? (shape-of (walk s expected)) "union")
                      (not (null? (member-of-shape (members-of (walk s expected)) "list"))))
                 "A list where a union with a list member is expected (C77): that
                  member, its elements checked against its own."
                 (check v s e (car (member-of-shape (members-of (walk s expected)) "list"))))
                ((and (string=? h "list") (tagcase expected (ty-list (el r) #t) (else other #f)))
                 (tagcase expected
                   (ty-list (el r)
                     (tagcase (if (null? xs)
                                  (tagcase (walk s el)
                                    (ty-meta (k) (refuse v "a (list) of a type nothing here says, as FX-26 finds it: say it, (the (listof T r) (list))"))
                                    (else other (res expected nil (note-turbofish s (cv-file v) (cv-pos v) (list el)))))
                                  (elements v s xs el))
                       (res (u es s)
                         (tagcase (region-of v s r)
                           (res (rr rn s) (res expected (effs-union (list (string-append "alloc:" (region-string s rr))) es) s))))))
                   (else other (check-by-synth v s e expected))))
                ((or (string=? h "the") (string=? h "and") (string=? h "or") (string=? h "lambda") (string=? h "list") (string=? h "quote") (string=? h "quasiquote")
                     (string=? h "extract"))
                 (check-by-synth v s e expected))
                (else (synth-call v s h xs (list expected))))))

      (elements (subr kfx (cv st sexps ty) res)
        (lambda (v s xs el)
          "A list's elements, each checked as `el`: their effect, and the state,
           which carries their facts."
          (if (null? xs)
              (res el nil s)
              (tagcase (check v s (car xs) el)
                (res (t es s) (with-effs (elements v s (cdr xs) el) es))))))

      (bools (subr kfx (cv st sexps bool) res)
        (lambda (v s xs holding)
          "An `and`'s operands, each checked where those before it hold, so
           narrowed by them; an `or`'s, where those before it fail (C84), as
           FX-26's `(if a b #f)` and `(if a #t b)` are."
          (if (null? xs)
              (res (ty-bool) nil s)
              (tagcase (check v s (car xs) (ty-bool))
                (res (t es s)
                  (let ((ns (narrowings v s (car xs))))
                    (with-effs (bools (if (null? ns) v (tagcase (car ns) (narrowing (yes no) (if holding yes no)))) s (cdr xs) holding)
                               es)))))))

      (body-form (subr kfx (cv st string sexps tys) res)
        (lambda (v s h xs expected)
          "`if`, `cond`, `case`, `tagcase`, `let`, `let*` and `begin`: forms
           whose last parts give the value; `expected` is the type, if known."
          (cond ((not (well-formed? h xs))
                 (refuse v (string-append "a (" (string-append h " ...) not of the form FX-26 has"))))
                ((and (null? expected) (pairs-mixed? h xs))
                 (refuse v (string-append "the branches are a pair `cons` makes, a (pairof ...), and what is not one: FX-26 joins no (pairof ...) with a (listof ...); write the type, (the (listof ...) (" (string-append h " ...))"))))
                ((or (string=? h "confirm-nat") (string=? h "confirm-length") (string=? h "acyclic"))
                 (confirm-form v s h xs expected))
                ((string=? h "if")
                 (let ((ns (narrowings v s (car xs))))
                   (tagcase (check v s (car xs) (ty-bool))
                     (res (t es s)
                       (if (null? ns)
                           (with-effs (arms v s (cdr xs) expected) es)
                           (tagcase (car ns)
                             (narrowing (yes no) (with-effs (narrowed-arms yes no s (second xs) (third xs) expected) es))))))))
                ((string=? h "typecase")
                 (if (null? (union-local v s (car xs)))
                     (refuse v "a typecase of a local of a union (C62)")
                     (typecase-arms v (let ((origin (bind-origin (sym-name (car xs)) (cv-binds v))))
                                        (if (and (not (null? origin)) (valued? s (car origin))) (note-fact s (cv-file v) (cv-pos v) "typecase-valued") s))
                                    (car xs) (cdr xs) expected)))
                ((string=? h "begin") (body v s xs expected))
                ((string=? h "let")
                 (let-values v s (items (car xs)) (cdr xs) expected nil #f))
                ((string=? h "let*")
                 (let-values v s (items (car xs)) (cdr xs) expected nil #t))
                ((string=? h "letrec") (letrec-form v s (items (car xs)) (cdr xs) expected))
                ((string=? h "letregion") (letregion-form v s (name-of v (car xs)) (cdr xs) expected))
                ((string=? h "letfreeze") (letfreeze-form v s xs expected))
                ((string=? h "with")
                 "`(with m body ...)`: `m`'s values and types in scope in the body,
                  shadowing what is outside, locals too, as FX-26 has it; `m` a
                  module defined at the top level, reading which is reading a
                  global."
                 (let* ((m (tagcase (car xs) (sym (n f p) n) (else other "")))
                        (found (if (string=? m "") nil (scope-bind m v))))
                   (cond ((or (string=? m "")
                              (and (not (null? found))
                                   (tagcase (car found) (bind (n sc wher) (and (not (string=? wher "module")) (tagcase sc (scheme (tv t) (mtype? (walk s t)))))))))
                          "A module value's (C170): the value a variable names, or one an
                           expression makes; FX-26's, not KFX's."
                          (tagcase (synth v s (car xs))
                            (res (t es s)
                              (if (not (mtype? (walk s t)))
                                  (refuse v (string-append "a with of no module: a " (show-ty s t)))
                                  (with-effs (found-then-fitted v (body (mtype-opened v (walk s t))
                                                                        (kfx-restricted v (note-fact (note-fact s (cv-file v) (cv-pos v) "with-value") (cv-file v) (cv-pos v) (string-append "with-spec " (words-of (mtype-value-names (walk s t)))))
                                                                                        "a with of a module value, FX-26's first-class modules', which KFX has not yet (C170)")
                                                                        (cdr xs) nil)
                                                                expected)
                                             es)))))
                         ((and (not (null? found))
                               (tagcase (car found) (bind (n sc wher) (string=? wher "local")))
                               (not (null? (module-spec v (tagcase (car found) (bind (n sc wher) (tagcase sc (scheme (tv t) t))))))))
                          "A module parameter's values, of its abstract types `m..t`."
                          (let* ((spec (car (module-spec v (tagcase (car found) (bind (n sc wher) (tagcase sc (scheme (tv t) t)))))))
                                 (w (module-scope v spec m ""))
                                 (s (note-fact s (cv-file v) (cv-pos v) (string-append "with-spec " (spec-value-words spec)))))
                            (found-then-fitted v (body (with-binds w (module-type-values w spec)) s (cdr xs) nil) expected)))
                         ((or (null? found) (not (tagcase (car found) (bind (n sc wher) (string=? wher "module")))))
                          (refuse v (string-append "KFX's with opens a module defined at the top level, or a module parameter, by its name: " m)))
                         (else (with-effs (found-then-fitted v (body (opened v m) s (cdr xs) nil) expected) (list (string-append "g:" m)))))))
                ((string=? h "cond") (cond-clauses v s xs expected))
                ((string=? h "case")
                 "On a character, an integer, a string or a boolean, the data
                  literals of its type; the kind told the emitter."
                 (tagcase (synth v s (car xs))
                   (res (t es s)
                     (let ((kind (tagcase (walk s t)
                                   (ty-char () "char") (ty-int () "int") (ty-nat () "int")
                                   (ty-string () "string") (ty-bool () "bool")
                                   (ty-data (d args) (if (string=? d "symbol") "symbol" (refuse v (string-append "KFX's case is on characters, ints, strings, booleans and symbols, and this is a " (show-ty s t)))))
                                   (else other (refuse v (string-append "KFX's case is on characters, ints, strings and booleans, and this is a "
                                                                        (show-ty s t)))))))
                       (with-effs (case-arms v (note-fact s (cv-file v) (cv-pos v) (string-append "case " kind)) kind (cdr xs) expected)
                                  es)))))
                (else
                 (tagcase (synth v s (car xs))
                   (res (t es s)
                     (tagcase (walk-mu s t)
                       (ty-data (d args)
                         (if (string=? d "%blobref")
                             (let ((flat (walk s (car (cdr args))))
                                   (owner (walk s (car args))))
                               (tagcase flat
                                 (ty-data (d2 a2)
                                   (if (not (string=? d2 "%flat-sum"))
                                       (refuse v (string-append "tagcase of a " (string-append (show-ty s t) ", no sum")))
                                       (with-effs (flat-tag-arms v (note-fact (if (unkeyed? a2) (kfx-restricted v s "a flat sum with no key, FX-26's, its tag an index of the owner's fields, which KFX has not yet (C175)") s)
                                                                              (cv-file v) (cv-pos v)
                                                                              (string-append "blob-tagcase " (string-append (i64->string (key-width (car a2)))
                                                                                (string-append " " (string-append (i64->string (variant-offset a2)) (if (unkeyed? a2) " fields" ""))))))
                                                                 t owner (flat-sum-variants a2) (cdr xs) expected)
                                                  (effs-union (list (string-append "read:" (region-string s (tagcase owner (ty-data (d3 a3) (car a3)) (else other (ty-unit)))))) es))))
                                 (else other (refuse v (string-append "tagcase of a " (string-append (show-ty s t) ", no sum"))))))
                         (if (null? (variants-of v d))
                             (refuse v (string-append "tagcase of a " (string-append (show-ty s t) ", no sum")))
                         (with-effs (tag-arms v s (walk s t) (cdr xs)
                                              (instantiate-variants (family-of v d) args (variants-of v d))
                                              expected)
                                    es))))
                       (ty-shape (p ls ts)
                         (if p
                             (refuse v (string-append "tagcase of a " (string-append (show-ty s t) ", no sum")))
                             (let ((arms (cdr xs)))
                               (with-effs (tag-arms v (note-fact s (cv-file v) (cv-pos v) (string-append "tagcase-sum " (words-of ls)))
                                                    (walk s t) (map sum-arm arms) (sum-variants v ls ts (unholed arms)) expected)
                                          es))))
                       (else other (refuse v (string-append "tagcase of a " (string-append (show-ty s t) ", no datatype")))))))))))

      (product-form (subr kfx (cv st sexps tys) res)
        (lambda (v s fields expected)
          "`(product (l e) ...)`: each field checked against the type expected
           of it, if a product of those labels is expected, else found."
          (let* ((fs (map items fields))
                 (ls (map (lambda ((f sexps)) (label-of (car f))) fs))
                 (want (if (null? expected) nil
                           (tagcase (walk-mu s (car expected))
                             (ty-shape (p ms us) (if (and p (strings=? ls ms)) us nil))
                             (else other nil)))))
            (cond ((any? (lambda ((f sexps)) (or (not (i64= (size f) 2)) (string=? (label-of (car f)) ""))) fs)
                   (refuse v "a product's fields are each (label value)"))
                  ((repeated? ls) (refuse v "a label appears twice in a product"))
                  ((and (null? want) (any? (lambda ((f sexps)) (sym-is? (second f) "nil")) fs))
                   "FX-26 gives a bare `nil` in a product found by itself `nil`'s own
                    poly type, which no list's is (a branch of a list there is
                    another type): KFX's fields are of one type each (K1)."
                   (refuse v "a product found by itself with a bare nil field, whose type FX-26 keeps poly: say the product's type, (the (productof (l (listof T r)) ...) (product ...))"))
                  (else
                (tagcase (product-values v s (map second fs) want)
                  (res (t es s)
                    (tagcase t
                      (ty-shape (p ms us)
                        (let ((r (res (ty-shape #t ls us) es s)))
                          (if (null? expected) r (tagcase r (res (t2 es2 s2) (res t2 es2 (fits v s2 t2 (car expected))))))))
                      (else other (refuse v "a product"))))))))))

      (product-values (subr kfx (cv st sexps tys) res)
        (lambda (v s es want)
          "Values, each checked against its type in `want` if there is one;
           their types as a sum of no tags, a carrier."
          (if (null? es)
              (res (ty-shape #t nil nil) nil s)
              (tagcase (if (null? want) (synth v s (car es)) (check v s (car es) (car want)))
                (res (t es0 s)
                  (tagcase (product-values v s (cdr es) (if (null? want) nil (cdr want)))
                    (res (rest es1 s)
                      (tagcase rest
                        (ty-shape (p ls ts) (res (ty-shape #t ls (cons t ts)) (effs-union es0 es1) s))
                        (else other (res rest es1 s))))))))))

      (sum-form (subr kfx (cv st sexps ty) res)
        (lambda (v s xs expected)
          "`(sum tag e)`, where a sum with that tag is expected: its type known
           whole, which the emitter is told, for Rust's sake."
          (tagcase (walk-mu s expected)
            (ty-shape (p ls ts)
              (if (and (not p) (not (null? xs)) (draft-hole? (car xs)))
                  (refuse-named v s (string-append "the hole: a tag, then its value: " (words-joined (tags-wanted s ls ts) ", ")))
              (let ((tag (label-of (car xs))))
                (if (or p (not (string-member? tag ls)) (not (i64= (size xs) 2)))
                    (refuse-named v s (string-append "a sum tagged " (string-append tag (string-append ", where a " (string-append (show-ty s expected) " is expected")))))
                    (tagcase (check v s (second xs) (member-type tag ls ts))
                      (res (t es s)
                        (res expected es (note-fact s (cv-file v) (cv-pos v)
                                                    (string-append "sum-type " (show-sexp (ty-sexp v s (zonk s expected))))))))))))
            (else other (if (and (not (null? xs)) (draft-hole? (car xs)))
                            (refuse v "the hole: a tag, then an expression")
                            (refuse v "a sum whose type is not known here: write it, (the (sumof ...) (sum ...))"))))))

      (arms (subr kfx (cv st sexps tys) res)
        (lambda (v s branches expected)
          "Branches of one type: the first found, if none is expected, and the
           rest checked against it."
          (tagcase (body v s (list (car branches)) expected)
            (res (t es s)
              (if (null? (cdr branches))
                  (res t es s)
                  (tagcase (arms v s (cdr branches) (next-expected s t expected))
                    (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) (join-state v s t t2 expected)))))))))

      (vlambda-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs given)
          "`(vlambda xs body ...)`, `(vlambda (xs T) body ...)` (C71): a variadic
           procedure, `xs` the list of its arguments, a `(listof T acyclic)`; `T`
           written, or the expected `vsubr`'s, `given`."
        (let* ((binder (car xs))
               (name (tagcase binder (lst (ys f l p) (sym-name (car ys))) (else other (sym-name binder))))
               (t (tagcase binder
                    (lst (ys f l p) (parse-type v (cv-tvars v) (second ys)))
                    (else other (if (null? given) (refuse v "a vlambda's elements' type: write it, (vlambda (xs T) ...)") (car given))))))
          (tagcase (body (with-binds v (list (local v name (ty-list t (ty-rconst "acyclic"))))) s (cdr xs) nil)
            (res (r es s2) (res (ty-data "%vsubr" (list (ty-proc es nil (ty-unit)) t r)) nil s2))))))

      (confirm-form (subr kfx (cv st string sexps tys) res)
        (lambda (v s h xs expected)
          "`(confirm-nat e (x body) else)`, `(acyclic e (x body) else)`,
           `(confirm-length e n (x body) else)` (Fixpt's sizes.md, C158): `x`
           in the body `e` confirmed, a `nat`, a list at `acyclic`, a list of
           size `n` (a literal, or a value whose size the facts know); the
           `else` where it is not."
          (let ((parts (if (string=? h "confirm-length") (the i64 4) (the i64 3))))
            (if (or (not (i64= (size xs) parts))
                    (not (tagcase (if (string=? h "confirm-length") (third xs) (second xs)) (lst (ys f l p) (and (i64= (size ys) 2) (tagcase (car ys) (sym (n f2 p2) #t) (else other #f)))) (else other #f))))
                (refuse v (string-append "(" (string-append h (if (string=? h "confirm-length") " e n (x body) else)" " e (x body) else)"))))
                (let* ((arm (items (if (string=? h "confirm-length") (third xs) (second xs))))
                       (x (sym-name (car arm)))
                       (els (if (string=? h "confirm-length") (fourth xs) (third xs))))
                  (tagcase (synth v s (car xs))
                    (res (t es0 s)
                      (let* ((w (walk s t))
                             (elem (tagcase w (ty-list (e r) (the tys (list e))) (else other (if (sized? w "%nlist") (the tys (list (sized-elem w))) nil)))))
                        (cond
                          ((string=? h "confirm-nat")
                           (let ((s (fits v s t (ty-int))))
                             (tagcase (narrowed-arms (with-binds v (list (local v x (ty-nat)))) v s (second arm) els expected)
                               (res (u es s) (res u (effs-union es0 es) s)))))
                          ((null? elem) (refuse v (string-append h (string-append " of no list: " (show-ty s t)))))
                          ((not (or (sized? w "%nlist") (tagcase w (ty-list (e r) (tagcase (walk s r) (ty-rconst (n) (or (string=? n "acyclic") (string=? n "const"))) (else other #f))) (else other #f))))
                           ;; Data alone, a list no one may write still (Fixpt's rule).
                           (refuse v (string-append "a " (string-append (show-ty s t) " is not data: a list that may still be written"))))
                          ((string=? h "acyclic")
                           (tagcase (narrowed-arms (with-binds v (list (local v x (ty-list (car elem) (ty-rconst "acyclic"))))) v s (second arm) els expected)
                             (res (u es s) (res u (effs-union es0 es) s))))
                          (else
                           (tagcase (check v s (second xs) (ty-int))
                             (res (u1 es1 s)
                               (let* ((n (tagcase (second xs) (num (k f p) (if (i64< k 0) nil (the lins (list (lin k nil))))) (else other (linear-of v s (second xs)))))
                                      (z (if (null? n) size-finite (size-of-lin (car n)))))
                                 (tagcase (narrowed-arms (with-binds v (list (local v x (ty-data "%nlist" (the tys (list (car elem) z)))))) v s (second arm) els expected)
                                   (res (u es s) (res u (effs-union es0 (effs-union es1 es)) s))))))))))))))))

      (narrowed-arms (subr kfx (cv cv st sexp sexp tys) res)
        (lambda (yes no s a b expected)
          "An `if`'s branches, each where its test narrows (C62)."
          (tagcase (body yes s (list a) expected)
            (res (t es s)
              (tagcase (body no s (list b) (next-expected s t expected))
                (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) (join-state yes s t t2 expected))))))))

      (typecase-arms (subr kfx (cv st sexp sexps tys) res)
        (lambda (v s x arms expected)
          "`(typecase x (shape name body) ... (else body))`, or `(else name
           body)`, as FX-26 has it (C62, C77): each arm binds its member; what it
           leaves narrows `x` for the arms after it, and the `else`'s name."
          (let ((arm (items (car arms))))
            (cond ((sym-is? (car arm) "else")
                   (cond ((not (null? (cdr arms))) (refuse v "a typecase's else is its last arm"))
                         ((i64= (size arm) 2) (body v s (cdr arm) expected))
                         ((and (i64= (size arm) 3) (tagcase (second arm) (sym (n f p) #t) (else other #f)))
                          (let ((ms (union-local v s x)))
                            (body (with-binds v (list (local v (name-of v (second arm)) (union-of ms))))
                                  (let ((origin (bind-origin (sym-name x) (cv-binds v))))
                                    (if (null? origin) s (coerced v s (datum-file (car arms)) (datum-pos (car arms)) (car origin) (union-of ms))))
                                  (list (third arm)) expected)))
                         (else (refuse v "a typecase's else is (else body) or (else name body)"))))
                  ((null? (cdr arms)) (refuse v "a typecase needs an else, its last arm, as FX-26's does"))
                  ((not (and (i64= (size arm) 3) (tagcase (car arm) (sym (n f p) #t) (else other #f))
                             (tagcase (second arm) (sym (n f p) #t) (else other #f))))
                   (refuse v "a typecase's arm is (shape name body)"))
                  ((not (string-member? (sym-name (car arm)) (list "int" "char" "bool" "nil" "pair" "string" "symbol" "procedure" "bloblet"
                                                                   "f64" "f32" "box" "sum" "product" "vector" "bytevector")))
                   (refuse v (string-append "a shape a typecase tests is int, char, bool, nil, pair, string, symbol, procedure, bloblet, f64, f32, box, sum, product, vector or bytevector, not " (sym-name (car arm)))))
                  (else
                   (let* ((ms (union-local v s x))
                          (shape (sym-name (car arm)))
                          (yes (narrowed-to ms shape))
                          (no (narrowed-from ms shape)))
                     (if (null? yes)
                         (refuse v (string-append "a typecase's arm of a shape its union has not: " shape))
                         (tagcase (body (with-binds v (list (local v (name-of v (second arm)) (union-of yes))))
                                        (let ((origin (bind-origin (sym-name x) (cv-binds v))))
                                          (if (null? origin) s (coerced v s (datum-file (car arms)) (datum-pos (car arms)) (car origin) (union-of yes))))
                                        (list (third arm)) expected)
                           (res (t es s)
                             (tagcase (typecase-arms (if (null? no) v (with-binds v (list (narrowed v (sym-name x) (union-of no))))) s x (cdr arms)
                                                     (next-expected s t expected))
                               (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) (join-state v s t t2 expected)))))))))))))

      (cond-clauses (subr kfx (cv st sexps tys) res)
        (lambda (v s clauses expected)
          (let ((clause (items (car clauses))))
            (if (sym-is? (car clause) "else")
                (if (null? (cdr clauses))
                    (body v s (cdr clause) expected)
                    (refuse v "a cond's else is its last clause"))
                (if (null? (cdr clauses))
                    (refuse v "a cond needs an else: FX has no unspecified value")
                    (tagcase (check v s (car clause) (ty-bool))
                      (res (t0 es0 s)
                        (tagcase (body (let ((ns (narrowings v s (car clause)))) (if (null? ns) v (tagcase (car ns) (narrowing (yes no) yes)))) s (cdr clause) expected)
                          (res (t es s)
                            (tagcase (cond-clauses (let ((ns (narrowings v s (car clause)))) (if (null? ns) v (tagcase (car ns) (narrowing (yes no) no)))) s (cdr clauses) (next-expected s t expected))
                              (res (t2 es2 s)
                                (res (joined s t t2 expected) (effs-union es0 (effs-union es es2)) (join-state v s t t2 expected)))))))))))))

      (case-arms (subr kfx (cv st string sexps tys) res)
        (lambda (v s kind cases expected)
          (let ((arm (items (car cases))))
            (cond ((sym-is? (car arm) "else")
                   (if (null? (cdr cases))
                       (body v s (cdr arm) expected)
                       (refuse v "a case's else is its last arm")))
                  ((null? (cdr cases)) (refuse v "a case needs an else: FX has no unspecified value"))
                  ((null? (items (car arm))) (refuse v "a case clause has at least one datum"))
                  ((not (case-data? kind (items (car arm))))
                   (refuse v (string-append "a case on a " (string-append kind "'s data are literals of its type"))))
                  ((repeated? (map datum-key (concat (map (lambda ((c sexp)) (if (sym-is? (car (items c)) "else") nil (items (car (items c))))) cases))))
                   (refuse v "a datum appears twice in this case"))
                  (else
                   (tagcase (body v (case-data v s kind (items (car arm))) (cdr arm) expected)
                     (res (t es s)
                       (tagcase (case-arms v s kind (cdr cases) (next-expected s t expected))
                         (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) (join-state v s t t2 expected)))))))))))

      (case-data (subr kfx (cv st string sexps) st)
        (lambda (v s kind xs)
          "A case's data, an int's checked as ints, so that the emitter writes
           them as ints."
          (if (or (null? xs) (not (string=? kind "int")))
              s
              (tagcase (check v s (car xs) (ty-int)) (res (t es s) (case-data v s kind (cdr xs)))))))

      (flat-tag-arms (subr kfx (cv st ty ty fvars sexps tys) res)
        (lambda (v s whole owner vs arms expected)
          "A tagcase's arms on a flat sum (C33): each a label, a number, and one
           name, a blobref to its variant; `else` the blobref as it is. `vs` are
           the variants no arm has taken yet."
          (if (null? arms)
              (if (null? vs)
                  (res (if (null? expected) (ty-void) (car expected)) nil s)
                  (refuse v (string-append "this tagcase has no arm for " (tagcase (car vs) (fvar (l x) l)))))
              (let ((arm (items (car arms))))
                (cond ((or (i64< (size arm) 3) (tagcase (second arm) (sym (n f p) #f) (else other #t)))
                       (refuse v "an arm on a flat sum binds one name, a blobref to its variant: no bytes are copied out"))
                      ((sym-is? (car arm) "else")
                       (if (null? (cdr arms))
                           (body (with-binds v (list (local v (name-of v (second arm)) whole))) s (cdr (cdr arm)) expected)
                           (refuse v "a tagcase's else is its last arm")))
                      (else
                       (let* ((lab (tagcase (car arm) (num (k f p) (i64->string k)) (sym (n f p) n) (else other "")))
                              (found (concat (map (lambda ((f fvar)) (tagcase f (fvar (l x) (if (string=? l lab) (the tys (list x)) nil)))) vs))))
                         (if (null? found)
                             (refuse v (string-append "a flat sum's arm is named by one of its labels not taken yet, a number: " (show-sexp (car arm))))
                             (tagcase (body (with-binds v (list (local v (name-of v (second arm)) (ty-data "%blobref" (list owner (car found))))))
                                            s (cdr (cdr arm)) expected)
                               (res (t es s)
                                 (tagcase (flat-tag-arms v s whole owner
                                                         (concat (map (lambda ((f fvar)) (tagcase f (fvar (l x) (if (string=? l lab) nil (the fvars (list f)))))) vs))
                                                         (cdr arms) (next-expected s t expected))
                                   (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) (join-state v s t t2 expected))))))))))))))

      (tag-arms (subr kfx (cv st ty sexps variants tys) res)
        (lambda (v s whole tagged vs expected)
          "A tagcase's arms; `vs` are the variants no arm has taken yet."
          (if (null? tagged)
              (if (null? vs)
                  (res (if (null? expected) (ty-void) (car expected)) nil s)
                  (refuse v (string-append "a tagcase of a " (string-append (show-ty s whole) " with no else, and no arm for each tag"))))
              (if (draft-hole? (car tagged))
                  (refuse-named v s (string-append "the hole: " (arms-wanted s vs (tagcase whole (ty-shape (p ls ts) "name") (else other "(name …)")))))
              (let* ((arm (items (car tagged)))
                     (tag (name-of v (car arm))))
                (if (string=? tag "else")
                    (if (null? (cdr tagged))
                        (body (with-binds v (list (local v (name-of v (second arm)) whole)))
                              s (cdr (cdr arm)) expected)
                        (refuse v "a tagcase's else is its last arm"))
                    (let* ((fields (variant-fields v (show-ty s whole) tag vs))
                           (listed (and (i64> (size arm) 1) (tagcase (second arm) (lst (xs f l p) #t) (else other #f))))
                           (names (if listed (items (second arm)) nil)))
                      (cond
                        ((not listed)
                         (refuse v (string-append "the arm for " (string-append tag (string-append " names its fields in a list: `(" (string-append tag " (name …) body …)`"))))))
                        ((not (i64= (size names) (size fields)))
                         (refuse v (string-append "the arm for " (string-append tag " names the wrong number of fields"))))
                        (else
                          (tagcase (body (with-binds v (bind-fields v names fields)) s (cdr (cdr arm)) expected)
                            (res (t es s)
                              (tagcase (tag-arms v s whole (cdr tagged) (without-tag tag vs) (next-expected s t expected))
                                (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) (join-state v s t t2 expected)))))))))))))))

      (tags-wanted (subr kfx (st strings tys) strings)
        (lambda (s ls ts)
          "Each tag of a sum, and its value's type."
          (if (or (null? ls) (null? ts))
              nil
              (cons (string-append "`" (string-append (car ls) (string-append "` (" (string-append (show-ty s (car ts)) ")"))))
                    (tags-wanted s (cdr ls) (cdr ts))))))

      (arms-wanted (subr kfx (st variants string) string)
        (lambda (s vs binds)
          "What a tagcase's next arm may be: one for a tag no arm has taken, or
           else; nothing, once each has one. A sum's arm `binds` a name, a
           datatype's a list of them."
          (if (null? vs)
              "nothing: every tag has an arm"
              (string-append (string-append "an arm `(tag " (string-append binds " body …)` for "))
                (string-append (words-joined (map (lambda ((x variant))
                                                    (tagcase x (variant (tag ts) (string-append "`" (string-append tag (string-append "` (" (string-append (words-joined (map (lambda ((t ty)) (show-ty s t)) ts) " ") ")")))))))
                                                  vs)
                                             ", ")
                               ", or `(else name body …)`")))))

      (let-values (subr kfx (cv st sexps sexps tys binds bool) res)
        (lambda (v s bindings forms expected bound sequential)
          "A `let`'s or `let*`'s bindings, then its body. `bound`: those made
           so far, which a `let*`'s next binding sees and a `let`'s does not."
          (if (null? bindings)
              (module-escape v (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (if (tagcase sc (scheme (tv t) (mtype? t))) (the strings (list n)) nil)))) bound))
                             (body (with-binds v bound) s forms expected))
              (let* ((b (items (car bindings)))
                     (sees (if sequential (with-binds v bound) v)))
                (tagcase (synth sees s (second b))
                  (res (t es s)
                    (with-effs (let-values v s (cdr bindings) forms expected
                                           (cons (local v (name-of v (car b)) t) bound) sequential)
                               es)))))))

      (module-escape (subr kfx (cv strings res) res)
        (lambda (v ps r)
          "No module's abstract type `p..t`, of a module bound to `p` in a scope,
           leaves that scope (Fixpt's `modules/escape.fx`)."
          (if (null? ps)
              r
              (tagcase r
                (res (t es s)
                  (let ((m (mentions-module-of? (zonk s t) ps)))
                    (if (string=? m "")
                        r
                        (refuse v (string-append "this is a " (string-append (show-ty s t) (string-append ", and `" (string-append m "` is a module's abstract type, not known outside the scope where the module is named"))))))))))))

      (letrec-form (subr kfx (cv st sexps sexps tys) res)
        (lambda (v s bindings forms expected)
          "`(letrec ((f T lambda) ...) body ...)`: each procedure's type written,
           every one in scope in each lambda and in the body. A group whose every
           run ends is bound as `ends`, its calls no `spin`; else as locals."
          (let* ((ends (with termination (terminates? v (map (lambda ((b sexp)) (name-of v (car (items b)))) bindings)
                                    (map (lambda ((b sexp))
                                           ;; A poly type's procedure, its body (C158).
                                           (let ((t (parse-type v (cv-tvars v) (second (items b)))))
                                             (tagcase t (ty-data (d args) (if (string=? d "%poly") (poly-body args) t)) (else other t))))
                                         bindings)
                                    (map (lambda ((b sexp)) (third (items b))) bindings))))
                 (types (letrec-found v s bindings (map (lambda ((b sexp)) (parse-type v (cv-tvars v) (second (items b)))) bindings)
                                      (if ends "ends" "rec")))
                 (w (with-binds v (map2 (lambda ((b sexp) (t ty))
                                         (bind (name-of v (car (items b))) (scheme nil t) (if ends "ends" "rec")))
                                       bindings types))))
            (tagcase (letrec-lambdas w s bindings types)
              (res (u es s) (body w s forms expected))))))

      (letrec-found (subr kfx (cv st sexps tys string) tys)
        (lambda (v s bindings types wher)
          "A local `letrec`'s types, the globals its procedures read found (C179;
           Fixpt's fx26.md, 2026-09-30): each lambda checked as though its type
           read any global, the globals its body reads not within its type put
           in it, and again until the group's calls of each other add none. A
           group that checks at its types written keeps them."
          (let* ((w (with-binds v (map2 (lambda ((b sexp) (t ty)) (bind (name-of v (car (items b))) (scheme nil t) wher)) bindings types)))
                 (more (map2 (lambda ((b sexp) (t ty))
                              (let ((ys (items b)))
                                (tagcase t
                                  (ty-proc (es ps r)
                                    (if (head-is? (third ys) "lambda")
                                        (let* ((lam (items (third ys)))
                                               (found (tagcase (lambda-effects w s (items (second lam)) (cdr (cdr lam)) (ty-proc (effs-union (list "@globals") es) ps r))
                                                        (res (u fs s2) fs))))
                                          (filter (lambda ((a string)) (and (or (string=? a "@globals") (global-atom? a)) (not (effs-within? (list a) es)))) found))
                                        nil))
                                  (else other nil))))
                            bindings types)))
            (if (not (any? (lambda ((m strings)) (not (null? m))) more))
                types
                (letrec-found v s bindings
                              (map2 (lambda ((t ty) (m strings)) (tagcase t (ty-proc (es ps r) (ty-proc (effs-union m es) ps r)) (else other t))) types more)
                              wher)))))

      (letregion-form (subr kfx (cv st string sexps tys) res)
        (lambda (v s r forms expected)
          "`(letregion r body ...)`: a region for the body's types, its data the
           heap's. What the body does to it is masked, and the value may not
           mention it, as in FX-26. A region named already is refused, so that
           masking, by name, masks nothing else."
          (let ((name (string-append "'" r)))
            (if (string-member? name (cv-tvars v))
                (refuse v (string-append "a letregion of a region named already: " r))
                (tagcase (found-then-fitted v (body (with-tvars v (list name)) s forms nil) expected)
                  (res (t es s)
                    (if (mentions? s t name)
                        (refuse v (string-append "a letregion whose value's type mentions its region " r))
                        (res t (masked es name) s))))))))

      (letfreeze-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(letfreeze r body ...)`, `(letfreeze (r heap) body ...)` (Fixpt's
           places-and-regions.md, C161): a region `r` for the body, whose data
           it builds and may write; the value leaves with `r` frozen, `acyclic`
           if the body never wrote `r`, else `const`; what the body does to `r`
           masked."
          (let ((r (tagcase (car xs)
                     (sym (n f p) n)
                     (lst (ys f l p) (if (and (i64= (size ys) 2) (sym-is? (second ys) "heap")) (sym-name (car ys))
                                         (refuse v "a letfreeze into a place but the heap, which KFX has not yet")))
                     (else other (refuse v "(letfreeze r body ...)")))))
            (let ((name (string-append "'" r)))
              (if (string-member? name (cv-tvars v))
                  (refuse v (string-append "a letfreeze of a region named already: " r))
                  (tagcase (body (with-tvars v (list name)) s (cdr xs) nil)
                    (res (t es s)
                      (let* ((wrote (any? (lambda ((x string)) (or (string=? x (string-append "write:" name)) (string=? x (string-append "init:" name)))) es))
                             (frozen (replace-var name (ty-rconst (if wrote "const" "acyclic")) (zonk s t))))
                        (if (writes-region? s (zonk s t) name)
                            (refuse v (string-append "the value of `letfreeze " (string-append r (string-append "` could still write its region's data: its type is " (show-ty s t)))))
                        (tagcase (found-then-fitted v (res frozen nil s) expected)
                          (res (u es2 s2) (res u (masked es name) s2))))))))))))

      (writes-region? (subr kfx (st ty string) bool)
          (lambda (s t r)
            "Whether a procedure in `t` writes region `r` (its latent effect)."
            (tagcase (walk s t)
              (ty-proc (es ps x)
                (or (any? (lambda ((a string)) (let ((y (resolve-atom s a))) (or (string=? y (string-append "write:" r)) (string=? y (string-append "init:" r))))) es)
                    (writes-region? s x r) (any? (lambda ((p ty)) (writes-region? s p r)) ps)))
              (ty-list (e g) (writes-region? s e r))
              (ty-ref (e g) (writes-region? s e r))
              (ty-data (d args) (any? (lambda ((a ty)) (writes-region? s a r)) args))
              (ty-shape (p ls ts) (any? (lambda ((a ty)) (writes-region? s a r)) ts))
              (else other #f))))

      (letrena-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(letrena r body ...)`, and `letreap`, which FX-26 types alike and
           collects as it runs, which an arena need not: a region whose data the
           body makes in an arena
           (`rcons`, `rnew`), freed when the body ends; typed as a `letregion`
           is, and `r` the region's place, `(place r)`, as FX-26 has it. In Rust
           a `fn` of the region's lifetime, of the arena and the locals the body
           names: what it is found to be, and they, are noted for the emitter.
           For now the place is given only to `rcons` and `rnew`, which make in
           the place's own region, and no letrena is in a poly over types."
          (cond ((or (i64< (size xs) 2) (tagcase (car xs) (sym (n f p) #f) (else other #t)))
                 (refuse v "(letrena r body ...)"))
                (else
                 (let* ((r (sym-name (car xs)))
                        (name (string-append "'" r))
                        (forms (cdr xs))
                        (used (concat (map (lambda ((n string))
                                             (let ((found (scope-bind n v)))
                                               (if (null? found)
                                                   nil
                                                   (tagcase (car found)
                                                     (bind (b sc wher)
                                                       (if (or (string=? wher "local") (string=? wher "narrowed") (string=? wher "rec") (string=? wher "ends"))
                                                           (the binds (list (car found)))
                                                           nil))))))
                                           (distinct (concat (map (lambda ((n string)) (if (string=? n (sym-name (car xs))) nil (the strings (list n))))
                                                                  (names-in-all forms)))))))
                        (types (map (lambda ((b bind)) (tagcase b (bind (n sc w) (tagcase sc (scheme (tv t) t))))) used)))
                   (cond ((string-member? name (cv-tvars v))
                          (refuse v (string-append "a letrena of a region named already: " r)))
                         (else
                          (tagcase (found-then-fitted v (body (with-binds (with-tvars v (list name (string-append "%place " name)))
                                                                           (list (local v r (ty-data "%place" (list (ty-var name))))))
                                                              s forms nil)
                                                      expected)
                            (res (t es s)
                              (if (mentions? s t name)
                                  (refuse v (string-append "a letrena whose value's type mentions its region " r))
                                  (let* ((s (note-types s (cv-file v) (cv-pos v) "letrena-type" (list t)))
                                         (s (note-types s (cv-file v) (cv-pos v) "letrena-locals" types))
                                         (s (note-fact s (cv-file v) (cv-pos v)
                                                       (string-append "letrena-names " (words-of (map (lambda ((b bind)) (tagcase b (bind (n sc w) n))) used)))))
                                         (s (if (escapes? es) (note-fact s (cv-file v) (cv-pos v) "fallible") s)))
                                    (if (suspends? es)
                                        (refuse v "a suspension inside a letrena, whose data a suspended task would outlive (C45; Fixpt's async note, finding 4)")
                                        (res t (masked es name) s)))))))))))))

      (place-region (subr kfx (st ty) bool)
        (lambda (s t)
          "Whether `t` is a place's type."
          (tagcase (walk s t) (ty-data (d args) (string=? d "%place")) (else other #f))))

      (place-of (subr kfx (cv st sexp) ty)
        (lambda (v s e)
          "The region of the place `e` names, given to an allocator."
          (let ((found (tagcase e (sym (n f p) (scope-bind n v)) (else other nil))))
            (if (null? found)
                (refuse v "an allocator's place is a letrena's name")
                (tagcase (car found)
                  (bind (n sc w)
                    (tagcase sc
                      (scheme (tv t)
                        (tagcase (walk s t)
                          (ty-data (d args) (if (string=? d "%place") (car args) (refuse v (string-append n " is no place"))))
                          (else other (refuse v (string-append n " is no place"))))))))))))

      (region-within (subr kfx (cv st ty tys) ty)
        (lambda (v s place expected)
          "The region an allocation in `place` makes at (C40): the one the type
           expected says, if it is the place's or a region bound within it, a
           region binder `(r region p)` or one bound inside the place's
           `letrena`, which will not outlive it, as FX-26 has it; else the
           place's own. A region bound outside the place is refused by the fit."
          (let ((said (if (null? expected) (ty-unit)
                          (tagcase (walk s (car expected))
                            (ty-list (e r) (walk s r))
                            (ty-ref (e r) (walk s r))
                            (else other (ty-unit)))))
                (p (tagcase (walk s place) (ty-var (n) n) (else other ""))))
            (tagcase said
              (ty-var (n)
                (if (or (string-member? (string-append "%within " (string-append n (string-append " " p))) (cv-tvars v))
                        (bound-before? n (string-append "%place " p) (cv-tvars v)))
                    said
                    place))
              (else other place)))))

      (bound-before? (subr kfx (string string strings) bool)
        (lambda (x y ls)
          "Whether `x` comes before `y` in `ls`, the variables in scope newest
           first: bound inside it."
          (cond ((null? ls) #f)
                ((string=? (car ls) y) #f)
                ((string=? (car ls) x) (string-member? y (cdr ls)))
                (else (bound-before? x y (cdr ls))))))

      (region-alloc-call (subr kfx (cv st string sexps tys) res)
        (lambda (v s h args expected)
          "`(rcons r x xs)`, `(rnew r v)`: made in the arena of the place `r`, at
           its region (FX-26 allows one within it, which KFX does not write yet).
           What is made is noted, for the arena's type."
          (cond ((not (i64= (size args) (if (string=? h "rnew") 2 3)))
                 (refuse v (string-append h (cond ((string=? h "rcons") " takes a place and two values")
                                                  ((string=? h "rmake-array") " takes a place, a length and a value")
                                                  (else " takes a place and a value")))))
                ((string=? h "rmake-array")
                 "`(rmake-array p n x)`: an array of `n` of `x`, in a region within
                  place `p` (Fixpt's `(poly ((p place) (r region p)) ...)`)."
                 (let ((r (place-of v s (car args))))
                   (tagcase (fresh s)
                     (res (m es0 s)
                       (let* ((at (region-within v s r expected))
                              (made (ty-data "%array" (list m at)))
                              (s (if (null? expected) s (fits v s made (car expected)))))
                         (tagcase (call-args v s (cdr args) (list (ty-int) m) nil)
                           (res (u es s)
                             (res made (effs-union (list (string-append "alloc:" (region-string s r)) (string-append "alloc:" (region-string s at))) es) s))))))))
                (else
                 (let ((r (place-of v s (car args))))
                   (tagcase (fresh s)
                     (res (m es0 s)
                       (let* ((at (region-within v s r expected))
                              (made (if (string=? h "rcons") (ty-list m at) (ty-ref m at)))
                              (s (if (null? expected) s (fits v s made (car expected)))))
                         (tagcase (if (string=? h "rcons")
                                      (call-args v s (cdr args) (list m (ty-list m at)) nil)
                                      (call-args v s (cdr args) (list m) nil))
                           (res (u es s)
                             (res made (effs-union (list (string-append "alloc:" (region-string s r)) (string-append "alloc:" (region-string s at))) es)
                                  (note-types s (cv-file v) (cv-pos v)
                                              (string-append (if (string=? h "rcons") "rheld-cons@" "rheld-ref@") (region-string s r))
                                              (list m)))))))))))))

      (blob-form (subr kfx (cv st string sexps tys) res)
        (lambda (v s h xs expected)
          "Bloblets and blobrefs (C31), syntax as FX-26's are, since a field's
           type is its literal index's and an owner's region is in its type. The
           emitter is told each blobref read's and write's scalar, an `extract`'s
           offset and a `blobref-index`'s element size and length."
          (let ((args-are (lambda ((n i64)) (if (i64= (size xs) n) #t (refuse v (string-append "(" (string-append h " ...) takes the parts FX-26's does")))))))
            (cond
              ((or (string=? h "make-bloblet") (string=? h "rmake-bloblet"))
               (let* ((placed (string=? h "rmake-bloblet"))
                      (want (if (null? expected) (ty-unit) (walk-mu s (car expected))))
                      (rest (if placed (cdr xs) xs)))
                 (tagcase want
                   (ty-data (d args)
                     (if (or (not (string=? d "%bloblet")) (null? rest) (not (i64= (size (cdr rest)) (size (cdr args)))))
                         (refuse v (string-append "a bloblet made where a " (string-append (show-ty s want) " is expected, or not of its fields")))
                         (let* ((s (if placed (fits v s (place-of v s (car xs)) (car args)) s))
                                (s (if placed (note-types s (cv-file v) (cv-pos v) (string-append "rheld-blob@" (region-string s (car args))) (list want)) s)))
                           (tagcase (call-args v s rest (cons (ty-int) (cdr args)) nil)
                             (res (u es s)
                               (res want (effs-union (list (string-append "alloc:" (region-string s (car args)))) es)
                                    (blob-noted v (note-types s (cv-file v) (cv-pos v) "blob-make" (list want))
                                                (tagcase (car rest) (num (k f p) (string-append "blob-bytes " (i64->string k))) (else other "")))))))))
                   (else other (refuse v "a bloblet whose type nothing says: (the (bloblet (fields T ...) R) (make-bloblet bytes e ...))")))))
              ((or (string=? h "bloblet-ref") (string=? h "bloblet-set!"))
               (begin
                 (args-are (if (string=? h "bloblet-ref") 2 3))
                 (tagcase (synth v s (car xs))
                   (res (b es0 s)
                     (tagcase (walk-mu s b)
                       (ty-data (d args)
                         (let ((i (tagcase (second xs) (num (k f p) k) (else other (the i64 -1)))))
                           (cond ((not (string=? d "%bloblet")) (refuse v (string-append h " of no bloblet")))
                                 ((or (i64< i 0) (not (i64< i (size (cdr args))))) (refuse v (string-append h ": no such field, its index a literal")))
                                 ((string=? h "bloblet-ref")
                                  (res (list-ref-i64 (cdr args) i) (effs-union (list (string-append "read:" (region-string s (car args)))) es0) s))
                                 (else
                                  (tagcase (check v s (third xs) (list-ref-i64 (cdr args) i))
                                    (res (u es s)
                                      (res (ty-unit) (effs-union (list (string-append "write:" (region-string s (car args)))) (effs-union es0 es)) s)))))))
                       (else other (refuse v (string-append h " of no bloblet"))))))))
              ((or (string=? h "bloblet-byte") (string=? h "bloblet-set-byte!") (string=? h "bloblet-bytes"))
               (begin
                 (args-are (cond ((string=? h "bloblet-bytes") 1) ((string=? h "bloblet-byte") 2) (else 3)))
                 (tagcase (synth v s (car xs))
                   (res (b es0 s)
                     (tagcase (walk s b)
                       (ty-data (d args)
                         (if (not (string=? d "%bloblet"))
                             (refuse v (string-append h " of no bloblet"))
                             (tagcase (call-args v (note-types s (cv-file v) (cv-pos v) "blob-raw" (list b)) (cdr xs) (map (lambda ((x sexp)) (ty-int)) (cdr xs)) nil)
                               (res (u es s)
                                 (res (if (string=? h "bloblet-set-byte!") (ty-unit) (ty-int))
                                      (effs-union (cond ((string=? h "bloblet-bytes") nil)
                                                        ((string=? h "bloblet-byte") (list (string-append "read:" (region-string s (car args)))))
                                                        (else (list (string-append "write:" (region-string s (car args))))))
                                                  (effs-union es0 es))
                                      s)))))
                       (else other (refuse v (string-append h " of no bloblet"))))))))
              ((string=? h "blobref-at")
               (begin
                 (args-are 2)
                 (tagcase (if (null? expected) (ty-unit) (walk s (car expected)))
                   (ty-data (d args)
                     (cond
                       ((not (string=? d "%blobref"))
                         (refuse v "a blobref made where none is expected"))
                       ((length-named? (walk s (car (cdr args))))
                        "Its length named where it is bound, not claimed (C175;
                         `flat-unsized-new.fx`)."
                        (refuse v "a new blobref's array of a length not literal is of length `finite`"))
                       (else
                         (tagcase (check v s (car xs) (car args))
                           (res (b es0 s)
                             (tagcase (check v s (second xs) (ty-int))
                               (res (u es s)
                                 (res (car expected) (effs-union es0 es)
                                      (blob-noted v
                                        (blob-noted v (note-types s (cv-file v) (cv-pos v) "blob-at" args)
                                                    (tagcase (second xs) (num (k f p) (if (i64= k 0) "blob-zero" "")) (else other "")))
                                        (string-append "blob-size " (tagcase (flat-layout (walk s (car (cdr args)))) (layout (size al) (i64->string size)))))))))))))
                   (else other (refuse v "which flat a new blobref points to is said by the type it is checked against: (the (blobref B F) (blobref-at b off))")))))
              ((string=? h "blobref+")
               (begin
                 (args-are 2)
                 (tagcase (if (null? expected) (ty-unit) (walk s (car expected)))
                   (ty-data (d args)
                     (if (not (string=? d "%blobref"))
                         (refuse v "a blobref made where none is expected")
                         (tagcase (synth v s (car xs))
                           (res (r es0 s)
                             (tagcase (walk s r)
                               (ty-data (d2 args2)
                                 (if (not (string=? d2 "%blobref"))
                                     (refuse v "blobref+ of no blobref")
                                     (tagcase (check v s (second xs) (ty-int))
                                       (res (u es s) (res (car expected) (effs-union es0 es)
                                                          (blob-noted v
                                                            (note-types (fits v s (car args2) (car args)) (cv-file v) (cv-pos v) "blob-raw" (list (car args2)))
                                                            (string-append "blob-size " (tagcase (flat-layout (walk s (car (cdr args)))) (layout (size al) (i64->string size))))))))))
                               (else other (refuse v "blobref+ of no blobref")))))))
                   (else other (refuse v "which flat a new blobref points to is said by the type it is checked against: (the (blobref B F) (blobref+ r d))")))))
              (else
               "blobref-owner, -offset, -get, -set!, -index: of a blobref."
               (begin
                 (args-are (cond ((or (string=? h "blobref-owner") (string=? h "blobref-offset") (string=? h "blobref-get") (string=? h "blobref-length")) 1) (else 2)))
                 (tagcase (synth v s (car xs))
                   (res (r es0 s)
                     (tagcase (walk s r)
                       (ty-data (d args)
                         (if (not (string=? d "%blobref"))
                             (refuse v (string-append h " of no blobref"))
                             (let* ((owner (walk s (car args)))
                                    (flat (walk s (car (cdr args))))
                                    (region (tagcase owner (ty-data (d2 a2) (car a2)) (else other (ty-unit))))
                                    (s (note-types s (cv-file v) (cv-pos v) "blob-owner" (list owner))))
                               (cond
                                 ((string=? h "blobref-owner") (res owner es0 (note-types s (cv-file v) (cv-pos v) "blob-raw" (list owner))))
                                 ((string=? h "blobref-offset") (res (ty-int) es0 (note-types s (cv-file v) (cv-pos v) "blob-raw" (list owner))))
                                 ((string=? h "blobref-index")
                                  (tagcase flat
                                    (ty-data (d3 a3)
                                      (if (not (string=? d3 "%flat-array"))
                                          (refuse v "blobref-index of a blobref to no flat array")
                                          (tagcase (check v s (second xs) (ty-int))
                                            (res (u es s)
                                              (res (ty-data "%blobref" (list owner (car a3))) (effs-union es0 es)
                                                   (note-fact s (cv-file v) (cv-pos v)
                                                     (string-append "blob-element "
                                                       (string-append (tagcase (flat-layout (car a3)) (layout (size al) (i64->string size)))
                                                         (string-append " " (flat-length-code (car (cdr a3))))))))))))
                                    (else other (refuse v "blobref-index of a blobref to no flat array"))))
                                 ((string=? h "blobref-length")
                                  "A flat array's length (C175; Fixpt's N5c): a `(nat n)` of its
                                   length `n`, `nat` if it is `finite`."
                                  (tagcase flat
                                    (ty-data (d3 a3)
                                      (if (not (string=? d3 "%flat-array"))
                                          (refuse v "blobref-length of a blobref to no flat array")
                                          (let ((n (walk s (flat-length (car (cdr a3))))))
                                            (res (if (tagcase n (ty-data (d4 a4) (string=? d4 "%finite")) (else other #f)) (ty-nat) (ty-data "%natof" (list n)))
                                                 es0
                                                 (note-fact (kfx-restricted v s "blobref-length, FX-26's, which KFX has not yet (C175)") (cv-file v) (cv-pos v)
                                                   (string-append "blob-element "
                                                     (string-append (tagcase (flat-layout (car a3)) (layout (size al) (i64->string size)))
                                                       (string-append " " (flat-length-code (car (cdr a3)))))))))))
                                    (else other (refuse v "blobref-length of a blobref to no flat array"))))
                                 ((string=? h "blobref-variant!")
                                  (tagcase flat
                                    (ty-data (d3 a3)
                                      (let* ((lab (tagcase (second xs)
                                                    (num (k f p) (if (and (string=? d3 "%flat-sum") (not (unkeyed? a3))) (i64->string k) ""))
                                                    (lst (qs f p l2)
                                                      (if (and (string=? d3 "%flat-sum") (unkeyed? a3) (i64= (size qs) 2) (sym-is? (car qs) "quote"))
                                                          (tagcase (second qs) (sym (n f2 p2) n) (else other ""))
                                                          ""))
                                                    (else other "")))
                                             (s (if (and (string=? d3 "%flat-sum") (unkeyed? a3))
                                                    (kfx-restricted v s "a flat sum with no key, FX-26's, its tag an index of the owner's fields, which KFX has not yet (C175)")
                                                    s))
                                             (found (concat (map (lambda ((f fvar)) (tagcase f (fvar (l x) (if (string=? l lab) (the tys (list x)) nil))))
                                                                 (if (string=? d3 "%flat-sum") (flat-sum-variants a3) nil)))))
                                        (cond ((not (string=? d3 "%flat-sum")) (refuse v "blobref-variant! of a blobref to no flat sum"))
                                              ((null? found) (refuse v "a variant is named by a literal: `'label`, or a number where the sum has a key"))
                                              (else
                                               (res (ty-data "%blobref" (list owner (car found)))
                                                    (effs-union (list (string-append "read:" (region-string s region)) (string-append "write:" (region-string s region))) es0)
                                                    (note-fact s (cv-file v) (cv-pos v)
                                                               (string-append "blob-variant " (string-append (i64->string (key-width (car a3)))
                                                                 (string-append " " (string-append lab (string-append " " (string-append (i64->string (variant-offset a3))
                                                                   (if (unkeyed? a3) " fields" "")))))))))))))
                                    (else other (refuse v "blobref-variant! of a blobref to no flat sum"))))
                                 ((string=? (scalar-name flat) "")
                                  (refuse v (string-append "only a scalar's bytes are read or written: " (show-ty s flat))))
                                 ((string=? h "blobref-get")
                                  (res flat (effs-union (list (string-append "read:" (region-string s region))) es0)
                                       (note-fact s (cv-file v) (cv-pos v) (string-append "blob-scalar " (scalar-name flat)))))
                                 (else
                                  (tagcase (check v s (second xs) flat)
                                    (res (u es s)
                                      (res (ty-unit) (effs-union (list (string-append "write:" (region-string s region))) (effs-union es0 es))
                                           (note-fact s (cv-file v) (cv-pos v) (string-append "blob-scalar " (scalar-name flat)))))))))))
                       (else other (refuse v (string-append h " of no blobref"))))))))))))

      (proj-form (subr kfx (cv st sexps) res)
        (lambda (v s xs)
          "`(proj f a ...)`: the poly procedure `f` at the arguments given for
           its binders in order, types and regions (places too), as FX-26
           projects one; in Rust `f`, whose generics the call finds. A proj of
           a proj (C60): FX-26's nested `poly`s have their binders in the order
           KFX's one has them, so the arguments are run together."
          (cond
           ((and (not (null? xs)) (head-is? (car xs) "proj"))
              (proj-form v s (onto (cdr (items (car xs))) (cdr xs))))
           ((and (not (null? xs)) (head-is? (car xs) "with") (i64= (size (items (car xs))) 3)
                 (tagcase (third (items (car xs))) (sym (n f p) #t) (else other #f)))
            "`(proj (with m x) a ...)`, `(with m (proj x a ...))` (C171)."
            (synth v s (lst (list (sym "with" "" 0) (second (items (car xs)))
                                  (lst (cons (sym "proj" "" 0) (cons (third (items (car xs))) (cdr xs))) "" 0 (cv-pos v)))
                            "" 0 (cv-pos v))))
           ((and (not (null? xs)) (tagcase (car xs) (lst (ys f l p) #t) (else other #f)))
            "A proj of an expression of a poly type, a `letrec`'s, as FX-26's
             programs write it (C158): its body at the arguments given, each by
             its binder's kind."
            (tagcase (synth v s (car xs))
              (res (t es s)
                (if (not (poly-type? s t))
                    (refuse v "(proj e arg ...) of an expression of no poly type")
                    (let ((args (tagcase (walk s t) (ty-data (d args) args) (else other nil))))
                      (if (not (i64= (size (poly-binders-of args)) (size (cdr xs))))
                          (refuse v "a proj given the wrong number of arguments")
                          (res (poly-instance args (map2 (lambda ((b string) (r sexp))
                                                           (cond ((has-prefix? b "'") (parse-region v (cv-tvars v) r))
                                                                 ((has-prefix? b "#") (parse-size v (cv-tvars v) r))
                                                                 ((has-prefix? b "^") (fun-of-kind v (cv-tvars v) r (binder-kind b) (written-binder b)))
                                                                 (else (parse-type v (cv-tvars v) r))))
                                                         (poly-binders-of args) (cdr xs)))
                               es
                               (if (all-regions? (poly-binders-of args)) s
                                   (kfx-restricted v s "a proj of a poly value of types or sizes, which KFX has not yet (C107)")))))))))
           (else
          (let ((found (if (null? xs) nil (tagcase (car xs) (sym (n f p) (let ((b (scope-bind n v))) (if (null? b) (find-bind n (control-binds v)) b))) (else other nil)))))
            (if (null? found)
                (refuse v "(proj f arg ...) of a poly procedure named")
                (tagcase (car found)
                  (bind (n sc wher)
                    (tagcase sc
                      (scheme (tvars t)
                        (cond
                         ((and (null? tvars) (poly-type? s t))
                          "A value of a poly type, a parameter's (rank 2, C107): its
                           body at the regions given."
                          (let ((args (tagcase (walk s t) (ty-data (d args) args) (else other nil))))
                            (if (not (i64= (size (poly-binders-of args)) (size (cdr xs))))
                                (refuse v (string-append "a proj of " (string-append n " given the wrong number of arguments")))
                                (res (poly-instance args (map2 (lambda ((b string) (r sexp))
                                                                 (cond ((has-prefix? b "'") (parse-region v (cv-tvars v) r))
                                                                       ((has-prefix? b "#") (parse-size v (cv-tvars v) r))
                                                                       ((has-prefix? b "^") (fun-of-kind v (cv-tvars v) r (binder-kind b) (written-binder b)))
                                                                       (else (parse-type v (cv-tvars v) r))))
                                                               (poly-binders-of args) (cdr xs)))
                                     nil
                                     (if (all-regions? (poly-binders-of args))
                                         s
                                         (kfx-restricted v s "a proj of a poly value of types or sizes, which KFX has not yet: its Rust erases regions alone (C107)"))))))
                         (else
                        (if (not (i64= (size tvars) (size (cdr xs))))
                            (refuse v (string-append "a proj of " (string-append n " given the wrong number of arguments")))
                            (begin
                              (bounds-kept v s n (lambda ((x string)) (projected v tvars (cdr xs) (ty-var x))))
                              (res (projected v tvars (cdr xs) t) (naming-effs s n wher t (cv-group v))
                                   (let ((s (if (null? (tagcase (car xs) (sym (n2 f2 p2) (scope-bind n2 v)) (else other nil)))
                                                ;; A control primitive's, no binding of the program's (C105).
                                                (note-fact s (cv-file v) (cv-pos v) "control")
                                                s)))
                                   (tagcase (car xs)
                                     (sym (name at-file at-pos)
                                       "A global that may suspend, as a value: its future boxed, as a
                                        name's is (`async-global`), at any effect it is given."
                                       (async-global v (proj-needs v s n tvars (cdr xs)) name at-file at-pos))
                                     (else other (proj-needs v s n tvars (cdr xs))))))))))))))))))))

      (bounds-kept (subr kfx (cv st string (subr kfx (string) ty)) unit)
        (lambda (v s n region-of-binder)
          "A procedure's regions within its places (C40), `(r region p)`, given
           regions that keep their bounds: `r`'s the place's, or bound inside
           it, or within it, so that it will not outlive it, as FX-26 has it."
          (begin
            (map (lambda ((rest string))
                           (let* ((ws (read-all (string-chars rest) "" 1))
                                  (r (tagcase (walk s (region-of-binder (sym-name (car ws)))) (ty-var (x) x) (else other "")))
                                  (p (tagcase (walk s (region-of-binder (sym-name (second ws)))) (ty-var (x) x) (else other ""))))
                             (if (or (string=? r "") (string=? p "") (string=? r p)
                                     (string-member? (string-append "%within " (string-append r (string-append " " p))) (cv-tvars v))
                                     (bound-before? r (string-append "%place " p) (cv-tvars v)))
                                 #u
                                 (refuse v (string-append "a region given within a place it could outlive: " (string-append r (string-append " is bound outside " p)))))))
                 (facts-after (cv-facts v) (string-append "region-within " (string-append n " "))))
            #u)))

      (proj-needs (subr kfx (cv st string strings sexps) st)
        (lambda (v s n tvars args)
          "A proj's needs: what the procedure makes in each place, at the
           places and types given (C34), noted as a call's are."
          (letrec ((go (subr kfx (st strings) st)
                         (lambda (s needs)
                           (if (null? needs)
                               s
                               (let* ((ws (read-all (string-chars (car needs)) "" 1))
                                      (place (projected v tvars args (ty-var (sym-name (car ws)))))
                                      (need (projected v tvars args (parse-type v (onto (map (lambda ((x string)) (string-append "%place " x)) tvars) tvars) (third ws)))))
                                 (go (note-types s (cv-file v) (cv-pos v) (string-append "rneed-" (string-append (sym-name (second ws)) (string-append "@" (region-string s place)))) (list need))
                                     (cdr needs)))))))
            (go s (facts-after (cv-facts v) (string-append "place-needs " (string-append n " ")))))))

      (projected (subr kfx (cv strings sexps ty) ty)
        (lambda (v tvars args t)
          (if (null? tvars)
              (if (has-app? t) (reduced t) t)
              (projected v (cdr tvars) (cdr args)
                         (replace-var (car tvars)
                                      (cond ((char=? (string-ref-i64 (car tvars) 0) #\') (parse-region v (cv-tvars v) (car args)))
                                            ((char=? (string-ref-i64 (car tvars) 0) #\~) (effect-row (cons "~!" (parse-effect v (cv-tvars v) (car args)))))
                                            ((char=? (string-ref-i64 (car tvars) 0) #\^)
                                             "A function where one of arrow kind is bound (C173)."
                                             (fun-of-kind v (cv-tvars v) (car args) (binder-kind (car tvars)) (written-binder (car tvars))))
                                            ((char=? (string-ref-i64 (car tvars) 0) #\#) "A size (C158)." (parse-size v (cv-tvars v) (car args)))
                                            (else (parse-type v (cv-tvars v) (car args))))
                                      t)))))

      (rlambda-form (subr kfx (cv st sexp sexps tys) res)
        (lambda (v s e xs expected)
          "`(rlambda r params body ...)` (C38): a closure made in the place `r`,
           whose latent effect therefore reads `r`, as FX-26 has it; its making
           allocates there. In Rust a closure as a `lambda`'s is, kept as long
           as anything wants it: where its memory is is all that differs."
          (if (i64< (size xs) 3)
              (refuse v "(rlambda r params body ...)")
              (let* ((r (place-of v s (car xs)))
                     (read (string-append "read:" (region-string s r)))
                     (lam (lst (cons (sym "lambda" "" 0) (cdr xs)) (datum-file e) 0 (datum-pos e))))
                (tagcase (if (and (not (null? expected)) (proc-type? s (car expected)))
                             (tagcase (walk s (car expected))
                               (ty-proc (ees eps er)
                                 (if (not (string-member? read (map (lambda ((x string)) (resolve-atom s x)) ees)))
                                     (refuse v (string-append "an rlambda's latent effect reads its place, which the type expected does not: " (show-ty s (car expected))))
                                     (check v s lam (car expected))))
                               (else other (check v s lam (car expected))))
                             (tagcase (synth v s lam)
                               (res (t es s)
                                 (tagcase (walk s t)
                                   (ty-proc (les ps rt) (res (ty-proc (effs-union (list read) les) ps rt) es s))
                                   (else other (res t es s))))))
                  (res (t es s) (res t (effs-union (list (string-append "alloc:" (region-string s r))) es) s)))))))

      (letrec-lambdas (subr kfx (cv st sexps tys) res)
        (lambda (v s bindings types)
          (if (null? bindings)
              (res (ty-unit) nil s)
              (let ((ys (items (car bindings))))
                (if (not (or (head-is? (third ys) "lambda") (head-is? (third ys) "rlambda")
                             (and (head-is? (third ys) "plambda") (poly-type? s (car types)))))
                    (refuse v "a letrec binds only lambdas")
                    (tagcase (check v s (third ys) (car types))
                      (res (t es s) (letrec-lambdas v s (cdr bindings) (cdr types)))))))))

      (synth-lambda (subr kfx (cv st sexps sexps) res)
        (lambda (v s params forms)
          "A lambda with nothing expected: its parameters' types written."
          (let ((types (synth-param-types v params)))
            (let ((s (if (any? (lambda ((p ty)) (not (null? (module-spec v p)))) types)
                         (kfx-restricted v s "a module parameter is a top-level procedure's (C24)")
                         s)))
            (tagcase (body (with-binds v (bind-params v params types)) s forms nil)
              (res (r es s) (res (deps-of-params params types 1 (ty-proc es types r)) nil (synced-lambda v (noted-lambda v s es) es params forms))))))))

      (synth-param-types (subr kfx (cv sexps) tys)
        (lambda (v params)
          "A lambda's parameters' types, as written, each seeing the module
           parameters before it (C170)."
          (if (null? params)
              nil
              (let ((t (tagcase (car params)
                         (lst (pt src-file src-line src-pos) (parse-type v (cv-tvars v) (second pt)))
                         (else other (refuse v (string-append "a lambda with nothing expected needs its parameters' types: " (show-sexp other)))))))
                (cons t (synth-param-types (module-param-bound v (car params) t) (cdr params)))))))

      (module-params-apart (subr kfx (cv sexps tys st) st)
        (lambda (v params types s)
          "No two module parameters named alike in Rust, their type parameters
           camel-cased (`m` and `m-` are both `Mod_M`)."
          (if (repeated? (concat (map (lambda ((n string)) (the strings (list (camel n))))
                                      (module-param-names v s params types))))
              (refuse v "two module parameters named alike in Rust (camel-cased, as `m` and `m-`)")
              s)))

      (module-param-names (subr kfx (cv st sexps tys) strings)
        (lambda (v s params types)
          (if (or (null? params) (null? types))
              nil
              (let ((rest (module-param-names v s (cdr params) (cdr types))))
                (if (null? (module-spec v (walk s (car types))))
                    rest
                    (cons (param-name (car params)) rest))))))

      (check-lambda (subr kfx (cv st sexps sexps ty) res)
        (lambda (v s params forms expected0)
          (let ((expected (deps-named params 1 expected0)))
          (tagcase expected
            (ty-proc (ees eps er)
              (if (not (i64= (size params) (size eps)))
                  (refuse v "a lambda of the wrong number of parameters")
                  (let* ((s (module-params-apart v params eps (check-written-params v s params eps)))
                         (s (if (or (not (null? (module-spec v (walk s er)))) (mtype? (walk s er))
                                    (and (any? (lambda ((p ty)) (or (not (null? (module-spec v (walk s p)))) (mtype? (walk s p)))) eps)
                                         (not (top-lambda? v))))
                                (kfx-restricted v s "a module parameter is a top-level procedure's, and no procedure gives a module back (C24)")
                                s)))
                    (if #f
                        (refuse v "")
                    (tagcase (body (with-binds v (cons (bind "%toplambda" (scheme nil (ty-unit)) "no") (bind-params v params eps)))
                                   s forms (list er))
                      (res (r es s)
                        (if (not (null? (fit-effs s es ees)))
                            (let* ((s (car (fit-effs s es ees)))
                                   (s (if (any? (lambda ((p ty)) (or (has-meta? s p) (has-var? s p))) eps)
                                          s
                                          (note-fact s (cv-file v) (cv-pos v)
                                                     (string-append "param-types " (show-sexp (lst (map (lambda ((p ty)) (ty-sexp v s (zonk s p))) eps) "" 0 0)))))))
                              (res expected nil (synced-lambda v (noted-lambda v s ees) ees params forms)))
                            (refuse v (string-append "a lambda whose effect " (string-append (show-effs es)
                                      (string-append " is not within " (show-effs ees))))))))))))
            ;; A lambda where a procedure of any convention is expected (C116):
            ;; KFX's own, as any procedure of KFX's is.
            (ty-data (d args)
              (cond ((string=? d "%fx") (check-lambda v s params forms (walk s (car args))))
                    ((has-prefix? d "%spec ")
                     "A lambda where a specified procedure is expected (C162): checked as
                      the procedure within, its specification not proved, as FX-26's
                      checker has it; but one that says what a test proves, which a
                      branch on its call would trust, refused (Fixpt's `k-claimed`)."
                     (if (spec-claims? d)
                         (refuse v "what a test proves, a `lambda` is not checked to prove")
                         (tagcase (check-lambda v s params forms (walk s (car args)))
                           (res (t es s2) (res expected es s2)))))
                    ((string=? d "%poly")
                     "A lambda where a poly type is expected, as FX-26 takes it: as the
                      plambda of that type's binders, rigid, in scope (C107, C158)."
                     (let ((names (poly-binders-of args)))
                       (tagcase (check-lambda (with-tvars v names) (if (all-regions? names) s (kfx-restricted v s "a lambda where a poly type of types or sizes is expected, which KFX has not yet (C107)"))
                                              params forms (poly-body args))
                         (res (t es s2) (res expected es s2)))))
                    (else (refuse v "a lambda where no procedure is expected"))))
            (else other (refuse v "a lambda where no procedure is expected"))))))

      (lambda-effects (subr kfx (cv st sexps sexps ty) res)
        (lambda (v s params forms t)
          "A lambda's body's effect, the body checked against the type `t`'s
           parameters and result, but not its effect: what `define*` finds."
          (tagcase t
            (ty-proc (ees eps er)
              (if (not (i64= (size params) (size eps)))
                  (refuse v "a lambda of the wrong number of parameters")
                  (body (with-binds v (bind-params v params eps))
                        (check-written-params v s params eps) forms (list er))))
            (else other (refuse v "a lambda where no procedure is expected")))))

      (module-param-bound (subr kfx (cv sexp ty) cv)
        (lambda (v p t)
          "`v` with parameter `p` in scope if it is a module's, for the types
           of the parameters after it (C170)."
          (if (or (mtype? t) (tagcase t (ty-data (d args) (has-prefix? d "%module ")) (else other #f)))
              (with-binds v (list (local v (param-name p) (as-mtype v t))))
              v)))

      (dep-substituted (subr kfx (cv st ty sexps) ty)
        (lambda (v s t args)
          "A dependent procedure's type at a call (C170): each `$i..t` the type
           its `i`th argument, a module, gives as `t`."
          (let ((names (data-names-with "$" t)))
            (if (null? names)
                t
                (data-replaced names
                               (map (lambda ((n string))
                                      (let* ((i (string->i64 (after-prefix (before-dots n) "$")))
                                             (arg (if (and (i64> i 0) (i64<= i (size args))) (list (nth-sexp args (i64- i 1))) nil)))
                                        (if (null? arg)
                                            (ty-data n nil)
                                            (tagcase (synth v s (car arg))
                                              (res (a es s2) (mtype-provided v (as-mtype v (walk s2 a)) (after-dots n) (ty-unit)))))))
                                    names)
                               t)))))

      (nth-sexp (subr kfx (sexps i64) sexp)
        (lambda (xs i) (if (i64= i 0) (car xs) (nth-sexp (cdr xs) (i64- i 1)))))

      (deps-named (subr kfx (sexps i64 ty) ty)
        (lambda (params i t)
          "A dependent procedure's type, as its lambda's parameters name its
           modules: `$i..t` its `i`th parameter's `p..t` (C170)."
          (if (null? params)
              t
              (let ((pre (string-append "$" (string-append (i64->string i) ".."))))
                (deps-named (cdr params) (i64+ i 1)
                            (data-renamed (data-names-with pre t)
                                          (map (lambda ((n string)) (string-append (param-name (car params)) (string-append ".." (after-dots n))))
                                               (data-names-with pre t))
                                          t))))))

      (deps-of-params (subr kfx (sexps tys i64 ty) ty)
        (lambda (params types i t)
          "`t`, a lambda's type, its parameters' modules' types `m..t` written
           `$i..t`, as a dependent procedure's are (C170)."
          (if (or (null? params) (null? types))
              t
              (deps-of-params (cdr params) (cdr types) (i64+ i 1)
                              (if (or (mtype? (car types)) (tagcase (car types) (ty-data (d args) (has-prefix? d "%module ")) (else other #f)))
                                  (let ((pre (string-append (param-name (car params)) "..")))
                                    (data-renamed (data-names-with pre t)
                                                  (map (lambda ((n string)) (string-append "$" (string-append (i64->string i) (string-append ".." (after-dots n)))))
                                                       (data-names-with pre t))
                                                  t))
                                  t)))))

      (check-written-params (subr kfx (cv st sexps tys) st)
        (lambda (v s params types)
          "A parameter written `(x T)` must be of the type expected. One written
           `x` must have its type known already, from the arguments before the
           lambda: rustc, which checks a call's arguments in order, finds a
           closure's parameter types no other way."
          (if (null? params)
              s
              (check-written-params (module-param-bound v (car params) (car types))
                                    (tagcase (car params)
                                      (lst (pt src-file src-line src-pos) (fits v s (car types) (parse-type v (cv-tvars v) (second pt))))
                                      (else other
                                        (if (has-meta? s (car types))
                                            (refuse v (string-append "the type of the lambda's parameter "
                                                        (string-append (show-sexp other)
                                                          " is not known from the arguments before it: write it as (x T)")))
                                            s)))
                                    (cdr params) (cdr types)))))

      (module-type-of (subr kfx (cv string) ty)
        (lambda (v m)
          "The type of module `m`, defined at the top level, as a value (C170):
           its generative types and datatypes abstract, `m..t`; its other
           types described; its effects; its values."
          (let* ((pre (string-append m " "))
                 (types (the aliases (onto nil (filter (lambda ((a alias)) (tagcase a (alias (n ps body) (and (has-prefix? n pre) (null? ps))))) (cv-aliases v)))))
                 (effs (the effdefs (onto nil (filter (lambda ((d effdef)) (tagcase d (effdef (n atoms) (has-prefix? n pre)))) (cv-effdefs v)))))
                 (vals (the binds (onto nil (filter (lambda ((b bind)) (tagcase b (bind (n sc w) (and (has-prefix? n pre) (not (has-prefix? (after-prefix n pre) "%"))
                                                                                                         (not (has-char-in? (after-prefix n pre) #\space)))))) (cv-binds v))))))
            (ty-data "%mtype" (newest-items (reverse (the tys
              (onto (map (lambda ((a alias))
                           (tagcase a
                             (alias (n ps body)
                               (let ((t (after-prefix n pre)))
                                 (if (tagcase body (sym (b f p) (and (or (string=? b (string-append m (string-append ".." t))) (has-prefix? b "made--load--"))
                                                                     (dt-named? b (cv-dts v))))
                                              (else other #f))
                                     ;; Its own abstract type, or a loaded file's, which only it
                                     ;; names (C172).
                                     (ty-data (string-append "%abs " t) (list (ty-data (sym-name body) nil)))
                                     (ty-data (string-append "%desc " t) (list (parse-type v nil body))))))))
                         types)
                    (onto (map (lambda ((d effdef)) (tagcase d (effdef (n atoms) (ty-data (string-append "%edesc " (after-prefix n pre)) (list (ty-proc atoms nil (ty-unit)))))))
                               effs)
                          (map (lambda ((b bind))
                                 (tagcase b
                                   (bind (n sc w)
                                     (ty-data (string-append "%val " (after-prefix n pre))
                                              (list (if (and (tagcase sc (scheme (tv t) (tagcase t (ty-unit () #t) (else other #f))))
                                                             (any? (lambda ((c bind)) (tagcase c (bind (m sc2 w2) (has-prefix? m (string-append n " "))))) (cv-binds v)))
                                                        ;; A module in the module (C88).
                                                        (module-type-of v n)
                                                        (tagcase sc (scheme (tv t) t))))))))
                               vals))))) nil)))))

      (newest-items (subr kfx (tys strings) tys)
        (lambda (ts seen)
          "Items, the last of each kind and name only, in order (`ts` reversed)."
          (if (null? ts)
              nil
              (let ((key (string-append (if (string=? (mitem-kind (car ts)) "%val") "v " "t ") (mitem-name (car ts)))))
                (if (string-member? key seen)
                    (newest-items (cdr ts) seen)
                    (append-ty (newest-items (cdr ts) (cons key seen)) (car ts)))))))

      (append-ty (subr kfx (tys ty) tys)
        (lambda (ts t) (if (null? ts) (list t) (cons (car ts) (append-ty (cdr ts) t)))))

      (module-extend (subr kfx (cv st sexps) res)
        (lambda (v s args)
          "`(extend e0 e1)` made as a value (C171; FX-91's, Fixpt's `TODO.md`
           §69): a module of the values and types of both, `e1`'s where both
           give a name."
          (tagcase (synth v s (car args))
            (res (a es0 s)
              (tagcase (synth v s (second args))
                (res (b es1 s)
                  (if (not (and (mtype? (walk s a)) (mtype? (walk s b))))
                      (refuse v "an extend of two modules")
                      (let* ((bs (mtype-items (walk s b)))
                             (types-of-b (map mitem-name (filter (lambda ((x ty)) (not (string=? (mitem-kind x) "%val"))) bs)))
                             (vals-of-b (map mitem-name (filter (lambda ((x ty)) (string=? (mitem-kind x) "%val")) bs)))
                             (replaced (lambda ((x ty)) (string-member? (mitem-name x) (if (string=? (mitem-kind x) "%val") vals-of-b types-of-b))))
                             (kept (filter (lambda ((x ty)) (not (replaced x))) (mtype-items (walk s a))))
                             (lost (concat (map (lambda ((x ty)) (if (and (string=? (mitem-kind x) "%abs") (replaced x))
                                                                     (tagcase (abs-ref x) (ty-data (r a2) (the strings (list r))) (else other nil))
                                                                     nil))
                                                (mtype-items (walk s a))))))
                        (begin
                          (map (lambda ((x ty))
                                 (if (any? (lambda ((n string)) (string-member? n lost))
                                           (data-names-with "" (tagcase x (ty-data (d xs) (if (null? xs) (ty-unit) (car xs))) (else other (ty-unit)))))
                                     (refuse v (string-append "`" (string-append (mitem-name x) "`'s type mentions the first module's abstract type, which the second's replaces")))
                                     #u))
                               kept)
                        (res (ty-data "%mtype" (onto kept bs))
                             (effs-union es0 es1)
                             (note-fact (kfx-restricted v s "an extend made as a value, FX-26's first-class modules', which KFX has not yet (C170)")
                                        (cv-file v) (cv-pos v) "module-value")))))))))))

      (module-expr (subr kfx (cv st sexps) res)
        (lambda (v s its)
          "`(module item ...)` made as a value (C170; Fixpt's first-class
           modules): its types, generative ones abstract, `mt@P..t`, each
           seeing those before it; then its values, each typed one in scope for
           all, each seeing those made before it. Its type a `moduleof` of what
           it gives, a hidden item not. Not KFX's, whose modules are Rust's,
           defined at the top level (C19)."
          (let ((s (note-fact (kfx-restricted v s "a module made as a value, FX-26's first-class modules', which KFX has not yet: KFX's are defined at the top level (C19, C170)")
                              (cv-file v) (cv-pos v) "module-value"))
                (id (string-append "mt@" (i64->string (cv-pos v)))))
            (tagcase (mod-types v s its id #t nil nil)
              (mres (w items es s)
                (tagcase (mod-values (with-binds w (mod-typed w its)) s its #t items es)
                  (mres (w2 items2 es2 s2)
                    (let* ((its2 (the tys (reverse items2)))
                           (types (map mitem-name (filter (lambda ((x ty)) (not (string=? (mitem-kind x) "%val"))) its2)))
                           (vals (map mitem-name (filter (lambda ((x ty)) (string=? (mitem-kind x) "%val")) its2)))
                           (twice (the strings (onto (repeated-names types) (repeated-names vals))))
                           (inner (mod-module-names its)))
                      (cond ((not (null? twice)) (refuse v (string-append "`" (string-append (car twice) "` is defined twice in this module"))))
                            (else
                             (begin
                               (map (lambda ((x ty))
                                      (let ((m (mentions-module-of? (tagcase x (ty-data (d args) (if (null? args) (ty-unit) (car args))) (else other (ty-unit))) inner)))
                                        (if (string=? m "")
                                            #u
                                            (refuse v (string-append "`" (string-append (mitem-name x) (string-append "`'s type mentions `" (string-append m "`, which is not known outside the module"))))))))
                                    its2)
                               (res (ty-data "%mtype" its2) es2 s2))))))))))))

      (repeated-names (subr kfx (strings) strings)
        (lambda (ns)
          (cond ((null? ns) nil)
                ((string-member? (car ns) (cdr ns)) (list (car ns)))
                (else (repeated-names (cdr ns))))))

      (mod-module-names (subr kfx (sexps) strings)
        (lambda (fs)
          "The names a module's items bind, whose abstract types, named for the
           binding, stay in the module."
          (concat (map (lambda ((f sexp))
                         (cond ((and (or (head-is? f "define") (head-is? f "define*")) (i64> (size (items f)) 2)
                                     (tagcase (second (items f)) (sym (n f2 p2) #t) (else other #f)))
                                (the strings (list (sym-name (second (items f))))))
                               ((head-is? f "hide") (mod-module-names (cdr (items f))))
                               (else nil)))
                       fs))))

      (mod-types (subr kfx (cv st sexps string bool tys strings) mres)
        (lambda (v s fs id export got es)
          (if (null? fs)
              (mres v got es s)
              (let* ((f (car fs)) (xs (tagcase f (lst (ys f1 l1 p1) ys) (else other nil))) (hd (logic-head f)) (tv (cv-tvars v))
                     (n (if (and (i64> (size xs) 1) (tagcase (second xs) (sym (m f2 p2) #t) (else other #f))) (sym-name (second xs)) ""))
                     (more (lambda ((w cv) (its tys)) (mod-types w s (cdr fs) id export (if export (onto its got) got) es))))
                (cond ((null? xs) (mod-types v s (cdr fs) id export got es))
                      ((and (string=? hd "define-type") (i64= (size xs) 3) (not (string=? n "")))
                       (let ((u (if (head-is? (third xs) "dlambda") (parse-fun v tv (third xs)) (parse-type v tv (third xs)))))
                         (more (with-type-binds v (list (type-bind n u)) nil) (the tys (list (ty-data (string-append "%desc " n) (list u)))))))
                      ((and (string=? hd "define-type") (i64= (size xs) 3))
                       (let* ((name (tagcase (second xs) (lst (hs hf hl hp) (sym-name (car hs))) (else other (sym-name (second xs)))))
                              (w (with-alias v (alias name (family-params v (second xs)) (third xs)))))
                         ;; A family, a function the module describes (C173).
                         (more w (the tys (list (ty-data (string-append "%desc " name) (list (parse-fun w tv (sym name "" 0)))))))))
                      ((and (string=? hd "define-generative") (i64= (size xs) 3) (tagcase (second xs) (lst (hs hf hl hp) #t) (else other #f)))
                       "A generative family in a module value (C173): an abstract type
                        constructor, its conversions polymorphic in its parameters."
                       (let* ((name (sym-name (car (items (second xs)))))
                              (ps (family-params v (second xs)))
                              (kind (string-append "(=> (" (string-append (words-of (map binder-kind ps)) ") type)")))
                              (ref (ty-data (string-append "%fam " (string-append id (string-append ".." name))) (list (ty-data kind nil))))
                              (bs (map (lambda ((q string)) (string-append q (string-append "@g" name))) ps))
                              (app (ty-data (string-append id (string-append ".." name)) (map (lambda ((q string)) (ty-var q)) bs)))
                              (r (substitute ps (map (lambda ((q string)) (ty-var q)) bs) (parse-type v (onto ps tv) (third xs)))))
                         (more (with-binds (with-type-binds v (list (type-bind name ref)) nil)
                                           (list (local v (string-append "up-" name) (ty-data "%poly" (onto (map (lambda ((q string)) (ty-var q)) bs) (list (ty-proc nil (list r) app)))))
                                                 (local v (string-append "down-" name) (ty-data "%poly" (onto (map (lambda ((q string)) (ty-var q)) bs) (list (ty-proc nil (list app) r)))))))
                               (the tys (list (ty-data (string-append "%abs " name) (list ref)))))))
                      ((and (string=? hd "define-generative") (i64= (size xs) 3) (not (string=? n "")))
                       (let ((ref (ty-data (string-append id (string-append ".." n)) nil)) (r (parse-type v tv (third xs))))
                         (more (with-binds (with-type-binds v (list (type-bind n ref)) nil)
                                           (list (local v (string-append "up-" n) (ty-proc nil (list r) ref))
                                                 (local v (string-append "down-" n) (ty-proc nil (list ref) r))))
                               (the tys (list (ty-data (string-append "%abs " n) (list ref)))))))
                      ((and (string=? hd "define-datatype") (not (string=? n "")))
                       (let* ((vs (map items (cdr (cdr xs))))
                              (tags (map (lambda ((x sexps)) (sym-name (car x))) vs))
                              (fields (map (lambda ((x sexps)) (map (lambda ((t sexp)) (parse-type v tv t)) (cdr x))) vs))
                              (sum (ty-shape #f tags (map (lambda ((fs2 tys)) (ty-shape #t (counting-labels 1 (size fs2)) fs2)) fields))))
                         (if (any? (lambda ((x sexps)) (any? (lambda ((t sexp)) (sexp-mentions? t n)) (cdr x))) vs)
                             (refuse v "a recursive datatype in a module value, which kayak's checker has not yet (C170)")
                             (more (with-binds (with-type-binds v (list (type-bind n sum)) nil)
                                               (map2 (lambda ((t string) (fs2 tys)) (local v t (ty-proc nil fs2 sum))) tags fields))
                                   (onto (reverse (map2 (lambda ((t string) (fs2 tys)) (ty-data (string-append "%val " t) (list (ty-proc nil fs2 sum)))) tags fields))
                                         (the tys (list (ty-data (string-append "%desc " n) (list sum)))))))))
                      ((and (string=? hd "define-effect") (i64= (size xs) 3) (not (string=? n "")))
                       (let ((atoms (parse-effect v tv (third xs))))
                         (more (with-type-binds v nil (list (effdef n atoms))) (the tys (list (ty-data (string-append "%edesc " n) (list (ty-proc atoms nil (ty-unit)))))))))
                      ((and (string=? hd "include") (i64= (size xs) 2))
                       (tagcase (synth v s (second xs))
                         (res (t ies s2)
                           (if (not (mtype? (walk s2 t)))
                               (refuse v (string-append "an include of no module: a " (show-ty s2 t)))
                               (mod-types (mtype-opened v (walk s2 t)) s2 (cdr fs) id export
                                          (if export (onto (reverse (map included-item (mtype-items (walk s2 t)))) got) got) (effs-union ies es))))))
                      ((string=? hd "hide")
                       (tagcase (mod-types v s (cdr xs) id #f nil es)
                         (mres (w its2 es2 s2) (mod-types w s2 (cdr fs) id export got es2))))
                      ((or (string=? hd "define") (string=? hd "define*") (string=? hd "define-rec"))
                       (mod-types v s (cdr fs) id export got es))
                      (else (refuse v (string-append "an item kayak's checker has not yet in a module value: " (show-sexp f)))))))))

      (included-item (subr kfx (ty) ty)
        (lambda (x)
          "An included module's item, as the including module gives it: an
           abstract type of a module named elsewhere described, `(desc t
           c..t)` (Fixpt's `include-abstract-escape.fx`)."
          (if (and (string=? (mitem-kind x) "%abs") (not (tagcase (abs-ref x) (ty-data (r a) (has-prefix? r "mt@")) (else other #f))))
              (ty-data (string-append "%desc " (mitem-name x)) (list (abs-ref x)))
              x)))

      (mod-typed (subr kfx (cv sexps) binds)
        (lambda (v fs)
          "A module's values of the types written, each in scope for all."
          (concat (map (lambda ((f sexp))
                         (let ((xs (tagcase f (lst (ys f1 l1 p1) ys) (else other nil))))
                           (cond ((and (or (head-is? f "define") (head-is? f "define*")) (i64= (size xs) 4) (tagcase (second xs) (sym (m f2 p2) #t) (else other #f)))
                                  (the binds (list (local v (sym-name (second xs)) (parse-type v (cv-tvars v) (third xs))))))
                                 ((and (head-is? f "define") (i64= (size xs) 3) (tagcase (second xs) (sym (m f2 p2) #t) (else other #f)))
                                  "An item of no type written: in scope for all, as FX-26's are, but
                                   not before it is made."
                                  (the binds (list (bind (sym-name (second xs)) (scheme nil (ty-unit)) "unmade"))))
                                 ((head-is? f "define-rec")
                                  (concat (map (lambda ((g sexp)) (let ((gs (items g))) (if (i64= (size gs) 3) (the binds (list (local v (sym-name (car gs)) (parse-type v (cv-tvars v) (second gs))))) nil))) (cdr xs))))
                                 ((head-is? f "hide") (mod-typed v (cdr xs)))
                                 (else nil))))
                       fs))))

      (mod-values (subr kfx (cv st sexps bool tys strings) mres)
        (lambda (v s fs export got es)
          (if (null? fs)
              (mres v got es s)
              (let* ((f (car fs)) (xs (tagcase f (lst (ys f1 l1 p1) ys) (else other nil))) (hd (logic-head f))
                     (n (if (and (i64> (size xs) 1) (tagcase (second xs) (sym (m f2 p2) #t) (else other #f))) (sym-name (second xs)) "")))
                (cond ((and (or (string=? hd "define") (string=? hd "define*")) (i64= (size xs) 4) (not (string=? n "")))
                       (let ((t (bound-type v n)) (written (parse-type v (cv-tvars v) (third xs))))
                         (tagcase (check v s (fourth xs) t)
                           (res (u ves s2)
                             (mod-values v s2 (cdr fs) export (if export (cons (ty-data (string-append "%val " n) (list written)) got) got) (effs-union ves es))))))
                      ((and (string=? hd "define") (i64= (size xs) 3) (not (string=? n "")))
                       (tagcase (synth v s (third xs))
                         (res (t ves s2)
                           (let ((b (local v n (walk s2 t))))
                             (mod-values (with-binds v (list b)) s2 (cdr fs) export
                                         (if export (cons (ty-data (string-append "%val " n) (list (walk s2 t))) got) got)
                                         (effs-union ves es))))))
                      ((string=? hd "define-rec")
                       (mod-values v (mod-rec-checked v s (cdr xs)) (cdr fs) export
                                   (if export
                                       (onto (reverse (map (lambda ((g sexp)) (let ((gs (items g))) (ty-data (string-append "%val " (sym-name (car gs))) (list (bound-type v (sym-name (car gs))))))) (cdr xs))) got)
                                       got)
                                   es))
                      ((string=? hd "hide")
                       (tagcase (mod-values v s (cdr xs) #f nil es)
                         (mres (w its2 es2 s2) (mod-values w s2 (cdr fs) export got es2))))
                      (else (mod-values v s (cdr fs) export got es)))))))

      (mod-rec-checked (subr kfx (cv st sexps) st)
        (lambda (v s gs)
          (if (null? gs)
              s
              (let ((g (items (car gs))))
                (if (not (i64= (size g) 3))
                    (refuse v "a module value's define-rec member is (name type value)")
                    (tagcase (check v s (third g) (bound-type v (sym-name (car g))))
                      (res (u es s2) (mod-rec-checked v s2 (cdr gs)))))))))

      (synth-call (subr kfx (cv st string sexps tys) res)
        (lambda (v s h args expected)
          "A call of a name: a procedure in this group is `spin`, one that is a
           local's value is a call of a procedure not known, so `spin` too. A
           form of processes that is a call is the form, whatever the program
           binds its name to, as FX-26 parses it (C101)."
          (let ((found (if (process-call? h)
                           (scope-bind (string-append "%form " h) v)
                           (scope-bind h v))))
            (cond ((and (or (string=? h "module") (string=? h "%module-value")) (null? found))
                   (module-expr v s args))
                  ((and (string=? h "extend") (null? found) (i64= (size args) 2))
                   (module-extend v s args))
                  ((keyword? h)
                   (refuse v (string-append "(" (string-append h " ...) is FX-26's form, which KFX does not have, or a call of a local named by that keyword"))))
                  ((and (null? found) (string=? h "abort-current-continuation")) (abort-call v s args))
                  ((and (null? found) (string=? h "native-procedure")) (native-call v s args expected))
                  ((and (string=? h "seal-code") (not (null? found)) (tagcase (car found) (bind (n sc w) (string=? w "prim"))))
                   (seal-call v s args))
                  ((and (or (string=? h "string-append") (string=? h "append")) (i64> (size args) 2) (not (null? found))
                        (tagcase (car found) (bind (n sc w) (string=? w "prim"))))
                   "FX-26's `string-append` and `append` of more than two (C116), as KFX's of
                    two, each onto the rest's."
                   (synth-call v s h (list (car args) (lst (cons (sym h "" 0) (cdr args)) "" 0 0)) expected))
                  ((and (null? found) (string=? h "apply") (i64= (size args) 2))
                   "`(apply f xs)` (C71): a variadic procedure on a list's elements."
                   (tagcase (synth v s (car args))
                     (res (ft es0 s0)
                       (tagcase (walk s0 ft)
                         (ty-data (d parts)
                           (if (not (string=? d "%vsubr"))
                               (refuse v "apply of no variadic procedure")
                               (tagcase (synth v s0 (second args))
                                 (res (lt es1 s1)
                                   (tagcase (walk s1 lt)
                                     (ty-list (el r)
                                       (res (car (cdr (cdr parts)))
                                            (effs-union (tagcase (car parts) (ty-proc (e ps x) e) (else other nil))
                                                        (effs-union (list (string-append "read:" (region-string s1 r))) (effs-union es0 es1)))
                                            (let ((s2 (fits v s1 el (car (cdr parts)))))
                                              "What is expected of it, fitted here, so that a region its
                                               procedure's effect allocates at is known (C156)."
                                              (if (null? expected) s2 (fits v s2 (car (cdr (cdr parts))) (car expected))))))
                                     (else other (refuse v "apply of a variadic procedure to no list")))))))
                         (else other (refuse v "apply of no variadic procedure"))))))
                  ((and (or (string=? h "null?") (string=? h "pair?")) (i64= (size args) 1) (not (null? found))
                        (tagcase (car found) (bind (n sc w) (string=? w "prim")))
                        (tagcase (car args)
                          (sym (n f p)
                            (let ((b (scope-bind n v)))
                              (and (not (null? b))
                                   (tagcase (car b) (bind (n2 sc w) (tagcase sc (scheme (tv t)
                                     (string-member? (shape-of (walk s t)) (list "union" "pair" "nil")))))))))
                          (lst (ys f l p)
                            "Or a call of a global whose result is declared so (C119:
                             Fixpt's `table-has?`, `(null? (table-entry t key))`)."
                            (and (not (null? ys))
                                 (tagcase (car ys)
                                   (sym (n f2 p2)
                                     (let ((b (scope-bind n v)))
                                       (and (not (null? b))
                                            (tagcase (car b) (bind (n2 sc w)
                                              (and (not (string=? w "prim"))
                                                   (tagcase sc (scheme (tv t)
                                                     (tagcase t
                                                       (ty-proc (es ps r) (string-member? (shape-of (walk s r)) (list "union" "pair" "nil")))
                                                       (else other #f))))))))))
                                   (else other #f))))
                          (else other #f)))
                   "FX-26's `null?` and `pair?` of any value (C68): of a local of a
                    union, a pair or `nil`, which KFX's, of a list, would not take."
                   (tagcase (synth v s (car args))
                     (res (t es s2) (res (ty-bool) es (if (valued? s2 t) (note-fact s2 (cv-file v) (cv-pos v) "union-test") s2)))))
                  ((and (or (string=? h "car") (string=? h "cdr")) (i64= (size args) 1) (not (null? found))
                        (tagcase (car found) (bind (n sc w) (string=? w "prim")))
                        (let ((ct (chain-type v s (car args)))) (and (not (null? ct)) (not (null? (pair-member s (car ct)))))))
                   "Of a union with a pair, or of a pair of a union's (C77): taken
                    apart as FX-26 takes it, checked at run time, a `Value` in Rust,
                    unboxed if its part is no union; the part fitted to the type
                    expected (C87: it had not been, and a union went where an
                    `int` was wanted, which `unions/paths-untested.fx` refuses)."
                   (tagcase (synth v s (car args))
                     (res (t es s1)
                       (let ((ps (pair-member s1 t)))
                         (if (null? ps)
                             (refuse v (string-append "a car or cdr of what has no pair: " (show-ty s1 t)))
                             (tagcase (car ps)
                               (ty-data (d parts)
                                 (let* ((part (if (string=? h "car") (car parts) (car (cdr parts))))
                                        (s2 (if (null? expected) s1 (fits v s1 part (car expected)))))
                                   (res part
                                        (effs-union (list (string-append "read:" (region-string s2 (car (cdr (cdr parts)))))) es)
                                        (coerced v (note-fact s2 (cv-file v) (cv-pos v) "value-call") (cv-file v) (cv-pos v) (ty-data "datum" nil) part))))
                               (else other (refuse v "a pair that is none"))))))))
                  ((and (or (string=? h "car") (string=? h "cdr")) (i64= (size args) 1) (not (null? (local-pair v s (car args)))))
                   "Of a local known to be a pair (C68): its head or its tail, of any
                    type, not only a list's."
                   (tagcase (car (local-pair v s (car args)))
                     (ty-data (d parts)
                       (res (if (string=? h "car") (car parts) (car (cdr parts)))
                            (list (string-append "read:" (region-string s (car (cdr (cdr parts))))))
                            (tagcase (car args)
                              (sym (n f p) (narrowing-unboxed v s n f p (car (local-pair v s (car args)))))
                              (else other s))))
                     (else other (refuse v "a pair that is none"))))
                  ((and (string=? h "cons") (i64= (size args) 2) (not (null? expected)) (not (null? (pair-expected s (car expected)))))
                   "Where a pair is expected (C68): its head and tail checked against
                    its own, of any types."
                   (tagcase (car (pair-expected s (car expected)))
                     (ty-data (d parts)
                       (tagcase (check v s (car args) (car parts))
                         (res (t1 es1 s1)
                           (tagcase (check v s1 (second args) (car (cdr parts)))
                             (res (t2 es2 s2)
                               (res (car (pair-expected s (car expected)))
                                    (effs-union (list (string-append "alloc:" (region-string s2 (car (cdr (cdr parts)))))) (effs-union es1 es2))
                                    (if (general-pair? s2 (car (pair-expected s (car expected))))
                                        (note-fact s2 (cv-file v) (cv-pos v) "value-cons")
                                        s2)))))))
                     (else other (refuse v "a pair that is none"))))
                  ((and (null? found) (string=? h "abort-with-continuation")) (suspend-call v s args expected))
                  ((and (null? found) (string=? h "make-continuation-prompt-tag")) (make-tag-call v s args expected))
                  ((and (null? found) (string=? h "escape")) (escape-call v s args))
                  ((and (null? found) (or (string=? h "rcons") (string=? h "rnew") (string=? h "rmake-array"))) (region-alloc-call v s h args expected))

                  ((null? found)
                   (refuse v (string-append "nothing is named " h)))
                  ((and (or (string=? h "+") (string=? h "-")) (prim? (car found)) (i64= (size args) 2) (not (null? expected))
                        (sized? (walk s (car expected)) "%natof"))
                   "A sum or a difference where `(nat s)` is wanted: shown to be `s` (C158)."
                   (let ((a (linear-of v s (car args))) (b (linear-of v s (second args))) (z (size-lin s (sized-size (walk s (car expected))))))
                     (if (and (not (null? a)) (not (null? b)) (not (null? z))
                              (let ((d (lin-add (lin-add (car a) (car b) (if (string=? h "+") 1 -1)) (car z) -1)))
                                (and (size-shown? v s d) (size-shown? v s (lin-scaled d -1)))))
                         (tagcase (call-args v s args (list (ty-int) (ty-int)) nil)
                           (res (u es s) (res (walk s (car expected)) es s)))
                         (refuse-named v s (string-append "a " (string-append h (string-append " here, where a " (string-append (show-ty s (car expected)) " is expected, not shown to be one"))))))))
                  ((and (string=? h "cons") (prim? (car found)) (i64= (size args) 2) (not (null? expected)) (sized? (walk s (car expected)) "%nlist"))
                   "`cons` where a list of size `s` is wanted, frozen: its head the
                    element, its tail of size `s - 1`, `s` shown not 0 (C158)."
                   (let* ((t (walk s (car expected))) (z (size-lin s (sized-size t))))
                     (if (and (not (null? z)) (not (size-shown? v s (lin-add (car z) (lin -1 nil) 1))))
                         (refuse-named v s (string-append "a cons where a " (string-append (show-ty s t) " is expected, its size not shown to be one or more")))
                         (tagcase (call-args v s args (list (sized-elem t) (sized-less t s)) nil)
                           (res (u es s) (res t es s))))))
                  ((and (or (string=? h "cdr") (string=? h "length")) (prim? (car found)) (i64= (size args) 1) (not (null? (nlist-type v s (car args)))))
                   "A list of size `n`'s `cdr`, of `n - 1` if `n >= 1` is shown, and its
                    `length`, a `(nat n)` (C158)."
                   (let ((t (car (nlist-type v s (car args)))))
                     (tagcase (call-args v s args (list t) nil)
                       (res (u es s)
                         (let ((r (if (string=? h "cdr") (cdr-size v s t) (ty-data "%natof" (list (sized-size t))))))
                           (res (if (and (string=? h "length") (size-finite? s (sized-size t))) (ty-nat) r) es (if (null? expected) s (fits v s r (car expected)))))))))
                  ((and (string=? h "-") (prim? (car found)) (i64= (size args) 2) (not (null? expected)) (nat? s (car expected))
                        (let ((a (linear-of v s (car args))) (b (linear-of v s (second args))))
                          (and (not (null? a)) (not (null? b)) (size-shown? v s (lin-add (car a) (car b) -1)))))
                   "A difference where a `nat` is expected, which the facts in scope
                    show is not negative (C157)."
                   (tagcase (call-args v s args (list (ty-int) (ty-int)) nil)
                     (res (u es s) (res (ty-nat) es s))))
                  ((and (nat-op? h) (prim? (car found)) (i64= (size args) 2) (nat-args? v s args))
                   (tagcase (call-args v s args (list (ty-nat) (ty-nat)) nil)
                     (res (u es s)
                       (res (ty-nat) es (if (null? expected) s (fits v s (ty-nat) (car expected)))))))
                  (else
                  (tagcase (car found)
                    (bind (n sc wher)
                      (let* ((s (held v s h found (process-marks (cv-tvars v))))
                             (from (st-next s)))
                      (tagcase (named-instance v s sc)
                        (inst (t s regions effects)
                          (cwcc-fresh-masked v h wher
                          (place-needed v h wher sc from
                          (regions-freshened v h wher regions
                          (static-instance v h wher (binder-metas from (st-next s) (onto effects regions))
                          (poly-settled v h wher args (binder-metas from (st-next s) (onto effects regions)) (result-only? s t (binder-metas from (st-next s) (onto effects regions)))
                          (void-call v (and (string=? h "error") (string=? wher "prim"))
                                     (and (not (null? expected)) (tagcase (walk s (car expected)) (ty-meta (k) #t) (else other #f)))
                          (mark-lifted v (if (string=? wher "prim") h "") args
                          (poly-self-application v sc t (knot-free-call v (synth-call-of v s (res t nil (head-unboxed v s h wher t)) args regions expected
                                         (effs-union
                                           (if (string=? wher "prim") (cwcc-spin h args) nil)
                                           (effs-union
                                           (if (string=? wher "global") (list (string-append "g:" h)) nil)
                                           (if (or (string=? wher "rec")
                                                   (and (or (string=? wher "local") (string=? wher "narrowed")) (self-applicable? v s t))
                                                   (and (string-member? h (cv-group v)) (or (string=? wher "global") (string=? wher "item"))))
                                               (list "spin")
                                               nil)))))))))))))))))))))))

      (cwcc-fresh-masked (subr kfx (cv string string res) res)
        (lambda (v h wher r)
          "A call of `cwcc` itself, its region one nothing names, fresh (C168):
           its control there masked, as Fixpt's."
          (if (and (string=? h "cwcc") (string=? wher "prim"))
              (tagcase r
                (res (t es s)
                  (res t (filter (lambda ((a string))
                                   (let ((x (resolve-atom s a)))
                                     (not (and (or (has-prefix? x "goto:") (has-prefix? x "comefrom:"))
                                               (or (string-has? x ":?") (string=? x "goto:acyclic") (string=? x "comefrom:acyclic"))))))
                                 es)
                       s)))
              r)))

      (cwcc-masked (subr kfx (cv sexp sexps res) res)
        (lambda (v head args r)
          "A `cwcc` at region `R` (`(proj cwcc R)`) whose receiver can only leave
           (C168): its continuation is called only while it runs, so its
           `comefrom R` and `goto R` stay within the call, masked, as Fixpt's."
          (if (and (head-is? head "proj") (string=? (proj-base v head) "cwcc") (escape-only? args))
              (let ((reg (proj-innermost-arg head)))
                (tagcase reg
                  (sym (n f p)
                    (tagcase r
                      (res (t es s) (res t (filter (lambda ((a string)) (not (or (string=? a (string-append "goto:" n)) (string=? a (string-append "comefrom:" n))))) es) s))))
                  (else other r)))
              r)))

      (proj-innermost-arg (subr kfx (sexp) sexp)
        (lambda (e)
          "The first argument of the innermost of a chain of `proj`s."
          (if (head-is? (second (items e)) "proj")
              (proj-innermost-arg (second (items e)))
              (if (i64> (size (items e)) 2) (third (items e)) e))))

      (proj-base (subr kfx (cv sexp) string)
        (lambda (v e)
          "The primitive a chain of `proj`s instantiates, if it is one, or none."
          (cond ((head-is? e "proj") (proj-base v (second (items e))))
                (else (tagcase e
                        (sym (n f p)
                          (let ((found (scope-bind n v)))
                            (if (and (not (null? found)) (tagcase (car found) (bind (m sc w) (string=? w "prim")))) n "")))
                        (else other ""))))))

      (mark-lifted (subr kfx (cv string sexps res) res)
        (lambda (v h args r)
          "A procedure kept in a mark (C106) is, in Rust, the one form whatever
           its effect, a future's (`(subr e ...)`, `e` a variable, as generic
           code has it): so `with-mark`'s value and `first-mark`'s default,
           where their key's type says a procedure that cannot suspend, are
           lifted to it (`lift-suspend N`, or `-fallible` if what is given
           returns a `Result`), and `first-mark`'s value, there, run to its end
           where it is called (`mark-unlift N`, or `-fallible`, by the key's
           effect)."
          (if (or (not (string-member? h (list "with-mark" "first-mark"))) (i64< (size args) 2))
              r
              (tagcase r
                (res (t es s)
                  (tagcase (synth v s (car args))
                    (res (kt kes ks)
                      (let ((parts (tagcase (walk ks kt) (ty-data (d ps) (if (string=? d "%mark-key") ps nil)) (else other nil))))
                        (if (null? parts)
                            r
                            (tagcase (walk ks (car parts))
                              (ty-proc (pes ps pr)
                                (let ((pes (map (lambda ((a string)) (resolve-atom ks a)) pes)))
                                  (if (suspends? pes)
                                      r
                                      (tagcase (synth v ks (second args))
                                        (res (gt ges gs)
                                          (let* ((n (i64->string (size ps)))
                                                 (given-fallible (tagcase (walk gs gt)
                                                                   (ty-proc (ges2 ps2 r2) (escapes? (map (lambda ((a string)) (resolve-atom gs a)) ges2)))
                                                                   (else other #f)))
                                                 (s (note-fact s (datum-file (second args)) (datum-pos (second args))
                                                               (string-append (if given-fallible "lift-suspend-fallible " "lift-suspend ") n)))
                                                 (s (if (string=? h "first-mark")
                                                        (note-fact s (cv-file v) (cv-pos v) (string-append (if (escapes? pes) "mark-unlift-fallible " "mark-unlift ") n))
                                                        s)))
                                            (res t es s)))))))
                              (else other r)))))))))))

      (static-instance (subr kfx (cv string string (listof i64 acyclic) res) res)
        (lambda (v h wher metas r)
          "A procedure's call at types, each a Rust type parameter `A: Copy +
           'static`: none may be at a region with a lifetime, a `letrena`'s, a
           place's, a region binder's (C42), which `'static` is not."
          (tagcase r
            (res (t es s)
              (if (and (or (string=? wher "global") (string=? wher "item") (string=? wher "rec"))
                       (any? (lambda ((k i64)) (region-var-in? s (ty-meta k))) metas))
                  (refuse v (string-append "a call of " (string-append h " at a type over a region with a lifetime, where its Rust type parameter is 'static (C42)")))
                  r)))))

      (regions-freshened (subr kfx (cv string string (listof i64 acyclic) res) res)
        (lambda (v h wher regions r)
          "A poly's call: a region binder its arguments and what its place
           expects did not say made fresh, as FX-26 makes it (its
           `default_regions`): a list made by `cons` and found by itself is at a
           region of its own, not one a later use may choose."
          (tagcase r
            (res (t es s)
              (res t es
                   (letrec ((go (subr kfx (st (listof i64 acyclic)) st)
                                  (lambda (s ks)
                                    (if (null? ks)
                                        s
                                        (go (tagcase (walk s (ty-meta (car ks))) (ty-meta (k) (solve s k (ty-rconst "%fresh"))) (else other s))
                                            (cdr ks))))))
                     (go s regions)))))))

      (place-needed (subr kfx (cv string string scheme i64 res) res)
        (lambda (v h wher sc from r)
          "A call of a procedure given places (C34): what it makes in each, its
           `place-needs`, noted at the call as needs of the place it is given,
           `rneed-kind@'r T`, `T` at the types it is called at."
          (if (or (not (string=? wher "global")) (not (given-place? sc)))
              r
              (tagcase r
                (res (t es s)
                  (tagcase sc
                    (scheme (tvars ty)
                      (let ((needs (facts-after (cv-facts v) (string-append "place-needs " (string-append h " ")))))
                        (begin
                          (bounds-kept v s h (lambda ((x string)) (instantiated tvars from (ty-var x))))
                          (res t es (note-needs v s tvars from needs)))))))))))

      (note-needs (subr kfx (cv st strings i64 strings) st)
        (lambda (v s tvars from needs)
          (if (null? needs)
              s
              (let* ((ws (read-all (string-chars (car needs)) "" 1))
                     (place (sym-name (car ws)))
                     (kind (sym-name (second ws)))
                     (need (instantiated tvars from (parse-type v (onto (map (lambda ((x string)) (string-append "%place " x)) tvars) tvars) (third ws))))
                     (at (instantiated tvars from (ty-var place))))
                (note-needs v (note-types s (cv-file v) (cv-pos v) (string-append "rneed-" (string-append kind (string-append "@" (region-string s at)))) (list need))
                            tvars from (cdr needs))))))

      (instantiated (subr kfx (strings i64 ty) ty)
        (lambda (tvars from t)
          "`t`, a callee's, its binders replaced by the inference variables its
           call made for them, from `from` on, in order."
          (if (null? tvars) t (instantiated (cdr tvars) (i64+ from 1) (replace-var (car tvars) (ty-meta from) t)))))

      (result-only? (subr kfx (st ty (listof i64 acyclic)) bool)
        (lambda (s t ks)
          "Whether a type binder of a procedure, `ks` as instantiated in `t`, is
           in none of its parameters' types: its result's alone, which rustc
           infers from no argument."
          (tagcase (walk s t)
            (ty-proc (es ps r) (any? (lambda ((k i64)) (not (any? (lambda ((p ty)) (occurs? s k p)) ps))) ks))
            (else other #f))))

      (poly-settled (subr kfx (cv string string sexps (listof i64 acyclic) bool res) res)
        (lambda (v h wher args ks fish r)
          "A poly's call: its type binders, `ks`, each solved by the call, as
           FX-26 has them (its arguments and what the call's place expects; not
           what follows), but `null?`'s of a name or an `error`, whose binder in
           FX-26 is its argument's type whole; and the types a procedure of the
           program's is called at noted, for the turbofish, where a binder is
           its result's alone."
          (tagcase r
            (res (t es s)
              (let ((open (any? (lambda ((k i64)) (tagcase (walk s (ty-meta k)) (ty-meta (j) #t) (else other #f))) ks)))
               (begin
                (cond ((and (or (string=? h "car") (string=? h "cdr")) (string=? wher "prim") (not (null? args))
                            (or (head-is? (car args) "error")
                                (tagcase (car args)
                                  (sym (n f p)
                                    (let ((found (scope-bind n v)))
                                      (and (not (null? found))
                                           (tagcase (car found) (bind (m sc w) (tagcase sc (scheme (tv x) (void? s x))))))))
                                  (else other #f))))
                       "FX-26's `car` and `cdr` are over a pair, `(pairof t1 t2 r)`: of a
                        `void`, what the expected type does not say of the pair, nothing
                        does."
                       (refuse v (string-append "a type " (string-append h " is called at that nothing here says, as FX-26 finds it: say it, (the T ...)"))))
                      ((and open
                            (not (and (string=? h "null?") (string=? wher "prim") (not (null? args))
                                      (or (tagcase (car args) (sym (n f p) #t) (else other #f)) (head-is? (car args) "error")))))
                       (refuse v (string-append "a type " (string-append h " is called at that nothing here says, as FX-26 finds it: say it, (the T ...)"))))
                      (open "`null?`'s, written at the type FX-26 leaves open: `void`."
                            (res t es (note-turbofish s (cv-file v) (cv-pos v) (map (lambda ((k i64)) (ty-meta k)) ks))))
                      ((or (string=? wher "prim") (null? ks) (not fish)) r)
                      (else (res t es (note-turbofish s (cv-file v) (cv-pos v) (map (lambda ((k i64)) (ty-meta k)) ks)))))))))))

      (nat-args? (subr kfx (cv st sexps) bool)
        (lambda (v s args)
          "Whether each argument is a `nat` FX-26 keeps one through a sum: a
           literal not negative, a name of a `nat`, or such a sum itself; not a
           call's value or a `the`'s, a plain `nat`, which FX-26's `+` makes an
           `int` (each literal is its own `(nat v)` to it). The finding is a
           test, its state dropped."
          (or (null? args)
              (and (tagcase (car args)
                     (num (k f p) (and (not (i64< k 0)) (not (i64> k 1152921504606846975))))
                     (big (text f p) #f)
                     (sym (n f p) (and (not (draft-hole? (car args))) (tagcase (synth v s (car args)) (res (t es s2) (nat? s2 t)))))
                     (lst (xs f l p)
                       (and (head-is? (car args) "+") (not (null? (scope-bind "+" v)))
                            (tagcase (car (scope-bind "+" v)) (bind (n sc w) (string=? w "prim")))
                            (nat-args? v s (cdr xs))))
                     (else other #f))
                   (nat-args? v s (cdr args))))))

      (native-call (subr kfx (cv st sexps tys) res)
        (lambda (v s args expected)
          "`(native-procedure c)` (C116, Fixpt's TODO §97): a native closure of
           code `seal-code` gave, trusted to be of the type expected, as `the`
           says it, which must be a procedure of the native convention. Named
           only as a call's operator, as FX-26 has it. What crosses into the
           code and back is only what kayak's values and Fixpt's lay out alike
           (kayak-rt's `Native`), of a bloblet of no fields, so stricter than
           FX-26."
          (let ((want (if (null? expected) (ty-unit) (walk s (car expected)))))
            (cond ((not (i64= (size args) 1)) (refuse v "native-procedure takes code seal-code gave"))
                  ((null? expected)
                   (refuse v "a native-procedure whose type is not known here: write it, (the (subr (conv native) E (T ...) R) (native-procedure c))"))
                  ((not (tagcase want (ty-data (d xs) (string=? d "%native")) (else other #f)))
                   (refuse v (string-append "native-procedure of a type not of the native convention: " (show-ty s want))))
                  (else
                   (tagcase want
                     (ty-data (d xs)
                       (tagcase (car xs)
                         (ty-proc (es ps r)
                           (cond ((i64> (size ps) 4) (refuse v "a native procedure of more than four parameters, which KFX does not have yet (C116)"))
                                 ((or (not (native-crossing? s r)) (any? (lambda ((t ty)) (not (native-given? s t))) ps))
                                  (refuse v (string-append "a native procedure KFX cannot call yet: only integers, booleans, unit, characters, strings, lists of them and bloblets of them cross between kayak's values and native code, and procedures of the fx convention given it (C116): "
                                                           (show-ty s want))))
                                 ((or (escapes? es) (suspends? es))
                                  (refuse v (string-append "a native procedure that may abort or suspend, which KFX does not have: " (show-ty s want))))
                                 (else
                                  (tagcase (synth v s (car args))
                                    (res (t es0 s0)
                                      (if (tagcase (walk s0 t) (ty-data (d2 ys) (string=? d2 "%bloblet")) (else other #f))
                                          (res want (effs-union (list "io:native") es0)
                                               (note-fact s0 (cv-file v) (cv-pos v)
                                                          (string-append "native-types "
                                                            (show-sexp (lst (map (lambda ((p ty)) (ty-sexp v s0 (zonk s0 p))) (onto ps (list r))) "" 0 0)))))
                                          (refuse v (string-append "native-procedure of what is not a bloblet: " (show-ty s0 t)))))))))
                         (else other (refuse v "native-procedure of a type not of the native convention"))))
                     (else other (refuse v "native-procedure of a type not of the native convention"))))))))

      (seal-call (subr kfx (cv st sexps) res)
        (lambda (v s args)
          "`(seal-code b)` (C116, Fixpt's TODO §97): a copy of bloblet `b` in the
           code area, of its type. Its fields are beside its code, as Fixpt's,
           so each must be what kayak lays out as Fixpt does (`native-given?`):
           stricter than FX-26, whose type for it is any `a`."
          (if (not (i64= (size args) 1))
              (refuse v "seal-code takes a bloblet")
              (tagcase (synth v s (car args))
                (res (t es s0)
                  (tagcase (walk s0 t)
                    (ty-data (d ys)
                      (cond ((not (string=? d "%bloblet"))
                             (refuse v (string-append "seal-code of what is not a bloblet, which KFX does not have: " (show-ty s0 t))))
                            ((any? (lambda ((f ty)) (not (native-given? s0 f))) (cdr ys))
                             (refuse v (string-append "seal-code of a bloblet whose fields native code cannot read in kayak yet (C116): " (show-ty s0 t))))
                            (else (res t (effs-union (list "io:native") es) s0))))
                    (else other (refuse v (string-append "seal-code of what is not a bloblet, which KFX does not have: " (show-ty s0 t))))))))))

      (abort-call (subr kfx (cv st sexps) res)
        (lambda (v s args)
          "`(abort-current-continuation tag v)`: to the innermost prompt of
           `tag`, with `v`; a `goto` on the tag's region, and of type `void`."
          (if (not (i64= (size args) 2))
              (refuse v "abort-current-continuation takes a tag and a value")
              (tagcase (synth v s (car args))
                (res (t es0 s)
                  (tagcase (walk s t)
                    (ty-tag (a h d r)
                      (tagcase (check v s (second args) h)
                        (res (u es1 s)
                          (res (ty-void) (effs-union (list (string-append "goto:" (region-string s r))) (effs-union es0 es1)) s))))
                    (else other (refuse v (string-append "an abort to a " (string-append (show-ty s t) ", no prompt-tag"))))))))))

      (escape-call (subr kfx (cv st sexps) res)
        (lambda (v s args)
          "`(escape tag v)` (C105): to the innermost prompt of the escape-only
           `tag`, with `v`, as an abort is to a prompt tag's; of type `void`."
          (if (not (i64= (size args) 2))
              (refuse v "escape takes a tag and a value")
              (tagcase (synth v s (car args))
                (res (t es0 s)
                  (let ((parts (escape-tag-parts s t)))
                    (if (null? parts)
                        (refuse v (string-append "an escape to a " (string-append (show-ty s t) ", no escape-tag")))
                        (tagcase (check v s (second args) (car (cdr parts)))
                          (res (u es1 s)
                            (res (ty-void) (effs-union (list (string-append "goto:" (region-string s (car (cdr (cdr parts)))))) (effs-union es0 es1))
                                 (note-fact s (cv-file v) (cv-pos v) "control")))))))))))

      (suspend-call (subr kfx (cv st sexps tys) res)
        (lambda (v s args expected)
          "`(abort-with-continuation tag (lambda ((k K)) body))` (kfx/prelude.fx,
           C45): the rest up to `tag`'s prompt, `k`, resumable once, of `K`, a
           `(subr (maxeff D (goto R) (comefrom R) (read R) (write R)) (V) A)`
           for the tag's `(prompt-tag A H D R)`; an abort there with `body`'s
           value, an `H`. Its value is a `V`, what `k` is resumed with; its
           effect, the body's, control and allocation at `R`, and the prelude's
           global read. The body runs as the prompt takes `k`: KFX has it
           neither abort nor suspend."
          (cond ((not (i64= (size args) 2))
                 (refuse v "abort-with-continuation takes a tag and a lambda"))
                ((not (and (head-is? (second args) "lambda") (i64= (size (items (second (items (second args))))) 1)))
                 (refuse v "abort-with-continuation's second argument is a lambda of one parameter, in KFX"))
                (else
                 (tagcase (synth v s (car args))
                   (res (tt es0 s)
                     (tagcase (walk s tt)
                       (ty-tag (a h d r)
                         (let* ((rn (region-string s r))
                                (lam (items (second args)))
                                (param (car (items (second lam)))))
                           (tagcase param
                                 (lst (pt pf pl pp)
                                   (let ((kt (parse-type v (cv-tvars v) (second pt))))
                                     (tagcase (walk s kt)
                                       (ty-proc (kes kps ka)
                                         (if (not (i64= (size kps) 1))
                                             (refuse v "a continuation takes one value")
                                             (let* ((want (effs-union d (list (string-append "goto:" rn) (string-append "comefrom:" rn)
                                                                              (string-append "read:" rn) (string-append "write:" rn))))
                                                    (s (fits v s ka a)))
                                               (if (not (and (effs-within? kes want) (effs-within? want kes)))
                                                   (refuse v (string-append "the continuation's effect is the tag's bound, and control, reading and writing at its region: "
                                                                            (string-append (show-effs want) (string-append ", not " (show-effs kes)))))
                                                   (tagcase (lambda-effects v s (items (second lam)) (cdr (cdr lam)) (ty-proc nil (list kt) h))
                                                     (res (u es1 s)
                                                       (if (escapes? es1)
                                                           (refuse v "abort-with-continuation's lambda may abort or suspend, which KFX has not")
                                                           (let ((s (if (null? expected) s (fits v s (car kps) (car expected)))))
                                                             (res (car kps)
                                                                  (effs-union (list (string-append "goto:" rn) (string-append "comefrom:" rn)
                                                                                    (string-append "alloc:" rn) "g:abort-with-continuation")
                                                                              (effs-union es0 es1))
                                                                  s)))))))))
                                       (else other (refuse v "a continuation's type is a subr")))))
                                 (else other (refuse v "abort-with-continuation's parameter is written (k K), its type said")))))
                       (else other (refuse v (string-append "a suspension to a " (string-append (show-ty s tt) ", no prompt-tag")))))))))))

      (make-tag-call (subr kfx (cv st sexps tys) res)
        (lambda (v s args expected)
          "`(make-continuation-prompt-tag)`: its type, said where it is made."
          (cond ((not (null? args)) (refuse v "make-continuation-prompt-tag takes nothing"))
                ((null? expected)
                 (refuse v "a prompt tag whose type nothing says: write (the (prompt-tag A H D R) (make-continuation-prompt-tag))"))
                (else
                 (tagcase (walk s (car expected))
                   (ty-tag (a h d r) (res (car expected) (list (string-append "alloc:" (region-string s r))) s))
                   (else other (refuse v "a prompt tag where none is expected")))))))

      (prompt-form (subr kfx (cv st sexps tys) res)
        (lambda (v s xs expected)
          "`(prompt tag body handler)`, as FX-26 has it: the body of the tag's
           answer type, its effect, but for control on the tag's region, within
           the tag's bound; an abort to the tag runs the handler. The prompt
           removes the `goto` on the region when the body can reach no other tag
           there: when nothing it names but the tag has a type that mentions the
           region (every name, bound in it or not: stricter than FX-26's free
           variables, never laxer)."
          (tagcase (synth v s (car xs))
            (res (tt es0 s)
              (tagcase (as-prompt-tag s tt)
                (ty-tag (a h d r)
                  (let ((rn (region-string s r)))
                    (tagcase (check v s (second xs) a)
                      (res (u es1 s)
                        (if (and (not (escape-tag? s tt)) (not (effs-within? (masked-goto es1 rn) d)))
                            (refuse v (string-append "the tag allows its delimited computations " (string-append (show-effs d)
                                      (string-append ", and this body also has " (show-effs (masked-goto es1 rn))))))
                            (tagcase (handler-of v s (third xs) h a)
                              (res (u2 es2 s)
                                (let* ((delimits (not (reaches? v s (second xs) (car xs) rn)))
                                       (s (if delimits (note-fact s (cv-file v) (cv-pos v) "delimits") s))
                                       (s (if (and delimits (not (escapes? (masked-goto es1 rn))))
                                              (note-fact s (cv-file v) (cv-pos v) "contains")
                                              s))
                                       (s (if (suspends? es1) (note-fact s (cv-file v) (cv-pos v) "suspending-body") s))
                                       (s (if (null? expected) s (fits v s a (car expected)))))
                                  (res a (effs-union es0 (effs-union es2 (if delimits (masked-goto es1 rn) es1))) s)))))))))
                (else other (refuse v (string-append "a prompt of a " (string-append (show-ty s tt) ", no prompt-tag")))))))))

      (poly-type? (subr kfx (st ty) bool)
        (lambda (s t) (tagcase (walk s t) (ty-data (d args) (string=? d "%poly")) (else other #f))))

      (plambda-form (subr kfx (cv st sexps ty) res)
        (lambda (v s xs expected)
          "`(plambda ((r region) ...) (lambda ...))` where a poly type is expected
           (rank 2, C107): the lambda checked against the type's body, its
           binders the plambda's regions, rigid, in scope; none may be named as
           one in scope already, nor escape into a type found outside it."
          (let* ((args (tagcase (walk s expected) (ty-data (d args) args) (else other nil)))
                 (names (map (lambda ((b sexp))
                               (if (tagcase b (lst (ys f l p) (i64= (size ys) 2)) (else other #f))
                                   (let ((k (second (items b))) (n (sym-name (car (items b)))))
                                     (cond ((sym-is? k "region") (string-append "'" n))
                                           ((sym-is? k "size") (string-append "#" n))
                                           ((sym-is? k "type") n)
                                           ((head-is? k "=>") (binder-named (kind-text v k) n))
                                           (else (refuse v "a plambda where a poly type is expected binds regions, types and sizes (C107)"))))
                                   (refuse v "a plambda where a poly type is expected binds regions, types and sizes (C107)")))
                             (items (car xs))))
                 (s (if (all-regions? names) s (kfx-restricted v s "a plambda of types or sizes where a poly type is expected, which KFX has not yet: its Rust erases regions alone (C107)"))))
            (cond ((not (i64= (size names) (size (poly-binders-of args))))
                   (refuse v "a plambda of as many regions as the poly type expected"))
                  ((and (any? (lambda ((n string)) (string-member? n (cv-tvars v))) names) (all-regions? names))
                   (refuse v "a plambda's binder named as one in scope already, which KFX does not take (C107)"))
                  (else
                   (let ((before (st-next s)))
                     (tagcase (check (with-tvars v names) s (second xs) (poly-instance args (map (lambda ((n string)) (ty-var n)) names)))
                       (res (t es s2)
                         (if (any? (lambda ((k i64)) (any? (lambda ((n string)) (mentions? s2 (ty-meta k) n)) names))
                                   ;; What could carry a binder out: the type expected, and the
                                   ;; locals in scope (C173: another plambda's binder of the
                                   ;; same name, in a meta of its own, is not this one's).
                                   (filter (lambda ((k i64)) (i64< k before))
                                           (onto (metas-of (ty-data "%poly" args))
                                                 (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (if (string=? w "local") (tagcase sc (scheme (tv u) (metas-of u))) nil))))
                                                              (cv-binds v))))))
                             (refuse v "a plambda's region escapes it, in a type found outside it")
                             (res expected es s2))))))))))

      (escape-tag-parts (subr kfx (st ty) tys)
        (lambda (s t)
          "An escape-only tag's answer, payload and region, or none."
          (tagcase (walk s t)
            (ty-data (d args) (if (string=? d "%escape-tag") args nil))
            (else other nil))))

      (escape-tag? (subr kfx (st ty) bool)
        (lambda (s t) (not (null? (escape-tag-parts s t)))))

      (as-prompt-tag (subr kfx (st ty) ty)
        (lambda (s t)
          "A tag as a prompt sees it: an escape-only tag as a prompt tag that
           bounds nothing (its `D` unused, C105)."
          (let ((parts (escape-tag-parts s t)))
            (if (null? parts)
                (walk s t)
                (ty-tag (car parts) (car (cdr parts)) nil (car (cdr (cdr parts))))))))

      (handler-of (subr kfx (cv st sexp ty ty) res)
        (lambda (v s e h a)
          "A prompt's handler, a lambda from the payload to the answer: its
           body's effect is the prompt's, since the prompt calls it. One that
           may abort or suspend is noted so, as any lambda is, and its call is
           `?`ed and awaited (C46)."
          (if (not (head-is? e "lambda"))
              ;; A procedure given, as FX-26 takes one (C107): of the payload to
              ;; the answer, called by the prompt, so its latent effect the
              ;; prompt's; noted as a lambda would be, for the emitter's call.
              (tagcase (synth v s e)
                (res (t es0 s)
                  (tagcase (walk s t)
                    (ty-proc (les ps r)
                      (if (not (i64= (size ps) 1))
                          (refuse v "a prompt's handler takes one value, the payload")
                          (let* ((s (fits v (fits v s h (car ps)) r a))
                                 (les (map (lambda ((x string)) (resolve-atom s x)) les))
                                 (s (if (escapes? les) (note-fact s (datum-file e) (datum-pos e) "fallible") s))
                                 (s (if (suspends? les) (note-fact s (datum-file e) (datum-pos e) "suspends") s)))
                            (res a (effs-union les es0) s))))
                    (else other (refuse v (string-append "a prompt's handler of a " (string-append (show-ty s t) ", no procedure")))))))
              (let ((lam (items e)))
                (tagcase (lambda-effects v s (items (second lam)) (cdr (cdr lam)) (ty-proc nil (list h) a))
                  (res (u es s)
                    (res a es (tagcase e (lst (xs f l p) (noted-lambda (near v f l p) s es)) (else other s)))))))))

      (synth-call-of (subr kfx (cv st res sexps (listof i64 acyclic) tys strings) res)
        (lambda (v s callee args regions expected more)
          "A call of the procedure `callee` is: its result fitted to the type
           `expected`, if one is, then its arguments checked against its
           parameters, in order (a `list` given for a parameter whose type is an
           instance's found by itself, as FX-26 finds it); its effect, the callee's latent effect, the
           arguments' and `more`. In order, not lambdas last as FX-26 does,
           since rustc finds a closure's parameter types only from what comes
           before it: see `check-written-params`. A procedure expected bounds
           the result from above, as FX-26 has it: fitted after the arguments,
           which say what it is, one that cannot abort then lifted (C35). A
           list it makes, found by itself, at a region nothing said is at a
           fresh one, as FX-26's is: not one a later use may choose (C36)."
          (tagcase (poly-callee callee)
            (res (t es0 s)
              (let ((args (if (string=? (cv-file v) "<draft>") (through-hole args) args)))
              (tagcase (vsubr-as-proc (composable-as-proc s (dep-substituted v s (walk s t) args)) (size args))
                (ty-proc (latent ps r)
                  (cond ((and (not (i64= (size ps) (size args))) (not (any? draft-hole? args)))
                         (refuse v (string-append "a call of the wrong number of arguments: "
                                                  (show-sexps args))))
                        ;; A REPL's hole among the arguments (C97): those before it
                        ;; checked, against as many parameters; none may follow all.
                        ((i64> (size args) (size ps))
                         (refuse v (string-append "the hole: nothing, the call has its " (string-append (i64->string (size ps)) (if (i64= (size ps) 1) " argument" " arguments")))))
                        (else
                      (tagcase (let ((s1 (if (or (null? expected) (proc-type? s (car expected))) s (fits v s r (car expected)))))
                                 (call-args v s1 args (if (i64= (size ps) (size args)) ps (tys-first ps (size args))) (fixed-by s s1 (concat (map metas-of ps)))))
                        (res (u es1 s0)
                         (let ((s (if (null? expected)
                                      (freshened s0 r)
                                      (if (proc-type? s0 (car expected)) (fits v s0 r (car expected)) s0))))
                          (tagcase (name-regions v s latent regions)
                            (res (u named s)
                              (if (any? (lambda ((x string)) (let ((y (resolve-atom s x))) (or (string=? y "write:acyclic") (string=? y "write:const")))) named)
                                  ;; A procedure that writes, at frozen data (C161): Fixpt's rule.
                                  (refuse v "this writes frozen data, whose region is const")
                              (res r (effs-union (close-effs s named) (effs-union more (effs-union es0 es1)))
                                   (lift-noted v (noted-call v s named) r expected)))))))))))
                (else other (refuse v (string-append "a call of a " (string-append (show-ty s t) ", no procedure"))))))))))

      (noted-lambda (subr kfx (cv st strings) st)
        (lambda (v s es)
          "A lambda of effect `es`: one that may abort returns a `Result`, and
           one that may suspend is a future besides (C45)."
          (let ((s (if (escapes? es) (note-fact s (cv-file v) (cv-pos v) "fallible") s)))
            (if (suspends? es) (note-fact s (cv-file v) (cv-pos v) "suspends") s))))

      (noted-call (subr kfx (cv st strings) st)
        (lambda (v s es)
          "A call of latent effect `es`: `?` after one that may abort, and
           `.await` before it after one that may suspend (C45)."
          (let ((s (if (escapes? es) (note-fact s (cv-file v) (cv-pos v) "fallible-call") s)))
            (if (suspends? es) (note-fact s (cv-file v) (cv-pos v) "suspending-call") s))))

      (lift-noted (subr kfx (cv st ty tys) st)
        (lambda (v s r expected)
          "A call whose value is a procedure that cannot abort, where one that
           may is expected: lifted, as `check-by-synth` lifts one (C35)."
          (if (null? expected)
              s
              (tagcase (walk s r)
                (ty-proc (pes ps r2)
                  (tagcase (walk s (car expected))
                    (ty-proc (ees eps er)
                      (cond ((and (suspends? ees) (not (suspends? pes)))
                             (note-fact s (cv-file v) (cv-pos v) (string-append (if (escapes? pes) "lift-suspend-fallible " "lift-suspend ") (i64->string (size ps)))))
                            ((and (escapes? ees) (not (escapes? pes)))
                             (note-fact s (cv-file v) (cv-pos v) (string-append "lift " (i64->string (size ps)))))
                            (else s)))
                    (else other s)))
                (else other s)))))

      (call-args (subr kfx (cv st sexps tys i64s) res)
        (lambda (v s args ps fixed)
          "The arguments, in order, but for `nil` given for a parameter that is
           an inference variable, which is heard after the rest, as FX-26 hears
           it. A literal is not: FX-26 makes it an `int` where it stands."
          (tagcase (call-args-pass v s args ps #f fixed 1)
            (res (u es s) (with-effs (call-args-pass v s args ps #t fixed 1) es)))))

      (module-argument (subr kfx (cv st sexp ty) res)
        (lambda (v s arg t)
          "A module given for a module parameter: one defined at the top level, by
           its name, read as a global is."
          (let ((name (tagcase arg (sym (n at-file at-pos) n) (else other ""))))
            (if (or (string=? name "")
                    (null? (scope-bind name v))
                    (not (tagcase (car (scope-bind name v)) (bind (n sc wher) (string=? wher "module")))))
                (refuse v "KFX's module argument is a module defined at the top level, by its name")
                (res t (list (string-append "g:" name))
                     (note-fact (conforms v s name (tagcase t (ty-data (d args) (after-prefix d "%module ")) (else other ""))
                                          (car (module-spec v t)))
                                (datum-file arg) (datum-pos arg)
                                (string-append "module-arg " (spec-value-words (car (module-spec v t))))))))))

      (call-args-pass (subr kfx (cv st sexps tys bool i64s i64) res)
        (lambda (v s args ps later fixed k)
          "The arguments `deferred?` says are `later`'s; the first is argument
           `k`. The REPL's hole as one is said to be in it (C97)."
          (cond ((null? args) (res (ty-unit) nil s))
                ((eqv-bool? (deferred? (car args) (car ps)) later)
                 (tagcase (cond ((and (not (null? (module-spec v (walk s (car ps)))))
                                      (tagcase (car args) (sym (n f p) (let ((b (scope-bind n v))) (and (not (null? b)) (tagcase (car b) (bind (m sc w) (string=? w "module")))))) (else other #f)))
                                 (module-argument (in-draft v (car args)) s (car args) (walk s (car ps))))
                                ((and (not (lambda-form? (car args)))
                                      (has-open? s (car ps)))
                                 "An argument for a parameter whose type is not known whole yet:
                                  found by itself, as FX-26 finds it (a literal an `int`, a
                                  control form's branches of one type, a `list` at a fresh
                                  region); a lambda, told its parameters, is checked."
                                 (check-by-synth (in-draft (if (draft-hole? (car args)) (said-in v (string-append "argument " (i64->string k))) v) (car args)) s (car args) (car ps)))
                                (else (check (in-draft (if (draft-hole? (car args)) (said-in v (string-append "argument " (i64->string k))) v) (car args)) s (car args) (car ps))))
                   (res (t es s) (with-effs (call-args-pass v s (cdr args) (cdr ps) later fixed (i64+ k 1)) es))))
                (else (call-args-pass v s (cdr args) (cdr ps) later fixed (i64+ k 1)))))))))
