"check.kfx: the checker."

"Checking (TODO.md, section 13): KFX's types and effects, so that kfx
 refuses what is not KFX without Fixpt. KFX is a subset of FX-26 (PLAN.md,
 K1): this checker may refuse what FX-26 accepts, never accept what it
 refuses. Where FX-26 is clever, it is plain instead:
 - every recursive procedure says `spin` (FX-26 proves termination);
 - a call of a procedure that is a value, and a global procedure named as
   a value, are `spin` (FX-26 says when they may loop);
 - a `poly` is over types, and a list at `acyclic`.
 Bidirectional, as FX-26's checking is: `check` knows the type expected,
 `synth` finds it. A `poly` procedure's call is instantiated by
 inference variables, solved by the arguments in order, those that are
 lambdas last."

(define-datatype ty
  (ty-i64)
  (ty-int)
  (ty-nat)
  (ty-f64)
  (ty-bool)
  (ty-char)
  (ty-unit)
  (ty-string)
  (ty-void)
  (ty-list ty ty)
  (ty-data string (listof ty acyclic))
  (ty-flat ty ty)
  (ty-ref ty ty)
  (ty-rconst string)
  (ty-tag ty ty strings ty)
  (ty-proc strings (listof ty acyclic) ty)
  (ty-var string)
  (ty-meta i64))

"`ty-flat` and `ty-ref` are a flat array and a reference, each with its
 element's type and its region: a `ty-rconst` (`@a`), a `ty-var` (a poly's
 region binder, named with a `'` first, so no type variable is one), or a
 `ty-meta`. Their effects' atoms are `read:`, `write:` and `alloc:` and a
 region's name.

 `ty-void` is `error`'s result, below every type. A `ty-proc`'s strings
 are its latent effect, a set of atoms: `spin`, `@globals` (every global
 read), and `g:` and a name (that global read). `ty-var` is a `poly`'s
 type variable, `ty-meta` an inference variable."

(define-type tys (listof ty acyclic))

(define-datatype scheme (scheme strings ty))

"A name in scope: its type, over its type variables, and where it is
 defined: `local`, `global` (the program's, so naming it reads it), or
 `prim` (kayak-rt's, and the prelude's)."
(define-datatype bind (bind string scheme string))
(define-type binds (listof bind acyclic))

(define-datatype variant (variant string tys))
(define-type variants (listof variant acyclic))
(define-datatype dt (dt string strings variants))
(define-type dts (listof dt acyclic))

(define-datatype alias (alias string strings sexp))
(define-type aliases (listof alias acyclic))

(define-datatype effdef (effdef string strings))
(define-type effdefs (listof effdef acyclic))

"What a checker of a definition knows: the names in scope, the datatypes,
 the type abbreviations, the effect abbreviations, the definition being
 checked, its recursive group (whose calls are `spin`), where the
 innermost list being checked began (a file, a line; for messages), the
 facts found so far, and the type and region variables in scope (a
 `poly`'s binders, a `letregion`'s region)."
(define-datatype cv (cv binds dts aliases effdefs string strings string i64 facts strings i64))

"Facts: what the checker found about a place, a file and an offset, for
 the emitter, which knows no types. `int`: the number literal there is an
 `int`, not an `i64`. A definition's facts are in its state while it is
 checked, then in `cv`'s, for the definitions after it, and the program's
 go to the emitter (`verdict`)."
(define-datatype fact (fact string i64 string))
(define-type facts (listof fact acyclic))

"Inference variables solved so far, the next one's number, and facts."
(define-datatype sb (sb i64 ty))
(define-type sbs (listof sb acyclic))
(define-datatype st (st sbs i64 facts))

"What checking an expression gives: its type, its effect, and the state."
(define-datatype res (res ty strings st))

"Messages"

(define-rec
  (show-sexp (subr kfx (sexp) string)
    (lambda (e)
      (tagcase e
        (sym (s) s)
        (str (s) (string-append "\"" (string-append s "\"")))
        (num (k num-file num-pos) (i64->string k))
        (chr (c) (string-append "#\\" (char->string c)))
        (real (t) t)
        (lst (xs src-file src-line src-pos) (string-append "(" (string-append (show-sexps xs) ")"))))))
  (show-sexps (subr kfx (sexps) string)
    (lambda (xs)
      (cond ((null? xs) "")
            ((null? (cdr xs)) (show-sexp (car xs)))
            (else (string-append (show-sexp (car xs)) (string-append " " (show-sexps (cdr xs)))))))))

(define cv-where (subr kfx (cv) string)
  (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) here))))

(define refuse (subr kfx (cv string) void)
  (lambda (v message)
    "An error, said where: the innermost list being checked, and the
     definition."
    (tagcase v
      (cv (bs ds as es here group file line fs tv at)
        (error (string-append "kfx: "
                 (string-append (if (i64= line 0) "" (string-append file (string-append ":" (string-append (i64->string line) ": "))))
                   (string-append "in " (string-append here (string-append ": " message))))))))))

(define name-of (subr kfx (cv sexp) string)
  (lambda (v e)
    "A name, where one is expected: refused, saying where, if `e` is none."
    (tagcase e
      (sym (s) s)
      (else other (refuse v (string-append "a name is expected here, not " (show-sexp other)))))))

"Effects"

(define take-chars (subr kfx ((listof char acyclic) i64) (listof char acyclic))
  (lambda (cs n) (if (or (null? cs) (i64= n 0)) nil (cons (car cs) (take-chars (cdr cs) (i64- n 1))))))

(define substring-of (subr kfx (string i64) string)
  (lambda (x n) (list->string (take-chars (string->list x) n))))

(define has-prefix? (subr kfx (string string) bool)
  (lambda (x p)
    (and (not (i64< (string-length-i64 x) (string-length-i64 p)))
         (string=? (substring-of x (string-length-i64 p)) p))))

(define-rec
  (drop-chars (subr kfx ((listof char acyclic) i64) (listof char acyclic))
    (lambda (cs n) (if (or (null? cs) (i64= n 0)) cs (drop-chars (cdr cs) (i64- n 1))))))

(define after-prefix (subr kfx (string string) string)
  (lambda (x p) (list->string (drop-chars (string->list x) (string-length-i64 p)))))

(define escapes? (subr kfx (strings) bool)
  (lambda (es)
    "Whether effect `es` may abort: a `goto` on some region. Such a
     procedure, in Rust, returns a `Result` (emit.kfx)."
    (any? (lambda ((x string)) (and (i64> (string-length-i64 x) 5) (string=? (substring-of x 5) "goto:"))) es)))

(define frozen-atom? (subr kfx (string) bool)
  (lambda (x)
    "An effect on `acyclic`: making and reading frozen data are pure, in
     FX-26; writing it is refused where its type is read."
    (or (string=? x "read:acyclic") (string=? x "alloc:acyclic") (string=? x "write:acyclic"))))

(define effs-union (subr kfx (strings strings) strings)
  (lambda (a b)
    (cond ((null? a) (if (any? (lambda ((x string)) (frozen-atom? x)) b) (effs-union b nil) b))
          ((or (frozen-atom? (car a)) (string-member? (car a) b)) (effs-union (cdr a) b))
          (else (effs-union (cdr a) (cons (car a) b))))))

(define global-atom? (subr kfx (string) bool)
  (lambda (x)
    "A read of one global, `g:name`; not a `goto:`."
    (and (i64> (string-length-i64 x) 1) (char=? (string-ref-i64 x 0) #\g) (char=? (string-ref-i64 x 1) #\:))))

(define effs-within? (subr kfx (strings strings) bool)
  (lambda (a b)
    "Whether effect `a` is within `b`: a read of one global is within a
     read of all of them."
    (or (null? a)
        (and (or (string-member? (car a) b)
                 (and (global-atom? (car a)) (string-member? "@globals" b)))
             (effs-within? (cdr a) b)))))

(define words-of (subr kfx (strings) string)
  (lambda (xs)
    (cond ((null? xs) "")
          ((null? (cdr xs)) (car xs))
          (else (string-append (car xs) (string-append " " (words-of (cdr xs))))))))

(define show-effs (subr kfx (strings) string)
  (lambda (es)
    (if (null? es) "pure" (string-append "(" (string-append (words-of es) ")")))))

(define find-effdef (subr kfx (cv string effdefs) strings)
  (lambda (v name es)
    (if (null? es)
        (refuse v (string-append "an effect KFX does not have: " name))
        (tagcase (car es)
          (effdef (n atoms) (if (string=? n name) atoms (find-effdef v name (cdr es))))))))

(define cv-effdefs (subr kfx (cv) effdefs)
  (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) es))))

(define region-name (subr kfx (cv strings sexp) string)
  (lambda (v tvars r)
    "A region's name: a constant, `@a`, or a poly's region binder, `'r`."
    (let ((s (tagcase r (sym (n) n) (else other (refuse v (string-append "a region KFX does not have: " (show-sexp other)))))))
      (cond ((string=? s "@globals")
             (refuse v "globals are a region only in effects: (read @globals), (read (globals g))"))
            ((char=? (string-ref-i64 s 0) #\@) s)
            ((string=? s "acyclic") s)
            ((string-member? (string-append "'" s) tvars) (string-append "'" s))
            (else (refuse v (string-append "a region KFX-0 does not have: " s)))))))

(define parse-region (subr kfx (cv strings sexp) ty)
  (lambda (v tvars r)
    (let ((name (region-name v tvars r)))
      (if (char=? (string-ref-i64 name 0) #\') (ty-var name) (ty-rconst name)))))

(define parse-mutable-region (subr kfx (cv strings sexp) ty)
  (lambda (v tvars r)
    "The region of data that may be written: not `acyclic`, which is frozen."
    (if (sym-is? r "acyclic")
        (refuse v "mutable data at acyclic, which is frozen and never written")
        (parse-region v tvars r))))

(define-rec
  (parse-effect (subr kfx (cv strings sexp) strings)
    (lambda (v tvars e)
      (tagcase e
        (sym (s)
          (cond ((string=? s "pure") nil)
                ((string=? s "spin") (list "spin"))
                (else (find-effdef v s (cv-effdefs v)))))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "maxeff") (parse-effects v tvars (cdr xs)))
                ((and (sym-is? (car xs) "read") (sym-is? (second xs) "@globals")) (list "@globals"))
                ((and (sym-is? (car xs) "read") (head-is? (second xs) "globals"))
                 (map (lambda ((g sexp)) (string-append "g:" (name-of v g))) (cdr (items (second xs)))))
                ((sym-is? (car xs) "comefrom")
                 (refuse v "a continuation kept (comefrom): KFX has escapes, not continuations, which Rust has not"))
                ((or (sym-is? (car xs) "read") (sym-is? (car xs) "write") (sym-is? (car xs) "alloc")
                     (sym-is? (car xs) "goto"))
                 (list (string-append (name-of v (car xs)) (string-append ":" (region-name v tvars (second xs))))))
                (else (refuse v (string-append "an effect KFX does not have: " (show-sexp e))))))
        (else other (refuse v (string-append "an effect KFX does not have: " (show-sexp e)))))))
  (parse-effects (subr kfx (cv strings sexps) strings)
    (lambda (v tvars es)
      (if (null? es) nil (effs-union (parse-effect v tvars (car es)) (parse-effects v tvars (cdr es)))))))

(define rename-atoms (subr kfx (strings string string) strings)
  (lambda (es from to)
    "Effect atoms on region `from` made atoms on region `to`."
    (map (lambda ((x string))
           (cond ((string=? x (string-append "read:" from)) (string-append "read:" to))
                 ((string=? x (string-append "write:" from)) (string-append "write:" to))
                 ((string=? x (string-append "alloc:" from)) (string-append "alloc:" to))
                 ((string=? x (string-append "goto:" from)) (string-append "goto:" to))
                 (else x)))
         es)))

(define rename-region (subr kfx (strings string ty) strings)
  (lambda (es name m)
    "Effects on region `name`, made effects on the region `m` stands for."
    (tagcase m
      (ty-meta (k) (rename-atoms es name (string-append "?" (i64->string k))))
      (ty-rconst (n) (rename-atoms es name n))
      (ty-var (n) (rename-atoms es name n))
      (else other es))))

(define meta-name (subr kfx (i64) string)
  (lambda (k) (string-append "?" (i64->string k))))

(define-rec
  (replace-var (subr kfx (string ty ty) ty)
    (lambda (name m t)
      (tagcase t
        (ty-var (n) (if (string=? n name) m t))
        (ty-list (e r) (ty-list (replace-var name m e) (replace-var name m r)))
        (ty-flat (e r) (ty-flat (replace-var name m e) (replace-var name m r)))
        (ty-tag (a h d r) (ty-tag (replace-var name m a) (replace-var name m h) (rename-region d name m) (replace-var name m r)))
        (ty-data (d args) (ty-data d (map (lambda ((x ty)) (replace-var name m x)) args)))
        (ty-ref (e r) (ty-ref (replace-var name m e) (replace-var name m r)))
        (ty-proc (es ps r)
          (ty-proc (rename-region es name m)
                   (map (lambda ((p ty)) (replace-var name m p)) ps) (replace-var name m r)))
        (else other t)))))

(define substitute (subr kfx (strings tys ty) ty)
  (lambda (params args t)
    "`t`, each of `params` replaced by its argument."
    (if (or (null? params) (null? args))
        t
        (substitute (cdr params) (cdr args) (replace-var (car params) (car args) t)))))

"Types"

(define cv-dts (subr kfx (cv) dts) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) ds))))
(define cv-aliases (subr kfx (cv) aliases) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) as))))
(define cv-binds (subr kfx (cv) binds) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) bs))))
(define cv-group (subr kfx (cv) strings) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) group))))
(define cv-tvars (subr kfx (cv) strings) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) tv))))

(define with-tvars (subr kfx (cv strings) cv)
  (lambda (v names)
    "`v`, with the type and region variables `names` in scope."
    (tagcase v (cv (bs ds as es here group file line fs tv at) (cv bs ds as es here group file line fs (onto names tv) at)))))

(define dt-named? (subr kfx (string dts) bool)
  (lambda (name ds)
    (any? (lambda ((d dt)) (tagcase d (dt (n ps vs) (string=? n name)))) ds)))

(define find-family (subr kfx (string dts) (listof dt acyclic))
  (lambda (name ds)
    "A datatype, its parameters and variants, as a list of one, or none."
    (cond ((null? ds) nil)
          ((tagcase (car ds) (dt (n ps vs) (string=? n name))) (list (car ds)))
          (else (find-family name (cdr ds))))))

(define find-alias (subr kfx (string aliases) (listof alias acyclic))
  (lambda (name as)
    "A type abbreviation, its parameters and what it stands for, as a list
     of one, or none."
    (cond ((null? as) nil)
          (else (tagcase (car as)
                  (alias (n ps t) (if (string=? n name) (list (car as)) (find-alias name (cdr as)))))))))

(define expanding (subr kfx (strings) strings)
  (lambda (tvars)
    "The type abbreviations being expanded, which `tvars` carries, marked,
     so that one that mentions itself is found."
    (cond ((null? tvars) nil)
          ((and (i64> (string-length-i64 (car tvars)) 0) (char=? (string-ref-i64 (car tvars) 0) #\%))
           (cons (car tvars) (expanding (cdr tvars))))
          (else (expanding (cdr tvars))))))

"A knot through the store (FX-26's `no_knot`): a procedure kept in
 storage at a region, whose latent effect reads that region and does not
 say `spin`, could be fetched from there by a procedure fetched from
 there, a loop with no recursive call, which only its type shows. The
 regions a type keeps things in: a `ref`'s, a list's not `acyclic`; a
 datatype keeps where its fields do; what a generative type is given, KFX
 takes as kept everywhere, more cautious than FX-26. `res` resolves an
 effect's inference variables."

(define region-name-of (subr kfx (ty) string)
  (lambda (r) (tagcase r (ty-var (n) n) (ty-rconst (n) n) (ty-meta (k) (meta-name k)) (else other "?"))))

(define reads-kept (subr kfx (strings strings bool) strings)
  (lambda (atoms kept every)
    (if (string-member? "spin" atoms)
        nil
        (concat (map (lambda ((x string))
                       (if (and (has-prefix? x "read:")
                                (or (string-member? (after-prefix x "read:") kept)
                                    (and every (not (string=? (after-prefix x "read:") "acyclic")))))
                           (the strings (list (after-prefix x "read:")))
                           nil))
                     atoms)))))

(define-rec
  (knot-in (subr kfx (cv (subr kfx (string) string) ty strings bool strings) strings)
    (lambda (v res t kept every seen)
      "The region of a knot `t` ties, kept in `kept` (everywhere, if
       `every`); or none."
      (tagcase t
        (ty-ref (a r) (knot-in v res a (cons (region-name-of r) kept) every seen))
        (ty-list (a r)
          (knot-in v res a (if (string=? (region-name-of r) "acyclic") kept (cons (region-name-of r) kept)) every seen))
        (ty-proc (es ps r)
          (let ((found (reads-kept (map res es) kept every)))
            (if (null? found) (first-knot v res (cons r ps) nil #f seen) found)))
        (ty-tag (a h d r) (first-knot v res (list a h) nil #f seen))
        (ty-data (d args)
          (if (string-member? d seen)
              nil
              (let ((found (find-family d (cv-dts v))))
                (if (null? found)
                    nil
                    (tagcase (car found)
                      (dt (n ps vs)
                        (if (null? vs)
                            (first-knot v res args kept #t (cons d seen))
                            (first-knot v res
                                        (concat (map (lambda ((x variant))
                                                       (tagcase x (variant (tag fs) (map (lambda ((f ty)) (substitute ps args f)) fs))))
                                                     vs))
                                        kept every (cons d seen)))))))))
        (else other nil))))
  (first-knot (subr kfx (cv (subr kfx (string) string) tys strings bool strings) strings)
    (lambda (v res ts kept every seen)
      (if (null? ts)
          nil
          (let ((found (knot-in v res (car ts) kept every seen)))
            (if (null? found) (first-knot v res (cdr ts) kept every seen) found))))))

(define no-knot (subr kfx (cv (subr kfx (string) string) ty) ty)
  (lambda (v res t)
    (let ((found (knot-in v res t nil #f nil)))
      (if (null? found)
          t
          (refuse v (string-append "a procedure kept in " (string-append (car found) (string-append " reads " (string-append (car found)
                    ", so it could reach itself: it must say spin")))))))))

(define-rec
  (parse-type (subr kfx (cv strings sexp) ty)
    (lambda (v tvars t)
      "`tvars`: the type variables in scope."
      (tagcase t
        (sym (s)
          (cond ((string=? s "i64") (ty-i64))
                ((string=? s "int") (ty-int))
                ((string=? s "nat") (ty-nat))
                ((string=? s "f64") (ty-f64))
                ((string=? s "bool") (ty-bool))
                ((string=? s "char") (ty-char))
                ((string=? s "unit") (ty-unit))
                ((string=? s "string") (ty-string))
                ((string=? s "void") (ty-void))
                ((string-member? s tvars) (ty-var s))
                ((dt-named? s (cv-dts v))
                 (tagcase (car (find-family s (cv-dts v)))
                   (dt (n ps vs)
                     (if (null? ps)
                         (ty-data s nil)
                         (refuse v (string-append "a type with parameters, given none: " s))))))
                (else
                 (let ((found (find-alias s (cv-aliases v))))
                   (if (null? found)
                       (refuse v (string-append "no type is named " s))
                       (tagcase (car found)
                         (alias (n ps body)
                           (cond ((not (null? ps))
                                  (refuse v (string-append "a type with parameters, given none: " s)))
                                 ((string-member? (string-append "%expanding " s) tvars)
                                  (refuse v (string-append "a type abbreviation that mentions itself, " (string-append s
                                            ": Rust's type aliases cannot; a datatype can"))))
                                 (else (parse-type v (cons (string-append "%expanding " s) tvars) body))))))))))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "listof")
                 (no-knot v (lambda ((x string)) x) (ty-list (parse-type v tvars (second xs)) (parse-region v tvars (third xs)))))
                ((sym-is? (car xs) "flatarrayof")
                 (if (sym-is? (second xs) "i64")
                     (ty-flat (ty-i64) (parse-mutable-region v tvars (third xs)))
                     (refuse v (string-append "KFX-0's flat arrays are of i64: " (show-sexp t)))))
                ((sym-is? (car xs) "ref")
                 (no-knot v (lambda ((x string)) x) (ty-ref (parse-type v tvars (second xs)) (parse-mutable-region v tvars (third xs)))))
                ((sym-is? (car xs) "prompt-tag")
                 (ty-tag (parse-type v tvars (second xs)) (parse-type v tvars (third xs))
                         (parse-effect v tvars (fourth xs)) (parse-mutable-region v tvars (car (cdr (cdr (cdr (cdr xs))))))))
                ((sym-is? (car xs) "select")
                 (let ((name (string-append (name-of v (second xs)) (string-append " " (name-of v (third xs))))))
                   (if (null? (find-alias name (cv-aliases v)))
                       (refuse v (string-append "no module defined at the top level gives a type " (show-sexp t)))
                       (parse-type v tvars (sym name)))))
                ((sym-is? (car xs) "subr")
                 (ty-proc (parse-effect v tvars (second xs))
                          (parse-types v tvars (items (third xs)))
                          (parse-type v tvars (fourth xs))))
                ((tagcase (car xs) (sym (n) (or (dt-named? n (cv-dts v)) (not (null? (find-alias n (cv-aliases v)))))) (else other #f))
                 (no-knot v (lambda ((x string)) x) (parse-application v tvars (name-of v (car xs)) (cdr xs))))
                (else (refuse v (string-append "a type KFX does not have: " (show-sexp t))))))
        (else other (refuse v (string-append "a type KFX does not have: " (show-sexp t)))))))
  (parse-types (subr kfx (cv strings sexps) tys)
    (lambda (v tvars ts) (map (lambda ((t sexp)) (parse-type v tvars t)) ts)))

  (parse-arguments (subr kfx (cv strings strings sexps) tys)
    (lambda (v tvars params args)
      "A family's arguments, each read as its parameter's kind says: a
       region for a name beginning `'`, a type otherwise."
      (cond ((and (null? params) (null? args)) nil)
            ((or (null? params) (null? args)) (refuse v "a type given the wrong number of arguments"))
            (else
             (cons (if (char=? (string-ref-i64 (car params) 0) #\')
                       (parse-region v tvars (car args))
                       (parse-type v tvars (car args)))
                   (parse-arguments v tvars (cdr params) (cdr args)))))))

  (parse-application (subr kfx (cv strings string sexps) ty)
    (lambda (v tvars name args)
      "`(name arg ...)`: a datatype with parameters, applied; or a type
       abbreviation with them, what it stands for with its arguments."
      (let ((found (find-family name (cv-dts v))))
        (if (not (null? found))
            (tagcase (car found) (dt (n ps vs) (ty-data name (parse-arguments v tvars ps args))))
            (tagcase (car (find-alias name (cv-aliases v)))
              (alias (n ps body)
                (if (string-member? (string-append "%expanding " name) tvars)
                    (refuse v (string-append "a type abbreviation that mentions itself, " (string-append name
                              ": Rust's type aliases cannot; a datatype can")))
                    (substitute ps (parse-arguments v tvars ps args)
                                (parse-type v (cons (string-append "%expanding " name) (onto ps (expanding tvars))) body))))))))))

(define family-params (subr kfx (cv sexp) strings)
  (lambda (v head)
    "A family's parameters, from its head `(name (p kind) ...)`: a type's
     named as written, a region's with `'` first; none for a bare name."
    (tagcase head
      (lst (xs src-file src-line src-pos)
        (map (lambda ((b sexp))
               (let ((b (items b)))
                 (cond ((not (i64= (size b) 2))
                        (refuse v (string-append "a variance mark, which KFX does not have (its families are invariant): "
                                                 (show-sexp (lst b "" 0 0)))))
                       ((sym-is? (second b) "type") (name-of v (car b)))
                       ((sym-is? (second b) "region") (string-append "'" (name-of v (car b))))
                       (else (refuse v (string-append "a family over a kind KFX does not have: "
                                                      (show-sexp (lst b "" 0 0))))))))
             (cdr xs)))
      (else other nil))))

(define poly-binders (subr kfx (cv sexp) strings)
  (lambda (v t)
    "A definition's type's variables: a poly at its top, over types, and
     regions, whose names begin with `'`."
    (if (head-is? t "poly")
        (map (lambda ((b sexp))
               (let ((b (items b)))
                 (cond ((not (i64= (size b) 2))
                        (refuse v (string-append "a binder KFX-0 does not have (distinct regions are to come): "
                                                 (show-sexp (lst b "" 0 0)))))
                       ((sym-is? (second b) "type") (name-of v (car b)))
                       ((sym-is? (second b) "region") (string-append "'" (name-of v (car b))))
                       (else (refuse v (string-append "KFX's poly is over types and regions: " (show-sexp (lst b "" 0 0))))))))
             (items (second (items t))))
        nil)))

(define parse-scheme (subr kfx (cv sexp) scheme)
  (lambda (v t)
    (let ((tvars (poly-binders v t)))
      (scheme tvars (parse-type v tvars (if (head-is? t "poly") (third (items t)) t))))))

(define-rec
  (show-ty (subr kfx (st ty) string)
    (lambda (s t)
      (tagcase (walk s t)
        (ty-i64 () "i64")
        (ty-int () "int")
        (ty-nat () "nat")
        (ty-f64 () "f64")
        (ty-bool () "bool")
        (ty-char () "char")
        (ty-unit () "unit")
        (ty-string () "string")
        (ty-void () "void")
        (ty-list (e r) (string-append "(listof " (string-append (show-ty s e) (string-append " " (string-append (show-ty s r) ")")))))
        (ty-data (d args) (if (null? args) d (string-append "(" (string-append d (string-append " " (string-append (show-tys s args) ")"))))))
        (ty-flat (e r) (string-append "(flatarrayof " (string-append (show-ty s e) (string-append " " (string-append (show-ty s r) ")")))))
        (ty-ref (e r) (string-append "(ref " (string-append (show-ty s e) (string-append " " (string-append (show-ty s r) ")")))))
        (ty-rconst (n) n)
        (ty-tag (a h d r)
          (string-append "(prompt-tag " (string-append (show-ty s a) (string-append " " (string-append (show-ty s h)
            (string-append " " (string-append (show-effs d) (string-append " " (string-append (show-ty s r) ")")))))))))
        (ty-proc (es ps r)
          (string-append "(subr " (string-append (show-effs es) (string-append " ("
            (string-append (show-tys s ps) (string-append ") " (string-append (show-ty s r) ")")))))))
        (ty-var (n) n)
        (ty-meta (k) (string-append "?" (i64->string k))))))
  (show-tys (subr kfx (st tys) string)
    (lambda (s ts)
      (cond ((null? ts) "")
            ((null? (cdr ts)) (show-ty s (car ts)))
            (else (string-append (show-ty s (car ts)) (string-append " " (show-tys s (cdr ts))))))))
  (walk (subr kfx (st ty) ty)
    (lambda (s t)
      "`t`, its inference variable replaced by its solution, if it has one."
      (tagcase t
        (ty-meta (k)
          (tagcase s
            (st (subst next fs)
              (let ((found (lookup-meta k subst)))
                (if (null? found) t (walk s (car found)))))))
        (else other t))))
  (lookup-meta (subr kfx (i64 sbs) tys)
    (lambda (k subst)
      (cond ((null? subst) nil)
            (else (tagcase (car subst)
                    (sb (j t) (if (i64= j k) (list t) (lookup-meta k (cdr subst))))))))))

(define-rec
  (has-meta? (subr kfx (st ty) bool)
    (lambda (s t)
      "Whether `t` has an inference variable not solved yet."
      (tagcase (walk s t)
        (ty-meta (k) #t)
        (ty-list (e r) (or (has-meta? s e) (has-meta? s r)))
        (ty-flat (e r) (or (has-meta? s e) (has-meta? s r)))
        (ty-tag (a h d r) (or (has-meta? s a) (has-meta? s h) (has-meta? s r)))
        (ty-data (d args) (any? (lambda ((x ty)) (has-meta? s x)) args))
        (ty-ref (e r) (or (has-meta? s e) (has-meta? s r)))
        (ty-proc (es ps r) (or (has-meta? s r) (any? (lambda ((p ty)) (has-meta? s p)) ps)))
        (else other #f)))))

(define fresh (subr kfx (st) res)
  (lambda (s)
    "A new inference variable."
    (tagcase s (st (subst next fs) (res (ty-meta next) nil (st subst (i64+ next 1) fs))))))

(define note-fact (subr kfx (st string i64 string) st)
  (lambda (s file pos what)
    (tagcase s (st (subst next fs) (st subst next (cons (fact file pos what) fs))))))

(define st-facts (subr kfx (st) facts)
  (lambda (s) (tagcase s (st (subst next fs) fs))))

(define solve (subr kfx (st i64 ty) st)
  (lambda (s k t)
    (tagcase s (st (subst next fs) (st (cons (sb k t) subst) next fs)))))

(define-rec
  (occurs? (subr kfx (st i64 ty) bool)
    (lambda (s k t)
      (tagcase (walk s t)
        (ty-meta (j) (i64= j k))
        (ty-list (e r) (or (occurs? s k e) (occurs? s k r)))
        (ty-flat (e r) (or (occurs? s k e) (occurs? s k r)))
        (ty-tag (a h d r) (or (occurs? s k a) (occurs? s k h) (occurs? s k r)))
        (ty-data (d args) (any? (lambda ((x ty)) (occurs? s k x)) args))
        (ty-ref (e r) (or (occurs? s k e) (occurs? s k r)))
        (ty-proc (es ps r) (or (occurs? s k r) (any? (lambda ((p ty)) (occurs? s k p)) ps)))
        (else other #f)))))

(define same-base? (subr kfx (ty ty) bool)
  (lambda (a e)
    (tagcase a
      (ty-i64 () (tagcase e (ty-i64 () #t) (else other #f)))
      (ty-int () (tagcase e (ty-int () #t) (else other #f)))
      (ty-nat () (tagcase e (ty-nat () #t) (ty-int () #t) (else other #f)))
      (ty-f64 () (tagcase e (ty-f64 () #t) (else other #f)))
      (ty-bool () (tagcase e (ty-bool () #t) (else other #f)))
      (ty-char () (tagcase e (ty-char () #t) (else other #f)))
      (ty-unit () (tagcase e (ty-unit () #t) (else other #f)))
      (ty-string () (tagcase e (ty-string () #t) (else other #f)))
      (else other #f))))

(define region-string (subr kfx (st ty) string)
  (lambda (s r)
    (tagcase (walk s r) (ty-rconst (n) n) (ty-var (n) n) (ty-meta (k) (meta-name k)) (else other "?"))))

(define meta-number (subr kfx (string) i64)
  (lambda (r)
    "The number of an inference variable's name, `?k`."
    (i64- 0 (digits-value (cdr (string-chars r)) 0 "" 0))))

(define-rec
  (after-colon (subr kfx ((listof char acyclic)) (listof char acyclic))
    (lambda (cs)
      (cond ((null? cs) nil)
            ((char=? (car cs) #\:) (cdr cs))
            (else (after-colon (cdr cs)))))))

(define region-atom? (subr kfx (string) bool)
  (lambda (x)
    (and (i64> (string-length-i64 x) 5)
         (or (string=? (substring-of x 5) "read:") (string=? (substring-of x 5) "goto:")
             (string=? (substring-of x 6) "write:") (string=? (substring-of x 6) "alloc:")))))

(define atom-kind (subr kfx (string) string)
  (lambda (x) (substring-of x (i64- (string-length-i64 x) (size (after-colon (string->list x)))))))

(define atom-region (subr kfx (string) string)
  (lambda (x) (list->string (after-colon (string->list x)))))

(define resolve-atom (subr kfx (st string) string)
  (lambda (s x)
    "An effect atom, its region an inference variable solved replaced by
     the region found."
    (let ((r (atom-region x)))
      (if (and (region-atom? x) (char=? (string-ref-i64 r 0) #\?))
          (string-append (atom-kind x)
                         (region-string s (ty-meta (meta-number r))))
          x))))

(define-rec
  (zonk (subr kfx (st ty) ty)
    (lambda (s t)
      "`t`, every inference variable in it replaced by its solution."
      (tagcase (walk s t)
        (ty-list (e r) (ty-list (zonk s e) (zonk s r)))
        (ty-flat (e r) (ty-flat (zonk s e) (zonk s r)))
        (ty-tag (a h d r) (ty-tag (zonk s a) (zonk s h) d (zonk s r)))
        (ty-data (d args) (ty-data d (map (lambda ((x ty)) (zonk s x)) args)))
        (ty-ref (e r) (ty-ref (zonk s e) (zonk s r)))
        (ty-proc (es ps r) (ty-proc es (map (lambda ((p ty)) (zonk s p)) ps) (zonk s r)))
        (else other other)))))

(define region-ty (subr kfx (string) ty)
  (lambda (r)
    (cond ((char=? (string-ref-i64 r 0) #\?) (ty-meta (meta-number r)))
          ((char=? (string-ref-i64 r 0) #\') (ty-var r))
          (else (ty-rconst r)))))

(define-rec
  (open-atom (subr kfx (st string strings) strings)
    (lambda (s x es)
      "Of the effect `es`, an atom of the kind of `x` whose region is an
       inference variable not solved: that variable can stand for `x`'s
       region."
      (cond ((null? es) nil)
            ((let ((y (resolve-atom s (car es))))
               (and (region-atom? y) (string=? (atom-kind y) (atom-kind x))
                    (char=? (string-ref-i64 (atom-region y) 0) #\?)))
             (list (resolve-atom s (car es))))
            (else (open-atom s x (cdr es)))))))

(define-rec
  (fit-effs (subr kfx (st strings strings) (listof st acyclic))
    (lambda (s a e)
      "Whether effect `a` is within `e`, an inference variable for a region
       in `e` solved for one in `a` if need be: the state, or none."
      (if (null? a)
          (list s)
          (let* ((x (resolve-atom s (car a)))
                 (es (map (lambda ((y string)) (resolve-atom s y)) e)))
            (cond ((effs-within? (list x) es) (fit-effs s (cdr a) e))
                  ((null? (open-atom s x e)) nil)
                  (else
                   (tagcase (region-ty (atom-region (car (open-atom s x e))))
                     (ty-meta (k) (fit-effs (solve s k (region-ty (atom-region x))) (cdr a) e))
                     (else other nil)))))))))

(define-rec
  (fits (subr kfx (cv st ty ty) st)
    (lambda (v s actual expected)
      "That a value of type `actual` may stand where `expected` is: the two
       the same, inference variables solved to make them so, but for
       `void`, which fits anything, and a procedure, whose latent effect
       may be within the one expected."
      (let ((a (walk s actual)) (e (walk s expected)))
        (tagcase a
          (ty-void () s)
          (ty-meta (k)
            (tagcase e
              (ty-meta (j) (if (i64= j k) s (solve s k e)))
              (else other
                (if (occurs? s k e) (mismatch v s a e) (solve s k e)))))
          (else other
            (tagcase e
              (ty-meta (j) (if (occurs? s j a) (mismatch v s a e) (solve s j a)))
              (else other (fits-shapes v s a e))))))))
  (fits-shapes (subr kfx (cv st ty ty) st)
    (lambda (v s a e)
      (tagcase a
        (ty-list (x xr) (tagcase e (ty-list (y yr) (fits v (fits v s x y) xr yr)) (else other (mismatch v s a e))))
        (ty-flat (x xr) (tagcase e (ty-flat (y yr) (fits v (fits v s x y) xr yr)) (else other (mismatch v s a e))))
        (ty-ref (x xr) (tagcase e (ty-ref (y yr) (fits v (fits v s x y) xr yr)) (else other (mismatch v s a e))))
        (ty-rconst (x) (tagcase e (ty-rconst (y) (if (string=? x y) s (mismatch v s a e))) (else other (mismatch v s a e))))
        (ty-tag (xa xh xd xr)
          (tagcase e
            (ty-tag (ya yh yd yr)
              (if (and (effs-within? xd yd) (effs-within? yd xd))
                  (fits v (fits v (fits v s xa ya) xh yh) xr yr)
                  (mismatch v s a e)))
            (else other (mismatch v s a e))))
        (ty-data (x xs)
          (tagcase e
            (ty-data (y ys) (if (and (string=? x y) (i64= (size xs) (size ys))) (fits-all v s xs ys) (mismatch v s a e)))
            (else other (mismatch v s a e))))
        (ty-var (x) (tagcase e (ty-var (y) (if (string=? x y) s (mismatch v s a e))) (else other (mismatch v s a e))))
        (ty-proc (aes aps ar)
          (tagcase e
            (ty-proc (ees eps er)
              (cond ((not (i64= (size aps) (size eps))) (mismatch v s a e))
                    ((null? (fit-effs s aes ees)) (mismatch v s a e))
                    (else (fits v (fits-all v (car (fit-effs s aes ees)) eps aps) ar er))))
            (else other (mismatch v s a e))))
        (else other (if (same-base? a e) s (mismatch v s a e))))))
  (fits-all (subr kfx (cv st tys tys) st)
    (lambda (v s actuals expecteds)
      "Parameters: each expected parameter's type stands for the actual's."
      (if (null? actuals)
          s
          (fits-all v (fits v s (car actuals) (car expecteds)) (cdr actuals) (cdr expecteds)))))
  (mismatch (subr kfx (cv st ty ty) st)
    (lambda (v s a e)
      (refuse v (string-append "a " (string-append (show-ty s a)
                (string-append " is here, where a " (string-append (show-ty s e) " is expected"))))))))

"A scheme's instance: each variable an inference variable; those for
 regions are kept, so that a call's effect can name the regions found."
(define-datatype inst (inst ty st (listof i64 acyclic)))

(define-rec
  (instantiate (subr kfx (st scheme) inst)
    (lambda (s sc)
      (tagcase sc
        (scheme (tvars t) (instantiate-vars s tvars t nil)))))
  (instantiate-vars (subr kfx (st strings ty (listof i64 acyclic)) inst)
    (lambda (s tvars t regions)
      (if (null? tvars)
          (inst t s regions)
          (tagcase (fresh s)
            (res (m es s)
              (tagcase m
                (ty-meta (k)
                  (instantiate-vars s (cdr tvars) (replace-var (car tvars) m t)
                                    (if (char=? (string-ref-i64 (car tvars) 0) #\') (cons k regions) regions)))
                (else other (inst t s regions)))))))))


"The names in scope"

(define find-bind (subr kfx (string binds) binds)
  (lambda (name bs)
    "The innermost binding of `name`, as a list of one, or none."
    (cond ((null? bs) nil)
          (else (tagcase (car bs)
                  (bind (n sc where) (if (string=? n name) (list (car bs)) (find-bind name (cdr bs)))))))))

(define keyword? (subr kfx (string) bool)
  (lambda (name)
    "FX-26's keywords, which name nothing (fixpt's top.rs, KEYWORDS)."
    (or (string=? name "lambda") (string=? name "plambda") (string=? name "proj") (string=? name "if")
        (string=? name "letrec") (string=? name "let") (string=? name "begin") (string=? name "define")
        (string=? name "define*") (string=? name "define-type") (string=? name "define-generative") (string=? name "subr")
        (string=? name "poly") (string=? name "ref") (string=? name "pairof") (string=? name "dletrec")
        (string=? name "void") (string=? name "pure") (string=? name "maxeff") (string=? name "read")
        (string=? name "write") (string=? name "alloc") (string=? name "goto") (string=? name "comefrom")
        (string=? name "region") (string=? name "effect") (string=? name "type") (string=? name "prompt")
        (string=? name "prompt-tag") (string=? name "composable") (string=? name "mark-key") (string=? name "listof")
        (string=? name "cond") (string=? name "case") (string=? name "else") (string=? name "and")
        (string=? name "or") (string=? name "let*") (string=? name "define-effect") (string=? name "module-parameters")
        (string=? name "the") (string=? name "bloblet") (string=? name "fields") (string=? name "frozen")
        (string=? name "arrayof") (string=? name "icell") (string=? name "await") (string=? name "define-rec")
        (string=? name "letrena") (string=? name "letreap") (string=? name "rlambda") (string=? name "quote")
        (string=? name "productof") (string=? name "sumof") (string=? name "product") (string=? name "extract")
        (string=? name "sum") (string=? name "tagcase") (string=? name "module") (string=? name "moduleof")
        (string=? name "with") (string=? name "select") (string=? name "load-module") (string=? name "define-datatype")
        (string=? name "make-bloblet") (string=? name "bloblet-ref") (string=? name "bloblet-set!") (string=? name "bloblet-freeze")
        (string=? name "bloblet-byte") (string=? name "bloblet-set-byte!") (string=? name "bloblet-bytes") (string=? name "rmake-bloblet")
        (string=? name "dlambda") (string=? name "=>") (string=? name "blobref-at") (string=? name "blobref+")
        (string=? name "blobref-owner") (string=? name "blobref-offset") (string=? name "blobref-get") (string=? name "blobref-set!")
        (string=? name "blobref-index") (string=? name "blobref-variant!"))))

(define bind-onto (subr kfx (binds binds) binds)
  (lambda (xs ys) (if (null? xs) ys (bind-onto (cdr xs) (cons (car xs) ys)))))

(define near (subr kfx (cv string i64 i64) cv)
  (lambda (v file line pos)
    "`v`, checking a list that began at `line` of `file`, at offset `pos`."
    (if (i64= line 0)
        v
        (tagcase v (cv (bs ds as es here group f l fs tv at) (cv bs ds as es here group file line fs tv pos))))))

(define cv-file (subr kfx (cv) string) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) file))))
(define cv-pos (subr kfx (cv) i64) (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) at))))

(define with-binds (subr kfx (cv binds) cv)
  (lambda (v more)
    (tagcase v (cv (bs ds as es here group file line fs tv at) (cv (bind-onto more bs) ds as es here group file line fs tv at)))))

(define local (subr kfx (cv string ty) bind)
  (lambda (v name t)
    "A local may be named by a keyword, as FX-26 has it; it may not then be
     called, since FX-26 reads such a call as its form (`synth-call`)."
    (bind name (scheme nil t) "local")))

"Expressions"

(define with-effs (subr kfx (res strings) res)
  (lambda (r es) (tagcase r (res (t es0 s) (res t (effs-union es es0) s)))))

(define proc-type? (subr kfx (st ty) bool)
  (lambda (s t) (tagcase (walk s t) (ty-proc (es ps r) #t) (else other #f))))

(define naming-effs (subr kfx (st string string ty) strings)
  (lambda (s name where t)
    "What naming a name does: a global is read, and a global procedure
     named as a value may be called from anywhere, so may loop."
    (cond ((not (string=? where "global")) nil)
          ((proc-type? s t) (list "spin" (string-append "g:" name)))
          (else (list (string-append "g:" name))))))

(define void? (subr kfx (st ty) bool)
  (lambda (s t) (tagcase (walk s t) (ty-void () #t) (else other #f))))

(define next-expected (subr kfx (st ty tys) tys)
  (lambda (s t expected)
    "What the branches after one of type `t` are checked against: the type
     expected, if known, else `t`, unless that is `void`, which says
     nothing."
    (cond ((not (null? expected)) expected)
          ((void? s t) nil)
          (else (list t)))))

(define joined (subr kfx (st ty ty tys) ty)
  (lambda (s t rest expected)
    "The type of branches, the first of type `t` and the rest of `rest`."
    (cond ((not (null? expected)) (car expected))
          ((void? s t) rest)
          (else t))))

(define region-of (subr kfx (cv st ty) res)
  (lambda (v s r)
    "A region, solved: one no argument nor expected type said is `acyclic`,
     as FX-26's fresh region for it, masked where it is not seen, is pure."
    (tagcase (walk s r)
      (ty-meta (k) (res (ty-rconst "acyclic") nil (solve s k (ty-rconst "acyclic"))))
      (else other (res other nil s)))))

(define name-regions (subr kfx (cv st strings (listof i64 acyclic)) res)
  (lambda (v s es regions)
    "A call's latent effect, its regions' inference variables replaced by
     the regions the arguments and the type expected found, or `acyclic`."
    (if (null? regions)
        (res (ty-unit) es s)
        (tagcase (region-of v s (ty-meta (car regions)))
          (res (r rn s)
            (name-regions v s (rename-atoms es (meta-name (car regions)) (region-string s r)) (cdr regions)))))))

(define masked (subr kfx (strings string) strings)
  (lambda (es r)
    "Effects, those on region `r` removed."
    (cond ((null? es) nil)
          ((or (string=? (car es) (string-append "read:" r)) (string=? (car es) (string-append "write:" r))
               (string=? (car es) (string-append "alloc:" r)) (string=? (car es) (string-append "goto:" r)))
           (masked (cdr es) r))
          (else (cons (car es) (masked (cdr es) r))))))

(define-rec
  (mentions? (subr kfx (st ty string) bool)
    (lambda (s t r)
      "Whether type `t` mentions region `r`, latent effects included."
      (tagcase (walk s t)
        (ty-var (n) (string=? n r))
        (ty-list (e x) (or (mentions? s e r) (mentions? s x r)))
        (ty-flat (e x) (or (mentions? s e r) (mentions? s x r)))
        (ty-tag (a h d x) (or (mentions? s a r) (mentions? s h r) (mentions? s x r)
                              (not (string=? (words-of (masked d r)) (words-of d)))))
        (ty-ref (e x) (or (mentions? s e r) (mentions? s x r)))
        (ty-data (d args) (any? (lambda ((a ty)) (mentions? s a r)) args))
        (ty-proc (es ps x)
          (or (not (string=? (words-of (masked es r)) (words-of es)))
              (mentions? s x r)
              (any? (lambda ((p ty)) (mentions? s p r)) ps)))
        (else other #f)))))

(define nat-op? (subr kfx (string) bool)
  (lambda (h)
    "The operations whose result is a `nat` when their operands are, as
     FX-26 keeps a `nat` through them: a sum, a product, a larger, a smaller."
    (or (string=? h "+") (string=? h "*") (string=? h "max") (string=? h "min"))))

(define prim? (subr kfx (bind) bool)
  (lambda (b) (tagcase b (bind (n sc where) (string=? where "prim")))))

(define nat? (subr kfx (st ty) bool)
  (lambda (s t) (tagcase (walk s t) (ty-nat () #t) (else other #f))))

(define deferred? (subr kfx (sexp ty) bool)
  (lambda (arg param)
    "`nil` given for a parameter that is, as instantiated, an inference
     variable: decided before any argument is checked, so both passes agree."
    (and (tagcase param (ty-meta (k) #t) (else other #f)) (sym-is? arg "nil"))))

(define eqv-bool? (subr kfx (bool bool) bool)
  (lambda (a b) (if a b (not b))))

(define masked-goto (subr kfx (strings string) strings)
  (lambda (es r)
    (cond ((null? es) nil)
          ((string=? (car es) (string-append "goto:" r)) (masked-goto (cdr es) r))
          (else (cons (car es) (masked-goto (cdr es) r))))))

(define-rec
  (names-in (subr kfx (sexp) strings)
    (lambda (e)
      "Every name in `e`, bound in it or not."
      (tagcase e
        (sym (n) (list n))
        (lst (xs src-file src-line src-pos) (names-in-all xs))
        (else other nil))))
  (names-in-all (subr kfx (sexps) strings)
    (lambda (es) (if (null? es) nil (onto (names-in (car es)) (names-in-all (cdr es)))))))

(define reaches? (subr kfx (cv st sexp sexp string) bool)
  (lambda (v s body tag r)
    "Whether `body` may reach a tag of region `r` but `tag`: whether a
     name in it, but `tag`'s if it is one, has a type that mentions `r`."
    (let ((tag-name (tagcase tag (sym (n) n) (else other ""))))
      (any? (lambda ((n string))
              (and (not (string=? n tag-name))
                   (let ((found (find-bind n (cv-binds v))))
                     (and (not (null? found))
                          (tagcase (car found) (bind (b sc where) (tagcase sc (scheme (tvars t) (mentions? s t r)))))))))
            (names-in body)))))

(define opened-binds (subr kfx (string binds) binds)
  (lambda (m bs)
    "Module `m`'s values, as items, named as `m` names them."
    (if (null? bs)
        nil
        (tagcase (car bs)
          (bind (n sc where)
            (if (and (string=? where "export") (has-prefix? n (string-append m " ")))
                (cons (bind (after-prefix n (string-append m " ")) sc "item") (opened-binds m (cdr bs)))
                (opened-binds m (cdr bs))))))))

(define well-formed? (subr kfx (string sexps) bool)
  (lambda (h xs)
    "Whether a control form has the parts it needs, before they are taken."
    (let ((lists? (lambda ((x sexp) (n i64) (exact bool))
                    (and (tagcase x (lst (ys f l p) #t) (else other #f))
                         (if exact (i64= (size (items x)) n) (not (i64< (size (items x)) n)))))))
      (cond ((string=? h "if") (i64= (size xs) 3))
            ((string=? h "cond") (and (not (null? xs)) (not (any? (lambda ((c sexp)) (not (lists? c 2 #f))) xs))))
            ((or (string=? h "let") (string=? h "let*"))
             (and (i64> (size xs) 1) (lists? (car xs) 0 #f)
                  (not (any? (lambda ((b sexp)) (not (lists? b 2 #t))) (items (car xs))))))
            ((string=? h "letrec")
             (and (i64> (size xs) 1) (lists? (car xs) 0 #f)
                  (not (any? (lambda ((b sexp)) (not (lists? b 3 #t))) (items (car xs))))))
            ((or (string=? h "case") (string=? h "tagcase"))
             (and (i64> (size xs) 1) (not (any? (lambda ((c sexp)) (not (lists? c 2 #f))) (cdr xs)))))
            ((or (string=? h "with") (string=? h "letregion")) (i64> (size xs) 1))
            (else #t)))))

"Termination (CLAUDES_CHOICES.md C20). A recursive group whose every run
 ends needs no `spin`: FX-26's size-change check (Lee, Jones and
 Ben-Amram; Fixpt's terminate.rs), its measures and no others, so that KFX
 accepts no group FX-26 would not. Each call within the group is a graph
 of how the callee's arguments relate to the caller's parameters: a part
 of one (strictly smaller), the same, or nothing known. The measures:
 parts, the `car` or `cdr` of a list at `acyclic` and a `tagcase` arm's
 fields; and an `int` or `nat` less by a literal under a test bounding it
 below by something fixed for the whole recursion, or greater, bounded
 above. A member named other than as a call's operator spoils it all."

"What is known of a value, of the member walked: the parameter, or a part
 of it (strictly smaller), of a type if known; or an integer parameter
 plus an offset."
(define-datatype tracked (part i64 bool tys) (int-of i64 i64))
(define-type trackeds (listof tracked acyclic))
(define-datatype known (known string trackeds))
(define-type knowns (listof known acyclic))
"A parameter, bounded below (`#t`) or above."
(define-datatype guard (guard i64 bool))
(define-type guards (listof guard acyclic))
"A size-change graph's edge: slots `3p + m`, `m` the measure (0 parts,
 1 down, 2 up), and whether it is strict."
(define-datatype edge (edge i64 i64 bool))
(define-type edges (listof edge acyclic))
(define-datatype scall (scall i64 i64 edges))
(define-type scalls (listof scall acyclic))
(define-type i64s (listof i64 acyclic))
"A call's arguments: each the caller's parameter passed on unchanged, or -1."
(define-datatype passing (passing i64 i64 i64s))
(define-type passings (listof passing acyclic))
(define-datatype slot (slot i64 i64))
(define-type slots (listof slot acyclic))

"The walk's context: the program's names; the members; the member walked;
 the names bound on the way down; the guards; its `nat` parameters; the
 parameters every call passes on unchanged."
(define-datatype wc (wc cv strings i64 knowns guards i64s slots))
"What it found: the calls, what each passes on, and whether a member
 escaped."
(define-datatype ws (ws scalls passings bool))

(define-rec
  (index-of (subr kfx (string strings i64) i64)
    (lambda (x xs i)
      (cond ((null? xs) -1) ((string=? (car xs) x) i) (else (index-of x (cdr xs) (i64+ i 1)))))))

(define-rec
  (nth-ty (subr kfx (tys i64) tys)
    (lambda (ts i)
      (cond ((null? ts) nil) ((i64= i 0) (the tys (list (car ts)))) (else (nth-ty (cdr ts) (i64- i 1)))))))

(define-rec
  (bound-of (subr kfx (string knowns) (listof trackeds acyclic))
    (lambda (n ks)
      (cond ((null? ks) nil)
            ((tagcase (car ks) (known (m t) (string=? m n))) (tagcase (car ks) (known (m t) (the (listof trackeds acyclic) (list t)))))
            (else (bound-of n (cdr ks)))))))

(define wc-bound (subr kfx (wc string) (listof trackeds acyclic))
  (lambda (c n) (tagcase c (wc (v ms cur sc gs nats inv) (bound-of n sc)))))

(define wc-member (subr kfx (wc string) i64)
  (lambda (c n)
    "The member `n` names here, unless something on the way down hid it; or -1."
    (tagcase c (wc (v ms cur sc gs nats inv) (if (null? (bound-of n sc)) (index-of n ms 0) -1)))))

(define std-op (subr kfx (wc sexp) string)
  (lambda (c e)
    "The primitive `e` names, if it names one: no local hides it."
    (tagcase e
      (sym (n)
        (tagcase c
          (wc (v ms cur sc gs nats inv)
            (if (or (not (null? (bound-of n sc))) (string-member? n ms)) ""
                (let ((found (find-bind n (cv-binds v))))
                  (if (and (not (null? found)) (tagcase (car found) (bind (x t where) (string=? where "prim")))) n ""))))))
      (else other ""))))

(define literal-of (subr kfx (sexp) i64s)
  (lambda (e) (tagcase e (num (k text pos) (the i64s (list k))) (else other nil))))

(define overflows? (subr kfx (i64 i64) bool)
  (lambda (o k)
    "Whether `o + k` is past an i64, where FX-26's `checked_add` gives up."
    (if (i64> k 0)
        (i64> o (i64- 9223372036854775807 k))
        (i64< o (i64- -9223372036854775808 k)))))

(define shifted (subr kfx (trackeds i64) trackeds)
  (lambda (ts k)
    "Each integer known, `k` more; one that would overflow known no longer."
    (concat (map (lambda ((t tracked))
                   (tagcase t
                     (int-of (p o) (if (overflows? o k) nil (the trackeds (list (int-of p (i64+ o k))))))
                     (else other nil)))
                 ts))))

(define-rec
  (tracked-of (subr kfx (wc sexp) trackeds)
    (lambda (c e)
      "What is known of `e`'s value."
      (tagcase e
        (sym (n) (let ((b (wc-bound c n))) (if (null? b) nil (car b))))
        (lst (xs src-file src-line src-pos)
          (let ((op (std-op c (car xs))))
            (cond ((sym-is? (car xs) "the") (tracked-of c (third xs)))
                  ((and (or (string=? op "car") (string=? op "cdr")) (i64= (size xs) 2))
                   (concat (map (lambda ((t tracked))
                                  (tagcase t
                                    (part (p strict ty)
                                      (if (null? ty) nil
                                          (tagcase (car ty)
                                            (ty-list (el r)
                                              (tagcase r
                                                (ty-rconst (rn)
                                                  (if (string=? rn "acyclic")
                                                      (the trackeds (list (part p #t (the tys (list (if (string=? op "car") el (car ty)))))))
                                                      nil))
                                                (else other nil)))
                                            (else other nil))))
                                    (else other nil)))
                                (tracked-of c (second xs)))))
                  ((and (or (string=? op "+") (string=? op "-")) (i64= (size xs) 3))
                   (let ((a (second xs)) (b (third xs)))
                     (cond ((not (null? (literal-of b)))
                            (cond ((string=? op "+") (shifted (tracked-of c a) (car (literal-of b))))
                                  ((i64= (car (literal-of b)) -9223372036854775808) nil)
                                  (else (shifted (tracked-of c a) (i64- 0 (car (literal-of b)))))))
                           ((and (string=? op "+") (not (null? (literal-of a))))
                            (shifted (tracked-of c b) (car (literal-of a))))
                           (else nil))))
                  (else nil))))
        (else other nil)))))

(define-rec
  (fixed? (subr kfx (wc sexp) bool)
    (lambda (c e)
      "Whether `e` is the same at every call of the group: a literal, a name
       bound outside it, a parameter passed on unchanged, or a string's
       length, or the sum or difference of such."
      (tagcase c
        (wc (v ms cur sc gs nats inv)
          (tagcase e
            (num (k text pos) #t)
            (sym (n)
              (let ((b (bound-of n sc)))
                (if (null? b)
                    (not (string-member? n ms))
                    (any? (lambda ((t tracked))
                            (tagcase t
                              (part (p strict ty) (and (not strict) (any? (lambda ((x slot)) (tagcase x (slot (i j) (and (i64= i cur) (i64= j p))))) inv)))
                              (else other #f)))
                          (car b)))))
            (lst (xs src-file src-line src-pos)
              (let ((op (std-op c (car xs))))
                (cond ((sym-is? (car xs) "the") (fixed? c (third xs)))
                      ((or (and (string=? op "string-length") (i64= (size xs) 2))
                           (and (or (string=? op "+") (string=? op "-")) (i64= (size xs) 3)))
                       (not (any? (lambda ((a sexp)) (not (fixed? c a))) (cdr xs))))
                      (else #f))))
            (else other #f)))))))

(define bounds-put (subr kfx (string bool) (listof bool acyclic))
  (lambda (op holds)
    "The bounds `op`, holding or not, puts on its left operand: below `#t`."
    (cond ((or (and (or (string=? op "<") (string=? op "<=")) holds) (and (or (string=? op ">") (string=? op ">=")) (not holds)))
           (the (listof bool acyclic) (list #f)))
          ((or (and (or (string=? op "<") (string=? op "<=")) (not holds)) (and (or (string=? op ">") (string=? op ">=")) holds))
           (the (listof bool acyclic) (list #t)))
          ((and (string=? op "=") holds) (the (listof bool acyclic) (list #t #f)))
          (else nil))))

(define guards-on (subr kfx (wc sexp sexp (listof bool acyclic)) guards)
  (lambda (c x other bounds)
    (if (fixed? c other)
        (concat (map (lambda ((t tracked))
                       (tagcase t
                         (int-of (p o) (map (lambda ((b bool)) (guard p b)) bounds))
                         (else other nil)))
                     (tracked-of c x)))
        nil)))

(define-rec
  (facts-of (subr kfx (wc sexp bool) guards)
    (lambda (c test holds)
      "The bounds on parameters that `test` having the value `holds` shows."
      (tagcase test
        (lst (xs src-file src-line src-pos)
          (let ((op (std-op c (car xs))))
            (cond ((and (string=? op "not") (i64= (size xs) 2)) (facts-of c (second xs) (not holds)))
                  ((and (i64= (size xs) 3) (not (null? (bounds-put op holds))))
                   (onto (guards-on c (second xs) (third xs) (bounds-put op holds))
                         (guards-on c (third xs) (second xs) (map (lambda ((b bool)) (not b)) (bounds-put op holds)))))
                  ((and (sym-is? (car xs) "and") holds (i64> (size xs) 2))
                   (concat (map (lambda ((a sexp)) (facts-of c a #t)) (cdr xs))))
                  ((and (sym-is? (car xs) "or") (not holds) (i64> (size xs) 2))
                   (concat (map (lambda ((a sexp)) (facts-of c a #f)) (cdr xs))))
                  (else nil))))
        (else other nil)))))

(define in-scope (subr kfx (wc knowns) wc)
  (lambda (c more) (tagcase c (wc (v ms cur sc gs nats inv) (wc v ms cur (onto more sc) gs nats inv)))))

(define hiding (subr kfx (wc strings) wc)
  (lambda (c names) (in-scope c (map (lambda ((n string)) (known n nil)) names))))

(define guarded (subr kfx (wc guards) wc)
  (lambda (c more) (tagcase c (wc (v ms cur sc gs nats inv) (wc v ms cur sc (onto more gs) nats inv)))))

(define has-bound? (subr kfx (wc i64 bool) bool)
  (lambda (c p lower)
    (tagcase c
      (wc (v ms cur sc gs nats inv)
        (or (any? (lambda ((g guard)) (tagcase g (guard (q b) (and (i64= q p) (eqv-bool? b lower))))) gs)
            (and lower (any? (lambda ((n i64)) (i64= n p)) nats)))))))

(define-rec
  (with-edge (subr kfx (edges i64 i64 bool) edges)
    (lambda (es from to strict)
      "A graph, kept in order of its edges' slots, with an edge more."
      (cond ((null? es) (the edges (list (edge from to strict))))
            (else
             (tagcase (car es)
               (edge (f t s)
                 (cond ((and (i64= f from) (i64= t to)) (cons (edge f t (or s strict)) (cdr es)))
                       ((or (i64< from f) (and (i64= from f) (i64< to t))) (cons (edge from to strict) es))
                       (else (cons (car es) (with-edge (cdr es) from to strict)))))))))))

(define arg-edges (subr kfx (wc i64 trackeds edges) edges)
  (lambda (c q ts g)
    "The edges to argument `q`, from what is known of it."
    (if (null? ts)
        g
        (arg-edges c q (cdr ts)
          (tagcase (car ts)
            (part (p strict ty) (with-edge g (i64* p 3) (i64* q 3) strict))
            (int-of (p off)
              (let* ((lo (has-bound? c p #t))
                     (hi (has-bound? c p #f))
                     (g (cond ((and (i64< off 0) lo) (with-edge g (i64+ (i64* p 3) 1) (i64+ (i64* q 3) 1) #t))
                              ((not (i64> off 0)) (with-edge g (i64+ (i64* p 3) 1) (i64+ (i64* q 3) 1) #f))
                              (else g))))
                (cond ((and (i64> off 0) hi) (with-edge g (i64+ (i64* p 3) 2) (i64+ (i64* q 3) 2) #t))
                      ((not (i64< off 0)) (with-edge g (i64+ (i64* p 3) 2) (i64+ (i64* q 3) 2) #f))
                      (else g)))))))))

(define-rec
  (args-edges (subr kfx (wc sexps i64 edges) edges)
    (lambda (c args q g)
      (if (null? args) g (args-edges c (cdr args) (i64+ q 1) (arg-edges c q (tracked-of c (car args)) g))))))

(define passed-on (subr kfx (wc sexp) i64)
  (lambda (c a)
    (let ((unchanged (concat (map (lambda ((t tracked)) (tagcase t (part (p strict ty) (if strict nil (the i64s (list p)))) (else other nil)))
                                  (tracked-of c a)))))
      (if (null? unchanged) -1 (car unchanged)))))

(define call-found (subr kfx (wc ws i64 sexps) ws)
  (lambda (c st to args)
    (tagcase c
      (wc (v ms cur sc gs nats inv)
        (tagcase st
          (ws (calls passed escaped)
            (ws (cons (scall cur to (args-edges c args 0 nil)) calls)
                (cons (passing cur to (map (lambda ((a sexp)) (passed-on c a)) args)) passed)
                escaped)))))))

(define escaping (subr kfx (ws) ws)
  (lambda (st) (tagcase st (ws (calls passed escaped) (ws calls passed #t)))))

(define param-names (subr kfx (sexps) strings)
  (lambda (params)
    (map (lambda ((p sexp)) (tagcase p (sym (n) n) (lst (xs f l o) (sym-name (car xs))) (else other ""))) params)))

(define variant-part (subr kfx (cv trackeds string i64) trackeds)
  (lambda (v whole tag i)
    "What an arm of a `tagcase` on `whole` binds for its field `i`: a part,
     strictly smaller, of the type the variant says if the whole's is known."
    (concat
     (map (lambda ((t tracked))
            (tagcase t
              (part (p strict ty)
                (the trackeds
                  (list (part p #t
                          (if (null? ty) nil
                              (tagcase (car ty)
                                (ty-data (d args)
                                  (let ((found (find-family d (cv-dts v))))
                                    (if (null? found) nil
                                        (tagcase (car found)
                                          (dt (n ps vs)
                                            (let ((fs (concat (map (lambda ((x variant)) (tagcase x (variant (vt ft) (if (string=? vt tag) ft nil)))) vs))))
                                              (map (lambda ((f ty)) (substitute ps args f)) (nth-ty fs i))))))))
                                (else other nil)))))))
              (else other nil)))
          whole))))

(define-rec
  (walk-all (subr kfx (wc ws sexps) ws)
    (lambda (c st es) (if (null? es) st (walk-all c (walk-exp c st (car es)) (cdr es)))))

  (walk-exp (subr kfx (wc ws sexp) ws)
    (lambda (c st e)
      (tagcase e
        (sym (n) (if (i64< (wc-member c n) 0) st (escaping st)))
        (lst (xs src-file src-line src-pos)
          (let ((h (tagcase (car xs) (sym (n) n) (else other ""))))
            (cond ((or (not (well-formed? h (cdr xs)))
                       (and (or (string=? h "lambda") (string=? h "the")) (i64< (size xs) 3)))
                   st)
                  ((string=? h "if")
                   (let ((st (walk-exp c st (second xs))))
                     (walk-exp (guarded c (facts-of c (second xs) #f))
                               (walk-exp (guarded c (facts-of c (second xs) #t)) st (third xs))
                               (fourth xs))))
                  ((string=? h "cond") (walk-clauses c st (cdr xs)))
                  ((string=? h "case")
                   (walk-all c (walk-exp c st (second xs))
                             (concat (map (lambda ((arm sexp)) (cdr (items arm))) (cdr (cdr xs))))))
                  ((string=? h "tagcase") (walk-arms c (walk-exp c st (second xs)) (tracked-of c (second xs)) (cdr (cdr xs))))
                  ((string=? h "let")
                   (let ((st (walk-all c st (map (lambda ((b sexp)) (second (items b))) (items (second xs))))))
                     (walk-all (in-scope c (map (lambda ((b sexp)) (known (sym-name (car (items b))) (tracked-of c (second (items b)))))
                                                (items (second xs))))
                               st (cdr (cdr xs)))))
                  ((string=? h "let*") (walk-let* c st (items (second xs)) (cdr (cdr xs))))
                  ((string=? h "letrec")
                   (let ((c (hiding c (map (lambda ((b sexp)) (sym-name (car (items b)))) (items (second xs))))))
                     (walk-all c (walk-all c st (map (lambda ((b sexp)) (third (items b))) (items (second xs)))) (cdr (cdr xs)))))
                  ((string=? h "letregion") (walk-all c st (cdr (cdr xs))))
                  ((string=? h "lambda") (walk-all (hiding c (param-names (items (second xs)))) st (cdr (cdr xs))))
                  ((string=? h "the") (walk-exp c st (third xs)))
                  ((string=? h "with")
                   (tagcase c
                     (wc (v ms cur sc gs nats inv)
                       (walk-all (hiding c (map (lambda ((b bind)) (tagcase b (bind (n t w) n)))
                                                (opened-binds (sym-name (second xs)) (cv-binds v))))
                                 st (cdr (cdr xs))))))
                  ((or (string=? h "begin") (string=? h "and") (string=? h "or") (string=? h "list") (string=? h "prompt"))
                   (walk-all c st (cdr xs)))
                  ((and (not (string=? h "")) (not (i64< (wc-member c h) 0)))
                   (walk-all c (call-found c st (wc-member c h) (cdr xs)) (cdr xs)))
                  (else (walk-all c st xs)))))
        (else other st))))

  (walk-clauses (subr kfx (wc ws sexps) ws)
    (lambda (c st clauses)
      "A `cond`, as the `if`s FX-26 reads it as: each clause's body under its
       test, and every clause after it under the test failing."
      (if (null? clauses)
          st
          (let ((clause (items (car clauses))))
            (if (sym-is? (car clause) "else")
                (walk-all c st (cdr clause))
                (let ((st (walk-exp c st (car clause))))
                  (walk-clauses (guarded c (facts-of c (car clause) #f))
                                (walk-all (guarded c (facts-of c (car clause) #t)) st (cdr clause))
                                (cdr clauses))))))))

  (walk-arms (subr kfx (wc ws trackeds sexps) ws)
    (lambda (c st whole arms)
      (if (null? arms)
          st
          (let ((arm (items (car arms))))
            (walk-arms c
              (if (sym-is? (car arm) "else")
                  (walk-all (in-scope c (the knowns (list (known (sym-name (second arm))
                                                     (concat (map (lambda ((t tracked)) (tagcase t (part (p s ty) (the trackeds (list t))) (else other nil)))
                                                                  whole))))))
                            st (cdr (cdr arm)))
                  (walk-all (in-scope c (fields-known c whole (sym-name (car arm)) (items (second arm)) 0))
                            st (cdr (cdr arm))))
              whole (cdr arms))))))

  (fields-known (subr kfx (wc trackeds string sexps i64) knowns)
    (lambda (c whole tag names i)
      (if (null? names)
          nil
          (tagcase c
            (wc (v ms cur sc gs nats inv)
              (cons (known (sym-name (car names)) (variant-part v whole tag i))
                    (fields-known c whole tag (cdr names) (i64+ i 1))))))))

  (walk-let* (subr kfx (wc ws sexps sexps) ws)
    (lambda (c st bindings body)
      (if (null? bindings)
          (walk-all c st body)
          (let ((b (items (car bindings))))
            (walk-let* (in-scope c (the knowns (list (known (sym-name (car b)) (tracked-of c (second b))))))
                       (walk-exp c st (second b))
                       (cdr bindings) body))))))

"A member of a group: its name, parameters, their types, and its body."
(define-datatype rec-member (rec-member string strings tys sexps))
(define-type rec-members (listof rec-member acyclic))

(define lambda-of (subr kfx (sexp) sexps)
  (lambda (e)
    "A definition's lambda, under a `plambda`: as a list of one, or none."
    (cond ((head-is? e "plambda") (if (head-is? (third (items e)) "lambda") (the sexps (list (third (items e)))) nil))
          ((head-is? e "lambda") (the sexps (list e)))
          (else nil))))

(define-rec
  (param-knowns (subr kfx (strings tys i64) knowns)
    (lambda (names ts j)
      (if (or (null? names) (null? ts))
          nil
          (cons (known (car names)
                       (cons (part j #f (the tys (list (car ts))))
                             (tagcase (car ts)
                               (ty-int () (the trackeds (list (int-of j 0))))
                               (ty-nat () (the trackeds (list (int-of j 0))))
                               (else other nil))))
                (param-knowns (cdr names) (cdr ts) (i64+ j 1)))))))

(define-rec
  (nat-params (subr kfx (tys i64) i64s)
    (lambda (ts j)
      (cond ((null? ts) nil)
            ((tagcase (car ts) (ty-nat () #t) (else other #f)) (cons j (nat-params (cdr ts) (i64+ j 1))))
            (else (nat-params (cdr ts) (i64+ j 1)))))))

(define-rec
  (walk-rec-members (subr kfx (cv strings rec-members i64 slots ws) ws)
    (lambda (v names ms i inv st)
      (cond ((null? ms) st)
            ((tagcase st (ws (calls passed escaped) escaped)) st)
            (else
             (tagcase (car ms)
               (rec-member (n ps ts body)
                 (walk-rec-members v names (cdr ms) (i64+ i 1) inv
                               (walk-all (wc v names i (param-knowns ps ts 0) nil (nat-params ts 0) inv) st body)))))))))

(define slot-in? (subr kfx (i64 i64 slots) bool)
  (lambda (i j inv) (any? (lambda ((x slot)) (tagcase x (slot (a b) (and (i64= a i) (i64= b j))))) inv)))

(define-rec
  (nth-i64 (subr kfx (i64s i64) i64)
    (lambda (xs i) (cond ((null? xs) -1) ((i64= i 0) (car xs)) (else (nth-i64 (cdr xs) (i64- i 1)))))))

(define kept-slots (subr kfx (slots passings) slots)
  (lambda (inv passed)
    "The slots every call passes on unchanged, of those still thought so."
    (concat
     (map (lambda ((x slot))
            (tagcase x
              (slot (to j)
                (if (any? (lambda ((p passing))
                            (tagcase p
                              (passing (f t args)
                                (and (i64= t to)
                                     (let ((q (nth-i64 args j)))
                                       (or (i64< q 0) (not (slot-in? f q inv))))))))
                          passed)
                    nil
                    (the slots (list x))))))
          inv))))

(define-rec
  (invariant (subr kfx (slots passings) slots)
    (lambda (inv passed)
      (let ((next (kept-slots inv passed)))
        (if (i64= (size next) (size inv)) inv (invariant next passed))))))

(define-rec
  (counting (subr kfx (i64 i64) i64s)
    (lambda (from n) (if (i64< from n) (cons from (counting (i64+ from 1) n)) nil))))

(define-rec
  (all-slots (subr kfx (rec-members i64) slots)
    (lambda (ms i)
      (if (null? ms)
          nil
          (tagcase (car ms)
            (rec-member (n ps ts body)
              (onto (map (lambda ((j i64)) (slot i j)) (counting 0 (size ps)))
                    (all-slots (cdr ms) (i64+ i 1)))))))))

(define-rec
  (fold-to (subr kfx (edges i64 i64 bool edges) edges)
    (lambda (b x y s1 out)
      (if (null? b)
          out
          (fold-to (cdr b) x y s1
            (tagcase (car b)
              (edge (y2 z s2) (if (i64= y y2) (with-edge out x z (or s1 s2)) out))))))))

(define-rec
  (fold-edges (subr kfx (edges edges edges) edges)
    (lambda (a b out)
      (if (null? a)
          out
          (fold-edges (cdr a) b
            (tagcase (car a)
              (edge (x y s1)
                (fold-to b x y s1 out))))))))

(define compose (subr kfx (edges edges) edges)
  (lambda (a b)
    (fold-edges a b nil)))

(define-rec
  (edges=? (subr kfx (edges edges) bool)
    (lambda (a b)
      (cond ((null? a) (null? b))
            ((null? b) #f)
            (else
             (and (tagcase (car a)
                    (edge (x y s)
                      (tagcase (car b) (edge (x2 y2 s2) (and (i64= x x2) (i64= y y2) (eqv-bool? s s2))))))
                  (edges=? (cdr a) (cdr b))))))))

(define scall=? (subr kfx (scall scall) bool)
  (lambda (a b)
    (tagcase a (scall (f g es) (tagcase b (scall (f2 g2 es2) (and (i64= f f2) (i64= g g2) (edges=? es es2))))))))

"The closure of the calls under composition stops past this many."
(define most-graphs i64 500)

(define-rec
  (paths (subr kfx (scalls scalls scalls) scalls)
    (lambda (calls all todo)
      "Every path of calls, as a graph; none if there are too many."
      (cond ((null? todo) all)
            ((i64> (size all) most-graphs) nil)
            (else
             (tagcase (car todo)
               (scall (f g a)
                 (close-over calls all (cdr todo) f a
                         (concat (map (lambda ((x scall)) (tagcase x (scall (g2 h b) (if (i64= g2 g) (the scalls (list x)) nil)))) calls)))))))))

  (close-over (subr kfx (scalls scalls scalls i64 edges scalls) scalls)
    (lambda (calls all todo f a nexts)
      (if (null? nexts)
          (paths calls all todo)
          (tagcase (car nexts)
            (scall (g h b)
              (let ((c (scall f h (compose a b))))
                (if (any? (lambda ((x scall)) (scall=? x c)) all)
                    (close-over calls all todo f a (cdr nexts))
                    (close-over calls (cons c all) (cons c todo) f a (cdr nexts))))))))))

(define ends? (subr kfx (scalls) bool)
  (lambda (calls)
    "The size-change criterion: every graph from a member to itself that is
     its own composition has a slot strictly smaller."
    (let ((all (paths calls calls calls)))
      (and (not (null? all))
           (not (any? (lambda ((x scall))
                        (tagcase x
                          (scall (f g a)
                            (and (i64= f g) (edges=? (compose a a) a)
                                 (not (any? (lambda ((e edge)) (tagcase e (edge (p q s) (and (i64= p q) s)))) a))))))
                      all))))))

(define-rec
  (rec-members-of (subr kfx (strings tys sexps) rec-members)
    (lambda (names types lambdas)
      (if (null? names)
          nil
          (cons (rec-member (car names)
                        (param-names (items (second (items (car lambdas)))))
                        (tagcase (car types) (ty-proc (es ps r) ps) (else other nil))
                        (cdr (cdr (items (car lambdas)))))
                (rec-members-of (cdr names) (cdr types) (cdr lambdas)))))))

(define terminates? (subr kfx (cv strings tys sexps) bool)
  (lambda (v names types defined)
    "Whether every run of the group ends: `names`, their types, and their
     lambdas. A member not a lambda, or named other than as a call's
     operator, and it does not."
    (let ((lambdas (map lambda-of defined)))
      (if (any? (lambda ((l sexps)) (null? l)) lambdas)
          #f
          (let* ((ms (rec-members-of names types (map (lambda ((l sexps)) (car l)) lambdas)))
                 (w1 (walk-rec-members v names ms 0 nil (ws nil nil #f))))
            (if (tagcase w1 (ws (calls passed escaped) escaped))
                #f
                (let* ((inv (invariant (all-slots ms 0) (tagcase w1 (ws (calls passed escaped) passed))))
                       (w2 (if (null? inv) w1 (walk-rec-members v names ms 0 inv (ws nil nil #f)))))
                  (and (not (tagcase w2 (ws (calls passed escaped) escaped)))
                       (ends? (tagcase w2 (ws (calls passed escaped) calls)))))))))))

(define knot-free-call (subr kfx (cv res) res)
  (lambda (v r)
    "A call's value, whose type, an instance, ties no knot through the store."
    (tagcase r
      (res (t es s)
        (begin (no-knot v (lambda ((x string)) (resolve-atom s x)) (zonk s t)) r)))))

(define control-form? (subr kfx (string) bool)
  (lambda (h)
    (or (string=? h "if") (string=? h "cond") (string=? h "case") (string=? h "tagcase")
        (string=? h "let") (string=? h "let*") (string=? h "begin") (string=? h "letrec")
        (string=? h "letregion") (string=? h "with"))))

(define opened-aliases (subr kfx (string aliases) aliases)
  (lambda (m as)
    "Module `m`'s types, named as `m` names them."
    (if (null? as)
        nil
        (tagcase (car as)
          (alias (n ps body)
            (if (has-prefix? n (string-append m " "))
                (cons (alias (after-prefix n (string-append m " ")) ps body) (opened-aliases m (cdr as)))
                (opened-aliases m (cdr as))))))))

(define opened (subr kfx (cv string) cv)
  (lambda (v m)
    "`v`, in a `(with m ...)`."
    (tagcase v
      (cv (bs ds as es here group file line fs tv at)
        (cv (bind-onto (opened-binds m bs) bs) ds (onto (opened-aliases m as) as) es here group file line fs tv at)))))

(define case-data? (subr kfx (string sexps) bool)
  (lambda (kind xs)
    "Whether `xs` are literals a case on a `kind` compares with."
    (not (any? (lambda ((x sexp))
                 (not (tagcase x
                        (chr (c) (string=? kind "char"))
                        (num (k text pos) (string=? kind "int"))
                        (str (t) (string=? kind "string"))
                        (sym (n) (and (string=? kind "bool") (or (string=? n "#t") (string=? n "#f"))))
                        (else other #f))))
               xs))))

(define all-chars? (subr kfx (sexps) bool)
  (lambda (xs) (not (any? (lambda ((x sexp)) (tagcase x (chr (c) #f) (else other #t))) xs))))

(define bind-fields (subr kfx (cv sexps tys) binds)
  (lambda (v names types)
    (if (null? names)
        nil
        (cons (local v (name-of v (car names)) (car types)) (bind-fields v (cdr names) (cdr types))))))

(define bind-params (subr kfx (cv sexps tys) binds)
  (lambda (v params types)
    (if (null? params)
        nil
        (cons (local v (param-name (car params)) (car types)) (bind-params v (cdr params) (cdr types))))))

(define find-dt (subr kfx (string dts) (listof variants acyclic))
  (lambda (d ds)
    (cond ((null? ds) nil)
          (else (tagcase (car ds) (dt (n ps vs) (if (string=? n d) (list vs) (find-dt d (cdr ds)))))))))

(define family-of (subr kfx (cv string) strings)
  (lambda (v d)
    "A datatype's parameters."
    (let ((found (find-family d (cv-dts v))))
      (if (null? found) nil (tagcase (car found) (dt (n ps vs) ps))))))

(define instantiate-variants (subr kfx (strings tys variants) variants)
  (lambda (params args vs)
    "Variants whose fields' types are of the datatype's parameters, at
     `args`."
    (map (lambda ((x variant))
           (tagcase x (variant (tag fields) (variant tag (map (lambda ((f ty)) (substitute params args f)) fields)))))
         vs)))

(define variants-of (subr kfx (cv string) variants)
  (lambda (v d)
    (let ((found (find-dt d (cv-dts v))))
      (if (null? found) (refuse v (string-append "no datatype is named " d)) (car found)))))

(define variant-fields (subr kfx (cv string string variants) tys)
  (lambda (v d tag vs)
    (cond ((null? vs)
           (refuse v (string-append tag (string-append " is no tag of " (string-append d ", or has an arm already")))))
          (else (tagcase (car vs)
                  (variant (t fields) (if (string=? t tag) fields (variant-fields v d tag (cdr vs)))))))))

(define without-tag (subr kfx (string variants) variants)
  (lambda (tag vs)
    (cond ((null? vs) nil)
          (else (tagcase (car vs)
                  (variant (t fields) (if (string=? t tag) (cdr vs) (cons (car vs) (without-tag tag (cdr vs))))))))))

(define-rec
  (synth (subr kfx (cv st sexp) res)
    (lambda (v s e)
      (tagcase e
        (num (k num-file num-pos) (res (ty-int) nil (note-fact s num-file num-pos "int")))
        (chr (c) (res (ty-char) nil s))
        (real (x) (res (ty-f64) nil s))
        (str (x) (res (ty-string) nil s))
        (sym (name) (synth-name v s name))
        (lst (xs src-file src-line src-pos)
          (let ((v (near v src-file src-line src-pos)))
            (tagcase (car xs)
              (sym (h) (synth-form v s e h (cdr xs)))
              (else head (synth-call-of v s (synth v s head) (cdr xs) nil nil (list "spin")))))))))

  (synth-name (subr kfx (cv st string) res)
    (lambda (v s name)
      (cond ((or (string=? name "#t") (string=? name "#f")) (res (ty-bool) nil s))
            ((string=? name "#u") (res (ty-unit) nil s))
            (else
             (let ((found (find-bind name (cv-binds v))))
               (if (null? found)
                   (refuse v (string-append "nothing is named " name))
                   (tagcase (car found)
                     (bind (n sc where)
                       (if (string=? where "module")
                           (refuse v (string-append "a module as a value: KFX's modules are Rust's, opened by with: " name))
                           (tagcase (instantiate s sc)
                             (inst (t s regions) (res t (naming-effs s name where t) s))))))))))))

  (check (subr kfx (cv st sexp ty) res)
    (lambda (v s e expected)
      (let ((x (walk s expected)))
        (tagcase e
          (num (k num-file num-pos)
            "A literal is an `i64` where one is expected, and otherwise an
             `int`, as in FX-26: an inference variable it meets is solved
             to `int`."
            (tagcase x
              (ty-i64 () (res x nil s))
              (ty-int () (res x nil (note-fact s num-file num-pos "int")))
              (ty-nat ()
                (if (i64< k 0)
                    (refuse v (string-append (i64->string k) " is no nat"))
                    (res x nil (note-fact s num-file num-pos "int"))))
              (ty-meta (m) (res (ty-int) nil (note-fact (solve s m (ty-int)) num-file num-pos "int")))
              (else other (refuse v (string-append "a literal is here, where a "
                                                   (string-append (show-ty s x) " is expected"))))))
          (lst (xs src-file src-line src-pos)
            (let ((v (near v src-file src-line src-pos)))
              (tagcase (car xs)
                (sym (h) (check-form v s e h (cdr xs) x))
                (else other (check-by-synth v s e x)))))
          (sym (name)
            (if (string=? name "nil")
                (tagcase x
                  (ty-list (el r) (res x nil s))
                  (else other (check-by-synth v s e x)))
                (check-by-synth v s e x)))
          (else other (check-by-synth v s e x))))))

  (check-by-synth (subr kfx (cv st sexp ty) res)
    (lambda (v s e expected)
      (tagcase (synth v s e)
        (res (t es s) (res expected es (fits v s t expected))))))

  (body (subr kfx (cv st sexps tys) res)
    (lambda (v s es expected)
      "A body: each expression but the last for its effect, the last
       checked against `expected` if it has one type in it, else found."
      (if (null? (cdr es))
          (if (null? expected) (synth v s (car es)) (check v s (car es) (car expected)))
          (tagcase (synth-any v s (car es))
            (res (t es0 s) (with-effs (body v s (cdr es) expected) es0))))))

  (synth-any (subr kfx (cv st sexp) res)
    (lambda (v s e)
      "An expression whose value is dropped: a string is a comment."
      (tagcase e
        (str (x) (res (ty-unit) nil s))
        (else other (synth v s e)))))

  (synth-form (subr kfx (cv st sexp string sexps) res)
    (lambda (v s e h xs)
      (cond ((string=? h "the")
             (check v s (second xs) (parse-type v (cv-tvars v) (car xs))))
            ((string=? h "prompt") (prompt-form v s xs nil))
            ((string=? h "lambda") (synth-lambda v s (items (car xs)) (cdr xs)))
            ((string=? h "list")
             (if (null? xs)
                 (tagcase (fresh s) (res (m es s) (res (ty-list m (ty-rconst "acyclic")) nil s)))
                 (tagcase (synth v s (car xs))
                   (res (t es0 s)
                     (with-effs (check v s e (ty-list t (ty-rconst "acyclic"))) es0)))))
            ((control-form? h) (body-form v s h xs nil))
            ((string=? h "and") (bools v s xs))
            ((string=? h "or") (bools v s xs))
            (else (synth-call v s h xs nil)))))

  (check-form (subr kfx (cv st sexp string sexps ty) res)
    (lambda (v s e h xs expected)
      (cond ((control-form? h) (body-form v s h xs (list expected)))
            ((string=? h "prompt") (prompt-form v s xs (list expected)))
            ((and (string=? h "lambda") (proc-type? s expected))
             (check-lambda v s (items (car xs)) (cdr xs) (walk s expected)))
            ((and (string=? h "list") (tagcase expected (ty-list (el r) #t) (else other #f)))
             (tagcase expected
               (ty-list (el r)
                 (tagcase (elements v s xs el)
                   (res (u es s)
                     (tagcase (region-of v s r)
                       (res (rr rn s) (res expected (effs-union (list (string-append "alloc:" (region-string s rr))) es) s))))))
               (else other (check-by-synth v s e expected))))
            ((or (string=? h "the") (string=? h "and") (string=? h "or") (string=? h "lambda") (string=? h "list"))
             (check-by-synth v s e expected))
            (else (synth-call v s h xs (list expected))))))

  (elements (subr kfx (cv st sexps ty) res)
    (lambda (v s xs el)
      "A list's elements, each checked as `el`: their effect, and the state,
       which carries their facts."
      (if (null? xs)
          (res el nil s)
          (tagcase (check v s (car xs) el)
            (res (t es s) (with-effs (elements v s (cdr xs) el) es))))))

  (bools (subr kfx (cv st sexps) res)
    (lambda (v s xs)
      (if (null? xs)
          (res (ty-bool) nil s)
          (tagcase (check v s (car xs) (ty-bool))
            (res (t es s) (with-effs (bools v s (cdr xs)) es))))))

  (body-form (subr kfx (cv st string sexps tys) res)
    (lambda (v s h xs expected)
      "`if`, `cond`, `case`, `tagcase`, `let`, `let*` and `begin`: forms
       whose last parts give the value; `expected` is the type, if known."
      (cond ((not (well-formed? h xs))
             (refuse v (string-append "a (" (string-append h " ...) not of the form FX-26 has"))))
            ((string=? h "if")
             (tagcase (check v s (car xs) (ty-bool))
               (res (t es s) (with-effs (arms v s (cdr xs) expected) es))))
            ((string=? h "begin") (body v s xs expected))
            ((string=? h "let")
             (let-values v s (items (car xs)) (cdr xs) expected nil #f))
            ((string=? h "let*")
             (let-values v s (items (car xs)) (cdr xs) expected nil #t))
            ((string=? h "letrec") (letrec-form v s (items (car xs)) (cdr xs) expected))
            ((string=? h "letregion") (letregion-form v s (name-of v (car xs)) (cdr xs) expected))
            ((string=? h "with")
             "`(with m body ...)`: `m`'s values and types in scope in the body,
              shadowing what is outside, locals too, as FX-26 has it; `m` a
              module defined at the top level, reading which is reading a
              global."
             (let* ((m (name-of v (car xs)))
                    (found (find-bind m (cv-binds v))))
               (if (or (null? found) (not (tagcase (car found) (bind (n sc where) (string=? where "module")))))
                   (refuse v (string-append "KFX's with opens a module defined at the top level, by its name: " m))
                   (with-effs (body (opened v m) s (cdr xs) expected) (list (string-append "g:" m))))))
            ((string=? h "cond") (cond-clauses v s xs expected))
            ((string=? h "case")
             "On a character, an integer, a string or a boolean, the data
              literals of its type; the kind told the emitter."
             (tagcase (synth v s (car xs))
               (res (t es s)
                 (let ((kind (tagcase (walk s t)
                               (ty-char () "char") (ty-int () "int") (ty-nat () "int")
                               (ty-string () "string") (ty-bool () "bool")
                               (else other (refuse v (string-append "KFX's case is on characters, ints, strings and booleans, and this is a "
                                                                    (show-ty s t)))))))
                   (with-effs (case-arms v (note-fact s (cv-file v) (cv-pos v) (string-append "case " kind)) kind (cdr xs) expected)
                              es)))))
            (else
             (tagcase (synth v s (car xs))
               (res (t es s)
                 (tagcase (walk s t)
                   (ty-data (d args)
                     (with-effs (tag-arms v s (walk s t) (cdr xs)
                                          (instantiate-variants (family-of v d) args (variants-of v d))
                                          expected)
                                es))
                   (else other (refuse v (string-append "tagcase of a " (string-append (show-ty s t) ", no datatype")))))))))))

  (arms (subr kfx (cv st sexps tys) res)
    (lambda (v s branches expected)
      "Branches of one type: the first found, if none is expected, and the
       rest checked against it."
      (tagcase (body v s (list (car branches)) expected)
        (res (t es s)
          (if (null? (cdr branches))
              (res t es s)
              (tagcase (arms v s (cdr branches) (next-expected s t expected))
                (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) s))))))))

  (cond-clauses (subr kfx (cv st sexps tys) res)
    (lambda (v s clauses expected)
      (let ((clause (items (car clauses))))
        (if (sym-is? (car clause) "else")
            (if (null? (cdr clauses))
                (body v s (cdr clause) expected)
                (refuse v "a cond's else is its last clause"))
            (if (null? (cdr clauses))
                (refuse v "a cond needs an else: FX has no unspecified value")
                (tagcase (check v s (car clause) (ty-bool))
                  (res (t0 es0 s)
                    (tagcase (body v s (cdr clause) expected)
                      (res (t es s)
                        (tagcase (cond-clauses v s (cdr clauses) (next-expected s t expected))
                          (res (t2 es2 s)
                            (res (joined s t t2 expected) (effs-union es0 (effs-union es es2)) s))))))))))))

  (case-arms (subr kfx (cv st string sexps tys) res)
    (lambda (v s kind cases expected)
      (let ((arm (items (car cases))))
        (cond ((sym-is? (car arm) "else")
               (if (null? (cdr cases))
                   (body v s (cdr arm) expected)
                   (refuse v "a case's else is its last arm")))
              ((null? (cdr cases)) (refuse v "a case needs an else: FX has no unspecified value"))
              ((not (case-data? kind (items (car arm))))
               (refuse v (string-append "a case on a " (string-append kind "'s data are literals of its type"))))
              (else
               (tagcase (body v (case-data v s kind (items (car arm))) (cdr arm) expected)
                 (res (t es s)
                   (tagcase (case-arms v s kind (cdr cases) (next-expected s t expected))
                     (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) s))))))))))

  (case-data (subr kfx (cv st string sexps) st)
    (lambda (v s kind xs)
      "A case's data, an int's checked as ints, so that the emitter writes
       them as ints."
      (if (or (null? xs) (not (string=? kind "int")))
          s
          (tagcase (check v s (car xs) (ty-int)) (res (t es s) (case-data v s kind (cdr xs)))))))

  (tag-arms (subr kfx (cv st ty sexps variants tys) res)
    (lambda (v s whole tagged vs expected)
      "A tagcase's arms; `vs` are the variants no arm has taken yet."
      (if (null? tagged)
          (if (null? vs)
              (if (null? expected) (refuse v "a tagcase with no arms") (res (car expected) nil s))
              (refuse v (string-append "a tagcase of a " (string-append (show-ty s whole) " with no else, and no arm for each tag"))))
          (let* ((arm (items (car tagged)))
                 (tag (name-of v (car arm))))
            (if (string=? tag "else")
                (if (null? (cdr tagged))
                    (body (with-binds v (list (local v (name-of v (second arm)) whole)))
                          s (cdr (cdr arm)) expected)
                    (refuse v "a tagcase's else is its last arm"))
                (let* ((fields (variant-fields v (show-ty s whole) tag vs))
                       (names (items (second arm))))
                  (if (not (i64= (size names) (size fields)))
                      (refuse v (string-append "the arm for " (string-append tag " names the wrong number of fields")))
                      (tagcase (body (with-binds v (bind-fields v names fields)) s (cdr (cdr arm)) expected)
                        (res (t es s)
                          (tagcase (tag-arms v s whole (cdr tagged) (without-tag tag vs) (next-expected s t expected))
                            (res (t2 es2 s) (res (joined s t t2 expected) (effs-union es es2) s))))))))))))

  (let-values (subr kfx (cv st sexps sexps tys binds bool) res)
    (lambda (v s bindings forms expected bound sequential)
      "A `let`'s or `let*`'s bindings, then its body. `bound`: those made
       so far, which a `let*`'s next binding sees and a `let`'s does not."
      (if (null? bindings)
          (body (with-binds v bound) s forms expected)
          (let* ((b (items (car bindings)))
                 (sees (if sequential (with-binds v bound) v)))
            (tagcase (synth sees s (second b))
              (res (t es s)
                (with-effs (let-values v s (cdr bindings) forms expected
                                       (cons (local v (name-of v (car b)) t) bound) sequential)
                           es)))))))

  (letrec-form (subr kfx (cv st sexps sexps tys) res)
    (lambda (v s bindings forms expected)
      "`(letrec ((f T lambda) ...) body ...)`: each procedure's type written,
       every one in scope in each lambda and in the body. A group whose every
       run ends is bound as `ends`, its calls no `spin`; else as locals."
      (let* ((ends (terminates? v (map (lambda ((b sexp)) (name-of v (car (items b)))) bindings)
                                (map (lambda ((b sexp)) (parse-type v (cv-tvars v) (second (items b)))) bindings)
                                (map (lambda ((b sexp)) (third (items b))) bindings)))
             (w (with-binds v (map (lambda ((b sexp))
                                     (let ((ys (items b)))
                                       (bind (name-of v (car ys)) (scheme nil (parse-type v (cv-tvars v) (second ys)))
                                             (if ends "ends" "local"))))
                                   bindings))))
        (tagcase (letrec-lambdas w s bindings)
          (res (u es s) (body w s forms expected))))))

  (letregion-form (subr kfx (cv st string sexps tys) res)
    (lambda (v s r forms expected)
      "`(letregion r body ...)`: a region for the body's types, its data the
       heap's. What the body does to it is masked, and the value may not
       mention it, as in FX-26. A region named already is refused, so that
       masking, by name, masks nothing else."
      (let ((name (string-append "'" r)))
        (if (string-member? name (cv-tvars v))
            (refuse v (string-append "a letregion of a region named already: " r))
            (tagcase (body (with-tvars v (list name)) s forms expected)
              (res (t es s)
                (if (mentions? s t name)
                    (refuse v (string-append "a letregion whose value's type mentions its region " r))
                    (res t (masked es name) s))))))))

  (letrec-lambdas (subr kfx (cv st sexps) res)
    (lambda (v s bindings)
      (if (null? bindings)
          (res (ty-unit) nil s)
          (let ((ys (items (car bindings))))
            (if (not (head-is? (third ys) "lambda"))
                (refuse v "a letrec binds only lambdas")
                (tagcase (check v s (third ys) (parse-type v (cv-tvars v) (second ys)))
                  (res (t es s) (letrec-lambdas v s (cdr bindings)))))))))

  (synth-lambda (subr kfx (cv st sexps sexps) res)
    (lambda (v s params forms)
      "A lambda with nothing expected: its parameters' types written."
      (let ((types (map (lambda ((p sexp))
                          (tagcase p
                            (lst (pt src-file src-line src-pos) (parse-type v (cv-tvars v) (second pt)))
                            (else other (refuse v (string-append "a lambda with nothing expected needs its parameters' types: " (show-sexp other))))))
                        params)))
        (tagcase (body (with-binds v (bind-params v params types)) s forms nil)
          (res (r es s) (res (ty-proc es types r) nil (if (escapes? es) (note-fact s (cv-file v) (cv-pos v) "fallible") s)))))))

  (check-lambda (subr kfx (cv st sexps sexps ty) res)
    (lambda (v s params forms expected)
      (tagcase expected
        (ty-proc (ees eps er)
          (if (not (i64= (size params) (size eps)))
              (refuse v "a lambda of the wrong number of parameters")
              (let ((s (check-written-params v s params eps)))
                (tagcase (body (with-binds v (bind-params v params eps)) s forms (list er))
                  (res (r es s)
                    (if (not (null? (fit-effs s es ees)))
                        (let ((s (car (fit-effs s es ees))))
                          (res expected nil (if (escapes? ees) (note-fact s (cv-file v) (cv-pos v) "fallible") s)))
                        (refuse v (string-append "a lambda whose effect " (string-append (show-effs es)
                                  (string-append " is not within " (show-effs ees)))))))))))
        (else other (refuse v "a lambda where no procedure is expected")))))

  (lambda-effects (subr kfx (cv st sexps sexps ty) res)
    (lambda (v s params forms t)
      "A lambda's body's effect, the body checked against the type `t`'s
       parameters and result, but not its effect: what `define*` finds."
      (tagcase t
        (ty-proc (ees eps er)
          (if (not (i64= (size params) (size eps)))
              (refuse v "a lambda of the wrong number of parameters")
              (body (with-binds v (bind-params v params eps))
                    (check-written-params v s params eps) forms (list er))))
        (else other (refuse v "a lambda where no procedure is expected")))))

  (check-written-params (subr kfx (cv st sexps tys) st)
    (lambda (v s params types)
      "A parameter written `(x T)` must be of the type expected. One written
       `x` must have its type known already, from the arguments before the
       lambda: rustc, which checks a call's arguments in order, finds a
       closure's parameter types no other way."
      (if (null? params)
          s
          (check-written-params v
                                (tagcase (car params)
                                  (lst (pt src-file src-line src-pos) (fits v s (car types) (parse-type v (cv-tvars v) (second pt))))
                                  (else other
                                    (if (has-meta? s (car types))
                                        (refuse v (string-append "the type of the lambda's parameter "
                                                    (string-append (show-sexp other)
                                                      " is not known from the arguments before it: write it as (x T)")))
                                        s)))
                                (cdr params) (cdr types)))))

  (synth-call (subr kfx (cv st string sexps tys) res)
    (lambda (v s h args expected)
      "A call of a name: a procedure in this group is `spin`, one that is a
       local's value is a call of a procedure not known, so `spin` too."
      (let ((found (find-bind h (cv-binds v))))
        (cond ((keyword? h)
               (refuse v (string-append "(" (string-append h " ...) is FX-26's form, which KFX does not have, or a call of a local named by that keyword"))))
              ((and (null? found) (string=? h "abort-current-continuation")) (abort-call v s args))
              ((and (null? found) (string=? h "make-continuation-prompt-tag")) (make-tag-call v s args expected))
              ((and (null? found)
                    (or (string=? h "call-with-composable-continuation") (string=? h "call-with-current-continuation")
                        (string=? h "call/cc")))
               (refuse v (string-append h " keeps a continuation, a comefrom, which KFX does not have: Rust has no frames to resume (docs/research/escapes.md)")))
              ((null? found)
               (refuse v (string-append "nothing is named " h)))
              ((and (nat-op? h) (prim? (car found)) (i64= (size args) 2) (nat-args? v s args))
               (tagcase (call-args v s args (list (ty-nat) (ty-nat)))
                 (res (u es s)
                   (res (ty-nat) es (if (null? expected) s (fits v s (ty-nat) (car expected)))))))
              (else
              (tagcase (car found)
                (bind (n sc where)
                  (tagcase (instantiate s sc)
                    (inst (t s regions)
                      (knot-free-call v (synth-call-of v s (res t nil s) args regions expected
                                     (effs-union
                                       (if (string=? where "global") (list (string-append "g:" h)) nil)
                                       (if (or (string=? where "local")
                                               (and (string-member? h (cv-group v)) (or (string=? where "global") (string=? where "item"))))
                                           (list "spin")
                                           nil)))))))))))))

  (nat-args? (subr kfx (cv st sexps) bool)
    (lambda (v s args)
      "Whether each argument is a `nat`: a literal not negative, or what
       its type is found to be. The finding is a test, its state dropped."
      (or (null? args)
          (and (tagcase (car args)
                 (num (k f p) (not (i64< k 0)))
                 (else other (tagcase (synth v s other) (res (t es s2) (nat? s2 t)))))
               (nat-args? v s (cdr args))))))

  (abort-call (subr kfx (cv st sexps) res)
    (lambda (v s args)
      "`(abort-current-continuation tag v)`: to the innermost prompt of
       `tag`, with `v`; a `goto` on the tag's region, and of type `void`."
      (if (not (i64= (size args) 2))
          (refuse v "abort-current-continuation takes a tag and a value")
          (tagcase (synth v s (car args))
            (res (t es0 s)
              (tagcase (walk s t)
                (ty-tag (a h d r)
                  (tagcase (check v s (second args) h)
                    (res (u es1 s)
                      (res (ty-void) (effs-union (list (string-append "goto:" (region-string s r))) (effs-union es0 es1)) s))))
                (else other (refuse v (string-append "an abort to a " (string-append (show-ty s t) ", no prompt-tag"))))))))))

  (make-tag-call (subr kfx (cv st sexps tys) res)
    (lambda (v s args expected)
      "`(make-continuation-prompt-tag)`: its type, said where it is made."
      (cond ((not (null? args)) (refuse v "make-continuation-prompt-tag takes nothing"))
            ((null? expected)
             (refuse v "a prompt tag whose type nothing says: write (the (prompt-tag A H D R) (make-continuation-prompt-tag))"))
            (else
             (tagcase (walk s (car expected))
               (ty-tag (a h d r) (res (car expected) (list (string-append "alloc:" (region-string s r))) s))
               (else other (refuse v "a prompt tag where none is expected")))))))

  (prompt-form (subr kfx (cv st sexps tys) res)
    (lambda (v s xs expected)
      "`(prompt tag body handler)`, as FX-26 has it: the body of the tag's
       answer type, its effect, but for control on the tag's region, within
       the tag's bound; an abort to the tag runs the handler. The prompt
       removes the `goto` on the region when the body can reach no other tag
       there: when nothing it names but the tag has a type that mentions the
       region (every name, bound in it or not: stricter than FX-26's free
       variables, never laxer)."
      (tagcase (synth v s (car xs))
        (res (tt es0 s)
          (tagcase (walk s tt)
            (ty-tag (a h d r)
              (let ((rn (region-string s r)))
                (tagcase (check v s (second xs) a)
                  (res (u es1 s)
                    (if (not (effs-within? (masked-goto es1 rn) d))
                        (refuse v (string-append "the tag allows its delimited computations " (string-append (show-effs d)
                                  (string-append ", and this body also has " (show-effs (masked-goto es1 rn))))))
                        (tagcase (handler-of v s (third xs) h a)
                          (res (u2 es2 s)
                            (let* ((delimits (not (reaches? v s (second xs) (car xs) rn)))
                                   (s (if delimits (note-fact s (cv-file v) (cv-pos v) "delimits") s))
                                   (s (if (and delimits (not (escapes? (masked-goto es1 rn))))
                                          (note-fact s (cv-file v) (cv-pos v) "contains")
                                          s))
                                   (s (if (null? expected) s (fits v s a (car expected)))))
                              (res a (effs-union es0 (effs-union es2 (if delimits (masked-goto es1 rn) es1))) s)))))))))
            (else other (refuse v (string-append "a prompt of a " (string-append (show-ty s tt) ", no prompt-tag")))))))))

  (handler-of (subr kfx (cv st sexp ty ty) res)
    (lambda (v s e h a)
      "A prompt's handler, a lambda from the payload to the answer: its
       body's effect is the prompt's, since the prompt calls it. A handler
       that may abort, KFX has not yet."
      (if (not (head-is? e "lambda"))
          (refuse v "a prompt's handler is a lambda, in KFX")
          (let ((lam (items e)))
            (tagcase (lambda-effects v s (items (second lam)) (cdr (cdr lam)) (ty-proc nil (list h) a))
              (res (u es s)
                (if (escapes? es)
                    (refuse v "a prompt's handler that may abort, which KFX has not yet")
                    (res a es s))))))))

  (synth-call-of (subr kfx (cv st res sexps (listof i64 acyclic) tys strings) res)
    (lambda (v s callee args regions expected more)
      "A call of the procedure `callee` is: its result fitted to the type
       `expected`, if one is, then its arguments checked against its
       parameters, in order; its effect, the callee's latent effect, the
       arguments' and `more`. In order, not lambdas last as FX-26 does,
       since rustc finds a closure's parameter types only from what comes
       before it: see `check-written-params`."
      (tagcase callee
        (res (t es0 s)
          (tagcase (walk s t)
            (ty-proc (latent ps r)
              (if (not (i64= (size ps) (size args)))
                  (refuse v (string-append "a call of the wrong number of arguments: "
                                           (show-sexps args)))
                  (tagcase (call-args v (if (null? expected) s (fits v s r (car expected))) args ps)
                    (res (u es1 s)
                      (tagcase (name-regions v s latent regions)
                        (res (u named s)
                          (res r (effs-union named (effs-union more (effs-union es0 es1)))
                               (if (escapes? named) (note-fact s (cv-file v) (cv-pos v) "fallible-call") s))))))))
            (else other (refuse v (string-append "a call of a " (string-append (show-ty s t) ", no procedure")))))))))

  (call-args (subr kfx (cv st sexps tys) res)
    (lambda (v s args ps)
      "The arguments, in order, but for `nil` given for a parameter that is
       an inference variable, which is heard after the rest, as FX-26 hears
       it. A literal is not: FX-26 makes it an `int` where it stands."
      (tagcase (call-args-pass v s args ps #f)
        (res (u es s) (with-effs (call-args-pass v s args ps #t) es)))))

  (call-args-pass (subr kfx (cv st sexps tys bool) res)
    (lambda (v s args ps later)
      "The arguments `deferred?` says are `later`'s."
      (cond ((null? args) (res (ty-unit) nil s))
            ((eqv-bool? (deferred? (car args) (car ps)) later)
             (tagcase (check v s (car args) (car ps))
               (res (t es s) (with-effs (call-args-pass v s (cdr args) (cdr ps) later) es))))
            (else (call-args-pass v s (cdr args) (cdr ps) later))))))

"Definitions"

(define primitives string
  "(i64+ (subr pure (i64 i64) i64)) (i64- (subr pure (i64 i64) i64)) (i64* (subr pure (i64 i64) i64))
   (i64-quotient (subr pure (i64 i64) i64)) (i64-remainder (subr pure (i64 i64) i64))
   (i64-and (subr pure (i64 i64) i64)) (i64-or (subr pure (i64 i64) i64)) (i64-xor (subr pure (i64 i64) i64))
   (i64-not (subr pure (i64) i64))
   (i64= (subr pure (i64 i64) bool)) (i64< (subr pure (i64 i64) bool)) (i64> (subr pure (i64 i64) bool))
   (i64<= (subr pure (i64 i64) bool)) (i64>= (subr pure (i64 i64) bool))
   (not (subr pure (bool) bool))
   (+ (subr pure (int int) int)) (- (subr pure (int int) int)) (* (subr pure (int int) int))
   (quotient (subr pure (int int) int)) (remainder (subr pure (int int) int)) (modulo (subr pure (int int) int))
   (= (subr pure (int int) bool)) (< (subr pure (int int) bool)) (> (subr pure (int int) bool))
   (<= (subr pure (int int) bool)) (>= (subr pure (int int) bool))
   (int->string (subr pure (int) string)) (int->i64 (subr pure (int) i64)) (i64->int (subr pure (i64) int))
   (zero? (subr pure (int) bool)) (max (subr pure (int int) int)) (min (subr pure (int int) int))
   (f64+ (subr pure (f64 f64) f64)) (f64- (subr pure (f64 f64) f64)) (f64* (subr pure (f64 f64) f64))
   (f64/ (subr pure (f64 f64) f64)) (f64-min (subr pure (f64 f64) f64)) (f64-max (subr pure (f64 f64) f64))
   (f64< (subr pure (f64 f64) bool)) (f64<= (subr pure (f64 f64) bool)) (f64> (subr pure (f64 f64) bool))
   (f64>= (subr pure (f64 f64) bool)) (f64= (subr pure (f64 f64) bool))
   (f64-abs (subr pure (f64) f64)) (f64-neg (subr pure (f64) f64)) (f64-sqrt (subr pure (f64) f64))
   (f64-floor (subr pure (f64) f64)) (f64-ceiling (subr pure (f64) f64))
   (f64-truncate (subr pure (f64) f64)) (f64-round (subr pure (f64) f64))
   (f64-nan? (subr pure (f64) bool)) (f64-infinite? (subr pure (f64) bool)) (f64-finite? (subr pure (f64) bool))
   (int->f64 (subr pure (int) f64)) (f64->int (subr pure (f64) int)) (f64->string (subr pure (f64) string))
   (string-length (subr pure (string) nat))
   (length (poly ((t type)) (subr pure ((listof t acyclic)) nat)))
   (list-length (poly ((r region) (t type)) (subr (read r) ((listof t r)) nat)))
   (append (poly ((r1 region) (r2 region) (t type)) (subr (maxeff (read r1) (alloc r2)) ((listof t r1) (listof t r2)) (listof t r2))))
   (reverse (poly ((r1 region) (r2 region) (t type)) (subr (maxeff (read r1) (alloc r2)) ((listof t r1)) (listof t r2))))
   (char=? (subr pure (char char) bool)) (char-whitespace? (subr pure (char) bool))
   (char-numeric? (subr pure (char) bool)) (char-alphabetic? (subr pure (char) bool))
   (char-upcase (subr pure (char) char)) (char->string (subr pure (char) string))
   (string-append (subr pure (string string) string)) (string=? (subr pure (string string) bool))
   (list->string (poly ((r region)) (subr (read r) ((listof char r)) string)))
   (string->list (poly ((r region)) (subr (alloc r) (string) (listof char r))))
   (error (subr pure (string) void))
   (new (poly ((r region) (t type)) (subr (alloc r) (t) (ref t r))))
   (get (poly ((r region) (t type)) (subr (read r) ((ref t r)) t)))
   (set (poly ((r region) (t type)) (subr (write r) ((ref t r) t) unit)))
   (nil (poly ((r region) (t type)) (listof t r)))
   (cons (poly ((r region) (t type)) (subr (alloc r) (t (listof t r)) (listof t r))))
   (car (poly ((r region) (t type)) (subr (read r) ((listof t r)) t)))
   (cdr (poly ((r region) (t type)) (subr (read r) ((listof t r)) (listof t r))))
   (null? (poly ((r region) (t type)) (subr pure ((listof t r)) bool)))")

"kayak-rt's primitives at KFX's types: the prelude's (kfx/prelude.fx), and
 FX-26's standard environment's at `acyclic`, where making and reading
 lists are pure."

(define prelude string
  "(string-length-i64 (subr pure (string) i64)) (string-ref-i64 (subr pure (string i64) char))
   (char->i64 (subr pure (char) i64)) (i64->string (subr pure (i64) string))
   (make-flatarray-i64 (poly ((r region)) (subr (alloc r) (i64 i64) (flatarrayof i64 r))))
   (flatarray-ref-i64 (poly ((r region)) (subr (read r) ((flatarrayof i64 r) i64) i64)))
   (flatarray-set-i64! (poly ((r region)) (subr (write r) ((flatarrayof i64 r) i64 i64) unit)))
   (flatarray-length-i64 (poly ((r region)) (subr pure ((flatarrayof i64 r)) i64)))")

"The prelude's (kfx/prelude.fx), at the types it gives them. To FX-26
 they are globals, the prelude's definitions: calling one reads it."

(define table-binds (subr kfx (cv string string string) binds)
  (lambda (v table file where)
    (map (lambda ((p sexp))
           (let ((xs (items p)))
             (bind (name-of v (car xs)) (parse-scheme v (second xs)) where)))
         (read-all (string-chars table) file 1))))

(define prim-binds (subr kfx (cv) binds)
  (lambda (v)
    (onto (table-binds v primitives "kayak-rt's primitives" "prim")
          (table-binds v prelude "kfx/prelude.fx" "global"))))

(define head-name (subr kfx (cv sexp) string)
  (lambda (v head)
    (tagcase head (lst (xs src-file src-line src-pos) (name-of v (car xs))) (else other (name-of v other)))))

(define datatype-of (subr kfx (cv sexps) dt)
  (lambda (v xs)
    "A define-datatype's name, parameters and variants, whose fields'
     types may name the parameters."
    (let ((params (family-params v (car xs))))
      (dt (head-name v (car xs))
          params
          (map (lambda ((vt sexp))
                 (let ((ys (items vt)))
                   (variant (name-of v (car ys)) (parse-types v params (cdr ys)))))
               (cdr xs))))))

(define constructors (subr kfx (dt) binds)
  (lambda (d)
    (tagcase d
      (dt (name ps vs)
        (map (lambda ((vt variant))
               (tagcase vt
                 (variant (tag fields)
                   (bind tag (scheme ps (ty-proc nil fields (ty-data name (map (lambda ((p string)) (ty-var p)) ps))))
                         "global"))))
             vs)))))

"Types and datatypes are declared ahead: every one is in scope in every
 definition, as FX-26 has it. Effect abbreviations and values are seen
 only after their definitions."

(define type-name (subr kfx (cv sexp) string)
  (lambda (v form)
    "A define-type's or define-datatype's name, from its head: a name, or
     `(name (p kind) ...)` for a family."
    (tagcase form
      (lst (xs src-file src-line src-pos) (head-name (near v src-file src-line src-pos) (second xs)))
      (else other (refuse v "a definition is expected")))))

(define type-params (subr kfx (cv sexp) strings)
  (lambda (v form)
    (tagcase form
      (lst (xs src-file src-line src-pos) (family-params (near v src-file src-line src-pos) (second xs)))
      (else other nil))))

(define declare-types (subr kfx (cv sexps aliases) aliases)
  (lambda (v forms as)
    (cond ((null? forms) as)
          ((head-is? (car forms) "define-type")
           (let ((xs (items (car forms))))
             (declare-types v (cdr forms)
                            (cons (alias (type-name v (car forms)) (type-params v (car forms)) (third xs)) as))))
          (else (declare-types v (cdr forms) as)))))

(define datatype-names (subr kfx (cv sexps dts) dts)
  (lambda (v forms ds)
    "The datatypes' names, before their variants' types can be read."
    (cond ((null? forms) ds)
          ((or (head-is? (car forms) "define-datatype") (head-is? (car forms) "define-generative"))
           (datatype-names v (cdr forms)
                           (cons (dt (type-name v (car forms)) (type-params v (car forms)) nil) ds)))
          (else (datatype-names v (cdr forms) ds)))))

(define with-effdef (subr kfx (cv sexps) cv)
  (lambda (v xs)
    "`v`, with a define-effect's abbreviation."
    (tagcase v
      (cv (bs ds as es here group file line fs tv at)
        (cv bs ds as (cons (effdef (name-of v (second xs)) (parse-effect v nil (third xs))) es) here group file line fs tv at)))))

(define declare-datatypes (subr kfx (cv sexps dts) dts)
  (lambda (v forms ds)
    "Each datatype's variants' types, as an effect abbreviation before it
     has them read."
    (cond ((null? forms) ds)
          ((head-is? (car forms) "define-datatype")
           (declare-datatypes v (cdr forms) (cons (datatype-of v (cdr (items (car forms)))) ds)))
          ((head-is? (car forms) "define-generative")
           (declare-datatypes v (cdr forms)
                              (cons (dt (type-name v (car forms)) (type-params v (car forms)) nil) ds)))
          ((head-is? (car forms) "define-effect")
           (declare-datatypes (with-effdef v (items (car forms))) (cdr forms) ds))
          (else (declare-datatypes v (cdr forms) ds)))))

(define at (subr kfx (cv string strings) cv)
  (lambda (v here group)
    (tagcase v (cv (bs ds as es h g file line fs tv at) (cv bs ds as es here group file line fs tv at)))))

(define runtime-name? (subr kfx (string) bool)
  (lambda (name)
    "kayak-rt's own names, which the generated modules import with the
     program's: a global of one of them would be ambiguous in Rust."
    (or (string=? name "alloc") (string=? name "leak-string") (string=? name "with-big-stack")
        (string=? name "abort-current-continuation") (string=? name "make-continuation-prompt-tag")
        (string=? name "the") (string=? name "unwind") (string=? name "knot")
        (string=? name "lambda0") (string=? name "lambda1") (string=? name "lambda2")
        (string=? name "lambda3") (string=? name "lambda4"))))

(define global (subr kfx (cv string scheme) bind)
  (lambda (v name sc)
    "A global, defined once: the generated modules each import every
     other's names and kayak-rt's, so a name defined twice, or a
     primitive's, would be ambiguous in Rust. KFX has no redefinition."
    (cond ((keyword? name) (refuse v (string-append "a keyword names nothing: " name)))
          ((runtime-name? name) (refuse v (string-append "kayak-rt has a " (string-append name " of its own"))))
          (else
           (let ((found (find-bind name (cv-binds v))))
             (if (null? found)
                 (bind name sc (if (null? (find-bind "%module" (cv-binds v))) "global" "item"))
                 (tagcase (car found)
                   (bind (n sc0 where)
                     (if (string=? where "prim")
                         (refuse v (string-append name " is a primitive, which KFX does not define again"))
                         (refuse v (string-append name " is defined already: KFX defines each name once")))))))))))

(define conversions (subr kfx (cv sexps) binds)
  (lambda (v xs)
    "A `define-generative`'s conversions, `up-t` from what it is made of and
     `down-t` back: a new type, distinct from its representation, as
     FX-26's top-level generative type is (not abstract: anyone may convert)."
    (let* ((name (head-name v (second xs)))
           (params (family-params v (second xs)))
           (made (ty-data name (map (lambda ((p string)) (ty-var p)) params)))
           (repr (parse-type (with-tvars v params) params (third xs))))
      (list (bind (string-append "up-" name) (scheme params (ty-proc nil (list repr) made)) "global")
            (bind (string-append "down-" name) (scheme params (ty-proc nil (list made) repr)) "global")))))

(define defined-once (subr kfx (cv binds) cv)
  (lambda (v bs)
    "`v` with each of `bs`, each refused if its name is taken (`global`)."
    (if (null? bs)
        v
        (tagcase (car bs)
          (bind (n sc where) (defined-once (with-binds v (list (global v n sc))) (cdr bs)))))))

(define new-state (subr kfx () st) (lambda () (st nil 0 nil)))

(define with-facts (subr kfx (cv facts) cv)
  (lambda (v more)
    "`v`, with a definition's facts."
    (tagcase v (cv (bs ds as es here group file line fs tv at) (cv bs ds as es here group file line (onto more fs) tv at)))))

(define cv-facts (subr kfx (cv) facts)
  (lambda (v) (tagcase v (cv (bs ds as es here group file line fs tv at) fs))))

(define no-reaching-itself (subr kfx (cv strings scheme) cv)
  (lambda (v group sc)
    "A global whose latent effect reads itself, or a member of its group,
     may reach itself through the store: its type says `spin`, as FX-26's
     must (`no_reaching_itself`)."
    (tagcase sc
      (scheme (tvars t)
        (tagcase t
          (ty-proc (es ps r)
            (if (and (not (string-member? "spin" es))
                     (any? (lambda ((n string)) (string-member? (string-append "g:" n) es)) group))
                (refuse v (string-append "calling it reads " (string-append (words-of group)
                          ": it may reach itself through a global, so its type must say spin")))
                v))
          (else other v))))))

(define ends-alone? (subr kfx (cv string scheme sexp) bool)
  (lambda (v name sc defined)
    "Whether a definition of one procedure ends however it calls itself, so
     that its calls of itself need no `spin` (`terminates?`)."
    (tagcase sc (scheme (tvars t) (terminates? v (list name) (list t) (list defined))))))

(define constant-made (subr kfx (cv st sexp strings) st)
  (lambda (v s e es)
    "A constant's value, of effect `es`: it may read globals, and allocate,
     and is then made once, at its first use, and kept (C21), which the
     emitter is told; nothing else, since when it is made is not when
     FX-26 makes it, where it is defined."
    (cond ((any? (lambda ((x string))
                   (not (or (string=? x "spin") (string=? x "@globals") (global-atom? x) (has-prefix? x "alloc:"))))
                 es)
           (refuse v (string-append "a constant whose value has the effect " (string-append (show-effs es)
                     ": KFX makes a constant at its first use, so its value may only read globals and allocate"))))
          ((any? (lambda ((x string)) (has-prefix? x "alloc:")) es)
           (tagcase e (lst (xs file line pos) (note-fact s file pos "once")) (else other s)))
          (else s))))

(define check-procedure (subr kfx (cv sexp scheme) cv)
  (lambda (v defined sc)
    "A procedure's lambda against its type; `v` already has its name."
    (let ((lam (items (if (head-is? defined "plambda") (third (items defined)) defined))))
      (tagcase sc
        (scheme (tvars t)
          (tagcase (check-lambda (with-tvars v tvars) (new-state) (items (second lam)) (cdr (cdr lam)) t)
            (res (u es s) (with-facts v (st-facts s)))))))))

(define variants-dt (subr kfx (cv string) (listof dt acyclic))
  (lambda (v d)
    (let ((found (find-dt d (cv-dts v))))
      (if (null? found)
          (refuse v (string-append "no datatype is named " d))
          (find-family d (cv-dts v))))))

(define check-members (subr kfx (cv sexps strings strings) cv)
  (lambda (v bindings group names)
    "A define-rec's members, one by one, each one's facts kept: `group`,
     those whose calls are recursion (none if the group ends); `names`, all
     of them, whose reading is reaching itself, ending or not."
    (if (null? bindings)
        v
        (let ((ys (items (car bindings))))
          (if (procedure? (third ys))
              (check-members (check-procedure (no-reaching-itself (at v (name-of v (car ys)) group) names (parse-scheme v (second ys)))
                                              (third ys)
                                              (parse-scheme v (second ys)))
                             (cdr bindings) group names)
              (refuse v "a define-rec binds only lambdas"))))))

(define check-rec (subr kfx (cv sexps) cv)
  (lambda (v bindings)
    "A define-rec: every member in scope in each, and each a lambda."
    (let* ((names (map (lambda ((b sexp)) (name-of v (car (items b)))) bindings))
           (ends (terminates? v names (map (lambda ((b sexp)) (tagcase (parse-scheme v (second (items b))) (scheme (tvars t) t))) bindings)
                              (map (lambda ((b sexp)) (third (items b))) bindings)))
           (named (with-binds v (map (lambda ((b sexp))
                                       (let ((ys (items b)))
                                         (global v (name-of v (car ys)) (parse-scheme v (second ys)))))
                                     bindings))))
      (check-members named bindings (if ends nil names) names))))

(define global-reads (subr kfx (strings) strings)
  (lambda (es)
    (if (null? es)
        nil
        (if (or (string=? (car es) "@globals") (global-atom? (car es)))
            (cons (car es) (global-reads (cdr es)))
            (global-reads (cdr es))))))

(define check-define* (subr kfx (cv sexps) cv)
  (lambda (v xs)
    "`(define* name type lambda)`: as FX-26 has it, the globals its body
     reads are found, not written. The body is checked as though the type
     read every global; the global is then of the type written, its effect
     with the globals found."
    (let* ((name (name-of v (second xs)))
           (defined (fourth xs))
           (v (at v name (if (ends-alone? v name (parse-scheme v (third xs)) defined) nil (list name))))
           (lam (items (if (head-is? defined "plambda") (third (items defined)) defined))))
      (if (not (procedure? defined))
          (refuse v "a define* is of a lambda")
          (tagcase (parse-scheme v (third xs))
            (scheme (tvars t)
              (tagcase t
                (ty-proc (declared ps r)
                  (let* ((wide (ty-proc (effs-union (list "@globals") declared) ps r))
                         (named (with-binds v (list (global v name (scheme tvars wide)))))
                         (found (lambda-effects (with-tvars named tvars) (new-state) (items (second lam)) (cdr (cdr lam)) wide))
                         (es (tagcase found (res (u es s) es)))
                         (fs (tagcase found (res (u es s) (st-facts s)))))
                    (if (effs-within? es (effs-union (list "@globals") declared))
                        (with-facts (with-binds (no-reaching-itself v (list name) (scheme tvars (ty-proc (effs-union (global-reads es) declared) ps r)))
                                                (list (global v name (scheme tvars (ty-proc (effs-union (global-reads es) declared) ps r)))))
                                    fs)
                        (refuse v (string-append "a define* whose effect " (string-append (show-effs es)
                                  (string-append " is not within " (show-effs declared))))))))
                (else other (refuse v "a define* is of a procedure")))))))))

(define check-top (subr kfx (cv sexp) cv)
  (lambda (v form)
    "One top-level form, which may add to what the forms after it see."
    (tagcase form
      (str (x) v)
      (lst (xs src-file src-line src-pos)
        (let ((v (near v src-file src-line src-pos))
              (h (if (null? xs) "" (tagcase (car xs) (sym (n) n) (else other "")))))
          (cond ((string=? h "define-effect") (with-effdef v xs))
                ((string=? h "define-type")
                 "Its body read where it stands, used or not: so that one that
                  mentions itself, or names no type, is refused."
                 (let* ((name (head-name v (second xs)))
                        (params (family-params v (second xs)))
                        (body (parse-type v (cons (string-append "%expanding " name) params) (third xs))))
                   v))
                ((string=? h "define-datatype")
                 (let ((d (car (variants-dt v (head-name v (second xs))))))
                   (defined-once v (constructors d))))
                ((string=? h "define-generative") (defined-once v (conversions v xs)))
                ((string=? h "define")
                 (if (not (i64= (size xs) 4))
                     (refuse v "a definition needs a type")
                     (let* ((name (name-of v (second xs)))
                            (sc (parse-scheme v (third xs)))
                            (v (at v name (if (ends-alone? v name sc (fourth xs)) nil (list name))))
                            (v (no-reaching-itself v (list name) sc))
                            (named (with-binds v (list (global v name sc)))))
                       (if (procedure? (fourth xs))
                           (check-procedure named (fourth xs) sc)
                           (tagcase sc
                             (scheme (tvars t)
                               (if (null? tvars)
                                   (tagcase (check v (new-state) (fourth xs) t)
                                     (res (u es s) (with-facts named (st-facts (constant-made v s (fourth xs) es)))))
                                   (refuse v "a poly constant: only a procedure may be poly"))))))))
                ((string=? h "define-rec") (check-rec v (cdr xs)))
                ((string=? h "define*") (check-define* v xs))
                (else (tagcase (synth (at v "a top-level expression" nil) (new-state) form)
                        (res (t es s) (with-facts v (st-facts s))))))))
      (else other (tagcase (synth (at v "a top-level expression" nil) (new-state) form)
                    (res (t es s) (with-facts v (st-facts s))))))))

(define type-names-free (subr kfx (cv sexps) unit)
  (lambda (v forms)
    "No type is named as one of kayak-rt's: `Str`, `List`, `Cons`."
    (begin
      (map (lambda ((f sexp))
             (if (or (head-is? f "define-type") (head-is? f "define-datatype") (head-is? f "define-generative"))
                 (let ((name (tagcase (second (items f)) (sym (n) n) (else other ""))))
                   (if (or (string=? name "str") (string=? name "list") (string=? name "cons"))
                       (refuse v (string-append "kayak-rt has a type " (string-append (camel name) " of its own")))
                       #u))
                 #u))
           forms)
      #u)))

"Elaboration. A definition with no type, `(define x e)`, has the type the
 checker finds for `e`; the emitter, which knows no types, is told it, as
 though it had been written. It is never `poly`, and must be known whole."

(define-datatype typed (typed string sexp))
(define-type typeds (listof typed acyclic))
(define-datatype elab (elab cv typeds))

(define-rec
  (ty-sexp (subr kfx (cv st ty) sexp)
    (lambda (v s t)
      "A type as written: for the emitter, which reads no effects, so a
       procedure's is written `pure`."
      (tagcase (walk s t)
        (ty-i64 () (sym "i64"))
        (ty-int () (sym "int"))
        (ty-nat () (sym "nat"))
        (ty-f64 () (sym "f64"))
        (ty-bool () (sym "bool"))
        (ty-char () (sym "char"))
        (ty-unit () (sym "unit"))
        (ty-string () (sym "string"))
        (ty-void () (sym "void"))
        (ty-list (e r) (lst (list (sym "listof") (ty-sexp v s e) (ty-sexp v s r)) "" 0 0))
        (ty-data (d args)
          (if (null? args) (sym d) (lst (cons (sym d) (map (lambda ((x ty)) (ty-sexp v s x)) args)) "" 0 0)))
        (ty-flat (e r) (lst (list (sym "flatarrayof") (ty-sexp v s e) (ty-sexp v s r)) "" 0 0))
        (ty-tag (a h d r) (lst (list (sym "prompt-tag") (ty-sexp v s a) (ty-sexp v s h) (sym "pure") (ty-sexp v s r)) "" 0 0))
        (ty-ref (e r) (lst (list (sym "ref") (ty-sexp v s e) (ty-sexp v s r)) "" 0 0))
        (ty-rconst (n) (sym n))
        (ty-proc (es ps r)
          (lst (list (sym "subr") (if (escapes? es) (lst (list (sym "goto") (sym "@escape")) "" 0 0) (sym "pure"))
                     (lst (map (lambda ((p ty)) (ty-sexp v s p)) ps) "" 0 0) (ty-sexp v s r)) "" 0 0))
        (ty-var (n) (refuse v (string-append "a definition with no type, of a type over " (string-append n ": write its type"))))
        (ty-meta (k) (refuse v "a definition with no type, whose type is not known whole: write it"))))))

(define check-untyped (subr kfx (cv sexp) elab)
  (lambda (v form)
    "`(define x e)`: `e`'s type found, `x` not in scope in `e` (as FX-26
     has it, for a lambda too), and the type kept for the emitter."
    (let* ((xs (items form))
           (name (name-of v (second xs)))
           (v (at v name nil))
           (e (third xs)))
      (tagcase (synth v (new-state) e)
        (res (t es s)
          (let ((written (ty-sexp v s t))
                (s (if (procedure? e) s (constant-made v s e es))))
            (elab (with-facts (with-binds v (list (global v name (scheme nil (zonk s t))))) (st-facts s))
                  (list (typed name written)))))))))

"Modules (CLAUDES_CHOICES.md C19): `(define m (module item ...))` at the
 top level, a Rust `mod`. Its items are a program's definitions, each
 seeing those before it; its types are named `m..t` for the program, so
 that a module's and the program's never meet, and a generative type's
 conversions stay inside. Outside, `m`'s values and types are named `m x`,
 found by `with` and `select`."

(define module-def? (subr kfx (sexp) bool)
  (lambda (form)
    (and (head-is? form "define") (i64= (size (items form)) 3) (head-is? (third (items form)) "module"))))

(define tag-taken? (subr kfx (string dts) bool)
  (lambda (tag ds)
    (any? (lambda ((d dt))
            (tagcase d (dt (n ps vs) (any? (lambda ((x variant)) (tagcase x (variant (t fs) (string=? t tag)))) vs))))
          ds)))

(define-rec
  (module-types (subr kfx (cv sexps) strings)
    (lambda (v forms)
      "A module's types' names, each refused if the program has a type of
       that name; and the items KFX's modules do not have, refused."
      (if (null? forms)
          nil
          (let ((f (car forms)))
            (cond ((and (head-is? f "define-datatype")
                        (any? (lambda ((vt sexp)) (tag-taken? (sym-name (car (items vt))) (cv-dts v))) (cdr (cdr (items f)))))
                   (refuse v "a module's datatype whose tag another datatype has: KFX's tags name one datatype each"))
                  ((or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype"))
                   (let ((name (tagcase (second (items f)) (sym (n) n)
                                 (else other (refuse v "a module's type with parameters, which KFX's modules do not have yet")))))
                     (if (dt-named? name (cv-dts v))
                         (refuse v (string-append "a module's type named as the program's: KFX names them apart, " name))
                         (cons name (module-types v (cdr forms))))))
                  ((or (head-is? f "define-effect") (head-is? f "include")
                       (head-is? f "hide") (module-def? f))
                   (refuse v (string-append "an item KFX's modules do not have yet: " (show-sexp (car (items f))))))
                  (else (module-types v (cdr forms)))))))))

(define-rec
  (qualify-type (subr kfx (string strings sexp) sexp)
    (lambda (m names t)
      "A type written in module `m`, its types named as the program names them."
      (tagcase t
        (sym (n) (if (string-member? n names) (sym (string-append m (string-append ".." n))) t))
        (lst (xs file line pos) (lst (map (lambda ((x sexp)) (qualify-type m names x)) xs) file line pos))
        (else other t)))))

(define module-aliases (subr kfx (string strings sexps bool) aliases)
  (lambda (m names forms inside)
    "A module's types: each `m..t`; and `t` inside it, `m t` outside."
    (concat
     (map (lambda ((f sexp))
            (cond ((not (or (head-is? f "define-type") (head-is? f "define-generative") (head-is? f "define-datatype"))) nil)
                  (else
                   (let* ((xs (items f))
                          (t (sym-name (second xs)))
                          (q (string-append m (string-append ".." t)))
                          (name (if inside t (string-append m (string-append " " t))))
                          (named (alias name nil (sym q))))
                     (if (head-is? f "define-type")
                         (the aliases (list named (alias q nil (qualify-type m names (third xs)))))
                         (the aliases (list named)))))))
          forms))))

(define module-dts (subr kfx (string sexps) dts)
  (lambda (m forms)
    (concat
     (map (lambda ((f sexp))
            (if (or (head-is? f "define-generative") (head-is? f "define-datatype"))
                (the dts (list (dt (string-append m (string-append ".." (sym-name (second (items f))))) nil nil)))
                nil))
          forms))))

(define module-conversions (subr kfx (cv string sexps) binds)
  (lambda (v m forms)
    "A module's generative types' conversions, `up-t` and `down-t`: its
     items', not in its type, so that outside `m..t` is abstract."
    (concat
     (map (lambda ((f sexp))
            (if (head-is? f "define-generative")
                (let* ((xs (items f))
                       (t (sym-name (second xs)))
                       (made (ty-data (string-append m (string-append ".." t)) nil))
                       (repr (parse-type v nil (third xs))))
                  (the binds (list (bind (string-append "up-" t) (scheme nil (ty-proc nil (list repr) made)) "item")
                                   (bind (string-append "down-" t) (scheme nil (ty-proc nil (list made) repr)) "item"))))
                nil))
          forms))))

(define module-datatypes (subr kfx (cv string sexps) dts)
  (lambda (v m forms)
    "A module's datatypes, their variants read where its types are named."
    (concat
     (map (lambda ((f sexp))
            (if (head-is? f "define-datatype")
                (tagcase (datatype-of v (cdr (items f)))
                  (dt (n ps vs) (the dts (list (dt (string-append m (string-append ".." n)) ps vs)))))
                nil))
          forms))))

(define-rec
  (module-exports (subr kfx (string strings binds) binds)
    (lambda (m conversions bs)
      "The items' values, before the module's mark, as `m x`."
      (if (null? bs)
          nil
          (tagcase (car bs)
            (bind (n sc where)
              (cond ((string=? n "%module") nil)
                    ((string-member? n conversions) (module-exports m conversions (cdr bs)))
                    (else (cons (bind (string-append m (string-append " " n)) sc "export")
                                (module-exports m conversions (cdr bs)))))))))))

(define untyped? (subr kfx (sexp) bool)
  (lambda (form) (and (head-is? form "define") (i64= (size (items form)) 3))))

(define-rec
  (check-items (subr kfx (cv string sexps typeds) elab)
    (lambda (v m forms found)
      "A module's items, in order: as the program's forms, but that its
       generative types are made already, and its elaborated types are named
       `m x`."
      (cond ((null? forms) (elab v found))
            ((or (head-is? (car forms) "define-generative") (head-is? (car forms) "define-datatype"))
             (check-items v m (cdr forms) found))
            ((untyped? (car forms))
             (tagcase (car forms)
               (lst (xs src-file src-line src-pos)
                 (tagcase (check-untyped (near v src-file src-line src-pos) (car forms))
                   (elab (v2 more)
                     (check-items (at v2 "" nil) m (cdr forms)
                                  (onto (map (lambda ((x typed))
                                               (tagcase x (typed (n t) (typed (string-append m (string-append " " n)) t))))
                                             more)
                                        found)))))
               (else other (check-items v m (cdr forms) found))))
            (else (check-items (check-top v (car forms)) m (cdr forms) found))))))

(define check-module (subr kfx (cv sexp) elab)
  (lambda (v form)
    (let* ((xs (items form))
           (m (name-of v (second xs)))
           (v (at v m nil))
           (made (tagcase (global v m (scheme nil (ty-unit))) (bind (n sc where) (bind n sc "module"))))
           (forms (cdr (items (third xs))))
           (names (module-types v forms))
           (typed (tagcase v
                    (cv (bs ds as es here group file line fs tv at)
                      (cv (cons (bind "%module" (scheme nil (ty-unit)) m) bs) (onto (module-dts m forms) ds)
                          (onto (module-aliases m names forms #t) as) es here group file line fs tv at))))
           (datatypes (module-datatypes typed m forms))
           (typed (tagcase typed
                    (cv (bs ds as es here group file line fs tv at)
                      (cv bs (onto datatypes ds) as es here group file line fs tv at))))
           (conversions (module-conversions typed m forms))
           (inner (defined-once typed (onto conversions (concat (map constructors datatypes))))))
      (tagcase (check-items inner m forms nil)
        (elab (done found)
          (tagcase done
            (cv (bs ds as es here group file line fs tv at)
              (elab (cv (cons made (bind-onto (module-exports m (map (lambda ((b bind)) (tagcase b (bind (n sc w) n))) conversions) bs)
                                              (cv-binds v)))
                        ds (onto (module-aliases m names forms #f) (cv-aliases v)) (cv-effdefs v) here group file line fs tv at)
                    found))))))))

(define check-tops (subr kfx (cv sexps typeds) elab)
  (lambda (v forms found)
    "The forms in order; `found`, the types elaborated so far."
    (cond ((null? forms) (elab v found))
          ((module-def? (car forms))
           (tagcase (car forms)
             (lst (xs src-file src-line src-pos)
               (tagcase (check-module (near v src-file src-line src-pos) (car forms))
                 (elab (v2 more) (check-tops (at v2 "" nil) (cdr forms) (onto more found)))))
             (else other (check-tops v (cdr forms) found))))
          ((untyped? (car forms))
           (tagcase (car forms)
             (lst (xs src-file src-line src-pos)
               (tagcase (check-untyped (near v src-file src-line src-pos) (car forms))
                 (elab (v2 more) (check-tops (at v2 "" nil) (cdr forms) (onto more found)))))
             (else other (check-tops v (cdr forms) found))))
          (else (check-tops (check-top v (car forms)) (cdr forms) found)))))

"What checking a program gives the emitter: the types of the definitions
 written with none, and the facts."
(define-datatype verdict (verdict typeds facts))

(define verdict-typeds (subr kfx (verdict) typeds)
  (lambda (x) (tagcase x (verdict (ts fs) ts))))

(define verdict-facts (subr kfx (verdict) facts)
  (lambda (x) (tagcase x (verdict (ts fs) fs))))

(define check-program (subr kfx (sexps) verdict)
  (lambda (forms)
    "Every form, in order; the first error stops the compiler. What it gives
     is the types of the definitions written with none."
    (let* ((empty (cv nil nil nil nil "a type" nil "the program" 0 nil nil 0))
           (start (cv nil nil (declare-types empty forms nil) nil "a type" nil "the program" 0 nil nil 0))
           (types (type-names-free start forms))
           (named (tagcase start (cv (bs ds as es here group file line fs tv at) (cv bs (datatype-names start forms nil) as es here group file line fs tv at))))
           (typed (tagcase named (cv (bs ds as es here group file line fs tv at) (cv bs (declare-datatypes named forms nil) as es here group file line fs tv at))))
           (v (with-binds typed (prim-binds typed))))
      (tagcase (check-tops v forms nil) (elab (done found) (verdict found (cv-facts done)))))))
