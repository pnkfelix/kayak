"check.kfx: the checker."

"Checking (TODO.md, section 13): KFX's types and effects, so that kfx
 refuses what is not KFX without Fixpt. KFX is a subset of FX-26 (PLAN.md,
 K1): this checker may refuse what FX-26 accepts, never accept what it
 refuses. Where FX-26 is clever, it is plain instead:
 - every recursive procedure says `spin` (FX-26 proves termination);
 - a call of a procedure that is a value, and a global procedure named as
   a value, are `spin` (FX-26 says when they may loop);
 - a `poly` is over types, and a list at `acyclic`.
 Bidirectional, as FX-26's checking is: `check` knows the type expected,
 `synth` finds it. A `poly` procedure's call is instantiated by
 inference variables, solved by the arguments in order, those that are
 lambdas last."

(define-datatype ty
  (ty-i64)
  (ty-int)
  (ty-nat)
  (ty-f64)
  (ty-bool)
  (ty-char)
  (ty-unit)
  (ty-string)
  (ty-void)
  (ty-list ty ty)
  (ty-data string (listof ty acyclic))
  (ty-flat ty ty)
  (ty-ref ty ty)
  (ty-rconst string)
  (ty-tag ty ty strings ty)
  (ty-proc strings (listof ty acyclic) ty)
  (ty-shape bool strings (listof ty acyclic))
  (ty-var string)
  (ty-meta i64))

"`ty-flat` and `ty-ref` are a flat array and a reference, each with its
 element's type and its region: a `ty-rconst` (`@a`), a `ty-var` (a poly's
 region binder, named with a `'` first, so no type variable is one), or a
 `ty-meta`. Their effects' atoms are `read:`, `write:` and `alloc:` and a
 region's name.

 `ty-void` is `error`'s result, below every type. A `ty-proc`'s strings
 are its latent effect, a set of atoms: `spin`, `@globals` (every global
 read), and `g:` and a name (that global read). `ty-var` is a `poly`'s
 type variable, `ty-meta` an inference variable. `ty-shape` is FX-26's structural
 data, immutable and in no region: a product (`#t`) or a sum, its labels
 or tags in order, and their types."

(define-type tys (listof ty acyclic))

(define-datatype scheme (scheme strings ty))

"A name in scope: its type, over its type variables, and where it is
 defined: `local`, `global` (the program's, so naming it reads it), or
 `prim` (kayak-rt's, and the prelude's)."
(define-datatype bind (bind string scheme string))
(define-type binds (listof bind acyclic))

(define-datatype variant (variant string tys))
(define-type variants (listof variant acyclic))
(define-datatype dt (dt string strings variants))
(define-type dts (listof dt acyclic))

(define-datatype alias (alias string strings sexp))
(define-type aliases (listof alias acyclic))

(define-datatype effdef (effdef string strings))
(define-type effdefs (listof effdef acyclic))

"What a checker of a definition knows: the names in scope, the datatypes,
 the type abbreviations, the effect abbreviations, the definition being
 checked, its recursive group (whose calls are `spin`), where the
 innermost list being checked began (a file, a line; for messages), the
 facts found so far, and the type and region variables in scope (a
 `poly`'s binders, a `letregion`'s region)."
(define-datatype cv (cv binds dts aliases effdefs string strings string i64 facts strings i64))

"Facts: what the checker found about a place, a file and an offset, for
 the emitter, which knows no types. `int`: the number literal there is an
 `int`, not an `i64`. A definition's facts are in its state while it is
 checked, then in `cv`'s, for the definitions after it, and the program's
 go to the emitter (`verdict`)."
(define-datatype fact (fact string i64 string))
(define-type facts (listof fact acyclic))

"Inference variables solved so far, the next one's number, and facts."
(define-datatype sb (sb i64 ty))
(define-type sbs (listof sb acyclic))
(define-datatype st (st sbs i64 facts))

"What checking an expression gives: its type, its effect, and the state."
(define-datatype res (res ty strings st))

"Messages"

(define-rec
  (show-sexp (subr kfx (sexp) string)
    (lambda (e)
      (tagcase e
        (sym (s at-file at-pos) s)
        (str (s at-file at-pos) (string-append "\"" (string-append s "\"")))
        (num (k num-file num-pos) (i64->string k))
        (big (text f p) text)
        (chr (c at-file at-pos) (string-append "#\\" (char->string c)))
        (real (t at-file at-pos) t)
        (lst (xs src-file src-line src-pos) (string-append "(" (string-append (show-sexps xs) ")"))))))
  (show-sexps (subr kfx (sexps) string)
    (lambda (xs)
      (cond ((null? xs) "")
            ((null? (cdr xs)) (show-sexp (car xs)))
            (else (string-append (show-sexp (car xs)) (string-append " " (show-sexps (cdr xs)))))))))

(define cv-where (subr kfx (cv) string)
  (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) here))))

(define refusal-text (subr kfx (cv string) string)
  (lambda (v message)
    "What a refusal says, past `kfx: `: where, the innermost list being
     checked and the definition, then `message`."
    (tagcase v
      (cv (bs ds als es here group file line fs tv at)
        (string-append (cond ((i64= line 0) "")
                             ;; A REPL's draft, checked as it is typed: where, as an offset
                             ;; into it, so that the REPL can tell whether the error is about
                             ;; what has been finished (live-repl.kfx, C96).
                             ((string=? file "<draft>") (string-append "<draft>@" (string-append (i64->string at) ": ")))
                             (else (string-append file (string-append ":" (string-append (i64->string line) ": ")))))
          (string-append "in " (string-append here (string-append ": " message))))))))

(define refuse (subr kfx (cv string) void)
  (lambda (v message)
    "An error, said where: the innermost list being checked, and the
     definition."
    (error (string-append "kfx: " (refusal-text v message)))))

(define name-of (subr kfx (cv sexp) string)
  (lambda (v e)
    "A name, where one is expected: refused, saying where, if `e` is none."
    (tagcase e
      (sym (s at-file at-pos) s)
      (else other (refuse v (string-append "a name is expected here, not " (show-sexp other)))))))

"Effects"

(define take-chars (subr kfx ((listof char acyclic) i64) (listof char acyclic))
  (lambda (cs n) (if (or (null? cs) (i64= n 0)) nil (cons (car cs) (take-chars (cdr cs) (i64- n 1))))))

(define substring-of (subr kfx (string i64) string)
  (lambda (x n) (list->string (take-chars (string->list x) n))))

(define-rec
  (same-from? (subr kfx (string string i64 i64) bool)
    (lambda (x p i n)
      (or (i64= i n) (and (char=? (string-ref-i64 x i) (string-ref-i64 p i)) (same-from? x p (i64+ i 1) n))))))

(define has-prefix? (subr kfx (string string) bool)
  (lambda (x p)
    "Whether `x` begins `p`: compared in place, making nothing (the compiler
     asks it of every fact it searches)."
    (and (not (i64< (string-length-i64 x) (string-length-i64 p)))
         (same-from? x p 0 (string-length-i64 p)))))

(define-rec
  (drop-chars (subr kfx ((listof char acyclic) i64) (listof char acyclic))
    (lambda (cs n) (if (or (null? cs) (i64= n 0)) cs (drop-chars (cdr cs) (i64- n 1))))))

(define after-prefix (subr kfx (string string) string)
  (lambda (x p) (list->string (drop-chars (string->list x) (string-length-i64 p)))))

(define-rec
  (char-from? (subr kfx (string char i64 i64) bool)
    (lambda (s c i n) (and (i64< i n) (or (char=? (string-ref-i64 s i) c) (char-from? s c (i64+ i 1) n))))))

(define has-char-in? (subr kfx (string char) bool)
  (lambda (s c) (char-from? s c 0 (string-length-i64 s))))

(define-rec
  (repeated? (subr kfx (strings) bool)
    (lambda (xs) (and (not (null? xs)) (or (string-member? (car xs) (cdr xs)) (repeated? (cdr xs)))))))

(define-rec
  (first-repeated (subr kfx (strings) string)
    (lambda (xs)
      "The first of `xs` that is there again later, or ``."
      (cond ((null? xs) "")
            ((string-member? (car xs) (cdr xs)) (car xs))
            (else (first-repeated (cdr xs)))))))

(define-rec
  (strings=? (subr kfx (strings strings) bool)
    (lambda (a b)
      (cond ((null? a) (null? b))
            ((null? b) #f)
            (else (and (string=? (car a) (car b)) (strings=? (cdr a) (cdr b))))))))

(define label-of (subr kfx (sexp) string)
  (lambda (e)
    "A product's label or a sum's tag, as written: a name or a number."
    (tagcase e (sym (n at-file at-pos) n) (num (k f p) (i64->string k)) (else other ""))))

(define escapes? (subr kfx (strings) bool)
  (lambda (es)
    "Whether effect `es` may abort: a `goto` on some region, or suspend, a
     `comefrom` (C45), which aborts to its prompt. Such a procedure, in
     Rust, returns a `Result` (emit.kfx)."
    (any? (lambda ((x string)) (or (has-prefix? x "goto:") (has-prefix? x "comefrom:") (has-prefix? x "~"))) es)))

(define suspends? (subr kfx (strings) bool)
  (lambda (es)
    "Whether effect `es` may suspend: a `comefrom` on some region, or an
     effect variable, which may stand for one (C46). Such a procedure, in
     Rust, is an `async fn` (C45)."
    (any? (lambda ((x string)) (or (has-prefix? x "comefrom:") (has-prefix? x "~"))) es)))

(define frozen-atom? (subr kfx (string) bool)
  (lambda (x)
    "An effect on `acyclic`: making and reading frozen data are pure, in
     FX-26; writing it is refused where its type is read."
    (or (string=? x "read:acyclic") (string=? x "alloc:acyclic") (string=? x "write:acyclic") (string=? x "read:const")
        (string=? x "read:%fresh") (string=? x "alloc:%fresh"))))

(define effs-union (subr kfx (strings strings) strings)
  (lambda (a b)
    (cond ((null? a) (if (any? (lambda ((x string)) (frozen-atom? x)) b) (effs-union b nil) b))
          ((or (frozen-atom? (car a)) (string-member? (car a) b)) (effs-union (cdr a) b))
          (else (effs-union (cdr a) (cons (car a) b))))))

(define global-atom? (subr kfx (string) bool)
  (lambda (x)
    "A read of one global, `g:name`; not a `goto:`."
    (and (i64> (string-length-i64 x) 1) (char=? (string-ref-i64 x 0) #\g) (char=? (string-ref-i64 x 1) #\:))))

(define effs-within? (subr kfx (strings strings) bool)
  (lambda (a b)
    "Whether effect `a` is within `b`: a read of one global is within a
     read of all of them, and an I-cell's fill within a write of its region
     (C101: FX's `init`, told apart from a write by `par` alone)."
    (or (null? a)
        (and (or (string-member? (car a) b)
                 (string=? (car a) "~!")
                 (and (global-atom? (car a)) (string-member? "@globals" b))
                 (and (has-prefix? (car a) "init:") (string-member? (string-append "write:" (after-prefix (car a) "init:")) b)))
             (effs-within? (cdr a) b)))))

(define words-of (subr kfx (strings) string)
  (lambda (xs)
    (cond ((null? xs) "")
          ((null? (cdr xs)) (car xs))
          (else (string-append (car xs) (string-append " " (words-of (cdr xs))))))))

"The kinds of an effect atom on a region, `read:@a`: FX-26's store
 effects and control effects, and its processes' (C101): a message sent
 to a mailbox at a region, taken from one, an I-cell filled, awaited."
(define region-kinds strings
  (list "read" "write" "alloc" "goto" "comefrom" "send" "receive" "init" "await"))

(define-rec
  (after-colon (subr kfx ((listof char acyclic)) (listof char acyclic))
    (lambda (cs)
      (cond ((null? cs) nil)
            ((char=? (car cs) #\:) (cdr cs))
            (else (after-colon (cdr cs)))))))

"Each of `region-kinds` with its colon, as an atom begins."
(define region-prefixes strings
  (list "read:" "write:" "alloc:" "goto:" "comefrom:" "send:" "receive:" "init:" "await:"))

(define region-atom? (subr kfx (string) bool)
  (lambda (x) (any? (lambda ((k string)) (has-prefix? x k)) region-prefixes)))

(define atom-kind (subr kfx (string) string)
  (lambda (x) (substring-of x (i64- (string-length-i64 x) (size (after-colon (string->list x)))))))

(define atom-region (subr kfx (string) string)
  (lambda (x) (list->string (after-colon (string->list x)))))

(define crossing-atom? (subr kfx (strings string) bool)
  (lambda (bound a)
    "Whether atom `a` is one a process may have that is seen outside it:
     a send, a fill or an await, I/O, `spin`, `nondet`, reading globals'
     bindings or data frozen in the heap, allocating at a region that is
     no place (a constant, or the heap); or anything on a binder in
     `bound`, which a caller gives (`crossing_atom`)."
    (or (string=? a "spin") (string=? a "nondet") (string=? a "@globals") (string=? a "~!")
        (global-atom? a) (has-prefix? a "io:")
        (has-prefix? a "send:") (has-prefix? a "init:") (has-prefix? a "await:")
        (string=? a "read:acyclic") (string=? a "read:%fresh") (string=? a "read:const")
        (string-member? a bound)
        (and (has-prefix? a "alloc:")
             (let ((r (after-prefix a "alloc:"))) (or (has-prefix? r "@") (string=? r "acyclic") (string=? r "%fresh"))))
        (and (region-atom? a) (string-member? (atom-region a) bound)))))

(define crossing? (subr kfx (strings) bool)
  (lambda (es)
    "Whether a latent effect is one a process may have (C101), so that a
     procedure of it may be held on another thread: its closure, in Rust, is
     `Send + Sync` (C102)."
    (not (any? (lambda ((a string)) (not (crossing-atom? nil a))) es))))

(define-rec
  (atom-written (subr kfx (string) string)
    (lambda (x)
      "An effect atom as FX-26 writes it; a read of one global is gathered
       by `show-effs`."
      (let ((at (lambda ((p string)) (let ((r (after-prefix x p))) (if (has-prefix? r "'") (after-prefix r "'") r)))))
        (cond ((string=? x "spin") "spin")
              ((string=? x "nondet") "nondet")
              ((string=? x "@globals") "(read @globals)")
              ((has-prefix? x "io:") (string-append "(io " (string-append (after-prefix x "io:") ")")))
              ((region-atom? x)
               (string-append "(" (string-append (substring-of (atom-kind x) (i64- (string-length-i64 (atom-kind x)) 1))
                 (string-append " " (string-append (at (atom-kind x)) ")")))))
              ((has-prefix? x "~") (after-prefix x "~"))
              (else x))))))

(define show-effs (subr kfx (strings) string)
  (lambda (es)
    "An effect as FX-26 writes it: `pure`, an atom, or `(maxeff ...)`, the
     globals read gathered, `(read (globals f g))`; its atoms, and the
     globals' names, in order, as Fixpt writes them (TODO §30)."
    (let* ((globals (sorted-strings (concat (map (lambda ((x string)) (if (global-atom? x) (the strings (list (after-prefix x "g:"))) nil)) es))))
           (others (concat (map (lambda ((x string)) (if (or (global-atom? x) (string=? x "~!")) nil (the strings (list (atom-written x))))) es)))
           (parts (sorted-strings (if (null? globals) others (onto others (list (string-append "(read (globals " (string-append (words-of globals) "))"))))))))
      (cond ((null? parts) "pure")
            ((null? (cdr parts)) (car parts))
            (else (string-append "(maxeff " (string-append (words-of parts) ")")))))))

(define find-effdef (subr kfx (cv string effdefs) strings)
  (lambda (v name es)
    (if (null? es)
        (refuse v (string-append "an effect KFX does not have: " name))
        (tagcase (car es)
          (effdef (n atoms) (if (string=? n name) atoms (find-effdef v name (cdr es))))))))

(define cv-effdefs (subr kfx (cv) effdefs)
  (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) es))))

(define region-name (subr kfx (cv strings sexp) string)
  (lambda (v tvars r)
    "A region's name: a constant, `@a`, or a poly's region binder, `'r`."
    (let ((s (tagcase r
               (sym (n at-file at-pos) n)
               ;; `(const heap)` and `(acyclic heap)` are `const` and `acyclic`
               ;; (C161); frozen into another place, not yet.
               (lst (xs f l p)
                 (if (and (i64= (size xs) 2) (or (sym-is? (car xs) "const") (sym-is? (car xs) "acyclic")) (sym-is? (second xs) "heap"))
                     (sym-name (car xs))
                     (refuse v (string-append "a region KFX does not have: " (show-sexp r)))))
               (else other (refuse v (string-append "a region KFX does not have: " (show-sexp other)))))))
      (cond ((string=? s "@globals")
             (refuse v "globals are a region only in effects: (read @globals), (read (globals g))"))
            ((char=? (string-ref-i64 s 0) #\@) s)
            ((string=? s "acyclic") s)
            ((string=? s "const")
             "Data frozen into the heap, which nothing may write any more; it may
              have been written before, so may be cyclic (Fixpt's
              acyclic-regions.md; C161)."
             s)
            ((string-member? (string-append "'" s) tvars) (string-append "'" s))
            ((and (char=? (string-ref-i64 s 0) #\') (string-member? s tvars)) s)
            (else (refuse v (string-append "a region KFX-0 does not have: " s)))))))

(define parse-region (subr kfx (cv strings sexp) ty)
  (lambda (v tvars r)
    (let ((name (region-name v tvars r)))
      (if (char=? (string-ref-i64 name 0) #\') (ty-var name) (ty-rconst name)))))

(define parse-mutable-region (subr kfx (cv strings sexp) ty)
  (lambda (v tvars r)
    "The region of data that may be written: not `acyclic` nor `const`, which
     are frozen."
    (if (or (sym-is? r "acyclic") (sym-is? r "const"))
        (refuse v "mutable data at acyclic, which is frozen and never written")
        (parse-region v tvars r))))

"FX-26's standard type `io-error` (Fixpt 17ac0c5, C49): an I/O failure's
 kind, for a `tagcase`, and the system's words."
(define io-error-text string
  "(productof (kind (sumof (not-found unit) (permission-denied unit) (already-exists unit) (not-a-directory unit)
                           (is-a-directory unit) (broken-pipe unit) (invalid-data unit) (other unit)))
              (detail string))")

(define io-kind? (subr kfx (string) bool)
  (lambda (k)
    "The `io` effects' kinds, a fixed family (C49)."
    (string-member? k (list "stdin" "stdout" "stderr" "fs-read" "fs-write" "clock" "args" "exit" "terminal" "native"))))

(define-rec
  (parse-effect (subr kfx (cv strings sexp) strings)
    (lambda (v tvars e)
      (tagcase e
        (sym (s at-file at-pos)
          (cond ((string=? s "pure") nil)
                ((string=? s "spin") (list "spin"))
                ((string=? s "%found")
                 (refuse v "`(->* (param ...) result)` is only the type a definition declares (`define`, `define-rec`)"))
                ((string=? s "nondet")
                 "That an answer may differ from run to run (C101): no region, so
                  never masked, as `spin`."
                 (list "nondet"))
                ((string-member? (string-append "~" s) tvars)
                 "A poly's effect binder (C46): an atom of its own, `~e`."
                 (list (string-append "~" s)))
                (else (find-effdef v s (cv-effdefs v)))))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "maxeff") (parse-effects v tvars (cdr xs)))
                ((and (sym-is? (car xs) "select") (i64= (size xs) 3))
                 "A module's effect, as the module defined at the top level gives it."
                 (find-effdef v (string-append (name-of v (second xs)) (string-append " " (name-of v (third xs)))) (cv-effdefs v)))
                ((and (sym-is? (car xs) "io") (i64= (size xs) 2) (io-kind? (tagcase (second xs) (sym (n f p) n) (else other ""))))
                 "An I/O effect (C49), `io:` and its kind: no region, so never masked."
                 (list (string-append "io:" (sym-name (second xs)))))
                ((and (sym-is? (car xs) "read") (sym-is? (second xs) "@globals")) (list "@globals"))
                ((and (sym-is? (car xs) "read") (head-is? (second xs) "globals"))
                 (map (lambda ((g sexp)) (string-append "g:" (name-of v g))) (cdr (items (second xs)))))
                ((and (i64= (size xs) 2) (any? (lambda ((k string)) (sym-is? (car xs) k)) region-kinds))
                 (list (string-append (name-of v (car xs)) (string-append ":" (region-name v tvars (second xs))))))
                (else (refuse v (string-append "an effect KFX does not have: " (show-sexp e))))))
        (else other (refuse v (string-append "an effect KFX does not have: " (show-sexp e)))))))
  (parse-effects (subr kfx (cv strings sexps) strings)
    (lambda (v tvars es)
      (if (null? es) nil (effs-union (parse-effect v tvars (car es)) (parse-effects v tvars (cdr es)))))))

(define rename-atoms (subr kfx (strings string string) strings)
  (lambda (es from to)
    "Effect atoms on region `from` made atoms on region `to`."
    (map (lambda ((x string))
           (cond ((and (region-atom? x) (string=? (atom-region x) from)) (string-append (atom-kind x) to))
                 ((and (has-prefix? from "~") (string=? x from)) (if (has-prefix? to "~") to (string-append "~" to)))
                 (else x)))
         es)))

(define-rec
  (remove-atom (subr kfx (string strings) strings)
    (lambda (x es)
      (cond ((null? es) nil)
            ((string=? (car es) x) (remove-atom x (cdr es)))
            (else (cons (car es) (remove-atom x (cdr es))))))))

(define effect-row (subr kfx (strings) ty)
  (lambda (atoms)
    "An effect as a type, where an effect binder is given one (C46): the
     row of its atoms, held as a procedure's latent effect."
    (ty-proc atoms nil (ty-unit))))

(define rename-region (subr kfx (strings string ty) strings)
  (lambda (es name m)
    "Effects on region `name`, made effects on the region `m` stands for."
    (tagcase m
      (ty-meta (k) (rename-atoms es name (string-append "?" (i64->string k))))
      (ty-rconst (n) (rename-atoms es name n))
      (ty-var (n) (rename-atoms es name n))
      (ty-proc (as ps r)
        "An effect binder given an effect, a row (C46): its atoms in its place."
        (if (string-member? name es) (effs-union as (remove-atom name es)) es))
      (else other es))))

(define meta-name (subr kfx (i64) string)
  (lambda (k) (string-append "?" (i64->string k))))

(define-rec
  (replace-var (subr kfx (string ty ty) ty)
    (lambda (name m t)
      (tagcase t
        (ty-var (n) (if (string=? n name) m t))
        (ty-list (e r) (ty-list (replace-var name m e) (replace-var name m r)))
        (ty-flat (e r) (ty-flat (replace-var name m e) (replace-var name m r)))
        (ty-shape (p ls ts) (ty-shape p ls (map (lambda ((x ty)) (replace-var name m x)) ts)))
        (ty-tag (a h d r) (ty-tag (replace-var name m a) (replace-var name m h) (rename-region d name m) (replace-var name m r)))
        (ty-data (d args) (ty-data d (map (lambda ((x ty)) (replace-var name m x)) args)))
        (ty-ref (e r) (ty-ref (replace-var name m e) (replace-var name m r)))
        (ty-proc (es ps r)
          (ty-proc (rename-region es name m)
                   (map (lambda ((p ty)) (replace-var name m p)) ps) (replace-var name m r)))
        (else other t)))))

(define-rec
  (fold-renames (subr kfx (strings i64 ty) ty)
    (lambda (names pos t)
      "Each binder `n` of a poly type written at `pos`, its kind's mark first
       (`'n` a region's, `#n` a size's, a type's none), named `n@pos` (C107,
       C158)."
      (if (null? names)
          t
          (fold-renames (cdr names) pos
                        (replace-var (car names) (ty-var (string-append (car names) (string-append "@" (i64->string pos)))) t))))))

(define binder-kind (subr kfx (string) string)
  (lambda (n) (cond ((has-prefix? n "'") "region") ((has-prefix? n "#") "size") (else "type"))))

(define all-regions? (subr kfx (strings) bool)
  (lambda (ns) (not (any? (lambda ((n string)) (not (has-prefix? n "'"))) ns))))

(define-rec
  (poly-binders-of (subr kfx (tys) strings)
    (lambda (args)
      "A poly type's binders' names: all its parts but the last, its body."
      (if (or (null? args) (null? (cdr args)))
          nil
          (cons (tagcase (car args) (ty-var (n) n) (else other "")) (poly-binders-of (cdr args)))))))

(define poly-body (subr kfx (tys) ty)
  (lambda (args) (last args)))

(define-rec
  (taken-before (subr kfx (chars char) chars)
    (lambda (cs c) (if (or (null? cs) (char=? (car cs) c)) nil (cons (car cs) (taken-before (cdr cs) c))))))

(define written-binder (subr kfx (string) string)
  (lambda (n)
    "A poly type's binder as written: `'r@P` is `r`, `#n@P` `n`."
    (let ((cs (string-chars (cond ((has-prefix? n "'") (after-prefix n "'")) ((has-prefix? n "#") (after-prefix n "#")) (else n)))))
      (list->string (taken-before cs #\@)))))

(define substitute-each (subr kfx (strings tys ty) ty)
  (lambda (params args t)
    (if (or (null? params) (null? args))
        t
        (substitute-each (cdr params) (cdr args) (replace-var (car params) (car args) t)))))

(define substitute (subr kfx (strings tys ty) ty)
  (lambda (params args t)
    "`t`, each of `params` replaced by its argument, all at once: first each
     by a name no argument has, so that an argument naming a parameter is
     not replaced again."
    (let ((temps (map (lambda ((p string)) (string-append (if (has-prefix? p "~") "~%subst " "%subst ") p)) params)))
      (substitute-each temps args
                       (substitute-each params (map (lambda ((p string)) (ty-var p)) temps) t)))))

(define-rec
  (i64s-below (subr kfx (i64) (listof i64 acyclic))
    (lambda (n) (if (i64<= n 0) nil (cons (i64- n 1) (i64s-below (i64- n 1)))))))

(define poly-instance (subr kfx (tys tys) ty)
  (lambda (args regions)
    "A poly type's body, its binders given `regions` (C107)."
    (substitute (poly-binders-of args) regions (poly-body args))))

(define-rec
  (binders-shown (subr kfx (strings) string)
    (lambda (ns)
      "A poly type's binders, as written."
      (cond ((null? ns) "")
            ((null? (cdr ns)) (string-append "(" (string-append (written-binder (car ns)) (string-append " " (string-append (binder-kind (car ns)) ")")))))
            (else (string-append "(" (string-append (written-binder (car ns)) (string-append " " (string-append (binder-kind (car ns)) (string-append ") " (binders-shown (cdr ns))))))))))))

(define poly-written (subr kfx (tys) ty)
  (lambda (args)
    "A poly type's body, its binders as written, `'r` (C107)."
    (poly-instance args (map (lambda ((n string)) (ty-var (cond ((has-prefix? n "'") (string-append "'" (written-binder n)))
                                                                 ((has-prefix? n "#") (string-append "#" (written-binder n)))
                                                                 (else (written-binder n)))))
                             (poly-binders-of args)))))

"Types"

(define cv-dts (subr kfx (cv) dts) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) ds))))
(define cv-aliases (subr kfx (cv) aliases) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) als))))
(define cv-binds (subr kfx (cv) binds) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) bs))))
(define cv-group (subr kfx (cv) strings) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) group))))
(define cv-tvars (subr kfx (cv) strings) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) tv))))

(define with-tvars (subr kfx (cv strings) cv)
  (lambda (v names)
    "`v`, with the type and region variables `names` in scope."
    (tagcase v (cv (bs ds als es here group file line fs tv at) (cv bs ds als es here group file line fs (onto names tv) at)))))

(define dt-named? (subr kfx (string dts) bool)
  (lambda (name ds)
    (any? (lambda ((d dt)) (tagcase d (dt (n ps vs) (string=? n name)))) ds)))

(define-rec
  (find-family (subr kfx (string dts) (union nil dt))
    (lambda (name ds)
      "A datatype, its parameters and variants, or `nil` (C84: a union, where
       it had been a list of one or none)."
      (cond ((null? ds) nil)
            ((tagcase (car ds) (dt (n ps vs) (string=? n name))) (car ds))
            (else (find-family name (cdr ds)))))))

(define find-alias (subr kfx (string aliases) (listof alias acyclic))
  (lambda (name als)
    "A type abbreviation, its parameters and what it stands for, as a list
     of one, or none."
    (cond ((null? als) nil)
          (else (tagcase (car als)
                  (alias (n ps t) (if (string=? n name) (list (car als)) (find-alias name (cdr als)))))))))

(define expanding (subr kfx (strings) strings)
  (lambda (tvars)
    "The type abbreviations being expanded, which `tvars` carries, marked,
     so that one that mentions itself is found."
    (cond ((null? tvars) nil)
          ((and (i64> (string-length-i64 (car tvars)) 0) (char=? (string-ref-i64 (car tvars) 0) #\%))
           (cons (car tvars) (expanding (cdr tvars))))
          (else (expanding (cdr tvars))))))

(define find-bind (subr kfx (string binds) binds)
  (lambda (name bs)
    "The innermost binding of `name`, as a list of one, or none."
    (cond ((null? bs) nil)
          (else (tagcase (car bs)
                  (bind (n sc wher) (if (string=? n name) (list (car bs)) (find-bind name (cdr bs)))))))))

(define-rec
  (conversion-bind (subr kfx (string binds) binds)
    (lambda (name bs)
      "A generative type's conversion, the global or item `name`: not a local
       that hides it."
      (cond ((null? bs) nil)
            ((tagcase (car bs) (bind (n sc w) (and (string=? n name) (or (string=? w "global") (string=? w "item")))))
             (the binds (list (car bs))))
            (else (conversion-bind name (cdr bs)))))))

(define char-lower? (subr kfx (char) bool)
  (lambda (c) (has-char-in? "abcdefghijklmnopqrstuvwxyz" c)))

(define-rec
  (same-at? (subr kfx (string string i64 i64 i64) bool)
    (lambda (s part at i n)
      (or (i64= i n)
          (and (char=? (string-ref-i64 s (i64+ at i)) (string-ref-i64 part i)) (same-at? s part at (i64+ i 1) n))))))

(define-rec
  (has-from? (subr kfx (string string i64) bool)
    (lambda (s part at)
      (and (not (i64< (i64- (string-length-i64 s) at) (string-length-i64 part)))
           (or (same-at? s part at 0 (string-length-i64 part)) (has-from? s part (i64+ at 1)))))))

(define string-has? (subr kfx (string string) bool)
  (lambda (s part)
    "Whether `part` is in `s`: compared in place, making nothing."
    (has-from? s part 0)))

(define rust-keyword-clash? (subr kfx (string) bool)
  (lambda (n)
    "Whether `n` is a Rust keyword no raw identifier may be, `self`, `super`,
     `crate`, or one as a type's name (`Self`): KFX names none so. The
     others are Rust's `r#loop` (C41)."
    (or (string-member? n (list "self" "super" "crate"))
        (string=? (camel n) "Self"))))

(define rust-type-names (subr kfx () strings)
  (lambda ()
    "The types Rust or kayak-rt has that the emitter writes: no KFX type and
     no type variable is named so, camel-cased, which would hide it."
    (list "Str" "List" "Cons" "Int" "Tag" "Unwind" "Ref" "FlatArray" "Knot" "Show" "OnceCell" "Fn"
          "Result" "Ok" "Err" "String" "Copy" "Clone" "Self" "Module" "Void" "Bloblet" "BlobRef" "Arena"
          "Holds" "ListAt" "RefAt" "TBloblet" "FlatArr" "Flat" "Owner" "Default" "Procedure"
          "Native" "NativeFields" "Sealed" "Written")))

(define kfx-name? (subr kfx (string) bool)
  (lambda (n)
    "Whether `n` may be a KFX name (C27): a lower-case letter or an operator's
     character first, then those, digits and `-`; no `--` (the emitter's
     `__`); and none whose Rust name kayak-rt or the emitter writes."
    (let ((cs (string-chars n)))
      (and (not (null? cs))
           (not (rust-keyword-clash? n))
           (or (char-lower? (car cs)) (has-char-in? "?!<>=+*/%-" (car cs)))
           (not (any? (lambda ((c char)) (not (or (char-lower? c) (char-numeric? c) (has-char-in? "?!<>=+*/%-" c)))) cs))
           (not (string-has? n "--"))
           (not (string-member? (mangle n) (list "str_lit" "int_lit" "int_text" "unreachable_unwind"
                                                 "kfx_toplevel" "once" "alloc" "the" "unwind" "knot" "lambda0" "lambda1"
                                                 "lambda2" "lambda3" "lambda4" "leak_string" "with_big_stack" "fail"
                                                 "make_continuation_prompt_tag" "nil" "cons" "bloblet_written"
                                                 "native_procedure0" "native_procedure1" "native_procedure2" "native_procedure3" "native_procedure4")))))))

(define label-name? (subr kfx (string) bool)
  (lambda (n)
    "Whether `n` may be a product's or a sum's label: as a KFX name (C27),
     but those kayak-rt's functions have, which a Rust field or variant is
     apart from (`cons`, C116: Fixpt's `convention-types.fx`)."
    (or (kfx-name? n) (string-member? n (list "nil" "cons" "once" "alloc" "the" "unwind" "knot" "fail")))))

"A knot through the store (FX-26's `no_knot`): a procedure kept in
 storage at a region, whose latent effect reads that region and does not
 say `spin`, could be fetched from there by a procedure fetched from
 there, a loop with no recursive call, which only its type shows. The
 regions a type keeps things in: a `ref`'s, a list's not `acyclic`; a
 datatype keeps where its fields do; what a generative type is given, KFX
 takes as kept everywhere, more cautious than FX-26. `res` resolves an
 effect's inference variables."

(define region-name-of (subr kfx (ty) string)
  (lambda (r) (tagcase r (ty-var (n) n) (ty-rconst (n) n) (ty-meta (k) (meta-name k)) (else other "?"))))

(define reads-kept (subr kfx (strings strings bool) strings)
  (lambda (atoms kept every)
    (if (string-member? "spin" atoms)
        nil
        (concat (map (lambda ((x string))
                       (if (and (has-prefix? x "read:")
                                (or (string-member? (after-prefix x "read:") kept)
                                    (and every (not (string=? (after-prefix x "read:") "acyclic")))))
                           (the strings (list (after-prefix x "read:")))
                           nil))
                     atoms)))))

(define-rec
  (knot-in (subr kfx (cv (subr kfx (string) string) ty strings bool strings) strings)
    (lambda (v res t kept every seen)
      "The region of a knot `t` ties, kept in `kept` (everywhere, if
       `every`); or none."
      (tagcase t
        (ty-ref (a r) (knot-in v res a (cons (region-name-of r) kept) every seen))
        (ty-list (a r)
          (knot-in v res a (if (or (string=? (region-name-of r) "acyclic") (string=? (region-name-of r) "%fresh")) kept (cons (region-name-of r) kept)) every seen))
        (ty-proc (es ps r)
          (let ((found (reads-kept (map res es) kept every)))
            (if (null? found) (first-knot v res (cons r ps) nil #f seen) found)))
        (ty-tag (a h d r) (first-knot v res (list a h) nil #f seen))
        (ty-shape (p ls ts) (first-knot v res ts kept every seen))
        (ty-data (d args)
          (cond
            ((and (or (string=? d "%array") (string=? d "%icell")) (i64= (size args) 2))
             "An array's elements and an I-cell's value, kept at its region, as
              Fixpt's `knot_in` has them (C119: arrays went unchecked before)."
             (knot-in v res (car args) (cons (region-name-of (car (cdr args))) kept) every seen))
            ((and (string=? d "%bloblet") (not (null? args)))
             "A bloblet's fields, kept at its region (C119), as a ref's value."
             (first-knot v res (cdr args) (cons (region-name-of (car args)) kept) every seen))
            ((string-member? d seen) nil)
            (else
              (let ((found (find-family d (cv-dts v))))
                (if (null? found)
                    nil
                    (tagcase found
                      (dt (n ps vs)
                        (if (null? vs)
                            (let ((down (conversion-bind (string-append "down-" d) (cv-binds v))))
                              (first-knot v res
                                          (onto (if (null? down) nil
                                                    (tagcase (car down)
                                                      (bind (n sc w)
                                                        (tagcase sc
                                                          (scheme (tvars t)
                                                            (tagcase t
                                                              (ty-proc (es xs r) (the tys (list (substitute ps args r))))
                                                              (else other nil)))))))
                                                args)
                                          kept #t (cons d seen)))
                            (first-knot v res
                                        (concat (map (lambda ((x variant))
                                                       (tagcase x (variant (tag fs) (map (lambda ((f ty)) (substitute ps args f)) fs))))
                                                     vs))
                                        kept every (cons d seen))))))))))
        (else other nil))))
  (first-knot (subr kfx (cv (subr kfx (string) string) tys strings bool strings) strings)
    (lambda (v res ts kept every seen)
      (if (null? ts)
          nil
          (let ((found (knot-in v res (car ts) kept every seen)))
            (if (null? found) (first-knot v res (cdr ts) kept every seen) found))))))

(define no-knot (subr kfx (cv (subr kfx (string) string) ty) ty)
  (lambda (v res t)
    (let ((found (knot-in v res t nil #f nil)))
      (if (null? found)
          t
          (refuse v (string-append "a procedure kept in " (string-append (car found) (string-append " reads " (string-append (car found)
                    ", so it could reach itself: it must say spin")))))))))

"Flats (C31): what a blobref points to, raw bytes in a bloblet's suffix,
 laid out as C lays them out: a scalar at its size, a product's fields in
 order each at its alignment and the whole padded to the widest, an
 array's elements one after another. KFX's scalars are FX-26's but `f32`,
 which KFX has not yet."

(define-rec
  (run-together (subr kfx (strings) string)
    (lambda (xs) (if (null? xs) "" (string-append (car xs) (run-together (cdr xs)))))))

(define key-range (subr kfx (string) i64)
  (lambda (key) (cond ((string=? key "u8") 256) ((string=? key "u16") 65536) (else 4294967296))))

(define key-width (subr kfx (ty) i64)
  (lambda (k) (tagcase k (ty-rconst (n) (cond ((string=? n "u8") 1) ((string=? n "u16") 2) (else 4))) (else other 4))))

(define-datatype fvar (fvar string ty))
(define-type fvars (listof fvar acyclic))

(define-rec
  (fvars-of (subr kfx (tys) fvars)
    (lambda (ts)
      (if (or (null? ts) (null? (cdr ts)))
          nil
          (cons (fvar (tagcase (car ts) (ty-rconst (n) n) (else other "")) (car (cdr ts))) (fvars-of (cdr (cdr ts))))))))

(define flat-sum-variants (subr kfx (tys) fvars)
  (lambda (args)
    "A keyed flat sum's variants, its type's arguments after the key."
    (fvars-of (cdr args))))

(define-rec
  (flat? (subr kfx (ty) bool)
    (lambda (t)
      (tagcase t
        (ty-i64 () #t)
        (ty-f64 () #t)
        (ty-data (d args)
          (or (and (null? args) (or (string=? d "i32") (string=? d "u32") (string=? d "u64") (string=? d "f32")))
              (and (string=? d "%flat-array") (flat? (car args)))
              (string=? d "%flat-sum")))
        (ty-shape (p ls ts) (and p (not (null? ts)) (not (any? (lambda ((x ty)) (not (flat? x))) ts))))
        (else other #f)))))

(define-datatype layout (layout i64 i64))

(define round-up (subr kfx (i64 i64) i64)
  (lambda (n a) (i64* (i64-quotient (i64+ n (i64- a 1)) a) a)))

(define-rec
  (flat-layout (subr kfx (ty) layout)
    (lambda (t)
      "A flat's size and alignment, in bytes."
      (tagcase t
        (ty-data (d args)
          (cond ((string=? d "%flat-array")
                 (tagcase (flat-layout (car args))
                   (layout (size align)
                     (layout (i64* size (tagcase (car (cdr args)) (ty-rconst (n) (i64- 0 (digits-value (string-chars n) 0 "" 0))) (else other 0))) align))))
                ((string=? d "u64") (layout 8 8))
                ((string=? d "%flat-sum")
                 (let* ((k (key-width (car args)))
                        (vs (flat-sum-variants args))
                        (widest (any-layout (map (lambda ((f fvar)) (tagcase f (fvar (l x) x))) vs) 0 1)))
                   (tagcase widest
                     (layout (size align)
                       (let ((at (round-up k align)) (whole (if (i64> align k) align k)))
                         (layout (round-up (i64+ at size) whole) whole))))))
                (else (layout 4 4))))
        (ty-shape (p ls ts)
          (tagcase (fields-layout ts 0 1)
            (layout (end align) (layout (round-up end align) align))))
        (else other (layout 8 8)))))
  (any-layout (subr kfx (tys i64 i64) layout)
    (lambda (ts size align)
      "The widest of flats `ts` and their widest alignment: a sum's variant's room."
      (if (null? ts)
          (layout size align)
          (tagcase (flat-layout (car ts))
            (layout (s a) (any-layout (cdr ts) (if (i64> s size) s size) (if (i64> a align) a align)))))))
  (fields-layout (subr kfx (tys i64 i64) layout)
    (lambda (ts at align)
      "The end of fields `ts` laid out from `at`, and their widest alignment."
      (if (null? ts)
          (layout at align)
          (tagcase (flat-layout (car ts))
            (layout (size a)
              (fields-layout (cdr ts) (i64+ (round-up at a) size) (if (i64> a align) a align))))))))

(define variant-offset (subr kfx (tys) i64)
  (lambda (args)
    "Where a keyed flat sum's variant begins: after its tag, at the widest
     variant's alignment."
    (tagcase (any-layout (map (lambda ((f fvar)) (tagcase f (fvar (l x) x))) (flat-sum-variants args)) 0 1)
      (layout (size align) (round-up (key-width (car args)) align)))))

(define field-offset (subr kfx (strings tys string) i64)
  (lambda (ls ts l)
    "The offset of a flat product's field `l`."
    (letrec ((go (subr kfx (strings tys i64) i64)
               (lambda (ls ts at)
                 (tagcase (flat-layout (car ts))
                   (layout (size a)
                     (if (string=? (car ls) l)
                         (round-up at a)
                         (go (cdr ls) (cdr ts) (i64+ (round-up at a) size))))))))
      (go ls ts 0))))

(define scalar-name (subr kfx (ty) string)
  (lambda (t)
    "A flat scalar's name, as its blobref's read and write are named; or ``."
    (tagcase t
      (ty-i64 () "i64")
      (ty-f64 () "f64")
      (ty-data (d args) (if (null? args) d ""))
      (else other ""))))

(define fixed-width? (subr kfx (string) bool)
  (lambda (s)
    "FX-26's fixed-width integers beside `i64` (`u8` and `i8` since Fixpt 17ac0c5), whose arithmetic wraps: a type
     named so, as a datatype is, of no variants; in Rust, Rust's."
    (or (string=? s "i32") (string=? s "u32") (string=? s "u64") (string=? s "u8") (string=? s "i8"))))

"Unions of shapes (C62; FX-26's, docs/fx26.md \"Unions of shapes\"): a
 value of any of its members, whose shapes at run time differ, so that a
 test tells them apart. A `(ty-data \"%union\" members)`, flattened, each
 member once; `false`, the type of `#f` alone, below `bool`, a
 `(ty-data \"false\" nil)`. Never Rust's (C57): the restriction pass's."
(define shape-of (subr kfx (ty) string)
  (lambda (t)
    "A member's shape at run time, or `` if it has none known."
    (tagcase t
      (ty-i64 () "int") (ty-int () "int") (ty-nat () "int") (ty-f64 () "f64") (ty-char () "char")
      (ty-bool () "bool") (ty-string () "string") (ty-unit () "symbol") (ty-list (e r) "list")
      (ty-proc (es ps r) "procedure") (ty-ref (e r) "box") (ty-flat (e r) "bloblet")
      (ty-shape (p ls ts) (if p "product" "sum"))
      (ty-data (d args)
        (cond ((or (string=? d "i32") (string=? d "u32") (string=? d "u64") (string=? d "u8") (string=? d "i8")) "int")
              ((string=? d "f32") "f32")
              ((string=? d "false") "bool")
              ((string=? d "nil") "nil")
              ((string=? d "%pairof") "pair")
              ((string=? d "symbol") "symbol")
              ((string=? d "%array") "bloblet")
              ((string=? d "%bytes") "bytevector")
              ((string=? d "%union") "union")
              ((string=? d "datum") "union")
              ((string=? d "vector") "vector")
              ((or (has-prefix? d "%") (has-char-in? d #\.) (has-char-in? d #\space)) "")
              (else
               "A datatype's value (C84): FX-26's shape `sum`. A generative
                type is named so too, which a union's parse refuses."
               "sum")))
      (else other ""))))

(define-rec
  (union-members (subr kfx (tys) tys)
    (lambda (ts)
      "Members flattened: a union in a union is its members."
      (if (null? ts)
          nil
          (tagcase (car ts)
            (ty-data (d args) (if (string=? d "%union") (onto (union-members args) (union-members (cdr ts))) (cons (car ts) (union-members (cdr ts)))))
            (else other (cons (car ts) (union-members (cdr ts)))))))))

"`datum` (C77), FX-26's union of what a reader reads, `(union int f64
 char bool string symbol nil (pairof datum datum acyclic) vector)`: a
 name, its members found when they are wanted, since it mentions itself.
 FX-26's has `bytevector` too, which KFX's has not yet."
(define datum-members (subr kfx () tys)
  (lambda ()
    (list (ty-int) (ty-f64) (ty-char) (ty-bool) (ty-string) (ty-data "symbol" nil) (ty-data "nil" nil)
          (ty-data "%pairof" (list (ty-data "datum" nil) (ty-data "datum" nil) (ty-rconst "acyclic")))
          (ty-data "vector" nil))))

(define members-of (subr kfx (ty) tys)
  (lambda (t)
    "A union's members; `datum`'s; or none."
    (tagcase t
      (ty-data (d args) (cond ((string=? d "%union") args) ((string=? d "datum") (datum-members)) (else nil)))
      (else other nil))))

(define generative? (subr kfx (cv ty) bool)
  (lambda (v t)
    "A generative type: among the datatypes, with no variants; its shape
     is its representation's, which FX-26 keeps unknown (C84)."
    (tagcase t
      (ty-data (d args)
        (let ((found (find-family d (cv-dts v))))
          (if (null? found) #f (tagcase found (dt (n ps vs) (null? vs))))))
      (else other #f))))

(define-rec
  (member-of-shape (subr kfx (tys string) tys)
    (lambda (ts shape)
      (cond ((null? ts) nil)
            ((string=? (shape-of (car ts)) shape) (list (car ts)))
            (else (member-of-shape (cdr ts) shape))))))

"Sizes' facts (C157; Fixpt's `sizes.rs`, `check-test-facts.fx`, N5b, N5c):
 a linear expression over local names, a constant and each name's
 coefficient; a fact that one is `= 0`, `>= 0`, or `/= 0`, learned in a
 branch of a test, kept in the environment as a binding of no name a
 program writes, `wher` `fact KIND C N K ...`."
(define-datatype lterm (lterm string i64))
(define-datatype lin (lin i64 (listof lterm acyclic)))
(define-type lins (listof lin acyclic))

(define-rec
  (lterms-added (subr kfx ((listof lterm acyclic) string i64) (listof lterm acyclic))
    (lambda (ts n k)
      (cond ((null? ts) (if (i64= k 0) nil (list (lterm n k))))
            ((tagcase (car ts) (lterm (m j) (string=? m n)))
             (tagcase (car ts) (lterm (m j) (if (i64= (i64+ j k) 0) (cdr ts) (cons (lterm m (i64+ j k)) (cdr ts))))))
            (else (cons (car ts) (lterms-added (cdr ts) n k)))))))

(define-rec
  (lin-terms-onto (subr kfx ((listof lterm acyclic) (listof lterm acyclic) i64) (listof lterm acyclic))
    (lambda (ts acc k)
      (if (null? ts) acc (tagcase (car ts) (lterm (n j) (lin-terms-onto (cdr ts) (lterms-added acc n (i64* j k)) k)))))))

(define lin-add (subr kfx (lin lin i64) lin)
  (lambda (a b k)
    "`a + k b`."
    (tagcase a (lin (ca ta) (tagcase b (lin (cb tb) (lin (i64+ ca (i64* k cb)) (lin-terms-onto tb ta k))))))))

(define lin-scaled (subr kfx (lin i64) lin) (lambda (a k) (lin-add (lin 0 nil) a k)))

(define lin-coef (subr kfx (lin string) i64)
  (lambda (a n)
    (tagcase a (lin (c ts) (let ((found (filter (lambda ((t lterm)) (tagcase t (lterm (m j) (string=? m n)))) ts)))
                             (if (null? found) 0 (tagcase (car found) (lterm (m j) j))))))))

(define lin-names (subr kfx (lin) strings) (lambda (a) (tagcase a (lin (c ts) (map (lambda ((t lterm)) (tagcase t (lterm (n j) n))) ts)))))

(define lin-text (subr kfx (lin) string)
  (lambda (a)
    (tagcase a (lin (c ts) (words-of (cons (i64->string c) (concat (map (lambda ((t lterm)) (tagcase t (lterm (n j) (the strings (list n (i64->string j)))))) ts))))))))

(define-rec
  (digits-i64-of (subr kfx (chars i64) i64)
    (lambda (cs n) (if (null? cs) n (digits-i64-of (cdr cs) (i64+ (i64* n 10) (i64- (char->i64 (car cs)) 48)))))))

(define string->i64 (subr kfx (string) i64)
  (lambda (t)
    (let ((cs (string-chars t)))
      (if (and (not (null? cs)) (char=? (car cs) #\-)) (i64- 0 (digits-i64-of (cdr cs) 0)) (digits-i64-of cs 0)))))

(define-rec
  (fact-words-from (subr kfx (chars chars strings) strings)
    (lambda (cs w acc)
      (cond ((null? cs) (reverse (if (null? w) acc (the strings (cons (list->string (reverse w)) acc)))))
            ((char=? (car cs) #\space) (fact-words-from (cdr cs) nil (if (null? w) acc (the strings (cons (list->string (reverse w)) acc)))))
            (else (fact-words-from (cdr cs) (cons (car cs) w) acc))))))

(define text-words (subr kfx (string) strings) (lambda (t) (fact-words-from (string-chars t) nil nil)))

(define second-word (subr kfx (strings) string) (lambda (ws) (car (cdr ws))))

(define-rec
  (lterms-read (subr kfx (strings) (listof lterm acyclic))
    (lambda (ws) (if (or (null? ws) (null? (cdr ws))) nil (cons (lterm (car ws) (string->i64 (second-word ws))) (lterms-read (cdr (cdr ws))))))))

(define lin-read (subr kfx (strings) lin)
  (lambda (ws) (lin (string->i64 (car ws)) (lterms-read (cdr ws)))))

"Whether inequalities `ls`, each `l >= 0`, have no solution, by
 Fourier-Motzkin elimination over the rationals: sound for the integers,
 not complete. Too many, and the answer is that they may have one."
(define-rec
  (no-solution? (subr kfx (lins i64) bool)
    (lambda (ls budget)
      (cond ((i64> (size ls) 400) #f)
            ((any? (lambda ((l lin)) (tagcase l (lin (c ts) (and (null? ts) (i64< c 0))))) ls) #t)
            (else
             (let ((open (filter (lambda ((l lin)) (tagcase l (lin (c ts) (not (null? ts))))) ls)))
               (if (or (null? open) (i64<= budget 0))
                   #f
                   (let* ((x (car (lin-names (car open))))
                          (pos (filter (lambda ((l lin)) (i64> (lin-coef l x) 0)) open))
                          (neg (filter (lambda ((l lin)) (i64< (lin-coef l x) 0)) open))
                          (rest (filter (lambda ((l lin)) (i64= (lin-coef l x) 0)) open)))
                     (no-solution? (onto rest (concat (map (lambda ((p lin)) (map (lambda ((q lin)) (lin-add (lin-scaled p (i64- 0 (lin-coef q x))) q (lin-coef p x))) neg)) pos)))
                                   (i64- budget 1))))))))))

(define-rec
  (lin-shown? (subr kfx (lins lins lin) bool)
    (lambda (ges nes goal)
      "Whether facts `ges` (each `>= 0`) and `nes` (each `/= 0`, split into
       `>= 1` and `<= -1`) show `goal >= 0`."
      (if (null? nes)
          (no-solution? (cons (lin-add (lin -1 nil) goal -1) ges) 64)
          (and (lin-shown? (cons (lin-add (car nes) (lin -1 nil) 1) ges) (cdr nes) goal)
               (lin-shown? (cons (lin-add (lin -1 nil) (car nes) -1) ges) (cdr nes) goal))))))

"Sizes in types (C158; Fixpt's `docs/research/sizes.md`): a size is
 `finite`, the top, some size not known; a size variable, a binder of
 kind `size` (`#n`) or an inference variable; or a linear one, a constant
 and each variable's coefficient: `(ty-data \"%sz\" (k t ...))`, `k` its
 constant (`%k C`) and each `t` a variable times its coefficient (`%t
 K`), so that instantiating and solving see the variables. `(nat s)` is
 `%natof`, `nat` itself `(nat finite)`; `(nlist T s)`, a list of
 exactly `s` elements, frozen, `%nlist`."
(define size-finite ty (ty-data "%finite" nil))

(define size-term-var (subr kfx (string) ty)
  (lambda (n) (if (has-prefix? n "?") (ty-meta (string->i64 (after-prefix n "?"))) (ty-var n))))

(define size-of-lin (subr kfx (lin) ty)
  (lambda (l)
    (tagcase l
      (lin (c ts)
        (if (and (i64= c 0) (not (null? ts)) (null? (cdr ts)) (tagcase (car ts) (lterm (n k) (i64= k 1))))
            ;; One variable alone: the variable, which may be solved to `finite`.
            (tagcase (car ts) (lterm (n k) (size-term-var n)))
        (ty-data "%sz" (cons (ty-data (string-append "%k " (i64->string c)) nil)
                             (map (lambda ((t lterm)) (tagcase t (lterm (n k) (ty-data (string-append "%t " (i64->string k)) (list (size-term-var n)))))) ts))))))))

(define-rec
  (parse-size-lin (subr kfx (cv strings sexp) lins)
    (lambda (v tvars z)
      "A size as written (C158), as a linear expression; none for `finite`: a
       literal, `finite`, a size variable, `(+ s ...)`, `(- s k)`."
      (tagcase z
        (num (k f p) (if (i64< k 0) (refuse v "a size is never negative") (list (lin k nil))))
        (sym (n f p)
          (cond ((string=? n "finite") nil)
                ((string-member? (string-append "#" n) tvars) (list (lin 0 (list (lterm (string-append "#" n) 1)))))
                (else (refuse v (string-append "a size: a natural, finite, a size variable, (+ s ...), (- s k): " n)))))
        (lst (xs f l p)
          (cond ((and (sym-is? (car xs) "+") (not (null? (cdr xs))))
                 (sizes-summed v tvars (cdr xs) (lin 0 nil)))
                ((and (sym-is? (car xs) "-") (i64= (size xs) 3) (tagcase (third xs) (num (k f2 p2) #t) (else other #f)))
                 (let ((a (parse-size-lin v tvars (second xs))))
                   (if (null? a) nil (list (lin-add (car a) (lin (tagcase (third xs) (num (k f2 p2) k) (else other 0)) nil) -1)))))
                (else (refuse v (string-append "a size: a natural, finite, a size variable, (+ s ...), (- s k): " (show-sexp z))))))
        (else other (refuse v "a size: a natural, finite, a size variable, (+ s ...), (- s k)")))))
  (sizes-summed (subr kfx (cv strings sexps lin) lins)
    (lambda (v tvars zs acc)
      (if (null? zs)
          (list acc)
          (let ((l (parse-size-lin v tvars (car zs))))
            (if (null? l) nil (sizes-summed v tvars (cdr zs) (lin-add acc (car l) 1))))))))

(define parse-size (subr kfx (cv strings sexp) ty)
  (lambda (v tvars z) (let ((l (parse-size-lin v tvars z))) (if (null? l) size-finite (size-of-lin (car l))))))

"Specifications (C162; Fixpt's `check-specs.fx`, `check-logic.fx`): a
 procedure type's `(subr E ((x T) ...) R (requires P) (ensures r Q))`,
 propositions of its `int`s, `nat`s and `bool`s, and of `pure` global
 procedures' values. FX-26's checker reads them, prints them, and holds a
 procedure to the one its type expected (behavioural subtyping, by a
 prover); it proves no body. A specified type is its procedure's, wrapped:
 `(ty-data \"%spec TEXT\" (P))`, `TEXT` the specification written plainly,
 `(spec (NAME ...) RESULT REQUIRES ENSURES)`, each name `%none` where a
 parameter has none; an integer `(lit k)`, `(p i)` (parameter `i`),
 `(res)`, `(add a b)`, `(sub a b)`, `(mul a b)`, `(call f a ...)`; a
 proposition `(true)`, `(false)`, `(rel R a b)` (0 `<`, 1 `<=`, 2 `=`, 3
 not `=`), `(holds a)`, `(not p)`, `(and p ...)`, `(or p ...)`,
 `(implies p q)`."

(define-datatype sname (sname string string ty))
(define-type snames (listof sname acyclic))

(define logic-type-forms strings
  (list "arrayof" "narrayof" "bloblet" "composable" "dletrec" "icell" "listof" "mark-key" "moduleof" "mu"
        "nat" "nlist" "oneshot" "pairof" "place" "poly" "productof" "prompt-tag" "proves" "ref" "select" "subr"
        "sumof" "bool" "union" "->" "->*"
        ;; And those of KFX's types that FX-26 names as types of its base.
        "addr" "blobref" "bytevectorof" "escape-tag" "flatarrayof" "inbox" "vsubr"))
(define logic-keywords strings
  (list "lambda" "plambda" "proj" "if" "letrec" "let" "begin" "define" "define*" "define-type"
        "define-generative" "void" "pure" "maxeff" "read" "write" "alloc" "goto" "comefrom" "region" "effect"
        "type" "prompt" "cond" "else" "and" "or" "let*" "define-effect" "module-parameters" "the" "fields"
        "frozen" "await" "define-rec" "letrena" "letreap" "rlambda" "quote" "product" "extract" "sum" "tagcase"
        "module" "with" "load-module" "define-datatype" "make-bloblet" "bloblet-ref" "bloblet-set!"
        "bloblet-freeze" "bloblet-byte" "bloblet-set-byte!" "bloblet-bytes" "rmake-bloblet" "dlambda" "=>" "case"
        "define-convention"))
(define logic-base-names strings
  (list "int" "nat" "i64" "u64" "i32" "u32" "i16" "u16" "i8" "u8" "f64" "f32" "bool" "char" "unit" "string"
        "symbol" "datum" "void" "false" "nil"))

(define param-name-written (subr kfx (cv strings sexp) string)
  (lambda (v tvars p)
    "A procedure type's parameter's name, `(x T)`, or none (\"\"): a list of
     two whose first is no type form's, keyword's, type's or base type's
     name, as FX-26's `k-param-name` has it."
    (tagcase p
      (lst (xs f l pos)
        (if (and (i64= (size xs) 2) (tagcase (car xs) (sym (n f2 p2) #t) (else other #f)))
            (let ((n (sym-name (car xs))))
              (if (or (string-member? n logic-type-forms) (string-member? n logic-keywords)
                      (string-member? n logic-base-names) (string-member? n tvars)
                      (dt-named? n (cv-dts v)) (not (null? (find-alias n (cv-aliases v)))))
                  ""
                  n))
            ""))
      (else other ""))))

(define param-type-written (subr kfx (cv strings sexp) sexp)
  (lambda (v tvars p) (if (string=? (param-name-written v tvars p) "") p (second (items p)))))

(define logic-head (subr kfx (sexp) string)
  (lambda (x)
    (tagcase x
      (lst (xs f l p) (if (and (not (null? xs)) (tagcase (car xs) (sym (n f2 p2) #t) (else other #f))) (sym-name (car xs)) ""))
      (else other ""))))

(define spec-clause? (subr kfx (sexp) bool)
  (lambda (x) (or (string=? (logic-head x) "requires") (string=? (logic-head x) "ensures"))))

(define-rec
  (clauses-count (subr kfx (sexps i64) i64)
    (lambda (xs n) (if (and (not (null? xs)) (spec-clause? (car xs))) (clauses-count (cdr xs) (i64+ n 1)) n))))

(define clauses-ending (subr kfx (sexps) i64)
  (lambda (xs) (clauses-count (reverse xs) 0)))

(define-rec
  (spec-firsts (subr kfx (sexps i64) sexps)
    (lambda (xs n) (if (i64= n 0) nil (cons (car xs) (spec-firsts (cdr xs) (i64- n 1)))))))

(define-rec
  (spec-drop (subr kfx (sexps i64) sexps)
    (lambda (xs n) (if (i64= n 0) xs (spec-drop (cdr xs) (i64- n 1))))))

(define-rec
  (logic-nth (subr kfx (sexps i64) sexp)
    (lambda (xs i) (if (i64= i 0) (car xs) (logic-nth (cdr xs) (i64- i 1))))))

(define logic-literal-symbol? (subr kfx (sexp) bool)
  (lambda (x) (tagcase x (sym (n f p) (string-member? n (list "#t" "#f" "#u"))) (else other #f))))

(define logic-int-ty? (subr kfx (ty) bool)
  (lambda (t) (tagcase t (ty-int () #t) (ty-nat () #t) (ty-data (d args) (string=? d "%natof")) (else other #f))))

(define logic-bool-ty? (subr kfx (ty) bool)
  (lambda (t) (tagcase t (ty-bool () #t) (else other #f))))

(define sname-find (subr kfx (snames string) snames)
  (lambda (ns n) (filter (lambda ((x sname)) (tagcase x (sname (m atom t) (string=? m n)))) ns)))

(define procedure-within (subr kfx (ty) ty)
  (lambda (t)
    "The procedure of a specified type, or of a convention's (C116): its
     `ty-proc`, or `t` itself."
    (tagcase t
      (ty-data (d args)
        (if (and (or (has-prefix? d "%spec ") (string=? d "%fx") (string=? d "%native")) (not (null? args)))
            (tagcase (car args)
              (ty-data (d2 args2) (if (and (or (string=? d2 "%fx") (string=? d2 "%native")) (not (null? args2))) (car args2) (car args)))
              (else other (car args)))
            t))
      (else other t))))

(define logic-callee (subr kfx (cv sexps) tys)
  (lambda (v xs)
    "Of `(f a ...)`, `f`'s type where its innermost binding is a global's
     (FX-26's `k-spec-callee?`), or none."
    (if (or (null? xs) (logic-literal-symbol? (car xs)) (not (tagcase (car xs) (sym (n f p) #t) (else other #f))))
        nil
        (let ((b (find-bind (sym-name (car xs)) (cv-binds v))))
          (if (null? b)
              nil
              (tagcase (car b) (bind (n sc wher) (if (string=? wher "global") (tagcase sc (scheme (vs t) (the tys (list t)))) nil))))))))

(define-rec
  (logic-term (subr kfx (cv snames sexp) string)
    (lambda (v names x)
      "An integer of a specification: a literal, a name of an `int` or a
       `nat`, `(+ a ...)`, `(- a)`, `(- a b ...)`, `(* a ...)`, a logic
       function's value."
      (let ((usage "an integer: a literal, an `int` or `nat` named, `(+ a …)`, `(- a b …)` or `(* a …)`"))
        (tagcase x
          (num (k f p) (string-append "(lit " (string-append (i64->string k) ")")))
          (sym (n f p)
            (if (logic-literal-symbol? x)
                (refuse v usage)
                (let ((found (sname-find names n)))
                  (cond ((null? found) (refuse v (string-append "`" (string-append n "` names no parameter or result here"))))
                        ((tagcase (car found) (sname (m atom t) (logic-int-ty? t))) (tagcase (car found) (sname (m atom t) atom)))
                        (else (refuse v (string-append "`" (string-append n "` is not an `int`"))))))))
          (lst (xs f l p)
            (let ((hd (logic-head x)))
              (if (and (not (string-member? hd (list "+" "-" "*"))) (not (null? (logic-callee v xs))))
                  (logic-call v names xs #f)
                  (let ((args (map (lambda ((a sexp)) (logic-term v names a)) (if (null? xs) nil (cdr xs)))))
                    (cond ((and (string=? hd "+") (not (null? args))) (logic-folded "add" (car args) (cdr args)))
                          ((and (string=? hd "*") (not (null? args))) (logic-folded "mul" (car args) (cdr args)))
                          ((and (string=? hd "-") (i64= (size args) 1)) (string-append "(sub (lit 0) " (string-append (car args) ")")))
                          ((and (string=? hd "-") (i64> (size args) 1)) (logic-folded "sub" (car args) (cdr args)))
                          (else (refuse v usage)))))))
          (else other (refuse v usage))))))
  (logic-folded (subr kfx (string string strings) string)
    (lambda (op a xs)
      (if (null? xs)
          a
          (logic-folded op (string-append "(" (string-append op (string-append " " (string-append a (string-append " " (string-append (car xs) ")"))))))
                        (cdr xs)))))
  (logic-call (subr kfx (cv snames sexps bool) string)
    (lambda (v names xs want-bool)
      "`(f a ...)`, a logic function's value at its arguments: `f` a global
       procedure, `pure`, of a `bool` result (`want-bool`) or an `int`'s or
       `nat`'s; each argument an integer where `f` takes one, else a
       parameter or the result, named."
      (let* ((fname (sym-name (car xs)))
             (t (procedure-within (car (logic-callee v xs)))))
        (tagcase t
          (ty-proc (es ps r)
            (cond ((not (null? es)) (refuse v (string-append "`" (string-append fname "` is called in a specification, so must be `pure`"))))
                  ((and want-bool (not (logic-bool-ty? r))) (refuse v (string-append "`" (string-append fname "` gives no `bool`, so is no proposition"))))
                  ((and (not want-bool) (not (logic-int-ty? r))) (refuse v (string-append "`" (string-append fname "` gives no `int` or `nat`, so is no integer"))))
                  ((not (i64= (size ps) (size (cdr xs))))
                   (refuse v (string-append "`" (string-append fname (string-append "` takes " (string-append (i64->string (size ps)) (string-append " arguments, not " (i64->string (size (cdr xs))))))))))
                  (else
                   (string-append "(call " (string-append fname (string-append (logic-args v names (cdr xs) ps fname) ")"))))))
          (else other (refuse v (string-append "`" (string-append fname "` is called in a specification, and is no procedure"))))))))
  (logic-args (subr kfx (cv snames sexps tys string) string)
    (lambda (v names xs ps fname)
      (if (null? xs)
          ""
          (string-append " "
            (string-append
              (if (logic-int-ty? (car ps))
                  (logic-term v names (car xs))
                  (let ((found (tagcase (car xs) (sym (n f p) (if (logic-literal-symbol? (car xs)) nil (sname-find names n))) (else other nil))))
                    (if (null? found)
                        (refuse v (string-append "an argument of `" (string-append fname "` in a specification: a parameter or the result, named")))
                        (tagcase (car found) (sname (m atom t) atom)))))
              (logic-args v names (cdr xs) (cdr ps) fname))))))
  (logic-prop (subr kfx (cv snames sexp) string)
    (lambda (v names x)
      "A proposition: `(< a b)`, `(<= a b)`, `(= a b)`, `(> a b)`, `(>= a b)`
       of integers; `(not p)`, `(and p ...)`, `(or p ...)`, `(implies p q)`;
       `#t`, `#f`; a `bool` named; a logic function's `bool`."
      (let ((usage "a proposition: `(< a b)`, `(<= a b)`, `(= a b)`, `(> a b)`, `(>= a b)`, `(not p)`, `(and p …)`, `(or p …)`, `(implies p q)`, `#t`, `#f`, or a `bool` named"))
        (tagcase x
          (sym (n f p)
            (cond ((string=? n "#t") "(true)")
                  ((string=? n "#f") "(false)")
                  ((logic-literal-symbol? x) (refuse v usage))
                  (else
                   (let ((found (sname-find names n)))
                     (cond ((null? found) (refuse v (string-append "`" (string-append n "` names no parameter or result here"))))
                           ((tagcase (car found) (sname (m atom t) (logic-bool-ty? t)))
                            (tagcase (car found) (sname (m atom t) (string-append "(holds " (string-append atom ")")))))
                           (else (refuse v (string-append "`" (string-append n "` is not a `bool`, so not a proposition")))))))))
          (lst (xs f l p)
            (let* ((hd (logic-head x))
                   (args (if (null? xs) nil (cdr xs)))
                   (n (size args)))
              (cond ((string=? hd "<") (logic-rel v names hd args "0" #f))
                    ((string=? hd "<=") (logic-rel v names hd args "1" #f))
                    ((string=? hd "=") (logic-rel v names hd args "2" #f))
                    ((string=? hd ">") (logic-rel v names hd args "0" #t))
                    ((string=? hd ">=") (logic-rel v names hd args "1" #t))
                    ((string=? hd "not")
                     (if (i64= n 1) (string-append "(not " (string-append (logic-prop v names (car args)) ")")) (refuse v "`(not p)`")))
                    ((string=? hd "and") (string-append "(and" (string-append (logic-props v names args) ")")))
                    ((string=? hd "or") (string-append "(or" (string-append (logic-props v names args) ")")))
                    ((string=? hd "implies")
                     (if (i64= n 2)
                         (string-append "(implies " (string-append (logic-prop v names (car args)) (string-append " " (string-append (logic-prop v names (second args)) ")"))))
                         (refuse v "`(implies p q)`")))
                    ((not (null? (logic-callee v xs))) (string-append "(holds " (string-append (logic-call v names xs #t) ")")))
                    (else (refuse v usage)))))
          (else other (refuse v usage))))))
  (logic-props (subr kfx (cv snames sexps) string)
    (lambda (v names xs)
      (if (null? xs) "" (string-append " " (string-append (logic-prop v names (car xs)) (logic-props v names (cdr xs)))))))
  (logic-rel (subr kfx (cv snames string sexps string bool) string)
    (lambda (v names hd args r swap)
      (if (not (i64= (size args) 2))
          (refuse v (string-append "`(" (string-append hd " a b)`")))
          (let ((x (logic-term v names (car args))) (y (logic-term v names (second args))))
            (string-append "(rel " (string-append r (string-append " " (string-append (if swap y x) (string-append " " (string-append (if swap x y) ")")))))))))))

(define-rec
  (logic-snames (subr kfx (strings tys i64) snames)
    (lambda (ns ts i)
      "The parameters named, from `i`, with their types."
      (cond ((or (null? ns) (null? ts)) nil)
            ((string=? (car ns) "") (logic-snames (cdr ns) (cdr ts) (i64+ i 1)))
            (else (cons (sname (car ns) (string-append "(p " (string-append (i64->string i) ")")) (car ts))
                        (logic-snames (cdr ns) (cdr ts) (i64+ i 1))))))))

(define-rec
  (logic-clauses (subr kfx (cv snames ty sexps strings strings string) string)
    (lambda (v names result cs req ens rn)
      "The clauses `cs` read, onto those read so far: `requires`, then
       `ensures`, each at most once; the specification's text, given the
       parameters' names."
      (if (null? cs)
          (string-append (if (null? req) "(true)" (car req))
                         (string-append " " (if (null? ens) "(true)" (car ens))))
          (let* ((c (car cs))
                 (xs (items c))
                 (hd (logic-head c))
                 (usage "a specification is `(requires proposition)`, then `(ensures name proposition)`, each at most once"))
            (cond ((and (string=? hd "requires") (i64= (size xs) 2) (null? req) (null? ens))
                   (logic-clauses v names result (cdr cs) (the strings (list (logic-prop v names (second xs)))) ens rn))
                  ((and (string=? hd "ensures") (i64= (size xs) 3) (null? ens))
                   (let ((r (second xs)))
                     (if (and (tagcase r (sym (n f p) #t) (else other #f)) (not (logic-literal-symbol? r)))
                         (let ((q (logic-prop v (onto names (list (sname (sym-name r) "(res)" result))) (third xs))))
                           (if (string=? rn "")
                               (string-append (sym-name r) (string-append " " (logic-clauses v names result (cdr cs) req (the strings (list q)) (sym-name r))))
                               (logic-clauses v names result (cdr cs) req (the strings (list q)) (sym-name r))))
                         (refuse v "the result's name: `(ensures name proposition)`"))))
                  (else (refuse v usage))))))))

(define specified-type (subr kfx (cv strings ty sexps) ty)
  (lambda (v pnames plain clauses)
    "`plain`, a procedure type just read, with the specification its clauses
     say of its parameters, named `pnames` (\"\" for one not named)."
    (tagcase (procedure-within plain)
      (ty-proc (es ps r)
        (let* ((body (logic-clauses v (logic-snames pnames ps 0) r clauses nil nil ""))
               ;; The result's name is first where an `ensures` names it.
               (named (not (or (has-prefix? body "(") (string=? body ""))))
               (rn (if named (car (text-words body)) "%none"))
               (rest (if named (after-prefix body (string-append rn " ")) body)))
          (ty-data (string-append "%spec (spec ("
                     (string-append (words-of (map (lambda ((n string)) (if (string=? n "") "%none" n)) pnames))
                       (string-append ") " (string-append rn (string-append " " (string-append rest ")"))))))
                   (list plain))))
      (else other plain))))

"The prover (Fixpt's `logic::entails`): whether propositions entail
 another, by refuting them and its negation: the connectives split into
 cases, each case's relations linear inequalities (a product of two
 unknowns, and a logic function's value, an unknown of its own) shown to
 have no solution by Fourier–Motzkin, a `bool` named a flag. Sound, not
 complete: past a depth of cases, it shows nothing."
(define spec-parts (subr kfx (string) sexps)
  (lambda (d) (items (car (read-all (string-chars (after-prefix d "%spec ")) "%spec" 0)))))

(define-rec
  (logic-lin (subr kfx (sexp) lin)
    (lambda (x)
      (let ((xs (items x)) (hd (logic-head x)))
        (cond ((string=? hd "lit") (lin (tagcase (second xs) (num (k f p) k) (else other (the i64 0))) nil))
              ((string=? hd "p") (lin 0 (list (lterm (show-sexp x) 1))))
              ((string=? hd "res") (lin 0 (list (lterm "(res)" 1))))
              ((string=? hd "add") (lin-add (logic-lin (second xs)) (logic-lin (third xs)) 1))
              ((string=? hd "sub") (lin-add (logic-lin (second xs)) (logic-lin (third xs)) -1))
              ((string=? hd "mul")
               (let ((a (logic-lin (second xs))) (b (logic-lin (third xs))))
                 (cond ((null? (lin-names a)) (lin-scaled b (tagcase a (lin (c ts) c))))
                       ((null? (lin-names b)) (lin-scaled a (tagcase b (lin (c ts) c))))
                       (else (lin 0 (list (lterm (show-sexp x) 1)))))))
              (else (lin 0 (list (lterm (show-sexp x) 1)))))))))

(define-datatype ptodo (ptodo sexp bool))
(define-type ptodos (listof ptodo acyclic))

(define-rec
  (logic-infeasible? (subr kfx (lins lins) bool)
    (lambda (ges nes)
      "Whether `ges` (each `>= 0`) and `nes` (each `/= 0`) have no solution."
      (if (null? nes)
          (no-solution? ges 64)
          (and (logic-infeasible? (cons (lin-add (car nes) (lin -1 nil) 1) ges) (cdr nes))
               (logic-infeasible? (cons (lin-add (lin -1 nil) (car nes) -1) ges) (cdr nes)))))))

(define logic-splits? (subr kfx (ptodo) bool)
  (lambda (t)
    (tagcase t
      (ptodo (x yes)
        (let ((hd (logic-head x)))
          (if yes (or (string=? hd "or") (string=? hd "implies")) (string=? hd "and")))))))

(define logic-trivial? (subr kfx (sexp) bool)
  (lambda (x) (or (string=? (logic-head x) "true") (and (string=? (logic-head x) "and") (string=? (show-sexp x) "(and)")))))

(define-rec
  (logic-refuted? (subr kfx (lins lins strings ptodos i64) bool)
    (lambda (ges nes flags todo depth)
      "Whether the case, `ges`, `nes`, the flags (`+` or `-` and a `bool`'s
       atom) and what is still to be taken, `todo` (each proposition held
       or not), has no solution: those that split taken last."
      (let ((plain (filter (lambda ((t ptodo)) (not (logic-splits? t))) todo))
            (split (filter logic-splits? todo)))
        (cond ((not (null? plain)) (logic-step ges nes flags (car plain) (onto (cdr plain) split) depth))
              ((null? split) (logic-infeasible? ges nes))
              ((logic-infeasible? ges nes) #t)
              ((i64<= depth 0) #f)
              (else
               (tagcase (car split)
                 (ptodo (x yes)
                   (let ((xs (cdr (items x))))
                     (not (any? (lambda ((w ptodo)) (not (logic-refuted? ges nes flags (cons w (cdr split)) (i64- depth 1))))
                           (if (string=? (logic-head x) "implies")
                               (list (ptodo (car xs) #f) (ptodo (second xs) #t))
                               (map (lambda ((y sexp)) (ptodo y yes)) xs))))))))))))
  (logic-step (subr kfx (lins lins strings ptodo ptodos i64) bool)
    (lambda (ges nes flags t rest depth)
      (tagcase t
        (ptodo (x yes)
          (let ((hd (logic-head x)) (xs (cdr (items x))))
            (cond ((string=? hd "true") (if yes (logic-refuted? ges nes flags rest depth) #t))
                  ((string=? hd "false") (if yes #t (logic-refuted? ges nes flags rest depth)))
                  ((string=? hd "not") (logic-refuted? ges nes flags (cons (ptodo (car xs) (not yes)) rest) depth))
                  ((string=? hd "and") (logic-refuted? ges nes flags (onto (map (lambda ((y sexp)) (ptodo y #t)) xs) rest) depth))
                  ((string=? hd "or") (logic-refuted? ges nes flags (onto (map (lambda ((y sexp)) (ptodo y #f)) xs) rest) depth))
                  ((string=? hd "implies") (logic-refuted? ges nes flags (cons (ptodo (car xs) #t) (cons (ptodo (second xs) #f) rest)) depth))
                  ((string=? hd "holds")
                   (let ((mine (string-append (if yes "+" "-") (show-sexp (car xs))))
                         (other (string-append (if yes "-" "+") (show-sexp (car xs)))))
                     (if (string-member? other flags) #t (logic-refuted? ges nes (cons mine flags) rest depth))))
                  ((string=? hd "rel")
                   (let* ((r (tagcase (car xs) (num (k f p) k) (else other (the i64 0))))
                          (a (logic-lin (second xs)))
                          (b (logic-lin (third xs)))
                          (b-a (lin-add b a -1))
                          (a-b (lin-add a b -1))
                          (lt (if yes (i64= r 0) (i64= r 1)))
                          (le (if yes (i64= r 1) (i64= r 0)))
                          (eq (if yes (i64= r 2) (i64= r 3)))
                          (ne (if yes (i64= r 3) (i64= r 2))))
                     (cond ((and yes lt) (logic-refuted? (cons (lin-add b-a (lin -1 nil) 1) ges) nes flags rest depth))
                           ((and yes le) (logic-refuted? (cons b-a ges) nes flags rest depth))
                           (lt (logic-refuted? (cons (lin-add a-b (lin -1 nil) 1) ges) nes flags rest depth))
                           (le (logic-refuted? (cons a-b ges) nes flags rest depth))
                           (eq (logic-refuted? (cons a-b (cons b-a ges)) nes flags rest depth))
                           (ne (logic-refuted? ges (cons a-b nes) flags rest depth))
                           (else #f))))
                  (else #f))))))))

(define logic-entails? (subr kfx (sexps sexp) bool)
  (lambda (hyps goal)
    (or (logic-trivial? goal)
        (string-member? (show-sexp goal) (map show-sexp hyps))
        (logic-refuted? nil nil nil (cons (ptodo goal #f) (map (lambda ((h sexp)) (ptodo h #t)) hyps)) 10))))

(define spec-within? (subr kfx (string string) bool)
  (lambda (a b)
    "Whether a procedure specified `a` (\"\" for none) is one specified `b`
     is: it requires no more, and, given `b`'s `requires`, ensures no less."
    (or (string=? a b)
        (let* ((pa (if (string=? a "") nil (spec-parts a)))
               (pb (if (string=? b "") nil (spec-parts b)))
               (truth (lst (list (sym "true" "" 0)) "" 0 0))
               (ra (if (null? pa) truth (fourth pa)))
               (ea (if (null? pa) truth (car (cdr (cdr (cdr (cdr pa)))))))
               (rb (if (null? pb) truth (fourth pb)))
               (eb (if (null? pb) truth (car (cdr (cdr (cdr (cdr pb))))))))
          (and (logic-entails? (list rb) ra) (logic-entails? (list rb ea) eb))))))

(define unspecified (subr kfx (ty) ty)
  (lambda (t) (tagcase t (ty-data (d args) (if (has-prefix? d "%spec ") (car args) t)) (else other t))))

(define spec-of (subr kfx (ty) string)
  (lambda (t) (tagcase t (ty-data (d args) (if (has-prefix? d "%spec ") d "")) (else other ""))))

(define-rec
  (claims-of? (subr kfx (sexp bool) bool)
    (lambda (ens yes)
      "Whether an `ensures` says what a test proves where its result is true
       (`yes`) or false: a conjunct `(implies r p)` (`(implies (not r) p)`),
       `p` a relation of parameters and literals (Fixpt's `k-ensures-latent`)."
      (let ((hd (logic-head ens)) (xs (cdr (items ens))))
        (cond ((string=? hd "and") (any? (lambda ((x sexp)) (claims-of? x yes)) xs))
              ((string=? hd "implies")
               (and (string=? (show-sexp (car xs)) (if yes "(holds (res))" "(not (holds (res)))"))
                    (conjunct-claim? (second xs))))
              (else #f)))))
  (conjunct-claim? (subr kfx (sexp) bool)
    (lambda (q)
      (let ((hd (logic-head q)) (xs (cdr (items q))))
        (cond ((string=? hd "and") (any? conjunct-claim? xs))
              ((string=? hd "rel") (and (logic-plain-term? (second xs)) (logic-plain-term? (third xs))))
              ((string=? hd "not")
               (and (string=? (logic-head (car xs)) "rel")
                    (string=? (show-sexp (second (items (car xs)))) "2")
                    (logic-plain-term? (third (items (car xs)))) (logic-plain-term? (fourth (items (car xs))))))
              (else #f)))))
  (logic-plain-term? (subr kfx (sexp) bool)
    (lambda (x) (or (string=? (logic-head x) "p") (string=? (logic-head x) "lit")))))

(define spec-claims? (subr kfx (string) bool)
  (lambda (d)
    "Whether a specification says what a test proves, which a `lambda`, its
     body not checked to prove it, may not (Fixpt's `k-claimed`)."
    (let ((ens (car (cdr (cdr (cdr (cdr (spec-parts d))))))))
      (or (claims-of? ens #t) (claims-of? ens #f)))))

"Shown, as Fixpt's `k-show-spec`: a parameter by its name, else `$i`; the
 result by its, else `result`."
(define-rec
  (logic-shown (subr kfx (sexps string sexp) string)
    (lambda (names rn x)
      (let ((hd (logic-head x)) (xs (cdr (items x))))
        (cond ((string=? hd "lit") (show-sexp (car xs)))
              ((string=? hd "p")
               (let* ((i (tagcase (car xs) (num (k f p) k) (else other (the i64 0))))
                      (n (if (i64< i (size names)) (show-sexp (logic-nth names i)) "%none")))
                 (if (string=? n "%none") (string-append "$" (i64->string i)) n)))
              ((string=? hd "res") (if (string=? rn "%none") "result" rn))
              ((string=? hd "add") (logic-op-shown names rn "+ " xs))
              ((string=? hd "sub") (logic-op-shown names rn "- " xs))
              ((string=? hd "mul") (logic-op-shown names rn "* " xs))
              ((string=? hd "call") (string-append "(" (string-append (show-sexp (car xs)) (string-append (logic-each-shown names rn (cdr xs)) ")"))))
              ((string=? hd "true") "#t")
              ((string=? hd "false") "#f")
              ((string=? hd "rel")
               (let* ((r (tagcase (car xs) (num (k f p) k) (else other (the i64 0))))
                      (ab (string-append (logic-shown names rn (second xs)) (string-append " " (logic-shown names rn (third xs))))))
                 (cond ((i64= r 3) (string-append "(not (= " (string-append ab "))")))
                       (else (string-append "(" (string-append (cond ((i64= r 0) "<") ((i64= r 1) "<=") (else "=")) (string-append " " (string-append ab ")"))))))))
              ((string=? hd "holds") (logic-shown names rn (car xs)))
              ((string=? hd "not") (string-append "(not " (string-append (logic-shown names rn (car xs)) ")")))
              ((or (string=? hd "and") (string=? hd "or")) (string-append "(" (string-append hd (string-append (logic-each-shown names rn xs) ")"))))
              ((string=? hd "implies") (string-append "(implies " (string-append (logic-shown names rn (car xs)) (string-append " " (string-append (logic-shown names rn (second xs)) ")")))))
              (else (show-sexp x))))))
  (logic-op-shown (subr kfx (sexps string string sexps) string)
    (lambda (names rn op xs)
      (string-append "(" (string-append op (string-append (logic-shown names rn (car xs)) (string-append " " (string-append (logic-shown names rn (second xs)) ")")))))))
  (logic-each-shown (subr kfx (sexps string sexps) string)
    (lambda (names rn xs)
      (if (null? xs) "" (string-append " " (string-append (logic-shown names rn (car xs)) (logic-each-shown names rn (cdr xs))))))))

(define spec-clauses-shown (subr kfx (string) string)
  (lambda (d)
    "A specification's clauses, each after a space, those not `#t`."
    (let* ((ps (spec-parts d))
           (names (items (second ps)))
           (rn (show-sexp (third ps)))
           (req (fourth ps))
           (ens (car (cdr (cdr (cdr (cdr ps)))))))
      (string-append (if (logic-trivial? req) "" (string-append " (requires " (string-append (logic-shown names rn req) ")")))
                     (if (logic-trivial? ens) ""
                         (string-append " (ensures " (string-append (if (string=? rn "%none") "result" rn)
                           (string-append " " (string-append (logic-shown names rn ens) ")")))))))))

(define spec-param-names (subr kfx (string) strings)
  (lambda (d) (map show-sexp (items (second (spec-parts d))))))

(define-rec
  (parse-type (subr kfx (cv strings sexp) ty)
    (lambda (v tvars t)
      "`tvars`: the type variables in scope."
      (tagcase t
        (sym (s at-file at-pos)
          (cond ((string=? s "i64") (ty-i64))
                ((string=? s "int") (ty-int))
                ((string=? s "nat") (ty-nat))
                ((string=? s "f64") (ty-f64))
                ((fixed-width? s) (ty-data s nil))
                ((string=? s "f32") (ty-data s nil))
                ((string=? s "symbol") (ty-data s nil))
                ((string=? s "false") (ty-data s nil))
                ((string=? s "nil") (ty-data s nil))
                ((or (string=? s "datum") (string=? s "vector")) (ty-data s nil))
                ((string=? s "bool") (ty-bool))
                ((string=? s "char") (ty-char))
                ((string=? s "unit") (ty-unit))
                ((string=? s "string") (ty-string))
                ((string=? s "void") (ty-void))
                ((string-member? s tvars) (ty-var s))
                ((and (string=? s "io-error") (not (dt-named? s (cv-dts v))) (null? (find-alias s (cv-aliases v))))
                 (parse-type v tvars (car (read-all (string-chars io-error-text) "" 1))))
                ((dt-named? s (cv-dts v))
                 (let ((found (find-family s (cv-dts v))))
                   (typecase found
                     (sum d (tagcase d
                              (dt (n ps vs)
                                (if (null? ps)
                                    (ty-data s nil)
                                    (refuse v (string-append "a type with parameters, given none: " s))))))
                     (else (refuse v (string-append "no type is named " s))))))
                (else
                 (let ((found (find-alias s (cv-aliases v))))
                   (if (null? found)
                       (refuse v (string-append "no type is named " s))
                       (tagcase (car found)
                         (alias (n ps body)
                           (cond ((not (null? ps))
                                  (refuse v (string-append "a type with parameters, given none: " s)))
                                 ((string-member? (string-append "%expanding " s) tvars)
                                  (refuse v (string-append "a type abbreviation that mentions itself, " (string-append s
                                            ": Rust's type aliases cannot; a datatype can"))))
                                 ((head-is? body "moduleof") (ty-data (string-append "%module " s) nil))
                                 (else (parse-type v (cons (string-append "%expanding " s) tvars) body))))))))))
        (lst (xs src-file src-line src-pos)
          (cond ((sym-is? (car xs) "listof")
                 (no-knot v (lambda ((x string)) x) (ty-list (parse-type v tvars (second xs)) (parse-region v tvars (third xs)))))
                ((and (sym-is? (car xs) "nlist") (i64= (size xs) 3))
                 "A list of exactly `s` elements, frozen (C158)."
                 (ty-data "%nlist" (list (parse-type v tvars (second xs)) (parse-size v tvars (third xs)))))
                ((and (sym-is? (car xs) "nat") (i64= (size xs) 2))
                 "`(nat s)`: exactly the size `s` (C158); `(nat finite)` is `nat`."
                 (let ((z (parse-size-lin v tvars (second xs)))) (if (null? z) (ty-nat) (ty-data "%natof" (list (size-of-lin (car z)))))))
                ((sym-is? (car xs) "flatarrayof")
                 (if (sym-is? (second xs) "i64")
                     (ty-flat (ty-i64) (parse-mutable-region v tvars (third xs)))
                     (refuse v (string-append "KFX-0's flat arrays are of i64: " (show-sexp t)))))
                ((sym-is? (car xs) "bytevectorof")
                 "FX-26's bytes (C49), as kayak-rt's `Bytes`: at a region, written
                  in place."
                 (if (i64= (size xs) 2)
                     (ty-data "%bytes" (list (parse-mutable-region v tvars (second xs))))
                     (refuse v (string-append "(bytevectorof R): " (show-sexp t)))))
                ((sym-is? (car xs) "ref")
                 (no-knot v (lambda ((x string)) x) (ty-ref (parse-type v tvars (second xs)) (parse-mutable-region v tvars (third xs)))))
                ((sym-is? (car xs) "place")
                 "`(place p)` (C34): a `letrena`'s place, or a poly's place binder."
                 (let ((r (if (i64= (size xs) 2) (tagcase (second xs) (sym (n f p) n) (else other "")) "")))
                   (if (string-member? (string-append "%place '" r) tvars)
                       (ty-data "%place" (list (ty-var (string-append "'" r))))
                       (refuse v (string-append "a place's type names a letrena's place or a poly's place binder: " (show-sexp t))))))
                ((sym-is? (car xs) "bloblet")
                 "`(bloblet (fields T ...) R)` (C31): fields that may be written, kept
                  at `R`, so none a procedure that reads `R` unless it says `spin`,
                  FX-26's rule (`no-knot`); a type variable's instance checked where
                  it is made, as a ref's is (C119)."
                 (cond ((or (not (i64= (size xs) 3)) (not (head-is? (second xs) "fields")))
                        (refuse v (string-append "a bloblet type KFX does not have yet (its fields frozen, or not of the form (bloblet (fields T ...) R)): " (show-sexp t))))
                       (else
                        (no-knot v (lambda ((x string)) x)
                                 (ty-data "%bloblet" (cons (parse-mutable-region v tvars (third xs)) (parse-types v tvars (cdr (items (second xs))))))))))
                ((sym-is? (car xs) "blobref")
                 (if (not (i64= (size xs) 3))
                     (refuse v "(blobref B F)")
                     (let ((b (parse-type v tvars (second xs)))
                           (f (parse-type v tvars (third xs))))
                       (cond ((not (tagcase b (ty-data (d args) (string=? d "%bloblet")) (else other #f)))
                              (refuse v (string-append "a blobref's owner is a bloblet: " (show-sexp t))))
                             ((not (flat? f)) (refuse v (string-append "a blobref's flat is a scalar, or a product or array of them (KFX has no f32 yet): " (show-sexp t))))
                             (else (ty-data "%blobref" (list b f)))))))
                ((and (sym-is? (car xs) "arrayof") (i64= (size xs) 3) (tagcase (third xs) (num (k f p) #f) (else other #t)))
                 "An array of values (C56), `(arrayof T R)`, at a region: kayak-rt's
                  `Array<T>`, a row of cells."
                 (no-knot v (lambda ((x string)) x) (ty-data "%array" (list (parse-type v tvars (second xs)) (parse-mutable-region v tvars (third xs))))))
                ((sym-is? (car xs) "arrayof")
                 (tagcase (third xs)
                   (num (k f p)
                     (let ((e (parse-type v tvars (second xs))))
                       (cond ((or (i64< k 0) (i64> k 268435454))
                              "Below FX-26's length that means \"to the end of the suffix\"."
                              (refuse v "a flat array's literal length is 0 to 268435454"))
                             ((flat? e)
                              (ty-data "%flat-array" (list e (ty-rconst (i64->string k)))))
                             (else (refuse v (string-append "a flat array is of a flat, its length a literal (KFX has no arrays of values yet): " (show-sexp t)))))))
                   (else other (refuse v (string-append "a flat array's length is a literal (KFX has no arrays of values yet): " (show-sexp t))))))
                ((and (or (sym-is? (car xs) "addr") (sym-is? (car xs) "inbox") (sym-is? (car xs) "icell")) (i64= (size xs) 3))
                 "FX-26's processes (C101): `(addr M R)`, the right to send an `M` to a
                  process's mailbox at `R`; `(inbox M r)`, the right to take from it,
                  its process's alone; `(icell T R)`, a `T` written once."
                 (ty-data (string-append "%" (sym-name (car xs))) (list (parse-type v tvars (second xs)) (parse-region v tvars (third xs)))))
                ((and (sym-is? (car xs) "poly") (i64= (size xs) 3))
                 "A poly type written in a type (rank 2, C107): `(poly ((r region) ...)
                  T)`, of regions, types and sizes (C158), its binders named apart by
                  where it is written, `'r@P`, `t@P`, `#n@P`, so that none is another's."
                 (let* ((bs (items (second xs)))
                        (names (map (lambda ((b sexp))
                                      (if (tagcase b (lst (ys f l p) (i64= (size ys) 2)) (else other #f))
                                          (let ((k (second (items b))) (n (sym-name (car (items b)))))
                                            (cond ((sym-is? k "region") (string-append "'" n))
                                                  ((sym-is? k "size") (string-append "#" n))
                                                  ((sym-is? k "type") n)
                                                  (else (refuse v "a poly type whose binders are regions, types and sizes, which KFX has not yet past (C107)"))))
                                          (refuse v "a poly type whose binders are regions, types and sizes, which KFX has not yet past (C107)")))
                                    bs))
                        (pos (datum-pos t))
                        (body (parse-type v (onto names tvars) (third xs)))
                        (renamed (fold-renames names pos body)))
                   (ty-data "%poly" (onto (map (lambda ((n string)) (ty-var (string-append n (string-append "@" (i64->string pos))))) names)
                                          (list renamed)))))
                ((and (sym-is? (car xs) "escape-tag") (i64= (size xs) 4))
                 "FX-26's escape-only tag (C105), `(escape-tag A H R)`: escaped to as a
                  prompt tag is aborted to, never captured with, so it bounds nothing
                  its prompts' bodies do. In Rust, a prompt tag's `Tag<A, H>`."
                 (ty-data "%escape-tag" (list (parse-type v tvars (second xs)) (parse-type v tvars (third xs))
                                              (parse-mutable-region v tvars (fourth xs)))))
                ((and (sym-is? (car xs) "mark-key") (i64= (size xs) 3))
                 "FX-26's continuation mark's key (C72), `(mark-key T R)`: a place in
                  the dynamic context, its marks `T`s, at `R`."
                 (ty-data "%mark-key" (list (parse-type v tvars (second xs)) (parse-mutable-region v tvars (third xs)))))
                ((and (sym-is? (car xs) "vsubr") (i64= (size xs) 4))
                 "FX-26's variadic procedure (C71), `(vsubr E T R)`: any number of `T`s
                  to an `R`, of effect `E`."
                 (ty-data "%vsubr" (list (ty-proc (parse-effect v tvars (second xs)) nil (ty-unit)) (parse-type v tvars (third xs)) (parse-type v tvars (fourth xs)))))
                ((and (sym-is? (car xs) "pairof") (i64= (size xs) 4))
                 "FX-26's pair, never `nil` (C68): `(pairof A B R)`, its head and
                  tail of any types; a list's pair when its tail is the list."
                 (ty-data "%pairof" (list (parse-type v tvars (second xs)) (parse-type v tvars (third xs)) (parse-region v tvars (fourth xs)))))
                ((sym-is? (car xs) "union")
                 (let* ((members (union-members (parse-types v tvars (cdr xs))))
                        (shapes (map shape-of members)))
                   (cond ((i64< (size members) 2) (refuse v (string-append "a union of fewer than two members: " (show-sexp t))))
                         ((or (string-member? "" shapes) (any? (lambda ((m ty)) (generative? v m)) members))
                          (refuse v (string-append "a union's member with no shape known (a type variable, an abstract or generative type, a tag): " (show-sexp t))))
                         ((repeated? shapes) (refuse v (string-append "a union of two members of one shape, which no test tells apart: " (show-sexp t))))
                         (else (ty-data "%union" members)))))
                ((and (or (sym-is? (car xs) "composable") (sym-is? (car xs) "oneshot")) (i64= (size xs) 5))
                 "FX-26's composable continuation (C60), `(composable T A D R)`: a
                  procedure of `T` to `A`, of effect `D` and control on `R`. Its own
                  type, below that procedure's; never Rust's (the restriction pass)."
                 (ty-data (if (sym-is? (car xs) "oneshot") "%oneshot" "%composable") (list (parse-type v tvars (second xs)) (parse-type v tvars (third xs))
                                             (ty-proc (parse-effect v tvars (fourth xs)) nil (ty-unit))
                                             (parse-mutable-region v tvars (car (cdr (cdr (cdr (cdr xs)))))))))
                ((sym-is? (car xs) "prompt-tag")
                 (ty-tag (parse-type v tvars (second xs)) (parse-type v tvars (third xs))
                         (parse-effect v tvars (fourth xs)) (parse-mutable-region v tvars (car (cdr (cdr (cdr (cdr xs))))))))
                ((sym-is? (car xs) "moduleof")
                 (refuse v "a moduleof is a module's type when a define-type names it: KFX's is a Rust trait (C24)"))
                ((and (sym-is? (car xs) "sumof") (not (null? (cdr xs))) (tagcase (second xs) (sym (n f p) #t) (else other #f)))
                 "A keyed flat sum, `(sumof u8 (0 F) (7 G))` (C33): a tag of the key's
                  width, the label stored as it is, then the variant."
                 (let ((key (sym-name (second xs))))
                   (if (not (string-member? key (list "u8" "u16" "u32")))
                       (refuse v "a flat sum's key is `u8`, `u16` or `u32`")
                       (ty-data "%flat-sum"
                                (cons (ty-rconst key)
                                      (concat (map (lambda ((g sexp))
                                                     (let ((parts (tagcase g (lst (ys f2 l2 p2) ys) (else other nil))))
                                                       (if (or (not (i64= (size parts) 2))
                                                               (tagcase (car parts) (num (k f3 p3) (or (i64< k 0) (not (i64< k (key-range key))))) (else other #t)))
                                                           (refuse v (string-append "a keyed flat sum's variant is (label flat), its label a number the key holds: " (show-sexp t)))
                                                           (let ((f (parse-type v tvars (second parts))))
                                                             (if (flat? f)
                                                                 (the tys (list (ty-rconst (i64->string (tagcase (car parts) (num (k f3 p3) k) (else other 0)))) f))
                                                                 (refuse v (string-append "a flat sum's variant is a flat: " (show-sexp t))))))))
                                                   (cdr (cdr xs)))))))))
                ((and (or (sym-is? (car xs) "productof") (sym-is? (car xs) "sumof"))
                      (any? (lambda ((x sexp)) (tagcase x (lst (ys f l p) #f) (else other #t))) (cdr xs)))
                 (refuse v (string-append "a type KFX does not have: " (show-sexp t))))
                ((or (sym-is? (car xs) "productof") (sym-is? (car xs) "sumof"))
                 (let ((fields (map items (cdr xs))))
                   (if (or (any? (lambda ((f sexps)) (not (i64= (size f) 2))) fields)
                           (any? (lambda ((f sexps)) (string=? (label-of (car f)) "")) fields)
                           (and (sym-is? (car xs) "sumof")
                                (any? (lambda ((f sexps)) (tagcase (car f) (sym (n at-file at-pos) #f) (else other #t))) fields)))
                       (refuse v (string-append "a type KFX does not have: " (show-sexp t)))
                       (if (or (any? (lambda ((f sexps)) (tagcase (car f) (sym (n at-file at-pos) (not (label-name? n))) (else other #f))) fields)
                               (repeated? (map (lambda ((f sexps)) (label-of (car f))) fields))
                               (repeated? (map (lambda ((f sexps)) (variant-name (label-of (car f)))) fields)))
                           (refuse v (string-append "a label appears twice in " (show-sexp t)))
                       (ty-shape (sym-is? (car xs) "productof")
                                 (map (lambda ((f sexps)) (label-of (car f))) fields)
                                 (map (lambda ((f sexps)) (parse-type v tvars (second f))) fields))))))
                ((head-is? (car xs) "select")
                 "A module's family applied (C89): `((select m t) arg ...)`."
                 (let ((s (items (car xs))))
                   (parse-application v tvars (string-append (name-of v (second s)) (string-append " " (name-of v (third s)))) (cdr xs))))
                ((sym-is? (car xs) "select")
                 (let ((name (string-append (name-of v (second xs)) (string-append " " (name-of v (third xs))))))
                   (if (null? (find-alias name (cv-aliases v)))
                       (refuse v (string-append "no module defined at the top level gives a type " (show-sexp t)))
                       (parse-type v tvars (sym name "" 0)))))
                ((and (sym-is? (car xs) "subr") (i64> (size xs) 4) (spec-clause? (last xs)))
                 "A procedure type with a specification after its result (C162): the
                  type without it, read as written, then the clauses against its
                  parameters' names."
                 (let* ((k (i64- (size xs) (clauses-ending xs)))
                        (plain (spec-firsts xs k))
                        (params (items (logic-nth plain (i64- k 2)))))
                   (specified-type v (map (lambda ((p sexp)) (param-name-written v tvars p)) params)
                                   (parse-type v tvars (lst plain (datum-file t) 0 (datum-pos t)))
                                   (spec-drop xs k))))
                ((and (sym-is? (car xs) "subr") (i64= (size xs) 5) (head-is? (second xs) "conv"))
                 "A procedure of a convention (C116), `(subr (conv C) E (T ...) R)`:
                  the native one, which made code keeps (Fixpt's TODO §97), only as
                  `native-procedure` makes it; or `fx`, any procedure, KFX's own
                  among them. Each wrapped: no lambda is native, nor is a native
                  one KFX's own, and a procedure of any convention is not one of the
                  program's, as FX-26 has it. A name `define-convention` binds is
                  `native`."
                 (let* ((named (if (i64= (size (items (second xs))) 2) (tagcase (second (items (second xs))) (sym (n f p) n) (else other "")) ""))
                        (declared (find-alias (string-append "%conv " named) (cv-aliases v)))
                        (conv (if (null? declared) named "native")))
                   (if (or (string=? conv "native") (string=? conv "fx"))
                       (ty-data (string-append "%" conv)
                                (list (ty-proc (parse-effect v tvars (third xs))
                                               (parse-params v tvars (items (fourth xs)))
                                               (parse-type v tvars (car (cdr (cdr (cdr (cdr xs)))))))))
                       (refuse v (string-append "a convention KFX does not have: " (show-sexp (second xs)))))))
                ((sym-is? (car xs) "subr")
                 (ty-proc (parse-effect v tvars (second xs))
                          (parse-params v tvars (items (third xs)))
                          (parse-type v tvars (fourth xs))))
                ((tagcase (car xs) (sym (n at-file at-pos) (or (dt-named? n (cv-dts v)) (not (null? (find-alias n (cv-aliases v)))))) (else other #f))
                 (no-knot v (lambda ((x string)) x) (parse-application v tvars (name-of v (car xs)) (cdr xs))))
                (else (refuse v (string-append "a type KFX does not have: " (show-sexp t))))))
        (else other (refuse v (string-append "a type KFX does not have: " (show-sexp t)))))))
  (parse-types (subr kfx (cv strings sexps) tys)
    (lambda (v tvars ts) (map (lambda ((t sexp)) (parse-type v tvars t)) ts)))
  (parse-params (subr kfx (cv strings sexps) tys)
    (lambda (v tvars ts)
      "A procedure type's parameters, each named or not (C162)."
      (map (lambda ((t sexp)) (parse-type v tvars (param-type-written v tvars t))) ts)))

  (parse-arguments (subr kfx (cv strings strings sexps) tys)
    (lambda (v tvars params args)
      "A family's arguments, each read as its parameter's kind says: a
       region for a name beginning `'`, a type otherwise."
      (cond ((and (null? params) (null? args)) nil)
            ((or (null? params) (null? args)) (refuse v "a type given the wrong number of arguments"))
            (else
             (cons (cond ((char=? (string-ref-i64 (car params) 0) #\') (parse-region v tvars (car args)))
                         ((char=? (string-ref-i64 (car params) 0) #\~)
                          "An effect argument (C46): a row, its atoms, and `~!`, which
                           says the procedures there are of an effect binder's, and so
                           are in Rust as the family's own are, whatever is given."
                          (effect-row (cons "~!" (parse-effect v tvars (car args)))))
                         (else (parse-type v tvars (car args))))
                   (parse-arguments v tvars (cdr params) (cdr args)))))))

  (select-behind (subr kfx (cv string i64) sexps)
    (lambda (v name depth)
      "The `(select m u)` an abbreviation with no parameters stands for,
       through others with none (a module's `t` is its `m..t`, C119); or
       none."
      (let ((named (find-alias name (cv-aliases v))))
        (if (or (null? named) (i64> depth 16))
            nil
            (tagcase (car named)
              (alias (n ps body)
                (cond ((not (null? ps)) nil)
                      ((head-is? body "select") (the sexps (list body)))
                      (else (tagcase body (sym (m f p) (select-behind v m (i64+ depth 1))) (else other nil))))))))))

  (parse-application (subr kfx (cv strings string sexps) ty)
    (lambda (v tvars name args)
      "`(name arg ...)`: a datatype with parameters, applied; or a type
       abbreviation with them, what it stands for with its arguments; or an
       abbreviation of a module's family, `(define-type t (select m u))`,
       that family applied (C89)."
      (let* ((found (find-family name (cv-dts v)))
             (behind (if (null? found) (select-behind v name 0) nil)))
        (if (not (null? behind))
            (parse-type v tvars (lst (cons (car behind) args) "" 0 0))
        (if (not (null? found))
            (tagcase found (dt (n ps vs) (ty-data name (parse-arguments v tvars ps args))))
            (tagcase (car (find-alias name (cv-aliases v)))
              (alias (n ps body)
                (if (string-member? (string-append "%expanding " name) tvars)
                    (refuse v (string-append "a type abbreviation that mentions itself, " (string-append name
                              ": Rust's type aliases cannot; a datatype can")))
                    (substitute ps (parse-arguments v tvars ps args)
                                (parse-type v (cons (string-append "%expanding " name)
                                                    (onto (map (lambda ((p string)) (string-append "%place " p))
                                                               (concat (map (lambda ((p string)) (if (has-prefix? p "'") (the strings (list p)) nil)) ps)))
                                                          (onto ps (expanding tvars))))
                                            body)))))))))))

(define family-params (subr kfx (cv sexp) strings)
  (lambda (v head)
    "A family's parameters, from its head `(name (p kind) ...)`: a type's
     named as written, a region's with `'` first; none for a bare name."
    (tagcase head
      (lst (xs src-file src-line src-pos)
        (map (lambda ((b sexp))
               (let ((b (items b)))
                 (cond ((and (i64= (size b) 3) (sym-is? (second b) "region") (not (sym-is? (third b) "distinct")))
                        "A region within a place, `(r region p)` (C40)."
                        (string-append "'" (name-of v (car b))))
                       ((not (i64= (size b) 2))
                        (refuse v (string-append "a variance mark, which KFX does not have (its families are invariant): "
                                                 (show-sexp (lst b "" 0 0)))))
                       ((sym-is? (second b) "type") (name-of v (car b)))
                       ((sym-is? (second b) "region") (string-append "'" (name-of v (car b))))
                       ((sym-is? (second b) "place") (string-append "'" (name-of v (car b))))
                       ((sym-is? (second b) "effect") (string-append "~" (name-of v (car b))))
                       (else (refuse v (string-append "a family over a kind KFX does not have: "
                                                      (show-sexp (lst b "" 0 0))))))))
             (cdr xs)))
      (else other nil))))

(define-rec
  (bare-type-name (subr kfx (chars chars) string)
    (lambda (cs acc)
      "A type's name as its own Rust scope writes it: `m t` and `m..t` are `t`."
      (cond ((null? cs) (rev->string acc))
            ((or (char=? (car cs) #\space) (char=? (car cs) #\.)) (bare-type-name (cdr cs) nil))
            (else (bare-type-name (cdr cs) (cons (car cs) acc)))))))

(define type-binders-apart (subr kfx (cv strings strings) unit)
  (lambda (v tvars types)
    "Type variables, a poly's or a family's, each a Rust type parameter of
     its name camel-cased: each a KFX name (C27), none named as a type the
     Rust names, as another of them, or as a type `types` has, which it
     would hide in Rust and not in FX-26. A region's, with `'`, is none, nor
     an effect's, with `~`, which Rust does not see (C46)."
    (let ((reserved (rust-type-names))
          (theirs (map (lambda ((t string)) (camel (bare-type-name (string-chars t) nil))) types))
          (tvars (concat (map (lambda ((n string)) (if (or (has-prefix? n "'") (has-prefix? n "~") (has-prefix? n "#")) nil (the strings (list n)))) tvars))))
      (begin
        (map (lambda ((n string))
               (cond ((not (kfx-name? n)) (refuse v (string-append "a type variable's name KFX's names are not (C27): " n)))
                     ((string-member? (camel n) reserved)
                      (refuse v (string-append "a type variable named as a type the Rust names: " n)))
                     ((string-member? (camel n) theirs)
                      (refuse v (string-append "a type variable named as a type, which it would hide in Rust: " n)))
                     (else #u)))
             tvars)
        (if (repeated? (map camel tvars))
            (refuse v "two type variables named alike in Rust (camel-cased, as `a` and `a-`)")
            #u)))))

(define poly-binders (subr kfx (cv sexp bool) strings)
  (lambda (v t own)
    "A definition's type's variables: a poly at its top, over types, and
     regions, whose names begin with `'`; the program's `own`, held apart
     from its types (a primitive's not)."
    (if (head-is? t "poly")
        (let ((tvars
        (map (lambda ((b sexp))
               (let ((b (items b)))
                 (cond ((and (i64= (size b) 3) (sym-is? (second b) "region") (not (sym-is? (third b) "distinct")))
                        "A region within a place, `(r region p)` (C40): its data may be
                         made in the place, which it will not outlive."
                        (string-append "'" (name-of v (car b))))
                       ((not (i64= (size b) 2))
                        (refuse v (string-append "a binder KFX-0 does not have (distinct regions are to come): "
                                                 (show-sexp (lst b "" 0 0)))))
                       ((sym-is? (second b) "type") (name-of v (car b)))
                       ((sym-is? (second b) "region") (string-append "'" (name-of v (car b))))
                       ((sym-is? (second b) "place") (string-append "'" (name-of v (car b))))
                       ((sym-is? (second b) "effect") (string-append "~" (name-of v (car b))))
                       ((sym-is? (second b) "size") (string-append "#" (name-of v (car b))))
                       (else (refuse v (string-append "KFX's poly is over types, effects, regions and places: " (show-sexp (lst b "" 0 0))))))))
             (items (second (items t))))))
          (begin
            (if own (type-binders-apart v tvars (onto (map (lambda ((d dt)) (tagcase d (dt (n ps vs) n))) (cv-dts v))
                                              (map (lambda ((a alias)) (tagcase a (alias (n ps body) n))) (cv-aliases v))))
                #u)
            tvars))
        nil)))

(define place-marks (subr kfx (sexp) strings)
  (lambda (t)
    "A poly's place binders, `%place 'p` each: where `(place p)` may be
     written (C34). A place is a region too, `'p`."
    (if (head-is? t "poly")
        (concat (map (lambda ((b sexp))
                       (let ((xs (items b)))
                         (cond ((and (i64= (size xs) 2) (sym-is? (second xs) "place"))
                                (the strings (list (string-append "%place '" (sym-name (car xs))))))
                               ((and (i64= (size xs) 3) (sym-is? (second xs) "region") (not (sym-is? (third xs) "distinct")))
                                (the strings (list (string-append "%within '" (string-append (sym-name (car xs)) (string-append " '" (sym-name (third xs))))))))
                               (else nil))))
                     (items (second (items t)))))
        nil)))

(define-rec
  (flat-poly (subr kfx (sexp) sexp)
    (lambda (t)
      "A `poly` directly in a `poly`, as FX-26 writes a primitive's binders by
       kind (C70): one `poly`, the binders in order, which means the same."
      (if (and (head-is? t "poly") (i64= (size (items t)) 3) (head-is? (third (items t)) "poly"))
          (let ((inner (flat-poly (third (items t)))))
            (lst (list (car (items t)) (lst (onto (items (second (items t))) (items (second (items inner)))) "" 0 0) (third (items inner)))
                 (datum-file t) 0 (datum-pos t)))
          t))))

(define parse-scheme-of (subr kfx (cv sexp bool) scheme)
  (lambda (v t0 own)
    (let* ((t (flat-poly t0))
           (tvars (poly-binders v t own)))
      (scheme tvars (parse-type v (onto (place-marks t) tvars) (if (head-is? t "poly") (third (items t)) t))))))

(define parse-scheme (subr kfx (cv sexp) scheme)
  (lambda (v t) (parse-scheme-of v t #t)))

(define-rec
  (size-lin (subr kfx (st ty) lins)
    (lambda (s t)
      "Size `t` as a linear expression, its variables named (`#n`, `?k`), an
       inference variable solved looked through; none if it is `finite`."
      (tagcase (walk s t)
        (ty-var (n) (list (lin 0 (list (lterm n 1)))))
        (ty-meta (k) (list (lin 0 (list (lterm (string-append "?" (i64->string k)) 1)))))
        (ty-data (d args)
          (if (string=? d "%sz")
              (size-terms-lin s (cdr args) (lin (string->i64 (after-prefix (tagcase (car args) (ty-data (k a) k) (else other "%k 0")) "%k ")) nil))
              nil))
        (else other nil))))
  (size-terms-lin (subr kfx (st (listof ty acyclic) lin) lins)
    (lambda (s ts acc)
      (if (null? ts)
          (list acc)
          (tagcase (car ts)
            (ty-data (d args)
              (let ((inner (size-lin s (car args))))
                (if (null? inner) nil (size-terms-lin s (cdr ts) (lin-add acc (car inner) (string->i64 (after-prefix d "%t ")))))))
            (else other nil)))))
  (size-finite? (subr kfx (st ty) bool) (lambda (s t) (null? (size-lin s t))))
  (size-text (subr kfx (lin) string)
  (lambda (l)
    "As FX-26 writes a size: `3`, `n`, `(+ n 1)`, `(- n 1)`, `(+ n m)`."
    (tagcase l
      (lin (c ts)
        (let ((vars (concat (map (lambda ((t lterm))
                                   (tagcase t
                                     (lterm (n k)
                                       (let ((x (if (has-prefix? n "#") (after-prefix n "#") n)))
                                         (if (i64= k 1) (the strings (list x)) (the strings (list (string-append "(* " (string-append (i64->string k) (string-append " " (string-append x ")")))))))))))
                                 ts))))
          (cond ((null? vars) (i64->string c))
                ((and (null? (cdr vars)) (i64= c 0)) (car vars))
                ((i64< c 0) (string-append "(- " (string-append (words-of vars) (string-append " " (string-append (i64->string (i64- 0 c)) ")")))))
                ((i64= c 0) (string-append "(+ " (string-append (words-of vars) ")")))
                (else (string-append "(+ " (string-append (words-of vars) (string-append " " (string-append (i64->string c) ")")))))))))))
  (show-size (subr kfx (st ty) string)
  (lambda (s t) (let ((l (size-lin s t))) (if (null? l) "finite" (size-text (car l))))))
  (show-ty (subr kfx (st ty) string)
    (lambda (s t)
      (tagcase (walk s t)
        (ty-i64 () "i64")
        (ty-int () "int")
        (ty-nat () "nat")
        (ty-f64 () "f64")
        (ty-bool () "bool")
        (ty-char () "char")
        (ty-unit () "unit")
        (ty-string () "string")
        (ty-void () "void")
        (ty-list (e r) (string-append "(listof " (string-append (show-ty s e) (string-append " " (string-append (show-ty s r) ")")))))
        (ty-data (d args)
          (cond ((null? args) d)
                ((has-prefix? d "%spec ") (show-specified s d (car args)))
                ((string=? d "%bloblet")
                 (string-append "(bloblet (fields " (string-append (show-tys s (cdr args)) (string-append ") " (string-append (show-ty s (car args)) ")")))))
                ((string=? d "%blobref") (string-append "(blobref " (string-append (show-tys s args) ")")))
                ((string=? d "%bytes") (string-append "(bytevectorof " (string-append (show-ty s (car args)) ")")))
                ((string=? d "%array") (string-append "(arrayof " (string-append (show-tys s args) ")")))
                ((string=? d "%union") (string-append "(union " (string-append (show-tys s args) ")")))
                ((string=? d "%pairof") (string-append "(pairof " (string-append (show-tys s args) ")")))
                ((string=? d "%mark-key") (string-append "(mark-key " (string-append (show-tys s args) ")")))
                ((string=? d "%escape-tag") (string-append "(escape-tag " (string-append (show-tys s args) ")")))
                ((string=? d "%nlist") (string-append "(nlist " (string-append (show-ty s (car args)) (string-append " " (string-append (show-size s (car (cdr args))) ")")))))
                ((string=? d "%natof") (string-append "(nat " (string-append (show-size s (car args)) ")")))
                ((or (string=? d "%sz") (string=? d "%finite")) (show-size s t))
                ((string=? d "%poly")
                 (string-append "(poly (" (string-append (binders-shown (poly-binders-of args))
                   (string-append ") " (string-append (show-ty s (poly-written args)) ")")))))
                ((or (string=? d "%addr") (string=? d "%inbox") (string=? d "%icell"))
                 (string-append "(" (string-append (after-prefix d "%") (string-append " " (string-append (show-tys s args) ")")))))
                ((or (string=? d "%native") (string=? d "%fx"))
                 (string-append "(subr (conv " (string-append (after-prefix d "%") (string-append ") " (after-prefix (show-ty s (car args)) "(subr ")))))
                ((string=? d "%vsubr")
                 (string-append "(vsubr " (string-append (tagcase (car args) (ty-proc (es ps r) (show-effs es)) (else other "?"))
                   (string-append " " (string-append (show-tys s (cdr args)) ")")))))
                ((or (string=? d "%composable") (string=? d "%oneshot"))
                 (string-append (if (string=? d "%oneshot") "(oneshot " "(composable ") (string-append (show-ty s (car args)) (string-append " " (string-append (show-ty s (car (cdr args)))
                   (string-append " " (string-append (tagcase (car (cdr (cdr args))) (ty-proc (es ps r) (show-effs es)) (else other "?"))
                     (string-append " " (string-append (show-ty s (car (cdr (cdr (cdr args))))) ")")))))))))
                ((string=? d "%flat-array") (string-append "(arrayof " (string-append (show-tys s args) ")")))
                ((string=? d "%flat-sum")
                 (string-append "(sumof " (string-append (show-ty s (car args))
                   (string-append (run-together (map (lambda ((f fvar)) (tagcase f (fvar (l x) (string-append " (" (string-append l (string-append " " (string-append (show-ty s x) ")")))))))
                                                       (flat-sum-variants args)))
                                  ")"))))
                ((string=? d "%place") (string-append "(place " (string-append (show-tys s args) ")")))
                (else (string-append "(" (string-append d (string-append " " (string-append (show-tys s args) ")")))))))
        (ty-shape (p ls ts) (string-append (if p "(productof" "(sumof") (string-append (show-fields s ls ts) ")")))
        (ty-flat (e r) (string-append "(flatarrayof " (string-append (show-ty s e) (string-append " " (string-append (show-ty s r) ")")))))
        (ty-ref (e r) (string-append "(ref " (string-append (show-ty s e) (string-append " " (string-append (show-ty s r) ")")))))
        (ty-rconst (n) n)
        (ty-tag (a h d r)
          (string-append "(prompt-tag " (string-append (show-ty s a) (string-append " " (string-append (show-ty s h)
            (string-append " " (string-append (show-effs d) (string-append " " (string-append (show-ty s r) ")")))))))))
        (ty-proc (es ps r)
          (string-append "(subr " (string-append (show-effs es) (string-append " ("
            (string-append (show-tys s ps) (string-append ") " (string-append (show-ty s r) ")")))))))
        (ty-var (n) n)
        (ty-meta (k) (string-append "?" (i64->string k))))))
  (show-specified (subr kfx (st string ty) string)
    (lambda (s d t)
      "A specified procedure type (C162): its parameters by their names where
       it has clauses, and its clauses after its result."
      (let* ((clauses (spec-clauses-shown d))
             (inner (walk s t))
             (conv (tagcase inner
                     (ty-data (c args) (if (or (string=? c "%fx") (string=? c "%native")) (string-append "(conv " (string-append (after-prefix c "%") ") ")) ""))
                     (else other ""))))
        (tagcase (procedure-within inner)
          (ty-proc (es ps r)
            (string-append "(subr " (string-append conv (string-append (show-effs es) (string-append " ("
              (string-append (if (string=? clauses "") (show-tys s ps) (show-named s ps (spec-param-names d)))
                (string-append ") " (string-append (show-ty s r) (string-append clauses ")")))))))))
          (else other (show-ty s t))))))
  (show-named (subr kfx (st tys strings) string)
    (lambda (s ps names)
      (if (null? ps)
          ""
          (string-append (let ((n (if (null? names) "%none" (car names))))
                           (if (string=? n "%none") (show-ty s (car ps)) (string-append "(" (string-append n (string-append " " (string-append (show-ty s (car ps)) ")"))))))
                         (if (null? (cdr ps)) "" (string-append " " (show-named s (cdr ps) (if (null? names) nil (cdr names)))))))))
  (show-fields (subr kfx (st strings tys) string)
    (lambda (s ls ts)
      (if (or (null? ls) (null? ts))
          ""
          (string-append " (" (string-append (car ls) (string-append " " (string-append (show-ty s (car ts))
            (string-append ")" (show-fields s (cdr ls) (cdr ts))))))))))
  (show-tys (subr kfx (st tys) string)
    (lambda (s ts)
      (cond ((null? ts) "")
            ((null? (cdr ts)) (show-ty s (car ts)))
            (else (string-append (show-ty s (car ts)) (string-append " " (show-tys s (cdr ts))))))))
  (walk (subr kfx (st ty) ty)
    (lambda (s t)
      "`t`, its inference variable replaced by its solution, if it has one."
      (tagcase t
        (ty-meta (k)
          (tagcase s
            (st (subst next fs)
              (let ((found (lookup-meta k subst)))
                (if (null? found) t (walk s (car found)))))))
        (else other t))))
  (lookup-meta (subr kfx (i64 sbs) tys)
    (lambda (k subst)
      (cond ((null? subst) nil)
            (else (tagcase (car subst)
                    (sb (j t) (if (i64= j k) (list t) (lookup-meta k (cdr subst))))))))))

(define-rec
  (has-meta? (subr kfx (st ty) bool)
    (lambda (s t)
      "Whether `t` has an inference variable not solved yet."
      (tagcase (walk s t)
        (ty-meta (k) #t)
        (ty-list (e r) (or (has-meta? s e) (has-meta? s r)))
        (ty-flat (e r) (or (has-meta? s e) (has-meta? s r)))
        (ty-shape (p ls ts) (any? (lambda ((x ty)) (has-meta? s x)) ts))
        (ty-tag (a h d r) (or (has-meta? s a) (has-meta? s h) (has-meta? s r)))
        (ty-data (d args) (any? (lambda ((x ty)) (has-meta? s x)) args))
        (ty-ref (e r) (or (has-meta? s e) (has-meta? s r)))
        (ty-proc (es ps r) (or (has-meta? s r) (any? (lambda ((p ty)) (has-meta? s p)) ps)))
        (else other #f)))))

(define fresh (subr kfx (st) res)
  (lambda (s)
    "A new inference variable."
    (tagcase s (st (subst next fs) (res (ty-meta next) nil (st subst (i64+ next 1) fs))))))

(define note-fact (subr kfx (st string i64 string) st)
  (lambda (s file pos what)
    (tagcase s (st (subst next fs) (st subst next (cons (fact file pos what) fs))))))

(define kfx-restricted (subr kfx (cv st string) st)
  (lambda (v s message)
    "What FX-26 has and KFX has not, for Rust (front-end.md stage 2, C154):
     not refused here but noted, a fact of the file `%kfx`, for kfx's
     restriction pass to refuse (restrict.kfx), where and as the checker
     would have; the engine, which runs no such pass, checks on."
    (note-fact s "%kfx" 0 (string-append "kfx-refuses " (refusal-text v message)))))

(define st-facts (subr kfx (st) facts)
  (lambda (s) (tagcase s (st (subst next fs) fs))))

(define st-next (subr kfx (st) i64)
  (lambda (s) (tagcase s (st (subst next fs) next))))

"Inference variables said by their binders' names (C98): an instance's
 made in a REPL's draft or entry each noted as the binder it stands for,
 a fact of the file `%meta` at its number; and a message about it says
 `t` where it would say `?3`, a second variable of the same name primed,
 `t'`, as Fixpt says them. No fact is noted in a file's checking, so no
 file's messages change."
(define-datatype said (said i64 string))
(define-type saids (listof said acyclic))

(define-rec
  (binders-noted (subr kfx (st strings i64) st)
    (lambda (s tvars k)
      (if (null? tvars) s (binders-noted (note-fact s "%meta" k (string-append "binder " (car tvars))) (cdr tvars) (i64+ k 1)))))
  (binder-of (subr kfx (facts i64) string)
    (lambda (fs k)
      (if (null? fs)
          ""
          (tagcase (car fs)
            (fact (f p w) (if (and (i64= p k) (string=? f "%meta")) (after-prefix w "binder ") (binder-of (cdr fs) k)))))))
  (said-as (subr kfx (saids i64) string)
    (lambda (ss k)
      (if (null? ss) "" (tagcase (car ss) (said (j n) (if (i64= j k) n (said-as (cdr ss) k)))))))
  (said-by? (subr kfx (saids string) bool)
    (lambda (ss n)
      (and (not (null? ss)) (tagcase (car ss) (said (j m) (or (string=? m n) (said-by? (cdr ss) n)))))))
  (unsaid (subr kfx (saids string) string)
    (lambda (ss n)
      (if (said-by? ss n) (unsaid ss (string-append n "'")) n)))
  (digits-after (subr kfx (chars i64) i64)
    (lambda (cs k)
      (if (and (not (null? cs)) (char-numeric? (car cs)))
          (digits-after (cdr cs) (i64+ (i64* k 10) (i64- (char->i64 (car cs)) 48)))
          k)))
  (past-digits (subr kfx (chars) chars)
    (lambda (cs)
      (if (and (not (null? cs)) (char-numeric? (car cs))) (past-digits (cdr cs)) cs)))
  (metas-said (subr kfx (facts chars saids string) string)
    (lambda (fs cs ss acc)
      (cond ((null? cs) acc)
            ((and (char=? (car cs) #\?) (not (null? (cdr cs))) (char-numeric? (car (cdr cs))))
             (let* ((k (digits-after (cdr cs) 0))
                    (was (said-as ss k))
                    (binder (binder-of fs k)))
               (cond ((not (string=? was "")) (metas-said fs (past-digits (cdr cs)) ss (string-append acc was)))
                     ((string=? binder "") (metas-said fs (past-digits (cdr cs)) ss (string-append acc (meta-name k))))
                     (else (let ((n (unsaid ss binder)))
                             (metas-said fs (past-digits (cdr cs)) (cons (said k n) ss) (string-append acc n)))))))
            (else (metas-said fs (cdr cs) ss (string-append acc (char->string (car cs)))))))))

(define metas-named (subr kfx (st string) string)
  (lambda (s message)
    (let ((fs (st-facts s)))
      (if (any? (lambda ((f fact)) (tagcase f (fact (file p w) (string=? file "%meta")))) fs)
          (metas-said fs (string-chars message) nil "")
          message))))

(define refuse-named (subr kfx (cv st string) void)
  (lambda (v s message)
    "A refusal whose types' inference variables are said by their binders'
     names, where a draft's instance noted them."
    (refuse v (metas-named s message))))

(define solve (subr kfx (st i64 ty) st)
  (lambda (s k t)
    (tagcase s (st (subst next fs) (st (cons (sb k t) subst) next fs)))))

(define-rec
  (occurs? (subr kfx (st i64 ty) bool)
    (lambda (s k t)
      (tagcase (walk s t)
        (ty-meta (j) (i64= j k))
        (ty-list (e r) (or (occurs? s k e) (occurs? s k r)))
        (ty-flat (e r) (or (occurs? s k e) (occurs? s k r)))
        (ty-shape (p ls ts) (any? (lambda ((x ty)) (occurs? s k x)) ts))
        (ty-tag (a h d r) (or (occurs? s k a) (occurs? s k h) (occurs? s k r)))
        (ty-data (d args) (any? (lambda ((x ty)) (occurs? s k x)) args))
        (ty-ref (e r) (or (occurs? s k e) (occurs? s k r)))
        (ty-proc (es ps r) (or (occurs? s k r) (any? (lambda ((p ty)) (occurs? s k p)) ps)))
        (else other #f)))))

(define same-base? (subr kfx (ty ty) bool)
  (lambda (a e)
    (tagcase a
      (ty-i64 () (tagcase e (ty-i64 () #t) (else other #f)))
      (ty-int () (tagcase e (ty-int () #t) (else other #f)))
      (ty-nat () (tagcase e (ty-nat () #t) (ty-int () #t) (else other #f)))
      (ty-f64 () (tagcase e (ty-f64 () #t) (else other #f)))
      (ty-bool () (tagcase e (ty-bool () #t) (else other #f)))
      (ty-char () (tagcase e (ty-char () #t) (else other #f)))
      (ty-unit () (tagcase e (ty-unit () #t) (else other #f)))
      (ty-string () (tagcase e (ty-string () #t) (else other #f)))
      (else other #f))))

(define-rec
  (repeat-ty (subr kfx (ty i64) tys)
    (lambda (t n) (if (i64< n 1) nil (cons t (repeat-ty t (i64- n 1)))))))

(define-rec
  (native-crossing? (subr kfx (st ty) bool)
    (lambda (s t)
      "Whether a value of type `t` crosses between kayak's values and native
       code's (C116, kayak-rt's `Native`): as the same word in both, or
       copied, which no KFX program can tell of a list or a string, since
       none tells pairs apart (`eq?`) nor writes through one (`set-car!`)."
      (tagcase (walk s t)
        (ty-int () #t) (ty-nat () #t) (ty-i64 () #t) (ty-bool () #t) (ty-unit () #t) (ty-char () #t) (ty-string () #t)
        (ty-list (x r) (native-crossing? s x))
        (ty-data (d args)
          "A bloblet whose fields cross, copied each way (kayak-rt's `Native`,
           which says what a copy cannot see)."
          (and (string=? d "%bloblet") (i64< (size args) 6)
               (not (any? (lambda ((x ty)) (not (native-crossing? s x))) (cdr args)))))
        (else other #f))))
  (native-given? (subr kfx (st ty) bool)
    (lambda (s t)
      "Whether a value of type `t` may be given to native code: one that
       crosses, or a procedure of the fx convention whose parameters and
       result cross, which native code calls back by `foreign` (C116)."
      (or (native-crossing? s t)
          (tagcase (walk s t)
            (ty-data (d args) (and (string=? d "%fx") (native-given? s (car args))))
            (ty-flat (e r)
              "An `i64` flat array, shared, laid out as Fixpt's (C126):
               native code reads and writes the elements KFX does."
              (tagcase (walk s e) (ty-i64 () #t) (else other #f)))
            (ty-proc (es ps r)
              "A procedure of KFX's own, as one of the fx convention is: in a
               code bloblet's field, made code calls it by `foreign`."
              (and (i64< (size ps) 4) (native-crossing? s r) (not (escapes? es)) (not (suspends? es))
                   (not (any? (lambda ((p ty)) (not (native-crossing? s p))) ps))))
            (else other #f))))))

(define vsubr-as-proc (subr kfx (ty i64) ty)
  (lambda (t n)
    "A variadic procedure called with `n` arguments, as the procedure of `n`
     `T`s it is then (C71); a native one, its procedure (C116); any other
     type, itself."
    (tagcase t
      (ty-data (d args)
        (cond ((string=? d "%vsubr")
               (ty-proc (tagcase (car args) (ty-proc (es ps r) es) (else other nil)) (repeat-ty (car (cdr args)) n) (car (cdr (cdr args)))))
              ((or (string=? d "%native") (string=? d "%fx")) "A procedure of a convention (C116), called as any is." (car args))
              ((has-prefix? d "%spec ") "A specified procedure (C162), called as any is." (procedure-within t))
              (else t)))
      (else other t))))

(define region-string (subr kfx (st ty) string)
  (lambda (s r)
    (tagcase (walk s r) (ty-rconst (n) n) (ty-var (n) n) (ty-meta (k) (meta-name k)) (else other "?"))))

(define-rec
  (composable-as-proc (subr kfx (st ty) ty)
    (lambda (s t)
      "A composable continuation as the procedure it is (C60): of its `D`, and
       control on its region; any other type, itself."
      (tagcase t
        (ty-data (d args)
          (if (or (string=? d "%composable") (string=? d "%oneshot"))
              (let ((r (region-string s (car (cdr (cdr (cdr args)))))))
                (ty-proc (effs-union (list (string-append "goto:" r) (string-append "comefrom:" r))
                                     (tagcase (car (cdr (cdr args))) (ty-proc (es ps x) es) (else other nil)))
                         (list (car args)) (car (cdr args))))
              t))
        (else other t)))))

(define meta-number (subr kfx (string) i64)
  (lambda (r)
    "The number of an inference variable's name, `?k`."
    (i64- 0 (digits-value (cdr (string-chars r)) 0 "" 0))))

(define-rec
  (chars-after-colon (subr kfx (chars) string)
    (lambda (cs) (cond ((null? cs) "") ((char=? (car cs) #\:) (rev->string (rev-onto (cdr cs) nil))) (else (chars-after-colon (cdr cs)))))))

(define effect-region (subr kfx (string) string)
  (lambda (e) (chars-after-colon (string-chars e))))

(define-rec
  (open-effects? (subr kfx (st ty) bool)
    (lambda (s t)
      "Whether `t` has an inference variable not solved yet, a latent
       effect's region too (`(goto ?k)`): as FX-26 counts what a parameter's
       type mentions that is not known."
      (tagcase (walk s t)
        (ty-proc (es ps r)
          (or (any? (lambda ((e string))
                      (let ((at (effect-region e)))
                        (and (has-prefix? at "?") (tagcase (walk s (ty-meta (meta-number at))) (ty-meta (k) #t) (else other #f)))))
                    es)
              (open-effects? s r) (any? (lambda ((p ty)) (open-effects? s p)) ps)))
        (ty-list (e r) (open-effects? s e))
        (ty-ref (e r) (open-effects? s e))
        (ty-data (d args) (any? (lambda ((x ty)) (open-effects? s x)) args))
        (ty-shape (p ls ts) (any? (lambda ((x ty)) (open-effects? s x)) ts))
        (else other #f)))))

(define has-open? (subr kfx (st ty) bool)
  (lambda (s t) (or (has-meta? s t) (open-effects? s t))))

(define resolve-atom (subr kfx (st string) string)
  (lambda (s x)
    "An effect atom, its region an inference variable solved replaced by
     the region found."
    (if (region-atom? x)
        (let ((r (atom-region x)))
          (if (char=? (string-ref-i64 r 0) #\?)
              (string-append (atom-kind x)
                             (region-string s (ty-meta (meta-number r))))
              x))
        x)))

(define-rec
  (zonk (subr kfx (st ty) ty)
    (lambda (s t)
      "`t`, every inference variable in it replaced by its solution."
      (tagcase (walk s t)
        (ty-list (e r) (ty-list (zonk s e) (zonk s r)))
        (ty-flat (e r) (ty-flat (zonk s e) (zonk s r)))
        (ty-shape (p ls ts) (ty-shape p ls (map (lambda ((x ty)) (zonk s x)) ts)))
        (ty-tag (a h d r) (ty-tag (zonk s a) (zonk s h) d (zonk s r)))
        (ty-data (d args) (ty-data d (map (lambda ((x ty)) (zonk s x)) args)))
        (ty-ref (e r) (ty-ref (zonk s e) (zonk s r)))
        (ty-proc (es ps r) (ty-proc es (map (lambda ((p ty)) (zonk s p)) ps) (zonk s r)))
        (else other other)))))

(define region-ty (subr kfx (string) ty)
  (lambda (r)
    (cond ((char=? (string-ref-i64 r 0) #\?) (ty-meta (meta-number r)))
          ((char=? (string-ref-i64 r 0) #\') (ty-var r))
          (else (ty-rconst r)))))

(define-rec
  (open-atom (subr kfx (st string strings) strings)
    (lambda (s x es)
      "Of the effect `es`, an atom of the kind of `x` whose region is an
       inference variable not solved: that variable can stand for `x`'s
       region."
      (cond ((null? es) nil)
            ((let ((y (resolve-atom s (car es))))
               (and (region-atom? y) (string=? (atom-kind y) (atom-kind x))
                    (char=? (string-ref-i64 (atom-region y) 0) #\?)))
             (list (resolve-atom s (car es))))
            (else (open-atom s x (cdr es)))))))

"Effect variables (C46): a poly's effect binder is an atom `~e`; at a
 call, an inference variable, `~?k`, solved to a row: `(ty-proc atoms nil
 unit)` holds its atoms, the last of which may be another variable, open
 for more."

(define effect-meta? (subr kfx (string) bool)
  (lambda (x) (has-prefix? x "~?")))

(define-rec
  (expand-effs (subr kfx (st strings) strings)
    (lambda (s es)
      "`es`, each effect variable solved replaced by its atoms."
      (if (null? es)
          nil
          (effs-union (if (effect-meta? (car es))
                          (tagcase (walk s (ty-meta (meta-number (after-prefix (car es) "~"))))
                            (ty-proc (as ps r) (expand-effs s as))
                            (else other (list (car es))))
                          (list (car es)))
                      (expand-effs s (cdr es)))))))

(define-rec
  (open-row (subr kfx (strings) strings)
    (lambda (es)
      "The effect variables of `es`, expanded: those not solved."
      (cond ((null? es) nil)
            ((effect-meta? (car es)) (cons (car es) (open-row (cdr es))))
            (else (open-row (cdr es)))))))

(define-rec
  (closed-row (subr kfx (strings) strings)
    (lambda (es)
      (cond ((null? es) nil)
            ((effect-meta? (car es)) (closed-row (cdr es)))
            (else (cons (car es) (closed-row (cdr es))))))))

(define close-effs (subr kfx (st strings) strings)
  (lambda (s es)
    "A call's effect: its effect variables' atoms, and none for a variable
     nothing said, as FX-26 instantiates an effect binder no argument
     names (pure)."
    (closed-row (expand-effs s es))))

(define-rec
  (fit-effs (subr kfx (st strings strings) (listof st acyclic))
    (lambda (s a e)
      "Whether effect `a` is within `e`, an inference variable for a region
       in `e` solved for one in `a` if need be, and one for an effect in `e`
       grown to hold an atom of `a` (C46): the state, or none."
      (if (null? a)
          (list s)
          (fit-expanded s (expand-effs s a) e (map (lambda ((y string)) (resolve-atom s y)) (expand-effs s e))))))
  (fit-expanded (subr kfx (st strings strings strings) (listof st acyclic))
    (lambda (s ax e es)
      "`fit-effs`, `a` and `e` expanded in `s` (`ax`, `es`): kept while `s`
       is, as expanding them again would give the same (C143)."
      (if (null? ax)
          (list s)
          (let ((x (resolve-atom s (car ax))))
            (cond ((effs-within? (list x) es) (fit-expanded s (cdr ax) e es))
                  ((string=? x "alloc:acyclic")
                   "Made at `acyclic`, frozen from its making, which nothing sees
                    (`list`'s `(alloc r)`, `r` acyclic): within any effect (C156)."
                   (fit-expanded s (cdr ax) e es))
                  ((effect-meta? x)
                   "An effect variable of `a` not solved, that `e` does not hold:
                    nothing more, the least it may be."
                   (fit-effs (solve s (meta-number (after-prefix x "~")) (effect-row nil)) (cdr ax) e))
                  ((not (null? (open-atom s x e)))
                   (tagcase (region-ty (atom-region (car (open-atom s x e))))
                     (ty-meta (k) (fit-effs (solve s k (region-ty (atom-region x))) (cdr ax) e))
                     (else other nil)))
                  ((not (null? (open-row es)))
                   (tagcase (fresh s)
                     (res (m u s)
                       (tagcase m
                         (ty-meta (j)
                           (fit-effs (solve s (meta-number (after-prefix (car (open-row es)) "~"))
                                            (effect-row (list x (string-append "~" (meta-name j)))))
                                     (cdr ax) e))
                         (else other nil)))))
                  (else nil)))))))

(define same-effs (subr kfx (st strings strings) (listof st acyclic))
  (lambda (s a b)
    "Effects `a` and `b` the same, each within the other, an effect variable
     on either side solved to make them so (C60): the side open grown first,
     so that its variable is not taken for the least it may be."
    (let ((grown (fit-effs s b a)))
      (if (and (not (null? grown)) (not (null? (fit-effs (car grown) a b))))
          (fit-effs (car grown) a b)
          (let ((other (fit-effs s a b)))
            (if (null? other) nil (fit-effs (car other) b a)))))))

(define datum? (subr kfx (ty) bool)
  (lambda (t) (tagcase t (ty-data (d args) (string=? d "datum")) (else other #f))))

"The facts in scope (C157), and whether they show `goal >= 0`: each
 local `nat` and each size variable not negative."
(define-datatype sfacts (sfacts lins lins))

(define-rec
  (size-facts-from (subr kfx (binds strings lins lins) sfacts)
    (lambda (bs seen ges nes)
      "The facts in scope, `>= 0` and `/= 0`: each of a binding of no name a
       program writes, unless a name it mentions has been bound again
       since (a narrowing names the same value)."
      (if (null? bs)
          (sfacts ges nes)
          (tagcase (car bs)
            (bind (n sc w)
              (cond ((and (string=? n "%size-fact") (has-prefix? w "fact "))
                     (let* ((ws (cdr (text-words w))) (kind (car ws)) (l (lin-read (cdr ws))))
                       (cond ((any? (lambda ((m string)) (string-member? m seen)) (lin-names l)) (size-facts-from (cdr bs) seen ges nes))
                             ((string=? kind "ge") (size-facts-from (cdr bs) seen (cons l ges) nes))
                             ((string=? kind "eq") (size-facts-from (cdr bs) seen (cons l (cons (lin-scaled l -1) ges)) nes))
                             (else (size-facts-from (cdr bs) seen ges (cons l nes))))))
                    ((string=? w "narrowed") (size-facts-from (cdr bs) seen ges nes))
                    (else (size-facts-from (cdr bs) (cons n seen) ges nes)))))))))

(define-rec
  (lin-resolved (subr kfx (st lin) lin)
    (lambda (s l)
      "`l`, each inference variable in it that is solved replaced by its size."
      (tagcase l
        (lin (c ts)
          (if (null? ts)
              l
              (tagcase (car ts)
                (lterm (n k)
                  (let ((rest (lin-resolved s (lin c (cdr ts)))))
                    (if (has-prefix? n "?")
                        (let ((found (size-lin s (ty-meta (string->i64 (after-prefix n "?"))))))
                          (if (or (null? found) (string=? (lin-text (car found)) (lin-text (lin 0 (list (lterm n 1))))))
                              (lin-add rest (lin 0 (list (lterm n 1))) k)
                              (lin-add rest (lin-resolved s (car found)) k)))
                        (lin-add rest (lin 0 (list (lterm n 1))) k)))))))))))

(define nat-bounds (subr kfx (cv st strings) lins)
  (lambda (v s ns)
    "Each of `ns` a size variable, or a local `nat`: `n >= 0`."
    (concat (map (lambda ((n string))
                   (let ((b (find-bind n (cv-binds v))))
                     (if (or (has-prefix? n "#") (has-prefix? n "?")
                             (and (not (null? b)) (tagcase (car b) (bind (m sc w) (tagcase sc (scheme (tv t) (tagcase (walk s t) (ty-nat () #t) (else other #f))))))))
                         (the lins (list (lin 0 (list (lterm n 1)))))
                         nil)))
                 ns))))

(define size-shown? (subr kfx (cv st lin) bool)
  (lambda (v s goal0)
    "Whether the facts in scope show `goal >= 0`."
    (tagcase (size-facts-from (cv-binds v) nil nil nil)
      (sfacts (ges0 nes0)
        (let* ((goal (lin-resolved s goal0))
               (ges (map (lambda ((l lin)) (lin-resolved s l)) ges0))
               (nes (map (lambda ((l lin)) (lin-resolved s l)) nes0))
               (names (concat (map lin-names (cons goal (onto ges nes))))))
          (lin-shown? (onto (nat-bounds v s names) ges) nes goal))))))

(define-rec
  (lone-meta (subr kfx ((listof lterm acyclic)) (listof lterm acyclic))
    (lambda (ts)
      "The first inference variable of `ts` of coefficient 1 or -1, if any:
       one to solve for."
      (let ((ms (filter (lambda ((t lterm)) (tagcase t (lterm (n k) (and (has-prefix? n "?") (or (i64= k 1) (i64= k -1)))))) ts)))
        (if (null? ms) nil (list (car ms)))))))

(define sized? (subr kfx (ty string) bool) (lambda (t d) (tagcase t (ty-data (x args) (string=? x d)) (else other #f))))
(define sized-elem (subr kfx (ty) ty) (lambda (t) (tagcase t (ty-data (d args) (car args)) (else other t))))
(define sized-size (subr kfx (ty) ty)
  (lambda (t) (tagcase t (ty-data (d args) (if (string=? d "%natof") (car args) (car (cdr args)))) (else other size-finite))))

(define sized-less (subr kfx (ty st) ty)
  (lambda (t s)
    "A `%nlist`'s type of one element fewer: `finite`'s is `finite`."
    (let ((l (size-lin s (sized-size t))))
      (ty-data "%nlist" (list (sized-elem t) (if (null? l) size-finite (size-of-lin (lin-add (car l) (lin -1 nil) 1))))))))

(define-rec
  (fits (subr kfx (cv st ty ty) st)
    (lambda (v s actual expected)
      "That a value of type `actual` may stand where `expected` is: the two
       the same, inference variables solved to make them so, but for
       `void`, which fits anything, and a procedure, whose latent effect
       may be within the one expected."
      (let ((a (walk s actual)) (e (walk s expected)))
        (tagcase a
          (ty-void () s)
          (ty-meta (k)
            (tagcase e
              (ty-meta (j) (if (i64= j k) s (solve s k e)))
              (else other
                (if (occurs? s k e) (mismatch v s a e) (solve s k e)))))
          (else other
            (tagcase e
              (ty-meta (j)
                (cond ((occurs? s j a) (mismatch v s a e))
                      ((tagcase a (ty-nat () #t) (else other #f))
                       "A `nat` met by an inference variable makes it an `int`: FX-26's
                        is the variable's own `(nat v)`, which no other `nat` is."
                       (solve s j (ty-int)))
                      (else (solve s j a))))
              (else other (fits-shapes v s a e))))))))
  (fits-shapes (subr kfx (cv st ty ty) st)
    (lambda (v s a e)
      (cond ((or (not (string=? (spec-of a) "")) (not (string=? (spec-of e) "")))
             "A specified procedure (C162): the procedure within, then behavioural
              subtyping, Fixpt's `logic::spec_within`: it requires no more than
              the one expected, and ensures no less."
             (let ((s2 (fits v s (unspecified a) (unspecified e))))
               (if (spec-within? (spec-of a) (spec-of e))
                   s2
                   (refuse-named v s (string-append "a " (string-append (show-ty s a) (string-append " is here, where a " (string-append (show-ty s e)
                     " is expected: it requires more, or ensures less, than is expected, as far as the prover can tell"))))))))
            ((and (sized? a "%natof") (tagcase e (ty-nat () #t) (ty-int () #t) (else other #f)))
             "`(nat s)` below `nat` and `int` (C158)."
             s)
            ((and (sized? a "%nlist") (tagcase e (ty-data (d args) (and (string=? d "%pairof") (sized? (walk s (car (cdr args))) "%nlist"))) (else other #f)))
             "A pair whose tail is a list of a size, at `acyclic`, as the list it
              is (C68, C158)."
             (tagcase e (ty-data (d args) (fits v (fits v (fits v s (sized-elem a) (car args)) a (car (cdr args))) (car (cdr (cdr args))) (ty-rconst "acyclic"))) (else other (mismatch v s a e))))
            ((and (sized? a "%nlist") (tagcase e (ty-list (y r) #t) (else other #f)))
             "A list of a size below a list, at `acyclic` (C158): frozen, it ends."
             (tagcase e (ty-list (y r) (fits v (fits v s (sized-elem a) y) (ty-rconst "acyclic") r)) (else other (mismatch v s a e))))
            ((and (sized? e "%nlist") (tagcase a (ty-list (x r) #t) (else other #f)))
             "A list at `acyclic` below a list of a size not known, `finite`: one
              that is frozen and ends (C158)."
             (tagcase a
               (ty-list (x r)
                 (if (size-finite? s (sized-size e))
                     (fits v s a (ty-list (sized-elem e) (ty-rconst "acyclic")))
                     (mismatch v s a e)))
               (else other (mismatch v s a e))))
            ((and (sized? e "%nlist") (tagcase a (ty-data (d args) (string=? d "nil")) (else other #f)))
             "`nil` below a list of a size shown 0 (C158)."
             (size-fits v s (size-of-lin (lin 0 nil)) (sized-size e) a e))
            ((and (sized? e "%nlist") (tagcase a (ty-data (d args) (string=? d "%pairof")) (else other #f)))
             "A pair, frozen, below a list of size `s`: its tail of size `s - 1`, `s`
              shown not 0 (C158)."
             (tagcase a
               (ty-data (d args)
                 (let ((z (sized-size e)))
                   (if (and (not (size-finite? s z)) (not (size-shown? v s (lin-add (car (size-lin s z)) (lin -1 nil) 1))))
                       (mismatch v s a e)
                       (fits v (fits v (fits v s (car args) (sized-elem e)) (car (cdr args)) (sized-less e s))
                             (car (cdr (cdr args))) (ty-rconst "acyclic")))))
               (else other (mismatch v s a e))))
            ((and (datum? a) (datum? e)) s)
            ((and (datum? e) (tagcase a (ty-list (x r) #t) (else other #f)))
             "A list below `datum` (C77): its elements are, at `acyclic`; so a
              list of datums is one, as FX-26 has it, and is given as it is."
             (tagcase a (ty-list (x r) (fits v (fits v s x e) r (ty-rconst "acyclic"))) (else other (mismatch v s a e))))
            ((string=? (shape-of a) "union")
             "A union below `e`: each member is (C62)."
             (fits-each-member v s (members-of a) e))
            ((and (string=? (shape-of e) "union") (tagcase a (ty-list (x r) #t) (else other #f))
                  (null? (member-of-shape (members-of e) "list")))
             "A list where a union of `nil` and a pair is expected: each of the
              two it is (C69)."
             (tagcase a
               (ty-list (x r) (fits v (fits v s (ty-data "nil" nil) e) (ty-data "%pairof" (list x a r)) e))
               (else other (mismatch v s a e))))
            ((and (string=? (shape-of e) "union") (not (string=? (shape-of a) "")))
             "A member below its union: the member of its shape (C62)."
             (let ((m (member-of-shape (members-of e) (shape-of a))))
               (if (null? m) (mismatch v s a e) (fits v s a (car m)))))
            ((and (tagcase a (ty-data (d args) (string=? d "false")) (else other #f)) (tagcase e (ty-bool () #t) (else other #f)))
             "`false` below `bool`."
             s)
            ((and (tagcase a (ty-data (d args) (string=? d "nil")) (else other #f)) (tagcase e (ty-list (x r) #t) (else other #f)))
             "`nil` below a list (C68)."
             s)
            ((and (tagcase a (ty-data (d args) (string=? d "%pairof")) (else other #f)) (tagcase e (ty-list (x r) #t) (else other #f)))
             "A pair whose tail is the list, below the list (C68)."
             (tagcase a
               (ty-data (d args)
                 (tagcase e
                   (ty-list (x r) (fits v (fits v (fits v s (car args) x) (car (cdr args)) e) (car (cdr (cdr args))) r))
                   (else other (mismatch v s a e))))
               (else other (mismatch v s a e))))
            (else (fits-shapes-of v s a e)))))
  (fits-each-member (subr kfx (cv st tys ty) st)
    (lambda (v s ms e) (if (null? ms) s (fits-each-member v (fits v s (car ms) e) (cdr ms) e))))
  (fits-shapes-of (subr kfx (cv st ty ty) st)
    (lambda (v s a e)
      (tagcase a
        (ty-list (x xr)
          (tagcase e
            (ty-list (y yr)
              "A list at `acyclic` is frozen, so its elements' type may be
               below the one expected (C78); at a region that may be
               written, the same, as FX-26 has it."
              (let ((s (fits v s xr yr)))
                (if (tagcase (walk s yr) (ty-rconst (n) (or (string=? n "acyclic") (string=? n "const"))) (else other #f))
                    (fits v s x y)
                    (fits v (fits v s x y) y x))))
            (else other (mismatch v s a e))))
        (ty-flat (x xr) (tagcase e (ty-flat (y yr) (fits v (fits v s x y) xr yr)) (else other (mismatch v s a e))))
        (ty-shape (p ls ts)
          (tagcase e
            (ty-shape (q ms us)
              (if (and (if p q (not q)) (strings=? ls ms) (i64= (size ts) (size us)))
                  (fits-each v s ts us)
                  (mismatch v s a e)))
            (else other (mismatch v s a e))))
        (ty-ref (x xr) (tagcase e (ty-ref (y yr) (fits v (fits v s x y) xr yr)) (else other (mismatch v s a e))))
        (ty-rconst (x)
          (tagcase e
            (ty-rconst (y)
              ;; `acyclic`, and a fresh one's data, below `const` (C161).
              (if (or (string=? x y) (and (string=? y "const") (or (string=? x "acyclic") (string=? x "%fresh")))) s (mismatch v s a e)))
            (else other (mismatch v s a e))))
        (ty-tag (xa xh xd xr)
          (tagcase e
            (ty-tag (ya yh yd yr)
              "A tag's bound the same both ways, its effect variables solved to
               make it so (C60: a primitive's tag at FX-26's poly type)."
              (let ((two (same-effs s xd yd)))
                (if (null? two)
                    (mismatch v s a e)
                    (fits v (fits v (fits v (car two) xa ya) xh yh) xr yr))))
            (else other (mismatch v s a e))))
        (ty-data (x xs)
          (tagcase e
            (ty-data (y ys)
              (cond ((and (string=? x "%native") (string=? y "%fx"))
                     "A native procedure where one of any convention is (C116)."
                     (fits v s (car xs) (car ys)))
                    ((not (and (string=? x y) (i64= (size xs) (size ys)))) (mismatch v s a e))
                    ((string=? x "%poly")
                     "Two poly types (C107): the one's binders the other's, then their bodies."
                     (fits v s (poly-body xs) (poly-instance ys (map (lambda ((n string)) (ty-var n)) (poly-binders-of xs)))))
                    ((or (string=? x "%composable") (string=? x "%oneshot"))
                     "Its bound `D` the same both ways, as a tag's (C60)."
                     (let* ((xd (tagcase (car (cdr (cdr xs))) (ty-proc (es ps r) es) (else other nil)))
                            (yd (tagcase (car (cdr (cdr ys))) (ty-proc (es ps r) es) (else other nil)))
                            (two (same-effs s xd yd)))
                       (if (null? two)
                           (mismatch v s a e)
                           (fits v (fits v (fits v (car two) (car xs) (car ys)) (car (cdr xs)) (car (cdr ys)))
                                 (car (cdr (cdr (cdr xs)))) (car (cdr (cdr (cdr ys))))))))
                    ((or (string=? x "%nlist") (string=? x "%natof"))
                     "A size the same, or the one expected `finite` (C158)."
                     (if (string=? x "%nlist")
                         (size-fits v (fits v s (car xs) (car ys)) (car (cdr xs)) (car (cdr ys)) a e)
                         (size-fits v s (car xs) (car ys) a e)))
                    ((string=? x "%vsubr")
                     "Its element and result first, then its effect, which they may solve
                      a region of: `list`'s `(alloc r)`, `r` acyclic, is pure (C156)."
                     (fits v (fits v (fits v s (car (cdr xs)) (car (cdr ys))) (car (cdr (cdr xs))) (car (cdr (cdr ys)))) (car xs) (car ys)))
                    (else (fits-all v s xs ys))))
            (ty-proc (ees eps er)
              "A composable continuation where a procedure is expected (C60)."
              (if (or (string=? x "%composable") (string=? x "%oneshot")) (fits v s (composable-as-proc s a) e) (mismatch v s a e)))
            (else other (mismatch v s a e))))
        (ty-var (x) (tagcase e (ty-var (y) (if (string=? x y) s (mismatch v s a e))) (else other (mismatch v s a e))))
        (ty-proc (aes aps ar)
          (tagcase e
            (ty-proc (ees eps er)
              (cond ((not (i64= (size aps) (size eps))) (mismatch v s a e))
                    ((null? (fit-effs s aes ees))
                     "A region of `a`'s effect not solved yet, which its parameters solve,
                      as where a module's poly value fits its module type's (C119): the
                      parameters first, then the effects."
                     (let* ((s2 (fits-all v s eps aps))
                            (fitted (fit-effs s2 aes ees)))
                       (if (null? fitted) (mismatch v s a e) (fits v (car fitted) ar er))))
                    (else (fits v (fits-all v (car (fit-effs s aes ees)) eps aps) ar er))))
            ;; A procedure of KFX's own where one of any convention is (C116).
            (ty-data (d args) (if (string=? d "%fx") (fits v s a (car args)) (mismatch v s a e)))
            (else other (mismatch v s a e))))
        (else other (if (same-base? a e) s (mismatch v s a e))))))
  (fits-each (subr kfx (cv st tys tys) st)
    (lambda (v s actuals expecteds)
      "Fields, or a sum's members: each actual's type standing for the
       expected's, covariant."
      (if (null? actuals)
          s
          (fits-each v (fits v s (car actuals) (car expecteds)) (cdr actuals) (cdr expecteds)))))
  (fits-all (subr kfx (cv st tys tys) st)
    (lambda (v s actuals expecteds)
      "Parameters: each expected parameter's type stands for the actual's."
      (if (null? actuals)
          s
          (fits-all v (fits v s (car actuals) (car expecteds)) (cdr actuals) (cdr expecteds)))))
  (size-fits (subr kfx (cv st ty ty ty ty) st)
    (lambda (v s za ze a e)
      "That size `za` may stand for `ze` (C158), in types `a` and `e`: `ze`
       `finite`; else the two shown equal by the facts in scope, an
       inference variable alone in one solved to make them so, its size
       shown not negative."
      (let ((la (size-lin s za)) (le (size-lin s ze)))
        (cond ((tagcase (walk s ze) (ty-meta (k) #t) (else other #f))
               "A size binder may be instantiated with `finite` too (Fixpt's sizes.md),
                unless it sizes more than one argument, or something inside one."
               (tagcase (walk s ze)
                 (ty-meta (k)
                   (cond ((tagcase (walk s za) (ty-meta (j) (i64= j k)) (else other #f)) s)
                         ((and (null? la) (any? (lambda ((f fact)) (tagcase f (fact (fl p w) (and (string=? fl "%sizes") (i64= p k) (string=? w "not-finite"))))) (st-facts s)))
                          (refuse-named v s "a size cannot be finite here: it is the size of more than one argument, or of something inside one, and finite would not keep them the same"))
                         (else (solve s k za))))
                 (else other s)))
              ((null? le) s)
              ((tagcase (walk s za) (ty-meta (k) #t) (else other #f))
               (tagcase (walk s za) (ty-meta (k) (solve s k ze)) (else other s)))
              ((null? la) (mismatch v s a e))
              (else
               (let* ((d (lin-resolved s (lin-add (car la) (car le) -1)))
                      (m (tagcase d (lin (c ts) (lone-meta ts)))))
                 (if (null? m)
                     (if (and (size-shown? v s d) (size-shown? v s (lin-scaled d -1))) s (mismatch v s a e))
                     (tagcase (car m)
                       (lterm (n k)
                         ;; d = k ?n + rest = 0, so ?n = - rest / k.
                         (let ((solved (lin-scaled (lin-add d (lin 0 (list (lterm n 1))) (i64- 0 k)) (i64- 0 k))))
                           ;; Not negative, where the solution is known whole; else
                           ;; what is fitted later says what its variables are.
                           (if (or (any? (lambda ((x string)) (has-prefix? x "?")) (lin-names solved)) (size-shown? v s solved))
                               (solve s (string->i64 (after-prefix n "?")) (size-of-lin solved))
                               (mismatch v s a e))))))))))))
  (mismatch (subr kfx (cv st ty ty) st)
    (lambda (v s a e)
      (refuse-named v s (string-append "a " (string-append (show-ty s a)
                (string-append " is here, where a " (string-append (show-ty s e) " is expected"))))))))

(define-rec
  (var-count (subr kfx (string ty) i64)
    (lambda (n t)
      "How often type variable `n` is in `t`."
      (tagcase t
        (ty-var (m) (if (string=? m n) 1 0))
        (ty-list (e r) (i64+ (var-count n e) (var-count n r)))
        (ty-flat (e r) (i64+ (var-count n e) (var-count n r)))
        (ty-ref (e r) (i64+ (var-count n e) (var-count n r)))
        (ty-data (d args) (vars-count n args))
        (ty-tag (a h es r) (i64+ (var-count n a) (i64+ (var-count n h) (var-count n r))))
        (ty-proc (es ps r) (i64+ (vars-count n ps) (var-count n r)))
        (ty-shape (p ls ts) (vars-count n ts))
        (else other 0))))
  (vars-count (subr kfx (string (listof ty acyclic)) i64)
    (lambda (n ts) (if (null? ts) 0 (i64+ (var-count n (car ts)) (vars-count n (cdr ts)))))))

(define finite-may? (subr kfx (string ty) bool)
  (lambda (n t)
    "Whether size binder `n` of a procedure's type `t` may be instantiated
     with `finite`: it is in its parameters once, the size of one of them,
     itself (Fixpt's rule: else `finite` would not keep two sizes the same)."
    (tagcase t
      (ty-proc (es ps r)
        (and (i64= (vars-count n ps) 1)
             (any? (lambda ((p ty)) (and (sized? p "%nlist") (tagcase (sized-size p) (ty-var (m) (string=? m n)) (else other #f)))) ps)))
      (else other #f))))

"A scheme's instance: each variable an inference variable; those for
 regions are kept, so that a call's effect can name the regions found."
(define-datatype inst (inst ty st (listof i64 acyclic) (listof i64 acyclic)))

(define-rec
  (instantiate (subr kfx (st scheme) inst)
    (lambda (s sc)
      (tagcase sc
        (scheme (tvars t) (instantiate-vars s tvars t nil nil)))))
  (instantiate-vars (subr kfx (st strings ty (listof i64 acyclic) (listof i64 acyclic)) inst)
    (lambda (s tvars t regions effects)
      "Each binder an inference variable; a region's and an effect's (C46)
       kept apart from a type's."
      (if (null? tvars)
          (inst t s regions effects)
          (tagcase (fresh s)
            (res (m es s)
              (tagcase m
                (ty-meta (k)
                  (instantiate-vars (if (and (has-prefix? (car tvars) "#") (not (finite-may? (car tvars) t)))
                                        (note-fact s "%sizes" k "not-finite")
                                        s)
                                    (cdr tvars) (replace-var (car tvars) m t)
                                    (if (char=? (string-ref-i64 (car tvars) 0) #\') (cons k regions) regions)
                                    (if (char=? (string-ref-i64 (car tvars) 0) #\~) (cons k effects) effects)))
                (else other (inst t s regions effects)))))))))

(define named-instance (subr kfx (cv st scheme) inst)
  (lambda (v s sc)
    "`sc`'s instance; in a REPL's draft or entry, its inference variables
     noted as their binders' names, to be said by them (C98)."
    (if (tagcase v (cv (bs ds als es here group file line fs tv at) (or (string=? file "<draft>") (has-prefix? file "<fx26:"))))
        (tagcase (instantiate s sc)
          (inst (t s2 regions effects)
            (inst t (binders-noted s2 (tagcase sc (scheme (tvars u) tvars)) (st-next s)) regions effects)))
        (instantiate s sc))))


"The names in scope"

(define keyword? (subr kfx (string) bool)
  (lambda (name)
    "FX-26's keywords, which name nothing (fixpt's top.rs, KEYWORDS)."
    (or (string=? name "lambda") (string=? name "plambda") (string=? name "proj") (string=? name "if")
        (string=? name "letrec") (string=? name "let") (string=? name "begin") (string=? name "define")
        (string=? name "define*") (string=? name "define-type") (string=? name "define-generative") (string=? name "subr")
        (string=? name "poly") (string=? name "ref") (string=? name "pairof") (string=? name "dletrec")
        (string=? name "void") (string=? name "pure") (string=? name "maxeff") (string=? name "read")
        (string=? name "write") (string=? name "alloc") (string=? name "goto") (string=? name "comefrom")
        (string=? name "region") (string=? name "effect") (string=? name "type") (string=? name "prompt")
        (string=? name "prompt-tag") (string=? name "composable") (string=? name "mark-key") (string=? name "listof")
        (string=? name "cond") (string=? name "case") (string=? name "else") (string=? name "and")
        (string=? name "or") (string=? name "let*") (string=? name "define-effect") (string=? name "module-parameters")
        (string=? name "the") (string=? name "bloblet") (string=? name "fields") (string=? name "frozen")
        (string=? name "arrayof") (string=? name "icell") (string=? name "await") (string=? name "define-rec")
        (string=? name "letrena") (string=? name "letreap") (string=? name "rlambda") (string=? name "quote")
        (string=? name "productof") (string=? name "sumof") (string=? name "product") (string=? name "extract")
        (string=? name "sum") (string=? name "tagcase") (string=? name "module") (string=? name "moduleof")
        (string=? name "with") (string=? name "select") (string=? name "load-module") (string=? name "define-datatype")
        (string=? name "make-bloblet") (string=? name "bloblet-ref") (string=? name "bloblet-set!") (string=? name "bloblet-freeze")
        (string=? name "bloblet-byte") (string=? name "bloblet-set-byte!") (string=? name "bloblet-bytes") (string=? name "rmake-bloblet")
        (string=? name "dlambda") (string=? name "=>") (string=? name "blobref-at") (string=? name "blobref+")
        (string=? name "blobref-owner") (string=? name "blobref-offset") (string=? name "blobref-get") (string=? name "blobref-set!")
        (string=? name "blobref-index") (string=? name "blobref-variant!"))))

(define process-call? (subr kfx (string) bool)
  (lambda (h)
    "FX-26's forms of processes that are calls (C101): typed as procedures
     are, but a call headed by one is the form, whatever binds its name."
    (string-member? h (list "send" "receive" "icell-get" "icell-put!"))))

(define process-form? (subr kfx (string) bool)
  (lambda (h)
    "FX-26's forms of processes and `par` (C101), each a form wherever it
     heads a list, whatever binds its name."
    (or (process-call? h) (string-member? h (list "spawn" "par" "pselect")))))

(define bind-onto (subr kfx (binds binds) binds)
  (lambda (xs ys) (if (null? xs) ys (bind-onto (cdr xs) (cons (car xs) ys)))))

(define near (subr kfx (cv string i64 i64) cv)
  (lambda (v file line pos)
    "`v`, checking a list that began at `line` of `file`, at offset `pos`."
    (if (i64= line 0)
        v
        (tagcase v (cv (bs ds als es here group f l fs tv at) (cv bs ds als es here group file line fs tv pos))))))

(define cv-facts (subr kfx (cv) facts)
  (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) fs))))
(define cv-file (subr kfx (cv) string) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) file))))
(define cv-pos (subr kfx (cv) i64) (lambda (v) (tagcase v (cv (bs ds als es here group file line fs tv at) at))))
(define at-offset (subr kfx (cv i64) cv)
  (lambda (v pos)
    "`v`, its refusals said at offset `pos`, a datum inside the list it checks."
    (tagcase v (cv (bs ds als es here group file line fs tv at) (cv bs ds als es here group file line fs tv pos)))))

(define-rec
  (tys-first (subr kfx ((listof ty acyclic) i64) (listof ty acyclic))
    (lambda (ts n) (if (or (null? ts) (i64<= n 0)) nil (cons (car ts) (tys-first (cdr ts) (i64- n 1)))))))

(define-rec
  (words-joined (subr kfx (strings string) string)
    (lambda (xs between)
      (cond ((null? xs) "")
            ((null? (cdr xs)) (car xs))
            (else (string-append (car xs) (string-append between (words-joined (cdr xs) between))))))))

(define draft-hole? (subr kfx (sexp) bool)
  (lambda (e)
    "Whether `e` is the hole the REPL puts where the next item of a draft
     goes, to ask what may go there (live-repl.kfx, C97): `%hole`, in a
     `<draft>` only, so that no file's meaning changes."
    (tagcase e (sym (n f p) (and (string=? n "%hole") (string=? f "<draft>"))) (else other #f))))

(define said-in (subr kfx (cv string) cv)
  (lambda (v here)
    "`v`, its refusals said to be in `here`."
    (tagcase v (cv (bs ds als es h group file line fs tv at) (cv bs ds als es here group file line fs tv at)))))

(define-rec
  (through-hole (subr kfx (sexps) sexps)
    (lambda (xs)
      "`xs` to the REPL's hole, which ends them: what follows it fills a
       form's later parts, and is no call's argument."
      (cond ((null? xs) nil)
            ((draft-hole? (car xs)) (list (car xs)))
            (else (cons (car xs) (through-hole (cdr xs))))))))

(define in-draft (subr kfx (cv sexp) cv)
  (lambda (v e)
    "`v`, its refusals said at `e`, if `e` is in a REPL's draft: where an
     argument is refused, underlined (C97). Elsewhere `v`, so that no fact's
     place changes."
    (if (string=? (datum-file e) "<draft>") (at-offset v (datum-pos e)) v)))

(define operator-char? (subr kfx (char) bool)
  (lambda (c) (has-char-in? "?!<>=+*/%" c)))

(define might-clash? (subr kfx (string) bool)
  (lambda (n)
    "Whether another name might mangle as `n` does: one with an operator's
     character, or one whose mangling has what such a character's has."
    (or (any? operator-char? (string-chars n))
        (let ((m (mangle n)))
          (any? (lambda ((part string)) (string-has? m part))
                (list "_p" "_x" "_to_" "_plus" "_star" "_slash" "_lt" "_gt" "_eq" "_pct" "_minus"))))))

(define mangled-clash (subr kfx (string binds) strings)
  (lambda (n bs)
    "Another name in scope, spelled otherwise, that Rust names as `n`: two
     KFX names one Rust name, one hiding the other (C27)."
    (if (or (has-prefix? n "%") (has-char-in? n #\space) (not (might-clash? n)))
        nil
        (let ((m (mangle n)))
          (concat (map (lambda ((b bind))
                         (tagcase b
                           (bind (x sc w)
                             (if (and (not (string=? x n)) (not (has-prefix? x "%")) (not (has-char-in? x #\space))
                                      (i64= (mangled-length x) (string-length-i64 m))
                                      (string=? (mangle x) m))
                                 (the strings (list (string-append n (string-append " and " x))))
                                 nil))))
                       bs))))))

(define-rec
  (remove-bind (subr kfx (bind binds) binds)
    (lambda (b bs)
      "`bs` but the first of them named as `b`: the others bound with it."
      (cond ((null? bs) nil)
            ((tagcase (car bs) (bind (n sc w) (tagcase b (bind (m sc2 w2) (string=? n m))))) (cdr bs))
            (else (cons (car bs) (remove-bind b (cdr bs))))))))

(define with-binds (subr kfx (cv binds) cv)
  (lambda (v more)
    "`v` with the names `more` binds; none with a `_`: KFX writes `-`, and
     every Rust name kfx and kayak-rt write that a KFX name could meet has
     a `_` (`i64_plus`, `tagcase_`), so none is ever hidden."
    (if (any? (lambda ((b bind))
                (tagcase b (bind (n sc w) (and (not (has-prefix? n "%")) (not (has-char-in? n #\space)) (not (string=? w "prim"))
                                               (not (kfx-name? n))))))
              more)
        (refuse v (string-append "a name KFX's names are not (lower case, digits, `-` and `?!<>=+*/%`, no `--`, none Rust writes): "
                                 (car (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (if (kfx-name? n) nil (the strings (list n)))))) more)))))
        (let ((clash (onto (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (mangled-clash n (cv-binds v))))) more))
                           (concat (map (lambda ((b bind)) (tagcase b (bind (n sc w) (mangled-clash n (remove-bind b more))))) more)))))
          (if (not (null? clash))
              (refuse v (string-append "two names that are one in Rust: " (car clash)))
              (tagcase v (cv (bs ds als es here group file line fs tv at) (cv (bind-onto more bs) ds als es here group file line fs tv at))))))))

(define local (subr kfx (cv string ty) bind)
  (lambda (v name t)
    "A local may be named by a keyword, as FX-26 has it; it may not then be
     called, since FX-26 reads such a call as its form (`synth-call`)."
    (bind name (scheme nil t) "local")))

(define narrowed (subr kfx (cv string ty) bind)
  (lambda (v name t)
    "A local narrowed by a test (C62): the same Rust local, its type known
     better, unboxed where it is named if a union's (C75)."
    (bind name (scheme nil t) "narrowed")))

(define bind-origin (subr kfx (string binds) tys)
  (lambda (name bs)
    "The type of the binding of `name` a narrowing narrows, as a list of
     one, or none."
    (cond ((null? bs) nil)
          (else (tagcase (car bs)
                  (bind (n sc wher)
                    (if (and (string=? n name) (not (string=? wher "narrowed")))
                        (tagcase sc (scheme (tv t) (list t)))
                        (bind-origin name (cdr bs)))))))))

"Expressions"

(define with-effs (subr kfx (res strings) res)
  (lambda (r es) (tagcase r (res (t es0 s) (res t (effs-union es es0) s)))))

(define proc-type? (subr kfx (st ty) bool)
  (lambda (s t)
    "A procedure's type: KFX's own, or one of any convention (C116), which a
     lambda is checked against as its procedure."
    (tagcase (walk s t) (ty-proc (es ps r) #t) (ty-data (d args) (or (string=? d "%fx") (has-prefix? d "%spec "))) (else other #f))))

(define naming-effs (subr kfx (st string string ty strings) strings)
  (lambda (s name wher t group)
    "What naming a name does: a global is read; a member of the group being
     defined, named as a value, may be called by whoever is given it, and so
     loop: `spin`, as FX-26 has it. A global defined before cannot be, since
     nothing it reaches is defined after it (KFX defines each name once); a
     `letrec` member that may not end can."
    (cond ((string=? wher "rec") (list "spin"))
          ((not (string=? wher "global")) nil)
          ((and (proc-type? s t) (string-member? name group)) (list "spin" (string-append "g:" name)))
          (else (list (string-append "g:" name))))))

(define-rec
  (holds-procedure? (subr kfx (cv st ty strings) bool)
    (lambda (v s t seen)
      "Whether a value of `t` may hold a procedure: in a list, a cell, a
       shape, a datatype's fields, a generative type's representation (one
       not known, cautiously, yes); or `t` is not known yet."
      (tagcase (walk s t)
        (ty-proc (es ps r) #t)
        (ty-meta (k) #t)
        (ty-list (e r) (holds-procedure? v s e seen))
        (ty-ref (e r) (holds-procedure? v s e seen))
        (ty-flat (e r) #f)
        (ty-tag (a h d r) (or (holds-procedure? v s a seen) (holds-procedure? v s h seen)))
        (ty-shape (p ls ts) (any? (lambda ((x ty)) (holds-procedure? v s x seen)) ts))
        (ty-data (d args)
          (or (any? (lambda ((x ty)) (holds-procedure? v s x seen)) args)
              (and (not (string-member? d seen))
                   (let ((found (find-family d (cv-dts v))))
                     (if (null? found)
                         #f
                         (tagcase found
                           (dt (n ps vs)
                             (if (null? vs)
                                 (let ((down (conversion-bind (string-append "down-" d) (cv-binds v))))
                                   (if (null? down)
                                       (not (has-prefix? d "%module "))
                                       (tagcase (car down)
                                         (bind (n2 sc w)
                                           (tagcase sc
                                             (scheme (tv tt)
                                               (tagcase tt
                                                 (ty-proc (es xs r) (holds-procedure? v s (substitute ps args r) (cons d seen)))
                                                 (else other #t))))))))
                                 (any? (lambda ((x variant))
                                         (tagcase x (variant (tag fs) (any? (lambda ((f ty)) (holds-procedure? v s (substitute ps args f) (cons d seen))) fs))))
                                       vs)))))))))
        (else other #f)))))

"Whether a procedure of a type could be given itself (C81), FX-26's
 `cyclic` (Fixpt's infer.rs): a cycle in the type runs through a
 procedure's parameter. A type merely recursive, as a list or a `datum`
 is, lets nothing loop. In KFX only a datatype, or `datum`, can be met
 again on the way down: the trail is their names, each with whether a
 parameter was crossed on the way to it from the one before."
(define-datatype trail (trail string bool))
(define-type trails (listof trail acyclic))

(define-rec
  (crossed-since? (subr kfx (string trails) bool)
    (lambda (n ts)
      "Whether a parameter was crossed on the way from `n`, met before, to here."
      (cond ((null? ts) #f)
            ((tagcase (car ts) (trail (m p) (string=? m n))) #f)
            ((tagcase (car ts) (trail (m p) p)) #t)
            (else (crossed-since? n (cdr ts))))))
  (on-trail? (subr kfx (string trails) bool)
    (lambda (n ts) (any? (lambda ((t trail)) (tagcase t (trail (m p) (string=? m n)))) ts)))
  (cyclic-walk (subr kfx (cv st ty bool trails) bool)
    (lambda (v s t crossed ts)
      (if (i64> (size ts) 64)
          #t
          (let ((x (walk s t)))
            (tagcase x
              (ty-proc (es ps r)
                (or (any? (lambda ((p ty)) (cyclic-walk v s p #t ts)) ps) (cyclic-walk v s r crossed ts)))
              (ty-list (e r) (cyclic-walk v s e crossed ts))
              (ty-ref (e r) (cyclic-walk v s e crossed ts))
              (ty-flat (e r) (cyclic-walk v s e crossed ts))
              (ty-shape (p ls fs) (any? (lambda ((f ty)) (cyclic-walk v s f crossed ts)) fs))
              (ty-tag (a h d r) (or (cyclic-walk v s a crossed ts) (cyclic-walk v s h crossed ts)))
              (ty-data (d args)
                (let ((named (or (string=? d "datum") (dt-named? d (cv-dts v)))))
                  (cond ((and named (on-trail? d ts)) (or crossed (crossed-since? d ts)))
                        (named
                         "Its fields; what it was given, cautiously, as if taken as a
                          parameter, as FX-26 has it."
                         (let ((ts2 (the trails (cons (trail d crossed) ts)))
                               (kids (if (string=? d "datum")
                                         (datum-members)
                                         (let ((found (find-family d (cv-dts v))))
                                           (if (null? found)
                                               nil
                                               (tagcase found
                                                 (dt (n ps vs) (concat (map (lambda ((x variant)) (tagcase x (variant (tag fs) fs))) vs)))))))))
                           (or (any? (lambda ((k ty)) (cyclic-walk v s k #f ts2)) kids)
                               (any? (lambda ((k ty)) (cyclic-walk v s k #t ts2)) args))))
                        ((or (string=? d "%composable") (string=? d "%oneshot"))
                         (or (cyclic-walk v s (car args) #t ts) (any? (lambda ((k ty)) (cyclic-walk v s k crossed ts)) (cdr args))))
                        (else (any? (lambda ((k ty)) (cyclic-walk v s k crossed ts)) args)))))
              (else other #f)))))))

(define self-applicable? (subr kfx (cv st ty) bool)
  (lambda (v s t)
    "Whether a call of a procedure of type `t`, not known, may loop with no
     recursive call: FX-26 says `spin` for one whose type is recursive
     through a parameter (C81; KFX had said it, more cautiously, for any
     procedure that might hold a procedure)."
    (cyclic-walk v s t #f nil)))

(define void? (subr kfx (st ty) bool)
  (lambda (s t) (tagcase (walk s t) (ty-void () #t) (else other #f))))

(define next-expected (subr kfx (st ty tys) tys)
  (lambda (s t expected)
    "What the branches after one of type `t` are checked against: the type
     expected, if known; else nothing, each found by itself and then joined
     (`join-state`), as FX-26 has it: a literal in one is an `int` though
     another is an `i64`."
    (if (null? expected) nil expected)))

(define found-then-fitted (subr kfx (cv res tys) res)
  (lambda (v r expected)
    "A `with`'s or a `letregion`'s body, found by itself, as FX-26 finds it,
     then fitted to the type expected."
    (if (null? expected)
        r
        (tagcase r (res (t es s) (res (car expected) es (fits v s t (car expected))))))))

(define join-state (subr kfx (cv st ty ty tys) st)
  (lambda (v s t rest expected)
    "Branches found by themselves agree: the rest's type fits the first's."
    (if (or (not (null? expected)) (void? s t) (void? s rest)) s (fits v s rest t))))

(define joined (subr kfx (st ty ty tys) ty)
  (lambda (s t rest expected)
    "The type of branches, the first of type `t` and the rest of `rest`."
    (cond ((not (null? expected)) (car expected))
          ((void? s t) rest)
          (else t))))

(define region-of (subr kfx (cv st ty) res)
  (lambda (v s r)
    "A region, solved: one no argument nor expected type said is `acyclic`,
     as FX-26's fresh region for it, masked where it is not seen, is pure."
    (tagcase (walk s r)
      (ty-meta (k) (res (ty-rconst "acyclic") nil (solve s k (ty-rconst "acyclic"))))
      (else other (res other nil s)))))

(define name-regions (subr kfx (cv st strings (listof i64 acyclic)) res)
  (lambda (v s es regions)
    "A call's latent effect, its regions' inference variables replaced by
     the regions the arguments and the type expected found, or `acyclic`."
    (if (null? regions)
        (res (ty-unit) es s)
        (tagcase (region-of v s (ty-meta (car regions)))
          (res (r rn s)
            (name-regions v s (rename-atoms es (meta-name (car regions)) (region-string s r)) (cdr regions)))))))

(define masked (subr kfx (strings string) strings)
  (lambda (es r)
    "Effects, those on region `r` removed."
    (cond ((null? es) nil)
          ((and (region-atom? (car es)) (string=? (atom-region (car es)) r))
           (masked (cdr es) r))
          (else (cons (car es) (masked (cdr es) r))))))

(define-rec
  (mentions? (subr kfx (st ty string) bool)
    (lambda (s t r)
      "Whether type `t` mentions region `r`, latent effects included."
      (tagcase (walk s t)
        (ty-var (n) (string=? n r))
        (ty-list (e x) (or (mentions? s e r) (mentions? s x r)))
        (ty-flat (e x) (or (mentions? s e r) (mentions? s x r)))
        (ty-shape (p ls ts) (any? (lambda ((x ty)) (mentions? s x r)) ts))
        (ty-tag (a h d x) (or (mentions? s a r) (mentions? s h r) (mentions? s x r)
                              (not (string=? (words-of (masked d r)) (words-of d)))))
        (ty-ref (e x) (or (mentions? s e r) (mentions? s x r)))
        (ty-data (d args) (any? (lambda ((a ty)) (mentions? s a r)) args))
        (ty-proc (es ps x)
          (or (not (string=? (words-of (masked es r)) (words-of es)))
              (mentions? s x r)
              (any? (lambda ((p ty)) (mentions? s p r)) ps)))
        (else other #f)))))

(define nat-op? (subr kfx (string) bool)
  (lambda (h)
    "The operations whose result is a `nat` when their operands are, as
     FX-26 keeps a `nat` through them: a sum. (A product, a larger, a smaller
     are `int`s to FX-26's checker.)"
    (string=? h "+")))

(define prim? (subr kfx (bind) bool)
  (lambda (b) (tagcase b (bind (n sc wher) (string=? wher "prim")))))

(define nat? (subr kfx (st ty) bool)
  (lambda (s t) (tagcase (walk s t) (ty-nat () #t) (else other #f))))



(define-rec
  (holds-meta? (subr kfx (ty) bool)
    (lambda (t)
      "Whether `t`, as written (no variable solved looked through), has an
       inference variable in it."
      (tagcase t
        (ty-meta (k) #t)
        (ty-list (e r) (or (holds-meta? e) (holds-meta? r)))
        (ty-ref (e r) (or (holds-meta? e) (holds-meta? r)))
        (ty-data (d args) (any? holds-meta? args))
        (ty-proc (es ps r) (or (holds-meta? r) (any? holds-meta? ps)))
        (ty-shape (p ls ts) (any? holds-meta? ts))
        (else other #f)))))

(define deferred? (subr kfx (sexp ty) bool)
  (lambda (arg param)
    "`nil` given for a parameter that is, as instantiated, an inference
     variable; and a lambda one of whose parameters has no type written,
     given for a procedure one of whose parameters' is such a variable (C74:
     FX-26 hears lambdas last, and the emitter writes the closure's
     parameters' types the checker found, so rustc need not find them):
     decided before any argument is checked, so both passes agree."
    (or (and (tagcase param (ty-meta (k) #t) (else other #f)) (sym-is? arg "nil"))
        (and (head-is? arg "lambda")
             (any? (lambda ((p sexp)) (tagcase p (sym (n f x) #t) (else other #f))) (items (second (items arg))))
             (tagcase param (ty-proc (es ps r) (any? holds-meta? ps)) (else other #f))))))

(define eqv-bool? (subr kfx (bool bool) bool)
  (lambda (a b) (if a b (not b))))

(define masked-goto (subr kfx (strings string) strings)
  (lambda (es r)
    (cond ((null? es) nil)
          ((string=? (car es) (string-append "goto:" r)) (masked-goto (cdr es) r))
          ((string=? (car es) (string-append "comefrom:" r)) (masked-goto (cdr es) r))
          (else (cons (car es) (masked-goto (cdr es) r))))))

(define-rec
  (names-in (subr kfx (sexp) strings)
    (lambda (e)
      "Every name in `e`, bound in it or not."
      (tagcase e
        (sym (n at-file at-pos) (list n))
        (lst (xs src-file src-line src-pos) (names-in-all xs))
        (else other nil))))
  (names-in-all (subr kfx (sexps) strings)
    (lambda (es) (if (null? es) nil (onto (names-in (car es)) (names-in-all (cdr es)))))))

(define reaches? (subr kfx (cv st sexp sexp string) bool)
  (lambda (v s body tag r)
    "Whether `body` may reach a tag of region `r` but `tag`: whether a
     name in it, but `tag`'s if it is one, has a type that mentions `r`; a
     module's name, whether anything it gives has (C116: `(with m f)`, a
     K1 breach found by Fixpt's checker's modules, its `goto` masked)."
    (let ((tag-name (tagcase tag (sym (n at-file at-pos) n) (else other ""))))
      (any? (lambda ((n string))
              (and (not (string=? n tag-name))
                   (let ((found (find-bind n (cv-binds v))))
                     (and (not (null? found))
                          (tagcase (car found)
                            (bind (b sc wher)
                              (if (string=? wher "module")
                                  (any? (lambda ((x bind))
                                          (tagcase x (bind (xn xsc xw) (and (has-prefix? xn (string-append n " "))
                                                                            (tagcase xsc (scheme (tvars t) (mentions? s t r)))))))
                                        (cv-binds v))
                                  (tagcase sc (scheme (tvars t) (mentions? s t r))))))))))
            (names-in body)))))

(define-rec
  (binds-prefixed (subr kfx (string binds) binds)
    (lambda (prefix bs)
      (if (null? bs)
          nil
          (tagcase (car bs)
            (bind (n sc wher)
              (if (and (string=? wher "export") (has-prefix? n prefix))
                  (cons (bind (after-prefix n prefix) sc "item") (binds-prefixed prefix (cdr bs)))
                  (binds-prefixed prefix (cdr bs)))))))))

(define opened-binds (subr kfx (string binds) binds)
  (lambda (m bs)
    "Module `m`'s values, as items, named as `m` names them (the prefix made
     once, C92: a module including another asks it often)."
    (binds-prefixed (string-append m " ") bs)))

"Whether an expression's value is a pair `cons` makes: FX-26 types one a
 `(pairof ...)`, never a `(listof ...)`, so that branches of which some
 are and some are not do not join where nothing is expected (KFX's
 `cons` is a list: `pairs-mixed?`, a K1 breach found 2026-10-16)."
(define-rec
  (pair-made? (subr kfx (sexp) bool)
    (lambda (e)
      (tagcase e
        (lst (xs f l p)
          (cond ((null? xs) #f)
                ((sym-is? (car xs) "cons") #t)
                ((and (or (sym-is? (car xs) "let") (sym-is? (car xs) "let*") (sym-is? (car xs) "letrec") (sym-is? (car xs) "begin"))
                      (i64> (size xs) 1))
                 (pair-made? (car (the sexps (reverse xs)))))
                ((and (sym-is? (car xs) "if") (i64= (size xs) 4)) (and (pair-made? (third xs)) (pair-made? (fourth xs))))
                (else #f)))
        (else other #f))))
  (branch-values (subr kfx (string sexps) sexps)
    (lambda (h xs)
      "The expressions whose values a branching form gives: an `if`'s two;
       the last of each clause of a `cond`, `case`, `tagcase`, `typecase`."
      (cond ((string=? h "if") (if (i64= (size xs) 3) (cdr xs) nil))
            ((string=? h "cond") (concat (map (lambda ((c sexp)) (tagcase c (lst (ys f l p) (if (null? ys) nil (the sexps (list (car (the sexps (reverse ys))))))) (else other nil))) xs)))
            ((or (string=? h "case") (string=? h "tagcase") (string=? h "typecase"))
             (if (null? xs) nil (concat (map (lambda ((c sexp)) (tagcase c (lst (ys f l p) (if (i64< (size ys) 2) nil (the sexps (list (car (the sexps (reverse ys))))))) (else other nil))) (cdr xs)))))
            (else nil)))))

(define pairs-mixed? (subr kfx (string sexps) bool)
  (lambda (h xs)
    "Whether a branching form's branches, nothing expected, mix a pair
     `cons` makes with what is not one (`pair-made?`)."
    (let ((vs (branch-values h xs)))
      (and (any? pair-made? vs) (any? (lambda ((x sexp)) (not (pair-made? x))) vs)))))

(define well-formed? (subr kfx (string sexps) bool)
  (lambda (h xs)
    "Whether a control form has the parts it needs, before they are taken."
    (let ((lists? (lambda ((x sexp) (n i64) (exact bool))
                    ;; A REPL's hole stands for a part not yet typed (C97).
                    (or (draft-hole? x)
                        (and (tagcase x (lst (ys f l p) #t) (else other #f))
                             (if exact (i64= (size (items x)) n) (not (i64< (size (items x)) n))))))))
      (cond ((string=? h "if") (i64= (size xs) 3))
            ((string=? h "cond") (and (not (null? xs)) (not (any? (lambda ((c sexp)) (not (lists? c 2 #f))) xs))))
            ((or (string=? h "let") (string=? h "let*"))
             (and (i64> (size xs) 1) (lists? (car xs) 0 #f)
                  (not (any? (lambda ((b sexp)) (not (lists? b 2 #t))) (items (car xs))))))
            ((string=? h "letrec")
             (and (i64> (size xs) 1) (lists? (car xs) 0 #f)
                  (not (any? (lambda ((b sexp)) (not (lists? b 3 #t))) (items (car xs))))))
            ((or (string=? h "case") (string=? h "tagcase"))
             (and (i64> (size xs) 1) (not (any? (lambda ((c sexp)) (not (lists? c 2 #f))) (cdr xs)))))
            ((or (string=? h "with") (string=? h "letregion")) (i64> (size xs) 1))
            (else #t)))))
