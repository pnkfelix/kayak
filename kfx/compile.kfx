"compile.kfx: the compiler's entry points, for a program of one file and
 for one of several."

(define header string
  "// Generated by kfx from KFX-0 source: edit that, and regenerate (PLAN.md, section 1).\n\nuse kayak_rt::*;\n\n")

(define-datatype source (source string string))
(define-datatype output (output string string))
(define-type sources (listof source acyclic))
(define-type outputs (listof output acyclic))

(define restrict-checked (subr kfx (verdict sexps) verdict)
  (lambda (checked forms)
    "A program checked, then KFX's restrictions (restrict.kfx, C60)."
    (begin (with restrictions (restrict forms (verdict-facts checked))) checked)))

"The facts only the async mode reads (C371, C373): a call's callee's kind,
 a named procedure as a value. Noted by the checker whatever the mode, they
 are dropped before the synchronous mode's emitter: a fact at every call,
 they made every walk of the facts longer, and one too deep for tier 1's
 stack, where the compiler runs as FX-26."
(define-rec
  (sync-facts (subr kfx (facts facts) facts)
    (lambda (fs acc)
      "`fs` but the async mode's, onto `acc` reversed: a loop, so as deep as
       nothing."
      (if (null? fs)
          (reverse acc)
          (tagcase (car fs)
            (fact (f p w)
              (if (or (string=? w "kfx-call") (string=? w "prim-call") (string=? w "prim-ref") (has-prefix? w "proc-value"))
                  (sync-facts (cdr fs) acc)
                  (sync-facts (cdr fs) (cons (car fs) acc)))))))))

"The emitter's mode as a fact (C371): at no place, `async-mode`, in the
 facts it is given; in its synchronous mode, none, and the async mode's own
 facts dropped."
(define moded-facts (subr kfx (facts bool) facts)
  (lambda (fs async) (if async (cons (fact "" -1 "async-mode") fs) (sync-facts fs nil))))

(define compile-named (subr kfx (string string fileds bool) string)
  (lambda (file src loaded async)
    "The same, its messages naming `file`; the files it loads, `loaded`;
     `async`, every procedure an `async fn` (C371)."
    (let* ((forms (with-loads (read-all src file 1) file loaded))
           (checked (restrict-checked (check-program forms) forms))
           (fs (moded-facts (verdict-facts checked) async))
           (c (with emitter (collect forms (ctx nil nil nil nil (verdict-typeds checked) fs (fidx-of fs) nil nil nil)))))
      (rev->string (with writing (put-module-impls c (with writing (put-tops c forms (with writing (put-shapes c forms #f (put header nil)))))))))))

(define compile-toplevel (subr kfx (string string fileds) string)
  (lambda (file src loaded)
    "A program of one file, as Rust, with its top-level expressions as
     `kfx_toplevel`, which writes their values (emit.kfx)."
    (let* ((forms (with-loads (read-all src file 1) file loaded))
           (checked (restrict-checked (check-program forms) forms))
           (c (with emitter (collect forms (ctx nil nil nil nil (verdict-typeds checked) (verdict-facts checked) (fidx-of (verdict-facts checked)) nil nil nil)))))
      (rev->string (with writing (put-toplevel c forms (with writing (put-module-impls c (with writing (put-tops (with emitter (with-locals c (list "%toplevel"))) forms (with writing (put-shapes c forms #t (put header nil)))))))))))))

(define compile (subr kfx (string) string)
  (lambda (src)
    "A KFX-0 program of one file, as one file of Rust."
    (compile-named "the program" src nil #f)))

"Programs of several files. A program is files in order, as a manifest
 (NAME.unit) lists them: to FX-26, the files one after another, so that a
 definition sees those in the files before it. To Rust, a module each,
 which imports every other's names (`use super::*`) and kayak-rt's; the
 modules' `mod.rs` declares them and re-exports their names."

"A file's name, without `.kfx`, and its text; a Rust file's name, and its
 text."

(define source-forms (subr kfx (source) sexps)
  (lambda (s)
    "A file's forms, the modules made in place defined before theirs (C90)."
    (tagcase s (source (name text) (with-loads (read-all text (string-append name ".kfx") 1) (string-append name ".kfx") nil)))))

(define module-header string
  "// Generated by kfx from KFX-0 source: edit that, and regenerate (PLAN.md, section 1).\n\nuse kayak_rt::*;\nuse super::*;\n\n")

(define put-mods (subr kfx (sources chars) chars)
  (lambda (ss acc)
    (if (null? ss)
        acc
        (tagcase (car ss)
          (source (name text)
            (let* ((m (mangle name))
                   (acc (put "pub mod " acc))
                   (acc (put m acc))
                   (acc (put ";\npub use " acc))
                   (acc (put m acc)))
              (put-mods (cdr ss) (put "::*;\n" acc))))))))

"Each file's forms, read once (C364): each was read again for its module's
 Rust, and with memos for its forms' texts too."
(define-type sources-forms (listof (listof sexp acyclic) acyclic))

(define-rec
  (modules-put (subr kfx (ctx sources sources-forms) outputs)
    (lambda (c ss fss)
      "Each file's module, its forms `fss`'s."
      (if (null? ss)
          nil
          (tagcase (car ss)
            (source (name text)
              (cons (output (string-append (mangle name) ".rs")
                            (rev->string (with writing (put-tops c (car fss) (put module-header nil)))))
                    (modules-put c (cdr ss) (cdr fss)))))))))

(define compile-units-as (subr kfx (sources bool bool) outputs)
  (lambda (ss runtime async)
    "A program of several files, as Rust: its modules, then their `mod.rs`.
     The whole program is checked, and each file written as a module. A
     `runtime`'s own may declare syscalls (C225: its manifest says
     `--syscalls`). `async`: every procedure an `async fn` (C371)."
    (let* ((fss (map source-forms ss))
           (forms (concat fss))
           (checked (restrict-checked (check-program-as forms runtime) forms))
           (fs (moded-facts (verdict-facts checked) async))
           (c (with emitter (collect forms (ctx nil nil nil nil (verdict-typeds checked) fs (fidx-of fs) nil nil nil))))
           (modules (modules-put c ss fss)))
      (onto modules
            (list (output "mod.rs"
                          (rev->string
                            (with writing (put-module-impls c (with writing (put-shapes c forms #f
                                        (put-mods ss (put "// Generated by kfx: the program's modules (PLAN.md, section 1).\n\n" nil)))))))))))))

(define compile-units (subr kfx (sources) outputs) (lambda (ss) (compile-units-as ss #f #f)))

"A program of several files, as `compile-units`, with memos (incr.kfx,
 C54): those given are taken where they fit, and those this compile made
 or took are given back, for the next."
(define-datatype compiled (compiled outputs memos))

(define-rec
  (memo-modules (subr kfx (ctx facts i64 memos sources sources-forms outputs memos) compiled)
    (lambda (c fs global old ss fss outs made)
      (if (null? ss)
          (compiled (reverse-outputs outs nil) made)
          (tagcase (car ss)
            (source (name text)
              (let* ((file (string-append name ".kfx"))
                     (forms (car fss))
                     (starts (map (lambda ((f sexp)) (datum-pos f)) forms))
                     (texts (with incremental (form-texts text (string-length-i64 text) starts))))
                (tagcase (with incremental (put-tops-memo c (with incremental (facts-of-file fs file)) global old forms texts starts (put module-header nil) made))
                  (emitted (acc made2)
                    (memo-modules c fs global old (cdr ss) (cdr fss)
                                  (cons (output (string-append (mangle name) ".rs") (rev->string acc)) outs)
                                  made2)))))))))
  (reverse-outputs (subr kfx (outputs outputs) outputs)
    (lambda (xs acc) (if (null? xs) acc (reverse-outputs (cdr xs) (cons (car xs) acc))))))

(define-rec
  (sources-texts (subr kfx (sources sources-forms) strings)
    (lambda (ss fss)
      "Each of the files' forms' text, in order (incr.kfx)."
      (if (null? ss)
          nil
          (tagcase (car ss)
            (source (name text)
              (onto (with incremental (form-texts text (string-length-i64 text) (map (lambda ((f sexp)) (datum-pos f)) (car fss))))
                    (sources-texts (cdr ss) (cdr fss)))))))))

(define compile-units-memo (subr kfx (sources memos bool) compiled)
  (lambda (ss old runtime)
    (let* ((fss (map source-forms ss))
           (forms (concat fss))
           (texts (sources-texts ss fss)))
      (tagcase (let ((c (with incremental (check-program-memo forms texts old runtime)))) (begin (with restrictions (restrict forms (tagcase c (checked-memo (done found checks) (cv-facts done))))) c))
        (checked-memo (done found checks)
          (let ((c (with emitter (collect forms (ctx nil nil nil nil found (cv-facts done) (fidx-of (cv-facts done)) nil nil nil)))))
            (tagcase (memo-modules c (cv-facts done) (with incremental (ctx-fingerprint c)) old ss fss nil checks)
              (compiled (modules made)
                (compiled (onto modules
                                (list (output "mod.rs"
                                              (rev->string
                                                (with writing (put-module-impls c (with writing (put-shapes c forms #f
                                                            (put-mods ss (put "// Generated by kfx: the program's modules (PLAN.md, section 1).\n\n" nil))))))))))
                          made)))))))))

(define bundle (subr kfx (outputs) string)
  (lambda (os)
    "Outputs as one string, for stage 0, where Fixpt prints one: each a line
     `@@kfx-file NAME`, then its text. No line of generated Rust starts with
     `@@`, since its string literals hold no newline but escaped."
    (if (null? os)
        ""
        (tagcase (car os)
          (output (name text)
            (string-append "@@kfx-file " (string-append name (string-append "\n" (string-append text (bundle (cdr os)))))))))))
