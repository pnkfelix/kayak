"compile.kfx: the compiler's entry points, for a program of one file and
 for one of several."

(define header string
  "// Generated by kfx from KFX-0 source: edit that, and regenerate (PLAN.md, section 1).\n\nuse kayak_rt::*;\n\n")

(define compile-named (subr kfx (string string) string)
  (lambda (file src)
    "The same, its messages naming `file`."
    (let* ((forms (read-all (string-chars src) file 1))
           (checked (check-program forms))
           (c (collect forms (ctx nil nil nil nil))))
      (rev->string (put-tops c forms (put header nil))))))

(define compile (subr kfx (string) string)
  (lambda (src)
    "A KFX-0 program of one file, as one file of Rust."
    (compile-named "the program" src)))

"Programs of several files. A program is files in order, as a manifest
 (NAME.unit) lists them: to FX-26, the files one after another, so that a
 definition sees those in the files before it. To Rust, a module each,
 which imports every other's names (`use super::*`) and kayak-rt's; the
 modules' `mod.rs` declares them and re-exports their names."

"A file's name, without `.kfx`, and its text; a Rust file's name, and its
 text."
(define-datatype source (source string string))
(define-datatype output (output string string))
(define-type sources (listof source acyclic))
(define-type outputs (listof output acyclic))

(define source-forms (subr kfx (source) sexps)
  (lambda (s) (tagcase s (source (name text) (read-all (string-chars text) (string-append name ".kfx") 1)))))

(define module-header string
  "// Generated by kfx from KFX-0 source: edit that, and regenerate (PLAN.md, section 1).\n\nuse kayak_rt::*;\nuse super::*;\n\n")

(define put-mods (subr kfx (sources chars) chars)
  (lambda (ss acc)
    (if (null? ss)
        acc
        (tagcase (car ss)
          (source (name text)
            (let* ((m (mangle name))
                   (acc (put "pub mod " acc))
                   (acc (put m acc))
                   (acc (put ";\npub use " acc))
                   (acc (put m acc)))
              (put-mods (cdr ss) (put "::*;\n" acc))))))))

(define compile-units (subr kfx (sources) outputs)
  (lambda (ss)
    "A program of several files, as Rust: its modules, then their `mod.rs`.
     The whole program is checked, and each file written as a module."
    (let* ((forms (concat (map (lambda ((s source)) (source-forms s)) ss)))
           (checked (check-program forms))
           (c (collect forms (ctx nil nil nil nil)))
           (modules (map (lambda ((s source))
                           (tagcase s
                             (source (name text)
                               (output (string-append (mangle name) ".rs")
                                       (rev->string (put-tops c (source-forms s) (put module-header nil)))))))
                         ss)))
      (onto modules
            (list (output "mod.rs"
                          (rev->string
                            (put-mods ss (put "// Generated by kfx: the program's modules (PLAN.md, section 1).\n\n" nil)))))))))

(define bundle (subr kfx (outputs) string)
  (lambda (os)
    "Outputs as one string, for stage 0, where Fixpt prints one: each a line
     `@@kfx-file NAME`, then its text. No line of generated Rust starts with
     `@@`, since its string literals hold no newline but escaped."
    (if (null? os)
        ""
        (tagcase (car os)
          (output (name text)
            (string-append "@@kfx-file " (string-append name (string-append "\n" (string-append text (bundle (cdr os)))))))))))
