"compile.kfx: the compiler's entry points, for a program of one file and
 for one of several."

(define header string
  "// Generated by kfx from KFX-0 source: edit that, and regenerate (PLAN.md, section 1).\n\nuse kayak_rt::*;\n\n")

(define-datatype source (source string string))
(define-datatype output (output string string))
(define-type sources (listof source acyclic))
(define-type outputs (listof output acyclic))

(define restrict-checked (subr kfx (verdict sexps) verdict)
  (lambda (checked forms)
    "A program checked, then KFX's restrictions (restrict.kfx, C60)."
    (begin (with restrictions (restrict forms)) checked)))

(define compile-named (subr kfx (string string fileds) string)
  (lambda (file src loaded)
    "The same, its messages naming `file`; the files it loads, `loaded`."
    (let* ((forms (with-loads (read-all (string-chars src) file 1) file loaded))
           (checked (restrict-checked (check-program forms) forms))
           (c (collect forms (ctx nil nil nil nil (verdict-typeds checked) (verdict-facts checked) nil nil nil))))
      (rev->string (put-module-impls c (put-tops c forms (put-shapes c forms #f (put header nil))))))))

(define compile-toplevel (subr kfx (string string fileds) string)
  (lambda (file src loaded)
    "A program of one file, as Rust, with its top-level expressions as
     `kfx_toplevel`, which writes their values (emit.kfx)."
    (let* ((forms (with-loads (read-all (string-chars src) file 1) file loaded))
           (checked (restrict-checked (check-program forms) forms))
           (c (collect forms (ctx nil nil nil nil (verdict-typeds checked) (verdict-facts checked) nil nil nil))))
      (rev->string (put-toplevel c forms (put-module-impls c (put-tops (with-locals c (list "%toplevel")) forms (put-shapes c forms #t (put header nil)))))))))

(define compile (subr kfx (string) string)
  (lambda (src)
    "A KFX-0 program of one file, as one file of Rust."
    (compile-named "the program" src nil)))

"Programs of several files. A program is files in order, as a manifest
 (NAME.unit) lists them: to FX-26, the files one after another, so that a
 definition sees those in the files before it. To Rust, a module each,
 which imports every other's names (`use super::*`) and kayak-rt's; the
 modules' `mod.rs` declares them and re-exports their names."

"A file's name, without `.kfx`, and its text; a Rust file's name, and its
 text."

(define source-forms (subr kfx (source) sexps)
  (lambda (s)
    "A file's forms, the modules made in place defined before theirs (C90)."
    (tagcase s (source (name text) (with-loads (read-all (string-chars text) (string-append name ".kfx") 1) (string-append name ".kfx") nil)))))

(define module-header string
  "// Generated by kfx from KFX-0 source: edit that, and regenerate (PLAN.md, section 1).\n\nuse kayak_rt::*;\nuse super::*;\n\n")

(define put-mods (subr kfx (sources chars) chars)
  (lambda (ss acc)
    (if (null? ss)
        acc
        (tagcase (car ss)
          (source (name text)
            (let* ((m (mangle name))
                   (acc (put "pub mod " acc))
                   (acc (put m acc))
                   (acc (put ";\npub use " acc))
                   (acc (put m acc)))
              (put-mods (cdr ss) (put "::*;\n" acc))))))))

(define compile-units (subr kfx (sources) outputs)
  (lambda (ss)
    "A program of several files, as Rust: its modules, then their `mod.rs`.
     The whole program is checked, and each file written as a module."
    (let* ((forms (concat (map (lambda ((s source)) (source-forms s)) ss)))
           (checked (restrict-checked (check-program forms) forms))
           (c (collect forms (ctx nil nil nil nil (verdict-typeds checked) (verdict-facts checked) nil nil nil)))
           (modules (map (lambda ((s source))
                           (tagcase s
                             (source (name text)
                               (output (string-append (mangle name) ".rs")
                                       (rev->string (put-tops c (source-forms s) (put module-header nil)))))))
                         ss)))
      (onto modules
            (list (output "mod.rs"
                          (rev->string
                            (put-module-impls c (put-shapes c forms #f
                                        (put-mods ss (put "// Generated by kfx: the program's modules (PLAN.md, section 1).\n\n" nil)))))))))))

"A program of several files, as `compile-units`, with memos (incr.kfx,
 C54): those given are taken where they fit, and those this compile made
 or took are given back, for the next."
(define-datatype compiled (compiled outputs memos))

(define-rec
  (memo-modules (subr kfx (ctx facts i64 memos sources outputs memos) compiled)
    (lambda (c fs global old ss outs made)
      (if (null? ss)
          (compiled (reverse-outputs outs nil) made)
          (tagcase (car ss)
            (source (name text)
              (let* ((file (string-append name ".kfx"))
                     (forms (source-forms (car ss)))
                     (starts (map (lambda ((f sexp)) (datum-pos f)) forms))
                     (texts (form-texts (string-chars text) 0 starts)))
                (tagcase (put-tops-memo c (facts-of-file fs file) global old forms texts starts (put module-header nil) made)
                  (emitted (acc made2)
                    (memo-modules c fs global old (cdr ss)
                                  (cons (output (string-append (mangle name) ".rs") (rev->string acc)) outs)
                                  made2)))))))))
  (reverse-outputs (subr kfx (outputs outputs) outputs)
    (lambda (xs acc) (if (null? xs) acc (reverse-outputs (cdr xs) (cons (car xs) acc))))))

(define source-texts (subr kfx (source) strings)
  (lambda (s)
    "Each of a file's forms' text (incr.kfx)."
    (tagcase s
      (source (name text) (form-texts (string-chars text) 0 (map (lambda ((f sexp)) (datum-pos f)) (source-forms s)))))))

(define compile-units-memo (subr kfx (sources memos) compiled)
  (lambda (ss old)
    (let* ((forms (concat (map (lambda ((s source)) (source-forms s)) ss)))
           (texts (concat (map source-texts ss))))
      (tagcase (let ((c (check-program-memo forms texts old))) (begin (with restrictions (restrict forms)) c))
        (checked-memo (done found checks)
          (let ((c (collect forms (ctx nil nil nil nil found (cv-facts done) nil nil nil))))
            (tagcase (memo-modules c (cv-facts done) (ctx-fingerprint c) old ss nil checks)
              (compiled (modules made)
                (compiled (onto modules
                                (list (output "mod.rs"
                                              (rev->string
                                                (put-module-impls c (put-shapes c forms #f
                                                            (put-mods ss (put "// Generated by kfx: the program's modules (PLAN.md, section 1).\n\n" nil))))))))
                          made)))))))))

(define bundle (subr kfx (outputs) string)
  (lambda (os)
    "Outputs as one string, for stage 0, where Fixpt prints one: each a line
     `@@kfx-file NAME`, then its text. No line of generated Rust starts with
     `@@`, since its string literals hold no newline but escaped."
    (if (null? os)
        ""
        (tagcase (car os)
          (output (name text)
            (string-append "@@kfx-file " (string-append name (string-append "\n" (string-append text (bundle (cdr os)))))))))))
