"base.kfx: what the compiler's other files use, first of them all.

 The compiler is the files kfx/kfx.unit lists, in order (PLAN.md,
 section 1): to FX-26, one program, each file seeing those before it; to
 Rust, a module each. Fixpt runs them, after kfx/prelude.fx, to make
 boot/src/kfx/ (stage 0); the Rust built from that runs them again, and
 must make the same files.

 `compile` (compile.kfx) takes a program's text and gives its Rust: it
 reads the text into `sexp`s (read.kfx), checks it (check.kfx), and
 writes Rust (emit.kfx) onto a list of characters, newest first, which is
 reversed once at the end."

(define-effect kfx (maxeff (read @globals) spin))

(define-type chars (listof char acyclic))
(define-type strings (listof string acyclic))

"Lists, of anything"

(define map (poly ((a type) (b type))
              (subr kfx ((subr kfx (a) b) (listof a acyclic)) (listof b acyclic)))
  (lambda (f xs) (if (null? xs) nil (cons (f (car xs)) (map f (cdr xs))))))

(define any? (poly ((a type)) (subr kfx ((subr kfx (a) bool) (listof a acyclic)) bool))
  (lambda (p xs) (and (not (null? xs)) (or (p (car xs)) (any? p (cdr xs))))))

(define filter (poly ((a type)) (subr kfx ((subr kfx (a) bool) (listof a acyclic)) (listof a acyclic)))
  (lambda (p xs) (cond ((null? xs) nil) ((p (car xs)) (cons (car xs) (filter p (cdr xs)))) (else (filter p (cdr xs))))))

(define map2 (poly ((a type) (b type) (c type))
               (subr kfx ((subr kfx (a b) c) (listof a acyclic) (listof b acyclic)) (listof c acyclic)))
  (lambda (f xs ys) (if (or (null? xs) (null? ys)) nil (cons (f (car xs) (car ys)) (map2 f (cdr xs) (cdr ys))))))

(define size-from (poly ((a type)) (subr kfx ((listof a acyclic) i64) i64))
  (lambda (xs n) (if (null? xs) n (size-from (cdr xs) (i64+ n 1)))))

(define size (poly ((a type)) (subr kfx ((listof a acyclic)) i64))
  (lambda (xs) (size-from xs 0)))

(define last (poly ((a type)) (subr kfx ((listof a acyclic)) a))
  (lambda (xs) (if (null? (cdr xs)) (car xs) (last (cdr xs)))))

(define onto (poly ((a type)) (subr kfx ((listof a acyclic) (listof a acyclic)) (listof a acyclic)))
  (lambda (xs ys) (if (null? xs) ys (cons (car xs) (onto (cdr xs) ys)))))

(define concat (poly ((a type)) (subr kfx ((listof (listof a acyclic) acyclic)) (listof a acyclic)))
  (lambda (xss) (if (null? xss) nil (onto (car xss) (concat (cdr xss))))))

"Characters and strings"

(define rev-onto (subr kfx (chars chars) chars)
  (lambda (xs acc)
    (if (null? xs) acc (rev-onto (cdr xs) (cons (car xs) acc)))))

(define rev->string (subr kfx (chars) string)
  (lambda (acc) (list->string (rev-onto acc nil))))

(define string-chars (subr kfx (string) chars)
  (lambda (s)
    "A string's characters, in one pass: indexing a string that is not
     ASCII counts characters from its start (CLAUDES_CHOICES.md, C14)."
    (string->list s)))

"Strings `xs` joined, in order (C261): adjacent ones appended pairwise,
 again and again, each round halving the list, so each character is
 copied once a round, some log2(n) times; where appending each onto the
 rest copies the rest again for each, n times. FX-26 has it as
 `(apply string-append xs)`, which KFX has not (C71); in KFX, so that it
 is the same on every engine."
(define-rec
  (string-pairs (subr kfx (strings) strings)
    (lambda (xs)
      (cond ((or (null? xs) (null? (cdr xs))) xs)
            (else (cons (string-append (car xs) (car (cdr xs))) (string-pairs (cdr (cdr xs)))))))))
(define-rec
  (string-list-append (subr kfx (strings) string)
    (lambda (xs) (cond ((null? xs) "") ((null? (cdr xs)) (car xs)) (else (string-list-append (string-pairs xs)))))))

(define put-from (subr kfx (string i64 i64 chars) chars)
  (lambda (s i n acc)
    (if (i64< i n) (put-from s (i64+ i 1) n (cons (string-ref-i64 s i) acc)) acc)))

(define put (subr kfx (string chars) chars)
  (lambda (s acc)
    "Adds `s` to the output `acc`."
    (put-from s 0 (string-length-i64 s) acc)))

(define put-sep (poly ((a type))
                  (subr kfx ((subr kfx (a chars) chars) string (listof a acyclic) chars) chars))
  (lambda (each sep xs acc)
    "Each of `xs` added to `acc` by `each`, separated by `sep`."
    (cond ((null? xs) acc)
          ((null? (cdr xs)) (each (car xs) acc))
          (else (put-sep each sep (cdr xs) (put sep (each (car xs) acc)))))))

(define string-member? (subr kfx (string strings) bool)
  (lambda (s xs)
    (if (null? xs) #f (or (string=? s (car xs)) (string-member? s (cdr xs))))))

(define-rec
  (counting (subr kfx (i64 i64) (listof i64 acyclic))
    (lambda (from n)
      "`from`, `from` + 1, ..., to before `n` (C91: from terminate.kfx, which
       the emitter used too, now a module of its own)."
      (if (i64< from n) (cons from (counting (i64+ from 1) n)) nil))))

"A set of names, a balanced tree (C92): a membership test in a few
 comparisons, where a list of hundreds took as many."
(define-datatype nset (nempty) (nnode nset string nset))

(define-rec
  (merged-strings (subr kfx ((listof string acyclic) (listof string acyclic)) (listof string acyclic))
    (lambda (a b)
      (cond ((null? a) b)
            ((null? b) a)
            ((string<? (car b) (car a)) (cons (car b) (merged-strings a (cdr b))))
            (else (cons (car a) (merged-strings (cdr a) b))))))
  (sorted-strings (subr kfx ((listof string acyclic)) (listof string acyclic))
    (lambda (xs)
      (if (or (null? xs) (null? (cdr xs)))
          xs
          (merged-strings (sorted-strings (halves xs #t)) (sorted-strings (halves xs #f))))))
  (halves (subr kfx ((listof string acyclic) bool) (listof string acyclic))
    (lambda (xs first)
      "Every other element, the first's or the second's."
      (cond ((null? xs) nil)
            (first (cons (car xs) (halves (cdr xs) #f)))
            (else (halves (cdr xs) #t))))))

(define-rec
  (taken (subr kfx ((listof string acyclic) i64) (listof string acyclic))
    (lambda (xs n) (if (or (null? xs) (i64<= n 0)) nil (cons (car xs) (taken (cdr xs) (i64- n 1))))))
  (dropped (subr kfx ((listof string acyclic) i64) (listof string acyclic))
    (lambda (xs n) (if (or (null? xs) (i64<= n 0)) xs (dropped (cdr xs) (i64- n 1)))))
  (tree-of (subr kfx ((listof string acyclic) i64) nset)
    (lambda (xs n)
      "The first `n` of `xs`, sorted, as a balanced tree."
      (if (i64<= n 0)
          (nempty)
          (let* ((half (i64-quotient n 2))
                 (rest (dropped xs half)))
            (nnode (tree-of xs half) (car rest) (tree-of (cdr rest) (i64- (i64- n half) 1))))))))

(define nset-of (subr kfx ((listof string acyclic)) nset)
  (lambda (xs) (let ((sorted (sorted-strings xs))) (tree-of sorted (size sorted)))))

(define-rec
  (in-nset? (subr kfx (string nset) bool)
    (lambda (x s)
      (tagcase s
        (nempty () #f)
        (nnode (l k r) (cond ((string=? x k) #t) ((string<? x k) (in-nset? x l)) (else (in-nset? x r))))))))
