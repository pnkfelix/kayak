"restrict.kfx: KFX's restrictions, a pass after checking (C60;
 docs/research/front-end.md). The checker says what FX-26 says; this pass
 refuses, for Rust, what has no Rust that means the same. kfx runs it
 after the checker, the engine (fx26/) does not: one checker, and KFX
 the programs that pass both.

 First: FX-26's composable continuations (C60), which may be resumed again and
 again, where a Rust future resumes once (C45). Their place, until the
 checker gives facts about them, is in the program's text: the primitive
 named, the type written, a control primitive given to `proj`."

"KFX's restrictions are a module (C92): its helpers hidden, the pass,
 `restrict`, what it gives."
(define restrictions
  (module
    (hide
      (define control-primitive? (subr kfx (string) bool)
        (lambda (n)
          (string-member? n (list "call-with-composable-continuation" "call-with-current-continuation" "call/cc"
                                  "abort-current-continuation" "make-continuation-prompt-tag" "escape"))))

      (define-rec
        (projected-control (subr kfx (sexp) string)
          (lambda (e)
            "The control primitive a chain of `proj`s instantiates, or none."
            (cond ((head-is? e "proj") (projected-control (second (items e))))
                  (else (tagcase e (sym (n f p) (if (control-primitive? n) n "")) (else other "")))))))

      (define restriction-refused (subr kfx (string i64 string) void)
        (lambda (file line message)
          (error (string-append "kfx: " (string-append file (string-append ":" (string-append (i64->string line)
                   (string-append ": " message))))))))

      (define items-of (subr kfx (sexp) sexps) (lambda (e) (tagcase e (lst (ys f l p) ys) (else other nil))))
      (define cdr-items-of (subr kfx (sexp) sexps) (lambda (e) (tagcase e (lst (ys f l p) (if (null? ys) nil (cdr ys))) (else other nil))))

      (define-rec
        (restricted (subr kfx (sexp string i64) unit)
          (lambda (e file line)
            "`e`, whose nearest list began at `line` of `file`: refused if it is
             what KFX does not have, else each of its parts."
            (tagcase e
              (sym (n f p)
                (cond ((or (string=? n "call-with-composable-continuation") (string=? n "call-with-current-continuation") (string=? n "call/cc") (string=? n "cwcc"))
                       (restriction-refused file line (string-append n " keeps a continuation FX-26 may resume again and again, and a Rust future once: KFX's is abort-with-continuation's (C45)")))
                      ((string-member? n (list "current-marks" "marks-of"))
                       (restriction-refused file line (string-append n ", which KFX has not yet: its marks' list would tell a with-mark in tail position from one that is not (C106)")))
                      ((string=? n "list")
                       (restriction-refused file line "list as a value, FX-26's variadic procedure, which KFX has not yet: a Rust fn has its arity (C71)"))
                      ((string-member? n (list "call-with-oneshot-continuation" "rmake-array" "datum-int?" "oneshot" "assume" "assert"
                                              "char-in?" "nat?" "certify-nat" "rmake-icell" "pair-identity" "make-flatarray" "flatarray-ref" "flatarray-set!" "flatarray-length" "flatlayout"
                                              "i32-flat" "u32-flat" "i64-flat" "u64-flat" "f32-flat" "f64-flat" "narrayof"))
                       (restriction-refused file line (string-append n ", FX-26's, which KFX has not yet (C156)")))
                      ((string-member? n (list "no-pair" "eq?" "set-car!" "set-cdr!" "stay-cellular"))
                       (restriction-refused file line (string-append n ", which KFX has not: it tells apart, or writes through, what a union's value in Rust (C75) would copy")))
                      (else #u)))
              (lst (xs f l p)
                (cond ((null? xs) #u)
                      ((sym-is? (car xs) "list") (restricted-all (cdr xs) f l))
                      ((and (or (sym-is? (car xs) "poly") (sym-is? (car xs) "plambda")) (i64>= (size xs) 2)
                            (tagcase (second xs)
                              (lst (bs f2 l2 p2) (any? (lambda ((b sexp)) (tagcase b (lst (ys f3 l3 p3) (and (i64= (size ys) 2) (sym-is? (second ys) "conv"))) (else other #f))) bs))
                              (else other #f)))
                       (restriction-refused f l "a convention binder, FX-26's, which KFX has not (C205)"))
                      ((and (i64= (size xs) 3) (sym-is? (second xs) "region") (sym-is? (third xs) "distinct"))
                       (restriction-refused f l "a distinct region binder, FX-26's, which KFX has not yet (C204)"))
                      ((and (sym-is? (car xs) "bloblet") (any? (lambda ((a sexp)) (head-is? a "frozen")) (cdr xs)))
                       (restriction-refused f l "a frozen bloblet, FX-26's, which KFX has not yet (C201)"))
                      ((and (tagcase (car xs) (sym (h f2 p2) (string-member? h (list "listof" "ref" "pairof" "arrayof" "bytevectorof" "blobref" "bloblet" "icell" "addr" "inbox" "read" "write" "alloc" "init"))) (else other #f))
                            (any? (lambda ((a sexp)) (and (or (head-is? a "const") (head-is? a "acyclic")) (not (sym-is? (second (items a)) "heap")))) (cdr xs)))
                       (restriction-refused f l "data frozen into a place but the heap, FX-26's, which KFX has not yet (C161, C193)"))
                      ((and (tagcase (car xs) (sym (h f2 p2) (string-member? h (list "listof" "ref" "pairof" "arrayof" "bytevectorof" "blobref" "bloblet" "icell" "addr" "inbox" "read" "write" "alloc" "init"))) (else other #f))
                            (any? (lambda ((a sexp)) (sym-is? a "heap")) (cdr xs)))
                       (restriction-refused f l "the heap's region written `heap`, FX-26's, which KFX writes `@heap` (C171)"))
                      ((or (sym-is? (car xs) "confirm-nat") (sym-is? (car xs) "confirm-length")
                           (and (sym-is? (car xs) "acyclic") (i64= (size xs) 4)))
                       (restriction-refused f l (string-append (sym-name (car xs)) ", FX-26's, which KFX has not yet (C159)")))
                      ((or (sym-is? (car xs) "nlist") (and (sym-is? (car xs) "nat") (i64= (size xs) 2))
                           (and (sym-is? (car xs) "poly") (not (null? (cdr xs)))
                                (tagcase (second xs)
                                  (lst (bs f2 l2 p2) (any? (lambda ((b sexp)) (tagcase b (lst (ys f3 l3 p3) (and (i64= (size ys) 2) (sym-is? (second ys) "size"))) (else other #f))) bs))
                                  (else other #f))))
                       (restriction-refused f l "sizes (nlist, (nat s), a size binder), FX-26's, which KFX has not yet (C158)"))
                      ((or (sym-is? (car xs) "vsubr") (sym-is? (car xs) "vlambda") (sym-is? (car xs) "apply"))
                       (restriction-refused f l (string-append (sym-name (car xs)) ", FX-26's variadic procedures, which KFX has not yet: a Rust fn has its arity (C71)")))
                      ((and (sym-is? (car xs) "arrayof") (i64= (size xs) 3) (or (sym-is? (third xs) "finite") (head-is? (third xs) "+") (head-is? (third xs) "-")))
                       (restriction-refused f l "a flat array of a length not literal, FX-26's, which KFX has not yet (C175)"))
                      ((let ((binders (cond ((and (or (sym-is? (car xs) "poly") (sym-is? (car xs) "plambda")) (i64> (size xs) 1)) (items-of (second xs)))
                                            ((and (or (sym-is? (car xs) "define-type") (sym-is? (car xs) "define-generative")) (i64> (size xs) 1)) (cdr-items-of (second xs)))
                                            (else nil))))
                         (any? (lambda ((b sexp)) (tagcase b
                                                    (lst (ys f2 l2 p2) (and (i64= (size ys) 2) (tagcase (second ys) (sym (k f3 p3) (string-member? k (list "data" "sendable" "flat" "conv"))) (else other #f))))
                                                    (else other #f)))
                               binders))
                       (restriction-refused f l "a binder of the kind data, sendable, flat or conv, FX-26's, which KFX's Rust generics have not (C186)"))
                      ((and (sym-is? (car xs) "define-generative") (i64> (size xs) 1)
                            (any? (lambda ((b sexp)) (tagcase b (lst (ys f2 l2 p2) (i64= (size ys) 3)) (else other #f))) (cdr-items-of (second xs))))
                       (restriction-refused f l "a variance mark, FX-26's, which KFX does not have (its families are invariant; C188)"))
                      ((and (sym-is? (car xs) "proves") (i64= (size xs) 2))
                       (restriction-refused f l "a lemma, `proves`, FX-26's, which KFX has not: its Rust's types have no subtyping to prove (C185)"))
                      ((and (sym-is? (car xs) "flatarrayof") (i64= (size xs) 3) (not (sym-is? (second xs) "i64")))
                       (restriction-refused f l "a flat array of other than i64, FX-26's, which KFX has not yet (C175)"))
                      ((or (sym-is? (car xs) "=>") (sym-is? (car xs) "dlambda"))
                       (restriction-refused f l (string-append (sym-name (car xs)) ", FX-26's higher kinds, which KFX has not yet: its Rust's generics are over types (C173)")))
                      ((sym-is? (car xs) "composable")
                       (restriction-refused f l "a composable continuation, which FX-26 may resume again and again, and a Rust future once: KFX's is abort-with-continuation's (C45)"))
                      ((and (sym-is? (car xs) "poly") (i64= (size xs) 3) (head-is? (third xs) "poly"))
                       (restriction-refused f l "a poly in a poly, which KFX's Rust writes as one: write it so (C70)"))
                      ((and (head-is? (car xs) "proj")
                            (string-member? (projected-control (car xs)) (list "abort-current-continuation" "escape" "make-continuation-prompt-tag")))
                       "An abort or an escape through `proj`s, called: the emitter writes
                        it as the primitive's call (C105)."
                       (restricted-all (cdr xs) f l))
                      ((and (sym-is? (car xs) "proj") (not (null? (cdr xs)))
                            (tagcase (second xs) (sym (n f2 p2) (control-primitive? n)) (else other #f)))
                       (restriction-refused f l (string-append "a proj of " (string-append (sym-name (second xs)) ", a control primitive KFX types by its own rule"))))
                      (else (restricted-all xs f l))))
              (real (t f p)
                (if (written-out-real? t)
                    #u
                    (restriction-refused file line (string-append "a number with an exponent, or its point first, which KFX reads not: write it out, " t))))
              (else other #u))))
        (restricted-all (subr kfx (sexps string i64) unit)
          (lambda (es file line) (if (null? es) #u (begin (restricted (car es) file line) (restricted-all (cdr es) file line))))))

      (define place-family? (subr kfx (sexp) bool)
        (lambda (head)
          "Whether a type's head names a family of places alone, `(name (p
           place) ...)` (C274)."
          (tagcase head
            (lst (xs f l p)
              (and (not (null? (cdr xs)))
                   (not (any? (lambda ((b sexp)) (not (and (i64= (size (items b)) 2) (sym-is? (second (items b)) "place")))) (cdr xs)))))
            (else other #f))))

      (define-rec
        (moduleof-restricted (subr kfx (sexp) unit)
          (lambda (e)
            "A module type other than a `define-type`'s, FX-26's first-class
             modules' (C170), which KFX has not: its module types are Rust
             traits, named (C24)."
            (tagcase e
              (lst (xs f l p)
                (cond ((null? xs) #u)
                      ((and (sym-is? (car xs) "define-type") (i64= (size xs) 3) (head-is? (third xs) "moduleof")
                            (not (and (trait-moduleof? (third xs)) (tagcase (second xs) (sym (n f2 p2) #t) (else other #f))))
                            ;; A module maker's interface, over places (C274): in
                            ;; Rust the maker's struct, no trait.
                            (not (place-family? (second xs))))
                       (restriction-refused f l "a module type KFX has not as a Rust trait: of an effect's description, or with parameters, FX-26's (C24, C170)"))
                      ((and (sym-is? (car xs) "define-type") (i64= (size xs) 3) (head-is? (third xs) "moduleof"))
                       (begin (map moduleof-restricted (cdr (items (third xs)))) #u))
                      ((sym-is? (car xs) "moduleof")
                       (restriction-refused f l "a module type not named by a define-type, FX-26's first-class modules', which KFX has not yet (C24, C170)"))
                      ((sym-is? (car xs) "quote") #u)
                      (else (begin (map moduleof-restricted xs) #u))))
              (else other #u)))))

      (define param-named? (subr kfx (sexp strings) bool)
        (lambda (q types)
          "Whether a procedure type's parameter is named, `(x : T)`, as the
           checker reads one (`param-name-written`)."
          (tagcase q
            (lst (ys f l p)
              (and (i64= (size ys) 3) (tagcase (car ys) (sym (n f2 p2) #t) (else other #f)) (sym-is? (second ys) ":")))
            (else other #f))))

      (define-rec
        (specs-restricted (subr kfx (sexp strings) unit)
          (lambda (e types)
            "A procedure type's specification, or its parameters named
             (C162), FX-26's, which KFX has not yet."
            (tagcase e
              (lst (xs f l p)
                (cond ((null? xs) #u)
                      ((and (or (sym-is? (car xs) "subr") (sym-is? (car xs) "->")) (i64> (size xs) 2)
                            (or (spec-clause? (last xs)) (latent-result? (last xs))
                                (tagcase (cond ((sym-is? (car xs) "->") (second xs)) ((head-is? (second xs) "conv") (fourth xs)) (else (third xs)))
                                  (lst (ps f2 l2 p2) (any? (lambda ((q sexp)) (param-named? q types)) ps))
                                  (else other #f))))
                       (restriction-refused f l "a procedure type's specification, or its parameters named, FX-26's, which KFX has not yet (C162)"))
                      (else (begin (map (lambda ((x sexp)) (specs-restricted x types)) xs) #u))))
              (else other #u)))))

      "Names (C61): KFX defines each name once, none a primitive's or
       kayak-rt's, since the generated modules each import every other's names
       and kayak-rt's; and its types' and modules' names are Rust's too, none
       Rust's or kayak-rt's own, each a KFX name (C27), none two alike
       camel-cased. FX-26 has neither rule."

      (define primitive-names (subr kfx () strings)
        (lambda ()
          (map (lambda ((p sexp)) (sym-name (car (items p))))
               (onto (read-all (string-chars primitives) "" 1) (read-all (string-chars prelude) "" 1)))))

      (define-rec
        (defined-names (subr kfx (sexps) (listof sexp acyclic))
          (lambda (forms)
            "Each definition among `forms`, as the list that says where it is: a
             `define`, or a `define-rec`'s item; a module's items' are its own
             scope's."
            (if (null? forms)
                nil
                (let ((f (car forms)))
                  (onto (cond ((or (head-is? f "define") (head-is? f "define*"))
                               (tagcase (second (items f)) (sym (n fl p) (the sexps (list f))) (else other nil)))
                              ((head-is? f "define-rec") (cdr (items f)))
                              (else nil))
                        (defined-names (cdr forms))))))))

      (define line-of (subr kfx (sexp) i64)
        (lambda (e) (tagcase e (lst (xs f l p) l) (else other 0))))

      (define-rec
        (names-once (subr kfx (sexps strings strings) unit)
          (lambda (names seen prims)
            (if (null? names)
                #u
                (let* ((d (car names))
                       (n (if (or (head-is? d "define") (head-is? d "define*")) (sym-name (second (items d))) (sym-name (car (items d)))))
                       (here d))
                  (cond ((string-member? n prims)
                         (restriction-refused (datum-file here) (line-of here) (string-append n " is a primitive, which KFX does not define again")))
                        ((string-member? n seen)
                         (restriction-refused (datum-file here) (line-of here) (string-append n " is defined already: KFX defines each name once")))
                        ((runtime-name? n)
                         (restriction-refused (datum-file here) (line-of here) (string-append "kayak-rt has a " (string-append n " of its own"))))
                        (else (names-once (cdr names) (cons n seen) prims))))))))

      (define module-own-items (subr kfx (sexp) sexps)
        (lambda (f) (concat (map (lambda ((g sexp)) (if (head-is? g "hide") (cdr (items g)) (the sexps (list g)))) (module-written f)))))

      (define-rec
        (sexp-names (subr kfx (sexp) strings)
          (lambda (e)
            "The names a type mentions where a type is: not a `select`'s
             (another module's), a field's label, a binder, a module type's."
            (tagcase e
              (sym (n f p) (the strings (list n)))
              (lst (xs f l p)
                (cond ((null? xs) nil)
                      ((or (head-is? e "select") (head-is? e "quote") (head-is? e "moduleof")) nil)
                      ((or (head-is? e "productof") (head-is? e "sumof"))
                       (concat (map (lambda ((g sexp)) (tagcase g (lst (ys f2 l2 p2) (concat (map sexp-names (cdr ys)))) (else other nil))) (cdr xs))))
                      ((or (head-is? e "poly") (head-is? e "dlambda") (head-is? e "mu")) (sexp-names (last xs)))
                      (else (concat (map sexp-names xs)))))
              (else other nil)))))

      (define abbreviations (subr kfx (sexps) sexps)
        (lambda (forms)
          "The define-types of `forms`, and of their modules."
          (concat (map (lambda ((f sexp))
                         (cond ((and (head-is? f "define-type") (i64= (size (items f)) 3)) (the sexps (list f)))
                               ((module-def? f) (filter (lambda ((g sexp)) (and (head-is? g "define-type") (i64= (size (items g)) 3))) (module-own-items f)))
                               (else nil)))
                       forms))))

      (define abbreviation-name (subr kfx (sexp) string)
        (lambda (f)
          (let ((h (second (items f))))
            (tagcase h (sym (n f2 p2) n) (lst (ys f2 l2 p2) (if (null? ys) "" (tagcase (car ys) (sym (n f3 p3) n) (else other "")))) (else other "")))))

      (define-rec
        (reaches? (subr kfx (sexps strings strings string) bool)
          (lambda (abbrevs todo seen target)
            "Whether, from the names `todo`, an abbreviation's body after
             another reaches `target`."
            (cond ((null? todo) #f)
                  ((string=? (car todo) target) #t)
                  ((string-member? (car todo) seen) (reaches? abbrevs (cdr todo) seen target))
                  (else
                   (let ((found (filter (lambda ((f sexp)) (string=? (abbreviation-name f) (car todo))) abbrevs)))
                     (reaches? abbrevs (onto (concat (map (lambda ((f sexp)) (sexp-names (third (items f)))) found)) (cdr todo))
                               (cons (car todo) seen) target)))))))

      (define-rec
        (mu-in-type (subr kfx (sexp) unit)
          (lambda (t)
            "A type as written: refused if it has a `(mu t T)`."
            (tagcase t
              (lst (xs f l p)
                (if (and (i64= (size xs) 3) (sym-is? (car xs) "mu") (tagcase (second xs) (sym (n f2 p2) #t) (else other #f)))
                    (restriction-refused f l "a recursive type, `mu`, FX-26's, which KFX has not: write a datatype (C174)")
                    (begin (map mu-in-type xs) #u)))
              (else other #u))))
        (mu-written (subr kfx (sexp) unit)
          (lambda (e)
            "Each type written in `e` where a form has one (a definition's, a
             `the`'s, a binding's of `define-rec` or `letrec`): `mu` is a type's
             word only there, and may name a procedure elsewhere."
            (tagcase e
              (lst (xs f l p)
                (cond ((null? xs) #u)
                      ((sym-is? (car xs) "quote") #u)
                      ((and (or (sym-is? (car xs) "define") (sym-is? (car xs) "define*") (sym-is? (car xs) "define-type")) (i64= (size xs) 4))
                       (begin (mu-in-type (third xs)) (mu-written (fourth xs))))
                      ((and (sym-is? (car xs) "define-type") (i64= (size xs) 3)) (mu-in-type (third xs)))
                      ((and (sym-is? (car xs) "the") (i64= (size xs) 3)) (begin (mu-in-type (second xs)) (mu-written (third xs))))
                      ((or (sym-is? (car xs) "define-rec") (sym-is? (car xs) "letrec"))
                       (begin
                         (map (lambda ((b sexp))
                                (tagcase b
                                  (lst (ys f2 l2 p2) (if (i64= (size ys) 3) (begin (mu-in-type (second ys)) (mu-written (third ys))) (mu-written b)))
                                  (else other #u)))
                              (if (sym-is? (car xs) "letrec") (items (second xs)) (cdr xs)))
                         (if (sym-is? (car xs) "letrec") (begin (map mu-written (cdr (cdr xs))) #u) #u)))
                      (else (begin (map mu-written xs) #u))))
              (else other #u)))))

      (define-rec
        (reserved-bound (subr kfx (sexp) unit)
          (lambda (e)
            "A name kayak-rt or the emitter writes, bound (C187): FX-26's, which
             KFX's names are not (C27)."
            (tagcase e
              (lst (xs f l p)
                (let* ((bound (lambda ((b sexp)) (tagcase b (sym (n f2 p2) (the strings (list n)))
                                                            (lst (ys f2 l2 p2) (if (null? ys) nil (tagcase (car ys) (sym (n f3 p3) (the strings (list n))) (else other nil))))
                                                            (else other nil))))
                       (names (cond ((null? xs) nil)
                                    ((or (sym-is? (car xs) "let") (sym-is? (car xs) "let*") (sym-is? (car xs) "letrec"))
                                     (if (i64> (size xs) 1) (tagcase (second xs) (lst (bs f2 l2 p2) (concat (map bound bs))) (else other nil)) nil))
                                    ((or (sym-is? (car xs) "lambda") (sym-is? (car xs) "rlambda"))
                                     (if (i64> (size xs) 1) (tagcase (second xs) (lst (bs f2 l2 p2) (concat (map bound bs))) (else other nil)) nil))
                                    ((or (sym-is? (car xs) "define") (sym-is? (car xs) "define*"))
                                     (if (i64> (size xs) 1) (bound (second xs)) nil))
                                    ((sym-is? (car xs) "define-rec") (concat (map bound (cdr xs))))
                                    ((or (sym-is? (car xs) "tagcase") (sym-is? (car xs) "typecase"))
                                     (concat (map (lambda ((arm sexp)) (tagcase arm
                                                                         (lst (ys f2 l2 p2) (if (i64> (size ys) 1)
                                                                                                (tagcase (second ys) (sym (n f3 p3) (the strings (list n)))
                                                                                                  (lst (zs f3 l3 p3) (concat (map bound zs))) (else other nil))
                                                                                                nil))
                                                                         (else other nil)))
                                                  (if (i64> (size xs) 2) (cdr (cdr xs)) nil))))
                                    (else nil)))
                       (wrong (lambda ((n string)) (and (not (has-prefix? n "%")) (not (has-prefix? n "made--")) (not (string=? n "_")) (or (kfx-reserved? n) (not (kfx-name? n)))))))
                  (if (any? wrong names)
                      (restriction-refused f l (string-append "a name KFX's names are not (lower case, digits, `-` and `?!<>=+*/%`, no `--`, none Rust writes): "
                                                              (car (filter wrong names))))
                      (begin (map reserved-bound xs) #u))))
              (else other #u)))))

      (define-rec
        (file-types (subr kfx (sexps) strings)
          (lambda (forms)
            "Each type defined, as `FILE|NAME`, in `forms` and their modules."
            (concat (map (lambda ((g sexp))
                           (tagcase g
                             (lst (xs f l p)
                               (cond ((and (or (head-is? g "define-type") (head-is? g "define-datatype") (head-is? g "define-generative")) (i64> (size xs) 1))
                                      (let ((n (tagcase (second xs) (sym (m f2 p2) m) (lst (ys f2 l2 p2) (if (null? ys) "" (tagcase (car ys) (sym (m f3 p3) m) (else other "")))) (else other ""))))
                                        (the strings (list (string-append f (string-append "|" n))))))
                                     ((module-def? g) (file-types (module-own-items g)))
                                     (else nil)))
                             (else other nil)))
                         forms)))))

      (define after-file (subr kfx (string) string)
        (lambda (t) (list->string (after-bar (string-chars t)))))

      (define-rec
        (after-bar (subr kfx ((listof char acyclic)) (listof char acyclic))
          (lambda (cs) (cond ((null? cs) nil) ((char=? (car cs) #\|) (cdr cs)) (else (after-bar (cdr cs)))))))

      (define-rec
        (binders-restricted (subr kfx (strings sexp) unit)
          (lambda (types e)
            "Type variables, a `poly`'s, a `plambda`'s or a family's, each a Rust
             type parameter of its name camel-cased (C27, C189; the checker's
             once, FX-26 having no such rule): a KFX name, none a type the Rust
             names, none a type the program has, no two alike."
            (tagcase e
              (lst (xs f l p)
                (let* ((binders (cond ((null? xs) nil)
                                      ((and (or (sym-is? (car xs) "poly") (sym-is? (car xs) "plambda")) (i64> (size xs) 1)) (items-of (second xs)))
                                      ((and (or (sym-is? (car xs) "define-type") (sym-is? (car xs) "define-generative") (sym-is? (car xs) "define-datatype")) (i64> (size xs) 1))
                                       (cdr-items-of (second xs)))
                                      (else nil)))
                       (names (concat (map (lambda ((b sexp)) (tagcase b
                                                                (lst (ys f2 l2 p2) (if (and (i64> (size ys) 1) (sym-is? (second ys) "type"))
                                                                                       (tagcase (car ys) (sym (n f3 p3) (the strings (list n))) (else other nil))
                                                                                       nil))
                                                                (else other nil)))
                                           binders)))
                       (theirs (map (lambda ((t string)) (camel (bare-type-name (string-chars t) nil)))
                                    ;; The types of the binder's own file: its Rust scope's (C189).
                                    (map after-file (filter (lambda ((t string)) (has-prefix? t (string-append f "|"))) types))))
                       (bad (filter (lambda ((n string)) (or (not (kfx-name? n)) (string-member? (camel n) (rust-type-names)) (string-member? (camel n) theirs))) names)))
                  (cond ((not (null? bad))
                         (restriction-refused f l (string-append "a type variable named as KFX's Rust cannot have it (C27): " (car bad))))
                        ((repeated? (map camel names))
                         (restriction-refused f l "two type variables named alike in Rust (camel-cased, as `a` and `a-`)"))
                        (else (begin (map (lambda ((x sexp)) (binders-restricted types x)) xs) #u)))))
              (else other #u)))))

      (define recursion-restricted (subr kfx (sexps) unit)
        (lambda (forms)
          "A type abbreviation that mentions itself, FX-26's recursive type
           (C174), which a Rust type alias is not; and `(mu t T)`, written."
          (let ((abbrevs (abbreviations forms)))
            (begin
              (map mu-written forms)
              (map reserved-bound forms)
              (map (lambda ((f sexp))
                     (let ((n (abbreviation-name f)))
                       (if (and (not (string=? n "")) (reaches? abbrevs (sexp-names (third (items f))) nil n))
                           (tagcase f (lst (xs f2 l2 p2) (restriction-refused f2 l2 (string-append "a type abbreviation that mentions itself, " (string-append n ": Rust's type aliases cannot; a datatype can")))) (else other #u))
                           #u)))
                   abbrevs)
              #u))))

      (define type-refused (subr kfx (sexps string string) void)
        (lambda (forms n message)
          (let ((fs (type-namer forms n)))
            (if (null? fs)
                (restriction-refused "the program" 0 message)
                (tagcase (car fs) (lst (xs file line pos) (restriction-refused file line message)) (else other (restriction-refused "the program" 0 message)))))))

      (define types-named (subr kfx (sexps) unit)
        (lambda (forms)
          (begin
            (map (lambda ((names strings))
                   (begin
                     (map (lambda ((n string))
                            (cond ((string-member? (camel n) (rust-type-names))
                                   (type-refused forms n (string-append "Rust or kayak-rt has a type " (string-append (camel n) " of its own"))))
                                  ((and (not (kfx-name? n)) (not (has-prefix? n "made--")))
                                   (type-refused forms n (string-append "a type's or module's name KFX's names are not (C27): " n)))
                                  (else #u)))
                          names)
                     (if (repeated? (map camel names))
                         (restriction-refused "the program" 0 "two types or modules named alike in Rust (camel-cased, as `point` and `point-`)")
                         #u)))
                 (type-scopes forms))
            #u)))

      (define-rec
        (noted-restricted (subr kfx (facts) unit)
          (lambda (fs)
            (cond ((null? fs) #u)
                  ((tagcase (car fs) (fact (f p what) (and (string=? f "%kfx") (has-prefix? what "kfx-refuses "))))
                   (tagcase (car fs) (fact (f p what) (error (string-append "kfx: " (after-prefix what "kfx-refuses "))))))
                  (else (noted-restricted (cdr fs)))))))

      (define names-restricted (subr kfx (sexps) unit)
        (lambda (forms)
          (let ((prims (primitive-names)))
            (begin
              (names-once (defined-names forms) nil prims)
              (map (lambda ((f sexp)) (if (module-def? f) (names-once (defined-names (module-own-items f)) nil nil) #u)) forms)
              (types-named forms))))))

    (define restrict (subr kfx (sexps facts) unit)
      (lambda (forms fs)
        "Each form, refused if it is not KFX: what the checker noted it has
         not (`kfx-restricted`, C154), the first noted first; names; then
         what each uses."
        (begin (noted-restricted (reverse fs)) (names-restricted forms) (restricted-all forms "the program" 0)
               (let ((types (concat (type-scopes forms))))
                 (begin (map (lambda ((f sexp)) (specs-restricted f types)) forms) (map moduleof-restricted forms) (recursion-restricted forms)
                        (map (lambda ((f sexp)) (binders-restricted (file-types forms) f)) forms)
                        (map (lambda ((f sexp))
                               (if (and (head-is? f "define") (tagcase (second (items f)) (sym (n f2 p2) (has-prefix? n "%shared:input:")) (else other #f)))
                                   (tagcase f (lst (xs f2 l2 p2) (restriction-refused f2 l2 "a load-input of a file whose expression is no module, FX-26's, which KFX reads not yet (C116, C171)")) (else other #u))
                                   #u))
                             forms)
                        #u)))))))
