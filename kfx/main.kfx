"main.kfx: the compiler's driver (C50), its I/O FX-26's (C49), so that
 Fixpt runs the whole compiler as Rust does: `fixpt run` it, or the
 binary kfx, with the same arguments.

   kfx FILE.kfx              a program of one file, as Rust, on standard
                             output;
   kfx --toplevel FILE.kfx   the same, with `kfx_toplevel`, which writes
                             the program's top-level expressions' values
                             as Fixpt does;
   kfx PROGRAM.unit DIR      a program of the files the manifest lists, in
                             order, as `DIR/mod.rs` and a module each. DIR
                             must be there: FX-26 makes no directories.

 A program of several files may be given `--cache FILE` before it (C54):
 FILE keeps each form's Rust for the next compile, which takes it again
 where nothing it was made from has changed (incr.kfx).

 Each may follow `--record LOG` or `--replay LOG` (C52): the compiler's
 reads and writes are a runner's operations (lib/runner.kfx), answered
 live (lib/live.kfx), recorded to LOG as text, or answered from LOG,
 which a run that reads or writes otherwise fails. A replay writes
 nothing: a compile replayed is the same compile, or it says where it
 parts.

 A file that cannot be read, or written, ends the run with status 1; a
 wrong use, with 2."

(define-effect driver (maxeff kfx world (alloc @io) (read @io) (write @io) (goto @io) (comefrom @io)))

"The runner the compiler's reads and writes go to."
(define-type drt (runner-tag int world @io))

(define fail-with (subr (maxeff (io stderr) (io exit)) (string int) void)
  (lambda (message status)
    (begin (write-err (string-append "kfx: " (string-append message "\n")))
           (exit status))))

(define read-text (subr driver (drt string) string)
  (lambda (rt path)
    (tagcase ((proj perform! int world @io) rt (sum read-file path))
      (text s s)
      (failed m (fail-with (string-append "cannot read " (string-append path (string-append ": " m))) 1))
      (else other (fail-with (string-append "cannot read " path) 1)))))

(define write-text (subr driver (drt string string) unit)
  (lambda (rt path text)
    (tagcase ((proj perform! int world @io) rt (sum write-file (product (path path) (text text))))
      (done u #u)
      (failed m (fail-with (string-append "cannot write " (string-append path (string-append ": " m))) 1))
      (else other (fail-with (string-append "cannot write " path) 1)))))

"The same, done directly, for the log itself."
(define read-text-now (subr (maxeff (read @globals) (io fs-read) (io stderr) (io exit) (alloc @io) (read @io)) (string) string)
  (lambda (path)
    (tagcase (the (sumof (data (bytevectorof @io)) (failed io-error)) (read-file path))
      (data b
        (tagcase (utf8->string b)
          (text s s)
          (bad k (fail-with (string-append "cannot read " (string-append path ": it is not UTF-8")) 1))))
      (failed e (fail-with (string-append "cannot read " (string-append path (string-append ": " (extract e detail)))) 1)))))

(define write-text-now (subr (maxeff (read @globals) (io fs-write) (io stderr) (io exit) (alloc @io) (read @io)) (string string) unit)
  (lambda (path text)
    (tagcase (write-file path (the (bytevectorof @io) (string->utf8 text)))
      (done u #u)
      (failed e (fail-with (string-append "cannot write " (string-append path (string-append ": " (extract e detail)))) 1)))))

"Manifests"

(define-rec
  (lines-from (subr kfx (chars chars) strings)
    (lambda (cs line)
      "The lines of `cs`, in order, the current one so far `line`, its
       characters newest first."
      (cond ((null? cs) (if (null? line) nil (list (rev->string line))))
            ((char=? (car cs) #\newline) (cons (rev->string line) (lines-from (cdr cs) nil)))
            (else (lines-from (cdr cs) (cons (car cs) line)))))))

(define-rec
  (drop-space (subr kfx (chars) chars)
    (lambda (cs) (if (and (not (null? cs)) (char-whitespace? (car cs))) (drop-space (cdr cs)) cs))))

(define line-trimmed (subr kfx (string) string)
  (lambda (s) (rev->string (drop-space (rev-onto (drop-space (string-chars s)) nil)))))

(define-rec
  (sources-of (subr driver (drt string strings) sources)
    (lambda (rt dir lines)
      "A manifest's files, in order: a line each, relative to the manifest;
       blank lines and `;` comments skipped."
      (if (null? lines)
          nil
          (let ((line (line-trimmed (car lines))))
            (if (or (string=? line "") (has-prefix? line ";"))
                (sources-of rt dir (cdr lines))
                (let* ((path (path-joined dir line))
                       (text (read-text rt path)))
                  (cons (source (stem path) text) (sources-of rt dir (cdr lines))))))))))

(define-rec
  (write-outputs (subr driver (drt string outputs) unit)
    (lambda (rt dir os)
      (if (null? os)
          #u
          (tagcase (car os)
            (output (name text)
              (begin (write-text rt (path-joined dir name) text)
                     (write-outputs rt dir (cdr os)))))))))

"The compiler, run."

(define put-out (subr driver (drt string) unit)
  (lambda (rt s) (begin ((proj perform! int world @io) rt (sum write s)) #u)))

"A compile, its uses `as`: the status."
(define-rec
  (loads-read (subr driver (drt strings fileds) fileds)
    (lambda (rt todo done)
      "The files a program loads, and those they load, each read once (C88)."
      (cond ((null? todo) done)
            ((any? (lambda ((s filed)) (tagcase s (filed (n t) (string=? n (car todo))))) done) (loads-read rt (cdr todo) done))
            (else
             (let ((text (read-text rt (car todo))))
               (loads-read rt (onto (load-paths-all (read-all (string-chars text) (car todo) 1) (directory-of (car todo))) (cdr todo))
                           (cons (filed (car todo) text) done))))))))

(define loaded-for (subr driver (drt string string) fileds)
  (lambda (rt file text)
    (loads-read rt (load-paths-all (read-all (string-chars text) file 1) (directory-of file)) nil)))

(define compile-with (subr driver (drt strings) int)
  (lambda (rt as)
    (cond ((i64= (size as) 1)
           (let ((text (read-text rt (car as)))) (begin (put-out rt (compile-named (car as) text (loaded-for rt (car as) text))) 0)))
          ((and (i64= (size as) 2) (string=? (car as) "--toplevel"))
           (let ((text (read-text rt (car (cdr as))))) (begin (put-out rt (compile-toplevel (car (cdr as)) text (loaded-for rt (car (cdr as)) text))) 0)))
          ((i64= (size as) 2)
           (let* ((text (read-text rt (car as)))
                  (program (sources-of rt (directory-of (car as)) (lines-from (string-chars text) nil))))
             (begin (write-outputs rt (car (cdr as)) (compile-units program)) 0)))
          ((and (i64= (size as) 4) (string=? (car as) "--cache"))
           (let* ((cache (car (cdr as)))
                  (unit (car (cdr (cdr as))))
                  (text (read-text rt unit))
                  (program (sources-of rt (directory-of unit) (lines-from (string-chars text) nil)))
                  (old (tagcase ((proj perform! int world @io) rt (sum read-file cache))
                         (text t (with incremental (memos-of-text t)))
                         (else other nil))))
             (tagcase (compile-units-memo program old)
               (compiled (outs made)
                 (begin (write-outputs rt (car (cdr (cdr (cdr as)))) outs)
                        (write-text rt cache (with incremental (memos-text made)))
                        0)))))
          (else
           (begin (fail-with "usage: kfx [--record LOG | --replay LOG] (FILE.kfx | [--cache FILE] PROGRAM.unit DIR | --toplevel FILE.kfx)" 2) 2)))))

(define reverse-log (subr (maxeff kfx (read @io) (alloc @io)) ((log @io) (log @io)) (log @io))
  (lambda (xs acc) (if (null? xs) acc (reverse-log (cdr xs) (cons (car xs) acc)))))

(define main (subr driver () int)
  (lambda ()
    (let ((as (the strings (args))))
      (cond ((and (not (null? as)) (string=? (car as) "--record") (not (null? (cdr as))))
             (let* ((log (the (ref (log @io) @io) (new nil)))
                    (status ((proj run-under int world @io) ((proj recording world @io) ((proj live @io)) log)
                             (lambda ((rt drt)) (compile-with rt (cdr (cdr as)))))))
               (begin (write-text-now (car (cdr as)) ((proj log-text @io) (reverse-log (get log) nil)))
                      status)))
            ((and (not (null? as)) (string=? (car as) "--replay") (not (null? (cdr as))))
             (let* ((log (the (ref (log @io) @io) (new ((proj log-of-text @io) (read-text-now (car (cdr as)))))))
                    (status ((proj run-under int world @io) ((proj replaying world @io) log)
                             (lambda ((rt drt)) (compile-with rt (cdr (cdr as)))))))
               (if (null? (get log))
                   status
                   (begin (fail-with "replay: the run ends before its log does" 1) 1))))
            (else
             ((proj run-under int world @io) ((proj live @io)) (lambda ((rt drt)) (compile-with rt as))))))))
