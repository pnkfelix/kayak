(syscall "code:page-words/1" "(subr (io sys) () int)" kayak)
(syscall "code:flush/1" "(poly ((r1 region)) (subr (maxeff (io sys) (read r1)) ((flatarrayof i64 r1) int int) unit))" kayak)
(syscall "kayak:call-native/1" "(poly ((r1 region)) (subr (maxeff (io sys) (read r1) (write r1)) ((flatarrayof i64 r1) int) int))" kayak)
(syscall "io:stdin-wait/1" "(subr (io sys) (i64) bool)" kayak)
(syscall "io:process-output-ready/1" "(subr (io sys) (i64) bool)" kayak)
(syscall "io:process-ended/1" "(subr (io sys) (i64) bool)" kayak)
(syscall "io:process-wait/1" "(subr (io sys) (i64 bool) bool)" kayak)
(syscall "io:write-points/1" "(poly ((r1 region)) (subr (maxeff (io sys) (read r1)) ((flatarrayof i64 r1) int int int int) int))" kayak)
(syscall "io:read-line-points/1" "(subr (io sys) () int)" kayak)
(syscall "io:take-points/1" "(poly ((r1 region)) (subr (maxeff (io sys) (write r1)) ((flatarrayof i64 r1) int int) unit))" kayak)
(syscall "io:failure-kind/1" "(subr (io sys) () int)" kayak)
(syscall "io:failure-detail/1" "(subr (io sys) () string)" kayak)
(syscall "kayak:note-code/1" "(subr (io sys) (int int string) unit)" kayak)
(syscall "kayak:note-code-lines/1" "(poly ((r1 region)) (subr (maxeff (io sys) (read r1)) (int int string string (flatarrayof i64 r1) int) unit))" kayak)
(syscall "kayak:string-utf8-length/1" "(subr pure (string) int)" kayak)
(syscall "kayak:last-sealed/1" "(subr (io sys) () int)" kayak)

