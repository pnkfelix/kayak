;; Immediates: Fixpt's values that are no object, and the sub-tags.
(immediate false 3 fixpt)
(immediate true 11 fixpt)
(immediate null 19 fixpt)
(immediate unit 27 fixpt)
(immediate eof 35 fixpt)
(immediate unspecified 43 fixpt)
(immediate default 51 fixpt)
(immediate unbound 59 fixpt)
(immediate sub-char 8 fixpt)
(immediate sub-f32 9 fixpt)

