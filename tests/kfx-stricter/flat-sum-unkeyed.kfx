"FX-26's flat sum with no key, its tag an index of the owner's fields,
 which KFX has not yet (C175)."
(define-effect kfx (maxeff (read @globals) (alloc @heap) (read @heap) (write @heap) spin))
(define-type o (bloblet (fields symbol symbol) @heap))
(define main (subr kfx () i64)
  (lambda ()
    (let* ((b (the o (make-bloblet 32 'a 'b)))
           (r (the (blobref o (sumof (a f64) (b i32))) (blobref-at b 0))))
      (int->i64 (blobref-offset (blobref-variant! r 'b))))))
