"A native procedure given a string: Fixpt passes its own string, and
 kayak's is Rust's, so KFX refuses it (C116)."
(define make (subr (maxeff (alloc @heap) (io native)) () (subr (conv native) pure (string) int))
  (lambda ()
    (the (subr (conv native) pure (string) int)
         (native-procedure (seal-code (the (bloblet (fields) @heap) (make-bloblet 8)))))))
