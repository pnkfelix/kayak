"A module as a value: FX-26's are, KFX's are Rust's mods (C19)."
(define-effect kfx (maxeff (read @globals) spin))
(define counter
  (module
    (define-generative t i64)
    (define zero t (up-t 0))
    (define value (subr pure (t) i64) (lambda (c) (down-t c)))))
(define f (subr kfx () i64) (lambda () (let ((m counter)) (with m (value zero)))))
(f)
