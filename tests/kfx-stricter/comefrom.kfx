"A continuation kept by call-with-composable-continuation: FX-26 may resume
 it again and again, a Rust future once; KFX's suspension is
 abort-with-continuation, whose continuation resumes once in both
 (CLAUDES_CHOICES.md C45)."
(define-effect kfx (maxeff (read @globals) spin))
(define f (subr kfx () i64)
  (lambda ()
    (letregion a
      (let ((t (the (prompt-tag i64 i64 kfx a) (make-continuation-prompt-tag))))
        (prompt t
                (begin (call-with-composable-continuation (lambda ((k (composable int i64 kfx a))) 1) t) 1)
                (lambda ((v i64)) v))))))
(f)
