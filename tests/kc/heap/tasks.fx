;; => (1495 30 7 100)
;; kc's tasks in the shared heap (C544): a process sent lists, each copied
;; into its mailbox, which it sums as they come; `par`'s branches, one
;; waiting for an I-cell another fills; a `race` whose spinning branch is
;; preempted and cancelled; a monitored process whose failure is its
;; watcher's message. The scheduler's queue, wakers and handlers are roots
;; off the heap, and what they reach moves (gc-stress, collected often).
(define-type msg (sumof (items (listof int acyclic)) (stop unit)))
(define* build (subr (maxeff spin (read (globals build))) (int (listof int acyclic)) (listof int acyclic))
  (lambda (n acc) (if (zero? n) acc (build (- n 1) (cons n acc)))))
(define* total-of (subr (maxeff spin (read (globals total-of))) ((listof int acyclic) int) int)
  (lambda (xs s) (if (null? xs) s (total-of (cdr xs) (+ s (car xs))))))
(define total (icell int @t) (make-icell))
(define summer (addr msg @p)
  (spawn (box msg r)
    (letrec ((go (subr (maxeff (receive r) (init @t) nondet spin (read (globals total-of))) (int) unit)
               (lambda (s)
                 (tagcase (receive box)
                   (items xs (go (total-of xs s)))
                   (stop u (icell-put! total s))))))
      (go 0))))
(send summer (sum items (build 20 nil)))
(send summer (sum items (build 30 nil)))
(send summer (sum items (build 40 nil)))
(send summer (sum stop #u))
(define c (icell int @c) (make-icell))
(define* spin-forever (subr spin (int) int) (lambda (n) (spin-forever (+ n 1))))
(define-type report (sumof (ok int) (failed string)))
(define reported (icell int @r) (make-icell))
(define watcher (addr report @w)
  (spawn (box report r)
    (tagcase (receive box)
      (ok v (icell-put! reported v))
      (failed m (icell-put! reported (if (string=? m "no") 100 50))))))
(define* failed (subr pure (string) report) (lambda (m) (sum failed m)))
(define worker (addr int @v)
  (spawn-monitored watcher failed (box int r) (send watcher (sum ok (if (= (receive box) 0) (error "no") 1)))))
(send worker 0)
(list (icell-get total)
      (par ((a (+ 10 (icell-get c))) (b (begin (icell-put! c 10) 10))) (+ a b))
      (race (spin-forever 0) 7)
      (icell-get reported))
