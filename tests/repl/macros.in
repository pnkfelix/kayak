(define-syntax swap! (macro (_ id id) expr) (syntax-rules ((_ a b) (let ((tmp (get a))) (begin (set a (get b)) (set b tmp))))))
(define x (ref int @g) (new 1))
(define y (ref int @g) (new 2))
(swap! x y)
(get x)
(define-syntax twice (macro (_ expr) expr) (syntax-rules ((_ e) (begin e e))))
(twice (swap! x y))
(get x)
(swap! x)
(get y)
