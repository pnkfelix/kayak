(define the-log (ref int @heap) (new 0))
(define api (module (define base 10) (define log the-log)))
(define-type api-type (moduleof (val base int) (val log (ref int @heap))))
(define s (sessionof api-type @heap) (make-session api))
(define step (subr (maxeff stage spin (read @heap) (write @heap) (read (globals s))) (datum) string) (lambda (code) (session-check s (maxeff (read @heap) (write @heap)) int code (c (tagcase c (expression p (int->string (p))) (definition d (tagcase (session-commit! s d (sum shadow #u)) (defined n (string-append "defined " n)) (failed why (extract why message)))))) (why (string-append "refused: " (extract why message))))))
(step '(define a (+ base 1)))
(define x1 100)
(define x2 200)
(step '(define b (* a 2)))
(define x3 300)
(step '(+ a b))
(list x1 x2 x3)
(step '(define base 1000))
(step '(+ base a))
(step '(begin (set log 7) (get log)))
(get the-log)
(step 'x1)
