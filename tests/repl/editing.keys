# Editing as Fixpt's REPL edits: Tab completes a name; ^B and Delete;
# up recalls the last entry; Enter in an open form is a newline; ^U
# drops the line before the cursor; ^A and ^E; ^W a word.
0 (define fib-of (subr (maxeff spin (read @globals)) (int) int) (lambda (n) (if (< n 2) n (+ (fib-of (- n 1)) (fib-of (- n 2))))))\r
100 (fib-o\t
110  10)\r
