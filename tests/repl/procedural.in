(define-syntax aif (er-macro-transformer (lambda (form rename compare) (let ((test (car (cdr form))) (then (car (cdr (cdr form)))) (else (car (cdr (cdr (cdr form)))))) `(,(rename 'let) ((it ,test)) (,(rename 'if) (,(rename '=) it 0) ,else ,then))))))
(aif (+ 2 4) it -1)
(aif 0 it -1)
(define helper (subr pure (int) int) (lambda (x) (+ x 1)))
(define-syntax inc (sc-macro-transformer (lambda (form env) `(helper ,(make-syntactic-closure env '() (car (cdr form)))))))
(let ((helper 100)) (inc helper))
(begin-for-syntax (define double (subr pure (datum) datum) (lambda (d) (if (int? d) (* 2 d) d))))
(define-syntax dbl (er-macro-transformer (lambda (form rename compare) (double (car (cdr form))))))
(+ (dbl 3) 1)
(define-syntax second (er-macro-transformer (lambda (form rename compare) (car (cdr (cdr form))))))
(second x)
(aif (+ 2 4) it -1)
