"Outside its module, a generative type is not what it is made of."
(define-effect kfx (maxeff (read @globals) spin))
(define counter
  (module
    (define-generative t i64)
    (define zero t (up-t 0))
    (define value (subr pure (t) i64) (lambda (c) (down-t c)))))
(define f (subr kfx () i64) (lambda () (i64+ 1 (with counter zero))))
