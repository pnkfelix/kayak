"A process making a module maker's instance in its own place: refused by
 FX-26 (Fixpt's `untransmissible`: a place, though its poly binds it, is
 untransmissible, and a process's body holds only what is), and by kfx (C439)."
(define-effect kfx (maxeff (read @globals) spin))
(define-type (cnt (p place)) (moduleof (val bump (subr (maxeff kfx (read p) (write p)) (i64) i64))))
(define counter-in (poly ((p place)) (subr (maxeff kfx (alloc p)) ((place p)) (cnt p)))
  (lambda (p)
    (module
      (define n (ref i64 p) (new 0))
      (define bump (subr (maxeff kfx (read p) (write p)) (i64) i64) (lambda (k) (begin (set n (i64+ k (get n))) (get n)))))))
(define* start (subr (maxeff (alloc @w) (init @o) nondet spin) ((icell i64 @o)) (addr unit @w))
  (lambda (out)
    (spawn (box unit p)
      (let ((x (counter-in p)))
        (begin (with x (bump 3)) (icell-put! out (with x (bump 4))))))))
(define main (subr (maxeff kfx (alloc @w) (init @o) (alloc @o) (await @o) nondet) () string)
  (lambda ()
    (let ((c (the (icell i64 @o) (make-icell))))
      (begin (start c) (i64->string (icell-get c))))))
