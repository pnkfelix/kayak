"f32: IEEE singles, rounded at each operation; no literal of their own, as
 in FX-26 (`(f64->f32 0.1)`, `(int->f32 3)`); an int rounded to one once,
 not through a double; and one in a bloblet's suffix beside an i32."
(define-effect kfx (maxeff (read @globals) spin))

(define-type o (bloblet (fields) @b))
(define b o (make-bloblet 16))
(define f (blobref o f32) (blobref-at b 8))
(define s (blobref o i32) (blobref+ f 4))

(define words (subr kfx ((listof string acyclic)) string)
  (lambda (xs) (if (null? xs) "" (string-append (car xs) (string-append " " (words (cdr xs)))))))

(define main (subr (maxeff kfx (read @b) (write @b)) () string)
  (lambda ()
    (begin
      (blobref-set! f (f64->f32 2.5))
      (blobref-set! s -5)
      (words (list (f32->string (f32+ (f64->f32 0.1) (f64->f32 0.2)))
                   (f32->string (int->f32 16777217))
                   (f64->string (f32->f64 (f64->f32 0.1)))
                   (f32->string (f32/ (int->f32 1) (int->f32 0)))
                   (f32->string (f32-round (f64->f32 2.5)))
                   (int->string (f32->int (int->f32 7)))
                   (int->string (u32->int (f32->bits (int->f32 1))))
                   (f32->string (int->f32 123456789012345678901234567890))
                   (f32->string (blobref-get f))
                   (int->string (i32->int (blobref-get s)))
                   (int->string (bloblet-byte b 11)))))))
(main)
