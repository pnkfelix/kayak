"Bytes (C49): `u8` and `i8`, whose arithmetic wraps; bytevectors made,
 written and read at a region, copied and compared; a string's UTF-8 and
 back, and bytes that are not UTF-8, which give the offset of the first
 bad one. After Fixpt's run/bytevectors.fx."

"The sum of the bytes from `i`."
(define* sum-bytes (subr (maxeff (read @b) spin) ((bytevectorof @b) int int) int)
  (lambda (bv i acc)
    (if (>= i (bytevector-length bv))
        acc
        (sum-bytes bv (+ i 1) (+ acc (u8->int (bytevector-u8-ref bv i)))))))

"FNV-1a over bytes, in `u32`, as a hash of a file's contents would be."
(define* fnv (subr (maxeff (read @b) spin) ((bytevectorof @b) int u32) u32)
  (lambda (bv i h)
    (if (>= i (bytevector-length bv))
        h
        (fnv bv (+ i 1) (u32* (u32-xor h (int->u32 (u8->int (bytevector-u8-ref bv i)))) 16777619)))))

"Each byte doubled, wrapping as a `u8` does."
(define* doubled! (subr (maxeff (read @b) (write @b) spin) ((bytevectorof @b) int) unit)
  (lambda (bv i)
    (if (>= i (bytevector-length bv))
        #u
        (begin (bytevector-u8-set! bv i (u8* (bytevector-u8-ref bv i) 2))
               (doubled! bv (+ i 1))))))

(define text-length (subr (read @b) ((bytevectorof @b)) int)
  (lambda (bv) (tagcase (utf8->string bv) (text s (string-length s)) (bad k (- 0 k)))))

(define* show-ints (subr (maxeff (read @l) spin) ((listof int @l)) string)
  (lambda (xs)
    (if (null? xs)
        ""
        (string-append (int->string (car xs)) (string-append " " (show-ints (cdr xs)))))))

(define small (subr pure () string)
  (lambda ()
    (string-append (int->string (u8->int (u8+ 200 100)))
      (string-append " " (string-append (int->string (i8->int (i8+ 100 100)))
        (string-append " " (string-append (int->string (u8->int (u8-shr 255 3)))
          (string-append " " (int->string (i8->int (i8-quotient -128 -1)))))))))))

(define main (subr (maxeff (read @globals) (alloc @b) (read @b) (write @b) (alloc @l) (read @l) spin) () string)
  (lambda ()
    (let ((bv (the (bytevectorof @b) (make-bytevector 4 7)))
          (hi (the (bytevectorof @b) (string->utf8 "héllo, wörld")))
          (none (the (bytevectorof @b) (make-bytevector 0 0))))
      (begin
        (bytevector-u8-set! bv 1 250)
        (bytevector-copy! bv 2 hi 0 2)
        (let ((before (sum-bytes bv 0 0)))
          (begin
            (doubled! bv 0)
            (string-append
              (show-ints
                (the (listof int @l)
                  (list before (sum-bytes bv 0 0) (bytevector-length hi) (bytevector-length none)
                        (if (bytevector=? bv (the (bytevectorof @b) (bytevector-copy bv 0 4))) 1 0)
                        (if (bytevector=? bv hi) 1 0)
                        (text-length hi)
                        (text-length (the (bytevectorof @b) (bytevector-copy hi 0 2)))
                        (text-length (the (bytevectorof @b) (bytevector-copy hi 3 14)))
                        (text-length none)
                        (u32->int (fnv hi 0 2166136261)))))
              (small))))))))
