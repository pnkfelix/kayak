"A module's items as FX-26's letrec* (C85): a typed lambda names items
 before or after it; procedures that call each other need no define-rec;
 a value is made from items made before it. And its names (C86): a type
 and a value may share a name; two modules included may give one type."
(define-effect kfx (maxeff (read @globals) spin))
(define nums (module (define-type num i64) (define one num 1)))
(define more (module (define-type num i64) (define two num 2)))
(define m
  (module
    (hide (include nums) (include more))
    (define g (subr pure (i64) i64) (lambda (x) (f x)))
    (define f (subr pure (i64) i64) (lambda (x) (i64+ x limit)))
    (define limit num (i64+ one two))
    (define y i64 (g 1))
    (define even? (subr spin (i64) bool) (lambda (n) (if (i64= n 0) #t (odd? (i64- n 1)))))
    (define odd? (subr spin (i64) bool) (lambda (n) (if (i64= n 0) #f (even? (i64- n 1)))))
    (define-type size i64)
    (define size size 7)))
(define main (subr kfx () string)
  (lambda ()
    (with m (string-append (i64->string (i64+ y size)) (if (even? 10) " even" " odd")))))
