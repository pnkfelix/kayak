"A module maker's types (C436), as Fixpt's expander's are once its
 datatypes are defined outside: a type abbreviation and an effect defined
 in the module, naming its place, and its items of them."

(define-effect kfx (maxeff (read @globals) spin))

(define-datatype shape (sq i64) (rect i64 i64))

(define-type (shapes (p place))
  (moduleof (val add (subr (maxeff kfx (read p) (write p)) (i64 i64) unit))
            (val area (subr (maxeff kfx (read p)) () i64))))

(define shapes-in (poly ((p place)) (subr (maxeff kfx (alloc p)) ((place p)) (shapes p)))
  (lambda (p)
    (module
      (define-type shape-cell (ref (listof shape acyclic) p))
      (define-effect keeps (maxeff kfx (read p) (write p)))
      (define kept shape-cell (new nil))
      (define square (subr kfx (i64) shape) (lambda (k) (sq k)))
      (define area-of (subr kfx (shape) i64)
        (lambda (s) (tagcase s (sq (k) (i64* k k)) (rect (w h) (i64* w h)))))
      (define add (subr keeps (i64 i64) unit)
        (lambda (w h) (set kept (cons (if (i64= w h) (square w) (rect w h)) (get kept)))))
      (define total-of (subr kfx ((listof shape acyclic)) i64)
        (lambda (xs) (if (null? xs) 0 (i64+ (area-of (car xs)) (total-of (cdr xs))))))
      (define area (subr (maxeff kfx (read p)) () i64) (lambda () (total-of (get kept)))))))

(define main (subr kfx () string)
  (lambda ()
    (letrena a
      (let ((x (shapes-in a)))
        (begin (with x (add 3 3)) (with x (add 2 5)) (i64->string (with x (area))))))))
