"A module maker's state (C433): a module made in a procedure of a place
 whose items include values and refs, made when the maker is called, so
 that each module it makes has its own; a value may call the module's
 procedures and name the values defined before it. Two counters, made in two places,
 count apart."

(define-effect kfx (maxeff (read @globals) spin))

(define-type (counter (p place))
  (moduleof (val bump (subr (maxeff kfx (read p) (write p)) () i64))
            (val total (subr (maxeff kfx (read p)) () i64))))

(define counter-in (poly ((p place)) (subr (maxeff kfx (alloc p)) ((place p)) (counter p)))
  (lambda (p)
    (module
      (define start (subr kfx () i64) (lambda () 10))
      (define base i64 (i64* 2 (start)))
      (define n (ref i64 p) (new (i64- base (start))))
      (define bumps (ref i64 p) (new 0))
      (define bump (subr (maxeff kfx (read p) (write p)) () i64)
        (lambda () (begin (set n (i64+ (get n) 1)) (set bumps (i64+ (get bumps) 1)) (get n))))
      (define total (subr (maxeff kfx (read p)) () i64)
        (lambda () (i64+ (get n) (i64* 100 (get bumps))))))))

(define main (subr kfx () string)
  (lambda ()
    (letrena a
      (letrena b
        (let ((x (counter-in a)) (y (counter-in b)))
          (begin
            (with x (bump)) (with x (bump)) (with y (bump))
            (string-append (i64->string (with x (total)))
              (string-append " " (i64->string (with y (total)))))))))))
