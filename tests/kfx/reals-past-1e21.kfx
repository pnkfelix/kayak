"Reals of 1e21 or more: f64s, as Fixpt reads them since both its checkers
 read the Rust reader's syntax (its 6864363b, C427); FX-26 had read them
 as ints, and KFX refused them."

(define-effect kfx (maxeff (read @globals) spin))

(define x f64 1000000000000000000000.0)

(define main (subr kfx () string)
  (lambda ()
    (string-append (f64->string x)
      (string-append " " (string-append (f64->string -12345678901234567890123.5)
        (string-append " " (f64->string (f64* x 1000.0))))))))
