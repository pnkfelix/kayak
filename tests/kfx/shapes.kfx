"FX-26's products and sums, structural: a generic Rust type for each list
 of labels, `Product_x_y<A0, A1>` a tuple struct, `Sum_circle_rect<A0, A1>`
 an enum whose values are references."

(define-effect kfx (maxeff (read @globals) spin))

(define-type point (productof (x i64) (y i64)))

(define-type shape (sumof (circle i64) (rect (productof (w i64) (h i64)))))

"A member taken apart, `(rect (w h) ...)`, or bound whole, `(rect q ...)`."
(define area (subr pure (shape) i64)
  (lambda (s) (tagcase s (circle r (i64* 3 (i64* r r))) (rect (w h) (i64* w h)))))

(define width (subr pure (shape) i64)
  (lambda (s) (tagcase s (rect q (extract q w)) (else z 0))))

(define origin point (product (x 1) (y 2)))

"Positional labels, and a product of products."
(define pair (subr pure (i64 i64) (productof (1 i64) (2 i64)))
  (lambda (a b) (product (1 a) (2 b))))

(define swap (subr pure ((productof (1 i64) (2 i64))) (productof (1 i64) (2 i64)))
  (lambda (p) (product (1 (extract p 2)) (2 (extract p 1)))))

(define main (subr kfx () string)
  (lambda ()
    (let ((shapes (the (listof shape acyclic) (list (sum rect (product (w 3) (h 4))) (sum circle 2)))))
      (i64->string
       (i64+ (i64+ (area (car shapes)) (area (car (cdr shapes))))
             (i64+ (i64* 100 (extract origin y))
                   (i64+ (i64* 1000 (width (sum rect (product (w 5) (h 6)))))
                         (i64* 10000 (extract (swap (pair 7 8)) 1)))))))))
