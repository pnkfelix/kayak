"A module maker's `->*` items (C435): each one's effect found from its
 lambda, in order, as a top-level module's are, one naming the module's
 ref among them."

(define-effect kfx (maxeff (read @globals) spin))
(define-type (cnt (p place)) (moduleof (val bump (subr (maxeff kfx (read p) (write p)) () i64))))
(define counter-in (poly ((p place)) (subr (maxeff kfx (alloc p)) ((place p)) (cnt p)))
  (lambda (p)
    (module
      (define n (ref i64 p) (new 0))
      (define step (->* (i64) i64) (lambda (k) (i64+ k 1)))
      (define bump0 (->* () i64) (lambda () (begin (set n (step (get n))) (get n))))
      (define bump (subr (maxeff kfx (read p) (write p)) () i64) (lambda () (bump0))))))
(define main (subr kfx () string) (lambda () (letrena a (let ((x (counter-in a))) (begin (with x (bump)) (i64->string (with x (bump))))))))
