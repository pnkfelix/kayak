"front.kfx: kc's inputs and its front end (docs/research/kc.md, K1).

 Every query's key is its name, a space, and its argument; every body is
 given the database, the procedure that runs any query (`runner`), and
 its key's argument, and reads what it needs only through the database.
 The inputs, set by `kc-load!` from one reading of a source file's text
 (C414): `text PATH`, the text; `keys PATH`; each form's `form PATH KEY`
 and `position PATH KEY`. Syntax alone, so that the driver may make it
 where a query would be re-run whole at every edit, each of its parts
 re-read by every form's queries. The language of a file is
 its name's: `.kfx` is KFX, anything else FX-26. One checker for both
 (kfx's); KFX is what also passes the restriction pass (`restrict.kfx`).

 A program's forms each have a key of their own (C407): a definition its
 name, any other form `#expr` and how many such came before it. What a
 later pass needs of a form it asks by that key, so that an edit of one
 form runs again only what reads it, and an edit that leaves a
 definition's interface as it was stops there (early cutoff):

   keys PATH             the keys, in order (an input)
   form PATH KEY         that form's datum (an input; `()` of a key
                         that is no form's, a name the program does not
                         define)
   position PATH KEY     where that form is among them (an input)
   interface PATH KEY    a definition's kind: `(proc NAME ARITY)` or
                         `(value NAME)`; `(expr)` of any other form, and
                         of a name the program does not define

 A form's scope is not a query of its own (C414): what a form needs of
 the program's names, it asks of each name it looks up (`kc-scope-entry`,
 C416), so that an edit elsewhere does not reach it."

"A query's body."

(define kc-front
  (module
    "A query's body (C417): given the database, the runner, and its key's
     arguments, a file's path and, of a query of a form, its key (`` of a
     query of one argument)."
    (define-type qbody (subr qe (db runner string string) string))

    (hide
      (define kc-language (subr kfx (string) string)
        (lambda (path) (if (has-suffix? path ".kfx") "kfx" "fx26"))))

    ;;; ------------------------------------------------------------ data as text
    (define-rec
      (kc-hex (subr kfx (i64 string) string)
        (lambda (n acc)
          "`n` in hexadecimal, before `acc`."
          (let* ((d (i64-remainder n 16))
                 (c (list->string (list (i64->char (if (i64< d 10) (i64+ d 48) (i64+ d 87))))))
                 (acc (string-append c acc)))
            (if (i64< n 16) acc (kc-hex (i64-quotient n 16) acc))))))

    (hide
      (define-rec
        (kc-escaped (subr kfx ((listof char acyclic) (listof string acyclic)) (listof string acyclic))
          (lambda (cs acc)
            "A string's characters as the reader reads them back, the newest first."
            (if (null? cs)
                acc
                (let* ((c (car cs)) (k (char->i64 c))
                       (w (cond ((char=? c #\") "\\\"")
                                ((char=? c #\\) "\\\\")
                                ((char=? c #\newline) "\\n")
                                ((char=? c #\tab) "\\t")
                                ((i64< k 32) (string-append "\\x" (string-append (kc-hex k "") ";")))
                                (else (list->string (list c))))))
                  (kc-escaped (cdr cs) (cons w acc))))))))

    (define-rec
      (kc-datum (subr kfx (sexp) string)
        (lambda (e)
          "A datum as text the reader reads back as it: a character by its code
           (`#\\x20`), a string with its escapes (C407)."
          (tagcase e
            (sym (s f p) s)
            (num (k f p) (i64->string k))
            (big (text f p) text)
            (real (t f p) t)
            (chr (c f p) (string-append "#\\x" (kc-hex (char->i64 c) "")))
            (str (s f p) (string-append "\"" (string-append (string-list-append (reverse (kc-escaped (string-chars s) nil))) "\"")))
            (lst (xs f l p) (string-append "(" (string-append (kc-data xs) ")"))))))
      (kc-data (subr kfx (sexps) string)
        (lambda (xs)
          (cond ((null? xs) "")
                ((null? (cdr xs)) (kc-datum (car xs)))
                (else (string-append (kc-datum (car xs)) (string-append " " (kc-data (cdr xs)))))))))

    (hide
      ;;; ------------------------------------------------------------ the forms
      "Each of `ks` asked of the database as `(QUERY PATH KEY)`, in order: their
       values (KFX's `map` takes no procedure that reads the database)."
      (define-rec
        (kc-get-all (subr qe (db runner string string (listof string acyclic)) (listof string acyclic))
          (lambda (d run query path ks)
            (if (null? ks) nil (cons (db-get d run (key2 query path (car ks))) (kc-get-all d run query path (cdr ks))))))))

    "Each of `ks`, of a file's forms, asked as `QUERY PATH KEY`, read as data."
    (define kc-items-of (subr qe (db runner string string (listof string acyclic)) sexps)
      (lambda (d run query path ks)
        (map (lambda ((t string)) (car (read-all t query 1)))
             (kc-get-all d run query path ks))))

    (hide
      "A file's forms, as read."
      (define kc-forms (subr qe (db runner string) sexps)
        (lambda (d run path) (read-all (db-get d run (key1 "text" path)) path 1))))

    (define form-name (subr kfx (sexp) string)
      (lambda (f)
        "A definition's name; `` of any other form."
        (tagcase f
          (lst (xs fl l p)
            (if (and (i64>= (size xs) 3) (sym-is? (car xs) "define"))
                (tagcase (second xs) (sym (n f2 p2) n) (else other ""))
                ""))
          (else other ""))))

    (hide
      (define-rec
        (forms-keyed (subr kfx (sexps i64 (listof string acyclic)) (listof string acyclic))
          (lambda (fs k acc)
            "Each form as `(KEY DATUM)`, the newest first; `k` how many forms that
             are no definition came before."
            (if (null? fs)
                acc
                (let ((n (form-name (car fs))))
                  (if (string=? n "")
                      (forms-keyed (cdr fs) (i64+ k 1) (cons (string-list-append (list "(#expr" (i64->string k) " " (kc-datum (car fs)) ")")) acc))
                      (forms-keyed (cdr fs) k (cons (string-list-append (list "(" n " " (kc-datum (car fs)) ")")) acc))))))))

      (define-rec
        (kc-set-forms! (subr qe (db string sexps i64) unit)
          (lambda (d path keyed i)
            "Each `(KEY DATUM)`'s inputs, `i` its position."
            (if (null? keyed)
                #u
                (let* ((x (items (car keyed)))
                       (k (tagcase (car x) (sym (n f p) n) (else other ""))))
                  (begin
                    (db-set! d (key2 "form" path k) (kc-datum (second x)) 0)
                    (db-set! d (key2 "position" path k) (i64->string i) 0)
                    (kc-set-forms! d path (cdr keyed) (i64+ i 1))))))))

      (define-rec
        (kc-unset-forms! (subr qe (db string (listof string acyclic)) unit)
          (lambda (d path ks)
            "Each of `ks`, a form no longer there: no form, and no position."
            (if (null? ks)
                #u
                (begin
                  (db-set! d (key2 "form" path (car ks)) "()" 0)
                  (db-set! d (key2 "position" path (car ks)) "-1" 0)
                  (kc-unset-forms! d path (cdr ks))))))))

    "`kc-load! PATH TEXT`: the file `PATH`'s text, read once, and the inputs
     made of it (C414): each form's datum and position, the keys in order; a
     form no longer there, `()`. An input set to what it was is no change
     (`db-set!`), so a run with the text as it was changes nothing."
    (define kc-load! (subr qe (db runner string string) unit)
      (lambda (d run path text)
        (if (let ((t (db-node d (key1 "text" path))))
              (and (not (null? t)) (string=? (node-value d (car t)) text)))
            ;; The text as it was (C417): its forms' inputs are too, not read
            ;; again.
            #u
        (let* ((kd (lambda ((x sexp)) (tagcase (car (items x)) (sym (n f p) n) (else other ""))))
               (keyed (map (lambda ((t string)) (car (read-all t "forms" 1))) (reverse (forms-keyed (read-all text path 1) 0 nil))))
               (keys (map kd keyed))
               (keys-text (string-append "(" (string-append (words-of keys) ")")))
               (old (db-node d (key1 "keys" path)))
               (old-keys (if (null? old) nil
                             (map (lambda ((x sexp)) (tagcase x (sym (n f p) n) (else other "")))
                                  (items (car (read-all (node-value d (car old)) "keys" 1)))))))
          (begin
            (db-set! d (key1 "text" path) text 0)
            (kc-set-forms! d path keyed 0)
            (if (and (not (null? old)) (not (string=? (node-value d (car old)) keys-text)))
                (kc-unset-forms! d path (filter (lambda ((k string)) (not (string-member? k keys))) old-keys))
                #u)
            (db-set! d (key1 "keys" path) keys-text 0))))))

    (define kc-keys (subr qe (db runner string) (listof string acyclic))
      (lambda (d run path)
        (map (lambda ((x sexp)) (tagcase x (sym (n f p) n) (else other ""))) (items (car (read-all (db-get d run (key1 "keys" path)) "keys" 1))))))

    "`form PATH KEY` of a key `kc-load!` set none of: a name the program does
     not define, `()`; and `position PATH KEY`, -1 (C414)."
    (define q-form qbody (lambda (d run a-path a-key) "()"))

    (define q-position qbody (lambda (d run a-path a-key) "-1"))

    (define kc-form (subr qe (db runner string string) sexp)
      (lambda (d run path key) (car (read-all (db-get d run (key2 "form" path key)) path 1))))

    "A definition's value, and whether it is a `lambda` (perhaps under `the`)."
    (define define-value (subr kfx (sexp) sexp)
      (lambda (f) (car (reverse (items f)))))

    (define lambda-of (subr kfx (sexp) sexps)
      (lambda (v)
        "A value's `lambda`, as a list of one, or none."
        (tagcase v
          (lst (xs f l p)
            (cond ((and (not (null? xs)) (sym-is? (car xs) "lambda") (i64>= (size xs) 3)) (list v))
                  (else nil)))
          (else other nil))))

    "`interface PATH KEY`."
    (define q-interface qbody
      (lambda (d run a-path a-key)
        (let ((f (kc-form d run a-path a-key)))
          (if (string=? (form-name f) "")
              "(expr)"
              (let ((l (lambda-of (define-value f))))
                (if (null? l)
                    (string-append "(value " (string-append (form-name f) ")"))
                    (string-list-append (list "(proc " (form-name f) " " (i64->string (size (items (second (items (car l)))))) ")"))))))))

    "Where form `key` is among the forms."
    (define kc-position (subr qe (db runner string string) i64)
      (lambda (d run path key)
        (string->i64 (db-get d run (key2 "position" path key)))))

    "What `name` is to the form at `at` (C414, C416): its definition's
     interface, `(proc NAME ARITY)` or `(value NAME)`, if one comes before;
     else `(none NAME)`. A name's interface read, and its position if it is
     defined, and nothing else: so that a form depends on the names it looks
     up, each alone."
    (define kc-scope-entry (subr qe (db runner string i64 string) sexp)
      (lambda (d run path at name)
        (let ((i (car (read-all (db-get d run (key2 "interface" path name)) "scope" 1))))
          (if (and (not (sym-is? (car (items i)) "expr")) (i64< (kc-position d run path name) at))
              i
              (lst (list (sym "none" "" 0) (sym name "" 0)) "" 0 0)))))

    ;;; ------------------------------------------------------------ checking
    (hide
      "What a check comes to (C415): the types found, as text, and the memos
       made; or a refusal's message."
      (define-datatype check-outcome (check-passed string memos) (check-refused string))

      (define check-outcome-of (subr kfx (string sexps strings memos) check-outcome)
        (lambda (path forms texts old)
          (tagcase (with incremental-check (check-program-memo forms texts old #f))
            (checked-memo (done found made)
              (begin
                (if (string=? (kc-language path) "kfx") (with restrictions (restrict forms (cv-facts done))) #u)
                (check-passed (words-of (map (lambda ((t typed)) (tagcase t (typed (n ty) (string-list-append (list "(" n " " (kc-datum ty) ")")))))
                                             found))
                              made)))))))

    "`checked PATH`: the file checked, as FX-26, or as KFX for a `.kfx` file:
     `(ok (NAME TYPE) ...)`, the types the checker found of the definitions
     written with none (C407); or `(refused MESSAGE)`, the checker's refusal
     (C415), a value as any other, so that a run that meets one ends as any
     other does, its work kept, and a `kc serve` goes on."
    (define q-checked qbody
      (lambda (d run path a-key)
        ;; Checked with the memos the last check left (C415, kfx's of C384):
        ;; a form whose text, and the bindings of the names it reads, and the
        ;; forms before it, are as they were, is not checked again, its
        ;; change to the checker's state replayed. Content-addressed, the
        ;; memos are no input: they spare work, and change no value.
        (let* ((text (db-get d run (key1 "text" path)))
               (forms (read-all text path 1))
               (texts (with incremental-check (form-texts text (string-length-i64 text) (map datum-pos forms))))
               (side (string-append "check-memos " path))
               (old ((with queries memos-of-text) (db-side d side) "kc")))
          ;; The checker's refusal, an `error`, caught (FX-26's `attempt`): the
          ;; check writes nothing, so a refusal half way leaves nothing to undo;
          ;; the memos are kept as they were.
          (tagcase (attempt (check-outcome-of path forms texts old) (lambda ((m string)) (check-refused m)))
            (check-passed (t made)
              (begin
                (db-side-put! d side ((with queries memos-text) made "kc"))
                (string-append "(ok " (string-append t ")"))))
            (check-refused (m) (string-append "(refused " (string-append (kc-datum (str m "" 0)) ")")))))))

    "A `checked`'s value: its refusal's message, `` if it passed; the types
     it found."
    (define kc-refusal (subr kfx (string) string)
      (lambda (v)
        (let ((x (items (car (read-all v "checked" 1)))))
          (if (sym-is? (car x) "refused") (tagcase (second x) (str (m f p) m) (else other "?")) ""))))

    (hide
      (define kc-checked-types (subr qe (db runner string) sexps)
        (lambda (d run path)
          (let ((v (db-get d run (key1 "checked" path))))
            (if (string=? (kc-refusal v) "")
                (cdr (items (car (read-all v "checked" 1))))
                (begin (error (kc-refusal v)) nil))))))

    "`type PATH NAME`: a definition's type, as written, or as the checker
     found it (C407)."
    (define q-type qbody
      (lambda (d run a-path a-key)
        (let* ((path a-path) (name a-key)
               (f (kc-form d run path name)))
          (if (i64= (size (items f)) 4)
              (kc-datum (third (items f)))
              (let ((found (filter (lambda ((x sexp)) (sym-is? (car (items x)) name))
                                   (kc-checked-types d run path))))
                (if (null? found) "()" (kc-datum (second (items (car found))))))))))

    (define kc-type (subr qe (db runner string string) sexp)
      (lambda (d run path name) (car (read-all (db-get d run (key2 "type" path name)) "type" 1))))

    "`kfx PATH`: the file checked and passing KFX's restrictions, whatever its
     name says, as the Rust back end needs it; `ok`."
    (define q-kfx qbody
      (lambda (d run path a-key)
        ;; A `.kfx` file's check restricts it already (C415): not checked twice.
        (if (string=? (kc-language path) "kfx")
            (begin (db-get d run (key1 "checked" path)) "ok")
            (let* ((forms (kc-forms d run path))
                   (v (check-program forms)))
              (begin (with restrictions (restrict forms (verdict-facts v))) "ok")))))))
