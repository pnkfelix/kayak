"front.kfx: kc's inputs and its front end (docs/research/kc.md, K1).

 Every query's key is its name, a space, and its argument; every body is
 given the database, the procedure that runs any query (`runner`), and
 its key's argument, and reads what it needs only through the database.
 The inputs, set by `kc-load!` from one reading of a source file's text
 (C414): `text PATH`, the text; `keys PATH`; each form's `form PATH KEY`
 and `position PATH KEY`. Syntax alone, so that the driver may make it
 where a query would be re-run whole at every edit, each of its parts
 re-read by every form's queries. The language of a file is
 its name's: `.kfx` is KFX, anything else FX-26. One checker for both
 (kfx's); KFX is what also passes the restriction pass (`restrict.kfx`).

 A program's forms each have a key of their own (C407): a definition its
 name, any other form `#expr` and how many such came before it. What a
 later pass needs of a form it asks by that key, so that an edit of one
 form runs again only what reads it, and an edit that leaves a
 definition's interface as it was stops there (early cutoff):

   keys PATH             the keys, in order (an input)
   form PATH KEY         that form's datum (an input; `()` of a key
                         that is no form's, a name the program does not
                         define)
   position PATH KEY     where that form is among them (an input)
   interface PATH KEY    a definition's kind: `(proc NAME ARITY)` or
                         `(value NAME)`; `(expr)` of any other form, and
                         of a name the program does not define

 A form's scope is not a query of its own (C414): what a form needs of
 the program's names, it asks of each name it looks up (`kc-scope-entry`,
 C416), so that an edit elsewhere does not reach it."

"A query's body."

(define kc-front
  (module
    "A query's body (C417): given the database, the runner, and its key's
     arguments, a file's path and, of a query of a form, its key (`` of a
     query of one argument)."
    (define-type qbody (subr qe (db runner string string) string))

    (hide
      (define kc-language (subr kfx (string) string)
        (lambda (path) (if (has-suffix? path ".kfx") "kfx" "fx26"))))

    ;;; ------------------------------------------------------------ data as text
    (define-rec
      (kc-hex (subr kfx (i64 string) string)
        (lambda (n acc)
          "`n` in hexadecimal, before `acc`."
          (let* ((d (i64-remainder n 16))
                 (c (list->string (list (i64->char (if (i64< d 10) (i64+ d 48) (i64+ d 87))))))
                 (acc (string-append c acc)))
            (if (i64< n 16) acc (kc-hex (i64-quotient n 16) acc))))))

    (hide
      (define-rec
        (kc-escaped (subr kfx ((listof char acyclic) (listof string acyclic)) (listof string acyclic))
          (lambda (cs acc)
            "A string's characters as the reader reads them back, the newest first."
            (if (null? cs)
                acc
                (let* ((c (car cs)) (k (char->i64 c))
                       (w (cond ((char=? c #\") "\\\"")
                                ((char=? c #\\) "\\\\")
                                ((char=? c #\newline) "\\n")
                                ((char=? c #\tab) "\\t")
                                ((i64< k 32) (string-append "\\x" (string-append (kc-hex k "") ";")))
                                (else (list->string (list c))))))
                  (kc-escaped (cdr cs) (cons w acc))))))))

    (define-rec
      (kc-datum (subr kfx (sexp) string)
        (lambda (e)
          "A datum as text the reader reads back as it: a character by its code
           (`#\\x20`), a string with its escapes (C407)."
          (tagcase e
            (sym (s f p) s)
            (num (k f p) (i64->string k))
            (big (text f p) text)
            (real (t f p) t)
            (chr (c f p) (string-append "#\\x" (kc-hex (char->i64 c) "")))
            (str (s f p) (string-append "\"" (string-append (string-list-append (reverse (kc-escaped (string-chars s) nil))) "\"")))
            (lst (xs f l p) (string-append "(" (string-append (kc-data xs) ")"))))))
      (kc-data (subr kfx (sexps) string)
        (lambda (xs)
          "Each of `xs`, spaced, joined once (C524): a loop, not a frame for
           each (each holding its datum's text, pinning a page as a
           collection runs), nor a copy of the rest for each."
          (string-list-append (kc-data-onto xs nil))))
      (kc-data-onto (subr kfx (sexps strings) strings)
        (lambda (xs acc)
          (cond ((null? xs) (reverse acc))
                ((null? (cdr xs)) (reverse (cons (kc-datum (car xs)) acc)))
                (else (kc-data-onto (cdr xs) (cons " " (cons (kc-datum (car xs)) acc))))))))

    (hide
      ;;; ------------------------------------------------------------ the forms
      "Each of `ks` asked of the database as `(QUERY PATH KEY)`, in order: their
       values (KFX's `map` takes no procedure that reads the database)."
      (define-rec
        (kc-get-all (subr qe (db runner string string (listof string acyclic)) (listof string acyclic))
          (lambda (d run query path ks)
            (if (null? ks) nil (cons (db-get d run (key2 query path (car ks))) (kc-get-all d run query path (cdr ks))))))))

    "Each of `ks`, of a file's forms, asked as `QUERY PATH KEY`, read as data."
    (define kc-items-of (subr qe (db runner string string (listof string acyclic)) sexps)
      (lambda (d run query path ks)
        (map (lambda ((t string)) (car (read-all t query 1)))
             (kc-get-all d run query path ks))))

    (define form-name (subr kfx (sexp) string)
      (lambda (f)
        "A definition's name, `define`'s or `define*`'s (C426: its effect found
         from its lambda, its code a `define`'s); `` of any other form."
        (tagcase f
          (lst (xs fl l p)
            (if (and (i64>= (size xs) 3) (or (sym-is? (car xs) "define") (sym-is? (car xs) "define*")))
                (tagcase (second xs) (sym (n f2 p2) n) (else other ""))
                ""))
          (else other ""))))

    "Whether a form defines a type, an effect or a datatype (C423): no code
     of its own; its key `%type:NAME`, so that one added leaves the keys of
     the expressions after it as they were."
    (define type-form? (subr kfx (sexp) bool)
      (lambda (f)
        (or (head-is? f "define-type") (head-is? f "define-datatype") (head-is? f "define-effect") (head-is? f "define-generative"))))

    (hide
      (define type-form-name (subr kfx (sexp) string)
        (lambda (f)
          (if (i64< (size (items f)) 2) "?"
              (tagcase (second (items f))
                (sym (n f2 p2) n)
                (lst (ys f2 l2 p2) (if (null? ys) "?" (tagcase (car ys) (sym (n f3 p3) n) (else other "?"))))
                (else other "?")))))

      (define-rec
        (field-names (subr kfx (i64 i64 (listof string acyclic)) (listof string acyclic))
          (lambda (i n acc) (if (i64> i n) (reverse acc) (field-names (i64+ i 1) n (cons (string-append "%x" (i64->string i)) acc))))))

      (define-rec
        (fields-numbered (subr kfx ((listof string acyclic) i64 (listof string acyclic)) (listof string acyclic))
          (lambda (xs i acc) (if (null? xs) (reverse acc) (fields-numbered (cdr xs) (i64+ i 1) (cons (string-list-append (list "(" (i64->string i) " " (car xs) ")")) acc))))))

      (define-rec
        (constructors-keyed (subr kfx (sexps (listof string acyclic)) (listof string acyclic))
          (lambda (vs acc)
            "A datatype's variants' constructors, as Fixpt's parser makes them
             (`parser.fx`'s `expand-datatype`): each a procedure of its
             fields, a sum of its name's tag of the product of them."
            (if (null? vs)
                acc
                (tagcase (car vs)
                  (lst (ys f l p)
                    (let* ((c (tagcase (car ys) (sym (n f2 p2) n) (else other "?")))
                           (xs (field-names 1 (i64- (size ys) 1) nil)))
                      (constructors-keyed (cdr vs)
                        (cons (string-list-append (list "(" c " (define " c " (lambda (" (words-of xs) ") (sum " c " (product" (if (null? xs) "" " ") (words-of (fields-numbered xs 1 nil)) ")))))")) acc))))
                  (else other (constructors-keyed (cdr vs) acc)))))))

      (define-rec
        (rec-members-keyed (subr kfx (sexps bool (listof string acyclic)) (listof string acyclic))
          (lambda (ms same acc)
            "A `define-rec`'s members, `(NAME TYPE LAMBDA)`, each `(define NAME TYPE
             LAMBDA)`, all but the first marked at the first's position."
            (if (null? ms)
                acc
                (let* ((xs (items (car ms))) (n (tagcase (car xs) (sym (s f p) s) (else other "?"))))
                  (rec-members-keyed (cdr ms) #t
                    (cons (string-list-append (list "(" n " " (kc-datum (lst (cons (sym "define" "" 0) xs) "" 0 0)) (if same " same)" ")"))) acc)))))))

      (define-rec
        (forms-keyed (subr kfx (sexps i64 (listof string acyclic)) (listof string acyclic))
          (lambda (fs k acc)
            "Each form as `(KEY DATUM)`, the newest first; `k` how many forms that
             are no definition, nor a type's, came before. A datatype's form is
             followed by its constructors' (C423), each a form of its own, keyed
             by its name, as a procedure's is."
            (if (null? fs)
                acc
                (let ((n (form-name (car fs))))
                  (cond ((type-form? (car fs))
                         ;; Named apart from `acc`, which a binding of it
                         ;; would hide, so that this call loops (C524).
                         (let ((typed (cons (string-list-append (list "(%type:" (type-form-name (car fs)) " " (kc-datum (car fs)) ")")) acc)))
                           (forms-keyed (cdr fs) k (if (head-is? (car fs) "define-datatype") (constructors-keyed (cdr (cdr (items (car fs)))) typed) typed))))
                        ((head-is? (car fs) "define-rec")
                         ;; Each member a definition of its own, at one position
                         ;; (C426).
                         (forms-keyed (cdr fs) k (rec-members-keyed (cdr (items (car fs))) #f acc)))
                        ((string=? n "")
                         (forms-keyed (cdr fs) (i64+ k 1) (cons (string-list-append (list "(#expr" (i64->string k) " " (kc-datum (car fs)) ")")) acc)))
                        (else (forms-keyed (cdr fs) k (cons (string-list-append (list "(" n " " (kc-datum (car fs)) ")")) acc)))))))))

      (define-rec
        (kc-set-forms! (subr qe (db string sexps i64) unit)
          (lambda (d path keyed i)
            "Each `(KEY DATUM)`'s inputs, `i` its position; `(KEY DATUM same)`
             at the position of the one before, a `define-rec`'s member
             (C426), so that its group's members see each other."
            (if (null? keyed)
                #u
                (let* ((x (items (car keyed)))
                       (k (tagcase (car x) (sym (n f p) n) (else other "")))
                       (same (i64= (size x) 3))
                       (at (if same (i64- i 1) i)))
                  (begin
                    (db-set! d (key2 "form" path k) (kc-datum (second x)) 0)
                    (db-set! d (key2 "position" path k) (i64->string at) 0)
                    (kc-set-forms! d path (cdr keyed) (i64+ at 1))))))))

      (define-rec
        (kc-unset-forms! (subr qe (db string (listof string acyclic)) unit)
          (lambda (d path ks)
            "Each of `ks`, a form no longer there: no form, and no position."
            (if (null? ks)
                #u
                (begin
                  (db-set! d (key2 "form" path (car ks)) "()" 0)
                  (db-set! d (key2 "position" path (car ks)) "-1" 0)
                  (kc-unset-forms! d path (cdr ks))))))))

    (hide
      "Modules (C425): a top-level module's items made top-level forms of their
       own, each named `m..x`, the module's own names renamed so in them (a
       binder of the same name hiding it, as the checker's scopes do); the
       module itself the product of what it gives, in order, as Fixpt makes
       a module's value; `(with m E)` of such a module `E` its names renamed
       so; `(import m x ...)` each `(define x m..x)`. A module given as a
       value (`with` of a variable), a maker, a module in a module: not yet."
      (define-datatype kmod (kmod string (listof string acyclic)))
      (define-datatype renaming (renaming string string))

      (define-rec
        (renaming-of (subr kfx (string (listof renaming acyclic)) string)
          (lambda (n rs)
            (cond ((null? rs) "")
                  ((tagcase (car rs) (renaming (a b) (string=? a n))) (tagcase (car rs) (renaming (a b) b)))
                  (else (renaming-of n (cdr rs)))))))

      (define-rec
        (renamings-without (subr kfx ((listof renaming acyclic) (listof string acyclic)) (listof renaming acyclic))
          (lambda (rs ns)
            (cond ((null? rs) nil)
                  ((tagcase (car rs) (renaming (a b) (string-member? a ns))) (renamings-without (cdr rs) ns))
                  (else (cons (car rs) (renamings-without (cdr rs) ns)))))))

      (define binder-name (subr kfx (sexp) string)
        (lambda (b) (tagcase b (sym (n f p) n) (lst (ys f l p) (if (null? ys) "" (tagcase (car ys) (sym (n f2 p2) n) (else other "")))) (else other ""))))

      (define-rec
        (renamed (subr kfx (sexp (listof renaming acyclic)) sexp)
          (lambda (e rs)
            "`e`, each name `rs` renames that no binder in it hides renamed."
            (if (null? rs)
                e
                (tagcase e
                  (sym (n f p) (let ((to (renaming-of n rs))) (if (string=? to "") e (sym to f p))))
                  (lst (xs f l p)
                    (cond ((null? xs) e)
                          ((sym-is? (car xs) "quote") e)
                          ((and (sym-is? (car xs) "lambda") (i64>= (size xs) 3))
                           (lst (cons (car xs) (cons (second xs) (renamed-all (cdr (cdr xs)) (renamings-without rs (map binder-name (items (second xs))))))) f l p))
                          ((and (sym-is? (car xs) "let") (i64>= (size xs) 3) (tagcase (second xs) (lst (ys f2 l2 p2) #t) (else other #f)))
                           (lst (cons (car xs) (cons (lst (map (lambda ((b sexp)) (tagcase b (lst (bs f2 l2 p2) (lst (cons (car bs) (renamed-all (cdr bs) rs)) f2 l2 p2)) (else other b))) (items (second xs))) f l p)
                                                     (renamed-all (cdr (cdr xs)) (renamings-without rs (map binder-name (items (second xs)))))))
                                f l p))
                          ((and (sym-is? (car xs) "let*") (i64>= (size xs) 3))
                           (lst (cons (car xs) (let*-renamed (items (second xs)) (cdr (cdr xs)) rs nil f l p)) f l p))
                          ((and (sym-is? (car xs) "tagcase") (i64>= (size xs) 2))
                           (lst (cons (car xs) (cons (renamed (second xs) rs)
                                                     (map (lambda ((a sexp))
                                                            (tagcase a
                                                              (lst (as f2 l2 p2)
                                                                (if (null? as) a
                                                                    (let ((hidden (tagcase (second as) (lst (bs f3 l3 p3) (map binder-name bs)) (sym (n f3 p3) (the strings (list n))) (else other nil))))
                                                                      (lst (cons (car as) (cons (second as) (renamed-all (cdr (cdr as)) (renamings-without rs hidden)))) f2 l2 p2))))
                                                              (else other a)))
                                                          (cdr (cdr xs)))))
                                f l p))
                          (else (lst (renamed-all xs rs) f l p))))
                  (else other e)))))
        (renamed-all (subr kfx (sexps (listof renaming acyclic)) sexps)
          (lambda (es rs) (map (lambda ((e sexp)) (renamed e rs)) es)))
        (let*-renamed (subr kfx (sexps sexps (listof renaming acyclic) sexps string i64 i64) sexps)
          (lambda (bs body rs done f l p)
            (if (null? bs)
                (cons (lst (reverse done) f l p) (renamed-all body rs))
                (let ((b (car bs)))
                  (let*-renamed (cdr bs) body (renamings-without rs (list (binder-name b)))
                                (cons (tagcase b (lst (ys f2 l2 p2) (lst (cons (car ys) (renamed-all (cdr ys) rs)) f2 l2 p2)) (else other b)) done)
                                f l p))))))

      (define-rec
        (module-of (subr kfx (string (listof kmod acyclic)) (listof kmod acyclic))
          (lambda (n ms)
            (cond ((null? ms) nil)
                  ((tagcase (car ms) (kmod (m es) (string=? m n))) (list (car ms)))
                  (else (module-of n (cdr ms)))))))

      (define qualified (subr kfx (string (listof string acyclic)) (listof renaming acyclic))
        (lambda (m ns) (map (lambda ((n string)) (renaming n (string-append m (string-append ".." n)))) ns)))

      (define-rec
        (withs-expanded (subr kfx (sexp (listof kmod acyclic)) sexp)
          (lambda (e ms)
            "Each `(with m E)` of a module `ms` knows, its `E` with `m`'s names."
            (tagcase e
              (lst (xs f l p)
                (cond ((null? xs) e)
                      ((sym-is? (car xs) "quote") e)
                      ((and (sym-is? (car xs) "with") (i64= (size xs) 3)
                            (tagcase (second xs) (sym (n f2 p2) (not (null? (module-of n ms)))) (else other #f)))
                       (tagcase (car (module-of (sym-name (second xs)) ms))
                         (kmod (m es) (withs-expanded (renamed (third xs) (qualified m es)) ms))))
                      (else (lst (map (lambda ((x sexp)) (withs-expanded x ms)) xs) f l p))))
              (else other e)))))

      "A module's items as kc flattens them (C471): a load's mark,
       `(%loaded ...)`, none; an `(include M)` of a module `ms` knows, each
       of `M`'s names given, `(define n M..n)` (a load's module named, `(define
       s (load-module ...))`, kfx's `(module (include made--load--K))`)."
      (define items-included (subr kfx (sexps (listof kmod acyclic)) sexps)
        (lambda (its ms)
          (concat (map (lambda ((it sexp))
                         (cond ((head-is? it "%loaded") nil)
                               ((and (head-is? it "include") (i64= (size (items it)) 2)
                                     (tagcase (second (items it)) (sym (n f p) (not (null? (module-of n ms)))) (else other #f)))
                                (tagcase (car (module-of (sym-name (second (items it))) ms))
                                  (kmod (m es) (map (lambda ((n string)) (lst (list (sym "define" "" 0) (sym n "" 0) (sym (string-append m (string-append ".." n)) "" 0)) "" 0 0)) es))))
                               (else (list it))))
                       its))))

      (define-rec
        (module-items (subr kfx (sexps bool (listof sexp acyclic)) sexps)
          (lambda (its hidden acc)
            "A module's items, `hide`s opened, each marked hidden or not:
             `(hidden ITEM)`, `(given ITEM)`."
            (if (null? its)
                (reverse acc)
                (let ((it (car its)))
                  (if (head-is? it "hide")
                      (module-items (cdr its) hidden (onto (reverse (module-items (cdr (items it)) #t nil)) acc))
                      (module-items (cdr its) hidden (cons (lst (list (sym (if hidden "hidden" "given") "" 0) it) "" 0 0) acc))))))))

      (define item-defined (subr kfx (sexp) string)
        (lambda (it) (if (head-is? it "define") (form-name it) (if (type-form? it) (type-form-name it) ""))))

      (define module-form? (subr kfx (sexp) bool)
        (lambda (f) (and (head-is? f "define") (i64>= (size (items f)) 3) (head-is? (car (reverse (items f))) "module"))))

      (define-rec
        (fields-of-names (subr kfx ((listof string acyclic) i64 sexps) sexps)
          (lambda (ns i acc)
            (if (null? ns) (reverse acc)
                (fields-of-names (cdr ns) (i64+ i 1) (cons (lst (list (num i "" 0) (sym (car ns) "" 0)) "" 0 0) acc))))))

      "A file of a place's interface (C471): its maker's type's name,
       `MK--face` (kfx's `place-made`), and its values' names, in order."
      (define-datatype kface (kface string (listof string acyclic)))

      (define faces-of (subr kfx (sexps) (listof kface acyclic))
        (lambda (fs)
          (concat (map (lambda ((f sexp))
                         (if (and (head-is? f "define-type") (i64= (size (items f)) 3)
                                  (tagcase (second (items f))
                                    (lst (ys f2 l2 p2) (and (not (null? ys)) (tagcase (car ys) (sym (n f3 p3) (has-suffix? n "--face")) (else other #f))))
                                    (else other #f))
                                  (head-is? (third (items f)) "moduleof"))
                             (the (listof kface acyclic)
                               (list (kface (sym-name (car (items (second (items f)))))
                                            (map (lambda ((v sexp)) (sym-name (second (items v))))
                                                 (filter (lambda ((v sexp)) (head-is? v "val")) (cdr (items (third (items f)))))))))
                             nil))
                       fs))))

      (define face-named (subr kfx (string (listof kface acyclic)) (listof kface acyclic))
        (lambda (mk faces)
          (filter (lambda ((k kface)) (tagcase k (kface (n vs) (string=? n (string-append mk "--face"))))) faces)))

      "Substitution (C471): a name for an expression, as `renamed` renames."
      (define-datatype ksub (ksub string sexp))

      (define-rec
        (subs-without (subr kfx ((listof ksub acyclic) (listof string acyclic)) (listof ksub acyclic))
          (lambda (ss ns) (filter (lambda ((x ksub)) (tagcase x (ksub (n e) (not (string-member? n ns))))) ss)))
        (substituted (subr kfx (sexp (listof ksub acyclic)) sexp)
          (lambda (e ss)
            "`e`, each name `ss` has that no binder in it hides its expression."
            (if (null? ss)
                e
                (tagcase e
                  (sym (n f p) (let ((hit (filter (lambda ((x ksub)) (tagcase x (ksub (m v) (string=? m n)))) ss)))
                                 (if (null? hit) e (tagcase (car hit) (ksub (m v) v)))))
                  (lst (xs f l p)
                    (cond ((null? xs) e)
                          ((sym-is? (car xs) "quote") e)
                          ((and (sym-is? (car xs) "lambda") (i64>= (size xs) 3))
                           (lst (cons (car xs) (cons (second xs) (substituted-all (cdr (cdr xs)) (subs-without ss (map binder-name (items (second xs))))))) f l p))
                          ((and (or (sym-is? (car xs) "let") (sym-is? (car xs) "letrec")) (i64>= (size xs) 3) (tagcase (second xs) (lst (ys f2 l2 p2) #t) (else other #f)))
                           (let* ((names (map binder-name (items (second xs))))
                                  (in-values (if (sym-is? (car xs) "letrec") (subs-without ss names) ss)))
                             (lst (cons (car xs) (cons (lst (map (lambda ((b sexp)) (tagcase b (lst (bs f2 l2 p2) (lst (cons (car bs) (substituted-all (cdr bs) in-values)) f2 l2 p2)) (else other b))) (items (second xs))) f l p)
                                                       (substituted-all (cdr (cdr xs)) (subs-without ss names))))
                                  f l p)))
                          ((and (sym-is? (car xs) "let*") (i64>= (size xs) 3) (tagcase (second xs) (lst (ys f2 l2 p2) #t) (else other #f)))
                           (if (null? (items (second xs)))
                               (lst (cons (car xs) (cons (second xs) (substituted-all (cdr (cdr xs)) ss))) f l p)
                               ;; One binder at a time: `(let* (b) (let* (rest) body))`.
                               (substituted (lst (list (sym "let" f p) (lst (list (car (items (second xs)))) f l p)
                                                       (lst (cons (sym "let*" f p) (cons (lst (cdr (items (second xs))) f l p) (cdr (cdr xs)))) f l p))
                                                 f l p)
                                            ss)))
                          ((and (sym-is? (car xs) "tagcase") (i64>= (size xs) 2))
                           (lst (cons (car xs) (cons (substituted (second xs) ss)
                                                     (map (lambda ((a sexp))
                                                            (tagcase a
                                                              (lst (as f2 l2 p2)
                                                                (if (null? as) a
                                                                    (let ((hidden (tagcase (second as) (lst (bs f3 l3 p3) (map binder-name bs)) (sym (n f3 p3) (the strings (list n))) (else other nil))))
                                                                      (lst (cons (car as) (cons (second as) (substituted-all (cdr (cdr as)) (subs-without ss hidden)))) f2 l2 p2))))
                                                              (else other a)))
                                                          (cdr (cdr xs)))))
                                f l p))
                          (else (lst (substituted-all xs ss) f l p))))
                  (else other e)))))
        (substituted-all (subr kfx (sexps (listof ksub acyclic)) sexps)
          (lambda (es ss) (map (lambda ((e sexp)) (substituted e ss)) es))))

      "An instance's items, `hide`s opened; a type, an effect, a load's mark,
       none (C471)."
      (define-rec
        (instance-items (subr kfx (sexps) sexps)
          (lambda (its)
            (concat (map (lambda ((it sexp))
                           (cond ((head-is? it "hide") (instance-items (cdr (items it))))
                                 ((or (head-is? it "%loaded") (head-is? it "define-type") (head-is? it "define-effect")) nil)
                                 (else (list it))))
                         its)))))

      "Whether a value is a procedure's, a `lambda` (perhaps under `the`)."
      (define a-lambda? (subr kfx (sexp) bool)
        (lambda (v) (or (head-is? v "lambda") (and (head-is? v "the") (i64= (size (items v)) 3) (head-is? (third (items v)) "lambda")))))

      "An instance's bindings: a `define`'s, as a `letrec`'s, `(n T v)`; a
       `define-rec`'s each."
      (define instance-bindings (subr kfx (sexps) sexps)
        (lambda (its)
          (concat (map (lambda ((it sexp))
                         (cond ((and (head-is? it "define") (i64>= (size (items it)) 3)) (list (lst (cdr (items it)) "" 0 0)))
                               ((head-is? it "define-rec") (cdr (items it)))
                               (else nil)))
                       its))))

      (define-rec
        (slot-subs (subr kfx (sexps i64 (listof ksub acyclic)) (listof ksub acyclic))
          (lambda (vs i acc)
            (if (null? vs)
                (reverse acc)
                (slot-subs (cdr vs) (i64+ i 1)
                           (cons (ksub (binder-name (car vs))
                                       (lst (list (sym "array-ref" "" 0) (sym "instance%env" "" 0) (num i "" 0)) "" 0 0))
                                 acc))))))

      (define-rec
        (slots-set (subr kfx (sexps i64 (listof ksub acyclic) sexps) sexps)
          (lambda (vs i ss acc)
            (if (null? vs)
                (reverse acc)
                (slots-set (cdr vs) (i64+ i 1) ss
                           (cons (lst (list (sym "array-set!" "" 0) (sym "instance%env" "" 0) (num i "" 0) (substituted (car (reverse (items (car vs)))) ss)) "" 0 0)
                                 acc))))))

      (define instance-body (subr kfx (sexps (listof string acyclic)) sexp)
        (lambda (its vals)
          "A module made at each call (C471), its items scoped as a program's
           globals are: each procedure (a value that is a `lambda`) in one
           `letrec`, so that each names any; each other value in a slot of
           an array of the instance's, `instance%env`, set in order, each use
           of its name reading it; then a tuple of its interface's values, in
           order. Its items, in order: a `define-datatype`'s not yet."
          (let* ((items0 (instance-items its))
                 (others (filter (lambda ((it sexp)) (not (or (head-is? it "define") (head-is? it "define-rec")))) items0))
                 (bs (instance-bindings items0))
                 (procs (filter (lambda ((b sexp)) (a-lambda? (car (reverse (items b))))) bs))
                 (values (filter (lambda ((b sexp)) (not (a-lambda? (car (reverse (items b)))))) bs))
                 (ss (slot-subs values 0 nil))
                 (result (substituted (lst (cons (sym "tuple" "" 0) (map (lambda ((n string)) (sym n "" 0)) vals)) "" 0 0) ss))
                 (sets (slots-set values 0 ss nil))
                 (body (lst (cons (sym "begin" "" 0) (onto others (onto sets (list result)))) "" 0 0))
                 (inner (if (null? procs)
                            body
                            (lst (list (sym "letrec" "" 0)
                                       (lst (map (lambda ((b sexp)) (lst (cons (car (items b)) (substituted-all (cdr (items b)) ss)) "" 0 0)) procs) "" 0 0)
                                       body)
                                 "" 0 0))))
            (lst (list (sym "let" "" 0)
                       (lst (list (lst (list (sym "instance%env" "" 0)
                                             (lst (list (sym "make-array" "" 0) (num (size values) "" 0) (num 0 "" 0)) "" 0 0))
                                       "" 0 0))
                            "" 0 0)
                       inner)
                 "" 0 0))))

      (define instance-made (subr kfx (sexp (listof kmod acyclic) (listof kface acyclic)) sexp)
        (lambda (f ms faces)
          "A file of a place's maker (C471; kfx's `place-made`), `(define MK T
           (lambda (p) (module ITEM ...)))`: its module made at each call."
          (if (and (head-is? f "define") (i64= (size (items f)) 4) (not (null? (face-named (form-name f) faces)))
                   (head-is? (fourth (items f)) "lambda") (i64= (size (items (fourth (items f)))) 3)
                   (head-is? (third (items (fourth (items f)))) "module"))
              (let ((l (items (fourth (items f)))))
                (tagcase (car (face-named (form-name f) faces))
                  (kface (n vals)
                    (lst (list (car (items f)) (second (items f)) (third (items f))
                               (lst (list (car l) (second l) (instance-body (items-included (cdr (items (third l))) ms) vals)) "" 0 0))
                         "" 0 0))))
              f)))

      "A local bound to an instance (C471): its name, and its maker's."
      (define-datatype kinst (kinst string string))

      (define env-without (subr kfx ((listof kinst acyclic) (listof string acyclic)) (listof kinst acyclic))
        (lambda (env ns) (filter (lambda ((k kinst)) (tagcase k (kinst (n m) (not (string-member? n ns))))) env)))

      (define instance-of (subr kfx (sexp (listof kface acyclic) (listof kinst acyclic)) (listof kface acyclic))
        (lambda (x faces env)
          "The interface of instance `x`: a local bound to one, or a maker's
           call; else none."
          (tagcase x
            (sym (n f p) (concat (map (lambda ((k kinst)) (tagcase k (kinst (v m) (if (string=? v n) (face-named m faces) nil)))) env)))
            (lst (ys f l p) (if (and (i64= (size ys) 2) (tagcase (car ys) (sym (n f2 p2) #t) (else other #f))) (face-named (sym-name (car ys)) faces) nil))
            (else other nil))))

      (define-rec
        (fields-bound (subr kfx ((listof string acyclic) i64 (listof string acyclic) sexp sexps) sexps)
          (lambda (vals i used x acc)
            "A `let`'s bindings of each value of an interface `used` names, the
             field of instance `x` at its place."
            (cond ((null? vals) (reverse acc))
                  ((string-member? (car vals) used)
                   (fields-bound (cdr vals) (i64+ i 1) used x
                                 (cons (lst (list (sym (car vals) "" 0) (lst (list (sym "extract" "" 0) x (num i "" 0)) "" 0 0)) "" 0 0) acc)))
                  (else (fields-bound (cdr vals) (i64+ i 1) used x acc))))))

      (define-rec
        (instances-in (subr kfx (sexp (listof kface acyclic) (listof kinst acyclic)) sexp)
          (lambda (e faces env)
            "`e`, each `(letrena r B ...)` a `let` of `r` to unit (and a
             `letreap`'s, a process's own place, C544; kc's code has
             one heap, so a place is nothing at run time), and each `(with x E)`
             of an instance a `let` of the names `E` uses of its interface, each
             its field (C471)."
            (tagcase e
              (lst (xs f l p)
                (cond ((null? xs) e)
                      ((sym-is? (car xs) "quote") e)
                      ((and (or (sym-is? (car xs) "letrena") (sym-is? (car xs) "letreap")) (i64>= (size xs) 3))
                       (instances-in (lst (cons (sym "let" f p) (cons (lst (list (lst (list (second xs) (sym "#u" f p)) f l p)) f l p) (cdr (cdr xs)))) f l p)
                                     faces env))
                      ((and (sym-is? (car xs) "with") (i64= (size xs) 3) (not (null? (instance-of (second xs) faces env))))
                       (tagcase (car (instance-of (second xs) faces env))
                         (kface (n vals)
                           (let* ((used (names-in (third xs)))
                                  (x (tagcase (second xs) (sym (v f2 p2) (second xs)) (else other (sym "instance%with" f p))))
                                  (bs (fields-bound vals 1 used x nil))
                                  (body (lst (list (sym "let" f p) (lst bs f l p) (instances-in (third xs) faces (env-without env vals))) f l p)))
                             (tagcase (second xs)
                               (sym (v f2 p2) body)
                               (else other
                                 (lst (list (sym "let" f p) (lst (list (lst (list x (instances-in (second xs) faces env)) f l p)) f l p) body) f l p)))))))
                      ((and (sym-is? (car xs) "lambda") (i64>= (size xs) 3))
                       (lst (cons (car xs) (cons (second xs) (instances-all (cdr (cdr xs)) faces (env-without env (map binder-name (items (second xs))))))) f l p))
                      ((and (or (sym-is? (car xs) "let") (sym-is? (car xs) "letrec") (sym-is? (car xs) "let*")) (i64>= (size xs) 3)
                            (tagcase (second xs) (lst (ys f2 l2 p2) #t) (else other #f)))
                       (let* ((bs (items (second xs)))
                              (names (map binder-name bs))
                              (inner (if (sym-is? (car xs) "let") env (env-without env names)))
                              (bs2 (map (lambda ((b sexp))
                                          (tagcase b
                                            (lst (ys f2 l2 p2) (lst (cons (car ys) (instances-all (cdr ys) faces inner)) f2 l2 p2))
                                            (else other b)))
                                        bs))
                              (made (concat (map (lambda ((b sexp))
                                                   (tagcase b
                                                     (lst (ys f2 l2 p2)
                                                       (tagcase (car (reverse ys))
                                                         (lst (zs f3 l3 p3)
                                                           (if (and (i64= (size zs) 2) (tagcase (car zs) (sym (m f4 p4) (not (null? (face-named m faces)))) (else other #f)))
                                                               (the (listof kinst acyclic) (list (kinst (binder-name b) (sym-name (car zs)))))
                                                               nil))
                                                         (else other nil)))
                                                     (else other nil)))
                                                 bs))))
                         (lst (cons (car xs) (cons (lst bs2 f l p) (instances-all (cdr (cdr xs)) faces (onto made (env-without env names))))) f l p)))
                      ((and (sym-is? (car xs) "tagcase") (i64>= (size xs) 2))
                       (lst (cons (car xs) (cons (instances-in (second xs) faces env)
                                                 (map (lambda ((a sexp))
                                                        (tagcase a
                                                          (lst (as f2 l2 p2)
                                                            (if (null? as) a
                                                                (let ((bound (tagcase (second as) (lst (bs f3 l3 p3) (map binder-name bs)) (sym (n f3 p3) (the strings (list n))) (else other nil))))
                                                                  (lst (cons (car as) (cons (second as) (instances-all (cdr (cdr as)) faces (env-without env bound)))) f2 l2 p2))))
                                                          (else other a)))
                                                      (cdr (cdr xs)))))
                            f l p))
                      (else (lst (instances-all xs faces env) f l p))))
              (else other e))))
        (instances-all (subr kfx (sexps (listof kface acyclic) (listof kinst acyclic)) sexps)
          (lambda (es faces env) (map (lambda ((e sexp)) (instances-in e faces env)) es))))

      (define-rec
        (modules-expanded (subr kfx (sexps (listof kmod acyclic) sexps (listof kface acyclic)) sexps)
          (lambda (fs ms acc faces)
            (if (null? fs)
                (reverse acc)
                (let ((f (car fs)))
                  (cond ((module-form? f)
                         (let* ((m (form-name f))
                                (its (module-items (items-included (cdr (items (car (reverse (items f))))) ms) #f nil))
                                (names (filter (lambda ((n string)) (not (string=? n ""))) (map (lambda ((x sexp)) (item-defined (second (items x)))) its)))
                                (given (concat (map (lambda ((x sexp)) (if (and (sym-is? (car (items x)) "given") (head-is? (second (items x)) "define"))
                                                                          (the strings (list (form-name (second (items x)))))
                                                                          nil))
                                                    its)))
                                (rs (qualified m names))
                                (defs (map (lambda ((x sexp))
                                             (let ((it (withs-expanded (second (items x)) ms)))
                                               (tagcase it
                                                 (lst (ys f2 l2 p2)
                                                   (lst (cons (car ys) (cons (renamed (second ys) rs) (renamed-all (cdr (cdr ys)) rs))) f2 l2 p2))
                                                 (else other it))))
                                           its))
                                (value (lst (list (sym "define" "" 0) (sym m "" 0)
                                                  (lst (cons (sym "product" "" 0) (fields-of-names (map (lambda ((n string)) (string-append m (string-append ".." n))) given) 1 nil)) "" 0 0))
                                            "" 0 0)))
                           (modules-expanded (cdr fs) (cons (kmod m given) ms) (cons value (onto (reverse defs) acc)) faces)))
                        ((and (head-is? f "import") (i64>= (size (items f)) 2)
                              (tagcase (second (items f)) (sym (n f2 p2) (not (null? (module-of n ms)))) (else other #f)))
                         (let ((m (sym-name (second (items f)))))
                           (modules-expanded (cdr fs) ms
                             (onto (reverse (concat (map (lambda ((x sexp))
                                                           (tagcase x
                                                             (sym (n f2 p2) (the sexps (list (lst (list (sym "define" "" 0) x (sym (string-append m (string-append ".." n)) "" 0)) "" 0 0))))
                                                             (else other nil)))
                                                         (cdr (cdr (items f))))))
                                   acc)
                             faces)))
                        ;; Its forms of processes the scheduler's calls (C544).
                        (else (modules-expanded (cdr fs) ms (cons (withs-expanded (instances-in (instance-made (processes-rewritten f) ms faces) faces nil) ms) acc) faces)))))))))

    "Whether the file `PATH`'s text is as it was (C417): its forms' inputs
     are too, not read again."
    (define kc-text-as-was? (subr qe (db string string) bool)
      (lambda (d path text)
        (let ((t (db-node d (key1 "text" path))))
          (and (not (null? t)) (string=? (node-value d (car t)) text)))))

    "`kc-load-forms! PATH TEXT FORMS EXPANDED`: the file `PATH`'s text, and
     the inputs made of its forms `forms` (C414): each form's datum and
     position, the keys in order; a form no longer there, `()`. An input set
     to what it was is no change (`db-set!`), so a run with the text as it
     was changes nothing. `forms` are as read, or, of a file that defines a
     macro, as kc expanded them (C445, `kc/expand.kfx`), `expanded`, the
     `expanded PATH` input, says so (`kc-program-forms`): `` of a file that
     defines none."
    (define kc-load-forms! (subr qe (db string string sexps string) unit)
      (lambda (d path text forms expanded)
        (let* ((kd (lambda ((x sexp)) (tagcase (car (items x)) (sym (n f p) n) (else other ""))))
               (keyed (map (lambda ((t string)) (car (read-all t "forms" 1))) (reverse (forms-keyed (modules-expanded forms nil nil (faces-of forms)) 0 nil))))
               (keys (map kd keyed))
               (keys-text (string-append "(" (string-append (words-of keys) ")")))
               (old (db-node d (key1 "keys" path)))
               (old-keys (if (null? old) nil
                             (map (lambda ((x sexp)) (tagcase x (sym (n f p) n) (else other "")))
                                  (items (car (read-all (node-value d (car old)) "keys" 1)))))))
          (begin
            (db-set! d (key1 "text" path) text 0)
            (db-set! d (key1 "expanded" path) expanded 0)
            (kc-set-forms! d path keyed 0)
            (if (and (not (null? old)) (not (string=? (node-value d (car old)) keys-text)))
                (kc-unset-forms! d path (filter (lambda ((k string)) (not (string-member? k keys))) old-keys))
                #u)
            (db-set! d (key1 "keys" path) keys-text 0)))))

    "`kc-load! PATH TEXT`: the file `PATH`'s text, read once, and its forms'
     inputs, as read (`kc-load-forms!`)."
    (define kc-load! (subr qe (db runner string string) unit)
      (lambda (d run path text)
        (if (kc-text-as-was? d path text) #u (kc-load-forms! d path text (read-all text path 1) ""))))

    "`expanded PATH` of a file `kc-load-forms!` set none of: ``."
    (define q-expanded qbody (lambda (d run a-path a-key) ""))

    "A located datum's text (C445), as kc's `expanded PATH` and `expansion
     PATH KEY` keep a form's: `(1 file line pos node ...)`, a list,
     `(0 file line pos atom)`, an atom, each where it is; read as the
     reader's datum, there."
    (define-rec
      (kc-unlocated (subr kfx (sexp) sexp)
        (lambda (n)
          (let* ((xs (items n))
                 (at (lambda ((e sexp)) (tagcase e (num (i f p) i) (else other (the i64 0)))))
                 (f (tagcase (second xs) (str (t f2 p2) t) (else other "")))
                 (l (at (third xs)))
                 (p (at (fourth xs)))
                 (rest (cdr (cdr (cdr (cdr xs))))))
            (if (i64= (at (car xs)) 1)
                (lst (map kc-unlocated rest) f l p)
                (tagcase (car rest)
                  (sym (x f2 p2) (sym x f p))
                  (num (i f2 p2) (num i f p))
                  (big (t f2 p2) (big t f p))
                  (real (t f2 p2) (real t f p))
                  (chr (c f2 p2) (chr c f p))
                  (str (t f2 p2) (str t f p))
                  (lst (ys f2 l2 p2) (lst ys f l p))))))))

    (hide
      "A file's forms, as read; of a file that defines a macro, as kc
       expanded them (C445): `expanded PATH`, the forms' located data, or
       `(refused MESSAGE)`; `` of one that defines none."
      (define kc-program-forms (subr qe (db runner string) sexps)
        (lambda (d run path)
          (let ((x (db-get d run (key1 "expanded" path))))
            (if (string=? x "")
                (read-all (db-get d run (key1 "text" path)) path 1)
                (map kc-unlocated (read-all x "expanded" 1)))))))

    "The refusal an expansion came to (C445), or ``."
    (define kc-expansion-refusal (subr qe (db runner string) string)
      (lambda (d run path)
        (let ((x (db-get d run (key1 "expanded" path))))
          (if (has-prefix? x "(refused ")
              (tagcase (second (items (car (read-all x "expanded" 1)))) (str (m f p) m) (else other "?"))
              ""))))

    (define kc-keys (subr qe (db runner string) (listof string acyclic))
      (lambda (d run path)
        (map (lambda ((x sexp)) (tagcase x (sym (n f p) n) (else other ""))) (items (car (read-all (db-get d run (key1 "keys" path)) "keys" 1))))))

    "`form PATH KEY` of a key `kc-load!` set none of: a name the program does
     not define, `()`; and `position PATH KEY`, -1 (C414)."
    (define q-form qbody (lambda (d run a-path a-key) "()"))

    (define q-position qbody (lambda (d run a-path a-key) "-1"))

    (hide
      "A file's forms, as read, or as expanded (C445)."
      (define kc-forms (subr qe (db runner string) sexps)
        (lambda (d run path) (kc-program-forms d run path))))

    (define kc-form (subr qe (db runner string string) sexp)
      (lambda (d run path key) (car (read-all (db-get d run (key2 "form" path key)) path 1))))

    "A definition's value, and whether it is a `lambda` (perhaps under `the`)."
    (define define-value (subr kfx (sexp) sexp)
      (lambda (f) (car (reverse (items f)))))

    (define lambda-of (subr kfx (sexp) sexps)
      (lambda (v)
        "A value's `lambda`, as a list of one, or none."
        (tagcase v
          (lst (xs f l p)
            (cond ((and (not (null? xs)) (sym-is? (car xs) "lambda") (i64>= (size xs) 3)) (list v))
                  (else nil)))
          (else other nil))))

    "`interface PATH KEY`."
    (define q-interface qbody
      (lambda (d run a-path a-key)
        (let ((f (kc-form d run a-path a-key)))
          (cond ((type-form? f) "(none)")
                ((string=? (form-name f) "")
              "(expr)")
              (else
              (let ((l (lambda-of (define-value f))))
                (if (null? l)
                    (string-append "(value " (string-append (form-name f) ")"))
                    (string-list-append (list "(proc " (form-name f) " " (i64->string (size (items (second (items (car l)))))) ")")))))))))

    "Where form `key` is among the forms."
    (define kc-position (subr qe (db runner string string) i64)
      (lambda (d run path key)
        (string->i64 (db-get d run (key2 "position" path key)))))

    "What `name` is to the form at `at` (C414, C416): its definition's
     interface, `(proc NAME ARITY)` or `(value NAME)`, if one comes before;
     else `(none NAME)`. A name's interface read, and its position if it is
     defined, and nothing else: so that a form depends on the names it looks
     up, each alone."
    (define kc-scope-entry (subr qe (db runner string i64 string) sexp)
      (lambda (d run path at name)
        (let ((i (car (read-all (db-get d run (key2 "interface" path name)) "scope" 1))))
          (if (and (or (sym-is? (car (items i)) "proc") (sym-is? (car (items i)) "value")) (i64<= (kc-position d run path name) at))
              i
              (lst (list (sym "none" "" 0) (sym name "" 0)) "" 0 0)))))

    ;;; ------------------------------------------------------------ checking
    (hide
      "What a check comes to (C415): the types found, as text, and the memos
       made; or a refusal's message."
      (define-datatype check-outcome (check-passed string memos) (check-refused string))

      (define check-outcome-of (subr kfx (string sexps strings memos) check-outcome)
        (lambda (path forms texts old)
          (tagcase (with incremental-check (check-program-memo forms texts old #f))
            (checked-memo (done found made)
              (begin
                (if (string=? (kc-language path) "kfx") (with restrictions (restrict forms (cv-facts done))) #u)
                (check-passed (words-of (map (lambda ((t typed)) (tagcase t (typed (n ty) (string-list-append (list "(" n " " (kc-datum ty) ")")))))
                                             found))
                              made)))))))

    "`checked PATH`: the file checked, as FX-26, or as KFX for a `.kfx` file:
     `(ok (NAME TYPE) ...)`, the types the checker found of the definitions
     written with none (C407); or `(refused MESSAGE)`, the checker's refusal
     (C415), a value as any other, so that a run that meets one ends as any
     other does, its work kept, and a `kc serve` goes on."
    (define q-checked qbody
      (lambda (d run path a-key)
        ;; Checked with the memos the last check left (C415, kfx's of C384):
        ;; a form whose text, and the bindings of the names it reads, and the
        ;; forms before it, are as they were, is not checked again, its
        ;; change to the checker's state replayed. Content-addressed, the
        ;; memos are no input: they spare work, and change no value.
        (let* ((text (db-get d run (key1 "text" path)))
               (expanded (db-get d run (key1 "expanded" path)))
               ;; FX-26's `import` expanded as it is read, as kfx's `with-loads`
               ;; does (C425).
               (forms (import-items (kc-program-forms d run path)))
               ;; A form's memo is addressed by its text: as written, its
               ;; file's; as expanded (C445), the datum's.
               (texts (if (string=? expanded "")
                          (with incremental-check (form-texts text (string-length-i64 text) (map datum-pos forms)))
                          (map kc-datum forms)))
               (side (string-append "check-memos " path))
               (old ((with queries memos-of-text) (db-side d side) "kc")))
          ;; The checker's refusal, an `error`, caught (FX-26's `attempt`): the
          ;; check writes nothing, so a refusal half way leaves nothing to undo;
          ;; the memos are kept as they were.
          (tagcase (if (string=? (kc-expansion-refusal d run path) "")
                       (attempt (check-outcome-of path forms texts old) (lambda ((m string)) (check-refused m)))
                       ;; Refused as it was expanded (C445): not checked.
                       (check-refused (kc-expansion-refusal d run path)))
            (check-passed (t made)
              (begin
                (db-side-put! d side ((with queries memos-text) made "kc"))
                (string-append "(ok " (string-append t ")"))))
            (check-refused (m) (string-append "(refused " (string-append (kc-datum (str m "" 0)) ")")))))))

    "A `checked`'s value: its refusal's message, `` if it passed; the types
     it found."
    (define kc-refusal (subr kfx (string) string)
      (lambda (v)
        (let ((x (items (car (read-all v "checked" 1)))))
          (if (sym-is? (car x) "refused") (tagcase (second x) (str (m f p) m) (else other "?")) ""))))

    (hide
      (define kc-checked-types (subr qe (db runner string) sexps)
        (lambda (d run path)
          (let ((v (db-get d run (key1 "checked" path))))
            (if (string=? (kc-refusal v) "")
                (cdr (items (car (read-all v "checked" 1))))
                (begin (error (kc-refusal v)) nil))))))

    "`type PATH NAME`: a definition's type, as written, or as the checker
     found it (C407)."
    (define q-type qbody
      (lambda (d run a-path a-key)
        (let* ((path a-path) (name a-key)
               (f (kc-form d run path name)))
          (if (i64= (size (items f)) 4)
              (kc-datum (third (items f)))
              (let ((found (filter (lambda ((x sexp)) (sym-is? (car (items x)) name))
                                   (kc-checked-types d run path))))
                (if (null? found) "()" (kc-datum (second (items (car found))))))))))

    (define kc-type (subr qe (db runner string string) sexp)
      (lambda (d run path name) (car (read-all (db-get d run (key2 "type" path name)) "type" 1))))

    "`kfx PATH`: the file checked and passing KFX's restrictions, whatever its
     name says, as the Rust back end needs it; `ok`."
    (define q-kfx qbody
      (lambda (d run path a-key)
        ;; A `.kfx` file's check restricts it already (C415): not checked twice.
        (if (string=? (kc-language path) "kfx")
            (begin (db-get d run (key1 "checked" path)) "ok")
            (let* ((forms (kc-forms d run path))
                   (v (check-program forms)))
              (begin (with restrictions (restrict forms (verdict-facts v))) "ok")))))))
