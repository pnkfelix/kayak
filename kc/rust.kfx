"rust.kfx: kc's Rust back end (docs/research/kc.md), of KFX: `rust PATH`,
 a module whose `main` gives the program's value as Fixpt writes it, on
 kayak-rt (its `Show`, which writes values as `fixpt eval` does)."

(define-rec
  (hex-digits (subr kfx (i64 string) string)
    (lambda (n acc)
      (let* ((d (i64-remainder n 16))
             (c (list->string (list (i64->char (if (i64< d 10) (i64+ d 48) (i64+ d 87))))))
             (acc (string-append c acc)))
        (if (i64< n 16) acc (hex-digits (i64-quotient n 16) acc))))))

"A primitive's kayak-rt function: its name as kfx spells it in Rust
 (`names.kfx`'s `mangle`: `char->integer` is `char_to_integer`, `+` is
 `_plus`), as kayak-rt names FX-26's standard operations (C402, C403)."
(define rust-primitive (subr kfx (string) string) (lambda (n) (mangle n)))

(define-rec
 (rust-of (subr kfx (sexp) string)
  (lambda (t)
    "A term as a Rust expression of kayak-rt's."
    (let ((h (term-head t)) (n (term-number t)))
      (cond ((and (string=? h "prim") (string=? (prim-name t) "eq?"))
             ;; Of immediates, which are equal as values (C403).
             (string-list-append (list "(" (rust-of (car (prim-args t))) " == " (rust-of (second (prim-args t))) ")")))
            ((string=? h "prim")
             (string-list-append (list (rust-primitive (prim-name t)) "(" (rust-args (prim-args t)) ")")))
            ((string=? h "int") (string-append "int_lit(" (string-append (i64->string n) "i64)")))
            ((string=? h "bool") (if (i64= n 1) "true" "false"))
            ((string=? h "char") (string-append "'\\u{" (string-append (hex-digits n "") "}'")))
            ((string=? h "unit") "()")
            ((string=? h "nil") "nil::<()>()")
            (else (begin (error (string-append "kc: the Rust back end has no term " h)) ""))))))
 (rust-args (subr kfx (sexps) string)
  (lambda (ts)
    (cond ((null? ts) "")
          ((null? (cdr ts)) (rust-of (car ts)))
          (else (string-append (rust-of (car ts)) (string-append ", " (rust-args (cdr ts)))))))))

(define q-rust qbody
  (lambda (d run path)
    (begin
     (db-get d run (string-append "kfx " path))
     (string-list-append
      (list "// Made by kc (docs/research/kc.md) from " path ".\n"
            "use kayak_rt::*;\n\n"
            "pub fn main() -> Str {\n"
            "    let mut out = String::new();\n"
            "    Show::show(&" (rust-of (l0-term d run path)) ", &mut out);\n"
            "    shown(out)\n"
            "}\n")))))
