"rust.kfx: kc's Rust back end (docs/research/kc.md), of KFX: `rust PATH`,
 a module whose `main` makes the program's forms in order and gives its
 last expression's value as Fixpt writes it, on kayak-rt (its `Show`,
 which writes values as `fixpt eval` does).

 Each form's Rust is a query of its own, `rust-item PATH KEY` (C407): a
 procedure a Rust function, `kcp_NAME`, its types its declared ones; a
 value definition a thread's cell, `KCG_NAME`, set as `main` comes to it
 (so that it is made where Fixpt makes it, and fails there), read through
 `kcg_NAME()`; an expression a statement of `main`. A lambda (C412) is kayak-rt's
 closure (C481, C493): `closureN` of its free variables, a tuple, and a
 `fn` of them and its parameters; a procedure's type `ProcN`, called by
 `.call`."

"A primitive's kayak-rt function: its name as kfx spells it in Rust
 (`names.kfx`'s `mangle`: `char->integer` is `char_to_integer`, `+` is
 `_plus`), as kayak-rt names FX-26's standard operations (C402, C403)."

(define kc-rust
  (module
    (hide
      (import kc-front kc-hex kc-datum kc-items-of kc-keys kc-type (type qbody))
      (import kc-l0 not-yet l0-item term-head item-kind item-name item-params item-body call-name call-args let-bindings let-body if-parts seq-terms prim-name prim-args term-number term-text lambda-params lambda-free app-fn app-args gproc-arity))

    (hide
      (define rust-primitive (subr kfx (string) string) (lambda (n) (mangle n)))

      "A variable's Rust name, of a `(var K NAME)` or a binding `(K NAME E)`:
       its number, then its name as kfx spells it."
      (define rust-variable (subr kfx (sexp) string)
        (lambda (t)
          (tagcase t
            (lst (xs f l p)
              (let ((ys (if (sym-is? (car xs) "var") (cdr xs) xs)))
                (string-list-append (list "v" (tagcase (car ys) (num (k f2 p2) (i64->string k)) (else other "")) "_"
                                          (mangle-bare (tagcase (second ys) (sym (n f2 p2) n) (else other "")))))))
            (else other ""))))

      (define-rec
        (rust-but-last (subr kfx (sexps) sexps)
          (lambda (xs) (if (or (null? xs) (null? (cdr xs))) nil (cons (car xs) (rust-but-last (cdr xs)))))))

      "A global's Rust names: its procedure's, its cell's, its reader's."
      (define rust-proc-name (subr kfx (string) string) (lambda (n) (string-append "kcp_" (mangle-bare n))))

      (define rust-cell-name (subr kfx (string) string) (lambda (n) (string-append "KCG_" (mangle-bare n))))

      (define rust-global-name (subr kfx (string) string) (lambda (n) (string-append "kcg_" (mangle-bare n))))

      (define-rec
        (words-of-commas (subr kfx ((listof string acyclic)) string)
          (lambda (ws) (cond ((null? ws) "") ((null? (cdr ws)) (car ws)) (else (string-append (car ws) (string-append ", " (words-of-commas (cdr ws))))))))))

      "A Rust string literal of `s` (C421)."
      (define-rec
        (rust-escaped (subr kfx ((listof char acyclic) (listof string acyclic)) (listof string acyclic))
          (lambda (cs acc)
            (if (null? cs)
                acc
                (let* ((c (car cs)) (k (char->i64 c)))
                  (rust-escaped (cdr cs)
                                (cons (cond ((char=? c #\") "\\\"")
                                            ((char=? c #\\) "\\\\")
                                            ((char=? c #\newline) "\\n")
                                            ((char=? c #\tab) "\\t")
                                            ((i64< k 32) (string-append "\\u{" (string-append (kc-hex k "") "}")))
                                            (else (list->string (list c))))
                                      acc)))))))

      (define rust-string (subr kfx (string) string)
        (lambda (s) (string-append "\"" (string-append (string-list-append (reverse (rust-escaped (string-chars s) nil))) "\""))))

      "A type as kayak-rt's Rust type."
      (define-rec
        (rust-type (subr kfx (string sexp) string)
          (lambda (path t)
            (tagcase t
              (sym (n f p)
                (cond ((or (string=? n "int") (string=? n "nat")) "Int")
                      ((string=? n "bool") "bool")
                      ((string=? n "char") "char")
                      ((string=? n "unit") "()")
                      ((string=? n "string") "Str")
                      ((string=? n "symbol") "Symbol")
                      (else (not-yet path (string-append "a Rust type of " n)))))
              (lst (xs f l p)
                (cond ((sym-is? (car xs) "nat") "Int")
                      ((sym-is? (car xs) "listof") (string-append "List<" (string-append (rust-type path (second xs)) ">")))
                ;; A ref at a region, kayak-rt's `Ref` (C424).
                ((and (sym-is? (car xs) "ref") (i64= (size xs) 3)) (string-append "Ref<" (string-append (rust-type path (second xs)) ">")))
                ;; An array at a region, kayak-rt's `Array` (C422).
                ((and (sym-is? (car xs) "arrayof") (i64= (size xs) 3)) (string-append "Array<" (string-append (rust-type path (second xs)) ">")))
                ;; A procedure as a value: kayak-rt's closure, a handle (C481, C493).
                ((and (sym-is? (car xs) "subr") (i64= (size xs) 4))
                 (string-list-append (list "kayak_rt::Proc" (i64->string (size (items (third xs)))) "<'static, "
                                           (words-of-commas (append (rust-param-types path (items (third xs))) (list (rust-type path (fourth xs))))) ">")))
                      (else (not-yet path (string-append "a Rust type of " (kc-datum t))))))
              (else other (not-yet path "a Rust type of this")))))
        (rust-param-types (subr kfx (string sexps) (listof string acyclic))
          (lambda (path ts) (if (null? ts) nil (cons (rust-type path (car ts)) (rust-param-types path (cdr ts)))))))

      (define-rec
       (rust-of (subr kfx (sexp) string)
        (lambda (t)
          "A term as a Rust expression of kayak-rt's."
          (let ((h (term-head t)) (n (term-number t)))
            (cond ((string=? h "var") (rust-variable t))
                  ((string=? h "gvar") (string-append (rust-global-name (item-name t)) "()"))
                  ((string=? h "call") (string-list-append (list (rust-proc-name (call-name t)) "(" (rust-args (call-args t)) ")")))
                  ((string=? h "if")
                   (let ((ps (if-parts t)))
                     (string-list-append (list "if " (rust-of (car ps)) " { " (rust-of (second ps)) " } else { " (rust-of (third ps)) " }"))))
                  ((string=? h "let")
                   ;; Each binder's name its own (`l0`'s numbers), so Rust's `let`s
                   ;; in turn are the parallel `let`'s bindings (C404).
                   (string-list-append
                     (append (list "{ ")
                             (append (map (lambda ((b sexp)) (string-list-append (list "let " (rust-variable b) " = " (rust-of (third (items b))) "; "))) (let-bindings t))
                                     (list (rust-of (let-body t)) " }")))))
                  ((string=? h "seq")
                   (string-list-append
                     (append (list "{ ")
                             (append (map (lambda ((e sexp)) (string-list-append (list "let _ = " (rust-of e) "; "))) (rust-but-last (seq-terms t)))
                                     (list (rust-of (car (reverse (seq-terms t)))) " }")))))
                  ;; A pair, a list's (KFX's `cons` makes lists, C197), on
                  ;; kayak-rt's heap; `pair?` of a list, that it is not empty (C406).
                  ((and (string=? h "prim") (string=? (prim-name t) "cons"))
                   (string-list-append (list "heap_cons(" (rust-args (prim-args t)) ")")))
                  ((and (string=? h "prim") (string=? (prim-name t) "pair?"))
                   (string-list-append (list "(!null_p(" (rust-of (car (prim-args t))) "))")))
                  ((and (string=? h "prim") (string=? (prim-name t) "eq?"))
                   ;; Of immediates, which are equal as values (C403).
                   (string-list-append (list "(" (rust-of (car (prim-args t))) " == " (rust-of (second (prim-args t))) ")")))
                  ((string=? h "prim")
                   (string-list-append (list (rust-primitive (prim-name t)) "(" (rust-args (prim-args t)) ")")))
                  ;; A lambda, kayak-rt's closure (C481, C493): its free variables
            ;; a tuple, given again to its code, a `fn` that captures nothing
            ;; (rustc refuses one that does); its parameters typed where
            ;; written (C412). What it captures traced, as FX-26's closure's.
            ((string=? h "lambda")
             (let* ((ps (lambda-params t))
                    (env (string-list-append (list "(" (string-list-append (map (lambda ((v sexp)) (string-append (rust-variable v) ", ")) (lambda-free t))) ")"))))
               (string-list-append
                 (list "kayak_rt::closure" (i64->string (size ps)) "(" env ", |" env
                       (string-list-append (map (lambda ((q sexp)) (string-append ", " (if (i64= (size (items q)) 3)
                                                                                    (string-append (rust-variable q) (string-append ": " (rust-type "" (third (items q)))))
                                                                                    (rust-variable q))))
                                                ps))
                       "| " (rust-of (item-body t)) ")"))))
            ((string=? h "app") (string-list-append (list "(" (rust-of (app-fn t)) ").call(" (rust-args (app-args t)) ")")))
            ;; A procedure of the program's as a value: a closure of nothing
            ;; that calls it (C493).
            ((string=? h "gproc")
             (let ((xs (rust-arg-names 0 (gproc-arity t))))
               (string-list-append (list "kayak_rt::closure" (i64->string (gproc-arity t)) "((), |()"
                                         (string-list-append (map (lambda ((x string)) (string-append ", " x)) xs))
                                         "| " (rust-proc-name (item-name t)) "(" (words-of-commas xs) "))"))))
            ;; A string, kayak-rt's `str_lit` of a Rust literal; a symbol, its
            ;; `sym_lit!` of its name's (C421; C504: its object made as rustc builds).
            ((string=? h "string") (string-append "str_lit!(" (string-append (rust-string (term-text t)) ")")))
            ((string=? h "symbol") (string-append "kayak_rt::sym_lit!(" (string-append (rust-string (term-text t)) ")")))
            ((string=? h "int") (string-append "int_lit(" (string-append (i64->string n) "i64)")))
                  ((string=? h "bool") (if (i64= n 1) "true" "false"))
                  ((string=? h "char") (string-append "'\\u{" (string-append (kc-hex n "") "}'")))
                  ((string=? h "unit") "()")
                  ((string=? h "nil") "nil()")
                  (else (begin (error (string-append "kc: the Rust back end has no term " h)) ""))))))
       (rust-arg-names (subr kfx (i64 i64) strings)
        (lambda (i n)
          "Arguments' names, `a0`, `a1`, ... below `n`, from `i`."
          (if (i64>= i n) nil (cons (string-append "a" (i64->string i)) (rust-arg-names (i64+ i 1) n)))))
       (rust-args (subr kfx (sexps) string)
        (lambda (ts)
          (cond ((null? ts) "")
                ((null? (cdr ts)) (rust-of (car ts)))
                (else (string-append (rust-of (car ts)) (string-append ", " (rust-args (cdr ts)))))))))

      "A procedure's type's parts: `(subr EFFECT (PARAM ...) RESULT)`."
      (define subr-params (subr kfx (sexp) sexps)
        (lambda (t) (tagcase t (lst (xs f l p) (if (i64= (size xs) 4) (items (third xs)) nil)) (else other nil))))

      (define subr-result (subr kfx (sexp) sexp)
        (lambda (t) (tagcase t (lst (xs f l p) (if (i64= (size xs) 4) (fourth xs) t)) (else other t))))

      (define-rec
        (rust-params (subr kfx (sexps (listof string acyclic)) (listof string acyclic))
          (lambda (ps ts)
            (if (or (null? ps) (null? ts)) nil
                (cons (string-append (rust-variable (car ps)) (string-append ": " (car ts))) (rust-params (cdr ps) (cdr ts)))))))

    (define-rec
      (sexp-at (subr kfx (sexps i64) sexp)
        (lambda (xs i) (if (i64= i 0) (car xs) (sexp-at (cdr xs) (i64- i 1))))))

    (hide
      (define item-text (subr kfx (sexp i64) string)
        (lambda (x i) (tagcase (sexp-at (items x) i) (str (s f p) s) (else other "")))))

    "`rust-item PATH KEY`: a form's Rust, `(proc TEXT)` of a procedure's
     function, `(global CELL INIT)` of a value definition's cell and the
     statement that sets it, `(expr STMT)` of an expression's statement."
    (define q-rust-item qbody
      (lambda (d run a-path a-key)
        (let* ((path a-path) (key a-key) (i (l0-item d run path key)) (k (item-kind i)))
          (cond ((string=? k "none") "(none)")
                ((string=? k "proc")
                 (let* ((t (kc-type d run path (item-name i))))
                   (if (not (sym-is? (car (items t)) "subr"))
                       (not-yet path (string-append "a procedure whose type is not a subr's, " (item-name i)))
                       (string-append "(proc "
                         (string-append (kc-datum (str (string-list-append
                                                         (list "pub fn " (rust-proc-name (item-name i)) "("
                                                               (words-of-commas (rust-params (item-params i) (rust-param-types path (subr-params t))))
                                                               ") -> " (rust-type path (subr-result t)) " {\n    "
                                                               (rust-of (item-body i)) "\n}\n"))
                                                       "" 0))
                                        ")")))))
                ((string=? k "global")
                 (let ((ty (rust-type path (kc-type d run path (item-name i)))))
                   (string-list-append
                     (list "(global "
                           (kc-datum (str (string-list-append
                                            (list "thread_local! { static " (rust-cell-name (item-name i)) ": std::cell::Cell<Option<" ty ">> = const { std::cell::Cell::new(None) }; }\n"
                                                  "fn " (rust-global-name (item-name i)) "() -> " ty " { " (rust-cell-name (item-name i)) ".with(|c| c.get().unwrap()) }\n"))
                                          "" 0))
                           " "
                           (kc-datum (str (string-list-append (list "    " (rust-cell-name (item-name i)) ".with(|c| c.set(Some(" (rust-of (item-body i)) ")));\n")) "" 0))
                           ")"))))
                (else
                 ;; `nil` alone: of no element type a use would say.
                 (let ((t (item-body i)))
                   (string-append "(expr "
                     (string-append (kc-datum (str (string-list-append
                                                     (list "    last = String::new();\n    Show::show(&"
                                                           (if (string=? (term-head t) "nil") "nil::<()>()" (rust-of t))
                                                           ", &mut last);\n"))
                                                   "" 0))
                                    ")"))))))))

    (define q-rust qbody
      (lambda (d run path a-key)
        (begin
          (db-get d run (key1 "kfx" path))
          (let ((its (kc-items-of d run "rust-item" path (kc-keys d run path))))
            (string-list-append
              (append (list "// Made by kc (docs/research/kc.md) from " path ".\n"
                            "#![allow(unused)]\n"
                            "use kayak_rt::*;\n\n")
                      (append (map (lambda ((x sexp)) (if (or (sym-is? (car (items x)) "expr") (sym-is? (car (items x)) "none")) "" (item-text x 1))) its)
                              (append (list "\npub fn main() -> Str {\n    let mut last = String::new();\n")
                                      (append (map (lambda ((x sexp)) (cond ((sym-is? (car (items x)) "global") (item-text x 2))
                                                                            ((sym-is? (car (items x)) "expr") (item-text x 1))
                                                                            (else ""))) its)
                                              (list "    shown(last)\n}\n"))))))))))))
