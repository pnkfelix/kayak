"phase1-read.kfx: what kc adds to a procedural macro's transformer's
 phase-1 program (C448), FX-26 it compiles as the rest: `%phase1-read`, a
 reader of the data Fixpt's expander writes a use as (lists, a dotted
 tail, symbols, fixnums, strings, characters, booleans), `%phase1-unread`
 of any other (a vector, a keyword, a number past a fixnum); and
 `%phase1-apply`, of each style, the transformer called on the use read
 from its text and the tag's, as `phase1-called` calls it. So a
 transformer's program is built once, and each use is a run of it, given
 the use (`kc_apply_entry`, kayak-kcrt's `--apply`). Checked by Fixpt as
 by kc: each test of a procedural macro runs through it."

(define phase1-reader string
  "(define %phase1-read (subr spin (string) datum)
  (letrec ((white? (subr spin (char) bool)
             (lambda (c) (or (char=? c #\\space) (char=? c #\\newline) (char=? c #\\tab) (char=? c #\\return))))
           (delim? (subr spin (char) bool)
             (lambda (c) (or (white? c) (char=? c #\\() (char=? c #\\)) (char=? c #\\\"))))
           (skip (subr spin (string int) int)
             (lambda (s i) (if (< i (string-length s)) (if (white? (string-ref s i)) (skip s (+ i 1)) i) i)))
           (token-end (subr spin (string int) int)
             (lambda (s i) (if (< i (string-length s)) (if (delim? (string-ref s i)) i (token-end s (+ i 1))) i)))
           (digits (subr spin (string int int int) int)
             (lambda (s i j acc)
               (cond ((>= i j) acc)
                     ((> acc 100000000000000000) -1)
                     ((char<? (string-ref s i) #\\0) -1)
                     ((char>? (string-ref s i) #\\9) -1)
                     (else (digits s (+ i 1) j (+ (* acc 10) (- (char->integer (string-ref s i)) 48)))))))
           (hex (subr spin (string int int int) int)
             (lambda (s i j acc)
               (cond ((>= i j) acc)
                     ((> acc 1114111) -1)
                     ((and (char>=? (string-ref s i) #\\0) (char<=? (string-ref s i) #\\9))
                      (hex s (+ i 1) j (+ (* acc 16) (- (char->integer (string-ref s i)) 48))))
                     ((and (char>=? (string-ref s i) #\\a) (char<=? (string-ref s i) #\\f))
                      (hex s (+ i 1) j (+ (* acc 16) (- (char->integer (string-ref s i)) 87))))
                     (else -1))))
           (named (subr spin (string) int)
             (lambda (t)
               (cond ((string=? t \"space\") 32) ((string=? t \"newline\") 10) ((string=? t \"tab\") 9)
                     ((string=? t \"return\") 13) ((string=? t \"null\") 0) ((string=? t \"alarm\") 7)
                     ((string=? t \"backspace\") 8) ((string=? t \"delete\") 127) ((string=? t \"escape\") 27)
                     ((= (string-length t) 1) (char->integer (string-ref t 0)))
                     ((char=? (string-ref t 0) #\\x) (hex t 1 (string-length t) 0))
                     (else -1))))
           (atom (subr spin (string int int) (pairof datum int acyclic))
             (lambda (s i j)
               (let ((t (substring s i j)) (n (- j i)))
                 (cond ((string=? t \"#t\") (cons (the datum #t) j))
                       ((string=? t \"#f\") (cons (the datum #f) j))
                       ((char=? (string-ref t 0) #\\#)
                        (if (and (> n 2) (char=? (string-ref t 1) #\\\\))
                            (let ((k (named (substring t 2 n))))
                              (if (< k 0) (cons (the datum '%phase1-unread) -1) (cons (the datum (integer->char k)) j)))
                            (cons (the datum '%phase1-unread) -1)))
                       ((and (char>=? (string-ref t 0) #\\0) (char<=? (string-ref t 0) #\\9))
                        (let ((k (digits t 0 n 0)))
                          (if (< k 0) (cons (the datum '%phase1-unread) -1) (cons (the datum k) j))))
                       ((and (> n 1) (char=? (string-ref t 0) #\\-) (char>=? (string-ref t 1) #\\0) (char<=? (string-ref t 1) #\\9))
                        (let ((k (digits t 1 n 0)))
                          (if (< k 0) (cons (the datum '%phase1-unread) -1) (cons (the datum (- 0 k)) j))))
                       (else (cons (the datum (string->symbol t)) j))))))
           (str (subr spin (string int string) (pairof datum int acyclic))
             (lambda (s i acc)
               (cond ((>= i (string-length s)) (cons (the datum '%phase1-unread) -1))
                     ((char=? (string-ref s i) #\\\") (cons (the datum acc) (+ i 1)))
                     ((char=? (string-ref s i) #\\\\)
                      (if (>= (+ i 1) (string-length s))
                          (cons (the datum '%phase1-unread) -1)
                          (let ((c (string-ref s (+ i 1))))
                            (cond ((char=? c #\\n) (str s (+ i 2) (string-append acc \"\\n\")))
                                  ((char=? c #\\t) (str s (+ i 2) (string-append acc \"\\t\")))
                                  ((char=? c #\\r) (str s (+ i 2) (string-append acc \"\\r\")))
                                  ((char=? c #\\\") (str s (+ i 2) (string-append acc \"\\\"\")))
                                  ((char=? c #\\\\) (str s (+ i 2) (string-append acc \"\\\\\")))
                                  (else (cons (the datum '%phase1-unread) -1))))))
                     (else (str s (+ i 1) (string-append acc (substring s i (+ i 1))))))))
           (items (subr spin (string int) (pairof datum int acyclic))
             (lambda (s i0)
               (let ((i (skip s i0)))
                 (cond ((>= i (string-length s)) (cons (the datum '%phase1-unread) -1))
                       ((char=? (string-ref s i) #\\)) (cons (the datum '()) (+ i 1)))
                       ((and (char=? (string-ref s i) #\\.) (< (+ i 1) (string-length s)) (delim? (string-ref s (+ i 1))))
                        (let ((r (one s (+ i 1))))
                          (if (< (cdr r) 0)
                              r
                              (let ((j (skip s (cdr r))))
                                (if (< j (string-length s))
                                    (if (char=? (string-ref s j) #\\)) (cons (car r) (+ j 1)) (cons (the datum '%phase1-unread) -1))
                                    (cons (the datum '%phase1-unread) -1))))))
                       (else
                        (let ((r (one s i)))
                          (if (< (cdr r) 0)
                              r
                              (let ((rest (items s (cdr r))))
                                (if (< (cdr rest) 0) rest (cons (the datum (cons (car r) (car rest))) (cdr rest)))))))))))
           (one (subr spin (string int) (pairof datum int acyclic))
             (lambda (s i0)
               (let ((i (skip s i0)))
                 (cond ((>= i (string-length s)) (cons (the datum '%phase1-unread) -1))
                       ((char=? (string-ref s i) #\\() (items s (+ i 1)))
                       ((char=? (string-ref s i) #\\)) (cons (the datum '%phase1-unread) -1))
                       ((char=? (string-ref s i) #\\\") (str s (+ i 1) \"\"))
                       ((and (char=? (string-ref s i) #\\#) (< (+ i 2) (string-length s)) (char=? (string-ref s (+ i 1)) #\\\\))
                        (atom s i (token-end s (+ i 3))))
                       (else (atom s i (token-end s i))))))))
    (lambda (s)
      (let ((r (one s 0)))
        (if (< (cdr r) 0)
            '%phase1-unread
            (if (< (skip s (cdr r)) (string-length s)) '%phase1-unread (car r)))))))
")

"`%phase1-apply`, for transformers of style `style`."
(define phase1-applier (subr kfx (string) string)
  (lambda (style)
    (let ((call (cond ((string=? style "0") "(%transformer d (%er-renamer (string->symbol tag)) %er-compare)")
                      ((string=? style "1") "(%transformer d (quote %env:use))")
                      (else "(%transformer d (quote %env:macro))"))))
      (string-list-append
        (list "\n(define %phase1-apply (subr (maxeff (read @globals) spin) (string string) datum)\n"
              "  (lambda (text tag)\n"
              "    (let ((d (%phase1-read text)))\n"
              "      (typecase d\n"
              "        (symbol y (if (symbol=? y (quote %phase1-unread)) d " call "))\n"
              "        (else e " call ")))))\n")))))
