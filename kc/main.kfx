"main.kfx: kc's driver (docs/research/kc.md, K1).

   kc [--db DB] --check FILE         the file checked
   kc [--db DB] --rust FILE OUT      its Rust, to OUT (KFX)
   kc [--db DB] --asm FILE OUT       its x86-64 assembly, to OUT
   kc [--db DB] [--rt RT] build FILE EXE
                                     its program built to EXE (C419): each
                                     procedure an object of its own, made
                                     once; linked only if its objects are
                                     new; RT the runtime's library
                                     (libkayak_kcrt.a beside kc)
   kc [--db DB] serve                requests, a line each, on the
                                     standard input (C415)
   kc [--db DB] --expanded-located FILE
                                     the program as kc expands it, a form at
                                     a time (C445), as the engine's
                                     `--expanded-located` writes it

 With --db, the database is read from DB first (if it is there and kc's)
 and written back after, so that a run begins with the last run's graph
 and values: only what an edit could have changed runs again. With
 --stats, how many query bodies ran, and which queries they
 were, on the standard error.

 A checker's refusal is the `checked` query's value (C415): said, and the
 run ends with status 1, its database written back as any run's is.

 `serve` (C415) keeps the database in memory between requests, so that a
 request pays for what its edit changed alone, not for the database read
 and written whole. A request, a line: `check FILE`, `asm FILE OUT`,
 `rust FILE OUT`, `save` (the database to DB, if given), `quit`; the file
 read anew at each. Its answer, a line: `ok N`, `refused N MESSAGE` (the
 message on one line), or `error MESSAGE`, `N` the query bodies run; with
 --stats, their names after a tab. At the end of the input the database
 is written to DB, as at `save`."

(define kc-driver
  (module
    (hide
      (import kc-front kc-refusal q-form q-position q-interface q-checked q-type q-kfx)
      (import kc-l0 q-l0-item)
      (import kc-rust q-rust-item q-rust)
      (import kc-x64 q-asm-item q-asm q-asm-entry q-objects x64-object-text)
      (import kc-expand kc-load-file! kc-expanded-lines q-expansion q-macros-for q-macro-in q-global-in q-entry
              q-written q-wseen q-wpos q-wkeys q-syntax-at q-defines-at q-wnames q-wforsyntax q-phase1)
      (import kc-front q-expanded))

    (define-effect driving (maxeff qe (io args) (io stdin) (io fs-read) (io fs-write) (io stdout) (io stderr) (io exit) (io process) (alloc @io) (read @io)))

    (hide
      "Whose a database is: kc's, of this kc's sources (`identity.kfx`, C399)."
      (define kc-whose string (string-append "kc " kc-identity))

      (define fail-with (subr (maxeff (io stderr) (io exit)) (string int) void)
        (lambda (message status)
          (begin (tagcase (write-err (string-append "kc: " (string-append message "\n"))) (done u #u) (failed e #u)) (exit status))))

      (define read-text (subr driving (string) string)
        (lambda (path)
          (tagcase (the (sumof (data (bytevectorof @io)) (failed io-error)) (read-file path))
            (data b (tagcase (utf8->string b) (text s s) (bad k (fail-with (string-append path ": not UTF-8") 1))))
            (failed e (fail-with (string-append "cannot read " (string-append path (string-append ": " (extract e detail)))) 1)))))

      (define read-text-or-none (subr driving (string) string)
        (lambda (path)
          (tagcase (the (sumof (data (bytevectorof @io)) (failed io-error)) (read-file path))
            (data b (tagcase (utf8->string b) (text s s) (bad k "")))
            (failed e ""))))

      (define write-text (subr driving (string string) unit)
        (lambda (path text)
          (tagcase (write-file path (the (bytevectorof @io) (string->utf8 text)))
            (done u #u)
            (failed e (fail-with (string-append "cannot write " (string-append path (string-append ": " (extract e detail)))) 1)))))

      "The database's two files (C417): its graph at DB, its payload at
       DB.payload; a whole program's output not kept, made again from its
       items when it is asked for."
      (define save-db (subr driving (db string) unit)
        (lambda (d dbp)
          (tagcase (db-files d kc-whose (lambda ((k sexp)) (not (or (string=? (key-query k) "asm") (string=? (key-query k) "rust")))))
            (db-files-made (graph payload)
              (begin (write-text dbp graph) (write-text (string-append dbp ".payload") payload))))))

      "Every query, by name."
      (define-rec
        (kc-run (subr qe (db sexp) string)
          (lambda (d k)
            ;; A key is `(QUERY PATH)` or `(QUERY PATH KEY)` (C417).
            (let ((q (key-query k)) (a (key-arg k 0)) (b (key-arg k 1)))
              (cond ((string=? q "checked") (q-checked d kc-run a b))
                    ((string=? q "kfx") (q-kfx d kc-run a b))
                    ((string=? q "form") (q-form d kc-run a b))
                    ((string=? q "interface") (q-interface d kc-run a b))
                    ((string=? q "position") (q-position d kc-run a b))
                    ((string=? q "type") (q-type d kc-run a b))
                    ((string=? q "l0-item") (q-l0-item d kc-run a b))
                    ((string=? q "rust-item") (q-rust-item d kc-run a b))
                    ((string=? q "rust") (q-rust d kc-run a b))
                    ((string=? q "asm-item") (q-asm-item d kc-run a b))
                    ((string=? q "asm") (q-asm d kc-run a b))
                    ((string=? q "asm-entry") (q-asm-entry d kc-run a b))
                    ((string=? q "objects") (q-objects d kc-run a b))
                    ;; A file's macros (C445): its forms each expanded, and
                    ;; the inputs, written, they are expanded from.
                    ((string=? q "expanded") (q-expanded d kc-run a b))
                    ((string=? q "expansion") (q-expansion d kc-run a b))
                    ((string=? q "macros-for") (q-macros-for d kc-run a b))
                    ((string=? q "macro-in") (q-macro-in d kc-run a b (key-arg k 2)))
                    ((string=? q "global-in") (q-global-in d kc-run a b (key-arg k 2)))
                    ((string=? q "entry") (q-entry d kc-run a b (key-arg k 2)))
                    ((string=? q "written") (q-written d kc-run a b))
                    ((string=? q "wseen") (q-wseen d kc-run a b))
                    ((string=? q "wpos") (q-wpos d kc-run a b))
                    ((string=? q "wkeys") (q-wkeys d kc-run a b))
                    ((string=? q "syntax-at") (q-syntax-at d kc-run a b))
                    ((string=? q "defines-at") (q-defines-at d kc-run a b))
                    ((string=? q "wnames") (q-wnames d kc-run a b))
                    ((string=? q "wforsyntax") (q-wforsyntax d kc-run a b))
                    ;; A transformer's answer (C446), an input.
                    ((string=? q "phase1") (q-phase1 d kc-run a b))
                    (else (begin (error (string-append "kc: no query " (key-text k))) "")))))))

      (define-rec
        (ran-names (subr kfx (sexps i64) string)
          (lambda (ks n)
            "The first `n` of `ks`, oldest first, each after a space."
            (if (or (null? ks) (i64<= n 0)) "" (string-append (ran-names (cdr ks) (i64- n 1)) (string-append " " (key-query (car ks))))))))

      (define-datatype opts (opts string bool string (listof string acyclic)))

      (define-rec
        (opts-of (subr kfx ((listof string acyclic) string bool string (listof string acyclic)) opts)
          (lambda (as db stats rt rest)
            (cond ((null? as) (opts db stats rt (reverse rest)))
                  ((and (string=? (car as) "--db") (not (null? (cdr as)))) (opts-of (cdr (cdr as)) (car (cdr as)) stats rt rest))
                  ((and (string=? (car as) "--rt") (not (null? (cdr as)))) (opts-of (cdr (cdr as)) db stats (car (cdr as)) rest))
                  ((string=? (car as) "--stats") (opts-of (cdr as) db #t rt rest))
                  (else (opts-of (cdr as) db stats rt (cons (car as) rest))))))))

    (hide
      "A request's outcome: refused (the checker's message), or not; and
       what it ran."
      (define-datatype answer (answer bool string i64 string))

      (define-rec
        (words-in (subr kfx ((listof char acyclic) (listof char acyclic) (listof string acyclic)) (listof string acyclic))
          (lambda (cs word acc)
            "A request's words, apart at its spaces, in order."
            (cond ((null? cs) (reverse (if (null? word) acc (cons (list->string (reverse word)) acc))))
                  ((char=? (car cs) #\space) (words-in (cdr cs) nil (if (null? word) acc (cons (list->string (reverse word)) acc))))
                  (else (words-in (cdr cs) (cons (car cs) word) acc))))))

      (define-rec
        (one-line (subr kfx ((listof char acyclic) (listof char acyclic)) string)
          (lambda (cs acc)
            (cond ((null? cs) (list->string (reverse acc)))
                  ((or (char=? (car cs) #\newline) (char=? (car cs) #\tab)) (one-line (cdr cs) (cons #\space acc)))
                  (else (one-line (cdr cs) (cons (car cs) acc)))))))

      "`kc build` (C419; the user: \"I'm wondering if we can go so far as to
       detect that the generated object code is actually unchanged in order
       to avoid downstream work\"): each procedure an object of its own and
       what is no procedure's one more, each named by the fingerprint of what
       it is made from (`objects`), so that an object made once is made no
       more; the program linked only when its objects, or the runtime, are not
       those it was last linked of (`EXE.objects` says which)."
      (define-rec
        (strings-at-io (subr (alloc @io) ((listof string acyclic)) (listof string @io))
          (lambda (xs) (if (null? xs) (the (listof string @io) nil) (the (listof string @io) (cons (car xs) (strings-at-io (cdr xs))))))))

      (define run-command (subr driving ((listof string acyclic) string) string)
        (lambda (argv dir)
          "A program run in `dir` to its end: `` if it exits 0; else what it said."
          (tagcase (process-start (strings-at-io argv) dir)
            (started p
              (tagcase (process-exit p)
                (exited c (if (i64= (int->i64 c) 0) "" (string-append (car argv) (string-append " failed:\n" (process-output p)))))
                (signalled g (string-append (car argv) " was signalled"))
                (unknown u (string-append (car argv) " ended, how is not known"))))
            (failed e (string-append "cannot run " (string-append (car argv) (string-append ": " (extract e detail))))))))

      (define-rec
        (object-names (subr kfx (sexps (listof string acyclic)) (listof string acyclic))
          (lambda (os acc)
            "Each object's name, `oFP` (`o_FP` of a negative), in order."
            (if (null? os)
                (reverse acc)
                (let ((fp (tagcase (second (items (car os))) (num (n f p) n) (else other (the i64 0)))))
                  (object-names (cdr os) (cons (if (i64< fp 0) (string-append "o_" (i64->string (i64- 0 fp))) (string-append "o" (i64->string fp))) acc)))))))

      (define-rec
        (members-text (subr driving (db string sexps (listof string acyclic)) string)
          (lambda (d file ks acc)
            "A run of procedures' objects' assembly, one after another."
            (if (null? ks)
                (string-list-append (reverse acc))
                (members-text d file (cdr ks)
                              (cons (x64-object-text (car (read-all (db-get d kc-run (key2 "asm-item" file (tagcase (car ks) (str (t f p) t) (else other "")))) "asm" 1)))
                                    acc))))))

      (define-rec
        (objects-written (subr driving (db string string sexps (listof string acyclic) (listof string acyclic) (listof string acyclic)) (listof string acyclic))
          (lambda (d file dir os names have acc)
            "The assembly of each object not made yet, written to `dir`; their
             files' names."
            (if (null? os)
                (reverse acc)
                (if (string-member? (string-append (car names) ".o") have)
                    (objects-written d file dir (cdr os) (cdr names) have acc)
                    (let* ((ks (items (car (items (car os)))))
                           (text (if (null? ks)
                                     (db-get d kc-run (key1 "asm-entry" file))
                                     (members-text d file ks nil)))
                           (s (string-append (car names) ".s")))
                      (begin
                        (write-text (string-append dir (string-append "/" s)) text)
                        (objects-written d file dir (cdr os) (cdr names) have (cons s acc)))))))))

      (define-rec
        (strings-from-io (subr (maxeff (read @io) spin) ((listof string @io)) (listof string acyclic))
          (lambda (xs) (if (null? xs) nil (cons (car xs) (strings-from-io (cdr xs)))))))

      (define listed (subr driving (string) (listof string acyclic))
        (lambda (dir)
          (tagcase (the (sumof (names (listof string @io)) (failed io-error)) (list-dir dir))
            (names ns (strings-from-io ns))
            (failed e nil))))

      (define exists? (subr driving (string) bool)
        (lambda (path)
          (tagcase (the (sumof (data (bytevectorof @io)) (failed io-error)) (read-file path))
            (data b #t)
            (failed e #f))))

      (define build (subr driving (db string string string) string)
        (lambda (d file exe rt)
          "The program of `file` built to `exe`, on the runtime `rt`: `` if
           it is, else what went wrong."
          (let* ((objs-text (db-get d kc-run (key1 "objects" file)))
                 (manifest (string-append objs-text (string-append "\n" rt)))
                 (record (string-append exe ".objects"))
                 (dir (string-append exe ".o.d")))
            (if (and (string=? manifest (read-text-or-none record)) (exists? exe))
                ""
                (let* ((os (items (car (read-all objs-text "objects" 1))))
                       (names (object-names os nil))
                       (made (run-command (list "mkdir" "-p" dir) ""))
                       (new (objects-written d file dir os names (listed dir) nil))
                       (assembled (if (null? new) "" (run-command (cons "cc" (cons "-c" new)) dir))))
                  (if (not (string=? assembled ""))
                      assembled
                      (let ((linked (run-command (append (list "cc" "-o" exe)
                                                         (append (map (lambda ((n string)) (string-append dir (string-append "/" (string-append n ".o")))) names)
                                                                 ;; The runtime shared (C447), found where it is.
                                                                 (if (has-suffix? rt ".so")
                                                                     (list rt (string-append "-Wl,-rpath," (directory-of rt)))
                                                                     (list rt "-lgcc_s" "-lutil" "-lrt" "-lpthread" "-lm" "-ldl" "-lc"))))
                                                 "")))
                        (if (string=? linked "") (begin (write-text record manifest) "") linked))))))))

      "Where a procedural macro's transformer is built, and on what runtime
       (C447): beside the database, `DB.phase1/`, where there is one, so that
       a transformer built once is built no more; else a directory of this
       run's own, taken away at its end. The runtime the shared one
       (`libkayak_kcrt.so`) where it is beside the static one."
      (define-datatype phase1-at (phase1-at string string))

      "A request's file's name in the database, of the fingerprint of what
       it defines (`phase1-parts`): each transformer a file of its own, its
       items kept, so that only a use's call is new at each use."
      (define phase1-name (subr kfx (string) string)
        (lambda (defs)
          (let ((fp ((with queries fnv-string) defs (with queries fnv-offset))))
            (if (i64< fp 0) (string-append "n" (i64->string (i64- 0 fp))) (i64->string fp)))))

      "The last line of a run's output that is not empty."
      (define-rec
        (last-line (subr kfx ((listof string acyclic) string) string)
          (lambda (ls last)
            (cond ((null? ls) last)
                  ((string=? (car ls) "") (last-line (cdr ls) last))
                  (else (last-line (cdr ls) (car ls)))))))

      (define-rec
        (lines-of (subr kfx ((listof char acyclic) (listof char acyclic) (listof string acyclic)) (listof string acyclic))
          (lambda (cs line acc)
            (cond ((null? cs) (reverse (cons (list->string (reverse line)) acc)))
                  ((char=? (car cs) #\newline) (lines-of (cdr cs) nil (cons (list->string (reverse line)) acc)))
                  (else (lines-of (cdr cs) (cons (car cs) line) acc))))))

      "A procedural macro's transformer's request (C446), answered by kc
       itself (C447): its phase-1 program (`phase1-parts`,
       fx26/macros-phase1.kfx) a file of the database, checked, compiled to
       native code and built as any program, each of its items a query, so
       that a transformer's definitions are compiled once and a use's call
       alone is new; then run. Its answer, `=` and the value of its last
       expression as `write` writes it (`#u` of none), or `!` and why its
       check refused it or its run failed. Of the request's text alone, so
       kept as the input `phase1 REQUEST`, and asked once."
      (define phase1-asked (subr driving (db phase1-at string) string)
        (lambda (d at request)
          (tagcase at
            (phase1-at (dir rt)
              (let* ((ps (phase1-parts request)) (defs (extract ps 1)))
                (if (string=? defs "")
                    "!a malformed transformer request"
                    (let* ((name (phase1-name defs))
                           (path (string-append "%phase1-" (string-append name ".fx")))
                           (need (kc-load-file! d kc-run path (string-append defs (extract ps 2)))))
                      (if (not (string=? need ""))
                          "!kc: not yet: a phase-1 form that uses a procedural macro"
                          (let ((refused (kc-refusal (db-get d kc-run (key1 "checked" path)))))
                            (if (not (string=? refused ""))
                                (string-append "!" (phase1-unplaced refused))
                                (let* ((exe (string-append dir (string-append "/t" name)))
                                       (built (build d path exe rt)))
                                  (if (not (string=? built ""))
                                      (string-append "!kc: the transformer's build: " built)
                                      (tagcase (process-start (strings-at-io (list exe)) "")
                                        (started p
                                          (let* ((how (process-exit p))
                                                 (last (last-line (lines-of (string-chars (process-output p)) nil nil) "")))
                                            (tagcase how
                                              (exited c
                                                (cond ((= c 0) (string-append "=" (if (string=? last "") "#u" last)))
                                                      ((has-prefix? last "evaluation failed: ") (string-append "!" (after-prefix last "evaluation failed: ")))
                                                      (else (string-append "!the transformer's run: " last))))
                                              (signalled g "!the transformer's run was signalled")
                                              (unknown u "!the transformer's run ended, how is not known"))))
                                        (failed e (string-append "!the transformer's run: cannot run " (string-append exe (string-append ": " (extract e detail))))))))))))))))))

      "`kc-load-file!`, each transformer's request it needs answered and set
       (C446), until it needs none."
      (define-rec
        (load-answered! (subr driving (db phase1-at string string) unit)
          (lambda (d at file text)
            (let ((need (kc-load-file! d kc-run file text)))
              (if (string=? need "")
                  #u
                  (begin (db-set! d (key1 "phase1" need) (phase1-asked d at need) 0)
                         (load-answered! d at file text)))))))

      "Where this run builds transformers (`phase1-at`): `DB.phase1`, or
       `/tmp/kc-phase1-PID`, PID this process's."
      (define phase1-dir (subr driving (string) string)
        (lambda (dbp)
          (if (not (string=? dbp ""))
              (string-append dbp ".phase1")
              (tagcase (read-symlink "/proc/self")
                (target t (string-append "/tmp/kc-phase1-" t))
                (failed e "/tmp/kc-phase1")))))

      "This run's own transformers' directory, if it made one, taken away."
      (define phase1-done (subr driving (string) unit)
        (lambda (dbp)
          (if (or (not (string=? dbp "")) (null? (listed (phase1-dir dbp))))
              #u
              (begin (run-command (list "rm" "-rf" (phase1-dir dbp)) "") #u))))

      (define request (subr driving (db phase1-at string string string) answer)
        (lambda (d at what file out)
          "`what` (`check`, `asm`, `rust`, `build`) of `file`, its output to
           `out`: the file read, its forms set (`kc-load-file!`), checked, and, if
           it passes, its code asked for, or built (on the runtime `rt`)."
          (let ((before (db-runs d)) (rt (tagcase at (phase1-at (dir r) r))))
            (begin
              (load-answered! d at file (read-text file))
              (let ((refused (kc-refusal (db-get d kc-run (key1 "checked" file)))))
                (begin
                  ;; Written only if it is new (C417): an output as it was is left as
                  ;; it was, its file's time too, so that what builds from it
                  ;; (cargo's rustc, the assembler) need not run again.
                  ;; The output's fingerprint first, its value neither read nor made:
                  ;; the file holding it already is the whole program's output
                  ;; kept (the database keeps only its parts, C417).
                  (if (and (string=? refused "") (not (string=? what "check")) (not (string=? what "build")))
                      (let* ((key (key1 (if (string=? what "rust") "rust" "asm") file))
                             (fp (db-fingerprint d kc-run key))
                             (there (read-text-or-none out)))
                        (if (i64= fp ((with queries fnv-string) there (with queries fnv-offset)))
                            #u
                            (write-text out (db-get d kc-run key))))
                      #u)
                  (let ((failed (if (and (string=? refused "") (string=? what "build")) (build d file out rt) refused)))
                    (answer (not (string=? failed "")) failed (i64- (db-runs d) before)
                            (ran-names (db-ran d) (i64- (db-runs d) before))))))))))

      (define said (subr (maxeff (io stdout)) (string) unit)
        (lambda (s) (tagcase (write-out (string-append s "\n")) (done u #u) (failed e #u))))

      (define-rec
        (serve (subr driving (db string bool phase1-at) int)
          (lambda (d dbp stats at)
            "Requests until the input ends, or `quit`."
            (tagcase (read-line)
              (line s
                (let* ((ws (words-in (string-chars s) nil nil))
                       (n (size ws)))
                  (cond ((and (i64= n 1) (string=? (car ws) "quit")) (begin (if (or (string=? dbp "") (not (db-dirty? d))) #u (save-db d dbp)) 0))
                        ((and (i64= n 1) (string=? (car ws) "save"))
                         (begin (if (or (string=? dbp "") (not (db-dirty? d))) #u (save-db d dbp)) (said "ok 0") (serve d dbp stats at)))
                        ((or (and (i64= n 2) (string=? (car ws) "check"))
                             (and (i64= n 3) (or (string=? (car ws) "asm") (string=? (car ws) "rust") (string=? (car ws) "build"))))
                         (tagcase (request d at (car ws) (car (cdr ws)) (if (i64= n 3) (car (cdr (cdr ws))) ""))
                           (answer (no msg k names)
                             (begin
                               (said (string-list-append (list (if no "refused " "ok ") (i64->string k)
                                                               (if no (string-append " " (one-line (string-chars msg) nil)) "")
                                                               (if stats (string-append "\t" names) ""))))
                               (serve d dbp stats at)))))
                        (else (begin (said (string-append "error not a request: " s)) (serve d dbp stats at))))))
              (eof u (begin (if (or (string=? dbp "") (not (db-dirty? d))) #u (save-db d dbp)) 0))
              (failed e (begin (if (or (string=? dbp "") (not (db-dirty? d))) #u (save-db d dbp)) 1)))))))

    (define kc-main (subr driving () int)
      (lambda ()
        (tagcase (opts-of (the (listof string acyclic) (args)) "" #f "" nil)
          (opts (dbp stats rt0 rest)
            (let* ((d (if (string=? dbp "") (db-make) (db-of-files (read-text-or-none dbp) (read-text-or-none (string-append dbp ".payload")) kc-whose)))
                   ;; The runtime, where not given, the one beside this kc (C447).
                   (rt (if (not (string=? rt0 ""))
                           rt0
                           (tagcase (read-symlink "/proc/self/exe")
                             (target x (string-append (directory-of x) "/libkayak_kcrt.a"))
                             (failed e "target/release/libkayak_kcrt.a"))))
                   ;; A transformer's program linked to the runtime shared, where
                   ;; it is beside this kc: a link a sixth of the static one's (C447).
                   (shared (string-append (directory-of rt) "/libkayak_kcrt.so"))
                   (at (phase1-at (phase1-dir dbp) (if (exists? shared) shared rt)))
                   (status
              (cond ((null? rest)
                     (fail-with "usage: kc [--db DB] [--stats] [--rt RUNTIME] (--check FILE | --rust FILE OUT | --asm FILE OUT | build FILE EXE | serve)" 2))
                    ((string=? (car rest) "serve") (serve d dbp stats at))
                    ;; The program as kc expands it, a form at a time (C445),
                    ;; located, as the engine's `--expanded-located` writes it.
                    ((and (string=? (car rest) "--expanded-located") (not (null? (cdr rest))))
                     (let ((file (car (cdr rest))))
                       (begin
                         (load-answered! d at file (read-text file))
                         (tagcase (write-out (string-list-append (kc-expanded-lines d kc-run file))) (done u #u) (failed e #u))
                         (if (or (string=? dbp "") (not (db-dirty? d))) #u (save-db d dbp))
                         0)))
                    (else
                     (let* ((what (car rest)) (file (if (null? (cdr rest)) "" (car (cdr rest)))))
                       (begin
                         (if (string=? file "") (fail-with "a FILE is wanted" 2) #u)
                         (if (not (or (string=? what "--check") (string=? what "--rust") (string=? what "--asm") (string=? what "build")))
                             (fail-with (string-append "not an option: " what) 2)
                             #u)
                         (if (and (not (string=? what "--check")) (null? (cdr (cdr rest)))) (fail-with "an OUT is wanted" 2) #u)
                         (tagcase (request d at (cond ((string=? what "--check") "check") ((string=? what "--rust") "rust") ((string=? what "build") "build") (else "asm")) file
                                           (if (string=? what "--check") "" (car (cdr (cdr rest)))))
                           (answer (no msg k names)
                             (begin
                               (if stats (tagcase (write-err (string-append "kc: " (string-append (i64->string k) (string-append " query bodies ran:" (string-append names "\n")))))
                                           (done u #u) (failed e #u))
                                   #u)
                               (if (or (string=? dbp "") (not (db-dirty? d))) #u (save-db d dbp))
                               (if no (begin (tagcase (write-err (string-append msg "\n")) (done u #u) (failed e #u)) 1) 0))))))))))
              (begin (phase1-done dbp) status))))))))

(import kc-driver (effect driving))

"kc's entry: the driver's."
(define main (subr driving () int) (lambda () (with kc-driver (kc-main))))
